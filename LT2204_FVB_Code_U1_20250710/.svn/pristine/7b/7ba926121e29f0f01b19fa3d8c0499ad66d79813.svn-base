 135          void Drv_Audio_HdmiOutInit(void)
 136          {
 137   1          BKC6_27_REG = 0x01; // to solve fs value change, ACR is locked to an abnormal value: 48Khz-->32Khz
 138   1          #if TX_PORT_SIGN == HDMI_PORT
              
                  //===============================spdif and i2s in===============================
                  #if ((TX_AUDIO_SEL == SPDIFIN_AUDIO_DATA) || (TX_AUDIO_SEL == I2SIN_AUDIO_DATA))
                  BKC6_2E_REG &= 0xf8;//[2:0]aud_2hm_sel: 4-acr, 2-dp, 1-aud_rev, 0-hdmirx
                  BKC6_2E_REG |= 0x01;//[2:0]aud_2hm_sel: 1-external audio data
              
                  BKED_10_REG &= 0x83;//[3:2]htx_fs64_clk_src_sel: 00-external audio
                                      //[6:4]htx_fs64_wclk_src_sel: 00-external audio
                  BKEB_0D_REG &= BIT2_0;//[2]ncts bypass en: 0-dis
                  #endif
                  //===============================spdif and i2s in===============================
              
                  //=====================================rx in====================================
                  #if TX_AUDIO_SEL == RX_AUDIO_DATA
                  #if RX_PORT_SIGN == HDMI_PORT
              
                  #if HDMITX_AUDIO_DATA_BYPASS == ENABLED
                  BKC6_2E_REG &= 0xf8;//[2:0]aud_2hm_sel: 0-hdmirx
                  #else
              
                  BKC6_2E_REG &= 0xf8;
                  BKC6_2E_REG |= BIT2_1;//[2:0]aud_2hm_sel: 100-acr
                  BKC6_28_REG |= BIT4_1;//[4]rgd_cor_mk_sel: 1-cor_mk_ideal
                  BKC6_4A_REG |= BIT5_1;//[5]rgd_mk_div_en: 1-en(mk value divide 2 when ma_pre > 0x4a)
                  BKC6_4B_REG = 0x50;//[7:0]rgd_fs_val_rea_thr
                  #endif
              
                  BKED_10_REG &= 0x83;//[6:4]fs64_wclk: 0-rev acr_clk, 1-128fs, 4-lclk;
                                      //[3:2]htx_fs64_clk_src_sel: 1-128fs, 0-rev acr_clk
                  #if HDMITX_AUDIO_DATA_BYPASS == ENABLED
                  BKED_10_REG |= 0x44;
                  #else
                  BKED_10_REG |= 0x14;
                  #endif
                  BKED_11_REG &= 0xf1;//[3:2]htx_fs64_clk_sel: 1-128fs, 0-acr_fs64
                  BKED_11_REG |= 0x02;//[1]acr_mux_clk_sel,1=dhtx_write_clk,0=div_link_clk(tmds for cts)
                  #if HDMITX_AUDIO_NCTS_BYPASS == ENABLED
                  BKEB_0D_REG |= BIT2_1;//[2]ncts bypass en, 1-from hdmi rx
C51 COMPILER V9.53.0.0   DRVAUDIO                                                          02/13/2025 10:14:11 PAGE 4   

                  #else
                  BKEB_0D_REG &= BIT2_0;//[2]ncts bypass en, 0-from acr regenerate
                  #endif
                  BKEB_10_REG |= BIT4_1;//[4]rgd_aud_auto_sel: 1-from hdmi rx depkt
                  #endif
              
                  
                  #if RX_PORT_SIGN == DP_PORT
              
                  #if HDMITX_AUDIO_DATA_BYPASS == ENABLED
                  BKC6_2E_REG &= 0xf8;
                  BKC6_2E_REG |= BIT1_1;//[2:0]aud_2hm_sel: 010-dp rx
                  #else
                  BKC6_2E_REG &= 0xf8;
                  BKC6_2E_REG |= BIT2_1;//[2:0]aud_2hm_sel: 100-acr
                  BKC6_28_REG |= BIT4_1;//[4]rgd_cor_mk_sel: 1-cor_mk_ideal
                  BKC6_4A_REG |= BIT5_1;//[5]rgd_mk_div_en: 1-en(mk value divide 2 when ma_pre > 0x4a)
                  BKC6_4B_REG = 0x50;//[7:0]rgd_fs_val_rea_thr
                  #endif
                  BKED_10_REG &= 0x83; //[6:4]fs64_wclk: 0-rev acr_clk, 1-128fs, 4-lclk;
                                       //[3:2]htx_fs64_clk_src_sel: 1-128fs, 0-rev acr_clk
                  #if HDMITX_AUDIO_DATA_BYPASS == ENABLED
                  BKED_10_REG |= 0x44;
                  #else
                  BKED_10_REG |= 0x14;
                  #endif
                  BKED_11_REG &= 0xf1;//[3:2]htx_fs64_clk_sel: 1-128fs, 0-acr_fs64
                  BKED_11_REG |= 0x02;//[1]acr_mux_clk_sel,1=dhtx_write_clk,0=div_link_clk(tmds for cts)
              
                  BKEB_0D_REG &= BIT2_0;//[2]ncts bypass en, 1-en, 0-dis
                  BKEB_10_REG &= BIT4_0;//[4]rgd_aud_auto_sel: 0-from user define
                  #endif
                  #endif
                  //=====================================rx in====================================
                  
                  //close audio pkt
                  BKEB_06_REG &= BIT2_0;//[[2]set hdmi audio stream input enable: 0-dis
                  //for case of Amlogic 311D2
              //    BKEB_18_REG &= BIT5_0;//[5]hdmi acr pkt en: 0-dis
                  BKEB_19_REG &= BIT1_0;//
                  #endif
 218   1      }
