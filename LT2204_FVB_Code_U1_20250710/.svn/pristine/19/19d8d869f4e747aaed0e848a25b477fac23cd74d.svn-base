 116          void Mod_DpTx_HbeSet(u8 b1IsHbeEn)
 117          {
 118   1          u16 usHtiming;
 119   1          if(b1IsHbeEn == ENABLED)
 120   1          {
 121   2              usHtiming = ((u16)BKF7_F6_REG << 8) + BKF7_F7_REG;
 122   2              usHtiming <<=1;
 123   2              Tx_Buff[0] = usHtiming; 
 124   2              Tx_Buff[1] = usHtiming>>8;
 125   2              Mod_DpTxLink_DpcdWrite(0x00,0x3054,Tx_Buff,2);//output htotal
 126   2              
 127   2              usHtiming =  ((u16)BKF7_EA_REG << 8) + BKF7_EB_REG;
 128   2              usHtiming += ((u16)BKF7_F0_REG << 8) + BKF7_F1_REG;
 129   2              usHtiming <<=1;
 130   2              Tx_Buff[0] = usHtiming;
 131   2              Tx_Buff[1] = usHtiming>>8;
 132   2              Mod_DpTxLink_DpcdWrite(0x00,0x3056,Tx_Buff,2);//output hstart
 133   2              
 134   2              usHtiming =  ((u16)BKF7_EA_REG << 8) + BKF7_EB_REG;
 135   2              usHtiming <<= 1;
 136   2              usHtiming = (BKF7_E7_REG&BIT4_1)?(usHtiming&0x7fff):(usHtiming|0x8000); 
 137   2              Tx_Buff[0] = usHtiming; 
 138   2              Tx_Buff[1] = usHtiming>>8;
 139   2              Mod_DpTxLink_DpcdWrite(0x00,0x3058,Tx_Buff,2);//output hsync
 140   2         }
 141   1         else
 142   1         {
 143   2              Tx_Buff[0] = Tx_Buff[1] = 0x00;
 144   2              Mod_DpTxLink_DpcdWrite(0x00,0x3054,Tx_Buff,2);//output htotal
 145   2         }
 146   1      
 147   1      }
