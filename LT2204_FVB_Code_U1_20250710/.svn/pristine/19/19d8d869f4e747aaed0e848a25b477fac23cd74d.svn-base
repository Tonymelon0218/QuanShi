 321          void Mod_DpTx_AudioInfoSet(void)
 322          {
 323   1          #if TX_AUDIO_SEL != NO_AUDIO_DATA
 324   1          #if DPTX_AUDIO_DATA_BYPASS == ENABLED
                  u8 ucLaneRate;
                  u32 ulMaud, ulTemp1;
                  u16 usFsValue_128;
                  float Temp0;
                  #endif
 330   1      
 331   1          printLT(PRINT_PRIO_TEST, "\nAudio layout is 0x%02bx", g_stDpTx.ucLayout);
 332   1          printLT(PRINT_PRIO_TEST, "\nAudio Channel is 0x%02bx", g_stDpTx.ucChannel);
 333   1      
 334   1          if(g_stDpTx.ucLayout == 1)
 335   1          {
 336   2              BKF6_14_REG |= BIT0_1;//[0]1-dp audio 8ch mode
 337   2          }
 338   1          else
 339   1          {
 340   2              BKF6_14_REG &= BIT0_0;//[0]0-dp audio 2ch mode
 341   2          }
 342   1      
 343   1          BKF6_D1_REG = g_stDpTx.szAudioInfo[0];//hb1
 344   1          BKF6_D2_REG = g_stDpTx.szAudioInfo[1];//hb2
 345   1          BKF6_D3_REG = g_stDpTx.szAudioInfo[2];//hb3
 346   1          BKF6_D4_REG = g_stDpTx.szAudioInfo[3];//pb0
 347   1          BKF6_D5_REG = g_stDpTx.szAudioInfo[4];//pb1
 348   1          BKF6_D6_REG = g_stDpTx.szAudioInfo[5];//pb2
 349   1          BKF6_D7_REG = g_stDpTx.szAudioInfo[6];//pb3
 350   1          BKF6_D8_REG = g_stDpTx.szAudioInfo[7];//pb4
 351   1          if(g_stDpTx.ucCodingType == ENABLED)
 352   1          {
 353   2              BKF6_14_REG |= BIT0_1;//[0]1-dp audio 8ch mode
 354   2              BKF6_EB_REG = 0x17;//hbr en
 355   2          }
 356   1          else
 357   1          {
 358   2              BKF6_EB_REG = g_stDpTx.ucChannel;//8 channel
 359   2          }
 360   1      
 361   1          #if DPTX_AUDIO_DATA_BYPASS == ENABLED// to fixe ACR no 128_fs clk issue.
                  //Naud = 0x8000;
                  //(Fhalf_lclk / 2) * 1000 * Maud = 4 * Naud * Fs * 64;
C51 COMPILER V9.53.0.0   MODDPTX                                                           02/13/2025 10:14:30 PAGE 7   

                  //Fhalf_lclk * 125 * Maud = Naud * Fs * 64;
                  //Fhalf_lclk * 125 * Maud = 0x8000 * 64 * Fs
                  //Maud = 0x200000 * Fs / (Fhalf_lclk * 125);
              
                  ucLaneRate = BKF5_5F_REG;
                  if (ucLaneRate == RBR)
                  {
                      ulTemp1 = 162;
                  }
                  else if (ucLaneRate == HBR)
                  {
                      ulTemp1 = 270;
                  }
                  else if (ucLaneRate == HBR2)
                  {
                      ulTemp1 = 540;
                  }
                  else
                  {
                      ulTemp1 = 810;
                  }
                  
                  BKF6_06_REG &= 0x0f;
                  BKF6_06_REG |= 0x90;
              
                  usFsValue_128 = ((u16)BKC6_7D_REG << 8) + BKC6_7E_REG;
                  ulTemp1 *= 125;
              //    ulMaud = ceil((double)usFsValue_128 * 16384 / ulTemp1);
              
                  Temp0 = (double)usFsValue_128 * 16384 / ulTemp1;
              
                  ulMaud = (u32)Temp0;//四舍五入
                  if(fabs(Temp0 - (float)ulMaud) >= 0.5f)
                  {
                      ulMaud++;
                  }
                  
                  printLT(PRINT_PRIO_TEST, "\nMaud is 0x%04lx",ulMaud);
                  
                  BKF6_0C_REG = ulMaud & 0xff;
                  BKF6_0B_REG = (ulMaud >> 8) & 0xff;
                  BKF6_0A_REG = (ulMaud >> 16) & 0xff;
                  #else
 407   1          BKF6_06_REG &= 0x8f;//[6:4]rg_maud_fact: 010-maud/2
 408   1          if(BKF6_EB_REG == 0x17)
 409   1          {
 410   2           BKF6_06_REG |= 0x10;//[6:4]rg_maud_fact: 010-maud/2
 411   2          }
 412   1          else
 413   1          {
 414   2           BKF6_06_REG |= 0x20;//[6:4]rg_maud_fact: 010-maud/2
 415   2          }
 416   1          #endif
 417   1      
 418   1          BKF6_14_REG |= BIT7_1;//[7]atp pkt send sdp enable: 1-en
 419   1          BKF6_DD_REG |= BIT0_1;//[1]psr data selet: 1-psr data from register
 420   1          #endif
 421   1      }
