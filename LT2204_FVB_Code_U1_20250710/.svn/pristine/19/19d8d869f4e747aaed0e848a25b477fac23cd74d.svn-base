 522          void Mod_DpTx_HpdDetProc(void)
 523          {
 524   1          if(g_stDpTx.ucTxState >= STATE_DPTX_UPSTREAM_DEVICE_READY_2)
 525   1          {
 526   2              //the current hpd detect is low.
 527   2              //if(Mod_DpTx_SinkHpdDet() == LOW)//dp hpd is low
 528   2              if(Mod_DpTx_SinkHpdDet() == LOW)
 529   2              { 
 530   3                  //the last hpd detect is high.
 531   3                  Drv_DpTx_HpdClear();
 532   3                  if(g_stDpTx.b1IsTxHpdDet == HIGH)
 533   3                  {
 534   4                      g_stDpTx.b1IsTxHpdDet = LOW;
 535   4                
 536   4                      Mod_DpTx_HpdLowAction();
 537   4                      printLT(PRINT_PRIO_HIG, "\ng_stDpTx.b1IsTxHpdDet = LOW");
 538   4                      Mod_DpTx_SetState(STATE_DPTX_UPSTREAM_DEVICE_READY_2);
 539   4                      Mod_DpTx_MsgNotify(DPTX_SINK_UNPLUG_EVENT);
 540   4                  } 
 541   3              }
 542   2              //the current hpd detect is high.
 543   2              //else if(Mod_DpTx_SinkHpdDet() == HIGH)//dp hpd is low 
 544   2              else if(Mod_DpTx_SinkHpdDet() == HIGH)
 545   2              {
 546   3                  //the last hpd detect is low.
 547   3                  if(g_stDpTx.b1IsTxHpdDet == LOW)
 548   3                  {
C51 COMPILER V9.53.0.0   MODDPTX                                                           02/13/2025 10:14:30 PAGE 10  

 549   4                      g_stDpTx.b1IsTxHpdDet = HIGH;
 550   4                      Mod_DpTx_MsgNotify(DPTX_SINK_PLUG_EVENT);
 551   4                  }
 552   3              }
 553   2          } 
 554   1      }
