              //================================
              //the function is used to initial nretry and variable
              //ucCC_Port:UCC or DCC
              //
              //================================
              void Mod_CCPortMsg_Retry(IN u8 ucCC_Port)
              {
                      if(ucCC_Port == UCC)
                      {
                              UCCStatus.b1CCDataMsg_Sent = FALSE;
                              UCCMSG.b1RcvGoodCRC = FALSE;
                              if(UCCStatus.b1Msg_ID_Change == TRUE)
                              {
C51 COMPILER V9.53.0.0   MODCCSHAREDTYPEC                                                  02/13/2025 10:14:01 PAGE 4   

                                      ;
                              }
                              else
                              {
                                      UCCStatus.ucRetryCounter++;
                              }
                              if(UCCMSG.ucCcVersion >= PD30)
                              {
                                      UCCStatus.ucnRetryCount = nRetryCount_PD30;
                              }
                              else
                              {
                                      UCCStatus.ucnRetryCount = nRetryCount_PD20;
                              }
                              UCCStatus.b1Msg_ID_Change = TRUE;       
                              Ocm_TR2_ValueSet();
                              if(UCCStatus.ucContract_Succeed)
                              {
                                      UCCStatus.b1CCDataMsg_Sent = TRUE;
                              }
                      }
                      else if(ucCC_Port == DCC)       
                      {
                      DCCStatus.b1CCDataMsg_Sent = FALSE;
                              DCCMSG.b1RcvGoodCRC = FALSE;
                              if(DCCStatus.b1Msg_ID_Change == TRUE)
                              {
                                      ;
                              }
                              else
                              {
                                      DCCStatus.ucRetryCounter++;
                              }
                      if(DCCMSG.ucCcVersion >= PD30)
                              {
                                      DCCStatus.ucnRetryCount = nRetryCount_PD30;
                              }
                              else
                              {
                                      DCCStatus.ucnRetryCount = nRetryCount_PD20;
                              }
                              DCCStatus.b1Msg_ID_Change = TRUE;
                              Ocm_TR2_ValueSet();
                      DCCStatus.b1CCDataMsg_Sent = TRUE;
                      }
              }
