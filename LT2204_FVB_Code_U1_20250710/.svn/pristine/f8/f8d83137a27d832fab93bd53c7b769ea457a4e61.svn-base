 419          void Drv_HdmiRxDscDec_TimingSet(void)//
 420          {
 421   1          u16 usTemp;
 422   1      
 423   1          BKEE_A3_REG = g_stHdmiDscDecTiming.usVsync & 0xff;
 424   1      
 425   1          BKEE_A6_REG = (g_stHdmiDscDecTiming.usVfp >> 8) & 0xff;
 426   1          BKEE_96_REG = g_stHdmiDscDecTiming.usVfp & 0xff;
 427   1      
 428   1          BKEE_90_REG = (g_stHdmiDscDecTiming.usVtol >> 8) & 0xff;
 429   1          BKEE_91_REG = g_stHdmiDscDecTiming.usVtol & 0xff;
 430   1      
 431   1          usTemp = g_stHdmiDscDecTiming.usHsync >> 1;
 432   1          if (g_stHdmiDscDecInfo.ucColorSpace == YCbCr420_3)
 433   1              usTemp >>= 1;
 434   1          BKEE_A2_REG = usTemp & 0xff;
 435   1      
 436   1          usTemp = g_stHdmiDscDecTiming.usHfp >> 1;
 437   1          if (g_stHdmiDscDecInfo.ucColorSpace == YCbCr420_3)
 438   1              usTemp >>= 1;
 439   1          BKEE_A0_REG = usTemp >> 8;
 440   1          BKEE_A1_REG = usTemp & 0xff;
 441   1      
 442   1          usTemp = g_stHdmiDscDecTiming.usHtol >> 1;
 443   1          if (g_stHdmiDscDecInfo.ucColorSpace == YCbCr420_3)
 444   1              usTemp >>= 1;
 445   1          BKEE_92_REG = usTemp >> 8;
 446   1          BKEE_93_REG = usTemp & 0xff;
 447   1      }
