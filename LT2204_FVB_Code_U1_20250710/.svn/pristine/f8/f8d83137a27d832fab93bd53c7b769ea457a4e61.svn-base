 402   2          }
 403   1          else
 404   1          {
 405   2              ucHact &= 0x03;
 406   2              if (ucHact == 0x00)
C51 COMPILER V9.53.0.0   DRVHDMIRXDSCDEC                                                   02/13/2025 10:14:19 PAGE 8   

 407   2              {
