  54          u8 Drv_HdmiRxDscDec_TimingGet(void)
  55          {
  56   1          u8 ucCnt, ucNum;
  57   1          u16 usCrt = 0, usLast = 0;
  58   1      
  59   1          //=================wait video check stable=====================
  60   1          ucCnt = 0;
  61   1          ucNum = 150;
  62   1          while(ucNum--)
  63   1          {
  64   2              Ocm_Delay1ms(2);
  65   2              usCrt = PACK_16_BIT(BKC8_56_REG, BKC8_57_REG);
  66   2              if (usLast == usCrt)
  67   2              {
  68   3                  ucCnt++;
  69   3                  if (ucCnt > 10)
  70   3                  {
  71   4                      break;
  72   4                  }
  73   3              }
  74   2              else
  75   2              {
  76   3                  ucCnt = 0;
  77   3                  usLast = usCrt;
  78   3              }
  79   2          }
  80   1          //=================wait video check stable=====================
  81   1      
  82   1          //get V timing by VideoCheck
  83   1          Drv_HdmiRx_RxTimingGet(&g_stHdmiDscDecTiming);
  84   1          //get H timing by EMP pkt
  85   1          g_stHdmiDscDecTiming.usHbp   = PACK_16_BIT(BKCB_3F_REG, BKCB_40_REG);
  86   1          g_stHdmiDscDecTiming.usHsync = PACK_16_BIT(BKCB_3D_REG, BKCB_3E_REG);
  87   1          g_stHdmiDscDecTiming.usHfp   = PACK_16_BIT(BKCB_3B_REG, BKCB_3C_REG);
  88   1          g_stHdmiDscDecTiming.usHact  = PACK_16_BIT(BKCB_42_REG, BKCB_43_REG);
  89   1          g_stHdmiDscDecTiming.usHtol  = PACK_16_BIT(BKCB_44_REG, BKCB_45_REG);
  90   1          #if CHIP_SEL == LT86121GXE
                  #if DSC_USER_DEFINE_PKT_EN == ENABLED
                  //get H timing by user define pkt
                  g_stHdmiDscDecTiming.usHbp   = ((u16)BKCC_79_REG << 8) + BKCC_7A_REG;
                  g_stHdmiDscDecTiming.usHsync = ((u16)BKCC_7B_REG << 8) + BKCC_7C_REG;
                  g_stHdmiDscDecTiming.usHfp   = ((u16)BKCC_7D_REG << 8) + BKCC_7E_REG;
                  g_stHdmiDscDecTiming.usHact  = ((u16)BKCC_7F_REG << 8) + BKCC_80_REG;
                  g_stHdmiDscDecTiming.usHtol  = ((u16)BKCC_81_REG << 8) + BKCC_82_REG;
                  //get V timing by user define pkt
                  g_stHdmiDscDecTiming.usVbp   = ((u16)BKCC_83_REG << 8) + BKCC_84_REG;
                  g_stHdmiDscDecTiming.usVsync = ((u16)BKCC_85_REG << 8) + BKCC_86_REG;
                  g_stHdmiDscDecTiming.usVfp   = ((u16)BKCC_87_REG << 8) + BKCC_88_REG;
                  g_stHdmiDscDecTiming.usVact  = ((u16)BKCC_89_REG << 8) + BKCC_8A_REG;
                  g_stHdmiDscDecTiming.usVtol  = ((u16)BKCC_8B_REG << 8) + BKCC_8C_REG;
                  #endif
                  #endif
 106   1      
 107   1          #if 1
 108   1          printLT(PRINT_PRIO_TEST, "\n==============DscDec Info==============");
 109   1          printLT(PRINT_PRIO_TEST, "\nHbp   : %-4d  Vbp   : %-4d", g_stHdmiDscDecTiming.usHbp,g_stHdmiDscDecTimi
