 450          void Drv_HdmiRxDscDec_ParamSet(void)
 451          {
 452   1          u8 ucTemp;
 453   1          u16 usTemp;
 454   1          u32 ulTemp;
 455   1      
 456   1          g_stHdmiDscDecInfo.ucSliceRemainder = (u8)(g_stHdmiDscDecInfo.usSliceWidth % 3);
 457   1          g_stHdmiDscDecInfo.usSliceGroup = (u16)(ceil((double)g_stHdmiDscDecInfo.usSliceWidth / 3));
 458   1      
 459   1          BKEE_98_REG |= BIT1_1;//[1]adaptive sync, timing follow
 460   1      
 461   1          if(g_stHdmiDscDecInfo.ucColorSpace == YCbCr422_1)//422
 462   1          {
 463   2              BKEE_89_REG = 0xe0;
 464   2              g_stHdmiDscDecInfo.ucGroupUnit = 0x04;
 465   2          }
 466   1          else
 467   1          {
 468   2              BKEE_89_REG = 0xac;
C51 COMPILER V9.53.0.0   DRVHDMIRXDSCDEC                                                   02/13/2025 10:14:19 PAGE 9   

 469   2              g_stHdmiDscDecInfo.ucGroupUnit = 0x03;
 470   2          }
 471   1      
 472   1          BKEE_81_REG  = g_stHdmiDscDecInfo.ucSliceRemainder << 6;
 473   1          BKEE_81_REG |= ((u8)(g_stHdmiDscDecInfo.usSliceGroup >> 8));
 474   1      
 475   1          if (BKEE_00_REG == 0x12)
 476   1              BKEE_81_REG |= BIT4_1;//[4]dsc version1.2a enable: 1-en
 477   1          else
 478   1              BKEE_81_REG &= BIT4_0;//[4]dsc version1.2a enable: 0-dis
 479   1      
 480   1          BKEE_82_REG  = (u8)g_stHdmiDscDecInfo.usSliceGroup;
 481   1      
 482   1          if (g_stHdmiDscDecInfo.ucColorDepth == BPC8)
 483   1          {
 484   2              BKEE_83_REG = 0x47;//EE83 BIT3-0:7+2*(BPC-8)
 485   2              BKEE_84_REG = 0x21;//EE84 BIT3-0:1+2*(BPC-8)
 486   2          }
 487   1          else
 488   1          {
 489   2              BKEE_83_REG = 0x4b;
 490   2              BKEE_84_REG = 0x85;
 491   2          }
 492   1      
 493   1          if (g_stHdmiDscDecInfo.ucColorDepth == BPC8)
 494   1          {
 495   2              if(g_stHdmiDscDecInfo.ucColorSpace == RGB_0)
 496   2                  BKEE_8D_REG = 0x0f;
 497   2              else
 498   2                  BKEE_8D_REG = 0x0e;
 499   2          }
 500   1          else
 501   1          {
 502   2              if(g_stHdmiDscDecInfo.ucColorSpace == RGB_0)
 503   2                  BKEE_8D_REG = 0x13;
 504   2              else
 505   2                  BKEE_8D_REG = 0x12;//12
 506   2          }
 507   1      
 508   1          //middle
 509   1          ulTemp = (u32)g_stHdmiDscDecInfo.usSliceWidth * (u32)g_stHdmiDscDecInfo.usBpp;
 510   1          ucTemp = (u8)(ulTemp & 0x0f);
 511   1          ulTemp = floor((double)ulTemp / 16);
 512   1          BKEE_8E_REG=(u8)(ulTemp >> 8);
 513   1          BKEE_8F_REG=(u8)(ulTemp);
 514   1      
 515   1          if (ucTemp == 0)
 516   1              BKEE_81_REG &= BIT3_0;//Bpp*SilceWidth: [3:0] is 0 ,ee81[3] is 0, otherwise is 1;
 517   1          else
 518   1              BKEE_81_REG |= BIT3_1;//Bpp*SilceWidth: [3:0] is 0 ,ee81[3] is 0, otherwise is 1;
 519   1      
 520   1          usTemp = 3 * g_stHdmiDscDecInfo.usBpp;
 521   1          usTemp = ceil((double)usTemp / (double)16);
 522   1          BKEE_8B_REG = usTemp + 8;
 523   1          BKEE_8C_REG = usTemp - g_stHdmiDscDecInfo.ucGroupUnit;
 524   1      
 525   1          usTemp = ceil((double)g_stHdmiDscDecInfo.usChunkSize / 6);
 526   1          BKEE_9A_REG = (u8)(usTemp >> 8);
 527   1          BKEE_9B_REG = (u8)(usTemp);
 528   1      
 529   1          //dsc last byte
 530   1          BKEE_9C_REG = (g_stHdmiDscDecInfo.usChunkSize + 6 - usTemp * 6) % 6;
C51 COMPILER V9.53.0.0   DRVHDMIRXDSCDEC                                                   02/13/2025 10:14:19 PAGE 10  

 531   1          BKEE_AB_REG=(u8)(usTemp >> 8);
 532   1          BKEE_AC_REG=(u8)(usTemp);
 533   1      
 534   1          if(g_stHdmiDscDecInfo.ucCoreNum == 0x01)
 535   1          {
 536   2              BKEE_A9_REG = 0x00;
 537   2              BKEE_AA_REG = 0x80;
 538   2              BKEE_97_REG &= BIT0_0;
 539   2          }
 540   1          else
 541   1          {
 542   2              //hact/2/slc*(slc-1)/slc + 16
 543   2              ucTemp = g_stHdmiDscDecInfo.ucCoreNum - 1;
 544   2              usTemp = g_stHdmiDscDecTiming.usHact >> 1;
 545   2              if (g_stHdmiDscDecInfo.ucColorSpace == YCbCr420_3)
 546   2              {
 547   3                  usTemp >>= 1;
 548   3              }
 549   2              usTemp *= ucTemp;
 550   2              ucTemp = g_stHdmiDscDecInfo.ucCoreNum * g_stHdmiDscDecInfo.ucCoreNum;
 551   2              usTemp = usTemp / ucTemp;
 552   2              usTemp += 16;
 553   2              BKEE_A9_REG = (usTemp >> 8) & 0xff;
 554   2              BKEE_AA_REG = usTemp & 0xff;
 555   2              BKEE_97_REG |= BIT0_1;
 556   2          }
 557   1      
 558   1          //start
 559   1          if(g_stHdmiDscDecInfo.ucCoreNum == 0x01)
 560   1          {
 561   2              ucTemp = 0x80;
 562   2          }
 563   1          else if(g_stHdmiDscDecInfo.ucCoreNum == 0x02)
 564   1          {
 565   2              ucTemp = 0xc0;
 566   2          }
 567   1          else
 568   1          {
 569   2              ucTemp = 0xe0;
 570   2          }
 571   1      
 572   1          BKEE_80_REG = 0x00;
 573   1          BKEE_F8_REG = 0x00;
 574   1          Ocm_Delay1ms(20);
 575   1          BKEE_F8_REG = 0xff;
 576   1          BKEE_80_REG = g_stHdmiDscDecInfo.ucSliceNum | ucTemp;
 577   1      }
