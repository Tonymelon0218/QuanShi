 119          u8 Drv_HdmiRxDscDec_DscInfoGet(void)
 120          {
 121   1          u16 usPpsDetCnt;
 122   1          u16 temp0, temp1;
 123   1      
 124   1          usPpsDetCnt = 0;
 125   1          Drv_System_IntClr(IRQ_HDMIRX_PPS_LOAD_SUCC_INT);
 126   1          while(usPpsDetCnt < 500)
 127   1          {
 128   2              usPpsDetCnt++;
 129   2              Ocm_Delay1us(100);
 130   2              if (Drv_System_IntFlagGet(IRQ_HDMIRX_PPS_LOAD_SUCC_INT) == TRUE)//[3]pps packet interrupt flag
 131   2              {
 132   3                  Ocm_Delay1us(10);//must be wait load success
 133   3                  BKEE_AD_REG = 0xff;//important, ee00 ~ ee80 update, must be set
 134   3                  Ocm_Delay1ms(1);
 135   3                  if ((BKEE_00_REG >= 0x11) && (BKEE_00_REG <= 0x13))
 136   3                  {
 137   4                      break;
 138   4                  }
 139   3              }
 140   2          }
 141   1          printLT(PRINT_PRIO_HIG, "\nPps Version Cnt = %d", usPpsDetCnt);
 142   1      
 143   1          //packet mode set to RGB
 144   1          BKCC_10_REG |= BIT0_1;//[0]color space en
 145   1          BKCC_10_REG &= 0x8f;//[6:4]color space value: 0-RGB, 1-YUV422, 2-YUV444, 3-YUV420
 146   1          BKCC_0F_REG |= BIT2_1;//[2]rgd_audc_cd_sel: 1-software configure color depth value
 147   1          BKCC_0F_REG &= 0x0f;//[7:4]color depth value: 4-8bit
 148   1          BKCC_0F_REG |= 0x40;//4-8bit
 149   1      
 150   1          #if CHIP_SEL == LT86121GXE
                  if((g_stHdmiRx.ucPixelEncoding == RGB_0)||(g_stHdmiRx.ucPixelEncoding == RGB_WIDE_4))
                  {
                      Drv_CscRx_Set(Y422_TO_RGB_7);//yuv422 -> rgb888
                  }
                  else if(g_stHdmiRx.ucPixelEncoding == YCbCr444_2)
                  {
                      Drv_CscRx_Set(Y422_TO_Y444_8);//yuv422 -> yuv444
                  }
                  #endif
 160   1      
 161   1          //color space and depth get
 162   1          g_stHdmiDscDecInfo.ucColorDepth = (BKEE_03_REG >> 5);//8 bit = 0x04, so >> 4 and /2, is >> 5
 163   1          if (BKEE_58_REG & BIT0_1)
 164   1              g_stHdmiDscDecInfo.ucColorSpace = YCbCr422_1;
 165   1          else if (BKEE_58_REG & BIT1_1)
 166   1              g_stHdmiDscDecInfo.ucColorSpace = YCbCr420_3;
 167   1          else if (BKEE_04_REG & BIT3_1)
 168   1              g_stHdmiDscDecInfo.ucColorSpace = SIMPLE422_5;
 169   1          else if (BKEE_04_REG & BIT4_1)//pps4[4]: 1-RGB, 0-nonRGB
 170   1              g_stHdmiDscDecInfo.ucColorSpace = RGB_0;
 171   1          else
 172   1              g_stHdmiDscDecInfo.ucColorSpace = YCbCr444_2;
C51 COMPILER V9.53.0.0   DRVHDMIRXDSCDEC                                                   02/13/2025 10:14:19 PAGE 4   

 173   1      
 174   1          g_stHdmiDscDecInfo.usBpp = ((u16)(BKEE_04_REG & 0x03) << 8) + BKEE_05_REG;
 175   1      
 176   1          temp1 = g_stHdmiDscDecInfo.usBpp;
 177   1          if (g_stHdmiDscDecInfo.ucColorSpace == YCbCr422_1)
 178   1          {
 179   2               temp0 = 24;//24/bpp
 180   2               temp1 >>= 1;
 181   2          }
 182   1          else if(g_stHdmiDscDecInfo.ucColorSpace == YCbCr420_3)
 183   1          {
 184   2               temp0 = 12;
 185   2               temp1 >>= 1;
 186   2          }
 187   1          else
 188   1          {
 189   2               temp0 = 24;
 190   2          }
 191   1          temp0 *= 160;
 192   1          g_stHdmiDscDecInfo.ucCompressRatio = (u8)(temp0 / temp1);
 193   1      
 194   1          temp0 = ((u16)BKEE_08_REG << 8) + BKEE_09_REG;
 195   1          temp1 = ((u16)BKEE_0C_REG << 8) + BKEE_0D_REG;
 196   1          g_stHdmiDscDecInfo.ucSliceNum = temp0 / temp1;
 197   1          if (g_stHdmiDscDecInfo.ucSliceNum > 4)
 198   1          {
 199   2              printLT(PRINT_PRIO_HIG, "\nWarning: the dp rx dsc number more than 4");
 200   2              return NOT_SUPPORT;
 201   2          }
 202   1      
 203   1          g_stHdmiDscDecInfo.usSliceHeight = ((u16)BKEE_0A_REG << 8) + BKEE_0B_REG;
 204   1          g_stHdmiDscDecInfo.usSliceWidth  = ((u16)BKEE_0C_REG << 8) + BKEE_0D_REG;
 205   1          if ((g_stHdmiDscDecInfo.ucColorSpace == YCbCr422_1) || (g_stHdmiDscDecInfo.ucColorSpace == YCbCr420_3)
             -)//420 or 422 or simple_422
 206   1          {
 207   2              g_stHdmiDscDecInfo.usSliceWidth >>= 1;
 208   2          }
 209   1          if (g_stHdmiDscDecInfo.ucColorSpace == YCbCr420_3)
 210   1          {
 211   2              g_stHdmiDscDecInfo.usSliceHeight >>= 1;
 212   2          }
 213   1      
 214   1          g_stHdmiDscDecInfo.usChunkSize = ((u16)BKEE_0E_REG << 8) + BKEE_0F_REG;
 215   1          g_stHdmiDscDecInfo.ucCoreNum = g_stHdmiDscDecInfo.ucSliceNum;
 216   1      
 217   1          return CAN_RUNNING;
 218   1      }
