 412   3                  g_stHdmiDscDecInfo.ucExtraHact = g_stHdmiDscDecInfo.ucSliceNum - ucHact;
 413   3              }
 414   2          }
 415   1          BKEE_9F_REG &= 0xf3;//[3:2]The number of extend pixel
 416   1          BKEE_9F_REG |= ((g_stHdmiDscDecInfo.ucExtraHact << 2) & 0x0c);
