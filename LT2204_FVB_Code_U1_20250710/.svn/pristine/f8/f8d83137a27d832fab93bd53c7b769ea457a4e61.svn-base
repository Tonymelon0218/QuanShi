 325          void Drv_HdmiRxDscDec_DataClkMuxSet(void)
 326          {
 327   1          u8 ucDiv;
 328   1          u32 ulDscRdClk;
 329   1          u32 ulDivPcrClk;
 330   1      
 331   1          //data mux set
 332   1          BKC7_D7_REG |= BIT6_1;//[6]dsc to dhtx
 333   1      
 334   1          //secpcr pll set
 335   1          BKA3_45_REG |= 0x11;//[4]rg_clkgen_dscin_clk_recvsel: 1-aa_secpcrpll_dsc_in_clk
 336   1                              //[0]rg_clkgen_pix_clk_recvsel  : 1-aa_secpcrpll_pix_clk
 337   1          BKA3_46_REG = 0x01;//[2:0]rg_clkgen_pcr_clk_recvsel : 001-aa_secpcrpll_pcr_clk
 338   1      
 339   1          //ad dscrx dsc rd clk set
 340   1          BKA3_40_REG = (BKA3_40_REG&0xf0)|0x01;//0001-div2 2F/2
 341   1          if (g_stHdmiDscDecInfo.ucCompressRatio <= 10)
 342   1          {
 343   2              if (g_stHdmiDscDecInfo.ucColorSpace != YCbCr420_3)
 344   2              {
 345   3                  BKA3_40_REG = (BKA3_40_REG&0xf0)|0x00;//0000-div1 2F/1
 346   3              }
C51 COMPILER V9.53.0.0   DRVHDMIRXDSCDEC                                                   02/13/2025 10:14:19 PAGE 7   

 347   2      
 348   2              Drv_System_FmSet(TOP_FM,TOPFM_AD_DSCRX_DSC_RD_CLK);
 349   2              Ocm_Delay1ms(10);
 350   2              ulDscRdClk = Drv_System_FmGet(TOP_FM, HALF_PIX_CLK);
 351   2      
 352   2              Drv_System_FmSet(TOP_FM,TOPFM_AD_PCRPLL_DIV_PCR_CLK);
 353   2              Ocm_Delay1ms(10);
 354   2              ulDivPcrClk = Drv_System_FmGet(TOP_FM, HALF_PIX_CLK);
 355   2      
 356   2              if ((ulDscRdClk > 0xb0c20) || (ulDscRdClk < ulDivPcrClk))//dsc rd clk max speed is 724M
 357   2              {
 358   3                  BKA3_28_REG |= 0x02;//[1:0]rg_pcrpll_dscrx_dscrd_muxsel: 10-aa_pll_half_pix_clk
 359   3                  BKA3_40_REG = 0x21; //[6:4]rg_clkgen_dscrx_dscrd_muxsel: 010-aa_pcrpll_dscrx_dscrd_clk 
 360   3              }
 361   2          }
 362   1      
 363   1          //ad dscrx dsc clk set
 364   1          ucDiv = g_stHdmiDscDecInfo.ucCoreNum;
 365   1          if (g_stHdmiDscDecInfo.ucColorSpace == YCbCr422_1)
 366   1          {
 367   2              ucDiv <<= 1;
 368   2              if(((g_stHdmiDscDecTiming.usHtol - g_stHdmiDscDecTiming.usHact) <= 200)&&(g_stHdmiDscDecInfo.ucCor
             -eNum == 4))
 369   2              {
 370   3                 ucDiv >>= 1;
 371   3              }
 372   2          }
 373   1          if (ucDiv == 1)
 374   1          {
 375   2              BKA3_3F_REG = (BKA3_3F_REG&0xf0)| 0x02;//0010-div3
 376   2          }
 377   1          else
 378   1          {
 379   2              ucDiv = 0x08 | (ucDiv - 1);
 380   2              BKA3_3F_REG  = (BKA3_3F_REG&0xf0)| ucDiv;
 381   2          }
 382   1          if ((g_stHdmiDscDecInfo.ucColorSpace == YCbCr420_3)&&((g_stHdmiDscDecTiming.usHtol - g_stHdmiDscDecTim
             -ing.usHact) <= 200)&&(g_stHdmiDscDecInfo.ucCoreNum == 4))
 383   1          {
 384   2              BKA3_3F_REG &= 0xf0;
 385   2              BKA3_3F_REG |= 0x0a;   //0x0b->0x0a
 386   2          }
 387   1      }
