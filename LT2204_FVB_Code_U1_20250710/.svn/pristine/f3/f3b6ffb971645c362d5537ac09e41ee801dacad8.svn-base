              //5v high and dp tx hpd high
              
              // rterm toggle for source det 
              //1s 0-200ms rterm is on 200-1000ms rterm is off
              
              void Mode_Sleep_RtermSet(u8 b1TermEn)
              {
                  if(b1TermEn == ENABLED)
                  {
                      BKA1_08_REG |= BIT3_1;//[3]rg_dhrx_en: 0-dis, 1-en;
                      BKA1_09_REG = 0x0f;
                  }
C51 COMPILER V9.53.0.0   MODTMDSRX                                                         02/13/2025 10:14:10 PAGE 7   

                  else
                  {
                      BKA1_08_REG |= BIT3_1;//[3]rg_dhrx_en: 0-dis, 1-en;
                      BKA1_09_REG = 0x00; //rterm disable
                  } 
              }
              
              void Mode_Sleep_AnaPowerSet(u8 b1IsSleep)
              {
                  if(b1IsSleep == ENABLED)
                  {
                      BKA3_00_REG &= BIT7_0;//[7]rg_syspll_pd: 0-normal work, 1-power down;
                      BKE1_0F_REG &= BIT3_0;
                      BKE1_0F_REG |= BIT3_1; //SYSPLL SW RESET
              
                      
                      BKA1_08_REG |= BIT3_1;//[3]rg_dhrx_en: 0-dis, 1-en;
                      BKA1_09_REG = 0xff;
                      BKA1_0A_REG = 0xf8;//d2 d3 pkdet enable
                       
                      BKA1_1F_REG = 0x10;//[4]rg_dhrxpi_bias_en: 1-en
                                         //[3:0]rg_dhrxpi_pd: 4'b0000 = four channel normal
                       
                      BKA1_30_REG = 0x68;// rxpll on
                      BKA1_30_REG &= BIT6_0;//[6]rg_dhrxpll_rst_n: 0-en
                      BKA1_30_REG |= BIT6_1;//[6]rg_dhrxpll_rst_n: 1-dis
                       
                      BKA1_48_REG = 0x50;///TX PLL POWER DOWN
                      BKA1_58_REG |= BIT7_1;///TX PHY enable
                      
                      BKA3_20_REG &= BIT4_0;//pcrpll pd
                      
                      #if SYSCLK == SYS_CLK_40M
                      BKE6_E9_REG |= 0x50;//
                      #endif
                      #if SYSCLK == SYS_CLK_48M
                      BKE6_E9_REG |= 0x60;//
                      #endif
                  }
                  else
                  {
                      BKE6_E9_REG &= 0x8f;//clk sel 25M
                      
                      BKA1_08_REG |= BIT3_1;//[3]rg_dhrx_en: 0-dis, 1-en;
                      BKA1_09_REG = 0x0f;
                      BKA1_0A_REG = 0xC8;//d2 d3 pkdet enable
                       
                      BKA1_1F_REG = 0x0f;//[4]rg_dhrxpi_bias_en: 0-dis;
                                         //[3:0]rg_dhrxpi_pd: 4'b1111 = four channel power down.
              
                      BKA1_30_REG |= BIT7_1; //dhrxpll_pd
                      BKA1_30_REG &= BIT3_0; //dhrxpll bias pd    
              
                      BKA1_48_REG |= BIT7_1;///TX PLL POWER DOWN
                      BKA1_48_REG &= BIT4_0;//Ttxpll ibas down
                      BKA1_58_REG &= BIT7_0;///TX PHY disable
                      
                      BKA3_20_REG |= BIT4_1;//pcrpll pd
                      
                      BKA3_00_REG = 0x80;// [7]rg_syspll_pd: 0-normal work, 1-power down; 
                  }
              }
C51 COMPILER V9.53.0.0   MODTMDSRX                                                         02/13/2025 10:14:10 PAGE 8   

              
              void Mod_Sleep_TmdsNoVideoDet(void)
              {
                  static u32 ulCurrentTime = 0;
                  switch(g_stSleep.ucSleepState)
                  {
                      case SLEEP_INIT_0:
                          if((g_stHdmiRx.ucHdmiVer == HDMI21)&&(Drv_System_IntSrcGet(IRQ_TMDS_PKDET_INT) == FALSE))//hdm
             -i2.1 no peakdet
                          {
                              g_stSleep.ucSleepState = SLEEP_ENTER_1;
                              g_stSleep.ucSleepChgFlag = TRUE;  
                          }
                          else if((g_stHdmiRx.ucHdmiVer <= HDMI20)&&(((BKE3_24_REG & BIT5_1) == 0x00)||(Drv_System_IntSr
             -cGet(IRQ_TMDS_PKDET_INT) == FALSE))) //hdmi2.0 peak or clk not det
                          {
                              g_stSleep.ucSleepState = SLEEP_ENTER_1;
                              g_stSleep.ucSleepChgFlag = TRUE; 
                          }
                          else 
                          {
                               g_stSleep.ucSleepState = SLEEP_INIT_0; 
                          }
                          break;
                      case SLEEP_ENTER_1:
                          if(g_stSleep.ucSleepChgFlag == TRUE)
                          {
                              g_stSleep.ucSleepChgFlag = FALSE;
                              Ocm_Timer_UpdLocalTime(&ulCurrentTime);
                          }
                          if(Ocm_Timer_IsOverFlow(&ulCurrentTime, SECOND_6) == TRUE)
                          {
                              printLT(PRINT_PRIO_HIG, "\nRx Sleep");
                              g_stHdmiRx.ucRxState = STATE_HDMIRX_TMDSCLK_STB_CHK_5;
                              Mode_Sleep_AnaPowerSet(DISABLED);
                              Mod_Sleep_DigPowerDown(); 
                              Drv_System_IntSet(IRQ_HDMIRX_FRL_INT, OFF);
                              g_stSleep.ucSleepState = SLEEP_TOGGLE_RTERM_ON_2;
                              g_stSleep.ucSleepChgFlag = TRUE; 
                                  
                          }
                          if((g_stHdmiRx.ucHdmiVer == HDMI21)&&(Drv_System_IntSrcGet(IRQ_TMDS_PKDET_INT) == TRUE))//hdmi
             -2.1 peak det true
                          {
                               g_stSleep.ucSleepState = SLEEP_INIT_0;
                          }
                          else if((g_stHdmiRx.ucHdmiVer <= HDMI20)&&(BKE3_24_REG & BIT5_1)) //hdmi2.0 clk det
                          {
                               g_stSleep.ucSleepState = SLEEP_INIT_0;
                          }
                          break;
                      case SLEEP_TOGGLE_RTERM_ON_2://toggle term_on
                          if(g_stSleep.ucSleepChgFlag == TRUE)
                          {
                              g_stSleep.ucSleepChgFlag = FALSE;
                              Ocm_Timer_UpdLocalTime(&ulCurrentTime);
                          }
                          if(Ocm_Timer_IsOverFlow(&ulCurrentTime, MS_800) == TRUE)
                          {
                              g_stSleep.ucSleepState   = SLEEP_TOGGLE_RTERM_OFF_3;
                              g_stSleep.ucSleepChgFlag = TRUE;  
                              Mode_Sleep_RtermSet(ENABLED); 
C51 COMPILER V9.53.0.0   MODTMDSRX                                                         02/13/2025 10:14:10 PAGE 9   

                          }
                          break;
                      case SLEEP_TOGGLE_RTERM_OFF_3: //toggle_term off
                          if(g_stSleep.ucSleepChgFlag == TRUE)
                          {
                              g_stSleep.ucSleepChgFlag = FALSE;
                              Ocm_Timer_UpdLocalTime(&ulCurrentTime);
                          }
                          if(Ocm_Timer_IsOverFlow(&ulCurrentTime, MS_300) == TRUE)
                          {
                              g_stSleep.ucSleepState   = SLEEP_TOGGLE_RTERM_ON_2;
                              g_stSleep.ucSleepChgFlag = TRUE; 
                              Mode_Sleep_RtermSet(DISABLED);
                          }
                          break;
                      case SLEEP_EXIT_4:
                          break;
                      case SLEEP_END_5:
                          break;
                      default:
                          break;
                  }
                  if(((Drv_System_IntSrcGet(IRQ_TMDS_PKDET_INT) == TRUE)&&((BKE3_24_REG & BIT5_1)||(BKCD_E6_REG & 0x51)|
             -|(BKCD_B5_REG & 0x0f)))// pkdet enable
                    ||(BKCA_BD_REG & BIT0_1))//hdcp det
                  {
                      if((g_stSleep.ucSleepState == SLEEP_TOGGLE_RTERM_OFF_3)||(g_stSleep.ucSleepState == SLEEP_TOGGLE_R
             -TERM_ON_2))
                      {
                          g_stSleep.ucSleepState  = SLEEP_EXIT_4;
                          Mode_Sleep_AnaPowerSet(ENABLED);
                          printLT(PRINT_PRIO_HIG, "\nToggle End");     
                      }
                  }
              }
              
              void Mod_Sleep_TmdsPowerOn(void)
              {
                  if(g_stSleep.ucSleepState < SLEEP_EXIT_4)
                  {
                       return;
                  }
                  if((Drv_System_IntSrcGet(IRQ_TMDS_PKDET_INT) == TRUE)&&(BKE3_24_REG & BIT5_1)&&((BKCD_B5_REG & 0x0f)==
             - 0x00))
                  {
                      g_stSleep.ucSleepState = SLEEP_INIT_0;
                      Mod_Sleep_DigPowerOn();
                      g_stHdmiRx.ucRxState = STATE_HDMIRX_TMDSCLK_STB_CHK_5;
                      g_stHdmiRx.b1RxStateChanged = TRUE;
                      printLT(PRINT_PRIO_HIG, "\nTmds Exit"); 
              
                  }
              }
              
              void Mod_Sleep_FrlPowerOn(void)
              {
                  if(g_stSleep.ucSleepState < SLEEP_EXIT_4)
                  {
                       return;
                  }
                  if((Drv_System_IntSrcGet(IRQ_TMDS_PKDET_INT) == TRUE)&((BKCD_E6_REG & 0x51)||(BKCD_B5_REG & 0x0f)))
                  {
C51 COMPILER V9.53.0.0   MODTMDSRX                                                         02/13/2025 10:14:10 PAGE 10  

                      g_stSleep.ucSleepState = SLEEP_INIT_0;
                      Mod_Sleep_DigPowerOn();
                      Drv_System_IntSet(IRQ_HDMIRX_FRL_INT, ON);
                      g_stHdmiRx.ucRxState = STATE_HDMIRX_WAIT_FRL_TRAIN_7;
                      g_stHdmiRx.b1RxStateChanged = TRUE;
                      printLT(PRINT_PRIO_HIG, "\nFrl Exit");
                  }
              }
              
              //----------------------------------------------------------SLEEP MOde2 END-------------------------------
             ---------------------------------
              
              #endif
              
