              void Mode_Sleep_HdmiRxPowerdown(u8 b1PowerDownEn)
              {
                  static u32 ulCurrentTime = 0;
                  switch(g_stSleep.ucRxPowerdownState)
                  {
                      case SLEEP_INIT_0:
                          g_stSleep.ucRxPowerdownState = SLEEP_ENTER_1 ;
                          g_stSleep.ucRxPowerdownChgFlag = TRUE;
                          break;
                      case SLEEP_ENTER_1:
                          if(g_stSleep.ucRxPowerdownChgFlag == TRUE)
                          {
                              g_stSleep.ucRxPowerdownChgFlag = FALSE;
                              Ocm_Timer_UpdLocalTime(&ulCurrentTime);
                          }
                          if(Ocm_Timer_IsOverFlow(&ulCurrentTime, MS_500) == TRUE)
                          {
                              printLT(PRINT_PRIO_HIG, "\nHdmiRx PowerDown");
                              Drv_Sys_DHRxPowerDomain(TRUE);
                              Drv_Sys_DHTxPowerDomain(TRUE);
                              Mod_Sleep_AnaPowerDown();
                              Mod_Sleep_DigPowerDown();
                              g_stSleep.ucRxPowerdownState = SLEEP_EXIT_4;
                              
                          }
                          break;
                      case SLEEP_EXIT_4:
                          if(b1PowerDownEn == DISABLED)
                          {
                              Drv_Sys_DHRxPowerDomain(FALSE);
                              Drv_Sys_DHTxPowerDomain(FALSE);
                              Mod_Sleep_AnaPowerOn();
                              Mod_Sleep_DigPowerOn(); 
                              Drv_System_XtalSet();
                              printLT(PRINT_PRIO_HIG, "\nHdmiRx PowerOn"); 
                              Drv_HdmiRx_PowerOnInit();
                              Drv_DpTx_PowerOnInit();
                              Drv_Sys_HdcpKeyLoad();  //solve RX/TX power domain ,key will lost issue
                              g_stSleep.ucRxPowerdownState = SLEEP_END_5;    
                          }
                          break;
                    case SLEEP_END_5:      
                          break;
                      default:
                          break;
                  }
              }
              
              void Mode_Sleep_DpTxPowerdown(u8 b1PowerDownEn)
              {
                  static u32 ulCurrentTime = 0;
                  switch(g_stSleep.ucTxPowerdownState)
                  {
C51 COMPILER V9.53.0.0   MODTMDSRX                                                         02/13/2025 10:14:10 PAGE 6   

                      case SLEEP_INIT_0:
                          g_stSleep.ucTxPowerdownState = SLEEP_ENTER_1 ;
                          g_stSleep.ucTxPowerdownChgFlag = TRUE;
                          break;
                      case SLEEP_ENTER_1:
                          if(g_stSleep.ucTxPowerdownChgFlag == TRUE)
                          {
                              g_stSleep.ucTxPowerdownChgFlag = FALSE;
                              Ocm_Timer_UpdLocalTime(&ulCurrentTime);
                          }
                          if(Ocm_Timer_IsOverFlow(&ulCurrentTime, MS_500) == TRUE)
                          {
                              printLT(PRINT_PRIO_HIG, "\nDpTx PowerDown");
                              Drv_Sys_DHRxPowerDomain(TRUE);
                              Drv_Sys_DHTxPowerDomain(TRUE);
                              Mod_Sleep_AnaPowerDown();
                              Mod_Sleep_DigPowerDown();
                              g_stSleep.ucTxPowerdownState = SLEEP_EXIT_4;
                              
                          }
                          break;
                      case SLEEP_EXIT_4:
                          if(b1PowerDownEn == DISABLED)
                          {
                              Drv_Sys_DHRxPowerDomain(FALSE);
                              Drv_Sys_DHTxPowerDomain(FALSE);
                              Mod_Sleep_AnaPowerOn();
                              Mod_Sleep_DigPowerOn();
                              Drv_System_XtalSet();   
                              printLT(PRINT_PRIO_HIG, "\nDpTx PowerOn");
                              Drv_HdmiRx_PowerOnInit();
                              Drv_DpTx_PowerOnInit();
                              Drv_Sys_HdcpKeyLoad();//solve RX/TX power domain ,key will lost issue
                              g_stSleep.ucTxPowerdownState = SLEEP_END_5;
                                  
