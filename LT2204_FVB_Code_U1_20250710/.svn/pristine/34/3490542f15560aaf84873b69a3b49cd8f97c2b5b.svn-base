#include "include.h"

#if RX_PORT_SIGN == DP_PORT

#if DPRX_DSC_DEC_SUPPORT == ENABLED


//===============================专用定义================================
DscDecInfo_S g_stDpRxDscDecInfo;//dsc相关的信息
LtTiming_S g_stDpRxDscDecTiming;//把色彩空间和色深放在video info
//=======================================================================


void Drv_DpRxDscDec_ParaInit(void)
{
    memset(&g_stDpRxDscDecInfo, 0, sizeof(DscDecInfo_S));
    memset(&g_stDpRxDscDecTiming, 0, sizeof(LtTiming_S));
}

void Drv_DpRxDscDec_RxInit(void)
{
    BKEE_86_REG = 0x1F;
    
    BKEE_97_REG = 0x00;
    BKEE_A7_REG = 0x3a;//[5], [4], [3], [1] set 1
   
                      //[4]set to 1, than pps can load from pps sram
                      //[4]set to 0, than pps can load from register

    Drv_System_SramPathSet(DPRX_DSCDEC_PPS_PATH);

    Drv_System_IntSet(IRQ_DPRX_PPS_PKT_INT,ON);
//    Drv_System_IntClr(IRQ_DPRX_PPS_PKT_INT);

    BKF3_00_REG = 0x06;//pixel count save for fifo for dsc
    //color depth force to 8bit for dsc mode
    BKF3_0A_REG |= BIT7_1;//[7]rg_depth_soft_mode, 1-soft mode
    BKF3_16_REG &= 0xe3;
    BKF3_16_REG |= BIT2_1;//[4:2]the value of pixel_depth in soft mode
    //color space force to RGB for dsc mode
    
    BKF3_05_REG |= BIT7_1;//[7]rg_format_soft_mode, 1-soft mode
    BKF3_16_REG &= 0xfc;//[1:0]the value of pixel_format in soft mode 

    //[7]dp dsc stream
    BKF3_63_REG |= 0xd0;//[4]software dsc enable
                       //[7]dsc data swap enable: 1-en; [6]Dsc enable select: 1-software en;
    BKF3_69_REG = 0x08;//hsync width
    BKF3_82_REG = 0x20;//hsync delay

//    BKF3_77_REG |= BIT0_1;//[0]rg_pcr_restart_mode: 1-h count dealy value more than rgd_step_hsync
    BKF3_83_REG |= BIT7_1;//[7]rg_dsc_bypass: 1-not bypass
    
    BKA3_27_REG = 0x00;
    BKA3_28_REG = 0x00;//for hblanking  = 80 issue
}

u8 Drv_DpRxDscDec_TimingGet(void)
{
    Drv_DpRx_RxTimingGet(&g_stDpRxDscDecTiming);//-wangtt- wait update

    #if 1
    printLT(PRINT_PRIO_TEST, "\n=================DscDec Info=================");
    printLT(PRINT_PRIO_TEST, "\nHbp   : %-4d  Vbp   : %-4d", g_stDpRxDscDecTiming.usHbp,g_stDpRxDscDecTiming.usVbp);
    printLT(PRINT_PRIO_TEST, "\nHfp   : %-4d  Vfp   : %-4d", g_stDpRxDscDecTiming.usHfp,g_stDpRxDscDecTiming.usVfp);
    printLT(PRINT_PRIO_TEST, "\nHsync : %-4d  Vsync : %-4d", g_stDpRxDscDecTiming.usHsync,g_stDpRxDscDecTiming.usVsync);
    printLT(PRINT_PRIO_TEST, "\nHact  : %-4d  Vact  : %-4d", g_stDpRxDscDecTiming.usHact,g_stDpRxDscDecTiming.usVact);
    printLT(PRINT_PRIO_TEST, "\nHtol  : %-4d  Vtol  : %-4d", g_stDpRxDscDecTiming.usHtol,g_stDpRxDscDecTiming.usVtol);
    #endif

//    if (g_stDpRxDscDecTiming.usHact > 5120)//dsc decoder not support
//    {
//        printLT(PRINT_PRIO_TEST, "\n Dsc decoder not support > 5120 ");
//        return NOT_SUPPORT;
//    }
    return CAN_RUNNING;
}

u8 Drv_DpRxDsc_SliceNum(void)
{
    u16 temp0,temp1;
    temp0 = ((u16)BKEE_08_REG << 8) + BKEE_09_REG; // pic_width
    temp1 = ((u16)BKEE_0C_REG << 8) + BKEE_0D_REG; // slice_width
    return (temp0/temp1);
}

u8 Drv_DpRxDscDec_DscInfoGet(void)
{
//    u16 usPpsDetCnt;
    u16 temp0, temp1;
	Ocm_Delay1us(10);//must be wait load success
	BKEE_AD_REG = 0xff;//important, ee00 ~ ee80 update, must be set
	Ocm_Delay1ms(1);
	if ((BKEE_00_REG >= 0x11) && (BKEE_00_REG <= 0x13))
	{
		printLT(PRINT_PRIO_HIG, "\nPPs LOAD SUCCEED");
	}
	else
	{
		return NOT_SUPPORT;
	}
    //color space and depth get
    g_stDpRxDscDecInfo.ucColorDepth = (BKEE_03_REG >> 5);//8 bit = 0x04, so >> 4 and /2，is >> 5
    if (BKEE_58_REG & BIT0_1)
        g_stDpRxDscDecInfo.ucColorSpace = YCbCr422_1;
    else if (BKEE_58_REG & BIT1_1)
        g_stDpRxDscDecInfo.ucColorSpace = YCbCr420_3;
    else if (BKEE_04_REG & BIT3_1)
        g_stDpRxDscDecInfo.ucColorSpace = SIMPLE422_5;
    else if (BKEE_04_REG & BIT4_1)//pps4[4]: 1-RGB, 0-nonRGB
        g_stDpRxDscDecInfo.ucColorSpace = RGB_0;
    else
        g_stDpRxDscDecInfo.ucColorSpace = YCbCr444_2;

    g_stDpRxDscDecInfo.usBpp = ((u16)(BKEE_04_REG & 0x03) << 8) + BKEE_05_REG;
    temp1 = g_stDpRxDscDecInfo.usBpp;
    temp0 = 3840;//8bpc * 3 * 160
    if (g_stDpRxDscDecInfo.ucColorSpace == YCbCr422_1)// || (g_stDpRxDscDecInfo.ucColorSpace == YCbCr420_3))
        temp1 >>= 1;

    g_stDpRxDscDecInfo.ucCompressRatio = (u8)(temp0 / temp1);

    g_stDpRxDscDecInfo.ucSliceNum = Drv_DpRxDsc_SliceNum();
    if (g_stDpRxDscDecInfo.ucSliceNum > 4)
    {
        printLT(PRINT_PRIO_HIG, "\nWarning: Slice >  4");
        return NOT_SUPPORT;
    }

    g_stDpRxDscDecInfo.usSliceHeight = ((u16)BKEE_0A_REG << 8) + BKEE_0B_REG;
    g_stDpRxDscDecInfo.usSliceWidth  = ((u16)BKEE_0C_REG << 8) + BKEE_0D_REG;
    if ((g_stDpRxDscDecInfo.ucColorSpace == YCbCr422_1) || (g_stDpRxDscDecInfo.ucColorSpace == YCbCr420_3))//420 or 422 or simple_422
    {
        g_stDpRxDscDecInfo.usSliceWidth >>= 1;
    }
    if (g_stDpRxDscDecInfo.ucColorSpace == YCbCr420_3)
    {
        g_stDpRxDscDecInfo.usSliceHeight >>= 1;
    }

    g_stDpRxDscDecInfo.usChunkSize = ((u16)BKEE_0E_REG << 8) + BKEE_0F_REG;
    g_stDpRxDscDecInfo.ucCoreNum   = g_stDpRxDscDecInfo.ucSliceNum;

    #if 1
    printLT(PRINT_PRIO_TEST, "\nSliceNumber   : %-4bd   DscNumber    : %-4bd", g_stDpRxDscDecInfo.ucSliceNum, g_stDpRxDscDecInfo.ucCoreNum);
    printLT(PRINT_PRIO_TEST, "\nCompressRatio : %-4bd   Bpp          : %-4d", g_stDpRxDscDecInfo.ucCompressRatio, g_stDpRxDscDecInfo.usBpp);
    printLT(PRINT_PRIO_TEST, "\nColorSpace    : %-4bd   ColorDepth   : %-4bd", g_stDpRxDscDecInfo.ucColorSpace, g_stDpRxDscDecInfo.ucColorDepth << 1);
    printLT(PRINT_PRIO_TEST, "\nGroupUnit     : %-4bd   ChunkSize    : %-4d", g_stDpRxDscDecInfo.ucGroupUnit, g_stDpRxDscDecInfo.usChunkSize);
    printLT(PRINT_PRIO_TEST, "\nSliceHeight   : %-4d   SliceWidth   : %-4d", g_stDpRxDscDecInfo.usSliceHeight, g_stDpRxDscDecInfo.usSliceWidth);
    printLT(PRINT_PRIO_TEST, "\n=============================================");
    #endif

    return CAN_RUNNING;
}

#if 0
void Drv_DpRxDscDec_SyncPolCvt(void)
{
    (!(BKC8_6F_REG&BIT5_1))? (BKEE_97_REG |= BIT6_1) : (BKEE_97_REG &= BIT6_0);//vsync pol
    (!(BKC8_6F_REG&BIT4_1))? (BKEE_97_REG |= BIT5_1) : (BKEE_97_REG &= BIT5_0);//hsync pol
}
#endif

void Drv_DpRxDscDec_DummySet(void)
{
    u16 temp0;
    u8 ucLaneCnt;
    u8 bIsDummyData = TRUE;
    #if CHIP_VERSION_SEL > U1_VERSION
	u16 usChunkSizeTmp = 0x00;
	#endif
    //dp rx chunk size set
    BKF3_63_REG &= BIT5_0;//[5]dsc data number of line is odd, 0-even
    #if DPRX_MST_MODE_EN == ENABLED
    ucLaneCnt = 4;//-wangtt- add judge, if rx is not mst mode when mst mode en is ENABLED
    #else
    ucLaneCnt = Mod_Aux_LinkCntGet();
    #endif
    switch(ucLaneCnt)
    {
        case 4://4lane
            temp0 = g_stDpRxDscDecInfo.usChunkSize % 12;
            if ((temp0 > 8) || (temp0 == 0))
                bIsDummyData = FALSE;

            if ((temp0 < 7) && (temp0 >= 1))
                BKF3_63_REG |= BIT5_1;//[5]dsc data number of line is odd, 1-odd
            break;

        case 2://2lane
            temp0 = g_stDpRxDscDecInfo.usChunkSize % 6;
            if ((temp0 == 0) || (temp0 == 5))
                bIsDummyData = FALSE;
            break;

        case 1://1lane
            temp0 = g_stDpRxDscDecInfo.usChunkSize % 3;
            if (temp0 == 0)
                bIsDummyData = FALSE;
            break;

        default:
            break;
    }

    if (bIsDummyData == FALSE)
    {
        BKF3_02_REG |= BIT6_1;//[6]no dummy in dsc mode: 1-is no dummy, 0-is dummy
        printLT(PRINT_PRIO_TEST, "\nDpRx is no dummy data");
    }
    else
    {
        BKF3_02_REG &= BIT6_0;//[6]no dummy in dsc mode: 1-is no dummy, 0-is dummy
        printLT(PRINT_PRIO_TEST, "\nDpRx have dummy data");
    }

    //chunk size
    BKF3_88_REG = g_stDpRxDscDecInfo.usChunkSize >> 8;
    BKF3_89_REG = g_stDpRxDscDecInfo.usChunkSize & 0xff;

    temp0 = g_stDpRxDscDecInfo.usChunkSize % 6;
    if (temp0 != 0)
    {
        BKF3_3E_REG &= 0x8f;
        BKF3_3E_REG |= (6 - temp0) << 4;//[6:4]dsc byte dummy number set of last data every chunk.
    }
    else
    {
        BKF3_3E_REG &= 0x8f;
    }

    BKF3_8F_REG &= 0xc0;
    BKF3_8F_REG |= g_stDpRxDscDecInfo.ucSliceNum;//[5:0]slice number per line in dsc mode
	
    #if CHIP_VERSION_SEL > U1_VERSION
	usChunkSizeTmp = g_stDpRxDscDecInfo.usChunkSize;
	if(g_stDpRxDscDecInfo.ucSliceNum == 1)
	{
		temp0 = ceil((double)usChunkSizeTmp / 6);
		if(temp0 % 2)
		{
			temp0 *= 4;
			BKF3_8A_REG = temp0 >> 8;
			BKF3_8B_REG = temp0 & 0xff;
			usChunkSizeTmp += 6;
			BKF3_1F_REG |= BIT0_1; //[0]eco en
			BKF3_88_REG = usChunkSizeTmp >> 8;
			BKF3_89_REG = usChunkSizeTmp & 0xff;
			BKF3_63_REG |= BIT3_1;
			BKF3_3E_REG &= 0x83;
			BKF3_3E_REG |= 0x04;
		}
		else
		{
			BKF3_8A_REG = 0x00;
			BKF3_8B_REG = 0x00;
			BKF3_1F_REG &= BIT0_0; //[0]eco disen
			BKF3_63_REG &= BIT3_0;
			BKF3_3E_REG &= 0x83;
		}
	}
    #endif
}
void Drv_DpRxDscDec_WordDelaySet(void)
{
    u8 ucRecord = 0x00;
    u16 usWordMin = 0x200;
    u16 usWordMax = 0xC00;
    u16 usWordDelay = 0x0400;
    u32 ulTemp0, ulTemp1;
    if(g_stDpRxDscDecInfo.ucCoreNum == 0x01)
    {
        usWordDelay = 0x0200;
    }
    else if(g_stDpRxDscDecInfo.ucCoreNum == 0x02)
    {
        if (g_stDpRxDscDecInfo.usBpp >= 384)//>bpp24
        {
            usWordDelay = 0x0140;
        }
        else if (g_stDpRxDscDecInfo.usBpp >= 320)//>bpp20
        {
            usWordDelay = 0x0200;
        }
        else if (g_stDpRxDscDecInfo.usBpp >= 256)//>bpp16
        {
            usWordDelay = 0x02c0;
        }
        else
        {
            usWordDelay = 0x0340;
        }
    }
    else
    {
        usWordDelay = 0x400;
        if (g_stDpRxDscDecTiming.usHact >= 7680)//8K
        {
//    -1.016*htotal -49.75*bpp + 0.00525*htotal*bpp + 11436

            ulTemp0 = (u32)1016 * (u32)g_stDpRxDscDecTiming.usHtol;
//            printf("\n===%ld===",ulTemp0);
            ulTemp0 = (u32)(ulTemp0 / 1000);
//            printf("\n===%ld===",ulTemp0);

            ulTemp1 = (u32)4975 * (u32)g_stDpRxDscDecInfo.usBpp;
            ulTemp1 = (u32)(ulTemp1/100);
//            printf("\n===%ld===",ulTemp1);

            ulTemp0 = (u32)(ulTemp0 + ulTemp1);
//            printf("\n===%ld===",ulTemp0);

            ulTemp1 = (u32)g_stDpRxDscDecTiming.usHtol * (u32)g_stDpRxDscDecInfo.usBpp;
            ulTemp1 = (u32)(ulTemp1 / 1000);
//            printf("\n===%ld===",ulTemp1);

            ulTemp1 = (u32)ulTemp1 * (u32)525;
            ulTemp1 = (u32)(ulTemp1/100);
            ulTemp1 = (u32)(ulTemp1 + 11436);
//            printf("\n===%ld===",ulTemp1);

            ulTemp1 =(u32)(ulTemp1 - ulTemp0);
//            printf("\n===%ld===",ulTemp1);
            usWordDelay = ulTemp1;
        }
    }
    
    if (g_stDpRxDscDecTiming.usHact < 7680)//8K
    {
        if (g_stDpRxDscDecInfo.ucColorDepth >= 0x05)//10bit??
        {
            usWordDelay += 0xc0; 
        }
    }

//    //    -1.016*htotal -49.75*bpp + 0.00525*htotal*bpp + 11436

//            ulTemp0 = (u32)1016 * (u32)g_stDpRxDscDecTiming.usHtol;
////            printf("\n===%ld===",ulTemp0);
//            ulTemp0 = (u32)(ulTemp0 / 1000);
////            printf("\n===%ld===",ulTemp0);

//            ulTemp1 = (u32)4975 * (u32)g_stDpRxDscDecInfo.usBpp;
//            ulTemp1 = (u32)(ulTemp1/100);
////            printf("\n===%ld===",ulTemp1);

//            ulTemp0 = (u32)(ulTemp0 + ulTemp1);
////            printf("\n===%ld===",ulTemp0);

//            ulTemp1 = (u32)g_stDpRxDscDecTiming.usHtol * (u32)g_stDpRxDscDecInfo.usBpp;
//            ulTemp1 = (u32)(ulTemp1 / 1000);
////            printf("\n===%ld===",ulTemp1);

//            ulTemp1 = (u32)ulTemp1 * (u32)525;
//            ulTemp1 = (u32)(ulTemp1/100);
//            ulTemp1 = (u32)(ulTemp1 + 11436);
////            printf("\n===%ld===",ulTemp1);

//            ulTemp1 =(u32)(ulTemp1 - ulTemp0);
////            printf("\n===%ld===",ulTemp1);
//            usWordDelay = ulTemp1;
            
    BKEE_87_REG = (usWordDelay >> 8);
    BKEE_88_REG = usWordDelay;
    printLT(PRINT_PRIO_HIG,"\n&&&&&&&&&&&&&&&&&&&");
    printLT(PRINT_PRIO_HIG,"\n======WORDDELAY = 0x%02bx,0x%02bx=====",BKEE_87_REG,BKEE_88_REG);
}
