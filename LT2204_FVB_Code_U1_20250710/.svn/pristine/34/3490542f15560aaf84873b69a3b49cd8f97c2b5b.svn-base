void Drv_DpRxDscDec_HstartCal(void)
{
    u8 ucMin, ucMax;
    //set Hsync to 04 
    if((g_stDpRxDscDecTiming.usHtol - g_stDpRxDscDecTiming.usHact) <= 80)
    {
        BKF3_69_REG = 0x04;
    }
    
    //bs issue, mate40 pro
    BKF3_82_REG = 0x08;
    while(BKF3_82_REG <= 0xf0)
    {
        BKF3_52_REG |= BIT5_1;
        BKF3_52_REG &= BIT5_0;
        Ocm_Delay1ms(20);
        if(BKF3_EB_REG & BIT5_1)//bs/de
        {
            BKF3_82_REG += 2;
        }
        else
        {
            break;
        }
    }
    ucMin = BKF3_82_REG;
	if(BKF3_82_REG >= 0xc0)
	{
		BKF3_82_REG = 0xff;
	}
	else
	{
		BKF3_82_REG += 0x40;
	}
    while(BKF3_82_REG >= ucMin)
    {
        BKF3_52_REG |= BIT5_1;
        BKF3_52_REG &= BIT5_0;
        Ocm_Delay1ms(20);
        if(BKF3_EB_REG & BIT5_1)
        {
            BKF3_82_REG -= 2;
        }
        else
        {
            break;
        }
    }
    ucMax = BKF3_82_REG;
	printLT(PRINT_PRIO_HIG, "\nucMin,ucMax = 0x%02bx",ucMin,ucMax);
    if (ucMax >= ucMin)
    {
        BKF3_82_REG = (ucMax + ucMin) / 2;
    }
    else
    {
        BKF3_82_REG = 0x20;
        printLT(PRINT_PRIO_HIG, "\nWarning: hstart err");
    }
	
    printLT(PRINT_PRIO_HIG, "\nDp rx Hstart is 0x%02bx, state is 0x%02bx", BKF3_82_REG, BKF3_EB_REG);
}

void Drv_DpRxDscDec_DataClkMuxSet(void)
{
    #define  MIN_DSC_HBLANK  40
    u8 ucDiv;
    u16 usHblank;
    u32 ulRdClk;
    u8 ucPcrpllDiv = 0;
        
    usHblank = (g_stDpRxDscDecTiming.usHtol - g_stDpRxDscDecTiming.usHact);
    BKC7_D7_REG |= BIT6_1;//[6]dsc dec to tx

    Drv_System_FmSet(TOP_FM,TOPFM_AD_DSCRX_DSC_RD_CLK);
    Ocm_Delay1ms(3);
    ulRdClk = Drv_System_FmGet(TOP_FM, HALF_PIX_CLK);
	    //ad_dscrx_dsc_rd_clk
	
    //ad_pcrpll_div_pcr_clk
    if (g_stDpRxDscDecInfo.ucCompressRatio >= 30)
    {
        ucDiv = 0x06;
//        BKA3_25_REG = 0x05;//[6:4]rg_pcrpll_half_tmdsck_divsel: 010-aa_pll_half_pix_clk
    }
    else if (g_stDpRxDscDecInfo.ucCompressRatio >= 25)
    {
        ucDiv = 0x05;
//        BKA3_25_REG = 0x04;//[6:4]rg_pcrpll_half_tmdsck_divsel: 010-aa_pll_half_pix_clk
    }
    else if (g_stDpRxDscDecInfo.ucCompressRatio >= 20)
    {
        ucDiv = 0x04;
//        BKA3_25_REG = 0x03;//[6:4]rg_pcrpll_half_tmdsck_divsel: 010-aa_pll_half_pix_clk
    }
    else if (g_stDpRxDscDecInfo.ucCompressRatio >= 15)
    {
        ucDiv = 0x03;
//        BKA3_25_REG = 0x02;//[6:4]rg_pcrpll_half_tmdsck_divsel: 010-aa_pll_half_pix_clk
    }
    else if (g_stDpRxDscDecInfo.ucCompressRatio >= 10)
    {
        ucDiv = 0x02;
//        BKA3_25_REG = 0x01;//[6:4]rg_pcrpll_half_tmdsck_divsel: 010-aa_pll_half_pix_clk
    }
    else
    {
        ucDiv = 0x01;
    }
    if(((u16)ucDiv * MIN_DSC_HBLANK) > usHblank)
    {
        ucDiv  = usHblank/MIN_DSC_HBLANK;
    }
    if((g_stDpRxDscDecInfo.ucCompressRatio > 10)&&(ulRdClk <= 50000))//half pixel clk < 50M
    {
        ucDiv = 2;
    }
    BKA3_25_REG = (ucDiv - 1);
    
    if(((g_stDpRxDscDecInfo.ucCompressRatio > 15)||((g_stDpRxDscDecInfo.ucCompressRatio > 10) &&(ulRdClk >= 360000)))&&(ucDiv > 1)) 
    {
        BKA3_40_REG = (BKA3_40_REG&0xf0)|0x01;//0001-div2 2f/2
    }
    else
    {
        BKA3_40_REG = (BKA3_40_REG&0xf0);//0001-div2 2f/2
    }
//    //ad_dscrx_dsc_rd_clk

    //ad_dscrx_dsc_clk
    ucDiv = g_stDpRxDscDecInfo.ucCoreNum;
    if ((g_stDpRxDscDecInfo.ucColorSpace == YCbCr422_1)&&(usHblank >= 200))
    {
        ucDiv *= 2;
    }
    if (ucDiv == 1)
    {
        BKA3_3F_REG = (BKA3_3F_REG&0xf0)| 0x02;//0010-div3
    }
    else
    {
        ucDiv = 0x08 | (ucDiv - 1);
        BKA3_3F_REG  = (BKA3_3F_REG&0xf0)| ucDiv;
    }
    
    ucPcrpllDiv = (u32)(ulRdClk/61200);//max to 124Mhz for ad_dscrx_dsc_clk
    //case for M42D ,DSC mode,Timing: 533Mhz 4k60 420 Input 
    if((usHblank <= 180)&&(g_stDpRxDscDecInfo.ucCoreNum == 0x04)&&(g_stDpRxDscDecInfo.ucColorSpace == YCbCr420_3))
    {
        BKA3_27_REG = ucPcrpllDiv;
        BKA3_28_REG = 0x0c;
        BKA3_3F_REG = 0x21;
    }
    if((g_stDpRxDscDecInfo.ucColorSpace != YCbCr422_1)||(g_stDpRxDscDecInfo.ucColorSpace != YCbCr420_3))
    {
        if(usHblank <= 90)
        {
            switch(g_stDpRxDscDecInfo.ucCoreNum)
            {
                case 4:
                    BKA3_27_REG = ucPcrpllDiv;
                    BKA3_28_REG = 0x0c;
                    BKA3_3F_REG = 0x21;
                    break;
                default:
                    BKA3_27_REG = 0x00;
                    BKA3_28_REG = 0x00;
                    break;
            }
        }
    }
}

void Drv_DpRxDscDec_ExtraHactSet(void)
{
    u8 ucHact;

    //extra hactive set
    ucHact = ((u8)g_stDpRxDscDecTiming.usHact) >> 1;
    if(g_stDpRxDscDecInfo.ucSliceNum == 0x01)
    {
        g_stDpRxDscDecInfo.ucExtraHact = 0x00;
    }
    else if(g_stDpRxDscDecInfo.ucSliceNum == 0x02)
    {
        g_stDpRxDscDecInfo.ucExtraHact = ucHact & BIT0_1;
    }
    else
    {
        ucHact &= 0x03;
        if (ucHact == 0x00)
        {
            g_stDpRxDscDecInfo.ucExtraHact = 0x00;
        }
        else
        {
            g_stDpRxDscDecInfo.ucExtraHact = g_stDpRxDscDecInfo.ucSliceNum - ucHact;
        }
    }
    BKEE_9F_REG = (g_stDpRxDscDecInfo.ucExtraHact << 2);
}

void Drv_DpRxDscDec_TimingSet(void)//
{
    u16 usTemp;

    BKEE_A3_REG = g_stDpRxDscDecTiming.usVsync & 0xff;

    BKEE_A6_REG = (g_stDpRxDscDecTiming.usVfp >> 8) & 0xff;
    BKEE_96_REG = g_stDpRxDscDecTiming.usVfp & 0xff;

    BKEE_90_REG = (g_stDpRxDscDecTiming.usVtol >> 8) & 0xff;
    BKEE_91_REG = g_stDpRxDscDecTiming.usVtol & 0xff;

    usTemp = g_stDpRxDscDecTiming.usHsync >> 1;
    if (g_stDpRxDscDecInfo.ucColorSpace == YCbCr420_3)
        usTemp >>= 1;
    BKEE_A2_REG = usTemp & 0xff;

    usTemp = g_stDpRxDscDecTiming.usHfp >> 1;
    if (g_stDpRxDscDecInfo.ucColorSpace == YCbCr420_3)
        usTemp >>= 1;
    BKEE_A0_REG = usTemp >> 8;
    BKEE_A1_REG = usTemp & 0xff;

    usTemp = g_stDpRxDscDecTiming.usHtol >> 1;
    if (g_stDpRxDscDecInfo.ucColorSpace == YCbCr420_3)
        usTemp >>= 1;
    BKEE_92_REG = usTemp >> 8;
    BKEE_93_REG = usTemp & 0xff;
}


void Drv_DpRxDscDec_ParamSet(void)
{
    u8 ucTemp;
    u16 usTemp;
    u32 ulTemp;

    g_stDpRxDscDecInfo.ucSliceRemainder = (u8)(g_stDpRxDscDecInfo.usSliceWidth % 3);
    g_stDpRxDscDecInfo.usSliceGroup = (u16)(ceil((double)g_stDpRxDscDecInfo.usSliceWidth / 3));

//    BKEE_98_REG |= BIT1_1;//[1]adaptive sync, timing follow

    if(g_stDpRxDscDecInfo.ucColorSpace == YCbCr422_1)//422
    {
        BKEE_89_REG = 0xe0;
        g_stDpRxDscDecInfo.ucGroupUnit = 0x04;
    }
    else
    {
        BKEE_89_REG = 0xac;
        g_stDpRxDscDecInfo.ucGroupUnit = 0x03;
    }

    BKEE_81_REG  = g_stDpRxDscDecInfo.ucSliceRemainder << 6;
    BKEE_81_REG |= ((u8)(g_stDpRxDscDecInfo.usSliceGroup >> 8));

    if (BKEE_00_REG == 0x12)
        BKEE_81_REG |= BIT4_1;//[4]dsc version1.2a enable: 1-en
    else
        BKEE_81_REG &= BIT4_0;//[4]dsc version1.2a enable: 0-dis

    BKEE_82_REG  = (u8)g_stDpRxDscDecInfo.usSliceGroup;

    if (g_stDpRxDscDecInfo.ucColorDepth == BPC8)
    {
        BKEE_83_REG = 0x47;//EE83 BIT3-0:7+2*(BPC-8)
        BKEE_84_REG = 0x21;//EE84 BIT3-0:1+2*(BPC-8)
    }
    else
    {
        BKEE_83_REG = 0x4b;
        BKEE_84_REG = 0x85;
    }

    if (g_stDpRxDscDecInfo.ucColorDepth == BPC8)
    {
        if(g_stDpRxDscDecInfo.ucColorSpace == RGB_0)
            BKEE_8D_REG = 0x0f;
        else
            BKEE_8D_REG = 0x0e;
    }
    else
    {
        if(g_stDpRxDscDecInfo.ucColorSpace == RGB_0)
            BKEE_8D_REG = 0x13;
        else
            BKEE_8D_REG = 0x12;//12
    }

    //middle
    ulTemp = (u32)g_stDpRxDscDecInfo.usSliceWidth * (u32)g_stDpRxDscDecInfo.usBpp;
    ucTemp = (u8)(ulTemp & 0x0f);
    ulTemp = floor((double)ulTemp / 16);
    BKEE_8E_REG=(u8)(ulTemp >> 8);
    BKEE_8F_REG=(u8)(ulTemp);

    if (ucTemp == 0)
        BKEE_81_REG &= BIT3_0;//Bpp*SilceWidth: [3:0] is 0 ,ee81[3] is 0, otherwise is 1;
    else
        BKEE_81_REG |= BIT3_1;//Bpp*SilceWidth: [3:0] is 0 ,ee81[3] is 0, otherwise is 1;

    usTemp = 3 * g_stDpRxDscDecInfo.usBpp;
    usTemp = ceil((double)usTemp / (double)16);
    BKEE_8B_REG = usTemp + 8;
    BKEE_8C_REG = usTemp - g_stDpRxDscDecInfo.ucGroupUnit;

    usTemp = ceil((double)g_stDpRxDscDecInfo.usChunkSize / 6);
    BKEE_9A_REG = (u8)(usTemp >> 8);
    BKEE_9B_REG = (u8)(usTemp);

    //dsc last byte
    BKEE_9C_REG = (g_stDpRxDscDecInfo.usChunkSize + 6 - usTemp * 6) % 6;
    BKEE_AB_REG=(u8)(usTemp >> 8);
    BKEE_AC_REG=(u8)(usTemp);

    if(g_stDpRxDscDecInfo.ucCoreNum == 0x01)
    {
        BKEE_A9_REG = 0x00;
        BKEE_AA_REG = 0x80;
        BKEE_97_REG &= BIT0_0;
    }
    else
    {
        //hact/2/slc*(slc-1)/slc + 16
        ucTemp = g_stDpRxDscDecInfo.ucCoreNum - 1;
        usTemp = g_stDpRxDscDecTiming.usHact >> 1;
        if (g_stDpRxDscDecInfo.ucColorSpace == YCbCr420_3)
        {
            usTemp >>= 1;
        }
        usTemp *= ucTemp;
        ucTemp = g_stDpRxDscDecInfo.ucCoreNum * g_stDpRxDscDecInfo.ucCoreNum;
        usTemp = usTemp / ucTemp;
        usTemp += 16;
        if(g_stDpRxDscDecInfo.ucSliceNum == 0x02)//Copy from 2207 ,2slice 1360*768 issue
        {
            if(usTemp < 0x2A0)
            {
                usTemp = 0x2A0;
            }
        }
        BKEE_A9_REG = (usTemp >> 8) & 0xff;
        BKEE_AA_REG = usTemp & 0xff;
        BKEE_97_REG |= BIT0_1;
    }

    //start
    if(g_stDpRxDscDecInfo.ucCoreNum == 0x01)
    {
        ucTemp = 0x80;
    }
    else if(g_stDpRxDscDecInfo.ucCoreNum == 0x02)
    {
        ucTemp = 0xc0;
    }
    else
    {
        ucTemp = 0xe0;
    }

    BKEE_80_REG = 0x00;
    BKEE_F8_REG = 0x00;
    Ocm_Delay1ms(2);
    
    BKEE_80_REG = g_stDpRxDscDecInfo.ucSliceNum | ucTemp;
    BKEE_F8_REG = 0xff;
}
void Drv_DpRxDscDec_Rst(void)
{
    u8 ucTmp = 0;
    ucTmp = BKEE_80_REG;
    BKEE_80_REG = 0x00;
    BKEE_F8_REG = 0x00;
    Ocm_Delay1ms(2);
    
    BKEE_80_REG = ucTmp;
    BKEE_F8_REG = 0xff;
}

void Drv_DpRxDscDec_ModuleEnable(void)
{
    #if 0
    Drv_DpRxDscDec_SyncPolCvt();
    #endif
    Drv_DpRxDscDec_DummySet();
    Drv_DpRxDscDec_WordDelaySet();
//    Drv_DpRxDscDec_HstartCal();
	
    Drv_DpRxDscDec_DataClkMuxSet();
	
	Drv_DpRxDscDec_HstartCal();
	
    Drv_DpRxDscDec_ExtraHactSet();
    Drv_DpRxDscDec_TimingSet();
    Drv_DpRxDscDec_ParamSet();
    g_stDpRxDscDecInfo.ucDscDecEn = ENABLED;
}

void Drv_DpRxDscDec_Set(u8 ucState)
{
    g_stDpRxDscDecInfo.ucDscDecEn = ucState;
}

void Drv_DpRxDscDec_Init(void)//recover to no dsc configure
{
    BKC7_D7_REG &= BIT6_0;//[6]1-dsc dec to tx
    
    //dsc module disable
    BKEE_80_REG = 0x00;//dsc dec disable
    BKEE_F8_REG = 0x00;

    
    BKF3_00_REG = 0x40;//pixel count save for fifo for dsc org-0x80
//    BKF3_03_REG = 0x02;
    BKF3_05_REG &= 0x03;//[7]rg_format_soft_mode, 0-hw
                        //[6]dp rx soft msa en: 0-dis
                        //[5:4]Vpol default
                        //[3:2]Hpol default

    BKF3_0A_REG &= BIT7_0;//[7]rg_depth_soft_mode, 0-hw modes
    BKF3_16_REG &= 0xe0;

    BKF3_63_REG = 0x06;//[4]software dsc enable
                       //dp rx dsc disable

//    BKF3_77_REG &= BIT0_0;//[0]rg_pcr_restart_mode: 0-sram fifo overflow
    BKF3_83_REG &= BIT7_0;//[7]rg_dsc_bypass: 1-not bypass

    BKA3_25_REG = 0x01;//[6:4]rg_pcrpll_half_tmdsck_divsel: 010-aa_pll_half_pix_clk
    BKA3_3F_REG = 0x01; //[6:4]rg_clkgen_dscrx_dsc_muxsel  : 001-aa_pcrpll_dsc_in_clk
    BKA3_40_REG = 0x11; //[6:4]rg_clkgen_dscrx_dscrd_muxsel: 000-aa_pcrpll_dsc_in_clk
                         //[3:0]rg_clkgen_dscrx_dscrd_divsel: div 2

    g_stDpRxDscDecInfo.ucDscDecEn = DISABLED;
}

#if DPRX_LINK_CTS == ENABLED
u8 Drv_DpRxDscDec_DscParaCheck(void)
{
    u8 ucRtn = TRUE;
    u16 usChunkSizeCal,usChunkSizeGet,usSliceWidth,usBpp;
    u32 temp0 =0;

    if (Drv_System_IntFlagGet(IRQ_DPRX_PPS_PKT_INT))//[3]pps data chg flag
    {
        Drv_System_IntClr(IRQ_DPRX_PPS_PKT_INT);
        BKEE_AD_REG = 0xff;//important, ee00 ~ ee80 update, must be set
        Ocm_Delay1ms(2);//must be wait load success
    }
    usBpp = ((u16)(BKEE_04_REG & 0x03) << 8) + BKEE_05_REG;
    usSliceWidth  = ((u16)BKEE_0C_REG << 8) + BKEE_0D_REG;
    usChunkSizeGet = ((u16)BKEE_0E_REG << 8) + BKEE_0F_REG;

    temp0 = (u32)usSliceWidth * (u32)usBpp;
    usChunkSizeCal = ceil((double)temp0/128);
    if(usChunkSizeCal != usChunkSizeGet)
    {
        g_stDpRx.ucDscChunkSizeErr = DSC_CHUNKSIZE_ERR;
        ucRtn = FALSE;
    }
    if(BKEE_AD_REG & 0x0f)
    {
        g_stDpRx.ucDscRcBufUnderRun = DSC_RCBUF_UNDERRUN;
        ucRtn = FALSE;
    }
    if(BKEE_AE_REG & 0x0f)
    {
        g_stDpRx.ucDscRcBufOverFlow = DSC_RCBUF_OVERFLOW;
        ucRtn = FALSE;
    }
    return ucRtn;
}
#endif

u8 Drv_DpRxDscDec_SwitchGet(void)
{
    return g_stDpRxDscDecInfo.ucDscDecEn;
}
u8 Drv_DpRxDscDec_ColorDepthGet(void)
{
	return g_stDpRxDscDecInfo.ucColorDepth;
}
u8 Drv_DpRxDscDec_ColorSpaceGet(void)
{
	return g_stDpRxDscDecInfo.ucColorSpace;
}

void Drv_DpRxDscDec_ColorInfoGet(ColorInfo_S *pstInfo)
{
    switch(g_stDpRxDscDecInfo.ucColorDepth)
    {
        case BPC10:
            pstInfo->ucBitDepth = DPRX_10BIT_2;
            break;
        case BPC12:
            pstInfo->ucBitDepth = DPRX_12BIT_3;
            break;        
        default:
            pstInfo->ucBitDepth = DPRX_8BIT_1;
            break;
    }
    pstInfo->ucPixelEncoding = g_stDpRxDscDecInfo.ucColorSpace;
    if(g_stDpRxDscDecInfo.ucColorSpace == SIMPLE422_5)
    {
        pstInfo->ucPixelEncoding = YCbCr444_2;
    }
}
#endif

#endif
