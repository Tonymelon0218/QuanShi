void Drv_DpRx_AudioInfoGet(AudioChlInfo_S *pstInfo)
{
    #if TX_AUDIO_SEL == RX_AUDIO_DATA
    pstInfo->ucFsValue = BKC6_7C_REG;

    pstInfo->ucLayout  = (BKF2_F1_REG >> 3) & BIT0_1;
    pstInfo->ucChannel = BKF2_F5_REG & 0x07;//audio stream packet(asp), hb3
    pstInfo->ucCodingType = BKF2_F5_REG & 0xf0;
    pstInfo->szAudioInfo[0] = BKF2_63_REG;//aud db0, is cta db1
    pstInfo->szAudioInfo[1] = BKF2_64_REG;//aud db1, is cta db2
    pstInfo->szAudioInfo[2] = BKF2_65_REG;//aud db2, is cta db3
    pstInfo->szAudioInfo[3] = BKF2_66_REG;//aud db3, is cta db4
    pstInfo->szAudioInfo[4] = BKF2_67_REG;//aud db4, is cta db5
    #elif TX_AUDIO_SEL == I2SIN_AUDIO_DATA
    pstInfo->ucFsValue = BKC6_98_REG;//WS VAL
    #endif
}
void Drv_DpRx_AudioFormatSet(void)
{
    if((BKF2_F5_REG & 0xf0)== 0x10)//1-IEC61937
    {
        //Enable HBR Audio out
        Drv_Audio_IisHbrSet(TRUE);
        BKF2_15_REG &= BIT1_0;       
        if((BKF2_F5_REG & 0x07) > 0x01)
        {
            BKF2_15_REG |= BIT0_1;
        }
        else
        {
            BKF2_15_REG &= BIT0_0;
        }
    }
    else
    {
        //Disable HBR Audio out
        Drv_Audio_IisHbrSet(FALSE);
        
        BKF2_15_REG &= BIT0_0;
        BKF2_15_REG |= BIT1_1;
    }
}
u8 Drv_DpRx_SscJudgeByRxFm(u8 ucLinkRate)
{
    u8 b1IsSscFlag;
    u16 usLinkClk;
    b1IsSscFlag = FALSE;
    BKC7_40_REG |= BIT7_1;//[7]freq_khz_frz_en: 1-en
    usLinkClk = ((u16)BKC7_59_REG<<8) + BKC7_5A_REG;
    switch(ucLinkRate)
    {
        case HBR3:
            if((BKC7_58_REG&0x0f) == 0x06)
            {
                b1IsSscFlag = (usLinkClk <0x2da4)?(TRUE):(FALSE);
            }
            break;
        case HBR2:
            if((BKC7_58_REG&0x0f) == 0x04)
            {   
                b1IsSscFlag = (usLinkClk <0x1e4c)?(TRUE):(FALSE);
            }
            break;
        case HBR:
            if((BKC7_58_REG&0x0f) == 0x02)
            {
                b1IsSscFlag = (usLinkClk <0x0ef4)?(TRUE):(FALSE);
            }
            break;
        case RBR:
            if((BKC7_58_REG&0x0f) == 0x01)
            {
                b1IsSscFlag = (usLinkClk <0x3c04)?(TRUE):(FALSE);
            }
            break;
        default:
            break;
    }
    BKC7_40_REG &= BIT7_0;
    return b1IsSscFlag;
}

void Drv_DpRx_SyncPolSet(u8 ucOpt)
{
    if (ucOpt == ENABLED)
    {
        BKF3_05_REG |= BIT4_1;//[4]rg_vspol_soft_mode: 1-en
        BKF3_05_REG |= BIT2_1;//[4]rg_hspol_soft_mode: 1-en
    }
    else
    {
        BKF3_05_REG &= 0xc3;//[5:4]Vpol default
                            //[3:2]Hpol default
    }
}

