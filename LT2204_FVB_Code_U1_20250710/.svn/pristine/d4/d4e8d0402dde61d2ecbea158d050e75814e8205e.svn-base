#define FREQ_INTG_UP_LIMIT      0x65
#define FREQ_INTG_DOWN_LIMIT    0x20


void Drv_DpRx_AuxInit(void)
{
    //[6:0]rgd_dprx_aux_clk_div_num, freq(sys_clk)/2
    #if SYSCLK == SYS_CLK_40M
    BKF4_09_REG = 0x13;
    #endif
    
    #if SYSCLK == SYS_CLK_48M
    BKF4_09_REG = 0x17;
    #endif
    
    BKF1_00_REG |= BIT6_1; //[6]DPCD mode select: 1-Register mode, 0-aux mode;
    BKF4_08_REG |= BIT1_1; //[1]rgd_aux_soft_mode, 1-en
    BKF4_08_REG &= BIT2_0; //[2]aux-ch native work mode: 0-Hardware mode,1-Combined hardware and software mode;
    BKF4_08_REG &= BIT3_0; //[3]AUX-CH interrupt mode: 0-All AUX transaction generate interrupt,1-Only Native AUX transaction generate interrupt.
    #if DPRX_AUX_MODE == SOFTMODE
    BKF4_30_REG |= BIT0_1;
    #endif

    BKA3_56_REG |= BIT5_1; //aux pullup or pulldown resistance select:1M.
    BKA3_57_REG = 0x2C; //RG_DHRX_AUX_EN = 1;  
    BKA3_58_REG = 0xBA;//AC AUX Set to 50R
    Drv_DpRx_DcAuxResCtrl(ENABLED);
    Drv_DpRx_AcAuxTermCtrl(ENABLED);
    
    //DPRX INT SRC: F1A7 BIT3-0 and F1A8 BIT0
    BKF1_A8_REG &= BIT0_0;
}

void Drv_DpRx_DcAuxResCtrl(u8 b1IsEn)
{
    if(b1IsEn == ENABLED)
    {
        BKA3_56_REG |= BIT4_1;//DC AUX Term EN
    }
    else
    {
        BKA3_56_REG &= BIT4_0;//DC AUX Term EN
    }
}
void Drv_DpRx_AuxSwap(u8 b1SwapEn)
{
    if (b1SwapEn == TRUE)
    {
        BKA3_57_REG |= BIT7_1;//bit2 aux swap
    }
    else
    {
        BKA3_57_REG &= BIT7_0;//bit2 aux swap
    }
}
//In order to solve Samsung Charging Warning issue
void Drv_DpRx_AcAuxTermCtrl(u8 b1IsEn)
{
    if(b1IsEn == ENABLED)
    {
        BKA3_58_REG |= 0xB0;//AC AUX Set to 50R
    }
    else
    {
        BKA3_58_REG &= 0x0F;//AC AUX Set to Max , Large than 1MR
    }
}
//========================================================================
// Func Name   : Drv_DpRx_AuxDcDet
// Description : detect source is present or not.
//             : if source is pulg, the voltge level of dc-aud pin will changes too.
// Input       : void
// Output      : None
// Return      : TRUE-> source plug.
//             : FALSE-> source unplug.
//========================================================================
u8 Drv_DpRx_AuxDcDet(void)
{
//    if(((BKE5_A3_REG & BIT6_1))&&((BKE5_A3_REG & BIT7_1) == 0))//auxp=1,auxn =0 not connect
//    {
//        return FALSE; //source unplug.
//    }
//    else
//    {
//        return TRUE; //source pulg.
//    }
    //对于SOURCE关机的case，检测AUXN 比较合理
    if(BKE5_A3_REG & BIT7_1)//auxp=1,auxn =0 not connect
    {
        return TRUE; //source plug.
    }
    else
    {
        return FALSE; //source unpulg.
    }
}


void Drv_DpRx_HpdSet(u8 b1IsHigh,u8 b1IsIrqHigh)
{
    #if SYSCLK == SYS_CLK_40M
    BKF1_BD_REG = 0x7d;
    #endif
    #if SYSCLK == SYS_CLK_48M
    BKF1_BD_REG = 0x98;
    #endif
    if (b1IsHigh == HPD_HIGH)
    {
        if (b1IsIrqHigh == IRQ_HIGH)
        {
            printLT(PRINT_PRIO_HIG,"\nDpRx HPD IRQ");
            BKF1_BB_REG |= BIT2_1;//[2]rgd_hpd_irq_sft_en: 1-en
            BKF1_BB_REG &= BIT2_0;//[2]rgd_hpd_irq_sft_en: 0-dis
        }
        else
        {
            printLT(PRINT_PRIO_HIG,"\nDpRx HPD High");
            BKF1_BB_REG |= BIT1_1;//[1]rgd_rx_hpd_auto_en: 1-high
        }
    }
    else
    {
        printLT(PRINT_PRIO_HIG,"\nDpRx HPD Low");
        BKF1_BB_REG &= BIT1_0;//[1]rgd_rx_hpd_auto_en: 0-low
    }
}


void Drv_DpRx_Dpcd_HighAddrWrite(IN u8 ucAddr15_8)
{
    BKF1_03_REG = 0x00;
    BKF1_04_REG = ucAddr15_8;
}

//===========================================
//func  :used to intital the dpcd addr bit7:0 and value
//input :ucAddr7_0/ucValue
//output:N/A
//return:void
//Info  :N/A
//===========================================
void Drv_DpRx_Dpcd_ValueWrite(IN u8 ucAddr7_0,IN u8 ucValue)
{
    BKF1_05_REG = ucAddr7_0;
    BKF1_53_REG = ucValue;
}
#if DPRX_ADAPTIVE_SYNC == ENABLED
void Drv_DpRx_AdaptiveSyncInit(void)
