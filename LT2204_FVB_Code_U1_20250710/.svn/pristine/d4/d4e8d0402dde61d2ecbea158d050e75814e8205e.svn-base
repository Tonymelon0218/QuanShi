u32 Drv_DpRx_PixFreqGet(void)
{
    return (((u32)(BKF3_F8_REG&0x0f)<<16) + ((u16)BKF3_F9_REG<<8) + BKF3_FA_REG);
}

u8 Drv_DpRx_PcrStableCheck(void)
{
    if (BKC8_B4_REG & BIT2_1)
    {
        return STABLE;
    }
    else
    {
        return UNSTABLE;
    }
}

void Drv_DpRx_VidFreqSetCheck(u8 ucOpt)
{
    u8 ucSoftFreqSet;
    u32 ulFreqSet = 0;
    if(ucOpt == DISABLED)
    {
        BKF3_62_REG  &= 0xf0;
    }
    else
    {
        if (BKF3_E2_REG & BIT4_1)
        {
            ulFreqSet =  ((u32)(BKF3_F8_REG&0x0f)<<16) + ((u16)BKF3_F9_REG<<8)+ BKF3_FA_REG;
        }
        if((ulFreqSet == 0)||(ulFreqSet >= 1200000))
        {
            return;
        }
        if(ulFreqSet < 18750)
        {
            ucSoftFreqSet = 6;
        }
        else if(ulFreqSet < 37500)
        {
            ucSoftFreqSet = 5;
        }
        else if(ulFreqSet < 75000)
        {
            ucSoftFreqSet = 4;
        }
        else if(ulFreqSet < 150000)
        {
            ucSoftFreqSet = 3;
        }
        else if(ulFreqSet < 300000)
        {
            ucSoftFreqSet = 2;
        }
        else if(ulFreqSet < 600000)
        {
            ucSoftFreqSet = 1;
        }
        else if(ulFreqSet < 1200000)
        {
            ucSoftFreqSet = 0;
        }
        if(ucSoftFreqSet != ((BKF3_F8_REG>>4)&0x07))
        {
            ucSoftFreqSet |= BIT3_1;
            BKF3_62_REG  = (BKF3_62_REG&0xf0) | ucSoftFreqSet;
        }
    }
}
//========================================================================
// Func Name   : Drv_DpRx_PowerOnInit
// Description : The setting init for power on
//             : Be called only one time at power on.
// Input       : None
// Output      : None
// Return      : void
//========================================================================
void Drv_DpRx_PowerOnInit()
{
    //ana
    Drv_DpRx_AuxInit();
    Drv_DpRx_PhyInit();
    Drv_DpRx_RtermCal();
    Drv_DpRx_PiEnable(TRUE);
    Drv_DpRx_RxPllCali();
    Drv_DpRx_PcrPllInit();

    //dig
    Drv_DpRx_FreqIntg();
    Drv_DpRx_DigitalInit();
    Drv_DpRx_MainLink();
    Drv_DpRx_PcrInit();
    Drv_DpRx_PcrHsyncMode();
    Drv_DpRx_HwResetSet();

    #if SPD_SUPPORT  == ENABLED
    Drv_DpRx_SpdPacketType_Set();
    #endif
}

//========================================================================
// Func Name   : Drv_DpRx_SettingInit
// Description : The setting init for HPD High.
//             : Shall be called every time before HPD go to high.
// Input       : void  
// Output      : None
// Return      : void
//========================================================================

void Drv_DpRx_SettingInit(void)
{
    Drv_DpRx_DpcdInit(g_stDpRx);
    Drv_DpRx_ClkMux();

    Drv_DpRx_Reset(DP_RX_PCR_RST);
    Drv_DpRx_Cp2520KeyCodeSet(FALSE);
    Drv_HdcpRx_Enable(DPRX_HDCP_DEC_MODE);
    #if ((DPRX_CDR_MODE == FULL_SPEED_DIGCDR) || (DPRX_CDR_MODE == HALF_SPEED_DIGCDR))
    Drv_DpRx_DigCdrRst(g_stDpRx.b1Ssc_Support);
    #endif
    Drv_System_FmSet(RX_FM,RXFM_LINK_CLK);//used for link clk det
    #if ((DPRX_FEC_SUPPORT == ENABLED)||(DPRX_DSC_DEC_SUPPORT == ENABLED)||(DPRX_DSC_BYPASS_SUPPORT == ENABLED))
    Drv_DpRx_FecDataPathSet(DISABLED);
    #endif
    Drv_System_IntClr(IRQ_DPRX_AUX_INT);
    Drv_System_IntSet(IRQ_DPRX_AUX_INT, ON);
    
    #if HDR_SUPPORT == ENABLED
    Drv_System_IntSet(IRQ_DPRX_STATICHDR_INT, ON);
    Drv_System_IntClr(IRQ_DPRX_STATICHDR_INT);
    #endif
    #if DOBLY_VISION_SUPPORT == ENABLED
    Drv_System_IntSet(IRQ_DPRX_VSI_INT, ON);
    Drv_System_IntClr(IRQ_DPRX_VSI_INT);
    #endif
    #if DPRX_ADAPTIVE_SYNC == ENABLED
    Drv_DpRx_AdaptiveSyncInit();
    Drv_System_IntSet(IRQ_DPRX_ADAPTIVE_SYNC_INT, ON);
    Drv_System_IntClr(IRQ_DPRX_ADAPTIVE_SYNC_INT);
    #endif
}

#endif
