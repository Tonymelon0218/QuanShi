#if DPRX_LINK_CTS == ENABLED
void Drv_DpRx_FecErrClr(void)
{
    BKF1_60_REG |= BIT7_1; //[7]1'b1:fec error clr en
    BKF1_60_REG &= BIT7_0; //[7]1'b0:fec error clr disable
}

void Drv_DpRx_FecCtsSet(u8 ucFecErrSel)
{
    if((ucFecErrSel & 0x0e) == 0x00)
    {
        BKF1_C2_REG &= BIT6_0; //[6]1'b1:link lock dis
        BKF1_8A_REG &= BIT1_0; //[1]1'b1:de-skew lock dis
        BKF1_8A_REG |= BIT4_1;  //[5:4]2'b00:fec PM update
        Ocm_Delay1us(50);
        Drv_DpRx_FecErrClr();
    }
    else
    {
        BKF1_C2_REG |= BIT6_1; //[6]1'b1:link lock en
        BKF1_8A_REG |= BIT1_1; //[1]1'b1:de-skew lock en
        BKF1_8A_REG &= 0xcf;  //[5:4]2'b00:fec PM not update
    }
}
#endif
#endif

u8 Drv_DpRx_DscDecState(void)
{
    #if (((DPRX_DSC_DEC_SUPPORT == ENABLED) ||(DPRX_DSC_BYPASS_SUPPORT == ENABLED))&&(DPRX_FEC_SUPPORT == ENABLED))
    if ((BKF2_F6_REG & BIT6_1)&&(BKF2_F7_REG & BIT6_1)&&(BKF2_F8_REG & BIT6_1)&&(BKF2_F9_REG & BIT6_1))//dp rx vb-id0
    {
        return ENABLED;//-wangtt- wait update
    }
    else
    #endif    
    {
        return DISABLED;
    }
}
void Drv_DpRx_FecAbnormalDet(void)
{
    #if CHIP_VERSION_SEL > U1_VERSION 
            //maximum wait time equal ((512*256)/810M)*2 = 324us
    BKF1_01_REG |= BIT7_1;//ECO ENABLED 
    Ocm_Delay1ms(1);//
    BKF1_01_REG &= BIT7_0;//ECO DISABLED 
    #endif
}

u8 Drv_DpRx_PpsInfoCheck(void)
{
    //BKF2_EE_REG[4]pps packet interrupt flag
    if ((BKF2_EE_REG & BIT4_1) && (BKF3_E2_REG & BIT4_1))//[4]pixel frequency stable read_only register
    {
        return SUCCESS;
    }
    else
    {
        return FAIL;
    }
}

u8 Drv_DpRx_PixelStableCheck(void)
{
    //BKF2_EE_REG[4]pps packet interrupt flag
    if (BKF3_E2_REG & BIT4_1)//[4]pixel frequency stable read_only register
    {
        return TRUE;
    }
    else
    {
        return FALSE;
    }
}

//Packet type value Packet type
//80h Reserved
//81h Vendor specific
//82h AVI
//83h Source Product Description
//84h Audio
//85h MPEG source
//86h NTSC VBI
//87h HDR
//20h DP_VSC_EXT_VESA
//21h DP_VSC_EXT_CTA
//22h Adaptive Sync
//07h VSC
#if SPD_SUPPORT  == ENABLED
void Drv_DpRx_SpdPacketType_Set(void)
{
    BKF2_0F_REG = 0x83;//Vender spec Source product descrption
}

u8 Drv_DpRxSpdVer_Get(void)//
{
    u8 b2SpdVision = HDR_SDPNone;
    if((BKF2_87_REG == 0x83)&&(BKF2_88_REG == 0x1D)&&(BKF2_89_REG == 0x4C))//hdr SDPv13
    {
        b2SpdVision = HDR_SDPVer13;
    }
    else if((BKF2_87_REG == 0x83)&&(BKF2_88_REG == 0x1B)/*&&(BKF2_89_REG == 0x48)*/)//hdr SDPv12
    {
        b2SpdVision = HDR_SDPVer12;
    }
    else
    {
        b2SpdVision = HDR_SDPNone;
    }
    return b2SpdVision;
}
#endif

#if DPRX_LINK_CTS == ENABLED
void Drv_DpRx_DscPpsDataChg_IntSet(IN u8 b1IsIntEn)
{
    if(b1IsIntEn == ENABLED)
    {
        BKE5_88_REG |= BIT3_1; //[3]1'b1:software pps cksum enable
        BKE6_EE_REG |= BIT0_1; //[0]1'b1:pps data cksum enable
    }
    else
    {
        BKE5_88_REG &= BIT3_0; //[3]1'b0:software pps cksum disable
        BKE6_EE_REG &= BIT0_0; //[0]1'b0:pps data cksum disable
    }
}

#endif
void Drv_DpcdError_Clear(IN u8 ucI)
{
    BKF1_A5_REG |= ucI;//clear the error
    BKF1_A5_REG &= 0xf0;//clear the error
}

void Drv_Dpcd270_PhyLaneSel(u8 ucPhyLane) //PHY SINK TEST LANE SEL:dpcd00270 [5:4]
{
    BKA1_0B_REG &= 0x0f;
    BKA1_0E_REG &= 0x0f;
    
    switch(ucPhyLane & 0xf0)
    {
        case 0x80: //lane0
            BKA1_0B_REG |= BIT7_1;
            #if DPRX_CDR_MODE == ANACDR
            BKA1_0E_REG |= BIT7_1;
            #endif
        break;
        case 0x90: //lane1
            BKA1_0B_REG |= BIT6_1;
            #if DPRX_CDR_MODE == ANACDR
            BKA1_0E_REG |= BIT6_1;
            #endif
        break;
        case 0xa0: //lane2
            BKA1_0B_REG |= BIT5_1;
            #if DPRX_CDR_MODE == ANACDR
            BKA1_0E_REG |= BIT5_1;
            #endif
        break;
        case 0xb0: //lane3
            BKA1_0B_REG |= BIT4_1;
            #if DPRX_CDR_MODE == ANACDR
            BKA1_0E_REG |= BIT4_1;
            #endif
        break;
        default:
        break;
    }
}

u8 Drv_DpRx_NoErrCheck(u8 ucLaneCount)
{
    if((BKF1_CC_REG == 0x80)&&(BKF1_CD_REG <= 0x10))
    {
        ;
    }
    else
    {
        return FALSE; 
    }
    if(ucLaneCount >= TWO_LANE)
    {
        if((BKF1_CE_REG == 0x80)&&(BKF1_CF_REG <= 0x10))
        {
            ;
        }
        else
        {
            return FALSE; 
        }
    }
    if(ucLaneCount >= FOUR_LANE)
    {
        if((BKF1_D0_REG == 0x80)&&(BKF1_D1_REG <= 0x10))
        {
            ;
        }
        else
        {
            return FALSE; 
        }
        if((BKF1_D2_REG == 0x80)&&(BKF1_D3_REG <= 0x10))
        {
            ;
        }
        else
        {
            return FALSE; 
        }
    }
    return TRUE;
}
#if DPRX_PCRPLL_HRST == DISABLED
void Drv_DpRx_PcrPllRst(u8 b1IsRst)
{
    if(b1IsRst == ENABLED)
    {
        BKE1_0E_REG |= BIT6_0; //pcrpll0_hw_reset = 0;
        BKE1_0E_REG |= BIT5_0; //pcrpll1 hw reset = 0;
    }
    else
    {
        BKE1_0E_REG &= BIT6_0; //pcrpll0_hw_reset = 0;
        BKE1_0E_REG &= BIT5_0; //pcrpll1 hw reset = 0;
