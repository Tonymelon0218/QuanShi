#if ((DPRX_FEC_SUPPORT == ENABLED)||(DPRX_DSC_DEC_SUPPORT == ENABLED)||(DPRX_DSC_BYPASS_SUPPORT == ENABLED))

u8 Drv_DpRx_FecDecDet(void)
{
    //use static var can't clear when hotplug
    if((!(BKF1_60_REG&BIT6_1))&&(BKF1_E1_REG & BIT5_1))
    {
        printLT(PRINT_PRIO_HIG, "\nDet fec en sequence");
        return TRUE;
    }
    else if((BKF1_60_REG&BIT6_1) && ((BKF1_E1_REG & BIT5_1) == 0x00))
    {
        printLT(PRINT_PRIO_HIG, "\nDet fec dis sequence");
        return FALSE;
    }
    return UNKNOWN;
}


//========================================================================
// Func Name   : Drv_DpRx_FecDataPathSet
// Description : Select data path for fec data.
// Input       : ENABLED-> data path is fec decode, the data will be corrected by fec decode.
//             : DISABLED-> data bypass fec decode, the data will not be corrected. 
// Output      : None
// Return      : void
//========================================================================
void Drv_DpRx_FecDataPathSet(u8 b1IsFecEn)
{
    if(b1IsFecEn == ENABLED)
    {
        BKF1_60_REG |= BIT6_1;//fec decode
        BKF1_B8_REG |= BIT1_1;//FEC DIS enable
    }
    else
    {
        BKF1_60_REG &= BIT6_0;//bypass fec decode
        BKF1_B8_REG &= BIT1_0;
    }
}

void Drv_DpRx_FecDisclr(void)
{
    BKF1_B9_REG |= BIT2_1;//FEC DIS CLR EN
    BKF1_B9_REG &= BIT2_0;//FEC DIS CLR EN
}

