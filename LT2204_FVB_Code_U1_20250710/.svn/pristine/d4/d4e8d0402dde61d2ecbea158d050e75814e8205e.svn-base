//========================================================================
// Func Name   : Drv_DpRx_DigitalInit
// Description : DpRx top settings.
// Input       : void  
// Output      : None
// Return      : void
//========================================================================
void Drv_DpRx_DigitalInit(void)
{
    BKA3_7F_REG &= BIT3_0;//[3]rgd_sw_en_dhrx_hpd: 0-hw;
    
    BKC7_D7_REG &= BIT0_0;//[0]rgd_rx_da_src_sel: 0-dhrx_hpd_auto
    
    BKF1_BB_REG = 0x59;   //[0]rgd_rx_hpd_auto_sel: 1-auto, [1]rgd_rx_hpd_auto_en: 1-en
                          //[2]rgd_hpd_irq_sft_en: 0-dis, [3]rgd_cp_hpd_irq_en: 1-en
                          //[4]link_fail_int_en: 1-en, [5]r0_available_int_en: 0-dis
                          //[6]v_rdy_int_en: 1-en, [7]ecf_chg_int_en: 0-dis
    BKF1_C4_REG |= BIT1_1;//[1]rgd_dprx_hdcp_bypass_en: 1-dprx hdcp bypass enable

}

void Drv_DpRx_HwResetSet(void)
{
    BKE1_0C_REG &= BIT4_0; //disable rx RXPLL_CAL_RX_HW_RST_EN
    BKE1_0C_REG &= BIT5_0; //disable rx hard reset
    #if ((DPRX_CDR_MODE == FULL_SPEED_DIGCDR)||(DPRX_CDR_MODE == HALF_SPEED_DIGCDR))
    BKE1_0D_REG &= BIT7_0; //disable anacdr hw rst.
    #endif
    BKE1_0D_REG &= BIT6_0; //disable anacdr hw rst.
    BKE1_0D_REG &= BIT5_0; //disable pi hard reset
    
    BKE1_0E_REG &= BIT7_0;//[7]rg_audpll_hw_rst_en: 0-dis
    #if DPRX_PCRPLL_HRST == DISABLED
    //PCRPLL hard control has logic issue, maybe enter into dead loop
    BKE1_0E_REG &= BIT6_0; //pcrpll0_hw_reset = 0;
    BKE1_0E_REG &= BIT5_0; //pcrpll1 hw reset = 0;
    #endif
    //design of RX FIFO doubled, easy to occur SKEW issue
    //need to hard reset when skew occurs
    BKC9_0A_REG |= BIT1_1; //rx_fifo_rst enable //sovle the no align down issue
}

void Drv_DpRx_SkewLock(u8 IsLock)
{
    if(IsLock == TRUE)
    {
        BKF1_8A_REG |= BIT1_1;
    }
    else
    {
        BKF1_8A_REG &= BIT1_0;
    }    
}

void Drv_DpRx_FecSoftModeSet(u8 b1IsFecEn)
{
    if(b1IsFecEn == ENABLED)
    {
        BKF1_B7_REG |= 0x30;//fec decode

    }
    else
    {
        BKF1_B7_REG &= 0xcf;//bypass fec decode
    }
}
//========================================================================
// Func Name   : Drv_DpRx_MainLink
// Description : The initalization of main link.
// Input       : void  
// Output      : None
// Return      : void
//========================================================================
void Drv_DpRx_MainLink(void)
{
    //修改training基准定时器设置,由默认的1us基准时间改为2us的基准时间,基准时间寄存器配置都加倍.
    //CR lock time,training eq scan wait time,training eq scan total time寄存器配置减半.
    BKF1_10_REG = 0xa2; //1.62g定时器基准时间:1us->2us
    BKF1_11_REG = 0x01; //2.7g定时器基准时间:1us->2us
    BKF1_12_REG = 0x0e; //2.7g定时器基准时间
    BKF1_13_REG = 0x02; //5.4g定时器基准时间:1us->2us
    BKF1_14_REG = 0x1c; //5.4g定时器基准时间
    BKF1_15_REG = 0x03; //8.1g定时器基准时间:1us->2us
    BKF1_16_REG = 0x2a; //8.1g定时器基准时间
//    BKF1_0C_REG = 0x32; //CR lock time
    BKF1_0C_REG = 0x1E; //CR lock time
    //19=50us,OK 32=100us(M1 NOTEBOOK NG) --0E == OK
    BKF1_39_REG = 0x0E;
    #if DPRX_CDR_MODE == ANACDR
    //set anacdr training wait time,EQ scan time
    BKF1_0D_REG = 0x0E;//26us each EQ Level Scan time(Whole time)
    BKF1_0E_REG = 0x08;//16us wait time(include CDR reset time)
    #else
    //set digcdr training wait time,EQ scan time
    BKF1_0D_REG = 0x0a;//20us each EQ Level Scan time(Whole time)
    BKF1_0E_REG = 0x03;//6us wait time(include CDR reset time)
    #endif

    BKF1_1B_REG = 0x02; //err conter mode in tps2/3/4 stage select: 8b10b err only.
                        //to fix tps4 training fail at non-enhanced mode issue.
    BKF1_5F_REG = 0xe4; //eq swap
    
    
    //eq index in mainlink.
	#if DPRX_EQ_SCAN_MODE == SW_SCANVALIDEQ_EXT
	BKF1_4A_REG = SzEq_Stg0[1];
    BKF1_4C_REG = SzEq_Stg0[3];
    BKF1_4E_REG = SzEq_Stg0[5];
    BKF1_50_REG = SzEq_Stg0[7];
    BKF1_64_REG = SzEq_Stg0[9];
    BKF1_66_REG = SzEq_Stg0[11];
    BKF1_68_REG = SzEq_Stg0[13];
    BKF1_6C_REG = SzEq_Stg0[15];
    BKF1_6E_REG = SzEq_Stg0[17];
    BKF1_70_REG = SzEq_Stg0[19];
    BKF1_72_REG = SzEq_Stg0[21];
    BKF1_74_REG = SzEq_Stg0[23];
    BKF1_76_REG = SzEq_Stg0[25];
    BKF1_78_REG = SzEq_Stg0[27];
    BKF1_7A_REG = SzEq_Stg0[29];
    BKF1_7C_REG = SzEq_Stg0[31];
    
    BKF1_49_REG = SzEq_Stg1[1];
    BKF1_4B_REG = SzEq_Stg1[3];
    BKF1_4D_REG = SzEq_Stg1[5];
    BKF1_4F_REG = SzEq_Stg1[7];
                                 
    BKF1_63_REG = SzEq_Stg1[9];
    BKF1_65_REG = SzEq_Stg1[11];
    BKF1_67_REG = SzEq_Stg1[13];
    BKF1_6B_REG = SzEq_Stg1[15];
    
    BKF1_6D_REG = SzEq_Stg1[17];
    BKF1_6F_REG = SzEq_Stg1[19];
    BKF1_71_REG = SzEq_Stg1[21];
    BKF1_73_REG = SzEq_Stg1[23];
    
    BKF1_75_REG = SzEq_Stg1[25];
    BKF1_77_REG = SzEq_Stg1[27];
    BKF1_79_REG = SzEq_Stg1[29];
    BKF1_7B_REG = SzEq_Stg1[31];
    #else
    
    BKF1_4A_REG = SzEq_Stg0[0];
    BKF1_4C_REG = SzEq_Stg0[1];
    BKF1_4E_REG = SzEq_Stg0[2];
    BKF1_50_REG = SzEq_Stg0[3];
    BKF1_64_REG = SzEq_Stg0[4];
    BKF1_66_REG = SzEq_Stg0[5];
    BKF1_68_REG = SzEq_Stg0[6];
    BKF1_6C_REG = SzEq_Stg0[7];
    BKF1_6E_REG = SzEq_Stg0[8];
    BKF1_70_REG = SzEq_Stg0[9];
    BKF1_72_REG = SzEq_Stg0[10];
    BKF1_74_REG = SzEq_Stg0[11];
    BKF1_76_REG = SzEq_Stg0[12];
    BKF1_78_REG = SzEq_Stg0[13];
    BKF1_7A_REG = SzEq_Stg0[14];
    BKF1_7C_REG = SzEq_Stg0[15];
    
    BKF1_49_REG = SzEq_Stg1[0];
    BKF1_4B_REG = SzEq_Stg1[1];
    BKF1_4D_REG = SzEq_Stg1[2];
    BKF1_4F_REG = SzEq_Stg1[3];
                                 
    BKF1_63_REG = SzEq_Stg1[4];
    BKF1_65_REG = SzEq_Stg1[5];
    BKF1_67_REG = SzEq_Stg1[6];
    BKF1_6B_REG = SzEq_Stg1[7];
    
    BKF1_6D_REG = SzEq_Stg1[8];
    BKF1_6F_REG = SzEq_Stg1[9];
    BKF1_71_REG = SzEq_Stg1[10];
    BKF1_73_REG = SzEq_Stg1[11];
    
    BKF1_75_REG = SzEq_Stg1[12];
    BKF1_77_REG = SzEq_Stg1[13];
    BKF1_79_REG = SzEq_Stg1[14];
    BKF1_7B_REG = SzEq_Stg1[15];
    #endif
        
//    BKF1_4A_REG = SzMainLink_Eq[0];
//    BKF1_4C_REG = SzMainLink_Eq[1];
//    BKF1_4E_REG = SzMainLink_Eq[2];
//    BKF1_50_REG = SzMainLink_Eq[3];
//    BKF1_64_REG = SzMainLink_Eq[4];
//    BKF1_66_REG = SzMainLink_Eq[5];
//    BKF1_68_REG = SzMainLink_Eq[6];
//    BKF1_6C_REG = SzMainLink_Eq[7];
//    BKF1_6E_REG = SzMainLink_Eq[8];
//    BKF1_70_REG = SzMainLink_Eq[9];
//    BKF1_72_REG = SzMainLink_Eq[10];
//    BKF1_74_REG = SzMainLink_Eq[11];
//    BKF1_76_REG = SzMainLink_Eq[12];
//    BKF1_78_REG = SzMainLink_Eq[13];
//    BKF1_7A_REG = SzMainLink_Eq[14];
//    BKF1_7C_REG = SzMainLink_Eq[15];
    
    BKF1_8A_REG = 0x14; //RGD_FEC_PM_MODE
    #if DPRX_CDR_MODE == ANACDR
    BKF1_B8_REG &= 0x0f;//10us CDR reset time  
    BKF1_B8_REG |= 0x50;
    #endif
    BKF1_B9_REG |= BIT4_1;    //8b10b error count enable
    
    //link lock sel 
    BKF1_C2_REG |= BIT5_1; //link lock en sel soft mode
    BKF1_C2_REG &= BIT6_0; //link lock en = 0.
                           //8b/10b boundary is real-time updating.
    Drv_DpRx_FecSoftModeSet(FALSE);//hardmode
}

void Drv_DpRx_Reset(EnumDpRxRstType ucOpt)
{
    switch(ucOpt)
    {
        case DP_RX_PCR_RST:
            BKF1_B4_REG &= BIT1_0;//[1]dprx video pcr soft reset en
            BKF1_B4_REG |= BIT1_1;//[1]dprx video pcr soft reset dis
           break;
        case DP_RX_SDP_RST:
            BKF1_B4_REG &= BIT5_0;//[5]DPRX sdp logic soft reset en
            BKF1_B4_REG |= BIT5_1;//[5]DPRX sdp logic soft reset dis
            break;
        case DP_RX_FIFO_RST:
            BKC9_08_REG &= BIT4_0;
            BKC9_08_REG |= BIT4_1;
            break;
        case DP_FEC_DEC_RST:
            BKF1_B5_REG &= BIT3_0;
            BKF1_B5_REG |= BIT3_1;
            break;
        case DP_MLC_DAT_RST:
            BKF1_B5_REG &= BIT2_0;
            BKF1_B5_REG |= BIT2_1;
            break;   
        case DP_MLC_DPCD_RST:
            BKF1_B5_REG &= BIT1_0;
            BKF1_B5_REG |= BIT1_1;
            break;   
            
        default:
            break;
    }
}

//========================================================================
// Func Name   : Drv_DpRx_PcrInit
// Description : The setting for pcr digital block.
// Input       : void  
// Output      : None
// Return      : void
//========================================================================
void Drv_DpRx_PcrInit(void)
{
    BKF3_00_REG = 0x40;//org-0x80
    
    BKF3_62_REG |= BIT4_1;//cbcr swap edid cts use

    //just valid for mst mode, sst mode [7] must be set 0
    BKF3_12_REG &= BIT7_0;//[7]rg_lane_cnt_soft_mode: 1-soft en, 0-soft dis
    BKF3_1E_REG |= BIT7_1;//[7]video timing regenerate if fifo over: 1-dis
    BKF3_21_REG = 0x94;//ratio lw lmt(lw max is 08)
    BKF3_22_REG = 0xe2;//ratio up lmt(up max is 1f)
    
    BKF3_23_REG = 0x7b;
    BKF3_31_REG = 0xa4;//lin_cnt_sel = 64
    BKF3_47_REG = 0x7b;
    BKF3_55_REG = 0x00;//pcrpll_rst_end  =0

    BKF3_63_REG = 0x06;//bit2 soft freq sel =1
//    BKF3_77_REG = 0x7a;//[0]fifo overflow than restart, 1-en
    //F377 BIT0:如果是HSYNC Mode，2204 SRAM溢出逻辑有问题
    BKF3_77_REG = 0x7f;//[0]fifo overflow than restart, 0-dis [2]:PCR hsync模式使能vblank微调
    BKF3_32_REG = 0x0b;//frequecy change to 2.5Mhz
    BKF3_79_REG = 0x30;
    BKF3_7B_REG = 0x41;
    BKF3_7D_REG = 0x52;
     //for dp rx cts test
    BKF3_7E_REG = 0x10;//[4]1-support crc for dp video cts
    
    BKF3_86_REG = 0x14;//[7]ycbcr420
    BKF3_87_REG = 0xe2;//[7]pcr adaptive sync mode: 1-en
                       //[6:0]ratio up lmt

    BKC8_B0_REG = 0x00;//gd_pcr_stb_chk_sel
    #if SYSCLK == SYS_CLK_40M
    BKC8_B1_REG = 0x28;//rgd_sys_cnt_1us[6:0]
    #endif
    #if SYSCLK == SYS_CLK_48M
    BKC8_B1_REG = 0x30;//rgd_sys_cnt_1us[6:0]
    #endif
    BKC8_B2_REG = 0x0f;//rgd_pcr_stb_chk1_cnt
}


void Drv_DpRx_PcrHsyncMode(void)
{
    BKF3_00_REG = 0x40;//pixel count save for fifo for dsc org-0x80
#if 1
    BKF3_23_REG = 0x02;
    BKF3_24_REG = 0x02;
    BKF3_25_REG = 0x02;
    BKF3_26_REG = 0x00;
    BKF3_47_REG = 0x91;
    BKF3_48_REG = 0x35;
    BKF3_49_REG = 0x30;
    BKF3_4A_REG = 0x2a;

    BKF3_4B_REG = 0x02;
    BKF3_4C_REG = 0x98;
    BKF3_4D_REG = 0x02;
    BKF3_4E_REG = 0x98;
    BKF3_4F_REG = 0x04;
    #else// macbook M1/M2 can not work stable
    BKF3_23_REG = 0x00;
    BKF3_24_REG = 0x00;
    BKF3_25_REG = 0x00;
    BKF3_26_REG = 0x00;
    BKF3_47_REG = 0xe1;
    BKF3_48_REG = 0xc5;
    BKF3_49_REG = 0x30;
    BKF3_4A_REG = 0x2a;

    BKF3_4B_REG = 0x01;
    BKF3_4C_REG = 0x00;
    BKF3_4D_REG = 0x01;
    BKF3_4E_REG = 0x00;
    BKF3_4F_REG = 0x02;
	#endif

    BKF3_46_REG |= BIT5_1;//[5]1-hsync mode, 0-de mode
    Drv_DpRx_420DetectMode(SOFTMODE);

    printLT(PRINT_PRIO_TEST, "\npcr hsync mode");
}

u8 Drv_DpRx_DeSkewCheck(void)
{
    BKF1_C2_REG |= BIT4_1;
    BKF1_C2_REG &= BIT4_0; //clear deskew status
    Ocm_Delay1ms(10);
    if(BKF1_FD_REG&BIT4_1)
    {
        return FAIL;
    }
    return SUCCESS;
}

void Drv_DpRx_Cp2520KeyCodeSet(u8 ucPtnMode)
{
    BKF1_B7_REG &= 0x37;
    switch(ucPtnMode)
    {
        case 0x03: //prbs7 pattern
            BKF1_B7_REG |= 0xc0;
            BKF1_C2_REG |= BIT6_1;
        break;
        case 0x05: //cp2520 pattern1: Data align use CP;
            BKF1_B7_REG |= 0x48;
            BKF1_C2_REG |= BIT6_1;
        break;
        case 0x06: //cp2520 pattern2: Data align use BF-;
            BKF1_B7_REG |= 0x88;
            BKF1_C2_REG |= BIT6_1;
        break;
        case 0x07: //cp2520 pattern3: Data align use BS;
            BKF1_B7_REG |= 0xc8;//tps4 pattern3 bit error 
            BKF1_C2_REG |= BIT6_1;
        break;
        default:
            BKF1_B7_REG |= 0xc8;//video bit error 
            BKF1_C2_REG &= BIT6_0;
            BKF1_B9_REG |= BIT4_1;
        break;
    }
}

//========================================================================
// Func Name   : Drv_DpRx_EccErrorCheck
// Description : Check ECC error, if ECC error is checked, the SDP data uncorrect.
// Input       : void  
// Output      : None
// Return      : SUCCESS: no ECC error.
//             : FAIL: ECC error.
//========================================================================
u8 Drv_DpRx_EccErrorCheck(void)
{ 
    if (BKF2_EF_REG != 0)
    {
        BKF2_10_REG |= BIT6_1;//[6]fec err clr en
        BKF2_10_REG &= BIT6_0;//[6]fec err clr dis
        return FAIL;
    }
    return SUCCESS;
}
void Drv_DpRx_MsaPktDetEn(void)
{
    BKF3_05_REG &= BIT6_0;//hardmsa
    BKF2_17_REG |= BIT2_1;//Msa valid interrupt enable

    BKF2_19_REG |= BIT2_1;//clear msa interrupt
    BKF2_19_REG &= BIT2_0;//clear msa interrupt
}
void Drv_DpRx_420DetectMode(u8 b1Softmode)
{
    if(b1Softmode == SOFTMODE)
    {
        BKF3_62_REG |= BIT7_1;//420 soft control
    }
    else
    {
        BKF3_62_REG &= BIT7_0;//420 vsc control
    }
}

//========================================================================
// Func Name   : Drv_DpRx_VscPktCheck
// Description : Vsc packet is an option SDP, this function is to check soucer whether send vsc packet.
// Input       : None
// Output      : None
// Return      : TRUE->source send vsc packet.
//             : FALSE->source did not send vsc packet
//========================================================================
u8 Drv_DpRx_VscPktCheck()
{
    if((MSA_MISC1 & BIT6_1)&&(VSC_HB1 == 0x07)&&(VSC_HB2 == 0x05)&&(VSC_HB3 == 0x13)&&((VSC_DB16&0xf0) <= 0x30))
    {
        return TRUE;
    }
    return FALSE;
}

void Drv_DpRx_VidColorInfoGet(ColorInfo_S *pstInfo)
{
    if(Drv_DpRx_VscPktCheck() == TRUE)
    {
        pstInfo->b1VscPkg            = TRUE;
        pstInfo->b1DynamicRange      = (VSC_DB17 >> 7) & BIT0_1;//1-cta range limit, 0-vesa range full
        pstInfo->ucPixelEncoding     = (VSC_DB16 >> 4) & 0x0f;//00-rgb, 01-ycc444, 10-ycc222, 11-ycc420
        
        if(pstInfo->ucPixelEncoding == DP_VSC_YCC422_2)
        {
            pstInfo->ucPixelEncoding = YCbCr422_1;
        }
        else  if(pstInfo->ucPixelEncoding == DP_VSC_YCC444_1)
        {
            pstInfo->ucPixelEncoding = YCbCr444_2;
        }
        
        pstInfo->ucColorimetryFormat = VSC_DB16 & 0x0f;
        pstInfo->ucBitDepth          = (VSC_DB17 & 0x07);//0-rgb 6bit 1-8bit, 2-10bit, 3-12bit: +3 is 4-8bit, 5-10bit, 6-12bit
    }
    else
    {
        pstInfo->b1VscPkg            = FALSE;
        pstInfo->b1DynamicRange      = (MSA_MISC0 >> 3) & BIT0_1;//1-cta range limit, 0-vesa range full
        pstInfo->ucPixelEncoding     = (MSA_MISC0 >> 1) & 0x03;  //00 rgb 01 ycc422 10 ycc444  11 rgb wide

        if(pstInfo->ucPixelEncoding == MISC_RGB_WIDE_3)
        {
            pstInfo->ucPixelEncoding = RGB_WIDE_4;
        }
        
        pstInfo->ucColorimetryFormat = (MSA_MISC0 >> 3) & 0x03;//
        pstInfo->ucBitDepth = ((MSA_MISC0 >> 5) & 0x07);//0-rgb 6bit 1-8bit, 2-10bit, 3-12bit: +3 is 4-8bit, 5-10bit, 6-12bit
    }
}

void Drv_DpRx_RxTimingGet(LtTiming_S *pstTiming)
{
    u16 usStart;
    //get H timing by dp rx msa
    pstTiming->usHact  = ((u16)BKF2_E7_REG << 8)          + BKF2_E8_REG;//msa hact
    pstTiming->usHsync = ((u16)(BKF2_DF_REG & 0x7f) << 8) + BKF2_E0_REG;//msa hsync
    usStart            = ((u16)BKF2_E1_REG << 8)          + BKF2_E2_REG;//msa hstart
    pstTiming->usHbp   = usStart - pstTiming->usHsync;
    pstTiming->usHtol  = ((u16)BKF2_DB_REG << 8)          + BKF2_DC_REG;//msa htol
    pstTiming->usHfp   = pstTiming->usHtol - pstTiming->usHact - usStart;

    //get V timing by dp rx msa
    pstTiming->usVact   = ((u16)BKF2_E9_REG << 8)          + BKF2_EA_REG;//msa vact
    pstTiming->usVsync  = ((u16)(BKF2_E5_REG & 0x7f) << 8) + BKF2_E6_REG;//msa vsync
    usStart             = ((u16)BKF2_E3_REG << 8)          + BKF2_E4_REG;//msa vstart
    pstTiming->usVbp    = usStart - pstTiming->usVsync;
    pstTiming->usVtol   = ((u16)BKF2_DD_REG << 8)          + BKF2_DE_REG;//msa vtol
    pstTiming->usVfp    = pstTiming->usVtol - pstTiming->usVact - usStart;
}

