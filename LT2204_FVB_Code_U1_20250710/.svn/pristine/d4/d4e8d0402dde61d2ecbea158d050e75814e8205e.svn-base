//========================================================================
// Func Name   : Drv_DpRx_DpcdInit
// Description : initial dpcd field of dp rx.
// Input       : IN StructDpRx pstDpRx  
// Output      : None
// Return      : void
//========================================================================
void Drv_DpRx_DpcdInit(IN StructDpRx pstDpRx)
{
    u8 ucTps3Support,ucTps4Support;
    u8 ucSscCap;
    u8 Dpcd007;
    #if DPRX_ADAPTIVE_SYNC == ENABLED
    
    if(pstDpRx.ucAdaptiveSync_En == TRUE)
    {
        Dpcd007 = 0x41;
    }
    else
    {
        Dpcd007 = 0x01;
    }
    #else
    Dpcd007 = 0x01;
    #endif
    ucSscCap      = (pstDpRx.b1Ssc_Support)?(0x01):(0x00);
    ucTps3Support = (pstDpRx.b1Tps3_Support)?(0xc0):(0x80);
    ucTps4Support = (pstDpRx.b1Tps4_Support)?(0x80):(0x00);
    
    Drv_DpRx_Dpcd_HighAddrWrite(0x00);
    Drv_DpRx_Dpcd_ValueWrite(0x00, DP1_2);//fixed to DP1.1
    if(pstDpRx.ucRxMaxLinkRate == HBR3)
    {
        Drv_DpRx_Dpcd_ValueWrite(0x01, HBR2);
    }
    else
    {
        Drv_DpRx_Dpcd_ValueWrite(0x01, pstDpRx.ucRxMaxLinkRate);
    }
    Drv_DpRx_Dpcd_ValueWrite(0x02,ucTps3Support | pstDpRx.ucRxMaxLaneCount);
    #if (DPRX_VERSION <= DP1_2)
    Drv_DpRx_Dpcd_ValueWrite(0x03,0x00|ucSscCap);
    #else
    Drv_DpRx_Dpcd_ValueWrite(0x03,ucTps4Support|ucSscCap);  
    #endif
    Drv_DpRx_Dpcd_ValueWrite(0x04,0x01);
    #if (DPRX_DFP_TYPE == BRANCH_HDMI)
    Drv_DpRx_Dpcd_ValueWrite(0x05,0x1d);//bit3:format conversion support
    #else
    Drv_DpRx_Dpcd_ValueWrite(0x05,0x00);//bit3:format conversion support
    #endif
    Drv_DpRx_Dpcd_ValueWrite(0x06,0x01);

    Drv_DpRx_Dpcd_ValueWrite(0x07,Dpcd007);//[6]msa_timing_par_ignored set 1 for adative sync mode

    #if (DPRX_TIMING_HBE == ENABLED)
    Drv_DpRx_Dpcd_ValueWrite(0x08,0x2a);//bit1:local edid bit3:HBE;bit4-5:Buffer size unit and per port
    #else
    Drv_DpRx_Dpcd_ValueWrite(0x08,0x02);//bit1:local edid bit3:HBE;bit4-5:Buffer size unit and per port
    #endif
    
    Drv_DpRx_Dpcd_ValueWrite(0x09,0x0f);//bit7-0:buffer size
    Drv_DpRx_Dpcd_ValueWrite(0x0a,0x04);//DPRX CTS 5.2.2.6
    Drv_DpRx_Dpcd_ValueWrite(0x0b,0x00);
    Drv_DpRx_Dpcd_ValueWrite(0x0c,0x00);//iic speed
    Drv_DpRx_Dpcd_ValueWrite(0x0d,0x00);//eDP configuration cap
    //dp1.4 support 2200h,100us for cr_lock,4ms for eq
    #if (DPRX_VERSION <= DP1_2)
    Drv_DpRx_Dpcd_ValueWrite(0x0e,0x01);
    #else
    Drv_DpRx_Dpcd_ValueWrite(0x0e,0x81);
    #endif
    #if DPRX_MST_MODE_EN == ENABLED
    Drv_DpRx_Dpcd_ValueWrite(0x21,0x01);//support mst
    #else
    Drv_DpRx_Dpcd_ValueWrite(0x21,0x00);//not support mst
    #endif
    Drv_DpRx_Dpcd_ValueWrite(0x22,0x00);
    Drv_DpRx_Dpcd_ValueWrite(0x23,0x00);

    Drv_DpRx_Dpcd_ValueWrite(0x60,0x00);//[0]dsc enable
    Drv_DpRx_Dpcd_ValueWrite(0x61,0x00);//[7:4]dsc minor verison, [3:0]dsc major version
    Drv_DpRx_Dpcd_ValueWrite(0x62,0x00);//[1:0]dsc rc buff, 03-64K
    
    #if ((DPRX_DSC_DEC_SUPPORT == ENABLED) || (DPRX_DSC_BYPASS_SUPPORT == ENABLED))

    #if (DPRX_DSC_DEC_SUPPORT == DISABLED)//Only Bypass
    if(g_stHdmiEdidInfo.ucMaxFrlDscRate == FRL_NOT_SPT)
    {
        ;
    }
    else
    {
        Drv_DpRx_Dpcd_ValueWrite(0x60,0x03);//[0]dsc enable
        Drv_DpRx_Dpcd_ValueWrite(0x61,0x21);//[7:4]dsc minor verison, [3:0]dsc major version
        Drv_DpRx_Dpcd_ValueWrite(0x62,0x03);//[1:0]dsc rc buff, 03-64K
    }
    #else
    Drv_DpRx_Dpcd_ValueWrite(0x60,0x03);//[0]dsc enable
    Drv_DpRx_Dpcd_ValueWrite(0x61,0x21);//[7:4]dsc minor verison, [3:0]dsc major version
    Drv_DpRx_Dpcd_ValueWrite(0x62,0x03);//[1:0]dsc rc buff, 03-64K
    #endif
    if(pstDpRx.b1DscAbnormal == TRUE)
    {
        Drv_DpRx_Dpcd_ValueWrite(0x60,0x00);//[0]dsc enable
    }
    
    Drv_DpRx_Dpcd_ValueWrite(0x63,0x7f);//[7:0]rc buff size, 7f-128, 64Kx128 is 8MB
    #if (DPRX_DSC_DEC_SUPPORT == DISABLED)//Only Dscpass
    if(g_stHdmiEdidInfo.ucMaxFrlDscRate == FRL_NOT_SPT)
    {
        ;
    }
    else
    {
        Drv_DpRx_Dpcd_ValueWrite(0x64,0x2b);//slice capability, 2b-8,4,2,1 slice support --4k144Hz
    }
    #elif (DPRX_DSC_BYPASS_SUPPORT == DISABLED)//Only decode
    Drv_DpRx_Dpcd_ValueWrite(0x64,0x0b);//slice capability, 2b-8,4,2,1 slice support --4k144Hz
    #else//
    if(g_stHdmiEdidInfo.ucMaxFrlDscRate == FRL_NOT_SPT)
    {
        Drv_DpRx_Dpcd_ValueWrite(0x64,0x0b);//slice capability, 2b-8,4,2,1 slice support --4k144Hz
    }
    else
    {
        Drv_DpRx_Dpcd_ValueWrite(0x64,0x2b);//slice capability, 2b-8,4,2,1 slice support --4k144Hz
    }
    #endif
    Drv_DpRx_Dpcd_ValueWrite(0x65,0x04);//line buff depth, 04-13bit needed
    Drv_DpRx_Dpcd_ValueWrite(0x66,0x03);//[0]1-block prediction is support
	#if (DPRX_DFP_TYPE == BRANCH_HDMI)
	//bypass mode, Asus 4k144 4k120,BPP大于18不显示
    Drv_DpRx_Dpcd_ValueWrite(0x67,0x00);//[7:0]dsc max bpp support
	Drv_DpRx_Dpcd_ValueWrite(0x68,0x01);//[9:8]dsc max bpp support, a0-10bpp
	#else
	Drv_DpRx_Dpcd_ValueWrite(0x67,0x00);//[7:0]dsc max bpp support
	Drv_DpRx_Dpcd_ValueWrite(0x68,0x01);//[9:8]dsc max bpp support, a0-10bpp
	#endif
    
    Drv_DpRx_Dpcd_ValueWrite(0x69,0x17);//color space support, 1f-all color space support
    Drv_DpRx_Dpcd_ValueWrite(0x6a,0x06);//bpc support,06 - 8,10bpc support
    Drv_DpRx_Dpcd_ValueWrite(0x6b,0x11);//peak dsc throughout ,peak 400M
    Drv_DpRx_Dpcd_ValueWrite(0x6c,0x08);//slice width is 8 x 320
    Drv_DpRx_Dpcd_ValueWrite(0x6d,0x00);//16 20 24 slice num support
    Drv_DpRx_Dpcd_ValueWrite(0x6e,0x00);//reserved
    Drv_DpRx_Dpcd_ValueWrite(0x6f,0x00);//dsc bpp increment: 00-1/16bpp, 04-1bpp
    #endif
    #if (DPRX_DFP_TYPE == BRANCH_HDMI)
    Drv_DpRx_Dpcd_ValueWrite(0x80,0x4b);
    Drv_DpRx_Dpcd_ValueWrite(0x81,0xF0);//TMDS 600Mhz
    Drv_DpRx_Dpcd_ValueWrite(0x82,0x16);//8/10/12bit
    Drv_DpRx_Dpcd_ValueWrite(0x83,0x1e);//CSC support and 420/422 support
    #else
    Drv_DpRx_Dpcd_ValueWrite(0x80,0x08);
    #endif

    #if ((DPRX_FEC_SUPPORT == ENABLED)||(DPRX_DSC_DEC_SUPPORT == ENABLED)||(DPRX_DSC_BYPASS_SUPPORT == ENABLED))
    Drv_DpRx_Dpcd_ValueWrite(0x90,0xbf);
    #else
    Drv_DpRx_Dpcd_ValueWrite(0x90,0x00);
    #endif
    //DPCD10A default value is 0x02
    Drv_DpRx_Dpcd_HighAddrWrite(0x01);
    Drv_DpRx_Dpcd_ValueWrite(0x0a,0x00);//to fix not support non-enhanced framing mode issue.

////the reason why remove DPCD200 is the value returned to TX is from software
////the reason why remove DPCD2002 is 2002 can not be programmed
//    Drv_DpRx_Dpcd_HighAddrWrite(0x02);
//    #if DPRX_MST_MODE_EN == ENABLED
//    Drv_DpRx_Dpcd_ValueWrite(0x00,DPRX_MST_SINK_CNT);//sink cnt is 1
//    #else
//    Drv_DpRx_Dpcd_ValueWrite(0x00,0x01);//sink cnt is 1
//    #endif
    
//    Drv_DpRx_Dpcd_HighAddrWrite(0x20);
//    Drv_DpRx_Dpcd_ValueWrite(0x02,0x01);//sink cnt = 1

    #if DPRX_MST_MODE_EN == ENABLED
    Drv_DpRx_Dpcd_HighAddrWrite(0x05);
    Drv_DpRx_Dpcd_ValueWrite(0x00,0x90);
    Drv_DpRx_Dpcd_ValueWrite(0x01,0xcc);
    Drv_DpRx_Dpcd_ValueWrite(0x02,0x24);
    Drv_DpRx_Dpcd_ValueWrite(0x03,0x53);
    Drv_DpRx_Dpcd_ValueWrite(0x04,0x59);
    Drv_DpRx_Dpcd_ValueWrite(0x05,0x4e);
    Drv_DpRx_Dpcd_ValueWrite(0x06,0x41);
    Drv_DpRx_Dpcd_ValueWrite(0x07,0x53);
    Drv_DpRx_Dpcd_ValueWrite(0x08,0x20);

    Drv_DpRx_Dpcd_ValueWrite(0x10,0xbe);
    Drv_DpRx_Dpcd_ValueWrite(0x11,0x05);
    #endif
    #if DPRX_VERSION <= DP1_2
    Drv_DpRx_Dpcd_HighAddrWrite(0x22);
    Drv_DpRx_Dpcd_ValueWrite(0x00,0x00);
    Drv_DpRx_Dpcd_ValueWrite(0x01,0x00); 
    Drv_DpRx_Dpcd_ValueWrite(0x02,0x00);
    Drv_DpRx_Dpcd_ValueWrite(0x06,0x00);
    Drv_DpRx_Dpcd_ValueWrite(0x07,0x00);//1DFPs
    Drv_DpRx_Dpcd_ValueWrite(0x0e,0x00);
    #else
    Drv_DpRx_Dpcd_HighAddrWrite(0x22);
    Drv_DpRx_Dpcd_ValueWrite(0x00,DP1_4);//fixed to DP1.4
    Drv_DpRx_Dpcd_ValueWrite(0x01,pstDpRx.ucRxMaxLinkRate);
    Drv_DpRx_Dpcd_ValueWrite(0x02,ucTps3Support|pstDpRx.ucRxMaxLaneCount);
    Drv_DpRx_Dpcd_ValueWrite(0x03,ucTps4Support|ucSscCap);  
    Drv_DpRx_Dpcd_ValueWrite(0x04,0x01);
    #if (DPRX_DFP_TYPE == BRANCH_HDMI)
    Drv_DpRx_Dpcd_ValueWrite(0x05,0x1d);
    #else
    Drv_DpRx_Dpcd_ValueWrite(0x05,0x00);
    #endif

    Drv_DpRx_Dpcd_ValueWrite(0x06,0x01);
//在HDMI Mode下，14号笔记本一定要将Bit0置1
    Drv_DpRx_Dpcd_ValueWrite(0x07,Dpcd007);//[6]msa_timing_par_ignored set 1 for adative sync mode


    #if DPRX_TIMING_HBE == ENABLED
    Drv_DpRx_Dpcd_ValueWrite(0x08,0x2a);//bit1:local edid bit3:HBE;bit4-5:Buffer size unit and per port
    #else
    Drv_DpRx_Dpcd_ValueWrite(0x08,0x02);//bit1:local edid bit3:HBE;bit4-5:Buffer size unit and per port
    #endif
    Drv_DpRx_Dpcd_ValueWrite(0x09,0x0f);//port0 bit7-0:buffer size in pixels (512)
    Drv_DpRx_Dpcd_ValueWrite(0x0a,0x04);//This port is used for the secondary isochronous stream of the main stream received
    Drv_DpRx_Dpcd_ValueWrite(0x0b,0x00);//port1 bit7-0:buffer size in pixels (00)
    Drv_DpRx_Dpcd_ValueWrite(0x0c,0x00);
    Drv_DpRx_Dpcd_ValueWrite(0x0d,0x00);
    //4ms for symbol lock
    Drv_DpRx_Dpcd_ValueWrite(0x0e,0x81);
    Drv_DpRx_Dpcd_ValueWrite(0x10,0x08);//VSC support

    #if DPRX_ADAPTIVE_SYNC == ENABLED
    Drv_DpRx_Dpcd_ValueWrite(0x14,0x01);//[1]adaptive_sync_sdp_supported
    #endif
    #endif
}

//========================================================================
// Func Name   : Drv_DpRx_PhyInit
// Description : Select which phy dig_wclk for link clock.
                 //            connector----phy-------------digitail
                 //            D0-----------D0---------------D0
                 //            D1-----------D1---------------D1
                 //            D2-----------D2---------------D2
                 //            D3-----------D3---------------D3
// Input       : void  
// Output      : None
// Return      : void
//========================================================================
void Drv_DpRx_PhyInit(void)
{
    BKA1_08_REG = 0x0b;//[7]rg_dhrx_ldo_en: 0-disable, eq power use external vcc11_dhrx;
                       //[6:4]rg_dhrx_ldo_vset: 000-1.1v
                       //[3]rg_dhrx_en: 0-dis, 1-en;
                       //[2:0]rg_dhrx_vcm_adj: 011-0.75v

    BKA1_09_REG = 0xff;//[7:4]rg_dhrx_d0(d0~d3)_hseq_en
    //PKT DET needs to be 1
    BKA1_0A_REG = 0xf0;//[7:4]rg_dhrx_d0(d0~d3)_pkdet_en; 
                       //[3:0]rg_dhrx_d0(d0~d3)_clkdet_en;
    BKA1_0B_REG = 0x8f;//[7:4]D0 link clk enable.
                       //[3:0]D0/D1/D2/D3 dig_clk enable.
    BKA1_0C_REG  = 0x7c;//[2:0]rg_dhrx_pkdet_sdth:
    BKA1_0D_REG = 0xa8;//[7:6]rg_dhrx_temp_sense_vset; 
                       //[5]rg_dhrx_temp_sense_en
                       //[4]rg_dhrx_eqrg_sel: 0-small range, 1-large range for 121 mode only
                       //[3]rg_dhrx_mxchsel: do not touch this bit, default is 1
                       //[2]rg_dhrx_refclk_sel: 0-sel from eq path, 1-sel from dhrxpll
                       //[1]rg_dhrx_linkclk_sel: 0-sel from dhrx, 1-sel from dhrxpll
                       //[0]rg_dhrx_linkclk_div2_en: 0-use from normal half-rate mode, 1-use for new full-rate mede;
    BKA1_0E_REG &= 0xfc;
    BKA1_0E_REG |= 0x03;
    BKA1_0E_REG &= 0xf3;//[7:4]rg_dhrx_d0(d0~d3)bf2cdr_en; [3:2]2'b00 = Stronger DFE; [1:0]rg_dhrx_bf2cdr_fbis;
    BKA1_0E_REG |= 0x04;//DFE 
}

void Drv_DpRx_PhyShut(void)//主要是关term
{
    BKA1_09_REG = 0x00;
    BKA1_1F_REG = 0x0f;//[4]rg_dhrxpi_bias_en: 0-dis;
                       //[3:0]rg_dhrxpi_pd: 4'b1111 = four channel power down
}

void Drv_DpRx_RtermCal(void)
{
    u8 ucIndex;
    u8 ucResult = FAIL;
    
    BKA1_08_REG |= BIT3_1;//[3]rg_dhrx_en: 0-dis, 1-en;
    ucIndex = 10;
    while(ucIndex--)
    {
        BKE2_00_REG &= BIT0_0;//[0]rgd_dhrx_rterm_cali_en, 0-dis
        Ocm_Delay1ms(1);
        BKE2_00_REG |= BIT0_1;//[0]rgd_dhrx_rterm_cali_en, 1-en
        Ocm_Delay1ms(2);
        if(0x02 == (BKE2_07_REG & 0x03))//[1]rgod_dhrx_rterm_cali_done: 1-done; [0]rgod_dhrx_rterm_cali_fail: 1-fail
        {
            ucResult = SUCCESS;
            break;
        }
    }
    printLT(PRINT_PRIO_HIG, "\nRx Rterm is 0x%02bx", BKE2_08_REG);
    if(ucResult == SUCCESS)//Rterm calibration done
    {
        printLT(PRINT_PRIO_HIG, "\nCali success");
    }
    else
    {
        printLT(PRINT_PRIO_HIG, "\nCali failed");
    }
}


//========================================================================
// Func Name   : Drv_DpRx_CrLockThresholdSet
// Description : Set threshold of cr lock, to force tps1 fail.
//             : is used to get a higher swing level.
// Input       : TRUE-> force tps1 fail.
//             : FLASE-> tps normal.
// Output      : None
// Return      : void
//========================================================================
void Drv_DpRx_CrLockThresholdSet(u8 b1IsLock)
{
    if (b1IsLock == TRUE)
    {
        BKF1_19_REG = 0x00; 
        BKF1_1A_REG = 0x00; //err cnt threshold for cr lock.
        BKF1_06_REG = 0xff; //rx data force 0xff
        BKF1_52_REG = 0x0f;
    }
    else
    {
        BKF1_19_REG = 0x00;
        BKF1_1A_REG = 0x02;
        BKF1_06_REG = 0x00;
        BKF1_52_REG = 0x00;
    }
}

void Drv_DpRx_PiEnable(u8 ucOpt)
{
    if (ON == ucOpt)
    {
        BKA1_1F_REG = 0x10;//[4]rg_dhrxpi_bias_en: 1-en
                           //[3:0]rg_dhrxpi_pd: 4'b0000 = four channel normal
    }
    else
    {
        BKA1_1F_REG = 0x0f;//[4]rg_dhrxpi_bias_en: 0-dis;
                           //[3:0]rg_dhrxpi_pd: 4'b1111 = four channel power down.
    }
}

void Drv_DpRx_PiSet(u8 ucLinkRate)
{
    switch(ucLinkRate)
    {
        case RBR:
            #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR
            BKA1_25_REG = 0x84;
            BKA1_26_REG = 0x9e;
            BKA1_27_REG = 0x9e;
            BKA1_28_REG = 0x16;
            #else
            BKA1_26_REG = 0x13;
            BKA1_27_REG = 0x13;
            #endif
            break;
        case HBR:
            #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR
            BKA1_25_REG = 0x8d;
            BKA1_26_REG = 0x9e;
            BKA1_27_REG = 0x9e;
            BKA1_28_REG = 0x16;
            #else
            BKA1_26_REG = 0x13;
            BKA1_27_REG = 0x13;
            #endif
            break;
        case HBR2:
            #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR
            BKA1_25_REG = 0x9c;
            BKA1_26_REG = 0x8f;
            BKA1_27_REG = 0x8f;
            BKA1_28_REG = 0x17;
            #else
            BKA1_26_REG = 0x13;
            BKA1_27_REG = 0x13;
            #endif
        break;
        case HBR3:
            BKA1_25_REG = 0x03;
            BKA1_26_REG = 0x80;
            BKA1_27_REG = 0x80;
            BKA1_28_REG = 0x03;
        break;
        default:
            BKA1_25_REG = 0x03;
            BKA1_26_REG = 0x13;
            BKA1_27_REG = 0x13;
            BKA1_28_REG = 0x03;
        break;
    }
}

void Drv_DpRx_FreqIntg(void)
{
    BKC8_20_REG = 0x0a;
    BKC8_21_REG = 0xcd;//soft freq intg value lane0
    BKC8_22_REG = 0x0a;
    BKC8_23_REG = 0xcd;//soft freq intg value lane1
    BKC8_24_REG = 0x0a;
    BKC8_25_REG = 0xcd;//soft freq intg value lane2
    BKC8_26_REG = 0x0a;
    BKC8_27_REG = 0xcd;//soft freq intg value lane3
}
//========================================================================
// Func Name   : Drv_DpRx_TrainingReset
// Description : Include phy, pi, cdr reset, to ensure cdr working normally
// Input       : u8 b1SscEnable  
// Output      : None
// Return      : void
//========================================================================

#if DPRX_CDR_MODE == ANACDR
void Drv_DpRx_AnaCdrRst(u8 ucLinkRate)
{
    BKA1_44_REG = 0xc0; //anacdr extref mode enable

    BKE1_0D_REG &= 0xfe; //[0]1'b0:dhrxpll cdr reset
    BKE1_0D_REG |= 0x01; //[0]1'b1:dhrxpll cdr release

    BKE1_0C_REG &= 0xf0; //[3:0]dhrx d3~d0 reset
    BKE1_0D_REG &= 0xe1; //[4:1]dhrx pi3~0 reset
    BKC9_03_REG &= 0x0f; //[7:4]dig cdr reset
    Ocm_Delay1us(10);
    BKA1_38_REG = (ucLinkRate >= HBR2)?(0x37):(0x27);
    BKA1_44_REG = 0x80; //anacdr extref mode disable
    
    BKE1_0C_REG |= 0x0f; //[3:0]dhrx d3~d0 release
    BKE1_0D_REG |= 0x1e; //[4:1]dhrx pi3~0 release
    BKC9_03_REG |= 0xf0; //[7:4]dig cdr release
    
    BKA1_44_REG = 0x00;
}
#endif
#if ((DPRX_CDR_MODE == FULL_SPEED_DIGCDR)||(DPRX_CDR_MODE == HALF_SPEED_DIGCDR))
void Drv_DpRx_DigCdrRst(u8 b1SscEnable)
{
    if(b1SscEnable == TRUE)
    {
        BKC8_28_REG = 0xf0; //7:4rgd_cdr_sw_freq_intg_en: 1-en
    }

    BKE1_0C_REG &= 0xf0;//[6]rgd_sw_dhrx_rst_n: 0-en
    BKE1_0D_REG &= 0xe1;//[4:1]rg_sw_dhrxpi3(3~0)_rst_n: 0-en ;
    BKC9_03_REG &= 0x0f;// rx cdr reset

    BKE1_0C_REG |= 0x0f;//[6]rgd_sw_dhrx_rst_n: 1-dis
    BKE1_0D_REG |= 0x1e;//[4:1]rg_sw_dhrxpi3(3~0)_rst_n: 1-dis; 
    BKC9_03_REG |= 0xf0;//rx cdr reset
    
    BKC8_28_REG = 0x00; //rgd_cdr_sw_freq_intg_en: 0-dis
    
}
#endif
#if DPRX_CDR_MODE == ANACDR
void Drv_DpRx_CdrSet(u8 ucLinkRate)
{
    BKC8_11_REG = 0x00;
    switch (ucLinkRate)
    {
        case RBR : //1.62G
        case HBR : //2.7G
            BKC8_12_REG = 0x00;
            break;
        case HBR2 : //5.4G
        case HBR3 : //8.1G
            BKC8_12_REG = 0x02;
            break;
        default:
            break;
    }
}
#else
void Drv_DpRx_CdrSet(u8 b1SscEnable,u8 ucLinkRate)
{
    #if ((DPRX_CDR_MODE == FULL_SPEED_DIGCDR)||(DPRX_CDR_MODE == HALF_SPEED_DIGCDR))
    BKC8_11_REG |= BIT0_1; //rgd_cdr_ord_sel = 1: second order.
    switch (ucLinkRate)
    {
        case RBR : //1.62G
            #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR
            BKC8_12_REG = (b1SscEnable == 0)?(0x3a):(0x7a); //[3:0]phug,[7:4]frug
            #else
            BKC8_12_REG = (b1SscEnable == 0)?(0x37):(0x79); //[3:0]phug,[7:4]frug
            #endif
            break;
        case HBR : //2.7G
            #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR
            BKC8_12_REG = (b1SscEnable == 0)?(0x3a):(0x7a); //[3:0]phug,[7:4]frug
            #else
            BKC8_12_REG = (b1SscEnable == 0)?(0x37):(0x69); //[3:0]phug,[7:4]frug
            #endif
            break;
        case HBR2 : //5.4G
            #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR
            BKC8_12_REG = (b1SscEnable == 0)?(0x39):(0x78); //[3:0]phug,[7:4]frug
            #else
            BKC8_12_REG = (b1SscEnable == 0)?(0x37):(0x77); //[3:0]phug,[7:4]frug
            #endif
            break;
        case HBR3 : //8.1G
            BKC8_12_REG = (b1SscEnable == 0)?(0x36):(0x77);  //[3:0]phug,[7:4]frug
            break;
        default:
            break;
    }
    #endif
}
#endif
void Drv_DpRx_CdrLoopDivSet(u8 ucLinkRate)//issue for the cdr
{
    #if DPRX_CDR_MODE == ANACDR
    BKA1_1B_REG = 0x90; //[5:4]:11-cdr loop div 8
    BKC8_19_REG = 0x05;//[1:0]:11-cdr loop div 8
    switch (ucLinkRate)
    {
        case RBR :
            break;
        case HBR :
            break;
        case HBR2 :
            break;
        case HBR3 :       
            break;
        default:
            break;
    }
    #endif
    #if ((DPRX_CDR_MODE == FULL_SPEED_DIGCDR)||(DPRX_CDR_MODE == HALF_SPEED_DIGCDR))
    switch (ucLinkRate)
    {
        case RBR :
            #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR
            BKA1_1B_REG = 0xb0; //[5:4]:11-cdr loop div 4
            BKC8_19_REG = 0x0f; //[3]1'b1:CDR full rate enable
                                //[2]1'b1:CDR s2p divder set software
                                //[1:0]2'b:CDR s2p div set sel:DIV 4
            #else
            BKA1_1B_REG = 0xb0; //[5:4]:11-cdr loop div 4
            BKC8_19_REG = 0x07;
            #endif
            break;
        case HBR :
            #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR
            BKA1_1B_REG = 0x90; //[5:4]:11-cdr loop div 8
            BKC8_19_REG = 0x0d; //[3]1'b1:CDR full rate enable
                                //[2]1'b1:CDR s2p divder set software
                                //[1:0]2'b01:CDR s2p div set sel:DIV 8
            #else
            BKA1_1B_REG = 0xb0; //[5:4]:11-cdr loop div 4
            BKC8_19_REG = 0x07;
            #endif
            break;
        case HBR2 :
            #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR
            BKA1_1B_REG = 0x90; //[5:4]:11-cdr loop div 10
            BKC8_19_REG = 0x0d; //[3]1'b1:CDR full rate enable
                                //[2]1'b1:CDR s2p divder set software
                                //[1:0]2'b00:CDR s2p div set sel:DIV 10
            #else
            BKA1_1B_REG = 0x90; //[5:4]:11-cdr loop div 8
            BKC8_19_REG = 0x05;
            #endif
            break;
        case HBR3 :
            BKA1_1B_REG = 0x90; //[5:4]:11-cdr loop div 8
            BKC8_19_REG = 0x05;//[1:0]:11-cdr loop div 8            
            break;
        default:
            break;
    }
    #endif
}

void Drv_DpRx_PcrPllInit(void)
{
    BKA3_20_REG &= BIT4_0;//[4]rg_pcrpll_pd: 0-normal work
    BKA3_20_REG &= 0xfc;  //[1:0]rg_pcrpll_ref_sel: 00-Xtal_25m_clk
    BKA3_23_REG = 0x01;//[6:4]rg_pcrpll_half_pcrck_muxsel : 010-aa_pll_half_pix_clk
    BKA3_24_REG = 0x00;//[6:4]rg_pcrpll_half_pixck_muxsel : 010-sel pixel clk
    BKA3_25_REG = 0x01;//[6:4]rg_pcrpll_half_tmdsck_divsel: 010-aa_pll_half_pix_clk
    BKA3_26_REG = 0x01;//[6:4]rg_pcrpll_dscin_muxsel      : 000-aa_pll_pix_clk

    BKE2_3D_REG = 0x20;//ks =2;
//    BKE2_3D_REG &= BIT3_0;
    BKE2_3D_REG |= BIT3_1;//pcrpll_cal_en = 1: 
}


void Drv_DpRx_ClkMux(void)
{
    //sel rx link ckk
    BKA3_3D_REG = 0x20;//[6:4]rg_clkgen_div_link_muxsel //aa_dhrx_link_clk
    
    //sel pixel clk
    BKA3_45_REG = 0x00; //[4]rg_clkgen_dscin_clk_recvsel     : 0-aa_pcrpll_dsc_in_clk
                        //[3:1]rg_clkgen_divpcr_clk_recvsel  : 000-aa_pcrpll_div_pcr_clk
                        //[0]rg_clkgen_pix_clk_recvsel       : 0-aa_pcrpll_pix_clk
    BKA3_46_REG = 0x00;//[2:0]rg_clkgen_pcr_clk_recvsel      : 000-aa_pcrpll_pcr_clk

    //sel pixel clk 
    BKA3_3C_REG = 0x01;//[6:4]rg_clkgen_cscrx_halfpix_muxsel: 000-aa_pcrpll_pix_clk or aa_secpcrpll_pix_clk
                            //[3:0]rg_clkgen_cscrx_halfpix_divsel: div 1
    BKA3_3E_REG = 0x11;//[6:4]rg_clkgen_dscout_muxsel       : 001-aa_pcrpll_pix_clk
                       //[3:0]rg_clkgen_dscout_divse        : div 2
    BKA3_3F_REG = 0x01;//ad_dscrx_dsc_clk    2f/2
    BKA3_40_REG = 0x11;//ad_dscrx_dsc_rd_clk 2f/2
    
    BKA3_41_REG = 0x01;//[6:4]rg_clkgen_dsctx_dsc_muxsel    : 000-aa_pcrpll_pix_clk
    BKA3_42_REG = 0x11;//[6:4]rg_clkgen_dsctx_dscrd_muxsel  : 001-aa_pcrpll_pix_clk
                         //[3:0]rg_clkgen_dsctx_dscrd_divsel : div 2  
}


void Drv_DpRx_RxPllBand(u8 ucLinkRate)
{
    #if DPRX_CDR_MODE == ANACDR
    switch(ucLinkRate)
    {
        case RBR:
        case HBR:
            BKA1_31_REG = 0x08; //[3:0]rxpll cp
            BKA1_33_REG = 0x60; //[2]1'b0:anacdr new fd mode disable
            BKA1_3A_REG = 0x02; //[7:4]:acdr fdcp;[3:0]:acdr pdcp
                                //[7:4]4'b0000:dhrxpll_fdcp_cursel;//[3:0]4'b0010:dhrxpll_pdcp_cursel
            BKA1_3B_REG = 0x87; //anacdr v2i
            break;
        case HBR2:
//            BKA1_31_REG = 0x08; //[3:0]rxpll cp
//            BKA1_33_REG = 0x60; //[2]1'b0:anacdr new fd mode disable
//			//03-->07 solve ANACDR unlock issue
//            BKA1_3A_REG = 0x04; //[7:4]:acdr fdcp;[3:0]:acdr pdcp
//                                //[7:4]4'b0000:dhrxpll_fdcp_cursel;//[3:0]4'b0100:dhrxpll_pdcp_cursel
//            //R7 360 0xc7 cause Training fail
//			BKA1_3B_REG = 0xc7; //anacdr v2i
//            
            BKA1_31_REG = 0x08; //[3:0]rxpll cp
            BKA1_33_REG = 0x64; //[2]1'b0:anacdr new fd mode disable
            BKA1_38_REG = 0x37; //[2]1'b0:anacdr new fd mode disable
			//03-->07 solve ANACDR unlock issue
            BKA1_39_REG = 0x06;
            BKA1_3A_REG = 0x12; //[7:4]:acdr fdcp;[3:0]:acdr pdcp
                                //[7:4]4'b0000:dhrxpll_fdcp_cursel;//[3:0]4'b0100:dhrxpll_pdcp_cursel
            //R7 360 0xc7 cause Training fail
			BKA1_3B_REG = 0xA7; //anacdr v2i
        
//            BKA1_31_REG = 0x08; //[3:0]rxpll cp
//            BKA1_33_REG = 0x64; //[2]1'b0:anacdr new fd mode disable
//			//03-->07 solve ANACDR unlock issue
//            BKA1_38_REG = 0x37; //[2]1'b0:anacdr new fd mode disable
//            BKA1_39_REG = 0x06;
//            BKA1_3A_REG = 0x12; //[7:4]:acdr fdcp;[3:0]:acdr pdcp
//                                //[7:4]4'b0000:dhrxpll_fdcp_cursel;//[3:0]4'b0100:dhrxpll_pdcp_cursel
//            //R7 360 0xc7 cause Training fail
//			BKA1_3B_REG = 0xA7; //anacdr v2i
            break;
        case HBR3:
		//for 5M cable
            BKA1_31_REG = 0x08; //[3:0]rxpll cp
            BKA1_33_REG = 0x64; //[2]1'b1:anacdr new fd mode
            BKA1_38_REG = 0x37; //[2]1'b0:anacdr new fd mode disable
            BKA1_39_REG = 0x04;
            BKA1_3A_REG = 0x48; //[7:4]:acdr fdcp;[3:0]:acdr pdcp
                                //[7:4]4'b0110:dhrxpll_fdcp_cursel;//[3:0]4'b0110:dhrxpll_pdcp_cursel
            BKA1_3B_REG = 0x87; //anacdr v2i
                                //兼容AMD6900 ecc error问题,0x47->0x87----2023.7.10
                                //兼容980B 出图后误码突增的问题----2023.7.11
            break;
        default:
            break;
    }
    #endif
    #if ((DPRX_CDR_MODE == FULL_SPEED_DIGCDR)||(DPRX_CDR_MODE == HALF_SPEED_DIGCDR))
    switch(ucLinkRate)
    {
        case RBR:
            #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR
            BKC7_E6_REG |= BIT3_1; //[3]1'b1:RX full speed for DP enable
            BKA1_0D_REG = 0xa9;    //[0]1'b1:Use for new full-rate mode
            BKA1_31_REG = 0x08;    //[3:0]rxpll cp
            BKA1_3E_REG = 0x50;    //1.62g full speed-fb div /2
            #else
            BKA1_31_REG = 0x01;    //[3:0]rxpll cp
            BKA1_42_REG = 0x90;    //rxpll freqset= 1
            #endif
            break; 
        case HBR:
            #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR 
            BKC7_E6_REG |= BIT3_1; //[3]1'b1:RX full speed for DP enable
            BKA1_0D_REG = 0xa9;    //[0]1'b1:Use for new full-rate mode
            BKA1_31_REG = 0x08;    //[3:0]rxpll cp
            BKA1_3E_REG = 0x50;    //2.7g full speed-fb div /2
            #else
            BKA1_31_REG = 0x08;   //[3:0]rxpll cp
            BKA1_42_REG = 0x80;   //rxpll freqset= 0
            #endif
            break;
        case HBR2:
            #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR
            BKC7_E6_REG |= BIT3_1; //[3]1'b1:RX full speed for DP enable
            BKA1_0D_REG = 0xa9;    //[0]1'b1:Use for new full-rate mode
            BKA1_31_REG = 0x88;    //[7]1'b1:iband enhace enable; [3:0]rxpll cp
            BKA1_3E_REG = 0x50;    //5.4g full speed-fb div /2
            #else
            BKA1_31_REG = 0x08;   //[3:0]rxpll cp
            BKA1_42_REG = 0x80;   //rxpll freqset= 0
            #endif
            break;
        case HBR3:
            #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR
            BKC7_E6_REG &= BIT3_0; //[3]1'b0:RX full speed for DP disable
            BKA1_0D_REG = 0xa8;    //[0]1'b0:use for normal half-rate mode
            BKA1_3E_REG = 0x60;    //8.1g-fb div /1
            #endif
            BKA1_31_REG = 0x08;    //[7]1'b0:iband enhace disable;[3:0]rxpll cp
            BKA1_42_REG = 0x80;    //rxpll freqset= 0
            break;
        default:
             break;
    }
    BKA1_30_REG &= BIT5_0;//[5]rg_dhrxpll_vcodiv_rst_n: 0-en
    BKA1_30_REG |= BIT5_1;//[5]rg_dhrxpll_vcodiv_rst_n: 1-dis
    #endif
}

void Drv_DpRx_RxPllCali(void)
{
    u8 ucCnt;
    u8 ucloop_rxpll_cal;
    #if DPRX_CDR_MODE == ANACDR
    u8 ucLoop_Cnt;
    u8 ucCal_Det_Cnt,ucCal_Cnt;
    u16 usRxpll_Ref_Cnt,usRxpll_Cal_Cnt,usRxpll_Avg_CalCnt;
    u16 usRxpll_Sum_CalCnt[5];
    u16 usTemp_Min_Cnt; 
    #endif
    BKA1_30_REG &= BIT7_0; //pd disable
    BKA1_30_REG |= BIT3_1; //bias enable
    BKA1_30_REG |= BIT2_1; //sel dp mode
    BKA1_30_REG &= 0xfc;   //bit7 pll power on [1:0]rg_dhrxpll_ref_sel: 00-xtal_25m_clk or xtal_50m_clk

    BKA1_33_REG = 0x60; //rxpll prediv = 1
    BKA1_3E_REG = 0x60; //rxpll fb div = 1;
    BKA1_42_REG = 0x80; //rxpll freqset= 0
    BKA1_3B_REG = 0x00;//not ana cdr V2T need close
    BKA1_44_REG = 0x80;    //[7]1'b1:dhrxpll cdr extref mode software mode;[6]1'b0:anacdr extref mode set:0-disable
                           //dhrxpll cdr extref mode sel software mode and set anacdr extref mode is 0;

    BKE3_00_REG &= BIT1_0; //[1]rgd_dhrxpll_cal_pll_cal_en_auto_en: 1-> calibrate multiple frequency.
    BKE3_01_REG = 0x20;    //[5:4]ks = 2;


    #if DPRX_CDR_MODE == ANACDR
    BKA1_32_REG = 0x00; //dhrxpll v2i close when anacdr mode
    BKA1_38_REG = 0x27; //[5]1'b1:anacdr lpf for high speed;[0]1'b1:anacdr pd buffer enable
    BKA1_39_REG = 0x06; //[3:0]4'b0111:analog cdr fd loop bandwidth select:1/4
    BKA1_3B_REG = 0x87;//not ana cdr V2T need close
    BKA1_43_REG |= 0x30; // force ana cdr open
    BKA1_44_REG |= 0x30;// rxpll open mode
    BKE3_01_REG |=BIT0_1; //[0]1'b1:dhrxpll cal_cdr cal en
    #endif
    
    BKE3_09_REG = 0x03;   // [3:2] = 00: calibration HDMI/DP select: 00-> HDMI1.4/2.0, to fix bug.
                          // [1:0] = 11: calibration train_sel: software control mode
    BKE3_0B_REG &= BIT0_0;// [0]rgd_dhrxpll_cal_pll_band_sw_en: 0-dis
    
    ucloop_rxpll_cal = 2;
    for(ucloop_rxpll_cal = 0; ucloop_rxpll_cal < 4;ucloop_rxpll_cal++)
    {
        #if DPRX_CDR_MODE == FULL_SPEED_DIGCDR
        BKA1_31_REG = (ucloop_rxpll_cal == 2)?(0x88):(0x08);   //5.4g:iband enhace
        BKA1_3E_REG = (ucloop_rxpll_cal <= 2)?(0x50):(0x60);   //1.62g,2.7g,5.4g:fb div/2;8.1g:fb div/1
        #endif
        #if DPRX_CDR_MODE == HALF_SPEED_DIGCDR
        BKA1_42_REG = (ucloop_rxpll_cal == 0)?(0x90):(0x80); //freq set
        #endif
        
        BKE3_0A_REG &= 0x3f;//[5:4]rgd_dhrxpll_cal_frl_set_mode_sel: 00-auto ctrl mode
        switch(ucloop_rxpll_cal)
        {
            case 0x00:
                BKE3_0A_REG |= 0x00; //[7:6] = 00: train_sel software set: 1.62G
                break;
            case 0x01:
                BKE3_0A_REG |= 0x40; //[7:6] = 01: train_sel software set: 2.7G
                break;
            case 0x02:
                BKE3_0A_REG |= 0x80; //[7:6] = 10: train_sel software set: 5.4G
                break;
            case 0x03:
                BKE3_0A_REG |= 0xc0; //[7:6] = 11: train_sel software set: 8.1G
                break;
            default:
                break;
        }        
        ucCnt = 3;
        while(ucCnt--)
        {
            BKE1_05_REG &= 0xfc;//[0]rgd_sw_dhrxpll_cal_rst_n: 0-en
            BKA1_30_REG &= BIT6_0;//[6]rg_dhrxpll_rst_n: 0-en
            BKE3_00_REG &= BIT0_0;//[0]rgd_dhrxpll_cal_pll_cal_en: 0-dis
            Ocm_Delay1ms(1);
            BKE1_05_REG |= 0x03;//[0]rgd_sw_dhrxpll_cal_rst_n: 1-dis
            BKA1_30_REG |= BIT6_1;//[6]rg_dhrxpll_rst_n: 1-dis
            BKE3_00_REG |= BIT0_1;//[0]rgd_dhrxpll_cal_pll_cal_en: 1-en
            Ocm_Delay1ms(2);//KF增大后，delay需要加长，否则Cali失败
            if((BKE3_24_REG&0x03) == 0x02) //[1]rgod_dhrxpll_pll_cal_done: 1-done
            {
                break;
            }
        }
        #if ((DPRX_CDR_MODE == FULL_SPEED_DIGCDR) ||(DPRX_CDR_MODE == HALF_SPEED_DIGCDR))  
        switch(ucloop_rxpll_cal)
        {
            case 0x00:
                BKE3_12_REG =   BKE3_1D_REG; 
                break;
            case 0x01:
                BKE3_13_REG =   BKE3_1E_REG; 
                break;
            case 0x02:
                BKE3_14_REG =   BKE3_1F_REG; 
                break;
            case 0x03:
                BKE3_15_REG =   BKE3_20_REG; 
                break;
            default:
                break;
        }
        #endif
        #if DPRX_CDR_MODE == ANACDR
        BKE3_0B_REG |= BIT0_1;//[0]rgd_dhrxpll_cal_pll_band_sw_en: 1-en
        BKE3_09_REG |= 0x0c;
        
        usRxpll_Ref_Cnt  =  ((u16)BKE3_29_REG << 8) + BKE3_2A_REG;
        for(ucLoop_Cnt = 0; ucLoop_Cnt < 5;ucLoop_Cnt++)
        {
            switch(ucloop_rxpll_cal)
            {
                case 0x00:
                    BKE3_12_REG =   BKE3_1D_REG + ucLoop_Cnt - 2; 
                    break;
                case 0x01:
                    BKE3_13_REG =   BKE3_1E_REG + ucLoop_Cnt - 2;
                    break;
                case 0x02:
                    BKE3_14_REG =   BKE3_1F_REG + ucLoop_Cnt - 2; 
                    break;
                case 0x03:
                    BKE3_15_REG =   BKE3_20_REG + ucLoop_Cnt - 2;
                    break;
                default:
                    break;
            }
            usRxpll_Avg_CalCnt  = 0;
            ucCal_Det_Cnt       = 0;
            ucCal_Cnt           = 0;
            while(ucCal_Cnt < 100)
            {
                Ocm_Delay1ms(1);
                ucCal_Cnt++;
                usRxpll_Cal_Cnt =  ((u16)BKE3_26_REG << 8) + BKE3_27_REG;    
                if(abs(usRxpll_Cal_Cnt - usRxpll_Ref_Cnt) < 0x80) //in case fm split issue
                {
                     usRxpll_Avg_CalCnt += usRxpll_Cal_Cnt;
                     ucCal_Det_Cnt++;
                }
                if(ucCal_Det_Cnt == 8)
                {
                    usRxpll_Sum_CalCnt[ucLoop_Cnt] = usRxpll_Avg_CalCnt/8;
                    break;
                }
            }
        }
        usTemp_Min_Cnt = 0xffff;
        for(ucLoop_Cnt = 0; ucLoop_Cnt < 5;ucLoop_Cnt++)
        {
            if(usTemp_Min_Cnt > abs(usRxpll_Sum_CalCnt[ucLoop_Cnt] - usRxpll_Ref_Cnt))
            {
                switch(ucloop_rxpll_cal)
                {
                    case 0x00:
                        BKE3_12_REG =   BKE3_1D_REG + ucLoop_Cnt - 2; 
                        break;
                    case 0x01:
                        BKE3_13_REG =   BKE3_1E_REG + ucLoop_Cnt - 2;
                        break;
                    case 0x02:
                        BKE3_14_REG =   BKE3_1F_REG + ucLoop_Cnt - 2; 
                        break;
                    case 0x03:
                        BKE3_15_REG =   BKE3_20_REG + ucLoop_Cnt - 2;
                        break;
                    default:
                        break;
                }
                usTemp_Min_Cnt =  abs(usRxpll_Sum_CalCnt[ucLoop_Cnt] - usRxpll_Ref_Cnt);
            }         
        }
        BKE3_0B_REG &= BIT0_0;//[0]rgd_dhrxpll_cal_pll_band_sw_en: 1-en
        BKE3_09_REG &= 0xf3;
        #endif
    }
    printLT(PRINT_PRIO_TEST, "\nDp rxpll band = 0x%02bx,0x%02bx,0x%02bx,0x%02bx",BKE3_12_REG, BKE3_13_REG, BKE3_14_REG, BKE3_15_REG);
    #if DPRX_CDR_MODE == ANACDR
    BKA1_43_REG &= 0xcf;
    BKA1_44_REG = 0xc0;
    #endif
    BKE3_0B_REG |= BIT0_1;//[0]rgd_dhrxpll_cal_pll_band_sw_en: 1-en
    BKE3_09_REG = 0x0d;   // [3:2] = 11: calibration HDMI/DP select: 11-> dp mode.
                          // [1:0] = 01: calibration train_sel: dp tx mainlink control mode
    BKE3_0A_REG &= 0x3f;  //[7:6]training sel = 0
}
#if DPRX_CDR_MODE == ANACDR
u8 Drv_DpRxPll_LockGet(void)
{
    if(BKE3_24_REG & BIT4_1)
    {
        return TRUE;
    }
    else
    {
        return FALSE;
    }
}
#endif
void Drv_DpRx_LinkClkSel(u8 uclinkClk)
{
    BKA1_0B_REG &= 0x0f;
    switch (uclinkClk)
    {
        case LANE_0 :
            BKA1_0B_REG |= BIT7_1;
            break;
        case LANE_1 :
            BKA1_0B_REG |= BIT6_1; 
            break;
        case LANE_2 :
            BKA1_0B_REG |= BIT5_1;
            break;
        case LANE_3 :
            BKA1_0B_REG |= BIT4_1;
            break;
        default:
            break;
    }
}

u8 Drv_DpRx_DscFifoEmptyGet(void)
{
    return BKEE_AD_REG;
}
u8 Drv_DpRx_DscFifoFullGet(void)
{
    return BKEE_AE_REG;
}
void Drv_DpRx_CtleSet(u8 ucLinkRate)
{
    switch (ucLinkRate)
    {
        case RBR :
            memcpy(&BKA1_02_REG,szDpRxEqConfig[0],6); 
            break;
        case HBR :
            memcpy(&BKA1_02_REG,szDpRxEqConfig[1],6); 
            break;
        case HBR2 :
            memcpy(&BKA1_02_REG,szDpRxEqConfig[2],6);
            break;
        case HBR3 :
            memcpy(&BKA1_02_REG,szDpRxEqConfig[3],6);
            break;
        default:
            break;
    }
}

void Drv_DpRx_DpRxChlSwap(void)
{
    #if DPRX_CDR_MODE == ANACDR
    BKA1_0E_REG &= 0x0f;//[7:4]rg_dhrx_d0_bf2cdr_en,only enable one lane when use anacdr
    #endif    

    #if DPRX_LANE_COUNT == FOUR_LANE
    BKA1_09_REG = 0xff;
    BKA1_1F_REG = 0x10;
    #else
    BKA1_09_REG = 0xcc;
    BKA1_1F_REG = 0x1c;
    #endif

    BKC7_E6_REG &= 0x0f;//pn swap
    BKC7_E7_REG = 0x01; //[7:4]dhrx logical channel data 0 source select, 1-chl1;
                        //[3:0]dhrx logical channel data 1 source select, 2-chl2;
    BKC7_E8_REG = 0x23; //[7:4]dhrx logical channel data 2 source select, 3-chl3;
                        //[3:0]dhrx logical channel data 3 source select, 0-chl0;
    #if DPRX_CDR_MODE == ANACDR
    BKA1_0E_REG |= BIT7_1;//[7:4]rg_dhrx_d0_bf2cdr_en,only enable one lane when use anacdr
    #endif
    Drv_DpRx_AuxSwap(FALSE);
    Drv_DpRx_LinkClkSel(LANE_0);

    BKC7_E6_REG |= BIT0_1;//eq mode sel dp rx
}

#if TYPECRX_EN == ENABLED
void Drv_DpRx_TypecRxChlSwap(u8 ucInputSel, StructCcStatus pUCCStatus)
{
    #if DPRX_CDR_MODE == ANACDR
    BKA1_0E_REG &= 0x0F;//[7:4]rg_dhrx_d0_bf2cdr_en,only enable one lane when use anacdr
    #endif    
    switch(ucInputSel)
    {
        case TYPEC_MALE:
            if(pUCCStatus.uclaneCount == FOUR_LANE)
            {
                BKA1_09_REG = 0xff;
                BKA1_1F_REG = 0x10;
            }
            else
            {
                BKA1_09_REG = 0xcc;
                BKA1_1F_REG = 0x1c;
            }
            BKC7_E6_REG &= 0x0F;//pn swap
            BKC7_E7_REG = 0x01; //[7:4]dhrx logical channel data 0 source select, 1-chl1;
                                //[3:0]dhrx logical channel data 1 source select, 2-chl2;
            BKC7_E8_REG = 0x23; //[7:4]dhrx logical channel data 2 source select, 3-chl3;
                                //[3:0]dhrx logical channel data 3 source select, 0-chl0;
            #if DPRX_CDR_MODE == ANACDR
            BKA1_0E_REG |= BIT7_1;//[7:4]rg_dhrx_d0_bf2cdr_en,only enable one lane when use anacdr
            #endif
            Drv_DpRx_AuxSwap(FALSE);
            Drv_DpRx_LinkClkSel(LANE_0);
            break;
                        
        case TYPEC_FEMALE_FLIP:
            if(pUCCStatus.uclaneCount == FOUR_LANE)
            {
                BKA1_09_REG = 0xff;
                BKA1_1F_REG = 0x10;
            }
            else
            {
                #if PINE_SUPPORT == ENABLED
                if(pUCCStatus.ucPin_Assignment == PIN_E)
                {
                    BKA1_09_REG = 0x33;//term2.3EN
                    BKA1_1F_REG = 0x13;//PI 0.1 OFF
                }
                else
                #endif
                {
                    BKA1_09_REG = 0xcc;//term0.1EN
                    BKA1_1F_REG = 0x1c;//PI 2.3 OFF
                }
            }
            #if PINE_SUPPORT == ENABLED
            if(pUCCStatus.ucPin_Assignment == PIN_E)
            {
                BKC7_E6_REG &= 0x0F; //pn swap
                BKC7_E6_REG |= 0x50;//pn swap
                
                BKC7_E7_REG = 0x23; //[7:4]dhrx logical channel data 0 source select, 1-chl1;
                                    //[3:0]dhrx logical channel data 1 source select, 2-chl2;
                BKC7_E8_REG = 0x10; //[7:4]dhrx logical channel data 2 source select, 3-chl3;
                                        //[3:0]dhrx logical channel data 3 source select, 0-chl0;
            
                #if DPRX_CDR_MODE == ANACDR
                BKA1_0E_REG |= BIT5_1;//[7:4]rg_dhrx_d0_bf2cdr_en,only enable one lane when use anacdr
                #endif
                Drv_DpRx_AuxSwap(FALSE);
                Drv_DpRx_LinkClkSel(LANE_2);
            }
            else
            #endif
            {
                BKC7_E6_REG &=0x0F; //pn swap
                BKC7_E6_REG |= 0xA0;//pn swap
                BKC7_E7_REG = 0x10; //[7:4]dhrx logical channel data 0 source select, 1-chl1;
                                    //[3:0]dhrx logical channel data 1 source select, 2-chl2;
                BKC7_E8_REG = 0x23; //[7:4]dhrx logical channel data 2 source select, 3-chl3;
                                        //[3:0]dhrx logical channel data 3 source select, 0-chl0;
            
                #if DPRX_CDR_MODE == ANACDR
                BKA1_0E_REG |= BIT6_1;//[7:4]rg_dhrx_d0_bf2cdr_en,only enable one lane when use anacdr
                #endif
                Drv_DpRx_AuxSwap(TRUE);
                Drv_DpRx_LinkClkSel(LANE_1);
            }
            break;        
        case TYPEC_FEMALE_NOFLIP:
            if(pUCCStatus.uclaneCount == FOUR_LANE)
            {
                BKA1_09_REG = 0xff;    
                BKA1_1F_REG = 0x10;
            }
            else
            {
                #if PINE_SUPPORT == ENABLED
                if(pUCCStatus.ucPin_Assignment == PIN_E)
                {
                    BKA1_09_REG = 0xCC;//PHY0 needs enabled
                    BKA1_1F_REG = 0x1C;//PI
                }
                else
                #endif
                {
                    BKA1_09_REG = 0x33;//PHY0 needs enabled
                    BKA1_1F_REG = 0x13;//PI
                }
            }
            #if PINE_SUPPORT == ENABLED
            if(pUCCStatus.ucPin_Assignment == PIN_E)
            {
                BKC7_E6_REG &= 0x0F; //pn swap
                BKC7_E6_REG |= 0x50;//pn swap
                BKC7_E7_REG = 0x01; //[7:4]dhrx logical channel data 0 source select, 1-chl1;
                                    //[3:0]dhrx logical channel data 1 source select, 2-chl2;
                BKC7_E8_REG = 0x32; //[7:4]dhrx logical channel data 2 source select, 3-chl3;
                                    //[3:0]dhrx logical channel data 3 source select, 0-chl0;
                #if DPRX_CDR_MODE == ANACDR
                BKA1_0E_REG |= BIT7_1;//[7:4]rg_dhrx_d0_bf2cdr_en,only enable one lane when use anacdr
                #endif
                Drv_DpRx_AuxSwap(TRUE);
                Drv_DpRx_LinkClkSel(LANE_0);
            }
            else
            #endif
            {
                BKC7_E6_REG &= 0x0F; //pn swap
                BKC7_E6_REG |= 0xA0;//pn swap
                BKC7_E7_REG = 0x32; //[7:4]dhrx logical channel data 0 source select, 1-chl1;
                                    //[3:0]dhrx logical channel data 1 source select, 2-chl2;
                BKC7_E8_REG = 0x01; //[7:4]dhrx logical channel data 2 source select, 3-chl3;
                                    //[3:0]dhrx logical channel data 3 source select, 0-chl0;
                #if DPRX_CDR_MODE == ANACDR
                BKA1_0E_REG |= BIT4_1;//[7:4]rg_dhrx_d0_bf2cdr_en,only enable one lane when use anacdr
                #endif
                Drv_DpRx_AuxSwap(FALSE);
                Drv_DpRx_LinkClkSel(LANE_3);
            }
            break;
        default:
        break;
    }
    BKC7_E6_REG |= BIT0_1;//eq mode sel dp rx
}
#endif

void Drv_DpRx_EqModeSet(u8 ucEqMode)
{
    if(ucEqMode == HW_MODE)
    {
        BKF1_5D_REG |= BIT6_1;//hard eq enable
    }
    else
    {
        BKF1_5D_REG &= BIT6_0;//hard eq disable
    }
}
u8 Drv_DpRx_EqModeGet(void)
{
    if(BKF1_5D_REG & BIT6_1)
    {
        return HW_MODE;
    }
    return SW_MODE;
}
