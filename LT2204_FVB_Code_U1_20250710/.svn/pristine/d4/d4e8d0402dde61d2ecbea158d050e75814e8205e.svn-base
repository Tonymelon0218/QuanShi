u8 Drv_DpRx_InterlaceGet(void)
{
    if(((BKF2_F6_REG&BIT2_1)==BIT2_1)&&((BKF2_F7_REG&BIT2_1)==BIT2_1)&&((BKF2_F8_REG&BIT2_1)==BIT2_1)&&((BKF2_F9_REG&BIT2_1)==BIT2_1))
    {
        return FORMAT_INTL;
    }
    else
