	UCCStatus.ucPin_Assignment = PIN_C;
	#endif
	
	UCCStatus.b1Pd31Test = 1;
	
	UCCStatus.ucRequestPdo = 0x02;
	DCCStatus.ucRequestPdo = 0x02;
    
    UCCStatus.b2AttentionType = ATTENTION_NULL;
    
    #if CHIP_SEL == LT6711GXE
    UCCStatus.b1CcDataRoleSet = DFP;  
    #else
    UCCStatus.b1CcDataRoleSet = UFP;
    #endif
    
    UCCStatus.b2VdmBusy = AMS_NONE;
    UCCStatus.b2DisIdSend_En = INITIATE_NONE;
    memset(&UCCAmsType,AMS_NONE,sizeof(UCCAmsType));
}
u8 Mod_CC1MsgType_Calc(IN u8 ucCommandType,IN u8 ucMessageType,IN u8 ucVdmType)
{
    u8 ucMessageTypeCal = 0;
    ucMessageTypeCal = ucMessageType;//real message type copy to cal
    switch(ucCommandType)
    {
        case Ctrl_Msg:
        case Data_Msg:
        case Ext_Msg:
            ucMessageTypeCal |= (ucCommandType<<5);
            break;
        case Vdm_Msg:
            if(ucVdmType)
            {
                ucMessageTypeCal |= (ucCommandType<<5);    
            }
            else
            {
                ucMessageTypeCal = 0xff;
            }    
            break;
        default:
            ucMessageTypeCal = 0xff;
        break;
    }
    return    ucMessageTypeCal;
}


void Mod_CC1Vconn_Off(void)
{
	VCONN1_GPIO_CTRL(LOW);
    VCONN2_GPIO_CTRL(LOW);
}
void Mod_CC1LockVari_Set(u8 ucDat_Role)
{
    if(ucDat_Role == UFP)
    {
		#if CCTRY_MODE == TRY_SRC
		if(UCCStatus.b2TRYTIMES == 0)
        {
            UCCStatus.b1IsVconnSource = FALSE;
			#if REMOVE_UART == DISABLED
            printLT(PRINT_PRIO_HIG,"\nUUFP");  
			#endif         
            UCCStatus.b1PowerRole = FALSE;
            UCCStatus.b1DataRole = FALSE;
            Drv_CC1Flip_Judge(&UCCStatus);
        }
        else
        {
            UCCStatus.b2TRYTIMES--;
            Drv_Cc1Sw_Ctrl(DISABLED);
            DRV_PowerRole_Set(UCC,SOURCE);   
			#if REMOVE_UART == DISABLED      
            printLT(PRINT_PRIO_HIG,"\nTrySrc = 0x%02bx",UCCStatus.b2TRYTIMES);
			#endif  
            Ocm_Delay1ms(100);
            Drv_Cc1Sw_Ctrl(ENABLED);
            Ocm_Delay1ms(50);//Reserved enough time to set to Rp
        }        
		#else
        UCCStatus.b1IsVconnSource = FALSE;
        #if REMOVE_UART == DISABLED
        printLT(PRINT_PRIO_HIG,"\nUUFP");   
        #endif
        UCCStatus.b1PowerRole = FALSE;
        UCCStatus.b1DataRole = FALSE;
		#if CCTRY_MODE == TRY_SNK
        Drv_CC1Flip_Judge(&UCCStatus);
		#endif
        #endif
    }
    else if(ucDat_Role == DFP)
    {		
		#if CCTRY_MODE == TRY_SNK
		if(UCCStatus.b2TRYTIMES == 0)
        {
            UCCStatus.b1IsVconnSource = TRUE;
			#if REMOVE_UART == DISABLED
            printLT(PRINT_PRIO_HIG,"\nUDFP");  
			#endif         
            UCCStatus.b1PowerRole = TRUE;
            UCCStatus.b1DataRole = TRUE;
            Drv_CC1Flip_Judge(&UCCStatus);
        }
        else
        {
            UCCStatus.b2TRYTIMES--;
            Drv_Cc1Sw_Ctrl(DISABLED);
            DRV_PowerRole_Set(UCC,SINK);   
			#if REMOVE_UART == DISABLED      
            printLT(PRINT_PRIO_HIG,"\nTrySrc = 0x%02bx",UCCStatus.b2TRYTIMES);
			#endif  
            Ocm_Delay1ms(100);
            Drv_Cc1Sw_Ctrl(ENABLED);
            Ocm_Delay1ms(50);//Reserved enough time to set to Rp
        }        
		#else		
        UCCStatus.b1IsVconnSource = TRUE;
        #if REMOVE_UART == DISABLED
        printLT(PRINT_PRIO_HIG,"\nUDFP");     
        #endif
        UCCStatus.b1PowerRole = TRUE;
        UCCStatus.b1DataRole = TRUE;		
		#if CCTRY_MODE == TRY_SRC
        Drv_CC1Flip_Judge(&UCCStatus);
		#endif
		#endif
    }
	Mod_CC1Vconn_Off();
    #if NINTENDO_SWITCH_HDMIHPD == ENABLED
    CC1NINTENDOState.b1NintendoRecordTxHpd = Drv_HdmiTx_HpdDet();
    #endif
    UCCStatus.b1Toggle_DFP_EN = !UCCStatus.b1Toggle_DFP_EN;
    UCCStatus.ucnUccSourceCapCnt = 0;
    UCCMSG.ucMessageID = 0;
    UCCStatus.b2Toggle_enable = 0x02;
    UCCStatus.b1PrDone = FALSE;
    UCCStatus.ucnUccSourceCapCnt = 0;
    UCCStatus.ucContract_Succeed = 0;
    SOURCE_GPIO_CTRL(IN LOW);	
    #if CHIP_SEL != LT6711GXE
    Drv_DpRx_PhyShut();//
    #endif
    TR2 = 0;
	#if CCTRY_MODE == NO_TRY              
    Drv_CC1Flip_Judge(&UCCStatus);
	#endif
	UCCMSG.ucLastMsgType = 0xff;
    
    UCCStatus.b2AttentionType = ATTENTION_NULL;
    //to Solve Samsung Warning issue
    #if RX_PORT_SIGN == DP_PORT
    Drv_DpRx_AcAuxTermCtrl(DISABLED);
    Drv_DpRx_DcAuxResCtrl(DISABLED);
    #endif
    #if CHIP_SEL == LT6711GXE
    UCCStatus.b1CcDataRoleSet = DFP;  
    #else
    UCCStatus.b1CcDataRoleSet = UFP;
    #endif
    UCCStatus.b2VdmBusy = AMS_NONE;
    UCCStatus.b2DisIdSend_En = INITIATE_NONE;
    memset(&UCCAmsType,AMS_NONE,sizeof(UCCAmsType));
}
void Mod_CC1Toggle_Init(u8 vaule)
{         
    #if HUB_RESET_CTRL == ENABLED
    UCCStatus.b2HubResetHigh = HUBRESETLOW;
    HubReset_GPIO_Ctrl(LOW);
    #endif
	TR2 = 0;
	Mod_CC1Vconn_Off();
    SOURCE_GPIO_CTRL(IN LOW);
	UCCStatus.b1PrDone = FALSE;
    UCCStatus.ucnUccSourceCapCnt = 0;
    UCCStatus.b1IsCc_done = FALSE;
    UCCStatus.b2Toggle_enable = 0x01;
    UCCStatus.ucFlow_Step = 0;
    UCCStatus.ucVDM_Step = 0;
    UCCStatus.b1PowerRole = FALSE;
    UCCStatus.b1DataRole =  FALSE;
    UCCStatus.ucPRSwaped  = 0;
    UCCStatus.ucContract_Succeed = 0;
    UCCStatus.b1IsVconnSource = FALSE;
    #if PDCTS_USE == ENABLED
    UCCStatus.b1SwapToVconnSource = FALSE;
    #endif
	#if VCONNSWAP_SUPPORT == ENABLED 
    UCCStatus.b1VconnSwap_En = FALSE;
	#endif
    #if NINTENDO_SWITCH == ENABLED
    CC1NINTENDOState.b1IsSwitch = FALSE;
    #endif
    UCCStatus.ucDrSwap_En = 0; 
    Mod_CC1CableVari_Init();
    UCCMSG.b1Vdm_Msg = FALSE;
    UCCStatus.b1Multi_Function = FALSE;
    if(vaule)
    {
        DRV_PowerRole_Set(UCC,SOURCE);
        UCCStatus.b1Toggle_DFP_EN = TRUE;
    }
    else
    {
        DRV_PowerRole_Set(UCC,SINK);
        UCCStatus.b1Toggle_DFP_EN = FALSE;
    }
}
void Mod_CC1Toggle_Loop(void)
{
	u8 loop_u = 0;
	static u8 CC_Role =0;
	static u8 ucStage=0;
	static u32 ulLastTime=0;
	static u16 Toggle_Keep_Time = MS_50;
    if(DCCStatus.b2Charger_Scan != PDSCANEND)//after enter into DCCDET,then do CC_Toggle
    {
        ucStage = 0;
		return;
    }
	switch(ucStage)
	{
        case 0:
            Ocm_Timer_UpdLocalTime(INOUT &ulLastTime);
			#if CCTRY_MODE == TRY_SNK
			if(CC_Role == TRUE)
            {
                Toggle_Keep_Time = MS_30;
            }
            else
            {
                Toggle_Keep_Time = MS_70;
            }
			#else
            if(CC_Role == TRUE)
            {
                Toggle_Keep_Time = MS_70;
            }
            else
            {
                Toggle_Keep_Time = MS_30;
            }
			#endif
            ucStage++;
            break;
        case 1:
            if(UCCStatus.ucContract_Succeed == 0)
            {           
                if((Drv_CC2On_Det(SINK) == TRUE)&&(UCCStatus.ucPRSwaping != 2)&&(UCCStatus.ucPRSwaped == 0x00))////
                {
                    if(Drv_CC1RpOn_Scan() == 1)
                    {
                        if(UCCStatus.b1Toggle_DFP_EN == TRUE)
                        {
                            Mod_CC1LockVari_Set(DFP);                           
                            ucStage++;
//                            SOURCE_GPIO_CTRL(IN HIGH);
                        }
                    }
                    else if(Drv_CC1RdOn_Scan() == 1)
                    {
                        if(UCCStatus.b1Toggle_DFP_EN == FALSE)
                        {
                            #if HUB_RESET_CTRL == ENABLED
                            UCCStatus.b2HubResetHigh = HUBRESETHIGH_PRE;
                            #endif
                            Mod_CC1LockVari_Set(UFP);                           
                            ucStage++;
                        }
                    }
                    else if(Ocm_Timer_IsOverFlow(&ulLastTime,Toggle_Keep_Time) == TRUE)
                    {
                        CC_Role = !CC_Role;
                        Mod_CC1Toggle_Init(CC_Role);
						#if CCTRY_MODE == TRY_SNK
						if(CC_Role == TRUE)
						{
							Toggle_Keep_Time = MS_30;
						}
						else
						{
							Toggle_Keep_Time = MS_70;
						}
						#else
						if(CC_Role == TRUE)
						{
							Toggle_Keep_Time = MS_70;
						}
						else
						{
							Toggle_Keep_Time = MS_30;
						}
						#endif
                        Ocm_Timer_UpdLocalTime(INOUT &ulLastTime);
                    }
				}
				else
				{
					ucStage = 0;
				}
			}
			else
			{
				ucStage = 0;
			}
            break;
        default:
            ucStage = 0;
            break;			
	}
}
#if DCC_TOGGLE_SUPPORT == ENABLED
void Mod_CC2Flip_Scan(void)
{
    if(Drv_CC2On_Det(SOURCE) == TRUE)
    {
        if(BKFC_B0_REG & BIT6_1) //
        {
            DCCPORTUSBMUX_CTRL(LOW);
            BKFC_AF_REG &= BIT1_0;//flip 1 soft
        }
        else if(BKFC_B0_REG & BIT4_1)//
        {
            DCCPORTUSBMUX_CTRL(HIGH);
            BKFC_AF_REG |= BIT1_1;//flip 1 soft
        }
    }
}

void Mod_CC2LockVari_Set(u8 ucDat_Role)
{
    if(ucDat_Role == UFP)
    {       
    	#if REMOVE_UART == DISABLED
        printLT(PRINT_PRIO_HIG,"\nDUFP");    
        #endif
        DCCStatus.b1DccUfpMode = TRUE;
    }
    else if(ucDat_Role == DFP)
    {
    	#if REMOVE_UART == DISABLED
        printLT(PRINT_PRIO_HIG,"\nDDFP");
        #endif
        Mod_CC2Flip_Scan();
        DCCStatus.b1DccDfpMode = TRUE;        
    }
    DCCStatus.b1Toggle_DFP_EN = !DCCStatus.b1Toggle_DFP_EN;       
    //Drv_CC1Flip_Judge(&UCCStatus);
}
void Mod_CC2Toggle_Init(u8 vaule)
{          
    ADAPTER_GPIO_CTRL(LOW);
    DCCPORTUSBMUX_CTRL(LOW);
    #if DCC_TOGGLE_SUPPORT == ENABLED
    DCCStatus.b1DccUfpMode = FALSE;
    DCCStatus.b1DccDfpMode = FALSE;
    #endif
    #if NINTENDO_SWITCH == ENABLED
    CC1NINTENDOState.b2Switch_Ada_Online = NOT_SWITCH;
    #endif
    DCCStatus.b1AdapterWithPD = FALSE;
    UCCStatus.b1PrDone = FALSE;
    UCCStatus.b1DataRole = FALSE;
    UCCStatus.ucPRSended = 0;
    UCCStatus.ucPRSwaping = 0;
    UCCStatus.ucPRSwaped = 0;        
    UCCStatus.ucFlow_Step = 0;
    if(vaule)
    {
        DRV_PowerRole_Set(DCC,SOURCE);
        DCCStatus.b1Toggle_DFP_EN = TRUE;
    }
    else
    {
        DRV_PowerRole_Set(DCC,SINK);
        DCCStatus.b1Toggle_DFP_EN = FALSE;
        DCCStatus.b2Charger_Scan = PDSCANSTART;
    }
}
void Mod_CC2Toggle_Loop(void)
{
	u8 loop_u = 0;
	static u8 CC_Role =0;
	static u8 ucStage=0;
	static u32 ulLastTime=0;
	static u16 Toggle_Keep_Time = MS_50;
    
	switch(ucStage)
	{
        case 0:
            if(DCCStatus.b1DccDfpMode == TRUE)
            {
                if(Drv_CC2On_Det(SOURCE) == FALSE)
                {
                    Mod_CC2Toggle_Init(FALSE);//Rp
                }
            }
            else if(DCCStatus.b1DccUfpMode == TRUE)
            {
                if(Drv_CC2On_Det(SINK) == FALSE)
                {
                    Mod_CC2Toggle_Init(TRUE);//Rp
                }
            }
            if((DCCStatus.b1DccDfpMode == FALSE)&&(DCCStatus.b1DccUfpMode == FALSE))
            {
                Ocm_Timer_UpdLocalTime(INOUT &ulLastTime);
                ucStage++;
            }            
            break;
        case 1:
            if((DCCStatus.b1DccDfpMode == FALSE)&&(DCCStatus.b1DccUfpMode == FALSE))
            {           
                if(Drv_CC2On_Det(SOURCE) == TRUE)//Source Detected
                {           
                    if(DCCStatus.b1Toggle_DFP_EN == TRUE)
                    {         
                        Mod_CC2LockVari_Set(DFP);
                        Ocm_Timer_UpdLocalTime(INOUT &ulLastTime);
                        ucStage++;
                    }
                }
                else if(Drv_CC2On_Det(SINK) == TRUE)
                {
                    if(DCCStatus.b1Toggle_DFP_EN == FALSE)
                    {
                        Mod_CC2LockVari_Set(UFP);
                        Ocm_Timer_UpdLocalTime(INOUT &ulLastTime);
                        ucStage++;
                    }
                }
                else if(Ocm_Timer_IsOverFlow(&ulLastTime,Toggle_Keep_Time) == TRUE)
                {
                    CC_Role = !CC_Role;
                    Mod_CC2Toggle_Init(CC_Role);
                    if(CC_Role == TRUE)
                    {
                        Toggle_Keep_Time = MS_50;
                    }
                    else
                    { 
                        Toggle_Keep_Time = MS_50;
                    }
                    Ocm_Timer_UpdLocalTime(INOUT &ulLastTime);
                }
			}
			else
			{
				ucStage++;
			}
            break;
        case 2:
            if(DCCStatus.b1DccDfpMode == TRUE)
            {
                if(Ocm_Timer_IsOverFlow(&ulLastTime,MS_20) == TRUE)
                {
                    ADAPTER_GPIO_CTRL(HIGH);
                    ucStage++;
                }
                else if(Drv_CC2On_Det(SOURCE) == FALSE)
                {
                    Mod_CC2Toggle_Init(TRUE);//Rp
                    ucStage = 0;
                }
            }           
            else
            {
                ucStage++;
            }          
            break;
        default:
            ucStage = 0;
            break;			
	}
}
#endif
//===============================================================end the toggle ini=========================================================

#if TYPEC_PRSWAP_EN == ENABLED
void Mod_CC1PrSwap_Send(void)
{
//    if((UCCStatus.ucPRSended == 1)&&(UCCStatus.b1DataRole == FALSE)&&(UCCStatus.ucPRSwaped==0))
    if((UCCStatus.ucPRSended == 1)&&(UCCStatus.b1PowerRole == FALSE)&&(UCCStatus.ucPRSwaped==0))
    {
        if(Drv_CC2On_Det(SINK) == TRUE)
        {
            ADAPTER_GPIO_CTRL(IN HIGH);
            DRV_CC_LogicRst(UCC);    
            UCCStatus.ucPRSended = 2;
            SOURCE_GPIO_CTRL(IN LOW);
            if(Mod_CC1DetOff_Judge() == TRUE)
            {
                #if REMOVE_UART == DISABLED
                printLT(PRINT_PRIO_HIG,"\nPROFF");
                #endif
                Mod_CC1DetOff_Action();
            }
            else
            {
                if(UCCStatus.ucPRSwaped == 0x00)
                {           
                    #if REMOVE_UART == DISABLED
                    printLT(PRINT_PRIO_HIG,"\nPrSend");
                    #endif
                    UCCMSG.pDataOrder = szCC_CtrlMsg[0];    
                    UCCStatus.ucPRSwaping = 1;
                    UCCStatus.ucPRSwaped =  1;    
                    UCCAmsType.ucPrSwap_Ams = AMS_READY;
                    UCCMSG.ucLastMsgType = Mod_CC1MsgType_Calc(Ctrl_Msg,PR_Swap,StrVdm);                    
                    Mod_CC1Msg_Send();//// PR_SWAP 1                                    
                }
                else
                {
                    ;
                }
            }        
        }
        else
        {            
            #if REMOVE_UART == DISABLED
            printLT(PRINT_PRIO_HIG,"\nAda Lst");    
            #endif
            DCCStatus.b1AdapterWithPD = FALSE;
            ADAPTER_GPIO_CTRL(IN LOW);
            SOURCE_GPIO_CTRL(IN HIGH);
            DCCStatus.b2Charger_Scan = PDSCANSTART;
            UCCStatus.ucPRSwaped = 0;
            UCCStatus.ucPRSended = 0;
            #if NINTENDO_SWITCH == ENABLED
            CC1NINTENDOState.b2Switch_Ada_Online = NOT_SWITCH;
            #endif
			if(UCCStatus.b1IsCc_done == FALSE)
			{
				UCCStatus.b1IsCc_done = TRUE; // Hdmi_Edid = 0x02;
			}
        }        
    }
}

void Mod_CC1PrSwap_Scan(void)
{
    static u8 ucStage_Change=0;
    static u8 ucStage=0;
    static u32 ulLastTime=0;
    if(UCCStatus.b2Toggle_enable == 0x01)
    {
        ucStage = 0;
        return;
    }
    if(UCCStatus.ucFlow_Step >= 2)
    {
        ucStage = 0;
        return;
    }
    if(UCCAmsType.ucPrSwap_Ams == AMS_DONE)
    {
        ucStage = 0;
        return;
    }
    if(UCCStatus.ucPRSended == 2)
    {
        ucStage = 0;
        return;
    }
    switch(ucStage)
    {
        case 0:
            ucStage_Change = 1;
            ucStage++;
            break;
        case 1:
            if(ucStage_Change)
            {
                ucStage_Change = 0;
                Ocm_Timer_UpdLocalTime(&ulLastTime);
            }
            if(Ocm_Timer_IsOverFlow(&ulLastTime,SECOND_3) == TRUE)//do not receive source cap
            {
                if(UCCStatus.ucContract_Succeed == 0)
                {
                    Drv_CC1Flip_Judge(&UCCStatus);
                    UCCStatus.b2Hardreset_Hdl = HardRst_Source;
                    ucStage = 0;
                }
                else
                {
                    ucStage_Change = 1;
                    ucStage++;
                }
            }
            else if(UCCStatus.ucContract_Succeed == 1)
            {
                ucStage_Change = 1;
                ucStage++;
            }        
            break;
        case 2:
            if(ucStage_Change)
            {
                ucStage_Change = 0;
                Ocm_Timer_UpdLocalTime(&ulLastTime);
            }
            if(Ocm_Timer_IsOverFlow(&ulLastTime,MS_800) == TRUE)
            {      
                //ADAPTER_GPIO_CTRL(IN LOW);   
                Mod_CC1PrSwap_Send();    
                ucStage_Change = 1;
                ucStage++;
            }
            else if((UCCStatus.ucPRSended == 0)||(UCCStatus.ucPRSwaped))
            {
                ucStage_Change = 1;
                ucStage = 0;
            }
            break;
        case 3:
            if(ucStage_Change)
            {
                ucStage_Change = 0;
                Ocm_Timer_UpdLocalTime(&ulLastTime);
            }
            if(UCCStatus.ucPRSwaping == 1)
            {
                if(Ocm_Timer_IsOverFlow(&ulLastTime,SECOND_3)== TRUE)//can not receive accept
                {       
                    UCCStatus.b2Hardreset_Hdl = HardRst_Source;
                    ucStage = 0;
                }
                else
                {
                    ;
                }
            }
            else
            {
                ucStage_Change = 1;
                ucStage++;
            }    
            break;   
        default:
            ucStage = 0;
            break;            
    } 
}

#endif
#if VCONNSWAP_SUPPORT == ENABLED 
void Mod_CC1Vconn_Send(void)
{
    if(UCCStatus.b1VconnSwap_En == TRUE)
    {
        UCCStatus.b1WaitMsg_Receive = FALSE;
        UCCStatus.b1VconnSwap_En = FALSE;
        UCCStatus.ucSwap_Sent |= Vconn_Sent;
        UCCMSG.pDataOrder = szCC_CtrlMsg[4];
        UCCAmsType.ucVconnSwap_Ams = AMS_GOING;
        Mod_CC1Msg_Send();//Vconn Swap
        UCCMSG.ucLastMsgType = Mod_CC1MsgType_Calc(Ctrl_Msg,VCONN_Swap,StrVdm);
    }        
}
#endif
void Mod_CC1DrSwap_Send(void)
{
	#if CHIP_SEL == LT6711GXE
    if(UCCStatus.b1DataRole == TRUE)
    {
        return;
    }
	#else
	if(UCCStatus.b1DataRole == FALSE)
    {
        return;
    }
	#endif
    if(UCCStatus.ucDrSwap_En == 1)
    {
        if(UCCMSG.ucCcVersion >= PD30)
        {
            DRV_RpCur_Sel(UCC,Rp_SinkTxNG);//Needed for Honor Magic3 Phone
        }
        Ocm_Delay1ms(20);//Needed for Honor Magic3 Phone
        UCCStatus.b1WaitMsg_Receive = FALSE;
		#if VCONNSWAP_SUPPORT == ENABLED 
        UCCStatus.b1VconnSwap_En = FALSE;
		#endif
        if((UCCStatus.ucDrSwap_En == 1)&&(UCCStatus.ucFlow_Step < 2))
        {
            printLT(PRINT_PRIO_HIG, "\nDR_Swap send");
            UCCStatus.ucSwap_Sent &= DR_No_Sent;
            UCCStatus.ucDrSwap_En = 0;
            UCCMSG.pDataOrder = szCC_CtrlMsg[5];    
            Mod_CC1Msg_Send();//DR_Swap
            UCCMSG.ucLastMsgType = Mod_CC1MsgType_Calc(Ctrl_Msg,DR_Swap,StrVdm);
        }
		Ocm_Delay1ms(1);
        if(UCCMSG.ucCcVersion >= PD30)
        {
            DRV_RpCur_Sel(UCC,Rp_SinkTxOK);
        }
        #if HUB_RESET_CTRL == ENABLED
        UCCStatus.b2HubResetHigh = HUBRESETHIGH_PRE;
        #endif
    }        
}
void Mod_CC1WaitMsg_Send(void)//use Timer to do this
{
    if(UCCStatus.b1WaitMsg_Receive== TRUE)
    {
        if(UCCAmsType.ucPrSwap_Ams == AMS_READY)
        {
            UCCStatus.ucPRSwaping = 1;
        }
        UCCMSG.pDataOrder = UCCMSG.pLast_DataOrder;
        UCCStatus.b1WaitMsg_Receive = FALSE;
        Mod_CC1Msg_Send();    
    }
}
void Mod_CC1SwapMsg_Scan(void)
{
    static u8 ucStage=0;
    static u32 ulLastTime=0;
    if(UCCStatus.ucFlow_Step >= 2)
    {
        ucStage = 0;
        return;
    }
	#if VCONNSWAP_SUPPORT == ENABLED 
	if((UCCStatus.b1VconnSwap_En== FALSE)&&(UCCStatus.ucDrSwap_En != 1)&&(UCCStatus.b1WaitMsg_Receive== FALSE))
    #else
	if((UCCStatus.ucDrSwap_En != 1)&&(UCCStatus.b1WaitMsg_Receive== FALSE))
	#endif
	{
        ucStage = 0;
        return;
    }
    switch(ucStage)
    {
        case 0:
            Ocm_Timer_UpdLocalTime(&ulLastTime);
            ucStage++;
            break;
        case 1:
            if(Ocm_Timer_IsOverFlow(&ulLastTime,MS_500) == TRUE)
            {
				#if VCONNSWAP_SUPPORT == ENABLED 
                Mod_CC1Vconn_Send();
				#endif
                Mod_CC1DrSwap_Send();
                Mod_CC1WaitMsg_Send();
                Ocm_Timer_UpdLocalTime(&ulLastTime);
                ucStage++;
            }
            else
            {
                ;
            }
            break;
        default:
            ucStage = 0;
            break;            
    }
}    
void Mod_Cc1VconnSwap_Handle(void)
{
	#if VCONNSWAP_SUPPORT == ENABLED 
    static u32 ulLastTime = 0;
    if(UCCAmsType.ucVconnSwap_Ams == AMS_NONE)
    {
        return;
    }
    if(UCCAmsType.ucVconnSwap_Ams == AMS_DONE)
    {
        return;
    }
    if(UCCAmsType.ucVconnSwap_Ams == AMS_GOING)
    {
        UCCAmsType.ucVconnSwap_Ams = AMS_GOEXP;
        Ocm_Timer_UpdLocalTime(&ulLastTime);
    }
    if(UCCAmsType.ucVconnSwap_Ams == AMS_GOEXP)
    {
        if(Ocm_Timer_IsOverFlow(&ulLastTime,MS_100) == TRUE)
        {
            Ocm_Timer_UpdLocalTime(&ulLastTime);
            UCCAmsType.ucVconnSwap_Ams = AMS_DONE;
            UCCStatus.b1IsVconnSource = FALSE;
            Mod_CC1Vconn_Off();     
            Mod_Cc1DrSwap_Set();
        }
    }
	#endif
}
void Mod_CC1Unlock_Init(void)
{
    UCCStatus.b1PowerRole = FALSE;
    UCCStatus.b1DataRole =  FALSE;
    UCCStatus.ucPRSwaped  = 0;
    UCCStatus.ucnUccSourceCapCnt = 0;
    UCCStatus.b2Toggle_enable = 0x01;
    UCCStatus.ucContract_Succeed = 0;
    #if VCONNSWAP_SUPPORT == ENABLED 
    UCCStatus.b1VconnSwap_En = FALSE;
    #endif
    UCCStatus.ucDrSwap_En = 0;
    SOURCE_GPIO_CTRL(IN LOW);
    UCCStatus.b1Toggle_DFP_EN = !UCCStatus.b1Toggle_DFP_EN;
}
#if UCC_EMARK_SUPPORT == ENABLED

void Mod_CC1Emark_Comm(void)
{
	u8 ucSop1MsgCnt;
    
    DRV_CcOrder_Set(UCC,CABLERESET);
    Ocm_Delay1ms(3);
	for(ucSop1MsgCnt=0;ucSop1MsgCnt<10;ucSop1MsgCnt++)
	{
		if(UCCStatus.ucSop1MsgStep == SOP1SENDING)
		{		
			if(ucSop1MsgCnt == 5)
			{
				DRV_CcOrder_Set(UCC,CABLERESET);
				Ocm_Delay1ms(10);
			}
			UCCMSG.ucMessageID = 0;
			UCCMSG.pDataOrder = szCC_DataMsg[20];
			Mod_CC1MessageSOP1_Send();
			Ocm_Delay1ms(3);
		}	
		else
		{
			break;
		}
	}
}
void Mod_CC1Emark_Initiate(void)
{
    UCCStatus.ucCable5A = 0;
    Mod_CC1Vconn_Off();
    Drv_CC1Ra_Det();
    Ocm_Delay1ms(20);
    UCCStatus.ucSop1MsgStep = SOP1SENDING;
    Mod_CC1Emark_Comm();
    Ocm_Delay1ms(1);//
}
void Mod_CC1Emark_Done(void)
{
    UCCStatus.ucSop1MsgStep = SOP1END;
    BKFC_19_REG = 0x01;
    BKFC_17_REG = 0x40;
    BKFC_18_REG = 0x00;
}
#endif
void Mod_CC1SourceCapMsg_Loop(void)
{
    u8 ucSourceCapPerCycle;
    static u8 ucStage_Change = 0;
    static u8 ucStage=0;
    static u32 ulLastTime=0;
    if(UCCStatus.ucContract_Succeed||(UCCStatus.b2Toggle_enable==0x01))
    {
        return;
    }
	if(UCCStatus.b2Toggle_enable==0x02)
	{
		UCCStatus.b2Toggle_enable = 0x00;
		ucStage = 0x00;
    }
    switch(ucStage)
    {
        case 0:
            Ocm_Timer_UpdLocalTime(&ulLastTime);
            ucStage++;
            ucStage_Change = 1;
            break;
        case 1:
            //MS_100 for OPPO findX3 and Switch; if MS_20,switch will not ack source_cap
			//MS_150 for 黑鲨,if MS_100, 1/3的概率会出现不回包的情况
            if(Ocm_Timer_IsOverFlow(&ulLastTime,MS_150) == TRUE)
            {
                Ocm_Timer_UpdLocalTime(&ulLastTime);
                ucStage++;
                ucStage_Change = 1;
            }
            break;
        case 2:        
            if((UCCStatus.ucContract_Succeed == 0x00)&&(UCCStatus.b1PowerRole == TRUE)&&(UCCStatus.b1DataRole == TRUE))
            {
                if(Ocm_Timer_IsOverFlow(&ulLastTime,MS_100) == TRUE)
                {
                    if(UCCStatus.ucnUccSourceCapCnt < nCapsCount)
                    {    
                        UCCStatus.ucnUccSourceCapCnt++;
                        for(ucSourceCapPerCycle = 0; ucSourceCapPerCycle< 4; ucSourceCapPerCycle++)
                        {        
                            if(Drv_CC1RpOn_Scan() == 0)
                            {
                                Mod_CC1Unlock_Init();
                                ucStage = 0;
                                break;
                            }
                            else                
                            {        
                                if(ucStage_Change == 1)
                                {
									#if UCC_EMARK_SUPPORT == ENABLED
                                    if(UCCStatus.b1UCcInput_type == FEMALE)
                                    {
                                        Mod_CC1Emark_Initiate();
                                        Ocm_Delay1ms(20);
                                        Mod_CC1Emark_Done();
                                    }
									#endif
                                    ucStage_Change = 0;
                                    ADAPTER_GPIO_CTRL(IN HIGH);
                                    SOURCE_GPIO_CTRL(IN HIGH);
                                    Ocm_Timer_UpdLocalTime(&ulLastTime);
                                    break;
                                }
                                else
                                {
                                    ADAPTER_GPIO_CTRL(IN HIGH);
                                    if(!UCCStatus.ucContract_Succeed) //source cap
                                    {
                                        DRV_RpCur_Sel(UCC,Rp_SinkTxNG);
                                        Ocm_Delay1ms(4);
                                        UCCStatus.ucPRSwaped  = 1;    //necessary for dr swap as the role of UFP
                                        UCCStatus.b1PowerRole = TRUE;
                                        UCCStatus.b1DataRole = TRUE;
										#if VCONNSWAP_SUPPORT == ENABLED 
                                        UCCStatus.b1VconnSwap_En = FALSE;  
										#endif  
                                        UCCStatus.ucDrSwap_En = 0;    
                                        UCCMSG.ucMessageID = 0;
                                        
                                        Mod_CC1SourceCapMsg_Set();    
                                        UCCStatus.ucFlow_Step = 6;
										#if CCTRY_MODE != NO_TRY
										UCCStatus.b2TRYTIMES = TRYTIMES;
										#endif
                                        //#if ((LT8711UXD == DISABLED)||(TYPEC_INPUT_TYPE == FEMALE))                 
                                        Drv_CC1Flip_Judge(&UCCStatus);
                                        //#endif
                                        Mod_CC1Msg_Send();
                                        UCCMSG.ucLastMsgType = Mod_CC1MsgType_Calc(Data_Msg,Source_Capabilities,StrVdm);    
                                        Ocm_Delay1ms(2);
                                    }
                                    else
                                    {
                                        ucStage++;
                                    }    
                                }                                
                            }
                        }
                    }
                    else
                    {
                        UCCStatus.ucnUccSourceCapCnt = nCapsCount;
                        #if HUB_RESET_CTRL == ENABLED
                        UCCStatus.b2HubResetHigh = HUBRESETHIGH_DONE;
                        #endif
                    }
                    Ocm_Timer_UpdLocalTime(&ulLastTime);
                }
                else                     
                {
                    if(Drv_CC1RpOn_Scan() == 0)
                    {
                        Mod_CC1Unlock_Init();
                        ucStage = 0;                      
                    }                 
                }
            } 
            else
            {
                ucStage = 0;
            }
            break;
        default:
            ucStage = 0;
//            ucRtn = 1;
            break;                    
    }    
//    return ucRtn;
}
#if ((TYPEC_PRSWAP_EN == ENABLED)||(TYPEC_DRSWAP_EN == ENABLED))
void Mod_CC1DetOff_Action(void)
{
    u16 usWaitRequestDone;
	Mod_CC1Vconn_Off();
    #if RX_PORT_SIGN == DP_PORT
    Drv_System_IntSet(IRQ_DPRX_AUX_INT, OFF);
    Drv_System_IntClr(IRQ_DPRX_AUX_INT);
    
    Drv_DpRx_AcAuxTermCtrl(DISABLED);
    Drv_DpRx_DcAuxResCtrl(DISABLED);
    #endif
    
    Ocm_Delay1ms(1);
    Drv_Cc1Sw_Ctrl(DISABLED);
    
    Ocm_Delay1ms(26);//big than 25ms.less than 35ms 
	SOURCE_GPIO_CTRL(IN LOW);
    DISCSOURCE_GPIO_CTRL(IN HIGH);
	#if HUB_RESET_CTRL == ENABLED
    HubReset_GPIO_Ctrl(LOW);
	#endif
    
//	Mod_CC1SwapMsg_Scan(0);
    DRV_CC_LogicRst(UCC);
    DRV_PowerRole_Set(UCC,SINK);
	Mod_CC1Vari_Init();
    BKA2_BA_REG = 0x08;//400mv
    if(DCCStatus.b1AdapterWithPD)	
    {
        DCCMSG.pDataOrder = szCC_DataMsg[1];//request 5v
        Mod_CC2Msg_Send();//request 5v
        DCCStatus.ucFlow_Step = 2;//INITITATE REQUEST
    }
//    DRV_HdmiTx_TxPllReset();//TBD
    //Mod_CC1Vari_Init();
    #if RX_PORT_SIGN == DP_PORT
    #if DPRX_HDCP_DEC_MODE != NO_HDCP
    Drv_System_IntSet(IRQ_RXHDCP1X_INT,OFF);//
    Drv_System_IntSet(IRQ_RXHDCP2X_INT,OFF);//
    
    Drv_HdcpRx_StateClear();
    #endif
    #endif
    Ocm_Delay1ms(100);
    for(usWaitRequestDone=0;usWaitRequestDone<300;usWaitRequestDone++)
    {
        if(DCCStatus.ucFlow_Step == 2)
        {
            Ocm_Delay1ms(1);
        }
        else
        {
            break;
        }
    }
    DISCSOURCE_GPIO_CTRL(IN LOW);
    Drv_Cc1Sw_Ctrl(ENABLED);
    #if REMOVE_UART == DISABLED
    printLT(PRINT_PRIO_HIG,"\nUCC OFF");
    #endif
   
}
u8 Mod_CC1DetOff_Scan(void)
{
    if(((BKFC_30_REG&0xf0)==0x00)||((((BKFC_30_REG&0xf0)==0x80)||((BKFC_30_REG&0xf0)==0x20))&&(BKA2_B1_REG&BIT2_1))) //UCC OUT
    {
        return TRUE; 
    }
    return FALSE;
}
//===============================
//detect ucc state
//1 stands for out,0 stands for in
u8 Mod_CC1DetOff_Judge(void)
{
    bool CC_Off_Line = FALSE;
    u8 ucCC_Count;
    //For LT8711UXD,UCC2 maybe used for HUB reset;in this case,CC detect will abnormal
    if(Mod_CC1DetOff_Scan() == TRUE)
    {
		Ocm_Delay1us(3);
        for(ucCC_Count=0;ucCC_Count < 100;ucCC_Count++)
        {
            if(Mod_CC1DetOff_Scan() == TRUE)
            {
                CC_Off_Line = TRUE;
				Ocm_Delay1us(3);
            }
            else
            {
                CC_Off_Line = FALSE;
                break;
            }
        }
    }
    return CC_Off_Line;
}
void Mod_CC1PSSourceOff_Det(void)// ps rdy off timer detect
{
    static u8 ucStage= 0;
    static u32 ulLastTime= 0;
    switch(ucStage)
    {
        case 0:
            Ocm_Timer_UpdLocalTime(&ulLastTime);
            ucStage++;
        case 1:          
            if(UCCStatus.ucPRSwaping == 2)
            {
                if(Ocm_Timer_IsOverFlow(&ulLastTime,MS_835) == TRUE)//tPSSourceOff
                {        
                    UCCStatus.b2Hardreset_Hdl = HardRst_Initate;
                    ucStage++;   
                }
                else
                {
                    ;
                }                
            }
            else
            {
                Ocm_Timer_UpdLocalTime(&ulLastTime);
                ucStage = 0;
            }
            break;
        default:
            ucStage = 0;
            break;            
    }  
}
