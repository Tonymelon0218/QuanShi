void Mod_CC2Flip_ScanDet(void)
{
	if(Drv_CC2On_Det(SINK) == TRUE)
    {
        if(BKFC_B0_REG&0xc0) //
        {
            BKFC_AF_REG &= BIT1_0;//flip 1 soft
        }
        else if(BKFC_B0_REG&0x30)//
        {
            BKFC_AF_REG |= BIT1_1;//flip 1 soft
        }
    }
}
#if ((TYPEC_PRSWAP_EN == ENABLED)||(TYPEC_DRSWAP_EN == ENABLED))
void Mod_CC2PowerOn_Det(void)
{
    static u32 ulLastTime = 0;
    static u8 ucStage = 0x00;
    static u8 ucHardRst_Cnt = 0x00;
	#if DCC_TOGGLE_SUPPORT == ENABLED
    u8 ucLoopCnt;
	#endif
    Mod_CC2Flip_ScanDet();
	#if DCC_TOGGLE_SUPPORT == ENABLED
    Mod_CC2Flip_Scan();
	#endif
    if((Drv_CC2On_Det(SINK) == TRUE)&&(UCCStatus.ucFRSwaping == FRSWAP_NULL))
    {    
        if(DCCStatus.b2Charger_Scan == PDSCANSTART)
        {
            #if REMOVE_UART == DISABLED
            printLT(PRINT_PRIO_HIG, "\nAdaP");
            #endif
            ucStage = 0x00;
            UCCMSG.szPDP_Value[0] = 0x07;
            UCCMSG.szPDP_Value[1] = 0x07;
            ADAPTER_GPIO_CTRL(IN LOW);;
            DCCStatus.b1FrTriggle = FALSE;
            DCCStatus.b2Charger_Scan = PDSCANGOING;           
            #if DCC_TOGGLE_SUPPORT == ENABLED
            for(ucLoopCnt = 0;ucLoopCnt<250;ucLoopCnt++)
            {        
                Ocm_Delay1ms(1);
                if(Drv_CC2On_Det(SINK) == FALSE)
                {
                    Mod_CC2Toggle_Init(FALSE);//Rp
                    DCCStatus.b2Charger_Scan = PDSCANSTART;
                    break;
                }            
            }
            #endif
        }       		       
        if(DCCStatus.b2Charger_Scan == PDSCANGOING)
        {          
            if(Drv_CC2On_Det(SINK) == FALSE)
            {
                ucStage = 0x00;
                DCCStatus.b2Charger_Scan = PDSCANSTART;
                return;
            }
            Mod_CC2Flip_ScanDet();
          	switch(ucStage)
            {
                case 0x00:
                    ucStage++;  
                    ucHardRst_Cnt = 0;
                    Ocm_Timer_UpdLocalTime(&ulLastTime); 
                    break;
                case 0x01:   
                    if((DCCStatus.b1AdapterWithPD)||(Ocm_Timer_IsOverFlow(&ulLastTime,SECOND_1)))
                    {
                        ucStage++; 
                        Ocm_Timer_UpdLocalTime(&ulLastTime); 
                    }
                    break;
                case 0x02:
                    if(DCCStatus.b1AdapterWithPD == FALSE)//没有收到包
                    {
                        if(Ocm_Timer_IsOverFlow(&ulLastTime,MS_500))//500ms发送一次hardreset
                        {
                            if(ucHardRst_Cnt <= nHardResetCount)//最多发送三次
                            {
                                ucHardRst_Cnt++;
                                DRV_CcOrder_Set(DCC,HARDRESET);
                                Ocm_Timer_UpdLocalTime(&ulLastTime); 
                            }
                            else//发完就结束
                            {      
                                #if TYPEC_PRSWAP_EN == ENABLED
                                if((Mod_CC1DetOff_Judge() == FALSE)&&(UCCStatus.ucPRSended == 0)&&(UCCStatus.b1PowerRole ==FALSE))    //
                                {
                                    UCCStatus.ucPRSended = 1;
                                }
                                #endif
                                ucHardRst_Cnt = 0;
                                ucStage++; 
                            }
                        }
                    }
                    else
                    {
                        ucStage++; 
                    }
                    break;
                case 0x03:
                    ucHardRst_Cnt = 0;
                    ucStage++;
                    DCCStatus.b2Charger_Scan = PDSCANEND;
                    SOURCE_GPIO_CTRL(IN LOW);
                    ADAPTER_GPIO_CTRL(IN HIGH);
                    break;
                default:
                    ucStage = 0;
                    break;
                
            }
        }
    }
}

        
