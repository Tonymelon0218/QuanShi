void Mod_TSwapSourceStart(void)//tSwapSourceStart >=20ms   
{
    static u32 ulLastTime = 0;
    //reserve for Emark communication
    if(UCCStatus.b2SwapSourceStart == 0x00)
    {
        return;
    }
    else if(UCCStatus.b2SwapSourceStart == 0x01)
    {
        UCCMSG.ucLastMsgType = 0xff;
        UCCStatus.b2SwapSourceStart = 0x02;     
		if(UCCMSG.ucCcVersion == PD30)
		{
        	DRV_RpCur_Sel(UCC,Rp_SinkTxNG);
		}
		#if UCC_EMARK_SUPPORT == ENABLED     
        if(UCCStatus.b1UCcInput_type == FEMALE)
        {
            Mod_CC1Emark_Initiate();
        }
		#endif
        Ocm_Timer_UpdLocalTime(&ulLastTime);      
    }
    else//02
    {
        if(Ocm_Timer_IsOverFlow(&ulLastTime,MS_80))
        {
            UCCStatus.b2SwapSourceStart = 0x00; 
            UCCStatus.ucPRSwaping = 0;        
            #if UCC_EMARK_SUPPORT == ENABLED
            if(UCCStatus.b1UCcInput_type == FEMALE)
            {
                Mod_CC1Emark_Done();
            }
            #endif
            if(UCCAmsType.ucPrSwap_Ams == AMS_GOING)
            {
                UCCAmsType.ucPrSwap_Ams = AMS_GOEXP;
            }
            //for HUAWEI P50,we need to Delay at least 70ms before sending Source cap                               
            UCCMSG.ucMessageID = 0x00;
            Mod_CC1SourceCapMsg_Set();
            Mod_CC1Msg_Send();
            UCCMSG.ucLastMsgType = 0xff;
            if(UCCMSG.ucCcVersion == PD30)
            {
                DRV_RpCur_Sel(UCC,Rp_SinkTxOK);
            }
        }
    }
}
void Mod_Cc1_DisIdentifySend(void)
{
    static u8 ucStage = 0;
    static u8 ucDisIdSendCnt = 0;
    static u32 ulLastTime= 0;
    static u8 ucTmpInit = 0x00;
    static u16 ucKeepTime = MS_50;
    if(UCCStatus.b2DisIdSend_En == INITIATE_NONE)
    {
        ucTmpInit = 1;
    }
    else if(UCCStatus.b2DisIdSend_En == INITIATE_DONE)
    {
        ucTmpInit = 1;
    }
    else if(UCCStatus.ucFlow_Step >= 2)
    {
        ucTmpInit = 1;
    }
    else if(UCCStatus.ucPRSwaping)
    {
        ucTmpInit = 1;
    }
    else if(UCCAmsType.ucVconnSwap_Ams == AMS_GOING)
    {
        ucTmpInit = 1;
    }
    if(ucTmpInit == 1)
    {
        ucTmpInit = 0;
        ucStage = 0;
        ucDisIdSendCnt = 0;
        ucKeepTime = MS_800;
        return ;
    }
    switch(ucStage)
    {
        case 0://init
            Ocm_Timer_UpdLocalTime(&ulLastTime);
            ucStage++;   
            break; 
        case 1:     
            if((UCCStatus.b1DataRole == TRUE)&&(UCCAmsType.ucBist_Ams == 0))
            {
                if(ucDisIdSendCnt < 30) //send Discover_Identity
                {
                    if(Ocm_Timer_IsOverFlow(&ulLastTime,ucKeepTime) == TRUE)
                    {
                        UCCMSG.pDataOrder     = szCCData_REQDiscoverId;// 
                        UCCMSG.ucLastMsgType  = Mod_CC1MsgType_Calc(Vdm_Msg,Discover_Identity,StrVdm);
                        UCCMSG.b1Vdm_Msg = TRUE;
                        Mod_CC1Msg_Send();
                        ucKeepTime = MS_50;
                        Ocm_Timer_UpdLocalTime(&ulLastTime);
                    }
                }
                else
                {
                    UCCStatus.b2DisIdSend_En = INITIATE_DONE;
                    ucStage = 0;
                }
            }
            else
            {
                ucStage = 0;
            }
            break;
        default:
            ucStage = 0;
            break;            
    }
}
