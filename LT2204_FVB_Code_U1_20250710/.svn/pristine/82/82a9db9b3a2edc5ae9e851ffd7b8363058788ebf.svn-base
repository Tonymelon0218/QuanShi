void Mod_CC1SoftRstRec_Handle(void)
{
    if(UCCStatus.b1Flag_Source_Send)
    {
        UCCStatus.b1Flag_Source_Send = 0;     
        if(Drv_CC1RpOn_Scan()==1)
        {
            Ocm_Delay1ms(5);
            Mod_CC1SourceCapMsg_Set();
            UCCStatus.ucFlow_Step = 5;
            UCCMSG.ucMessageID = 0x02;
            Mod_CC1Msg_Send();
            UCCMSG.ucLastMsgType = Mod_CC1MsgType_Calc(Data_Msg,Source_Capabilities,StrVdm);
            Ocm_Delay1ms(1);						
        }
    }
}

void Mod_HardRstSend_Handle(void)
{
    if(UCCStatus.b2Hardreset_Hdl == HardRst_Initate)
    {
        UCCStatus.b2Hardreset_Hdl = HardRst_None;
        if(Mod_CC1DetOff_Judge() == FALSE)
        {            
            DRV_CcOrder_Set(UCC,HARDRESET);
            Mod_CC1DetOff_Action();   
        }            
    }
    if(UCCStatus.b2Hardreset_Hdl == HardRst_Source)
    {
        UCCStatus.b2Hardreset_Hdl = HardRst_None;
        if(Mod_CC1DetOff_Judge() == FALSE)
        {
			//if C2A cable inserts, 8711 should send hardreset and set the Try timer
			#if CCTRY_MODE != NO_TRY
            UCCStatus.b2TRYTIMES = TRYTIMES;
			#endif
            DRV_CcOrder_Set(UCC,HARDRESET);
        } 
    }
}
#if NINTENDO_SWITCH == ENABLED
void Mod_EnterIntoSwitch_Handle(void)
{
    if(UCCStatus.b2Hardreset_Hdl == HardRst_Switch)
    {
        DRV_CcOrder_Set(UCC,HARDRESET);
        Mod_CC1DetOff_Action();
        CC1NINTENDOState.b1Switch_Online = TRUE;
        DRV_PowerRole_Set(UCC,SOURCE);
        DRV_RpCur_Sel(UCC,Rp_SinkTxOK);
        UCCStatus.b1Toggle_DFP_EN = TRUE;
    }
}
#endif
