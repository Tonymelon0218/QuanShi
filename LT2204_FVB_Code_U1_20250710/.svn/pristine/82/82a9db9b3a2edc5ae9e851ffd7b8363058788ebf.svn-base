    CC1NINTENDOState.b1IsSwitch = FALSE;
    CC1NINTENDOState.b2SwitchIntoSleep = Sleep_None;
    CC1NINTENDOState.b2SwitchIntoWakeUp = Sleep_None;
    #endif
    #if NINTENDO_SWITCH_HDMIHPD == ENABLED
    CC1NINTENDOState.b1NintendoRecordTxHpd = Drv_HdmiTx_HpdDet();
    CC1NINTENDOState.b1HPDLongTime = FALSE;
    #endif
    DCCStatus.ucFlow_Step = 0;
//    #if DDCCI_EN == ENABLED
//    g_stDdcciStatus.b1Send_Differ_En = 0;
//    g_stDdcciStatus.ucAuxDDCCI = 0;
//    g_stDdcciStatus.ucLenth_Of_Data = 0;
