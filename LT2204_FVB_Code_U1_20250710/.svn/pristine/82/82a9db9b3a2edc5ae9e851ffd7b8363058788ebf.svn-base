void Mod_HardRstRec_Handle(void)//TDB2.2.13.1
{
	if(UCCStatus.b2Hardreset_Hdl == HardRst_Rec)
	{
		Mod_CC1DetOff_Action();
		UCCStatus.b2Hardreset_Hdl = HardRst_None;
	}		
}
