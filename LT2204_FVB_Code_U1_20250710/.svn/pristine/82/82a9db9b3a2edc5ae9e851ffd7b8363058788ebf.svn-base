//===========================================
//func  :used to indicate the typec communication is done ,when new cc communction must be cleared zero
//input :N/A
//output:1:meas cc is done , 0 means cc is on-going
//return:void
//Info  :N/A
//===========================================
u8 Mod_CC1ComDone_Get(void)
{
    #if CHIP_SEL == LT6711GXE
    if((UCCStatus.ucVDM_Step&BIT6_1)&&(UCCStatus.b1IsCc_done == TRUE))//todo
    #else
    if((UCCStatus.ucVDM_Step&BIT5_1)&&(UCCStatus.b1IsCc_done == TRUE))//todo
    #endif
    {
		return TRUE;
    }
    return FALSE;
}


//=============================================
//func  :send the attetion flage for the hpd or irq
//input :N/A
//output:1:meas cc is done , 0 means cc is on-going
//return:void
//Info  :N/A
//==============================================

void Mod_CC1HpdIrq_Send(u8 ucAttentType)
{
    static u8 b1Atten_EN = 0;
    
    if(ucAttentType == ATTENTION_LOW)
    {
        if(UCCStatus.ucVDM_Step & BIT6_1)
        {
            UCCMSG.pDataOrder = szCC_DataMsg[10];  
            #if REMOVE_UART == DISABLED
            printLT(PRINT_PRIO_HIG,"\nATN LOW"); 
            #endif
            UCCStatus.ucVDM_Step &= BIT6_0;
            b1Atten_EN = 1;
        }
    }
    else
    {
        if(ucAttentType == ATTENTION_HIGH)
        {
            UCCMSG.pDataOrder = szCC_DataMsg[11];
            #if REMOVE_UART == DISABLED
            printLT(PRINT_PRIO_HIG,"\nATN HIG");//need update 
            #endif
            UCCStatus.ucVDM_Step |= BIT6_1; 
            b1Atten_EN = 1;
        }
        else if(ucAttentType == ATTENTION_IRQ)
        {
            if(UCCStatus.ucVDM_Step & BIT6_1)
            {
                UCCMSG.pDataOrder = szCC_DataMsg[12];
                #if REMOVE_UART == DISABLED
                printLT(PRINT_PRIO_HIG,"\nATN IRQ");//need update 
                #endif
                b1Atten_EN = 1;             
            }
        }	    
    } 
    if(b1Atten_EN == 1)
    {
        b1Atten_EN = 0;
        UCCMSG.b1Vdm_Msg = TRUE;
        UCCStatus.b1Multi_Function = (UCCStatus.uclaneCount == 4)?(0):(1);
        Mod_CC1Msg_Send();
    }
}   
    
void Mod_CC2Vari_Init(void)
{
    DCCStatus.b1DataRole = 0;
    DCCStatus.b1PowerRole = 0;
    DCCStatus.b1AdapterWithPD = FALSE;
    
    #if PD_PPS_EN == ENABLED
    DCCMSG.ucCcVersion = PD30;
    #else
    DCCMSG.ucCcVersion = PD20;
    #endif
    
    DCCMSG.ucMessageID = 0;
    
    DCCStatus.b1DataRole = 0;
    DCCStatus.b1PowerRole = 0;
    DCCStatus.ucRetryCounter = 0;
    DCCStatus.b1FrTriggle = FALSE;
    DCCMSG.b1RcvGoodCRC = 1;
    DCCStatus.b2Charger_Scan = PDSCANSTART;
    DCCStatus.b1Msg_ID_Change = 1;
    #if DCC_TOGGLE_SUPPORT == ENABLED
    DCCStatus.b1DccUfpMode = FALSE;
    DCCStatus.b1DccDfpMode = FALSE;
    #endif    
    #if NINTENDO_SWITCH == ENABLED
    CC1NINTENDOState.b2Switch_Ada_Online = NOT_SWITCH;
    #endif
}
void Mod_CC1CableVari_Init(void)
{
    #if UCC_EMARK_SUPPORT == ENABLED 
    UCCStatus.ucSop1MsgStep = SOP1END;
    if(UCCStatus.b1UCcInput_type == FEMALE)
    {
        UCCStatus.ucCable5A = 0; 
    }
    else
    {
        UCCStatus.ucCable5A = 1; 
    }
    #else
    if(UCCStatus.b1UCcInput_type == FEMALE)
    {
        UCCStatus.ucCable5A = 0; 
    }
    else
    {
        UCCStatus.ucCable5A = 1; 
    }
    #endif
}

void Mod_CC1Vari_Init(void)
{
    #if HUB_RESET_CTRL == ENABLED
    UCCStatus.b2HubResetHigh = HUBRESETLOW;//TBDY
    #endif
	#if CCTRY_MODE != NO_TRY
    UCCStatus.b2TRYTIMES = TRYTIMES;	
	#endif
    UCCStatus.b1IsCc_done = FALSE;
    UCCStatus.b1DataRole = 0;
    UCCStatus.b1PowerRole = 0;
	#if VCONNSWAP_SUPPORT == ENABLED 
    UCCStatus.b1VconnSwap_En = 0;
	#endif
	UCCStatus.b1PrDone = FALSE;
    UCCStatus.b1Multi_Function = 0;
    UCCStatus.b1PsRdy_Send  = 0;
    UCCStatus.b1WaitMsg_Receive = 0;
    UCCStatus.b1IsFlip = FALSE;
    UCCStatus.b1Flag_Source_Send = 0;
    UCCStatus.b1Toggle_DFP_EN = FALSE;
    UCCStatus.b2Hardreset_Hdl = HardRst_None;
//    UCCStatus.b1IsCc_done = 0;
    UCCStatus.b1CCDataMsg_Sent = FALSE;    
    UCCStatus.ucPRSended = 0;
    UCCStatus.ucPRSwaping = 0;
    UCCStatus.ucPRSwaped = 0;    
    UCCStatus.ucFRSwaping = FRSWAP_NULL;    
    UCCStatus.ucDrSwap_En = 0;
    UCCStatus.ucContract_Succeed =0;
    UCCStatus.ucSwap_Sent = 0;
    UCCStatus.ucRetryCounter = 0;   
    UCCStatus.ucFlow_Step = 0;
    UCCStatus.ucVDM_Step = 0;
    UCCStatus.ucnUccSourceCapCnt = 0;
    UCCStatus.b2SwapSourceStart = 0x00;
    Mod_CC1CableVari_Init();
    UCCStatus.b1Msg_ID_Change = 1;    
    UCCStatus.b2Toggle_enable = 0x01;
