#if HUB_RESET_CTRL == ENABLED
void Mod_HubReset_Handle(void)
{
    static u32 ulLastTime = 0;
    if(UCCStatus.b2HubResetHigh == HUBRESETHIGH_PRE)
    {
        UCCStatus.b2HubResetHigh = HUBRESETHIGH_GOING;
        Ocm_Timer_UpdLocalTime(&ulLastTime);        
    }
    if(UCCStatus.b2HubResetHigh == HUBRESETHIGH_GOING)
    {
        //if(KNL_Timer_IsOverFlow(&ulLastTime,MS_1500))
        if(Ocm_Timer_IsOverFlow(&ulLastTime,SECOND_1))
        {
            UCCStatus.b2HubResetHigh = HUBRESETHIGH_DONE;
        }
    }
    if(UCCStatus.b2HubResetHigh == HUBRESETHIGH_DONE)
    {
        Drv_CC1Flip_Judge(&UCCStatus);
        UCCStatus.b2HubResetHigh = HUBRESETLOW;
        HubReset_GPIO_Ctrl(HIGH);
    }    
}
#endif
#if NINTENDO_SWITCH_HDMIHPD == ENABLED
void Mod_Nintendoswitch_HdmiHpd_Handle(void)
{   
    u8 b1HdmiHpdState;
    static u32 ulLastTime = 0;
    static u8 b1StateChange = FALSE;
    static u16 Time_Stampe = 0x00;
    if(CC1NINTENDOState.b1HPDLongTime == TRUE)
    {
        Time_Stampe = SECOND_4;
    }
    else
    {
        Time_Stampe = MS_1500;
    }
    b1HdmiHpdState = Drv_HdmiTx_HpdDet();
    if((b1HdmiHpdState != CC1NINTENDOState.b1NintendoRecordTxHpd))
    {
        if(b1StateChange == FALSE)
        {
            b1StateChange = TRUE;
            Ocm_Timer_UpdLocalTime(&ulLastTime);  
        }
    }
    else
    {
        if(b1StateChange == TRUE)
        {
            b1StateChange = FALSE;
            Ocm_Timer_UpdLocalTime(&ulLastTime); 
        }
    }
    #if ((FORCE_NINTENDO_SWITCH == ENABLED)||(NINTENDO_SWITCH_FORALL == ENABLED))
    if(((CC1NINTENDOState.b2Switch_Ada_Online != NOT_SWITCH)||(DCCStatus.b1AdapterWithPD == FALSE))&&(Drv_CC2On_Det(SINK)==TRUE))//DCC Online and Switch adapter Online
    {
        if((UCCStatus.b1PrDone&&((UCCStatus.ucVDM_Step&BIT2_1)==0x00))||(CC1NINTENDOState.b1Switch_Online == TRUE))
        {         
            if((b1HdmiHpdState != CC1NINTENDOState.b1NintendoRecordTxHpd))
            {
                
                if(Ocm_Timer_IsOverFlow(&ulLastTime,Time_Stampe))
                {
                    CC1NINTENDOState.b1NintendoRecordTxHpd = b1HdmiHpdState;
                    UCCStatus.b2Hardreset_Hdl = HardRst_Switch;
                }
                else
                {
                    ;
                }
            }
            else
            {
                Ocm_Timer_UpdLocalTime(&ulLastTime); 
            }
        }
    }
    #else
    if(((CC1NINTENDOState.b2Switch_Ada_Online == SWITCH_ADAPTER)||(DCCStatus.b1AdapterWithPD == FALSE))&&(Drv_CC2On_Det(SINK)==TRUE))//DCC Online and Switch adapter Online
    {
        if((UCCStatus.b1PrDone&&((UCCStatus.ucVDM_Step&BIT2_1)==0x00))||(CC1NINTENDOState.b1Switch_Online == TRUE))
        {         
            if((b1HdmiHpdState != CC1NINTENDOState.b1NintendoRecordTxHpd))
            {
                
                if(Ocm_Timer_IsOverFlow(&ulLastTime,Time_Stampe))
                {
                    CC1NINTENDOState.b1NintendoRecordTxHpd = b1HdmiHpdState;
                    UCCStatus.b2Hardreset_Hdl = HardRst_Switch;
                }
                else
                {
                    ;
                }
            }
            else
            {
                Ocm_Timer_UpdLocalTime(&ulLastTime); 
            } 
        }
    }
    #endif
}
#endif
void Mod_Cc1Attention_Handle(void)
{
    #if CHIP_SEL == LT6711GXE
    static u8 b2AttentionStatus = ATTENTION_NULL;
    static u8 ucHpdChange = 0;
	static u32 ulLastTime=0;
    //DP config之前的变换全部清掉
    if(UCCStatus.ucFlow_Step >= 2)
    {
        return;
    }
    if((UCCStatus.ucVDM_Step & BIT5_1) == 0x00)
    {
        b2AttentionStatus = ATTENTION_NULL;
        ucHpdChange = 0;
        return;
    }
    if(b2AttentionStatus != UCCStatus.b2AttentionType)
    {
        ucHpdChange = 1;
        Ocm_Timer_UpdLocalTime(&ulLastTime);
    }
    b2AttentionStatus = UCCStatus.b2AttentionType;
    if(ucHpdChange == 1)//in case of constant IRQ issue, reserve 20ms keep out
    {
        if(Ocm_Timer_IsOverFlow(&ulLastTime,MS_20))
        {
            UCCStatus.b2AttentionType = ATTENTION_NULL;
            ucHpdChange = 0;
            if(b2AttentionStatus == ATTENTION_LOW)
            {
                #if REMOVE_UART == DISABLED
                printLT(PRINT_PRIO_HIG, "\nUAttLOW");
                #endif
                UCCStatus.ucVDM_Step &= BIT6_0;
            }
            else if(b2AttentionStatus == ATTENTION_HIGH)
            {
                #if REMOVE_UART == DISABLED
                printLT(PRINT_PRIO_HIG, "\nUAttHIGH");
                #endif
                UCCStatus.ucVDM_Step |= BIT6_1;
            }
            else if(b2AttentionStatus == ATTENTION_IRQ)
            {
                if(UCCStatus.ucVDM_Step & BIT6_1)
                {
                    UCCStatus.ucUccIrq=1;
                    #if REMOVE_UART == DISABLED
                    
                    printLT(PRINT_PRIO_HIG, "\nUAttIRQ");
                    #endif
                    Drv_DpTx_IrqTrig();
                }
                else
                {
                    #if REMOVE_UART == DISABLED
                    printLT(PRINT_PRIO_HIG, "\nUAttInvalid");
                    #endif
                }
            }
            b2AttentionStatus = ATTENTION_NULL;
        }
    }
    #else
    static u8 ucAttentionStep = 0x00;
    static u32 ulLastTime = 0;
    static u8 ucAttentType = ATTENTION_NULL;
    if(UCCStatus.ucFlow_Step >= 2)//IN Power Nego
    {
        ucAttentionStep = 0x00;
        return;
    }
    //没有要发的ATTENTION
    if(UCCStatus.b2AttentionType == ATTENTION_NULL)
    {
        ucAttentionStep = 0x00;
        return;
    }
    else
    {
        if(ucAttentionStep == 0x00)
        {
            Ocm_Timer_UpdLocalTime(&ulLastTime); 
            ucAttentionStep = 0x01;
        }        
    }
    if(Ocm_Timer_IsOverFlow(&ulLastTime,MS_20))
    {
        ucAttentionStep = 0x00;
        ucAttentType = UCCStatus.b2AttentionType;
        //先发送后清零
        Mod_CC1HpdIrq_Send(UCCStatus.b2AttentionType);
        //如果发送Attention过程中，新触发了Attention，需要处理一下
        if(UCCStatus.b2AttentionType != ucAttentType)
        {
            ;
        }
        else
        {
            UCCStatus.b2AttentionType = ATTENTION_NULL;
        }   
    }
    #endif
}

void Mod_Cc1VdmBusy_Handle(void)
{
    static u32 ulLastTime= 0;
    static u8 ucVdmBusyCnt = 0x00;
    if(UCCStatus.ucFlow_Step >= 2)
    {
        return;
    }
    else if(UCCStatus.ucPRSwaping)
    {
        return;
    }
    else if(UCCStatus.b2VdmBusy == AMS_NONE)
    {
        ucVdmBusyCnt = 0;
    }
    else if(UCCStatus.b2VdmBusy == AMS_READY)
    {
        UCCStatus.b2VdmBusy = AMS_GOING;
        Ocm_Timer_UpdLocalTime(&ulLastTime);
    }
    else if(UCCStatus.b2VdmBusy == AMS_GOING)
    {
        if(ucVdmBusyCnt < nBusyCount)
        {
            ucVdmBusyCnt++;
            if(Ocm_Timer_IsOverFlow(&ulLastTime,MS_100) == TRUE)
            {
                UCCStatus.b2VdmBusy = AMS_DONE;
                UCCMSG.pDataOrder = UCCMSG.pLast_DataOrder;
                Mod_CC1Msg_Send();
            }
        }
        else
        {
            UCCStatus.b2VdmBusy = AMS_DONE;
        }  
    }
}

void Mod_CC1Rx_Loop(void)
{
    
    #if CHIP_SEL == LT6711GXE
    if(g_stDpTx.b1IsDpOrTypec  == DP_INTF)
    {
        return;
    }
    #else
    if(g_stDpRx.b1Input_Type_Sel == DP_INTF)
    {
        return;
    }
    #endif  
    if(UCCStatus.b1PrDone == FALSE)
    {
        Drv_CC1Flip_Scan(&UCCStatus);      
        if(UCCAmsType.ucBist_Ams == 0)
        {
            #if ((TYPEC_PRSWAP_EN == ENABLED)||(TYPEC_DRSWAP_EN == ENABLED))
            Mod_CC1PSSourceOff_Det();
            #endif
        }
        #if TYPEC_DRSWAP_EN == ENABLED
        Mod_CC2PowerOn_Det();           
        Mod_CC1Toggle_Loop();
        #endif
        if(UCCAmsType.ucBist_Ams == 0)
        {
            Mod_CC1SourceCapMsg_Loop();
            #if TYPEC_PRSWAP_EN == ENABLED
            Mod_CC1PrSwap_Scan();
            #endif
        }
        if((UCCStatus.ucPRSwaping != 2)&&(UCCStatus.ucContract_Succeed)&&(UCCStatus.ucFRSwaping != FRSWAP_ONGOING))//det UCC all the time
//		if((UCCStatus.ucPRSwaping != 2)&&(UCCStatus.ucContract_Succeed))//det UCC all the time
        {
            if(Mod_CC1DetOff_Judge()==TRUE)
            {			
                Mod_CC1DetOff_Action();
            }
        }           
    }
    else
    {
        #if ((TYPEC_PRSWAP_EN == ENABLED)||(TYPEC_DRSWAP_EN == ENABLED))
//        if(UCCAmsType.ucBist_Ams == 0)
//        {
//            Mod_CC1SwapMsg_Scan(1);
//        }
        if(Mod_CC1DetOff_Judge() == TRUE)
        {
            Mod_CC1DetOff_Action();
        }
        #endif
    }
    if(UCCAmsType.ucBist_Ams == 0)
    {
        Mod_CC1SwapMsg_Scan();
        Mod_Cc1VconnSwap_Handle();
    }
    Mod_TSwapSourceStart();
    Mod_Cc1_DisIdentifySend();
    Mod_HardRstRec_Handle();
    Mod_HardRstSend_Handle();
    Mod_CC1SoftRstRec_Handle();
    #if NINTENDO_SWITCH == ENABLED
    Mod_EnterIntoSwitch_Handle();
    Mod_Nintendoswitch_WakeUp_Handle();
    #if NINTENDO_SWITCH_HDMIHPD == ENABLED
    Mod_Nintendoswitch_HdmiHpd_Handle();
    #endif
    #endif
    #if HUB_RESET_CTRL == ENABLED
    Mod_HubReset_Handle();
    #endif
    #if DCC_TOGGLE_SUPPORT == ENABLED
    Mod_CC2Toggle_Loop();
    #endif
    Mod_Cc1Attention_Handle();
    #if  TYPEC_FRSWAP_EN == ENABLED
    Mod_CC2FrSwapDischarge_Scan();
    #endif
    Mod_Cc1VdmBusy_Handle();
}

