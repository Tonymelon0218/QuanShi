void Mod_CC2FrSwapDischarge_Scan(void)
{
    static u32 ulLastTime = 0;
    static u8 ucStage = 0x00;
    static u8 ucStateChange = 0x00;
    if(UCCStatus.ucFRSwaping == FRSWAP_NULL)
    {
        // in case of abnormal cases
        if(Drv_GetIO_State(GPIO28_SD1B)==HIGH)
        {
            DISCADAPTER_GPIO_CTRL(LOW);
        }
        if(Drv_GetIO_State(GPIO19_SD0A_VSYNC)==HIGH)
        {
            DISCSOURCE_GPIO_CTRL(LOW);
        }
        ucStage = 0;
        return;
    }
    switch(ucStage)
    {
        case 0x00:
            ucStage++;
            ucStateChange = 0x01;
            Ocm_Timer_UpdLocalTime(&ulLastTime); 
            break;
        case 0x01://此处等待FR swap收到
            //如果一段时间内没有收到FRSWAP，处理
            if(UCCStatus.ucFRSwaping == FRSWAP_INITIATE)
            {
                if(Ocm_Timer_IsOverFlow(&ulLastTime,SECOND_1))//1s 没有收到FR swap
                {
                    ;///TBD
                }
            }
            else if(UCCStatus.ucFRSwaping == FRSWAP_RECEIVED)
            {      
                if(ucStateChange == 0x01)
                {
                    DISCSOURCE_GPIO_CTRL(HIGH);
                    ucStateChange = 0x00;
                    Ocm_Timer_UpdLocalTime(&ulLastTime); 
                }     
                if((Drv_Cc2VbusOff_Det() != 0x00)||Ocm_Timer_IsOverFlow(&ulLastTime,MS_1500))
                {
                    Ocm_Delay1ms(5);  //needed for Ipad Pro
                    DISCSOURCE_GPIO_CTRL(LOW);
                    //to solve lenovo PD30 issue
//                    DRV_PowerRole_Set(UCC,SINK);
                    UCCStatus.b1Toggle_DFP_EN = FALSE;
                    UCCStatus.ucFRSwaping = FRSWAP_ONGOING;
                    DCCStatus.b2Charger_Scan = PDSCANSTART;
                    //set to send PS_RDY
                    UCCStatus.b1PsRdy_Send  = TRUE;
                    Ocm_Timer2ForPsRdy_Set();//
                }                             
            }
            else if(UCCStatus.ucFRSwaping == FRSWAP_ONGOING)
            {
                DISCADAPTER_GPIO_CTRL(HIGH);
                Ocm_Timer_UpdLocalTime(&ulLastTime);
                ucStage++;
            }
            break;
        case 0x02:
            if((Drv_CC2On_Det(SINK) == FALSE)||(Ocm_Timer_IsOverFlow(&ulLastTime,SECOND_1)))
            {
                Ocm_Timer_UpdLocalTime(&ulLastTime); 
                ucStage++;
            }
            else
            {
                ;
            }
            break;
        case 0x03:
            if(Ocm_Timer_IsOverFlow(&ulLastTime,MS_100))
            {
                ucStage = 0x00;
                DISCADAPTER_GPIO_CTRL(LOW);
                UCCStatus.ucFRSwaping = FRSWAP_NULL;
            }
            break;
        default :
            ucStage = 0x00;
            break;
    }
}
