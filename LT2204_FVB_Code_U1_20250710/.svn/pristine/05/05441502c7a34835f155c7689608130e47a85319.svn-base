void Mod_HdmiTx_StateJudge(void)
{
    u8 IDATA ucAudioMute = 0x00;
    u8 ucMinState     = 0xff;
	#if HDMITX_HDCP_ENC_MODE != NO_HDCP
	u8 ucHdcpRxVerTmp;
	static u32 ulCurrentTime = 0x00;
	#endif
    //monitor upstream device stable.
    if(g_stHdmiTx.ucTxState > STATE_HDMITX_UPSTREAM_DEVICE_READY_2)
    {
        if(g_stHdmiTx.b1UpstreamDeviceReady == FALSE)
        {      
            Mod_HdmiTx_HpdLowAction();
            Mod_HdmiTx_MsgNotify(HDMITX_SINK_UNPLUG_EVENT);
            ucMinState = MIN(ucMinState,STATE_HDMITX_UPSTREAM_DEVICE_READY_2);
        }
    }

    //monitor upstream video stable.
    if(g_stHdmiTx.ucTxState > STATE_HDMITX_UPSTREAM_VIDEO_READY_4)
    {
        if(g_stHdmiTx.b1UpstreamVideoReady == FALSE)
        {
            Mod_HdmiTx_HpdLowAction();
            ucMinState = MIN(ucMinState,STATE_HDMITX_UPSTREAM_VIDEO_READY_4);
        }
    }

    //monitor frl update status
    if (g_stHdmiTx.ucTxState > STATE_HDMITX_FRL_TRAINING_6)
    {
        if (Drv_HdmiTx_FrlUpdateChg() == TRUE)
        {
            printLT(PRINT_PRIO_TEST, "\nHdmi tx frl update");
            ucMinState = MIN(ucMinState,STATE_HDMITX_FRL_TRAINING_6);
        }
    }
    #if HDMITX_VRR_SUPPORT == ENABLED
    if((g_stHdmiTx.ucTxState > STATE_HDMITX_VIDEO_OUT_7)&&(ucMinState >STATE_HDMITX_VIDEO_OUT_7))      
    {
        //monitor dobly hdr flag
        if(g_stHdmiTx.b1SrcVrrChg == TRUE)
        {
            g_stHdmiTx.b1SrcVrrChg = FALSE;
            Mod_DpRx_FrameRate_Get(&stRxTimingInfo);
            Drv_DpRx_RxTimingGet(&stRxTimingInfo);
            Drv_HdmiTx_VrrSet(g_stHdmiTx.b1SrcVrrEn,&stRxTimingInfo);
        }
    }
//    #if DPRX_ADAPTIVE_SYNC_WITHOUT_SDP == ENABLED
//    Drv_HdmiTx_VrrEnable();
//    #endif
    #endif

    #if 0
    if(g_stHdmiTx.ucTxState > STATE_HDMITX_HDCP_ENABLE_9)
    {
        TEST_16B18B_ERROR_READ();
    }
    #endif

    if(g_stHdmiTx.ucTxState > STATE_HDMITX_VIDEO_OUT_7)
    {
        //monitor dobly hdr flag
        if((g_stHdmiTx.b1SrcDoblyHdrChg == TRUE)&&(g_stHdmiTx.b1SrcDoblyHdrEn  == ENABLED))
        {
            g_stHdmiTx.b1SrcDoblyHdrChg = FALSE;
            Drv_HdmiTx_VicUD0Set(DISABLED);//for changhong TV issue, 杜比和VSIF包不能同时发，否则会造成花屏
            Drv_HdmiTx_DoblyHdrEnable();
        }
        //monitor static hdr flag
        if((g_stHdmiTx.b1SrcStaticHdrChg == TRUE)&&(g_stHdmiTx.b1SrcStaticHdrEn  == ENABLED))
        {
            g_stHdmiTx.b1SrcStaticHdrChg = FALSE;
            Drv_HdmiTx_StaticHdrEnable();
        }
        //monitor dynamic hdr flag
        if((g_stHdmiTx.b1SrcDynamicHdrChg == TRUE)&&(g_stHdmiTx.b1SrcDynamicHdrEn  == ENABLED))
        {
            g_stHdmiTx.b1SrcDynamicHdrChg = FALSE;
            Drv_HdmiTx_DymicHdrEnable();
        }
	    ucAudioMute = Drv_Audio_StatusCheck();
	    if (ucAudioMute == ENABLED)
	    {
            #if REMOVE_UART == DISABLED
            printLT(PRINT_PRIO_HIG, "\nAudio Mute");
            #endif
	        Drv_Audio_OutEn(OFF);//audio mute enable
	    }
	    else if (ucAudioMute == DISABLED)
	    {
            #if REMOVE_UART == DISABLED
            printLT(PRINT_PRIO_HIG, "\nAudio Enable");
            #endif         
	        Drv_Audio_OutEn(ON);//audio mute disable     
	    }
	    else
	    {
			;
	    }
    }

    #if HDMITX_HDCP_ENC_MODE != NO_HDCP
    if(g_stHdmiTx.ucTxState > STATE_HDMITX_HDCP_ENABLE_9)
    {
		ucHdcpRxVerTmp = Drv_HdcpRx_VerGet();//to do add hdcp event
        if(g_stHdmiTx.ucHdcpRxVerRecord != ucHdcpRxVerTmp)
        {
            if(g_stHdmiTx.b1TxHdcpScanEn == ENABLED)
            {
                g_stHdmiTx.b1TxHdcpScanEn = DISABLED;
                Ocm_Timer_UpdLocalTime(&ulCurrentTime);
            }	
            if(Ocm_Timer_IsOverFlow(&ulCurrentTime,SECOND_3) == TRUE)
            {
                g_stHdmiTx.ucHdcpRxVerRecord = ucHdcpRxVerTmp;
                Drv_HdcpTx_Enable(ucHdcpRxVerTmp);
                #if REMOVE_UART == DISABLED
                printLT(PRINT_PRIO_HIG,"\nHDCP = 0x%02bx",ucHdcpRxVerTmp);//need update 
                #endif

            }
        }
        else
        {		
            g_stHdmiTx.b1TxHdcpScanEn = ENABLED;
        }
    }
	else
	{
		g_stHdmiTx.b1TxHdcpScanEn = ENABLED;
	}
    #endif

    if(g_stHdmiTx.ucTxState >= STATE_HDMITX_VIDEO_OUT_7)
    {
        if(g_stHdmiTx.b1AudioInfoChg == TRUE)
        {
            g_stHdmiTx.b1AudioInfoChg = FALSE;
            Drv_HdmiTx_AudioInfoSet(g_stHdmiTx);
            printLT(PRINT_PRIO_TEST, "\nAudio on");
        }
    }

    if (ucMinState != 0xff)
    {
        Mod_HdmiTx_SetState(ucMinState); 
    }
}


void Mod_HdmiTx_StateHandler(void)
{
    #if HDMITX_MAX_FRL_RATE != FRL_NOT_SPT
    u8 ucTrainResult;
    #endif
    u8 ucEdidValidGet;
    static u32 ulCurrentTime = 0;

    switch(g_stHdmiTx.ucTxState)
    {
        case STATE_HDMITX_POWER_ON_1:
            Drv_HmdiTx_PowerOnInit();
            Mod_HdmiTx_SetState(STATE_HDMITX_UPSTREAM_DEVICE_READY_2);
            break;

        case STATE_HDMITX_UPSTREAM_DEVICE_READY_2:
            if(g_stHdmiTx.b1UpstreamDeviceReady == TRUE) //Typec Rx CC is done or dp is ok
            {
                Mod_HdmiTx_SetState(STATE_HDMITX_WAIT_HPD_3);
            }
            break;

        case STATE_HDMITX_WAIT_HPD_3:
            if((g_stHdmiTx.b1TxStateChanged == TRUE)&&(g_stHdmiTx.b1IsTxHpdDet == HIGH))//hdmi hpd is high.
            {  
                Mod_HmdiTx_EdidRead(szEdidData,ENABLED);
                g_stHdmiTx.b1TxStateChanged = FALSE;
                Drv_HdmiTx_DdcMstRst();
                Ocm_Timer_UpdLocalTime(&ulCurrentTime);
            }
            if(g_stHdmiTx.b1IsTxHpdDet == HIGH)
            {
                if(Ocm_Timer_IsOverFlow(&ulCurrentTime, MS_100) == TRUE)
                {
                    ucEdidValidGet = Mod_HmdiTx_EdidRead(szEdidData,DISABLED);
                    if(ucEdidValidGet == HEADERERROR)
                    {
                        Mod_HdmiTx_MsgNotify(HDMITX_EDID_INVALID_EVENT);
                        printLT(PRINT_PRIO_HIG,"\nEDIDHeader");  
                        Mod_HdmiTx_SetState(STATE_HDMITX_UPSTREAM_VIDEO_READY_4);
                    }
                    else if(ucEdidValidGet == EDIDWAIT)
                    {
                        printLT(PRINT_PRIO_HIG,"\nEDIDWait===========================================");
                        Ocm_Timer_UpdLocalTime(&ulCurrentTime);
                    }
                    else
                    {
                        if(ucEdidValidGet == CHECKSUMERROR)
                        {
                            printLT(PRINT_PRIO_TEST, "\nEDIDSumerr");
                        }
                        else
                        {
                            printLT(PRINT_PRIO_TEST, "\nEdid Valid");
                        }
                        Mod_HdmiTx_MsgNotify(HDMITX_EDID_VALID_EVENT);
                        Mod_HdmiTx_SetState(STATE_HDMITX_UPSTREAM_VIDEO_READY_4);
                    }                   
                    
                }
            }
			else
            {
                Ocm_Timer_UpdLocalTime(&ulCurrentTime);
            }
            break;

        case STATE_HDMITX_UPSTREAM_VIDEO_READY_4:
            if(g_stHdmiTx.b1UpstreamVideoReady == TRUE)
            {
                printLT(PRINT_PRIO_TEST, "\nUpstream video is ready");
                #if HDMITX_DSC_ENC_SUPPORT == ENABLED
                Drv_HdmiTxDscEnc_Init();
                #endif
                #if HDMITX_DSC_BYPASS_SUPPORT == ENABLED
                Drv_HdmiTxDscBy_Init();
                #endif
                Drv_Sys_EncPowerDomain(TRUE);
                Mod_HdmiTx_VarInit();
                Mod_HdmiTx_HdmiVersionCal();// need for sel hdmi2.1 mode.
                if(g_stHdmiTx.ucHdmiVersion == HDMI21)
                {
                    Drv_Sys_DhTxSrcSel(DHTX_SRC_SEL_HDMI21TX);
                }
                else
                {
                    Drv_Sys_DhTxSrcSel(DHTX_SRC_SEL_HDMI20TX);
                }
                Mod_HdmiTx_SetState(STATE_HDMITX_DSCENC_CONFIG_5);
            }
            break;

        case STATE_HDMITX_DSCENC_CONFIG_5:
            #if HDMITX_DSC_ENC_SUPPORT == ENABLED
            if (g_stHdmiTx.b1EncodeEn == ENABLED)
            {
                Drv_Sys_EncPowerDomain(FALSE);
                Drv_HdmiTxDscEnc_ParaInit();
                Drv_HdmiTxDscEnc_InfoGet();
                Drv_HdmiTxDscEnc_ModuleEnable();
                g_stHdmiTx.ucColorDepth      = DEEP_8BIT;//force to RGB 8bpc
                g_stHdmiTx.ucTxPixelEncoding = RGB_0; 
            }
            #endif
            #if HDMITX_DSC_BYPASS_SUPPORT == ENABLED
            if (g_stHdmiTx.b1SrcDscByEn == ENABLED)
            {
                Drv_HdmiTxDscBy_PktSet();
                g_stHdmiTx.ucColorDepth      = DEEP_8BIT;//force to RGB 8bpc
                g_stHdmiTx.ucTxPixelEncoding = RGB_0; 
            }
            #endif
            Mod_HdmiTx_SetState(STATE_HDMITX_FRL_TRAINING_6);
            break;

        case STATE_HDMITX_FRL_TRAINING_6:
            #if HDMITX_MAX_FRL_RATE != FRL_NOT_SPT 
            if(g_stHdmiTx.b1TxStateChanged == TRUE)
            {
                Drv_HdmiTx_Reset(HDMI_TX_20DC_RST,ENABLED);
                Drv_HdmiTx_Reset(HDMI_TX_20DC_RST,DISABLED);
                Mod_FrlTx_ParamInit();
                g_stFrlTxInfo.ucFrlState = FRL_TRAIN_INIT_1;
                g_stHdmiTx.b1TxStateChanged = FALSE;
                
            }
            #if RX_PORT_SIGN == DP_PORT
			//CTS use
            if(((g_stHdmiEdidInfo.b1Yuv420Edid)==0x00)&&(g_stDpRx.ucPixelEncoding == YCbCr420_3))
            {
                return;
            }
            #endif
            ucTrainResult = Mod_FrlTx_TrainingHdl();
            if (ucTrainResult == TRAINING_SUCCESS)
            {
                Mod_HdmiTx_SetState(STATE_HDMITX_VIDEO_OUT_7);
            }
            else if (ucTrainResult == FAIL)
            #endif
            {
                Mod_HdmiTx_SetState(STATE_HDMITX_VIDEO_OUT_7);
            }
            break;
        case STATE_HDMITX_VIDEO_OUT_7://only for hdmi1.4 or hdmi2.0
			if(g_stHdmiTx.b1TxStateChanged == TRUE)
            {
                Ocm_Timer_UpdLocalTime(&ulCurrentTime);
                Drv_Audio_AcrLogicRst();//in case of audio stable first,then reset acr logic
                g_stHdmiTx.b1TxStateChanged = FALSE;
            }
            #if HDMITX_CTS_SUPPORT == ENABLED		
			if((Drv_HdmiTx_HpdDet() == LOW)||(Drv_HdmiTx_ResenState() == LOW)) //hdmi hpd is low
			{
				Ocm_Timer_UpdLocalTime(&ulCurrentTime);
			}							
            #endif
			if(Ocm_Timer_IsOverFlow(&ulCurrentTime, MS_20) == TRUE)
			{
				Drv_HdmiTx_AviInfoSet(g_stHdmiTx);
				Mod_HdmiTx_GcpInfoSet();
                if (g_stHdmiTx.ucHdmiVersion != HDMI21)//fix 
                {
                    printLT(PRINT_PRIO_TEST, "\nHD20 DCRST");
                    Drv_HdmiTx_Reset(HDMI_TX_20DC_RST,ENABLED);
                    Drv_HdmiTx_Reset(HDMI_TX_20DC_RST,DISABLED);
                }
				Drv_HdmiTx_TmdsVideoOn();
				#if SPD_SUPPORT  == ENABLED
				Drv_HdmiTx_SpdInfoSet();
				#endif
				Mod_HdmiTx_SetState(STATE_HDMITX_AUDIO_OUT_8);
			}       
            break;

        case STATE_HDMITX_AUDIO_OUT_8:
            if(g_stHdmiTx.b1TxStateChanged == TRUE)
            {
                Ocm_Timer_UpdLocalTime(&ulCurrentTime);
                g_stHdmiTx.b1TxStateChanged = FALSE;
            }
            if(Ocm_Timer_IsOverFlow(&ulCurrentTime, MS_100) == TRUE)
            {           
                Drv_Audio_HdmiNctsValueSet(Mod_FrlTx_Hdmi21EnGet());
                Mod_HdmiTx_SetState(STATE_HDMITX_HDCP_ENABLE_9);
            }
            break;

        case STATE_HDMITX_HDCP_ENABLE_9: 
            if(g_stHdmiTx.b1TxStateChanged == TRUE)
            {
                Ocm_Timer_UpdLocalTime(&ulCurrentTime);
                g_stHdmiTx.b1TxStateChanged = FALSE;
            }
            if(Ocm_Timer_IsOverFlow(&ulCurrentTime, MS_500) == TRUE)
            {
                g_stHdmiTx.b1TxHdcpScanEn = ENABLED;
			//8k30 10bit FRL10G , HDMITX Map Error
				if(Drv_HdmiTx_FrlJitGet() >= 0xFFE)
				{
					Drv_HdmiTx_Reset(HDMI_TX_21PKT_RST,ENABLED);
                    Drv_HdmiTx_Reset(HDMI_TX_21PKT_RST,DISABLED);
					printLT(PRINT_PRIO_TEST, "\nFRLTX JIT Reset");
				}
				g_stHdmiTx.ucHdcpRxVerRecord = NO_HDCP;
                Mod_HdmiTx_SetState(STATE_HDMITX_PLAY_BACK_10);
            }
            break;
            
        case STATE_HDMITX_PLAY_BACK_10:
            break;

        default:  
            break;
    }
}

void Mod_HdmiTx_Handler(void)
{
    Mod_HdmiTx_HpdDetProc();
    Mod_HdmiTx_StateJudge();
    Mod_HdmiTx_StateHandler();
}

#if HDMITX_VID_PATTERN_SEL != NO_PATTERN
void Mod_HdmiTx_Pattern(void)
{
    Drv_System_VidPatternSet();
    #if HDMITX_AUD_PATTERN_SEL != NO_PATTERN
    Drv_System_AudioPatternSet();
    #endif
    //============hdmi tx stub function set================
    memset(&g_stHdmiTx, 0, sizeof(HdmiTx_S));
    g_stHdmiTx.ucTxState = STATE_HDMITX_POWER_ON_1;
    g_stHdmiTx.b1UpstreamDeviceReady = TRUE;
    g_stHdmiTx.b1UpstreamVideoReady  = TRUE; //rx video rdy
    g_stHdmiTx.ucHdmiVersion     = HDMITX_VID_PATTERN_MODE;
//    g_stHdmiTx.ucHdcpRxVerChg    = TRUE;
//    g_stHdmiTx.ucHdcpRxVersion   = NO_HDCP;
    g_stHdmiTx.b1AudioInfoChg    = FALSE;//
    g_stHdmiTx.ucTxPixelEncoding = RGB_0;
    g_stHdmiTx.ucColorDepth      = DEEP_8BIT;

    g_stHdmiEdidInfo.ucMaxFrlDscRate = HDMITX_MAX_FRL_RATE;
    g_stHdmiEdidInfo.ucMaxFrlRate    = HDMITX_MAX_FRL_RATE;
    g_stHdmiTx.b1AudioInfoChg  = FALSE;//-wangtt- wait confirm
    #if HDMITX_AUD_PATTERN_SEL != NO_PATTERN
    g_stHdmiTx.b1AudioInfoChg  = TRUE;//-wangtt- wait confirm
    g_stHdmiTx.ucChannel = 0x01;
    g_stHdmiTx.szAudioInfo[0] = 0x84;//hb1
    g_stHdmiTx.szAudioInfo[1] = 0x01;//hb2
    g_stHdmiTx.szAudioInfo[2] = 0x0a;//hb3
    g_stHdmiTx.szAudioInfo[3] = 0x70;//checksum
    g_stHdmiTx.szAudioInfo[4] = 0x01;//pb0
    g_stHdmiTx.szAudioInfo[5] = 0x00;//pb1
    g_stHdmiTx.szAudioInfo[6] = 0x00;//pb2
    g_stHdmiTx.szAudioInfo[7] = 0x00;//pb3
    g_stHdmiTx.szAudioInfo[8] = 0x00;//pb4
    #endif

    Drv_System_FmSet(TOP_FM,TOPFM_PCRPLL_PCR_CLK);
    Ocm_Delay1ms(10);
    g_stHdmiTx.ulTxPixelClk  = Drv_System_FmGet(TOP_FM,HALF_PIX_CLK);
    g_stHdmiTx.ulTxPixelClk<<= 1;
    g_stHdmiTx.ulTxTmdsClk   = g_stHdmiTx.ulTxPixelClk ;
    g_stHdmiTx.ucszAviPkt[0] = 0x00;//rgb
    g_stHdmiTx.ucszAviPkt[1] = 0xe8;//rgb
    g_stHdmiTx.ucszAviPkt[2] = 0x44;//rgb
    g_stHdmiTx.ucszAviPkt[3] = 0x00;//rgb
    g_stHdmiTx.ucszAviPkt[4] = 0x00;//rgb
    
    #if HDMITX_VID_PATTERN_SEL == PTN480P
    g_stHdmiTx.ucszAviPkt[3] = 1;//rgb
    #elif HDMITX_VID_PATTERN_SEL == PTN720P
    g_stHdmiTx.ucszAviPkt[3] = 4;//rgb
    #elif HDMITX_VID_PATTERN_SEL == PTN1080P
    g_stHdmiTx.ucszAviPkt[3] = 16;//rgb
    #elif HDMITX_VID_PATTERN_SEL == PTN4K30
    g_stHdmiTx.ucszAviPkt[3] = 95;//rgb
    #elif HDMITX_VID_PATTERN_SEL == PTN4K60
    g_stHdmiTx.ucszAviPkt[3] = 97;//rgb
    #elif HDMITX_VID_PATTERN_SEL == PTN4K120
    g_stHdmiTx.ucszAviPkt[3] = 120;//rgb
    #elif HDMITX_VID_PATTERN_SEL == PTN8K30
    g_stHdmiTx.ucszAviPkt[3] = 196;//rgb
    #else
    
    #endif
    //============hdmi tx stub function set================
    while(1)
    {
        if(g_stHdmiTx.ucHdmiVersion != HDMI21)
        {
             g_stHdmiEdidInfo.ucMaxFrlRate = 0;
        }
        #if HDMITX_DSC_ENC_SUPPORT == ENABLED
        g_stHdmiTx.b1EncodeEn = TRUE ;
        #endif
        
        #if HDMITX_AUD_PATTERN_SEL != NO_PATTERN
        BKC6_2E_REG  = 0x03;// BIT7 DP ptn en, sel dp audio ptn
        BKC6_37_REG |= BIT0_1;  //rgd-aud-ptn-sel
        BKC9_20_REG |= BIT4_1;  //PTN_SEL CLOCK SEL
        BKED_10_REG = 0x14;     //DPTX fs64 clock source select
        if(g_stHdmiTx.ucHdmiVersion != HDMI21)
        {
            BKED_11_REG = 0x00;     //DPTX audio mux clock source select
            BKEB_11_REG = 0xd9;//N/CTS
        }
        else
        {
            BKEB_11_REG = 0x02;//N/CTS
            BKEB_11_REG = 0xda;//N/CTS
        }
        #endif
        Mod_HdmiTx_Handler();
    }
}
#endif
#endif
