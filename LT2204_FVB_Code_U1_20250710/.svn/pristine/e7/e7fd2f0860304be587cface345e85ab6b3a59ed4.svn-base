//=========================================MATRIX=========================================

void Drv_DpTxDscEnc_ParaInit(void)
{
    memset(&g_stDscEncTiming, 0, sizeof(LtTiming_S));
    memset(&g_stDscEncInfo, 0, sizeof(StructDscEncInfo));
}

void Drv_DpTxDscEnc_ColorInfoGet(void)
{
    //hdmi rx color space get
    #if RX_PORT_SIGN == HDMI_PORT
    ColorInfo_S stInfo;

    Drv_HdmiRx_ColorInfoGet(&stInfo);
    #if HDMIRX_DSC_DEC_SUPPORT == ENABLED
    if (Drv_HdmiRxDscDec_SwitchGet() == ENABLED)
    {
        Drv_HdmiRxDscDec_ColorInfoGet(&stInfo);
    }
    #endif
    #if HDMIRX_DSC_BYPASS_SUPPORT == ENABLED
    if (Drv_HdmiRxDscBy_SwitchGet() == ENABLED)
    {
        Drv_HdmiRxDscBy_ColorInfoGet(&stInfo);
    }
    #endif
    g_stDscEncInfo.ucColorSpace = stInfo.ucPixelEncoding;//Input Color space
    g_stDscEncInfo.ucColorDepth = stInfo.ucBitDepth;     //8 bit = 0x04

    g_stDscEncInfo.b1Simple422En = DISABLED;
    if(g_stDscEncInfo.ucColorSpace == YCbCr422_1)
    {
        g_stDscEncInfo.ucColorDepth = BPC8;
        if(((g_stAuxDpTx.ucDscColorFormat&0x0c) == 0x00)||((g_stAuxDpTx.ucDscColorFormat&0x0c) == 0x04))
        {
            Drv_CscRx_Set(Y422_TO_Y444_8);
            g_stDscEncInfo.b1Simple422En = ENABLED;
            g_stDscEncInfo.ucColorSpace  = YCbCr444_2;
            g_stHdmiRx.b1CscRxEnable     = ENABLED;
        }
    }
    if (g_stDscEncInfo.ucColorDepth == 0x00)
    {
        g_stDscEncInfo.ucColorDepth = BPC8;
    }
    #endif

    //dp rx color space get
    #if RX_PORT_SIGN == DP_PORT
    ColorInfo_S stInfo;

    Drv_DpRx_VidColorInfoGet(&stInfo);
    #if DPRX_DSC_DEC_SUPPORT == ENABLED
    if (Drv_DpRxDscDec_SwitchGet() == ENABLED)
    {
        Drv_DpRxDscDec_ColorInfoGet(&stInfo);
    }
    #endif
    #if DPRX_DSC_BYPASS_SUPPORT == ENABLED
    if (Drv_DpRxDscBy_SwitchGet() == ENABLED)
    {
        Drv_DpRxDscBy_ColorInfoGet(&stInfo);
    }
    #endif
    g_stDscEncInfo.ucColorSpace = stInfo.ucPixelEncoding;//Input Color space
    g_stDscEncInfo.ucColorDepth = stInfo.ucBitDepth + 3; //+3: 4-8bit

    g_stDscEncInfo.b1Simple422En = DISABLED;
    if(g_stDscEncInfo.ucColorSpace == YCbCr422_1)
    {
        if(((g_stAuxDpTx.ucDscColorFormat&0x0c) == 0x00)||((g_stAuxDpTx.ucDscColorFormat&0x0c) == 0x04))
        {
            Drv_CscRx_Set(Y422_TO_Y444_8);
            g_stDscEncInfo.b1Simple422En = ENABLED;
            g_stDscEncInfo.ucColorSpace  = YCbCr444_2;
            g_stDpRx.b1CscRxEnable       = ENABLED;
        }
    }
    if (g_stDscEncInfo.ucColorDepth == 0x00)
    {
        g_stDscEncInfo.ucColorDepth = BPC8;
    }
    #endif
}

void Drv_DpTxDscEnc_TimingGet(void)
{
    memcpy(&g_stDscEncTiming,&g_stDpTxTiming,sizeof(LtTiming_S));
    if (g_stDscEncInfo.ucColorSpace == YCbCr420_3)
    {
        g_stDscEncTiming.usHbp >>= 1;
        g_stDscEncTiming.usHfp >>= 1;
        g_stDscEncTiming.usHsync >>= 1;
        g_stDscEncTiming.usHtol >>= 1;
        g_stDscEncTiming.usHact >>= 1;
    }

    #if 1
    printLT(PRINT_PRIO_TEST, "\n==============DscEnc Info==============");
    printLT(PRINT_PRIO_TEST, "\nHbp   : %-4d  Vbp   : %-4d", g_stDscEncTiming.usHbp,g_stDscEncTiming.usVbp);
    printLT(PRINT_PRIO_TEST, "\nHfp   : %-4d  Vfp   : %-4d", g_stDscEncTiming.usHfp,g_stDscEncTiming.usVfp);
    printLT(PRINT_PRIO_TEST, "\nHsync : %-4d  Vsync : %-4d", g_stDscEncTiming.usHsync,g_stDscEncTiming.usVsync);
    printLT(PRINT_PRIO_TEST, "\nHact  : %-4d  Vact  : %-4d", g_stDscEncTiming.usHact,g_stDscEncTiming.usVact);
    printLT(PRINT_PRIO_TEST, "\nHtol  : %-4d  Vtol  : %-4d", g_stDscEncTiming.usHtol,g_stDscEncTiming.usVtol);
    #endif
}

void Drv_DpTxDscEnc_RxDscInfoGet(void)
{
    u8 ucRxBuff[9];
    u16 usTemp;
    u8 SliceNumTemp;
    
    //cal the slice num by hactive and pixel clk
    //dsc slice num and dsc num get
    usTemp = g_stDscEncTiming.usHact;
    if (g_stDscEncInfo.ucColorSpace == YCbCr420_3)
    {
        usTemp <<= 1;//recover to real timing
    }
    if (usTemp < 1200)//1500
    {
        g_stDscEncInfo.ucSliceNum = 1;
    }
    else if (usTemp < 2400)//
    {
        g_stDscEncInfo.ucSliceNum = 2;
    }
    else if (usTemp < 4800)//2600
    {
        g_stDscEncInfo.ucSliceNum = 4;
    }
    else
    {
        g_stDscEncInfo.ucSliceNum = 8;
    }

    if(g_stDpTx.ulTxPixelClk < 300000)
    {
        g_stDscEncInfo.ucSliceNum = max(g_stDscEncInfo.ucSliceNum,1);
    }
    else if(g_stDpTx.ulTxPixelClk < 600000)
    {
        g_stDscEncInfo.ucSliceNum = max(g_stDscEncInfo.ucSliceNum,2);
    }
    else if(g_stDpTx.ulTxPixelClk < 1200000)
    {
        g_stDscEncInfo.ucSliceNum = max(g_stDscEncInfo.ucSliceNum,4);
    }
    else
    {
        g_stDscEncInfo.ucSliceNum = max(g_stDscEncInfo.ucSliceNum,8);
    }
    if (g_stDscEncInfo.ucSliceNum > DPTX_DSC_MAX_SLICE_NUM)
    {
        g_stDscEncInfo.ucSliceNum = DPTX_DSC_MAX_SLICE_NUM;
    }
    g_stDscEncInfo.ucCoreNum = g_stDscEncInfo.ucSliceNum;

    Mod_DpTxLink_DpcdRead(0x00, 0x0060, ucRxBuff, 9);
    g_stDscEncInfo.ucMainVer     = (ucRxBuff[1] & 0x0f) <<4;
    g_stDscEncInfo.ucMinorVer    = (ucRxBuff[1] & 0xf0)>>4;
    g_stDscEncInfo.ucBlockPredEn = ucRxBuff[6] & BIT0_1;

    SliceNumTemp = ucRxBuff[4] & 0x3f;//dpcd-00064, dsc slice cap
    if(SliceNumTemp & BIT5_1)//[5]1-8slice cap, 0-not support
    {
        SliceNumTemp = 8;
    }
    else if(SliceNumTemp & BIT3_1)//[3]1-4slice cap, 0-not support
    {
        SliceNumTemp = 4;
    }
    else if(SliceNumTemp & BIT1_1)//[1]1-2slice cap, 0-not support
    {
        SliceNumTemp = 2;
    }
    else if (SliceNumTemp & BIT0_1)//[0]1-1slice cap, 0-not support
    {
        SliceNumTemp = 1;
    }
    printLT(PRINT_PRIO_TEST, "\n Tx slic cap :%-2bd Dp Sink slic cap = %-2bd",g_stDscEncInfo.ucSliceNum, SliceNumTemp);
    if (g_stDscEncInfo.ucSliceNum > SliceNumTemp)
    {
        g_stDscEncInfo.ucSliceNum = SliceNumTemp;
        printLT(PRINT_PRIO_TEST, "\nDp Tx slic cap not available");
    }
    g_stDscEncInfo.ucCoreNum = g_stDscEncInfo.ucSliceNum;
    g_stDscEncInfo.usBpp = DPTX_DSC_OUT_BPP;
    if ((g_stDscEncInfo.ucColorSpace == YCbCr420_3) || (g_stDscEncInfo.ucColorSpace == YCbCr422_1))
    {
        g_stDscEncInfo.usBpp <<= 1;
    }

    g_stDscEncInfo.usInitDelay = ceil((double)65536 / g_stDscEncInfo.usBpp);
    g_stDscEncInfo.usInitOffset = 0x800;
    if ((g_stDscEncInfo.ucColorSpace == RGB_0) || (g_stDscEncInfo.ucColorSpace == YCbCr444_2))
    {
        if (g_stDscEncInfo.usBpp < 0xa0)
        {
            g_stDscEncInfo.usInitOffset = 0x1800;
        }
        else if (g_stDscEncInfo.usBpp < 0xc0)
        {
            g_stDscEncInfo.usInitOffset = 0x1600;
        }
    }

    #if 1
    printLT(PRINT_PRIO_TEST, "\nColorSpace   : %-2bd  ColorDepth   : %-2bd", g_stDscEncInfo.ucColorSpace, g_stDscEncInfo.ucColorDepth << 1);
    printLT(PRINT_PRIO_TEST, "\nSliceNumber  : %-2bd  DscNumber    : %-2bd", g_stDscEncInfo.ucSliceNum,g_stDscEncInfo.ucCoreNum);
    printLT(PRINT_PRIO_TEST, "\nBlockPredic  : %-2bd  MaxSupportBpp: 0x%04x",g_stDscEncInfo.ucBlockPredEn,g_stDscEncInfo.usBpp);
    printLT(PRINT_PRIO_TEST, "\n=======================================");
    #endif
}

void Drv_DpTxDscEnc_DscInit(void)//before training
{
    u8 ucTxBuff;
    //dpcd dsc disable
    ucTxBuff = 0x00;
    Mod_DpTxLink_DpcdWrite(0x00,0x0160,&ucTxBuff,1);
}

void Drv_DpTxDscEnc_DataMux(void)
{
    //pps path set
    BKED_30_REG |= BIT4_1;//[4]dhtx src sel: 1-encoder, 0-rx
    Drv_System_SramPathSet(DPTX_DSCENC_PPS_PATH);
}

void Drv_DpTxDscEnc_ClkMux(void)
{
    u8 ucDiv;
    u8 ucRatio;
    u16 usRatio;
    u32 ulTempClk;

    BKE1_40_REG |= BIT0_1;//[0]rgd_pps_data_wr_clk_src_sel: 1-sys clk
    BKE1_41_REG &= BIT0_0;//[0]rgd_dptx_rx_pix_clk_src_sel: 0-ad_cscrx_half_pix_clk

    //default
    BKA3_3E_REG &= 0xf0;//[3:0]rg_clkgen_dscout_divsel
    BKA3_41_REG &= 0xf0;//[3:0]rg_clkgen_dsctx_dsc_divsel
    BKA3_42_REG &= 0xf0;//[3:0]rg_clkgen_dsctx_dscrd_divsel
    BKA3_42_REG |= 0x01;////0001-div2 recover to default clk

    //caculate ad_dsctx_dsc_out_clk div
    //3 * 8bpc * 16 * 10
    if ((g_stDscEncInfo.ucColorSpace == YCbCr422_1) || (g_stDscEncInfo.ucColorSpace == YCbCr420_3))
    {
        usRatio = 0x1e00;//3 * 8bpc * 16(for bpp) * 10 * 2
    }
    else
    {
        usRatio = 0xf00;//3 * 8bpc * 16 * 10
    }
    ucRatio = (u8)(usRatio / g_stDscEncInfo.usBpp);
    if (ucRatio >= 30)
    {
        ucRatio = 5;//div3
    }
    else if (ucRatio >= 25)
    {
        ucRatio = 4;//div2.5
    }
    else if (ucRatio >= 20)
    {
        ucRatio = 3;//div2
    }
    else if (ucRatio >= 15)
    {
        ucRatio = 2;//div1.5
    }
    else
    {
        ucRatio = 1;//div1
    }
    if (g_stDscEncInfo.ucColorSpace == YCbCr420_3)
    {
        ucRatio = (ucRatio - 1) / 2;
        if (ucRatio == 0)
        {
            ucRatio = 1;
        }
    }
    ucDiv = 2 * (g_stDscEncTiming.usHtol - g_stDscEncTiming.usHact) / (ucRatio + 1);
    if (ucDiv < 80)
    {
        ucRatio -= 1;
    }
    BKA3_3E_REG |= ucRatio;

    //Ad_dsctx_dsc_clk set
    ucDiv = g_stDscEncInfo.ucCoreNum;
    if (g_stDscEncInfo.ucColorSpace == YCbCr422_1)
    {
        ucDiv *= 2;
    }
    if (ucDiv == 1)
    {
        BKA3_41_REG |= 0x02;//0010-div3
    }
    else
    {
        ucDiv = 0x08 | (ucDiv - 1);
        BKA3_41_REG |= ucDiv;
    }

    Drv_System_FmSet(TOP_FM,TOPFM_AD_DSCTX_DSC_CLK);
    Ocm_Delay1ms(10);
    ulTempClk = Drv_System_FmGet(TOP_FM, HALF_PIX_CLK);
    printf("\n==%ld==",ulTempClk);
    if ((ulTempClk < 60000) && ((g_stDscEncTiming.usHtol - g_stDscEncTiming.usHact) < 100))
    {
        //Ad_dsctx_dsc_clk set
        ucDiv = g_stDscEncInfo.ucCoreNum >> 1;
        ucDiv = 0x08 | (ucDiv - 1);
        BKA3_41_REG &= 0xf0;//[3:0]rg_clkgen_dsctx_dsc_divsel
        BKA3_41_REG |= ucDiv;
    }

//    BKE1_0E_REG &= BIT3_0;
//    BKE1_0E_REG |= BIT3_1;
}

void Drv_DpTxDscEnc_RxParamSet(void)
{
    #if RX_PORT_SIGN == DP_PORT
    BKEA_18_REG |= BIT0_1;//[0]rgd_pps_dp_in: 1-dp in, 0-hdmi in
    #endif

    #if RX_PORT_SIGN == HDMI_PORT
    BKEA_18_REG &= BIT0_0;//[0]rgd_pps_dp_in: 1-dp in, 0-hdmi in
    #endif
}

void Drv_DpTxDscEnc_WordDelaySet(void)
{
    BKEF_87_REG = 0x01;//bkef_mux_word_delay[15:8]
    BKEF_88_REG = 0x60;//bkef_mux_word_delay[7:0]

    if (g_stDscEncInfo.ucSliceNum == 1)
    {
        BKEF_87_REG = 0x02;//bkef_mux_word_delay[15:8]
        BKEF_88_REG = 0x80;//bkef_mux_word_delay[7:0]
        if (g_stDscEncTiming.usHact > 3000)
        {
            BKEF_87_REG = 0x01;//bkef_mux_word_delay[15:8]
            BKEF_88_REG = 0xe0;//bkef_mux_word_delay[7:0]
        }
    }
    else
    {
        //dsc out clk is pix/2, than set word delay to this.
        if ((BKA3_3E_REG & 0x0f) == 0x01)
        {
            BKEF_87_REG = 0x01;//bkef_mux_word_delay[15:8]
            BKEF_88_REG = 0xa0;//bkef_mux_word_delay[7:0]
        }
    }
}

void Drv_DpTxDscEnc_ExtraHactSet(void)
{
    u8 ucRemainHact;

    //half pixel时钟域下的hact
    ucRemainHact = (u8)g_stDscEncTiming.usHact >> 1;
    if(g_stDscEncInfo.ucSliceNum == 1)
        ucRemainHact = 0;
    else if(g_stDscEncInfo.ucSliceNum == 2)
        ucRemainHact &= 0x01;
    else if(g_stDscEncInfo.ucSliceNum == 4)
        ucRemainHact &= 0x03;
    else if(g_stDscEncInfo.ucSliceNum == 8)
        ucRemainHact &= 0x07;

    if (ucRemainHact == 0)
        g_stDscEncInfo.ucExtraHact = 0x00;
    else
        g_stDscEncInfo.ucExtraHact = g_stDscEncInfo.ucSliceNum - ucRemainHact;

    BKEF_9F_REG &= 0xf3;//[3:2]The number of extend pixel
    BKEF_9F_REG |= ((g_stDscEncInfo.ucExtraHact << 2) & 0x0c);
    BKEF_9F_REG |= BIT4_1;//[4]extend pixel is black or the same as last pixel: 1-last pixel, 0-black pixel
    g_stDscEncInfo.ucExtraHact <<= 1;//换算成pixel时钟域下的hact

//    g_stDscEncTiming.usHact += g_stDscEncInfo.ucExtraHact;//pixel下的hact
}

void Drv_DpTxDscEnc_TimingSet(void)
{
    u8 ucDiv,ucTemp;
    u16 usTemp,usHfp,usHtol,usHact;

    BKEF_A3_REG = g_stDscEncTiming.usVsync & 0xff;
    BKEF_A6_REG = (g_stDscEncTiming.usVfp >> 8) & 0xff;
    BKEF_96_REG = g_stDscEncTiming.usVfp & 0xff;
    BKEF_90_REG = (g_stDscEncTiming.usVtol >> 8) & 0xff;
    BKEF_91_REG = g_stDscEncTiming.usVtol & 0xff;

    usHfp = g_stDscEncTiming.usHfp >> 1;
    usHtol = g_stDscEncTiming.usHtol >> 1;
    usHact = g_stDscEncTiming.usHact >> 1;

    //H video timing set
    ucTemp = (BKEF_9C_REG & 0x0f)? (11) : (10);
    ucDiv = (BKA3_3E_REG & 0x0f) + 1;
    if (g_stDscEncInfo.ucColorSpace == YCbCr420_3)
    {
        ucTemp = ucTemp * ucDiv;
    }
    else
    {
        ucTemp = ucTemp * ucDiv >> 1;
    }

    //solve that hblank is very small, so fixed parameter in all cases
    if (usHfp + ucTemp + 8 > (usHtol - usHact))
    {
        usTemp = usHtol - usHact - 8 - 3;
    }
    else
    {
        usTemp = usHfp + ucTemp;
    }

    BKEF_A0_REG = (usTemp >> 8) & 0xff;
    BKEF_A1_REG = usTemp & 0xff;
//    BKEF_A2_REG = usHsync & 0xff;
    BKEF_A2_REG = 0x08;
    BKEF_92_REG = (usHtol >> 8) & 0xFF;
    BKEF_93_REG = usHtol & 0xFF;
}

void Drv_DpTxDscEnc_MatrixSet(u8 *pstMatrix)
{
    //rc_range_parameters[0-14]
    BKEF_3A_REG = pstMatrix[0];
    BKEF_3B_REG = pstMatrix[1];
    BKEF_3C_REG = pstMatrix[2];
    BKEF_3D_REG = pstMatrix[3];
    BKEF_3E_REG = pstMatrix[4];
    BKEF_3F_REG = pstMatrix[5];
    BKEF_40_REG = pstMatrix[6];
    BKEF_41_REG = pstMatrix[7];
    BKEF_42_REG = pstMatrix[8];
    BKEF_43_REG = pstMatrix[9];
    BKEF_44_REG = pstMatrix[10];
    BKEF_45_REG = pstMatrix[11];
    BKEF_46_REG = pstMatrix[12];
    BKEF_47_REG = pstMatrix[13];
    BKEF_48_REG = pstMatrix[14];

    //rc_range_parameters[0-14]
    BKEF_49_REG = pstMatrix[15];
    BKEF_4A_REG = pstMatrix[16];
    BKEF_4B_REG = pstMatrix[17];
    BKEF_4C_REG = pstMatrix[18];
    BKEF_4D_REG = pstMatrix[19];
    BKEF_4E_REG = pstMatrix[20];
    BKEF_4F_REG = pstMatrix[21];
    BKEF_50_REG = pstMatrix[22];
    BKEF_51_REG = pstMatrix[23];
    BKEF_52_REG = pstMatrix[24];
    BKEF_53_REG = pstMatrix[25];
    BKEF_54_REG = pstMatrix[26];
    BKEF_55_REG = pstMatrix[27];
    BKEF_56_REG = pstMatrix[28];
    BKEF_57_REG = pstMatrix[29];

    BKEF_04_REG = (g_stDscEncInfo.usBpp >> 8) & 0x03;//[1:0]: bpp[9:8]
    BKEF_05_REG = g_stDscEncInfo.usBpp & 0xff;//[7:0]: bpp[7:0]

    BKEF_10_REG = g_stDscEncInfo.usInitDelay >> 8;//[1:0]: initial_xmit_delay[9:8]
    BKEF_11_REG = g_stDscEncInfo.usInitDelay & 0xff;//[7:0]: initial_xmit_delay[7:0]

    BKEF_20_REG = g_stDscEncInfo.usInitOffset >> 8;//[7:0]: initial_offset[15:8]
    BKEF_21_REG = g_stDscEncInfo.usInitOffset & 0xff;//[7:0]: initial_offset[7:0]

    if (g_stDscEncInfo.ucBlockPredEn)
        BKEF_04_REG |= BIT5_1;
    else
        BKEF_04_REG &= BIT5_0;
}

//目前的策略是, 如果bpp是小数，就按照该小数部分的整数
void Drv_DpTxDscEnc_MatrixCalculation(void)
{
    u8 ucBppInteger;
    u8 *pstCurrentMatrix = NULL;

    ucBppInteger = g_stDscEncInfo.usBpp >> 4;
    if ((g_stDscEncInfo.ucColorSpace == YCbCr422_1) || (g_stDscEncInfo.ucColorSpace == YCbCr420_3))
    {
        ucBppInteger >>= 1;
    }
    if (g_stDscEncInfo.ucColorSpace == YCbCr422_1)
    {
        ucBppInteger -= 7;
    }
    else if (g_stDscEncInfo.ucColorSpace == YCbCr420_3)
    {
        ucBppInteger -= 6;
    }
    else
    {
        ucBppInteger -= 8;
    }

    if ((g_stDscEncInfo.ucColorSpace == RGB_0) || (g_stDscEncInfo.ucColorSpace == YCbCr444_2))
    {
        if (g_stDscEncInfo.ucColorDepth == BPC8)
        {
            pstCurrentMatrix = MATRIX_RGB_8BPC_TO_NBPP[ucBppInteger];
        }
        else//10bpc
        {
            pstCurrentMatrix = MATRIX_RGB_10BPC_TO_NBPP[ucBppInteger];
        }
    }
    else if (g_stDscEncInfo.ucColorSpace == YCbCr422_1)
    {
        if (g_stDscEncInfo.ucColorDepth == BPC8)
        {
            pstCurrentMatrix = MATRIX_YUV422_8BPC_TO_NBPP[ucBppInteger];
        }
        else//10bpc
        {
            pstCurrentMatrix = MATRIX_YUV422_10BPC_TO_NBPP[ucBppInteger];
        }
    }
    else if (g_stDscEncInfo.ucColorSpace == YCbCr420_3)
    {
        if (g_stDscEncInfo.ucColorDepth == BPC8)
        {
            pstCurrentMatrix = MATRIX_YUV420_8BPC_TO_NBPP[ucBppInteger];
        }
        else//10bpc
        {
            pstCurrentMatrix = MATRIX_YUV420_10BPC_TO_NBPP[ucBppInteger];
        }
    }

    Drv_DpTxDscEnc_MatrixSet(pstCurrentMatrix);
}

void Drv_DpTxDscEnc_ColorSpaceSet(void)
{
    BKEF_5D_REG  = 0x00;//second_line_offset_adj[7:0]
    if(g_stDscEncInfo.ucColorSpace == YCbCr420_3)
    {
        BKEF_5C_REG = 0x02;//second_line_offset_adj[15:8]
        g_stDscEncInfo.ucSecLineOffset = 0x0c;
    }
    else
    {
        BKEF_5C_REG = 0x00;//second_line_offset_adj[15:8]
        g_stDscEncInfo.ucSecLineOffset = 0x00;
    }

    if(g_stDscEncInfo.ucColorSpace == YCbCr422_1)
    {
        BKEF_89_REG = 0xe0;//[7:0]rg_enc_ovfl_av_thresh
        g_stDscEncInfo.ucGroupUnit = 0x04;
        g_stDscEncInfo.usExtraBits = 0x142;
    }
    else
    {
        BKEF_89_REG = 0xac;//[7:0]rg_enc_ovfl_av_thresh
        g_stDscEncInfo.ucGroupUnit = 0x03;
        g_stDscEncInfo.usExtraBits = 0xf2; 
    }

    //default
    BKEF_04_REG &= BIT4_0;//pps4[4]1-RGB, 0-non RGB
    BKEF_04_REG &= BIT3_0;//pps4[3]simple_422 EN
    BKEF_58_REG = 0x00;//pps88[0]1-yuv422, 0-non yuv422; [1]1-yuv420, 0-non yuv420
    //color space set
    if(g_stDscEncInfo.b1Simple422En == ENABLED)
    {
         BKEF_04_REG |= BIT3_1;
    }
    if(g_stDscEncInfo.ucColorSpace == YCbCr422_1)
    {
        BKEF_58_REG |= BIT0_1;//pps88[0]1-yuv422, 0-non yuv422
    }
    else if(g_stDscEncInfo.ucColorSpace == YCbCr420_3)
    {
        BKEF_58_REG |= BIT1_1;//pps88[1]1-yuv420, 0-non yuv420
    }
    else if(g_stDscEncInfo.ucColorSpace == RGB_0)
    {
        BKEF_04_REG |= BIT4_1;//pps4[4]1-RGB, 0-non RGB
    }

    if(g_stDscEncInfo.ucColorDepth == BPC8)
    {
        BKEF_03_REG = 0x89;//-wangtt- wait update for edid or dpcd
        BKEF_83_REG = 0x47;//EF83 BIT3-0:7+2*(BPC-8)
        BKEF_84_REG = 0x21;//EF84 BIT3-0:1+2*(BPC-8)
    }
    else 
    {
        BKEF_03_REG = 0xab;//-wangtt- wait update for edid or dpcd
        BKEF_83_REG = 0x4B;
        BKEF_84_REG = 0x85;
    }

    if(g_stDscEncInfo.ucColorDepth == BPC8)
    {
        if(g_stDscEncInfo.ucColorSpace == RGB_0)
            BKEF_8D_REG = 0x0f;//default, 1080p, DSC C-code parameter
        else
            BKEF_8D_REG = 0x0e;//YU422 8bit
    }
    else
    {
        if(g_stDscEncInfo.ucColorSpace == RGB_0)
            BKEF_8D_REG = 0x13;//color depth,  DSC C-code parameter
        else
            BKEF_8D_REG = 0x12;//[4:0]DSC C-code parameter
    }
}

void Drv_DpTxDscEnc_SliceWidthAndHeightSet(void)
{
    u8 ucIndex;
    u16 usTemp;

    usTemp = 24;
    ucIndex = g_stDscEncTiming.usVact / usTemp;
    for ( ; ucIndex > 0; ucIndex--)
    {
        usTemp = g_stDscEncTiming.usVact / ucIndex;
        if (usTemp <= 24)
        {
            continue;
        }
        else if(g_stDscEncTiming.usVact % ucIndex)// 
        {
            continue;
        }
        else //N*ucIndex 
        {
            if(g_stDscEncInfo.ucColorSpace == YCbCr420_3)//420 case
            {
                if (usTemp % 2)
                {
                    continue;
                }
                else //usTemp  mod2 = 0
                {
                    if (g_stDscEncInfo.ucColorDepth == BPC12)
                    {
                        if (usTemp > 60)
                        {
                            break;
                        }
                    }
                    else
                    {
                        break;
                    }
                }
            }
            else
            {
                 if (usTemp >= 108)
                 {
                    break;
                 }
            }
        }
    }
    //slice height set
    #if CHIP_VERSION_SEL == U1_VERSION
    usTemp = g_stDscEncTiming.usVact;//wait eco
    #endif
    g_stDscEncInfo.usSliceHeight = usTemp;
    BKEF_0A_REG  = usTemp >> 8;
    BKEF_0B_REG  = usTemp & 0xff;

    //slice width set
    usTemp = g_stDscEncTiming.usHact / g_stDscEncInfo.ucSliceNum;
    if (g_stDscEncInfo.ucColorSpace == YCbCr420_3)
    {
        usTemp <<= 1;
    }
    BKEF_0C_REG  = usTemp >> 8;//slice width is according to real timing(4k 420 , hact is 3840)
    BKEF_0D_REG  = usTemp & 0xff;

    if ((g_stDscEncInfo.ucColorSpace == YCbCr422_1) || (g_stDscEncInfo.ucColorSpace == YCbCr420_3))
    {
        usTemp >>= 1;
    }
    g_stDscEncInfo.usSliceWidth = usTemp;
}

void Drv_DpTxDscEnc_PpsDynamicSet(void)
{
    u8 ucTemp;
    u8 ucInitScale, ucFinalScale;
    u16 usChunkSize, usFinalOffset;
    u16 usNotSecondLineOffset, usTemp;
    u32 temp0 =0, temp1 =0;

    g_stDscEncInfo.usSliceGroup = (u16)(ceil((double)g_stDscEncInfo.usSliceWidth / 3));
    ucTemp = (u8)(g_stDscEncInfo.usSliceWidth % 3);//SliceRemainder
    BKEF_81_REG = ucTemp << 6;//SliceRemainder
    BKEF_81_REG |= ((g_stDscEncInfo.usSliceGroup >> 8) & 0x07);
    BKEF_82_REG = g_stDscEncInfo.usSliceGroup;

    usTemp = g_stDscEncTiming.usHact;
    if(g_stDscEncInfo.ucColorSpace == YCbCr420_3)
        usTemp <<= 1;
    BKEF_08_REG = (usTemp >> 8) & 0xff;//hact[15:8]
    BKEF_09_REG = usTemp & 0xff;//hact[7:0]
    BKEF_06_REG = (g_stDscEncTiming.usVact >> 8) & 0xff;//vact[15:8]
    BKEF_07_REG = g_stDscEncTiming.usVact & 0xff;//vact[7:0]

    temp0 = (u32)g_stDscEncInfo.usSliceWidth * (u32)g_stDscEncInfo.usBpp;
    ucTemp = (u8)(temp0 & 0x0f);
    temp1 = temp0;
    temp0 = floor((double)temp0/16);
    usChunkSize = ceil((double)temp1/128);
    BKEF_8E_REG = temp0 >> 8;
    BKEF_8F_REG = temp0 & 0xff;
    BKEF_0E_REG = usChunkSize >> 8;
    BKEF_0F_REG = usChunkSize & 0xff;

    if (ucTemp == 0)
        BKEF_81_REG &= BIT3_0;//Bpp*SilceWidth: [3:0] is 0 ,ee81[3] is 0, otherwise is 1;
    else
        BKEF_81_REG |= BIT3_1;//Bpp*SilceWidth: [3:0] is 0 ,ee81[3] is 0, otherwise is 1;

    temp0 = 0x2000;//8192
    temp0 <<= 3;// temp0 = temp0 * 8
    temp0 = temp0 / (8192 - g_stDscEncInfo.usInitOffset);
    BKEF_15_REG =  temp0 & 0xff;
    ucInitScale = temp0 & 0xff;

    g_stDscEncInfo.usNotFirstLineOffset = ceil((double)(0x0f << 11) / (double)(g_stDscEncInfo.usSliceHeight - 1));
    BKEF_1C_REG = g_stDscEncInfo.usNotFirstLineOffset >> 8;
    BKEF_1D_REG = g_stDscEncInfo.usNotFirstLineOffset & 0xff;

    temp0  =  usChunkSize << 3;//* 8
    temp0  =  temp0 * g_stDscEncInfo.usSliceHeight;
    while((temp0 - g_stDscEncInfo.usExtraBits) % 48)
    {
        g_stDscEncInfo.usExtraBits--;
    }
    
    temp0 = 2048;
    temp0 = temp0 * (8192 - g_stDscEncInfo.usInitOffset + g_stDscEncInfo.usExtraBits);
    temp1 = (u32)g_stDscEncInfo.usSliceHeight * (u32)g_stDscEncInfo.usSliceGroup;

    g_stDscEncInfo.usSliceOffset = ceil((double)temp0 / (double)temp1);
    BKEF_1E_REG = g_stDscEncInfo.usSliceOffset >> 8;
    BKEF_1F_REG = g_stDscEncInfo.usSliceOffset & 0xff;

    temp0 = (u32)g_stDscEncInfo.usInitDelay * (u32)g_stDscEncInfo.usBpp + 8;
    temp0 = 8192 - (temp0 >> 4) + g_stDscEncInfo.usExtraBits;
    usFinalOffset = temp0;
    BKEF_22_REG = usFinalOffset >> 8;
    BKEF_23_REG = usFinalOffset & 0xff;

    BKEF_59_REG  = g_stDscEncInfo.ucSecLineOffset;
    usNotSecondLineOffset = ceil((double)(g_stDscEncInfo.ucSecLineOffset << 11) / (double)(g_stDscEncInfo.usSliceHeight - 1));
    BKEF_5A_REG = usNotSecondLineOffset >> 8;
    BKEF_5B_REG = usNotSecondLineOffset & 0xff;

    temp0 = 8192;
    temp0 <<= 3;
    temp1 = 8192 - usFinalOffset;
    temp0 = temp0 / temp1;
    ucFinalScale = temp0;
    temp0 = g_stDscEncInfo.usNotFirstLineOffset + g_stDscEncInfo.usSliceOffset + usNotSecondLineOffset;
    temp1 = (ucFinalScale - 9) * temp0;

    temp0 = 0x01 << 11;
    temp0 = temp0 * usFinalOffset;
    temp0 = temp0 / temp1;
    if (temp0 > 0xffff)
    {
        printLT(PRINT_PRIO_HIG,"\nWarning: pps parameter overflow!!!");
        temp0 = 0xffff;
    }
    BKEF_16_REG = temp0 >> 8;
    BKEF_17_REG = temp0 & 0xff;

    usTemp = ((g_stDscEncInfo.usSliceGroup) / (ucInitScale - 8));
    BKEF_18_REG = (usTemp >> 8) & 0x0f;
    BKEF_19_REG = usTemp & 0xff;

    usTemp = 3 * g_stDscEncInfo.usBpp;
    usTemp = ceil((double)usTemp/16);
    BKEF_8B_REG = usTemp + 8;
    BKEF_8C_REG = usTemp - g_stDscEncInfo.ucGroupUnit;

    temp0 = ceil((double)usChunkSize / 6);
    BKEF_9A_REG = (temp0 >> 8);
    BKEF_9B_REG = (temp0 & 0x00ff);
    BKEF_9C_REG = (usChunkSize + 6 - temp0 * 6) % 6;
    BKEF_AB_REG = temp0 >> 8;
    BKEF_AC_REG = temp0 & 0xff;

    #if CHIP_VERSION_SEL > U1_VERSION
    BKEF_B0_REG &= BIT0_0;
    if (g_stDscEncInfo.ucSliceNum > 1)
    {
        if (BKEF_9C_REG == 0x03)
        {
            BKEF_B0_REG |= BIT0_1;
        }
    }
    #endif
}

u32 Drv_DpTxDscEnc_OffsetCompute(u16 Group,u16 GroupCnt)//320 171
{
    u16 grpcnt_id = 0;
    u32 offset = 0, offset1 = 0;

    grpcnt_id = ceil((double)g_stDscEncInfo.usInitDelay / 3);
    if(GroupCnt <= grpcnt_id)
    {
        offset = GroupCnt * 3;//513
        offset = offset * g_stDscEncInfo.usBpp;
        offset = ceil((double)offset / 16);
    }
    else
    {
        offset = grpcnt_id * 3 ;
        offset = offset * g_stDscEncInfo.usBpp;
        offset = ceil((double)offset / 16);
        offset1 = (GroupCnt - grpcnt_id);
        offset1 = offset1 * g_stDscEncInfo.usSliceOffset;
        offset1 = offset1 >> 11;
        offset = offset - offset1;//4090
    }
    if(GroupCnt <= Group)
    {
        offset += (GroupCnt * 15);
    }
    else
    {
        offset1 = (GroupCnt - Group);
        offset1 = offset1 * g_stDscEncInfo.usNotFirstLineOffset;
        offset1 = offset1 >> 11;//original 11
        offset += (Group * 15 - offset1);
    }
    return offset;
}

void Drv_DpTxDscEnc_MaxOffset(void)
{
    u16 usEncDelay;
    u32 ulEncDelay;

    ulEncDelay = Drv_DpTxDscEnc_OffsetCompute(g_stDscEncInfo.usSliceGroup, ceil((double)g_stDscEncInfo.usInitDelay / 3)); 
    ulEncDelay = max(ulEncDelay, Drv_DpTxDscEnc_OffsetCompute((g_stDscEncInfo.usSliceGroup), (g_stDscEncInfo.usSliceGroup)));
    ulEncDelay = max(ulEncDelay, Drv_DpTxDscEnc_OffsetCompute((g_stDscEncInfo.usSliceGroup), (g_stDscEncInfo.usSliceGroup)*2));
    ulEncDelay += (8192 - g_stDscEncInfo.usInitOffset);
    ulEncDelay <<= 4;

    usEncDelay = (u16)ceil((double)ulEncDelay / g_stDscEncInfo.usBpp);
    usEncDelay = usEncDelay - g_stDscEncInfo.usInitDelay;

    BKEF_12_REG = (usEncDelay >> 8);
    BKEF_13_REG = usEncDelay;
}

void Drv_DpTxDscEnc_ParamSet(void)
{
    u8 ucTemp, ucDscNum;
//---------------------------------------------adaptive sync mode------------------------------------------------------------
    BKEF_98_REG |= BIT1_1;//[1]adaptive sync, timing follow
//---------------------------------------------adaptive sync mode------------------------------------------------------------
    if (g_stDscEncInfo.ucMinorVer == 0x02)
        BKEF_81_REG |= BIT4_1;//[4]dsc version1.2a enable: 1-en
    else
        BKEF_81_REG &= BIT4_0;//[4]dsc version1.2a enable: 0-dis

    if(g_stDscEncInfo.ucSliceNum == 0x01)
        BKEF_97_REG = 0x00;//rg_ich_clr
    else
        BKEF_97_REG = 0x01;

    ucDscNum = g_stDscEncInfo.ucCoreNum;
    BKEF_A7_REG = 0x6a;//rg_bkef_dsc_en, hdmi tx//28

    if(ucDscNum == 0x01)
    {
        ucTemp = 0x80;
    }
    else if(ucDscNum == 0x02)
    {
        ucTemp = 0xc0;
    }
    else if(ucDscNum == 0x04)
    {
        ucTemp = 0xe0;
    }
    else
    {
        ucTemp = 0xf0;
    }

    BKEF_00_REG = (g_stDscEncInfo.ucMainVer | g_stDscEncInfo.ucMinorVer);;//dsc-v1.2
    BKEF_AD_REG = 0xff;//dsc sram full & empty flag enable

    //dsc reset
    BKEF_F8_REG = 0x00;
    BKEF_80_REG = 0x00;
    Ocm_Delay1ms(1);
    BKEF_F8_REG = 0xff;
    BKEF_80_REG |= ucDscNum;//
    BKEF_80_REG |= ucTemp;
}

void Drv_DpTxDscEnc_TxPktSet(void)//emp packet set
{
    if(g_stDscEncInfo.ucColorSpace == YCbCr420_3)//recovery to real timing
    {
        g_stDscEncTiming.usHbp <<= 1;
        g_stDscEncTiming.usHfp <<= 1;
        g_stDscEncTiming.usHsync <<= 1;
        g_stDscEncTiming.usHtol <<= 1;
        g_stDscEncTiming.usHact <<= 1;
    }

    BKE6_EE_REG |= BIT7_1;//[7]pps_upd_sel: 1 = dsc_encode, 0 = dhrx
    BKF6_ED_REG = 0x10;//Timer to gate BS period
    BKF6_EF_REG |= BIT5_1;//[5]dp tx pps update: 1-vsync
    BKF6_EF_REG &= BIT6_0;//[6]rg_pps_upd_dis: 0-pps update en

//    BKF7_03_REG = 0x04;//important, must be 0x04, must msa first, msa start the number of line in vblanking 
    BKF7_26_REG = (BIT5_1 | (g_stDscEncInfo.ucSliceNum - 1));//[5]rgd_dsc_en, [4:0]number of chunks per line = slice number

    //soft msa H set
    BKF7_05_REG = g_stDscEncTiming.usHtol >> 8;
    BKF7_06_REG = g_stDscEncTiming.usHtol & 0xff;
    BKF7_07_REG = (g_stDscEncTiming.usHsync + g_stDscEncTiming.usHbp) >> 8;
    BKF7_08_REG = (g_stDscEncTiming.usHsync + g_stDscEncTiming.usHbp) & 0xff;
    BKF7_09_REG &= 0x80;//[6:0]hsync width, [7]hsync polarity
    BKF7_09_REG |= ((g_stDscEncTiming.usHsync >> 8) & 0x7f);//[6:0]hsync width
    BKF7_0A_REG = g_stDscEncTiming.usHsync & 0xff;
    BKF7_0B_REG = g_stDscEncTiming.usHact >> 8;
    BKF7_0C_REG = g_stDscEncTiming.usHact & 0xff;
    //soft msa V set
    BKF7_0D_REG = g_stDscEncTiming.usVtol >> 8;
    BKF7_0E_REG = g_stDscEncTiming.usVtol & 0xff;
    BKF7_11_REG = (g_stDscEncTiming.usVsync + g_stDscEncTiming.usVbp) >> 8;
    BKF7_12_REG = (g_stDscEncTiming.usVsync + g_stDscEncTiming.usVbp) & 0xff;
    BKF7_13_REG &= 0x80;//[6:0]vsync width, [7]vsync polarity
    BKF7_13_REG |= ((g_stDscEncTiming.usVsync >> 8) & 0x7f);//[6:0]vsync width
    BKF7_14_REG = g_stDscEncTiming.usVsync & 0xff;
    BKF7_15_REG = g_stDscEncTiming.usVact >> 8;
    BKF7_16_REG = g_stDscEncTiming.usVact & 0xff;
    BKF7_2A_REG |= BIT4_1;//[4]msa soft en, Video timing setting soft mode: From registers
    BKF7_2A_REG |= BIT5_1;//[5]RGB swap enable: 1-en, 0-dis
    BKF7_2E_REG |= BIT0_1;
    
    g_stDpTx.b1SoftMsaEn = TRUE;

    BKF7_24_REG = BKEF_0E_REG;//chunk size [15:8]
    BKF7_25_REG = BKEF_0F_REG;//chunk size [7:0]

    BKF6_10_REG = 0x00;//pps hb0
    BKF6_11_REG = 0x10;//pps hb1
    BKF6_12_REG = 0x7f;//pps hb2, length
    BKF6_13_REG = 0x00;//pps hb3
    BKF6_0E_REG |= BIT4_1;//[4]pps en

    //recovery to pix timing
    if(g_stDscEncInfo.ucColorSpace == YCbCr420_3)
    {
        g_stDscEncTiming.usHbp >>= 1;
        g_stDscEncTiming.usHfp >>= 1;
        g_stDscEncTiming.usHsync >>= 1;
        g_stDscEncTiming.usHtol >>= 1;
        g_stDscEncTiming.usHact >>= 1;
    }
}

void Drv_DpTxDscEnc_InfoGet(void)
{
    Drv_DpTxDscEnc_ColorInfoGet();
    Drv_DpTxDscEnc_TimingGet();
    Drv_DpTxDscEnc_RxDscInfoGet();
}

void Drv_DpTxDscEnc_ModuleEnable(void)
{
    Drv_DpTxDscEnc_DataMux();
    Drv_DpTxDscEnc_ClkMux();

    Drv_DpTxDscEnc_RxParamSet();
    Drv_DpTxDscEnc_WordDelaySet();
    Drv_DpTxDscEnc_ExtraHactSet();
    Drv_DpTxDscEnc_TimingSet();
    Drv_DpTxDscEnc_MatrixCalculation();
    Drv_DpTxDscEnc_ColorSpaceSet();
    Drv_DpTxDscEnc_SliceWidthAndHeightSet();
    Drv_DpTxDscEnc_PpsDynamicSet();
    Drv_DpTxDscEnc_MaxOffset();
    Drv_DpTxDscEnc_ParamSet();
    g_stDscEncInfo.ucDscEncEn = ENABLED;
}

void Drv_DpTxDscEnc_DoduleDisable(void)
{
    BKEF_80_REG = 0x00;
    BKEF_F8_REG = 0x00;
}

void Drv_DpTxDscEnc_Init(void)
{
    //dsc close
    Drv_System_SramPathSet(DPTX_INIT_SET_PATH);

    BKE6_EE_REG &= BIT7_0;//[7]pps_upd_sel: 1 = dsc_encode, 0 = dhrx
    BKEF_80_REG = 0x00;
    BKEF_F8_REG = 0x00;

    BKED_30_REG &= BIT4_0;//[4]dhtx src sel: 1-encoder, 0-rx

    BKF6_0E_REG &= BIT4_0;//pps pkt dis
    BKF6_ED_REG = 0x08;//timer to gate BS period: default
    BKF7_1A_REG &= BIT4_0;//The mode of total_byte_line value select: 0-hw
    BKF7_26_REG = 0x00;
    BKF7_2A_REG &= BIT4_0;//[4]rgd_msa_soft_en: 0-from video check
    BKF7_2A_REG &= BIT5_0;//[5]rgd_rgd_swap: 0-dis;

    BKF7_24_REG = 0x00;
    BKF7_25_REG = 0x00;
    BKF7_2E_REG &= BIT0_0;
    Drv_DpTxDscEnc_DscInit();
    g_stDscEncInfo.ucDscEncEn = DISABLED;
}

u8 Drv_DpTxDscEnc_SwitchGet(void)
{
    return g_stDscEncInfo.ucDscEncEn;
}

u16 Drv_DpTxDscEnc_BppGet(void)
{
    return g_stDscEncInfo.usBpp;
}
#endif

#endif
