void Drv_MipiTx_WordCnt_Set(u8 IsSoftMode ,u16 WordCnt,u8 PortCnt)
{
    (PortCnt > 1)?(BKF9_7A_REG|= BIT7_1):(BKF9_7A_REG&= BIT7_0);
    (IsSoftMode == SW_MODE)?(BKF9_7A_REG|= BIT6_1):(BKF9_7A_REG&= BIT6_0);
    BKF9_90_REG = WordCnt/256;
    BKF9_91_REG = WordCnt%256;
}

void Drv_MipiTx_Dsc_Split(u16 Hactive,u8 PortCnt)
{
	int i = Hactive/PortCnt;
	
	if(PortCnt > 1)
	{
		if (i % 2 != 0)
		{
		BKF9_88_REG = 0x21;
		BKF9_71_REG = 0x13;	
		}	
	}
}
