void Drv_MipiTx_HssLP_En(u8 ucIsEn)
{
    if(ucIsEn == ENABLED)
    {
        SET_BIT(BKF9_89_REG, BIT2);
    }
    else
    {
        CLEAR_BIT(BKF9_89_REG, BIT2);
    }
}

void Drv_MipiTx_HsCmd_En(u8 ucIsEn)
{
    if(ucIsEn == ENABLED)
    {
        SET_BIT(BKF9_84_REG, BIT3);
    }
    else
    {
        CLEAR_BIT(BKF9_84_REG, BIT3);
