void Drv_MipiTx_PortSwap(u8 PortNum)
{
    /*
        example: downstream connect LT9611uxc 
        LT9611uxc   ------->     LT22046911GXE
        port0      ------->     port3(sel 1)
        port1       ------->    port2(sel 3)
    */
//    if(GET_BITS(BKF9_87_REG, 3, 0) > 0)
//      {
//        BKF9_6C_REG = 0xFF;//  2 port 
//      }
	
	
	switch ( PortNum )
	{
	    case MIPI_1PORT :
	        BKF9_6C_REG = 0xFF;
	        break;
	    case MIPI_2PORT :
					#if ((CHIP_SEL == LT6911GXD_HD)||(CHIP_SEL == LT6911GXD_DP))
					BKF9_6C_REG = 0xF5;
					#else
	        BKF9_6C_REG = 0xDD;
					#endif
	        break;
	    case MIPI_4PORT :
	        BKF9_6C_REG = 0xE4;
	        break;
	    default:
	        break;
	}
	if(g_stMipiTx.ucLMTXPortSel != 0)
	{
	BKF9_6C_REG = g_stMipiTx.ucLMTXPortSel;
	}	
    
}

void Drv_MipiTx_PortNumSet(u8 ucPortNum)
{
    LET_BITS(BKF9_87_REG, 3, 0, ucPortNum);
    
    
}

void Drv_MipiTx_LaneNumSet(u8 ucLaneNum)
{
    if(4 > ucLaneNum)
    {
        LET_BITS(BKF9_89_REG, 1, 0, ucLaneNum);
    }
}

void Drv_MipiTx_CPhyEn(u8 ucEn)
{
    CHK_SET_BIT(ucEn, BKF9_6F_REG, BIT5);
}

void Drv_MipiTx_DPhyClkDataSet()
{
    BKF9_AA_REG = 0xAA;
}
void Drv_MipiTx_DPhyClkModeSet(u8 ub1ClkMode)
{
    if(ON == ub1ClkMode )
    {
        SET_BIT(BKF9_89_REG, BIT7);
        CLEAR_BIT(BKF9_AB_REG, BIT7);
        LTLog(LOG_DEBUG,"DPhy Clk burst Mode");
        
    }
    else
    {
        CLEAR_BIT(BKF9_89_REG, BIT7);//DSC这个要关闭
        SET_BIT(BKF9_AB_REG, BIT7);
        LTLog(LOG_DEBUG,"DPhy Clk continue Mode");
    }
}

void Drv_MipiTx_DSIVideoModeSet(u8 b1DSIVideoMode)
{
    if(b1DSIVideoMode == NON_BURST_MODE_WITH_SYNC_EVENT )
    {
				LET_BITS(BKF9_97_REG, 1, 0, 0x1);
        LTLog(LOG_DEBUG,"DSI video NON_BURST_MODE_WITH_SYNC_EVENT");
        
    }
    else if(b1DSIVideoMode == NON_BURST_MODE_WITH_SYNC_PULSE )
    {
				LET_BITS(BKF9_97_REG, 1, 0, 0x2);
        LTLog(LOG_DEBUG,"DSI video NON_BURST_MODE_WITH_SYNC_PULSE");
    }
		else if(b1DSIVideoMode == BURST_MODE )
		{
				LET_BITS(BKF9_97_REG, 1, 0, 0x3);
        LTLog(LOG_DEBUG,"DSI video BURST_MODE");			
		}
}

