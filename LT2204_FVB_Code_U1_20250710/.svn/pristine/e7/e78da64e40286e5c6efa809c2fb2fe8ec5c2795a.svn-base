#include "include.h"

#if TX_PORT_SIGN == MIPI_PORT

#define LMTXPLL_VCO_MIN_FS 1200000 //LMTX PLL min work Fs
#define LMTXPLL_VCO_MAX_FS 2000000 //LMTX PLL max work Fs

//PHY timing :
#define HS_LPX_REG          BKF9_A4_REG
#define HS_PREP_REG         BKF9_A5_REG
#define HS_TRAIL            BKF9_A6_REG
#define CLK_ZERO_REG        BKF9_A7_REG
#define CLK_PRE_REG         BKF9_A8_REG
#define CLK_POST_REG        BKF9_A9_REG
#define HS_RQST_PRE_REG     BKF9_8A_REG


u8 Drv_MipiTx_GetHsTrail()
{
    return BKF9_A6_REG;
}

u8 Drv_mipiTx_GetHsRqstPre()
{
    return BKF9_8A_REG;
}

void Drv_MipiTx_Rst(u8 IsEn)
{
	(IsEn == ENABLED)?(BKF9_BF_REG = 0xFF):(BKF9_BF_REG = 0x00);
}

void Drv_MipiTx_VideoSet(u8 b1Opt)
{
    if (ON == b1Opt)
    {
				Drv_MipiTx_Rst(ENABLED);			
				if (g_stMipiTx.b1MIPITXProSel == MIPITX_DSI)
				{
        CLEAR_BIT(BKF9_89_REG, BIT5);
        SET_BIT(BKF9_89_REG, BIT4);
        LTLog(LOG_INFO, "Mipi DSI Out");
				}
				else
				{
        SET_BIT(BKF9_89_REG, BIT5);
        CLEAR_BIT(BKF9_89_REG, BIT4);
        LTLog(LOG_INFO, "Mipi CSI Out");
				}
    }
    else
    {
				Drv_MipiTx_Rst(DISABLED);			
        CLEAR_BITS(BKF9_89_REG, BIT5, BIT4);
				LTLog(LOG_INFO, "Mipi Out Disable");
    }

}

void Drv_MipiTx_DataTypeSet(u8 ucDataType, u8 ucBppAndFmtVal)
{
    LET_BITS(BKF9_86_REG, 5, 0, ucDataType);
    BKF9_88_REG = ucBppAndFmtVal;

}

void Drv_MipiTx_TimingSet(IN StructTiming *pstVidTiming)
{
    BKF9_7E_REG = GET_16BIT_HIGH(pstVidTiming->Hactive); 
    BKF9_7F_REG = GET_16BIT_LOW(pstVidTiming->Hactive);        

    BKF9_7C_REG = GET_16BIT_HIGH(pstVidTiming->Vactive);
    BKF9_7D_REG = GET_16BIT_LOW(pstVidTiming->Vactive);    
    
    //SET_BIT(BKF9_7A_REG, BIT4);//以前是数vss 判断DE，现在通过第一个DE的上升沿来判断。

    BKF9_80_REG = GET_16BIT_HIGH(pstVidTiming->Vsw + pstVidTiming->Vbp);
    BKF9_81_REG = GET_16BIT_LOW(pstVidTiming->Vsw + pstVidTiming->Vbp);

    LET_BITS(BKF9_7A_REG, BIT3, BIT0, GET_16BIT_HIGH((pstVidTiming->Hactive) / 4));
    BKF9_7B_REG = GET_16BIT_LOW((pstVidTiming->Hactive) / 4);
}

void Drv_MipiTx_InHSyncPol_Sel(IN u8 b1SyncPol)
{
    if (POSITIVE == b1SyncPol )
    {
        CLEAR_BIT(BKF9_70_REG, BIT1);
    }
    else
    {
        SET_BIT(BKF9_70_REG, BIT1);
    }
}

void Drv_MipiTx_InVSyncPol_Sel(IN u8 b1SyncPol)
{
    if (POSITIVE == b1SyncPol )
    {
        CLEAR_BIT(BKF9_70_REG, BIT0);
    }
    else
    {
        SET_BIT(BKF9_70_REG, BIT0);
    }
}

u32 Drv_MipiTx_GetMipiInClk()
{
    u32 ulMipiInClk = 0 ;
    u8 ucIndex = 0;
    
    //Drv_System_FmSet(TX_FM, 0x13); //AD_DSCTX_DSC_OUT_CLK   
    Drv_System_FmSet(TOP_FM, 0x14); 
    Ocm_Delay1ms(5);

    for(;ucIndex < 5; ucIndex++)
    {
        if(STABLE ==  Drv_System_FmStbGet(TOP_FM) )
        {
            ulMipiInClk = Drv_System_FmGet(TOP_FM, 0);
            break;
        }
        Ocm_Delay1ms(1);
    }
    
    return ulMipiInClk;
}

void Drv_MipiTx_PortLdoRpRdCali()
{
    u8 ucMipiTxRd[4] = {0,0,0,0} ;
    u8 ucMipiTxRp[4] = {0,0,0,0} ;
    u8 ucScanCnt = 0;
    u8 ucCaliDoneFlag = 0x00;

    //port 0~3 TX Swing cali Enable
    SET_BIT(BKE2_A3_REG, BIT0);
    SET_BIT(BKE2_A5_REG, BIT0);
    SET_BIT(BKE2_A7_REG, BIT0);
    SET_BIT(BKE2_A9_REG, BIT0);
    Ocm_Delay1ms(1);
    
    //wait cali Done,and get Rp & Rd Value
    while(ucScanCnt ++ < 10)
    {
        if(GET_BIT(BKE2_AB_REG, BIT0)) //LMTX0 swing cali done
        {
            ucMipiTxRd[0] = GET_BITS(BKE2_AC_REG, 4, 0);
            ucMipiTxRp[0] = GET_BITS(BKE2_AD_REG, 4, 0);
            ucCaliDoneFlag |= 0x01;
        }
        
        if(GET_BIT(BKE2_AE_REG, BIT0)) //LMTX1 swing cali done
        {
            ucMipiTxRd[1] = GET_BITS(BKE2_AF_REG, 4, 0);
            ucMipiTxRp[1] = GET_BITS(BKE2_B0_REG, 4, 0);
            ucCaliDoneFlag |= 0x02;
        }

        if(GET_BIT(BKE2_B1_REG, BIT0)) //LMTX2 swing cali done
        {
            ucMipiTxRd[2] = GET_BITS(BKE2_B2_REG, 4, 0);
            ucMipiTxRp[2] = GET_BITS(BKE2_B3_REG, 4, 0);
            ucCaliDoneFlag |= 0x04;
        }

        if(GET_BIT(BKE2_B4_REG, BIT0)) //LMTX3 swing cali done
        {
            ucMipiTxRd[3] = GET_BITS(BKE2_B5_REG, 4, 0);
            ucMipiTxRp[3] = GET_BITS(BKE2_B6_REG, 4, 0);
            ucCaliDoneFlag |= 0x08;
        }
        
        if(0x0F == ucCaliDoneFlag)
        {
            break;
        }
        
        Ocm_Delay1ms(1);
    }

    //set Cali Result to LMTX0~3  TAP0 Rp and Rd
    if((0 != ucMipiTxRd[0]) && (0 != ucMipiTxRp[0]))
    {
        LET_BITS(BKA2_1C_REG, 4, 0, ucMipiTxRp[0]); 
        LET_BITS(BKA2_1D_REG, 4, 0, ucMipiTxRd[0]); 
    }

    if((0 != ucMipiTxRd[1]) && (0 != ucMipiTxRp[1]))
    {
        LET_BITS(BKA2_31_REG, 4, 0, ucMipiTxRp[1]); 
        LET_BITS(BKA2_32_REG, 4, 0, ucMipiTxRd[1]); 
    }

    if((0 != ucMipiTxRd[2]) && (0 != ucMipiTxRp[2]))
    {
        LET_BITS(BKA2_46_REG, 4, 0, ucMipiTxRp[2]); 
        LET_BITS(BKA2_47_REG, 4, 0, ucMipiTxRd[2]); 
    }

    if((0 != ucMipiTxRd[3]) && (0 != ucMipiTxRp[3]))
    {
        LET_BITS(BKA2_5B_REG, 4, 0, ucMipiTxRp[3]); 
        LET_BITS(BKA2_5C_REG, 4, 0, ucMipiTxRd[3]); 
    }

    LTLog(LOG_INFO, "Port 0~3 Rp Cali Result: %02bx, %02bx, %02bx, %02bx",ucMipiTxRp[0], ucMipiTxRp[1], ucMipiTxRp[2], ucMipiTxRp[3]);
    LTLog(LOG_INFO, "Port 0~3 Rd Cali Result: %02bx, %02bx, %02bx, %02bx",ucMipiTxRd[0], ucMipiTxRd[1], ucMipiTxRd[2], ucMipiTxRd[3]);
}

void Drv_MipiTx_Port0Setting(u8 ucP0En)
{
    //Dphy
	 if(g_stMipiTx.ucTxPhySel == MIPITX_DPHY)
	 {
    BKA2_12_REG = (ENABLED == ucP0En)? 0xF0 : 0x10; //lmtx port0 enable & port0 ldo1 ldo2 enable
    BKA2_13_REG = (ENABLED == ucP0En)? 0x30 : 0x20; //lmtx port0 p2s enable: rg_en
    BKA2_17_REG = (ENABLED == ucP0En)? 0xA2 : 0x00; //lp driver level2 for CTS
    BKA2_18_REG = (ENABLED == ucP0En)? 0xB2 : 0x00; //lmtx port0 mipi lprx enable control
    BKA2_19_REG = (ENABLED == ucP0En)? 0x01 : 0x00; //lmtx port0 dphy lprx channel select: lane-0
    BKA2_1A_REG = (ENABLED == ucP0En)? 0x03 : 0x00; //lmtx port0 dphy clk channel select: lane-2
    BKA2_22_REG = (ENABLED == ucP0En)? 0xFE : 0x00; //Lmtx port0 channel lvds_dphy lane0~4 enable control
    BKA2_23_REG = (ENABLED == ucP0En)? 0x80 : 0x00; //lmtx port0 lvds_dphy_cphy tap0 enable control
		}
		else
		{
    //Cphy
    BKA2_12_REG = (ENABLED == ucP0En)? 0xF4 : 0x10; //lmtx port0 enable & port0 ldo1 ldo2 enable
    BKA2_17_REG = (ENABLED == ucP0En)? 0xA2 : 0x00; //lp driver level2 for CTS
    BKA2_18_REG = (ENABLED == ucP0En)? 0xB2 : 0x00; //lmtx port0 mipi lprx enable control
    BKA2_19_REG = (ENABLED == ucP0En)? 0x01 : 0x00; // TODO:lmtx port0 dphy lprx channel select: lane-0 
    BKA2_23_REG = (ENABLED == ucP0En)? 0xC0 : 0x00; // mtx port0 lvds_dphy_cphy tap0 enable control
    BKA2_24_REG = (ENABLED == ucP0En)? 0x0F : 0x00; //lmtx port0 cphy channel enable cphy channel0 lprx
    BKA2_13_REG = (ENABLED == ucP0En)? 0x10 : 0x10; //bit5:lmtx port0 cphy p2s reset control
    BKA2_13_REG = (ENABLED == ucP0En)? 0x30 : 0x30; //lmtx0 p2s_en_sel from da
    if(BKA2_23_REG == 0xC0)
    {
        BKA2_1E_REG = 0x02;//tap1 up
        BKA2_1F_REG = 0x02;//tap1 down
					
    }
#ifdef MIPI_CHPY_HSLP_FALL_CFG_EN
    BKA2_6E_REG = 0x20;
    BKA2_6F_REG = 0xF0;//up
    BKA2_70_REG = 0x30;//down
    BKA2_1B_REG = 0x02;//RG_LMTX1_M_CALI_UPDOWN_SEL
    BKA2_6E_REG = 0x43;
#endif
		}
}

void Drv_MipiTx_Port1Setting(u8 ucP1En)
{
	 if(g_stMipiTx.ucTxPhySel == MIPITX_DPHY)
	 {
    //Dphy
    BKA2_27_REG = (ENABLED == ucP1En)? 0xF0 : 0x10; //lmtx port1 enable & port0 ldo1 ldo2 enable
    BKA2_28_REG = (ENABLED == ucP1En)? 0x30 : 0x20; //lmtx port1 p2s enable: rg_en
    BKA2_2C_REG = (ENABLED == ucP1En)? 0xA2 : 0x00; //lp driver level2 for CTS
    BKA2_2D_REG = (ENABLED == ucP1En)? 0xB2 : 0x00; //lmtx port1 mipi lprx enable control
    BKA2_2E_REG = (ENABLED == ucP1En)? 0x01 : 0x00; //lmtx port1 dphy lprx channel select: lane-0
    BKA2_2F_REG = (ENABLED == ucP1En)? 0x03 : 0x00; //lmtx port1 dphy clk channel select: lane-2
    BKA2_37_REG = (ENABLED == ucP1En)? 0xFE : 0x00; //Lmtx port1 channel lvds_dphy lane0~4 enable control
    BKA2_38_REG = (ENABLED == ucP1En)? 0x80 : 0x00; //lmtx port1 lvds_dphy_cphy tap0 enable control
		}
		else
		{
    //Cphy
    BKA2_27_REG = (ENABLED == ucP1En)? 0xF4 : 0x10; //lmtx port0 enable & port0 ldo1 ldo2 enable
    BKA2_2C_REG = (ENABLED == ucP1En)? 0xA2 : 0x00; //lp driver level2 for CTS
    BKA2_2D_REG = (ENABLED == ucP1En)? 0xB2 : 0x00; //lmtx port0 mipi lprx enable control
    BKA2_2E_REG = (ENABLED == ucP1En)? 0x01 : 0x00; // TODO:lmtx port0 dphy lprx channel select: lane-0
    BKA2_38_REG = (ENABLED == ucP1En)? 0xC0 : 0x00; //lmtx port0 lvds_dphy_cphy tap0 enable control
    BKA2_39_REG = (ENABLED == ucP1En)? 0x0F : 0x00; //lmtx port0 cphy channel enable & LPRX enable
    BKA2_28_REG = (ENABLED == ucP1En)? 0x10 : 0x10; //Lmtx port0 cphy p2s reset control:
    BKA2_28_REG = (ENABLED == ucP1En)? 0x30 : 0x30; //lmtx port0 p2s enable: rg_en
    if(BKA2_38_REG == 0xC0)
    {
        BKA2_33_REG = 0x02;
        BKA2_34_REG = 0x02;
    }
#ifdef MIPI_CHPY_HSLP_FALL_CFG_EN
    BKA2_79_REG = 0x03;
    BKA2_7A_REG = 0x30;//up
    BKA2_7B_REG = 0x30;//down
    BKA2_30_REG = 0x02;//RG_LMTX1_M_CALI_UPDOWN_SEL
    BKA2_79_REG = 0x0F;
#endif
		}
}

void Drv_MipiTx_Port2Setting(u8 ucP2En)
{
	 if(g_stMipiTx.ucTxPhySel == MIPITX_DPHY)
	 {
    //Dphy
    BKA2_3C_REG = (ENABLED == ucP2En)? 0xF0 : 0x10; //lmtx port1 enable & port0 ldo1 ldo2 enable
    BKA2_3D_REG = (ENABLED == ucP2En)? 0x30 : 0x20; //lmtx port1 p2s enable: rg_en
    BKA2_41_REG = (ENABLED == ucP2En)? 0xA2 : 0x00; //lp driver level2 for CTS
    BKA2_42_REG = (ENABLED == ucP2En)? 0xB2 : 0x00; //lmtx port1 mipi lprx enable control
    BKA2_43_REG = (ENABLED == ucP2En)? 0x01 : 0x00; //lmtx port1 dphy lprx channel select: lane-0
    BKA2_44_REG = (ENABLED == ucP2En)? 0x03 : 0x00; //lmtx port1 dphy clk channel select: lane-2
    BKA2_4C_REG = (ENABLED == ucP2En)? 0xFE : 0x00; //Lmtx port1 channel lvds_dphy lane0~4 enable control
    BKA2_4D_REG = (ENABLED == ucP2En)? 0x80 : 0x00; //lmtx port1 lvds_dphy_cphy tap0 enable control
		}
		else
		{
    //Cphy
    BKA2_3C_REG = (ENABLED == ucP2En)? 0xF4 : 0x10; //lmtx port0 enable & port0 ldo1 ldo2 enable
    BKA2_41_REG = (ENABLED == ucP2En)? 0xA2 : 0x00; //lp driver level2 for CTS
    BKA2_42_REG = (ENABLED == ucP2En)? 0xB2 : 0x00; //lmtx port0 mipi lprx enable control
    BKA2_43_REG = (ENABLED == ucP2En)? 0x01 : 0x00; // TODO:lmtx port0 dphy lprx channel select: lane-0
    BKA2_4D_REG = (ENABLED == ucP2En)? 0xC0 : 0x00; //lmtx port0 lvds_dphy_cphy tap0 enable control
    BKA2_4E_REG = (ENABLED == ucP2En)? 0x0F : 0x00; //lmtx port0 cphy channel enable & LPRX enable
    BKA2_3D_REG = (ENABLED == ucP2En)? 0x10 : 0x10; //Lmtx port0 cphy p2s reset control:
    BKA2_3D_REG = (ENABLED == ucP2En)? 0x30 : 0x30; //lmtx port0 p2s enable: rg_en
    if(BKA2_4D_REG == 0xC0)
    {
        BKA2_48_REG = 0x02;
        BKA2_49_REG = 0x02;
    }
#ifdef MIPI_CHPY_HSLP_FALL_CFG_EN
    BKA2_84_REG = 0x0C;
    BKA2_85_REG = 0xD0;//up
    BKA2_86_REG = 0x10;//down
    BKA2_45_REG = 0x02;//RG_LMTX1_M_CALI_UPDOWN_SEL
    BKA2_84_REG = 0x3C;
#endif
		}
}

void Drv_MipiTx_Port3Setting(u8 ucP3En)
{
	 if(g_stMipiTx.ucTxPhySel == MIPITX_DPHY)
	 {
    //Dphy
    BKA2_51_REG = (ENABLED == ucP3En)? 0xF0 : 0x10; //lmtx port1 enable & port0 ldo1 ldo2 enable
    BKA2_52_REG = (ENABLED == ucP3En)? 0x30 : 0x20; //lmtx port1 p2s enable: rg_en
    BKA2_56_REG = (ENABLED == ucP3En)? 0xA2 : 0x00; //lp driver level2 for CTS
    BKA2_57_REG = (ENABLED == ucP3En)? 0xB2 : 0x00; //lmtx port1 mipi lprx enable control
    BKA2_58_REG = (ENABLED == ucP3En)? 0x01 : 0x00; //lmtx port1 dphy lprx channel select: lane-0
    BKA2_59_REG = (ENABLED == ucP3En)? 0x03 : 0x00; //lmtx port1 dphy clk channel select: lane-2
    BKA2_61_REG = (ENABLED == ucP3En)? 0xFE : 0x00; //Lmtx port1 channel lvds_dphy lane0~4 enable control
    BKA2_62_REG = (ENABLED == ucP3En)? 0x80 : 0x00; //lmtx port1 lvds_dphy_cphy tap0 enable control
		}
		else
		{
    //Cphy
    BKA2_51_REG = (ENABLED == ucP3En)? 0xF4 : 0x10; //lmtx port0 enable & port0 ldo1 ldo2 enable
    BKA2_56_REG = (ENABLED == ucP3En)? 0xA2 : 0x00; //lp driver level2 for CTS
    BKA2_57_REG = (ENABLED == ucP3En)? 0xB2 : 0x00; //lmtx port0 mipi lprx enable control
    BKA2_58_REG = (ENABLED == ucP3En)? 0x01 : 0x00; // TODO:lmtx port0 dphy lprx channel select: lane-0
    BKA2_62_REG = (ENABLED == ucP3En)? 0xC0 : 0x00; //lmtx port0 lvds_dphy_cphy tap0 enable control
    BKA2_63_REG = (ENABLED == ucP3En)? 0x0F : 0x00; //lmtx port0 cphy channel enable & LPRX enable
    BKA2_52_REG = (ENABLED == ucP3En)? 0x10 : 0x10; //Lmtx port0 cphy p2s reset control:
    BKA2_52_REG = (ENABLED == ucP3En)? 0x30 : 0x30; //lmtx port0 p2s enable: rg_en
    if(BKA2_62_REG == 0xC0)
    {
        BKA2_5D_REG = 0x02;
        BKA2_5E_REG = 0x02;
    }
#ifdef MIPI_CHPY_HSLP_FALL_CFG_EN
    BKA2_8F_REG = 0x03;
    BKA2_91_REG = 0x30;//up
    BKA2_92_REG = 0x30;//down
    BKA2_5A_REG = 0x02;//RG_LMTX1_M_CALI_UPDOWN_SEL
    BKA2_8F_REG = 0x0f;
#endif
	}
}


void Drv_MipiTx_PhySet(u8 ucP0En,u8 ucP1En,u8 ucP2En,u8 ucP3En)
{
    Drv_MipiTx_Port0Setting(ucP0En);
    Drv_MipiTx_Port1Setting(ucP1En);
    Drv_MipiTx_Port2Setting(ucP2En);
    Drv_MipiTx_Port3Setting(ucP3En);

   // Drv_MipiTx_PortLdoRpRdCali();//LDO Rp RD 校准
}


