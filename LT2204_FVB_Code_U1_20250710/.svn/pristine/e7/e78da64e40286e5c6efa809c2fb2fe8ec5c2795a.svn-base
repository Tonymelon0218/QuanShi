}

void Drv_MipiTx_LmtxInputDataSet()
{
    SET_BIT(BKF9_00_REG, BIT2);
}

void Drv_MipiTx_LmtxSramInputSet()
{
    SET_BIT(BKF9_00_REG, BIT0);
}

void Drv_MipiTx_FrameCntSet(u8 ucFrameCntSet)
{
    if(ON == ucFrameCntSet)
    {
        SET_BIT(BKF9_70_REG, BIT3);
    }
    else
    {
        CLEAR_BIT(BKF9_70_REG, BIT3);
    }
}

void Drv_MipiTx_EotpSet(u8 ucEotpSet)
{
    if(ENABLED == ucEotpSet )
    {
        SET_BIT(BKF9_A0_REG, BIT7);
    }
    else
    {
        CLEAR_BIT(BKF9_A0_REG, BIT7);
    }
}

void Drv_MipiTx_3DModeSet(u8 uc3DMode)
{   
    LET_BITS(BKF9_87_REG, 6, 4, 0);
    switch(uc3DMode)
    {
        case MIPI_LEFT_RIGHT_MODE:
            SET_BIT(BKF9_87_REG, BIT4);
						LTLog(LOG_DEBUG,"MIPITX_3D_MODE: MIPI_LEFT_RIGHT_MODE");	
            break;
        
        case MIPI_UP_DOWN_MODE:
            SET_BIT(BKF9_87_REG, BIT5);
            break;
        
        case MIPI_ODD_EVEN_MODE:
            SET_BIT(BKF9_87_REG, BIT6);
            break;
        
        default:
						LTLog(LOG_DEBUG,"MIPITX_3D_MODE: MIPI_NO_3D_MODE");	
            break;
    }
        
}

void Drv_MipiTx_PllSrcSet()
{
    LET_BITS(BKA2_00_REG, 1,0,0x0);//0:xtal-25m 
    LET_BITS(BKA3_44_REG, 6, 4, 0x3);
}

void Drv_MipiTx_PllDivSet(u32 ulRate)
{
    u8 ucPrediv = 1;
    u8 ucLmtxpllOutPutDiv = 0; //cal LmtxpllOutPutDiv set
    u8 ucLoop = 0;
    u8 ucLmtxPllDiv = 0;
    u32 ulRateTmp = ulRate;
    
    SET_BIT(BKA2_00_REG, BIT4); //lmtxpll power down
    CLEAR_BIT(BKA2_00_REG, BIT2);//post div /2
    LET_BITS(BKA2_01_REG, 4,0,0x00);//lmtxpll prediv
    BKA2_02_REG = 0xA8; //lmtxpll cp current
    
    BKA2_04_REG = 0x00; //lmtxpll ssc half pixel clock mux and divider
    BKA2_05_REG = 0x00; // TODO:Lmtxpll output clock mux and divider
    BKA2_06_REG = 0x00; //lmtxpll tmds clock range selection
    BKA2_07_REG = 0x00; //lmtxpll output clock range selection:
    BKA2_0A_REG = 0x80; //Da_lmtxpll_div_set software output set value
    
    if((LMTXPLL_VCO_MIN_FS/2 > ulRateTmp) && (LMTXPLL_VCO_MIN_FS/2 - ulRateTmp < 1000))//如果输入频率与VCO/2 差别很小，则加一点余量，以免倍频过高达不到需要的频率
    {
        ulRateTmp += 10000;
    }
    LTLog(LOG_DEBUG,"vco DataRate: %lu, %lu",ulRateTmp,ulRate);
/*如何确定PLL分档步骤如下：
1、LMTXPLL输出为Fvco，pll_seri_clk输出为VCO的分频，pll_seri_clk分档1为1.2-2.4G，2挡为600M-1.2,因此VCO需工作在1.2-2.4G
2、输出需要根据phy的datarate计算，判断datarate处于pll_tdms的哪一个分档，可以根据倍乘来快速确定（*2）
3、确定pll_tdms分档后，就可以根据公式来计算pll环中muldiv、postdiv、cpcur以及lmtxpll_div，
Fin /prediv = Fvco/(muldiv*cpcur_set*postdiv*pll_div), Fvco = seri_div *分档，如果倍乘后Fvco超过2G，可以考虑多将muldiv、postdiv、cpcur 加一档
*/
    for (ucLoop = 0; ucLoop < 4; ucLoop++)
    {
        if (ulRateTmp < LMTXPLL_VCO_MIN_FS)
        {
            ucLmtxpllOutPutDiv++; 
            ulRateTmp <<= 1;
        }
        else
        {
            break;
        }
    }

    if(ulRateTmp > LMTXPLL_VCO_MAX_FS)
    {
        //cpcurset(1-2) 、muldivsel(1-2)0xA200-bit3 、postdivsel(1-2)0xA200-bit2、lmtxplldiv(3-127)0xA20A
        ulRateTmp >>= 1; 
        SET_BIT(BKA2_00_REG, BIT2);//post div /2
        LTLog(LOG_DEBUG,"Post div = 2");
    }

    LET_BITS(BKA2_07_REG, 2, 0, ucLmtxpllOutPutDiv); 
    LTLog(LOG_DEBUG,"A207 RG_LMTXPLL_RANGE_SEL : 0x%02bx",ucLmtxpllOutPutDiv);
    
    //cal div set
    ucLmtxPllDiv = ulRateTmp / (25 * 1000);
    if (0 != (ulRateTmp % (25 * 1000)))
    {
        ucLmtxPllDiv++;
    }

    LET_BITS(BKA2_0A_REG, 6, 0, ucLmtxPllDiv);
    SET_BIT(BKA2_0A_REG, BIT7);//LMTXPLL SW mode 
    
    
    LTLog(LOG_DEBUG,"A20A LMTXPLL_DIV_SET : 0x%02bx",ucLmtxPllDiv);

}

u8 Drv_MipiTx_PllCali()
{
    //1.配置相关模式以及分档
    //2.配置开启rg_xxxpll_pd=0              0xA200 Bit7
    //3.复位操作 rgd_xxxpll_rst_n=0 rgd_xxxpll_rst_n=1     0xE10FBIT4
    
    //4.校准使能 rgd_xxxpll_cal_en=0 rgd_xxxpll_cal_en=1       0xE263 bit3
    
    //5.判断 cal done 和 pll lock out    
        //RGOD_LMTXPLL_PLL_CAL_DONE 0xE26D bit1:calidone bit0 pll cail fail
        //RGOD_LMTXPLL_PLL_LOCK_OUT 0xE228 bit2
        
    //pll div rest 0xA210 bit7
    
      u8 ucCaliCnt = 0;

    CLEAR_BIT(BKA2_00_REG, BIT4); //Lmtxpll power Normal Work
    CLEAR_BITS(BKE1_07_REG, 3, 0);
    CLEAR_BIT(BKE1_0F_REG, BIT4);//Software control for LMTXPLL reset
    CLEAR_BIT(BKE2_63_REG, BIT3);//LMTXPLL PLL calibration enable.
    Ocm_Delay1ms(1);
    
    LET_BITS(BKE1_07_REG, 3, 0, 0xF);
    SET_BIT(BKE1_0F_REG, BIT4);//Software control for LMTXPLL reset
    
    Ocm_Delay1ms(1);
    SET_BIT(BKE2_63_REG, BIT3);//LMTXPLL PLL calibration enable.
    Ocm_Delay1ms(2);
     
    do
    {
        ucCaliCnt ++;
        Ocm_Delay1ms(5);
        
    }while((ucCaliCnt < 3) && (GET_BIT(BKE2_6D_REG, BIT1)));
    
    if(0x02 != GET_BITS(BKE2_6D_REG, BIT1, BIT0))
    {
        LTLog(LOG_ERROR, "LMTXPLL cali fail");
        return FALSE;
    }

    LTLog(LOG_DEBUG, "LMTXPLL lock flag:0x%02bx ",BKE2_28_REG);
    
    if(!GET_BIT(BKE2_28_REG, BIT2))
    {
        LTLog(LOG_ERROR, "LMTXPLL unlock");
        return FALSE;
    }

    LTLog(LOG_DEBUG, "LMTXPLL calibration bandout: 0x%02bx 0x%02bx", BKE2_74_REG, BKE2_75_REG);

    CLEAR_BIT(BKA2_10_REG, BIT7);
    SET_BIT(BKA2_10_REG, BIT7);
    
    return TRUE;

    
}

void Drv_MipiTx_PllSet(u32 ulPhyClk)
{
    Drv_MipiTx_PllSrcSet();
    Drv_MipiTx_PllDivSet(ulPhyClk);
}

void Drv_MipiTx_PhyTimingParaSet(u32 ulMipiDataRate, u8 b1MipiClockburst, u8 ucPhySel, u8 ucDphyCsi8Lane)
{
    u16 rdbyteclk ;
    rdbyteclk = ulMipiDataRate/1000 ;
    
    if(MIPITX_DPHY == ucPhySel)
    {
        rdbyteclk /= 8; 
    }
    else
    {
        rdbyteclk /= 7;
    }
    LTLog(LOG_DEBUG,"Byte clk:%uMhz",rdbyteclk);

    HS_LPX_REG = rdbyteclk * 60 / 1000 + 1;//hs lpx > 50ns
    HS_PREP_REG = rdbyteclk * 50 / 1000 + 1;//hs prep : (40ns + 4*UI)~(85ns + 6*UI) , clk_prepare
    HS_TRAIL = rdbyteclk * 7 / 100 + 4; //hs_trail and clk_trail: 60ns + 4UI ~105+12UI;
    
    CLK_ZERO_REG = rdbyteclk * 6 / 25;    //ck_zero > 300 - ck_prpr , old: rdbyteclk/4
    CLK_POST_REG = rdbyteclk * 7 / 100 + 7;//ck_post > 60ns + 52UI,  +4->+15->+1    
    
    if ( MIPITX_DPHY == ucPhySel  )
    {
        if(ON == b1MipiClockburst)
        {
            //CLK_PRE_REG = 0x00; //clk_pre  > 8 UI
            CLK_ZERO_REG = rdbyteclk * 6 / 25 + 7;    //ck_zero > 300 - ck_prpr , old: rdbyteclk/4
            //CLK_ZERO_REG = rdbyteclk * 6 / 100+5;
            CLK_POST_REG = rdbyteclk * 7 / 100 + 7;//ck_post > 60ns + 52UI,  +4->+15->+1
            HS_RQST_PRE_REG = HS_LPX_REG + 0x67; 
        }
        else
        {
            HS_RQST_PRE_REG = rdbyteclk / 10; 
        }
        
        if (ENABLED == ucDphyCsi8Lane)
        {
            HS_RQST_PRE_REG = HS_LPX_REG + HS_PREP_REG + 10; 
        }
    }
    else
    {
        CLK_POST_REG = 30; //t3-post
        HS_RQST_PRE_REG = HS_LPX_REG + 0x32;

        //cphy CTS test 
//        CLK_POST_REG = 0x10;
//        HS_RQST_PRE_REG = 0x20;
        
    }

    LTLog(LOG_DEBUG, "ck_post (0xF9A9) = 0x%02bx", BKF9_A9_REG);
    LTLog(LOG_DEBUG, "ck_zero (0xF9A7) = 0x%02bx", BKF9_A7_REG);
    LTLog(LOG_DEBUG, "hs_lpx  (0xF9A4) = 0x%02bx", BKF9_A4_REG);
    LTLog(LOG_DEBUG, "hs_prep (0xF9A5) = 0x%02bx", BKF9_A5_REG);
    LTLog(LOG_DEBUG, "hs_trail(0xF9A6) = 0x%02bx", BKF9_A6_REG);
    LTLog(LOG_DEBUG, "hs_rqst (0xF98A) = 0x%02bx", BKF9_8A_REG);
}

void Drv_MipiTx_Hss_Set(IN u16 usVal)
{
    if( usVal > 0x3FF )
    {
        usVal = 0x3FF;
    }

    LET_BITS(BKF9_84_REG, BIT1, BIT0, GET_16BIT_HIGH(usVal));
    BKF9_85_REG = GET_16BIT_LOW(usVal);
}

u16 Drv_MipiTx_Hss_Get(void)
{
    u16 rdhss;
    rdhss = PACK_16_BIT(BKF9_84_REG&0x03, BKF9_85_REG);
    return rdhss;
}


u16 Drv_MipiTx_FSMHact_Get(void)
{
    u16 rgod_hact;
    rgod_hact = PACK_16_BIT(BKF9_C1_REG & 0x3f, BKF9_C2_REG);
    return rgod_hact;
}

void Drv_MipiTx_FifoDelay_Set(IN u16 rddly)
{
    BKF9_82_REG = GET_16BIT_HIGH(rddly);
    BKF9_83_REG = GET_16BIT_LOW(rddly); //MIPI FIFO read delay:d'96
}


void Drv_MipiTx_DPhySkewCali(void)
{
    SET_BITS(BKF9_AB_REG, BIT3, BIT0); 
    BKF9_AC_REG = 0x18; 
    BKF9_AD_REG = 0x00; 
    BKF9_AE_REG = 0x10; 
    SET_BIT(BKF9_AB_REG, BIT4);
    Ocm_Delay1ms(5);
    CLEAR_BIT(BKF9_AB_REG, BIT4);
    BKF9_AE_REG = 0x00; 
}


void Drv_MipiTx_DPhyClkHsTrig(void)
{
    CLEAR_BIT(BKF9_AB_REG, BIT5);
    Ocm_Delay1ms(5);
    SET_BIT(BKF9_AB_REG, BIT5); //[5]:Dphy clk lane hs mode initial trigger
    Ocm_Delay1ms(1);
    CLEAR_BIT(BKF9_AB_REG, BIT5);
}

#if ((CHIP_SEL == LT6911GXD_HD) || (CHIP_SEL == LT7911UXE_HD))
u8 Drv_MipiTx_VideoReadyDetect(void)
{
		u16 Htotal,Hactive,Vtotal,Vactive;
		u8 Colorspace,Colordepth;
	
		if(BKE0_84_REG != 0x01)
		{
				BKE0_84_REG = 0x01;
			
				/*pixelclock:0xE085~0xE087*/
				BKE0_85_REG = (g_stMipiTx.ulMipiInClk*2 >> 16);//&0x0F;
				BKE0_86_REG = (g_stMipiTx.ulMipiInClk*2 >> 8);
				BKE0_87_REG = (g_stMipiTx.ulMipiInClk*2);
			
				/*resolution:0xE088~0xE08F*/
				Htotal    = Drv_VideoCheckSingle_Get(HTOTAL_POS);
				Hactive   = Drv_VideoCheckSingle_Get(HACTIVE_POS);
				Vtotal    = Drv_VideoCheckSingle_Get(VTOTAL_POS);
				Vactive   = Drv_VideoCheckSingle_Get(VACTIVE_POS);
			
				BKE0_88_REG = GET_16BIT_HIGH(Htotal);
				BKE0_89_REG = GET_16BIT_LOW(Htotal);
				BKE0_8A_REG = GET_16BIT_HIGH(Vtotal);
				BKE0_8B_REG = GET_16BIT_LOW(Vtotal);
				BKE0_8C_REG = GET_16BIT_HIGH(Hactive);
				BKE0_8D_REG = GET_16BIT_LOW(Hactive);
				BKE0_8E_REG = GET_16BIT_HIGH(Vactive);
				BKE0_8F_REG = GET_16BIT_LOW(Vactive);
				
				/*Byteclock:0xE092~0xE093*/
				BKE0_92_REG = ((g_stMipiTx.ulMipiDataRate/8)>>16);//&0x0F;
				BKE0_93_REG = ((g_stMipiTx.ulMipiDataRate/8)>>8);
				BKE0_94_REG = (g_stMipiTx.ulMipiDataRate/8);
				
				/*colorspace*/
				#if ((HDMIRX_DSC_BYPASS_SUPPORT == ENABLED)||(HDMIRX_DSC_DEC_SUPPORT == ENABLED))
				if (Drv_HdmiRx_DscDecState() == ENABLED)
				{
						Colorspace = g_stHdmiRxDscByInfo.ucColorSpace;
						Colordepth = (g_stHdmiRxDscByInfo.ucColorDepth << 1);
						BKE0_95_REG = Colorspace;
						BKE0_96_REG = Colordepth;
				}
				else
				#endif
				{
						Colorspace = ((BKCC_A3_REG & 0x60) >> 5);//pb1[7:5]0-rgb, 1-422, 2-444, 3-420
						BKE0_95_REG = Colorspace;
						Colordepth = (BKCC_D7_REG  & 0x0f);//[3:0]color depth: 4-8bit, 5-10bit, 6-12bit
						switch(Colordepth)
						{
								case 0x00:
								case 0x04:
									BKE0_96_REG = 8;
								break;
								
								case 0x05:
									BKE0_96_REG = 10;
								break;
								
								case 0x06:
									BKE0_96_REG = 12;
								break;
								
								default:
									BKE0_96_REG = 0;
								break;
						}
				}
				/********Mipi:0xE0A0~0xE0AF********/
				/*Lane*/
				BKE0_A0_REG = g_stMipiTx.ucTxLaneNum;
				BKE0_A1_REG = g_stMipiTx.ucTxPortNum;
				
			  return 1;
		}
		else
		{
			  return 0;
		}
}

void Drv_MipiTx_EnableControl(void)
{
		if(BKE0_B0_REG == 0x00)
		{
				if(BKF9_89_REG & 0x30)
				{
						Drv_MipiTx_VideoSet(OFF);
						printLT(PRINT_PRIO_TEST, "\nVIDEO_OUT_PUT_OFF!");
				}
		}
		else if(BKE0_B0_REG == 0x01)
		{
				if((BKF9_89_REG & 0x30) == 0x00)
				{
						Drv_MipiTx_VideoSet(ON);
						printLT(PRINT_PRIO_TEST, "\nVIDEO_OUT_PUT_ON!");
				}
		}
}
