              void Mod_CC2CCOff_Det(void)  //DCC 断开时，UCC做快速触发
              {
                  if((DCCStatus.b1FrTriggle == TRUE)&&(UCCStatus.b1PrDone == TRUE)) //
                  {
                      DRV_FrTrig_Send();   //
                      UCCStatus.ucFRSwaping = FRSWAP_INITIATE;  //
              //        SOURCE_GPIO_CTRL(LOW); //
                  }
                  else
C51 COMPILER V9.53.0.0   MODCC2MSGTYPEC                                                    02/13/2025 10:14:00 PAGE 3   

                  {
                      DCCStatus.b2Charger_Scan = PDSCANSTART;
              //        SOURCE_GPIO_CTRL(TRUE); //
                  }
                  Mod_CC2PowerLost_VarIni();
              }
              
              #endif
              void Mod_CC2Pd_Interrupt(void)
              {
                  static u8 ucDccMsgLength;
                  static u8 ucDccExtMsg;
                  static u8 ucDccMsgType;
                  static u8 ucDccTypecInt;
                  static u8 ucDccKeyCode;
                  static u8 ucDccRXCount;
              
                  #if TYPEC_FRSWAP_EN  == ENABLED
                      #if VBUS_DET == ENABLED
                  u8 Typec_Vbus_Off;
                  Typec_Vbus_Off = BKFC_9B_REG & BIT0_1;
                      #endif
                  #endif
                  ucDccTypecInt = BKFC_B6_REG;
                  BKFC_B6_REG = 0xeb;
                  BKFC_9B_REG = 0xff;
                  if(ucDccTypecInt & BIT7_1)//rcv_keycode_rdy
                  {
                      #if TYPEC_FRSWAP_EN  == ENABLED
                      if((BKFC_B0_REG&0xf0)==0x00)
                      {
                          Mod_CC2CCOff_Det();
                      }
                      #endif
                  }
                  if(ucDccTypecInt & BIT6_1)//rcv_keycode_rdy
                  {
                      ucDccRXCount = 0;
                      ucDccKeyCode =(BKFC_9C_REG & 0x07);
                      BKFC_9C_REG = 0xf8;
                      if(ucDccKeyCode == SOP)//check sop
                      {
                          BKFC_97_REG &= BIT4_0;//en auto goodcrc
                      }
                      else
                      {
                          BKFC_97_REG |= BIT4_1;//disable auto goodcrc
                      }
                  }
              
                  if(ucDccTypecInt & BIT0_1)//rcv_header
                  {
                      DCCMSG.szHeader[1] = BKFC_BB_REG;
                      DCCMSG.szHeader[0] = BKFC_BA_REG;
                      ucDccMsgType   = (DCCMSG.szHeader[0] & 0x1f);
                      ucDccMsgLength = ((DCCMSG.szHeader[1] & 0x70) >> 2);
                      ucDccExtMsg = (DCCMSG.szHeader[1] & BIT7_1)?(1):(0);
                      if((BKFC_B6_REG & BIT5_1) == 0x00)
                      {
                          ucDccTypecInt &= BIT5_0;
                      }
                  }
C51 COMPILER V9.53.0.0   MODCC2MSGTYPEC                                                    02/13/2025 10:14:00 PAGE 4   

              
                  if((ucDccTypecInt & BIT5_1) == 0x00)//rx_fifo_empty
                  {
                      do
                      {
                          DCCMSG.szRcvDate[ucDccRXCount] = BKFC_A3_REG;
                          ucDccRXCount++;
                          ucDccTypecInt |= BKFC_B6_REG;
                      } while((ucDccTypecInt & BIT5_1) == 0x00);
                      ucDccTypecInt |= BKFC_B6_REG;
                  }
              
                  if(ucDccTypecInt & BIT4_1) //eop level
                  {
                      BKFC_B6_REG |= BIT4_1;
                      if(UCCStatus.b1PsRdy_Send)
                      {
                          ;
                      }
                      else
                      {
                          TR2 = 0;
                      }
                      ucDccTypecInt = BKFC_B6_REG;
                      ucDccRXCount = 0;
                      DCCStatus.ucRetryCounter = 0;
              
                      DCCMSG.b1RcvGoodCRC = TRUE;
              
                      if(ucDccKeyCode == SOP)//check sop
                      {
                          if((!ucDccMsgLength)&&(ucDccMsgType == GoodCRC))
                          {
                              ;
                          }
                          else
                          {
                              DCCMSG.b1SendEN = TRUE;
                          }
                      }
                      else
                      {
                          DCCMSG.b1SendEN = FALSE;
                      }
                      if((ucDccMsgLength)||(ucDccMsgType != GoodCRC))//message
                      {
                          ;
                      }
                      else//goodcrc
                      {
                          DCCStatus.b1CCDataMsg_Sent = FALSE;
                      }
                  }
              
                  #if TYPEC_FRSWAP_EN  == ENABLED
                      #if VBUS_DET == ENABLED
                  if(Typec_Vbus_Off == BIT0_1)
                  {
                      if(BKFC_95_REG & BIT0_1)//INT ENABLE
                      {
                          Mod_CC2VbusOff_Det();
                      }
C51 COMPILER V9.53.0.0   MODCC2MSGTYPEC                                                    02/13/2025 10:14:00 PAGE 5   

                      else
                      {
                          ;
                      }
                  }
                      #endif
                  #endif
              
                  if(ucDccTypecInt & BIT2_1)//Send Over
                  {
                      BKFC_B6_REG = BIT2_1;
                      if(DCCStatus.b1CCDataMsg_Sent == TRUE)
                      {
                          DCCStatus.b1CCDataMsg_Sent = FALSE;
                          Ocm_TR2_ValueSet();
                          TR2 = 1;
                      }
              
                      if(DCCMSG.b1SendEN == TRUE)
                      {
                          DCCMSG.b1SendEN = 0;
                          if(ucDccKeyCode == SOP)//needed,or SOP' will be sended
                          {             
                              Mod_CC2Msg_Deal(ucDccMsgType, ucDccMsgLength, ucDccExtMsg);            
                          }
                      }
                  }    
              }
              
              #endif
 269          #endif


