              void Mod_CC2MsgSend_Retry(void)
              {
                  if(DCCMSG.b1RcvGoodCRC == FALSE)
                  {
                      DCCStatus.b1Msg_ID_Change = FALSE;
                      if(DCCStatus.ucRetryCounter <  DCCStatus.ucnRetryCount)
                      {       
                          DCCMSG.pDataOrder = DCCMSG.pBuffer_Order;
                          Mod_CC2Msg_Send();
                          Ocm_TR2_ValueSet();            //TR2 = 1;           
                      }
                      else
                      {
                                      DRV_RpCur_Sel(DCC,Rp_SinkTxNG);
                          DRV_PowerRole_Set(DCC,SOURCE);
                          Ocm_Delay1ms(50);
                          DRV_PowerRole_Set(DCC,SINK);
                          DCCStatus.b1Msg_ID_Change = TRUE;
                          DCCMSG.b1RcvGoodCRC = TRUE;
                          DCCStatus.ucRetryCounter = 0; 
                      }
                  }
              }
              
              void Mod_CC1PsRdy_Send(void)
              {
                  if(UCCStatus.ucPRSwaped == 5)
                  {
                      UCCStatus.b1PrDone = FALSE;
                      UCCStatus.ucPRSwaping = 2;
                      UCCStatus.ucPRSwaped = 6;
                      UCCStatus.b1PowerRole = FALSE; 
                      DRV_PowerRole_Set(UCC,SINK);
                      Ocm_Delay1ms(2);      
                  }
                  #if TYPEC_FRSWAP_EN == ENABLED
                  DCCStatus.b1FrTriggle = FALSE;
                  Drv_CC2VoltageLvl_Det();
                  DCCStatus.b1FrTriggle = TRUE;
                  #endif
                  UCCStatus.b1PsRdy_Send = FALSE;
                  #if TYPEC_FRSWAP_EN  == ENABLED
                      #if VBUS_DET == ENABLED
                  Drv_Cc2VbusDet_IntClr(TRUE);
                  Drv_Cc2VbusDet_IntSet(ENABLED);
                      #endif  
C51 COMPILER V9.53.0.0   MODCC2MSGTYPEC                                                    02/13/2025 10:14:00 PAGE 2   

                  #endif
                  if(UCCStatus.b1PrSwapDone == TRUE)
                  {
                      UCCStatus.b1PrSwapDone = FALSE;
                      UCCStatus.ucPRSwaping = 1;//PRSwap Done and go to cc off detect for CVTE Chrombook issue
                  }
                  //to solve lenovo PD30 issue
                  if(UCCStatus.ucFRSwaping == FRSWAP_ONGOING)
                  {
                      DRV_PowerRole_Set(UCC,SINK);
                  }
                  if(UCCAmsType.ucPrSwap_Ams == AMS_GOEXP)
                  {
                      UCCAmsType.ucPrSwap_Ams = AMS_DONE;
                  }
                  UCCMSG.pDataOrder = szCC_CtrlMsg[1];    //send PS_RDY //UFP_SINK 7
                  UCCMSG.ucLastMsgType = Mod_CC1MsgType_Calc(Ctrl_Msg,PS_RDY,StrVdm);
                  Mod_CC1Msg_Send();    
                  UCCStatus.ucFlow_Step = 1;
              }
              
              void Mod_CC2PowerLost_VarIni(void)
              {
                  ADAPTER_GPIO_CTRL(LOW);
                  #if DCC_TOGGLE_SUPPORT == ENABLED
                  DCCStatus.b1DccUfpMode = FALSE;
                  DCCStatus.b1DccDfpMode = FALSE;
                  #endif
                  DCCStatus.b1FrTriggle = FALSE;
                  DCCStatus.b1AdapterWithPD = FALSE;
                  UCCStatus.b1PrDone = FALSE;
                  UCCStatus.b1DataRole = FALSE;
                  UCCStatus.ucPRSended = 0;
                  UCCStatus.ucPRSwaping = 0;
                  UCCStatus.ucPRSwaped = 0;        
                  UCCStatus.ucFlow_Step = 0;
                  UCCAmsType.ucPrSwap_Ams = AMS_NONE;
              //        DCCStatus.ucDccState_Tmp = 0;
                  #if NINTENDO_SWITCH == ENABLED
                  CC1NINTENDOState.b2Switch_Ada_Online = NOT_SWITCH;
                  #endif
                  BKFC_3D_REG &= BIT6_0;//FR swap gen en //FOR CTS:TEST PD PHY 08
              }
