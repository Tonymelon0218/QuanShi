//================================
//the function is used to send DCC message;
//if length is shorter than 10bytes,the data is sent once together;
//if longer than 10bytes,data is sent two times
//
//
//================================
void Mod_CC2Msg_Send(void)
{
    u8 ucSendData;
	u8 ucSendMegSndDataOffset;
    static u8 ucDccTotalData;
	static u8 ucMessage_ID_Send = 0x00;
	DCCMSG.pBuffer_Order = DCCMSG.pDataOrder;
	ucDccTotalData = ((DCCMSG.pDataOrder[1] & 0x70)>>2)+2;
    for(ucSendMegSndDataOffset=0; ucSendMegSndDataOffset<ucDccTotalData; ucSendMegSndDataOffset++)
    {
        ucSendData = *DCCMSG.pDataOrder;
        DCCMSG.pDataOrder++;
        if(ucSendMegSndDataOffset < 10)
        {
            if(ucSendMegSndDataOffset == 1)
            {		
                ucSendData &=0xF0;
                if(DCCStatus.b1Msg_ID_Change == TRUE)
                {
                    ucMessage_ID_Send = DCCMSG.ucMessageID;
                    DCCMSG.ucMessageID = Mod_CCPortMsgId_Cal(DCCMSG.ucMessageID);	
                }
                else
                {
                    ;
                }
                ucSendData=(ucSendData|ucMessage_ID_Send);
                (DCCStatus.b1PowerRole)?(ucSendData |= BIT0_1):(ucSendData &= BIT0_0);
            }
		
            else if(ucSendMegSndDataOffset == 0)
            {
                ucSendData &= 0x1F;       //ufp pd2.0
                #if PD_PPS_EN == ENABLED
                if(DCCMSG.ucCcVersion < PD30)
                {
                    ucSendData |=  BIT6_1;
                }
                else
                {
                    ucSendData |=  BIT7_1;
                }
                #else
                ucSendData |= BIT6_1;
                #endif
                (DCCStatus.b1DataRole)?(ucSendData|= BIT5_1):(ucSendData &= BIT5_0);
            }
        }
		else if(ucSendMegSndDataOffset==10)
        {        
            BKFC_99_REG = 0x09; 
        }
        BKFC_9A_REG	= ucSendData;   
    }
	if(ucSendMegSndDataOffset > 10)
    {
        ;
    }
    else
    {
        BKFC_99_REG = 0x09; 
    }
    BKFC_A3_REG = 0x01; //clr rx fifo
    BKFC_98_REG |= BIT3_1;	  //mark all data done
    BKFC_98_REG &= BIT3_0;
	Mod_CCPortMsg_Retry(DCC);	
}
//================================
//
//the function is handle DCC VDM message
//ucMsg_Type:VDM type
//
//================================
void Mod_CC2VdmMsg_Analysis(void)
{
    switch(DCCMSG.szRcvDate[0]&0x1F)  //Command
    {
        case Discover_Identity :
            Mod_DiscoverID_Handle(DCCMSG.ucCcVersion,DCCMSG.szRcvDate,PDACK);
            DCCMSG.pDataOrder = szCC_DiscoverIDMsg;
            Mod_CC2Msg_Send();
            break;
        case Discover_SVIDs :
			//================================
			//remove DP alt mode from message in case of DP alt mode commuication happens 
			//================================
            memcpy(DCCMSG.szCC_ModeMsg_Buffer,szCC_DataMsg[2],10);
            DCCMSG.szCC_ModeMsg_Buffer[8] = 0x00; 
            DCCMSG.pDataOrder = DCCMSG.szCC_ModeMsg_Buffer;
            Mod_CC2Msg_Send();
            break;
        default :
            break;
    }
}
//================================
//
//the function is handle DCC message
//ucMsg_Type:message type;control,data,chunked
//ucLength:Control or data message
//ucExt:extended and not extended message
//================================
void Mod_CC2Msg_Deal(u8 ucMsg_Type,u8 ucLength,u8 ucExt)  //DFP message
{
    if(ucExt == 0x00)//Not Extended message
    {
        if(ucLength == 0x00)   //Control Message
        {
            switch(ucMsg_Type)
            {
                case GoodCRC      	            :
                case GotoMin                    ://Goto Mim
                case Accept                     :
                case Reject                     :
                case Ping                       :
                case Wait                       :               
                case Not_Support                :                                          
                        break;
                case PS_RDY                     :
                    if(DCCStatus.ucFlow_Step == 2)
                    {
                        DCCStatus.ucFlow_Step = 1;//Nego Done
                    }
                    if((Drv_CC2On_Det(SINK) == TRUE)&&(UCCStatus.ucPRSended == 0)&&(UCCStatus.b1PowerRole == FALSE))//DCC IS IN
                    {
                        if(Mod_CC1DetOff_Judge() == FALSE)
                        {
                            UCCStatus.ucPRSended = 1;
                        }
                    }
                    if((!UCCStatus.b1PsRdy_Send)&&(UCCStatus.b1PrDone)) //DFP_SOURCE 4 UFP_SINK 7
                    {
                        #if VCONNSWAP_SUPPORT == ENABLED     
                        if(((UCCStatus.ucSwap_Sent&Vconn_Sent) == 0)&&(UCCStatus.b1IsVconnSource == TRUE))
                        {
                            UCCStatus.b1VconnSwap_En = TRUE;
                        }
                        else
                        {
                            Mod_Cc1DrSwap_Set();
                        }
                        #else
                    	if((UCCStatus.ucSwap_Sent & DR_Sent)== 0)
                        {
                            Mod_Cc1DrSwap_Set();
                        }
                        #endif
                        UCCStatus.b1PsRdy_Send = TRUE;
                        Ocm_Timer2ForPsRdy_Set();
                    }
                    break;                  
                case DR_Swap                    :   
                case PR_Swap                    :  
                case FR_Swap                    :
                case VCONN_Swap                 :
                case Get_Source_Cap             :
//Reject                    
                    DCCMSG.pDataOrder = szCCCtrl_Reject; //send Reject
                    Mod_CC2Msg_Send();
                    UCCMSG.ucLastMsgType = 0xFF;
                    break;
                case Get_Source_Cap_Extended    :
                case Get_Status                 :
                case Get_PPS_Status             :
                case Get_Country_Codes          :
//Not Support
                    DCCMSG.pDataOrder = szCCCtrl_NotSupport; //send Not Support
                    Mod_CC2Msg_Send();
                    UCCMSG.ucLastMsgType = 0xFF;
                    break;               
                case Get_Sink_Cap   :
                    DCCMSG.pDataOrder = szCC_DataMsg[13];
                    Mod_CC2Msg_Send();
                    break;
                case Soft_Reset     :
                    DCCMSG.ucMessageID = 0;
                    DCCMSG.pDataOrder = szCCCtrl_Accept;
                    Mod_CC2Msg_Send();
                    break;
                default         :
                    break;
            }
        }
        else//Data Message
        {
            switch (ucMsg_Type)
            {
                case Source_Capabilities   :
                    #if PD_PPS_EN == ENABLED
                    DCCMSG.ucCcVersion = (DCCMSG.szHeader[0]&0xc0)>>6;
                    #endif
                    DCCStatus.b1AdapterWithPD = TRUE; //20210804
				    //如果适配器是可变功率，在充电完成后发新的sourcecap，程序会进入FRSwap导致流程异常；
                    //此处做一下限制，将电压检测拉低避免出现电压跌落问题从而触发FR Swap，如果有中断也可以关掉中断
                    DCCStatus.ucFlow_Step = 2;
                    BKA2_BA_REG = 0x08;//400mv
					#if DCCRequest_PointedVol == ENABLED
					Mod_CCPortSaveDataToTmp(&DCCMSG,ucLength);
					Mod_CCPortToPointedPdo(&DCCMSG,ucLength,&DCCStatus);
					Mod_CCPortRequestMsg_Cal(&DCCMSG,0x00,DCCStatus.ucRequestPdo);//unchunked
					#else
					Mod_CCPortSaveDataToTmp(&DCCMSG,ucLength);
					Mod_CCPortRequestMsg_Cal(&DCCMSG,0x00,DCCStatus.ucRequestPdo);//unchunked
                    Mod_CC2SourceCap_Cal(ucLength);
					#endif					
                    DCCMSG.pDataOrder = DCCMSG.szRequest_Buffer; //send Request
                    Mod_CC2Msg_Send();
                    UCCMSG.ucLastMsgType = Mod_CC1MsgType_Calc(Data_Msg,Request,StrVdm);
                    break;
                case Request               :
                    #if PD_PPS_EN == ENABLED
                    DCCMSG.ucCcVersion = (DCCMSG.szHeader[0]&0xc0)>>6;
                    #endif
                    break;
                case Vendor_Defined        :
                    Mod_CC2VdmMsg_Analysis();
                    break;
                default                    :
                    break;
            }
        }
    }
}


#endif
