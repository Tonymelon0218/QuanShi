#include "Include.h"

#define SWITCH_NO_15V  0
#define SWITCH_15V_OK  1
#define SWITCH_15V_NG  2

#if TYPECTX_EN == ENABLED

u16 Mod_AdapterCur_Set(u16 AdapterCur,u16 ValueSet)
{
    (AdapterCur>ValueSet)?(AdapterCur -= ValueSet):(AdapterCur = 50);
    return AdapterCur;
}
#if DCCRequest_PointedVol == DISABLED
//================================
//
//the function is recalculate DCC's power information
//ucDataLength:adapter's sourcecap datalength
//
//================================
void Mod_CC2SourceCap_Cal(u8 ucDataLength) //SOURCE CAP FOR THE SOURCE
{
    u8 Adtmp;
	u8 AdapterTmpLenth= 0;
    u8 loop_Adatper;
    u16 Adapter_Cur_Cap;
    u16 Adapter_Vol_Cap;
//	u32 Adapter_Wat_Cap = 0x00;
    #if NINTENDO_SWITCH == ENABLED
    #if FORCE_NINTENDO_SWITCH == ENABLED
    u8 b2CurrentChange;
    #endif
    #endif
	#if PD_PPS_EN == ENABLED
	u8 Loop_PPS_Cnt;
	u8 PPS_Max_Vol = 0;
	u8 PPS_Max_Cur = 0;
	u16 PPS_Wat_Cap = 0;
	Loop_PPS_Cnt = 0;
	memset(DCCMSG.szPPS_Object,0x00,3);
	#endif
	#if NINTENDO_SWITCH_FORALL == ENABLED
	CC1NINTENDOState.b2Switch_Ada_Online = SWITCH_ADAPTER_ALL;
	#else
    #if NINTENDO_SWITCH == ENABLED
    CC1NINTENDOState.b2Switch_Ada_Online = NOT_SWITCH;
    #endif
	#endif
	UCCMSG.szPDP_Value[0] = 0x07;
	UCCMSG.szPDP_Value[1] = 0x07;
	AdapterTmpLenth	= ucDataLength + 2;
	//SWITCH  TEST
    //memcpy(DCCMSG.szAdapterTmp,szCC_SourceCapFix,30);
    DCCMSG.szAdapterTmp[0] &= 0x0F;
    DCCMSG.szAdapterTmp[0] |= 0x40;
    
    DCCMSG.szAdapterTmp[4] &= 0x3f;//b23 b22 set to 0
    

    memcpy(DCCMSG.szAdapterTmpFor3A,DCCMSG.szAdapterTmp,sizeof(DCCMSG.szAdapterTmp));
    
	memcpy(DCCMSG.szAdapterCap_Ori,DCCMSG.szAdapterTmp,sizeof(DCCMSG.szAdapterTmp));
	//SWITCH TEST
    //memcpy(DCCMSG.szAdapterCap_Ori,szCC_SourceCapFix,30);
    #if FORCE_NINTENDO_SWITCH == ENABLED
    memcpy(DCCMSG.szSwitchTmp,DCCMSG.szAdapterTmp,sizeof(DCCMSG.szAdapterTmp));
    #endif
	#if PD_PPS_EN == ENABLED
	memcpy(DCCMSG.szAdapterCap_For_PD30,DCCMSG.szAdapterTmp,sizeof(DCCMSG.szAdapterTmp));
	#endif
	for(Adtmp = 2; Adtmp < AdapterTmpLenth ; Adtmp += 4)
	{
        #if FORCE_NINTENDO_SWITCH == ENABLED
        b2CurrentChange = SWITCH_NO_15V;
        #endif
		if((DCCMSG.szAdapterTmp[Adtmp+3]&0xc0) == 0xc0) //PPS Package
		{		
			for(loop_Adatper = Adtmp; (loop_Adatper+4) < AdapterTmpLenth; loop_Adatper++)
			{
				DCCMSG.szAdapterTmp[loop_Adatper] = DCCMSG.szAdapterTmp[loop_Adatper+4];
			}		
			#if PD_PPS_EN == ENABLED
			if(DCCMSG.szAdapterCap_For_PD30[Adtmp] > 8)//reduce 400mA
			{
				DCCMSG.szAdapterCap_For_PD30[Adtmp] -= 8;
			}
			else
			{
				;
			}
            //if Min Vol is lower than 5V ,limit to 5V
            if(DCCMSG.szAdapterCap_For_PD30[Adtmp+1] < 50)
			{
				DCCMSG.szAdapterCap_For_PD30[Adtmp+1] = 50;
			}
			//[0-6]:Cur;[8-15]:min Vol;[17-24]:max vol;
			PPS_Max_Cur = DCCMSG.szAdapterCap_For_PD30[Adtmp]; 
			PPS_Max_Vol = DCCMSG.szAdapterCap_For_PD30[Adtmp+3];
			PPS_Max_Vol <<= 7;
			PPS_Max_Vol = PPS_Max_Vol|(DCCMSG.szAdapterCap_For_PD30[Adtmp+2]>>1);
			PPS_Wat_Cap = (u16)(PPS_Max_Vol)*(PPS_Max_Cur);
			PPS_Wat_Cap = PPS_Wat_Cap / 200;//Watt
			if(UCCMSG.szPDP_Value[1] > PPS_Wat_Cap)
			{
				;
			}
			else
			{
				UCCMSG.szPDP_Value[1] = PPS_Wat_Cap;
			}
			DCCMSG.szPPS_Object[Loop_PPS_Cnt] = (Adtmp>>2)+1;
			Loop_PPS_Cnt++;
			#else
			//对于没有EMark的，干掉For 3A的PPS 
			DCCMSG.szAdapterTmpFor3A[1] -= 0x10;
			DCCMSG.szAdapterTmp[1] -= 0x10;
            #if (NINTENDO_SWITCH_FORALL == ENABLED)
            DCCMSG.szSwitchTmp[1] -= 0x10;
            #endif
			AdapterTmpLenth -=4;
			(Adtmp == 2)?(Adtmp = 0xfe):(Adtmp -= 4);
			#endif
		}
		else   //FIXED SUPPLY
		{            
            Adapter_Cur_Cap	= ((u16)(DCCMSG.szAdapterTmp[Adtmp+1]&0x03)<<8) + DCCMSG.szAdapterTmp[Adtmp] ;
			Adapter_Vol_Cap = ((u16)(DCCMSG.szAdapterTmp[Adtmp+2]&0x0f)<<6) + ((DCCMSG.szAdapterTmp[Adtmp+1]&0xfc)>>2);	
            //5V- 5W
            //9V-5.5W
            //12V-8W，限制3A
            //15V-8W,不超过3A，优先保证SWITCH
            //20V -47W以下扣除5W
            //47-65W 扣除8W
            //65W -93W扣除10W
            //93W-100W扣除14W
            //100W以上限制到98W
			if(Adapter_Vol_Cap < 120)      //5v
            {
				Adapter_Cur_Cap = Mod_AdapterCur_Set(Adapter_Cur_Cap,100);
            }
            else if(Adapter_Vol_Cap < 190) //9v
            {
                Adapter_Cur_Cap = Mod_AdapterCur_Set(Adapter_Cur_Cap,61);
            }
            else if(Adapter_Vol_Cap < 280)//12v
            {
                Adapter_Cur_Cap = Mod_AdapterCur_Set(Adapter_Cur_Cap,66);
            } 
            else if(Adapter_Vol_Cap == 300)//15v
            {              
                #if NINTENDO_SWITCH == ENABLED
                if(Adapter_Cur_Cap >= 260)
                {					
                    Adapter_Cur_Cap = 260;
                    CC1NINTENDOState.b2Switch_Ada_Online = SWITCH_ADAPTER; 
                    #if FORCE_NINTENDO_SWITCH == ENABLED
                    b2CurrentChange = SWITCH_15V_OK;
                    #endif
                }
                else
                {
                    #if FORCE_NINTENDO_SWITCH == ENABLED
                    Adapter_Cur_Cap = Mod_AdapterCur_Set(Adapter_Cur_Cap,53);
                    CC1NINTENDOState.b2Switch_Ada_Online = SWITCH_ADAPTER_15V; 
                    #if FORCE_NINTENDO_SWITCH == ENABLED
                    b2CurrentChange = SWITCH_15V_NG;
                    #endif
                    #else
                    Adapter_Cur_Cap = Mod_AdapterCur_Set(Adapter_Cur_Cap,53);
                    #endif
                }	
                #else
                Adapter_Cur_Cap = Mod_AdapterCur_Set(Adapter_Cur_Cap,53);
                #endif
            }
            else if(Adapter_Vol_Cap < 300)//15v
            {                
                Adapter_Cur_Cap = Mod_AdapterCur_Set(Adapter_Cur_Cap,58);               
            }
            else if(Adapter_Vol_Cap == 400)						//20v
            {
                if(Adapter_Cur_Cap > 500)//>5A
                {
                    Adapter_Cur_Cap = 490;//4.9A
                }
                else if(Adapter_Cur_Cap > 465)//93W--14W
                {
                    Adapter_Cur_Cap -= 70;
                }
                else if(Adapter_Cur_Cap > 325)//65W<->93W--10W
                {
                    Adapter_Cur_Cap -= 50;
                }
                else if(Adapter_Cur_Cap > 325)//47W<->65W--8W
                {
                    Adapter_Cur_Cap -= 40;
                }
                else
                {
                    Adapter_Cur_Cap = Mod_AdapterCur_Set(Adapter_Cur_Cap,25);
                }
            }
            else
            {
                Adapter_Cur_Cap = Mod_AdapterCur_Set(Adapter_Cur_Cap,45);
            }  
            //limit current to 3A
            if(Adapter_Vol_Cap != 400)	
            {
                if(Adapter_Cur_Cap > 300)
                {
                    Adapter_Cur_Cap = 300;
                }
            }
			DCCMSG.szAdapterTmp[Adtmp] = Adapter_Cur_Cap;
			DCCMSG.szAdapterTmp[Adtmp+1] &= 0xfc;
			DCCMSG.szAdapterTmp[Adtmp+1] |= ((Adapter_Cur_Cap>>8)&0x03);           
//            #if UCC_EMARK_SUPPORT == ENABLED
            if(Adapter_Cur_Cap >= 300)//Current Bigger than 3A
            {
                Adapter_Cur_Cap = 300;
                DCCMSG.szAdapterTmpFor3A[Adtmp] = Adapter_Cur_Cap;
                DCCMSG.szAdapterTmpFor3A[Adtmp+1] &= 0xfc;
                DCCMSG.szAdapterTmpFor3A[Adtmp+1] |= ((Adapter_Cur_Cap>>8)&0x03);
            }
            else
            {
                DCCMSG.szAdapterTmpFor3A[Adtmp] = DCCMSG.szAdapterTmp[Adtmp];
                DCCMSG.szAdapterTmpFor3A[Adtmp+1] = DCCMSG.szAdapterTmp[Adtmp+1];
            }	
//            #endif            
			#if PD_PPS_EN == ENABLED
			DCCMSG.szAdapterCap_For_PD30[Adtmp] = DCCMSG.szAdapterTmp[Adtmp];
			DCCMSG.szAdapterCap_For_PD30[Adtmp+1] = DCCMSG.szAdapterTmp[Adtmp+1];
			DCCMSG.szAdapterCap_For_PD30[5] = DCCMSG.szAdapterTmp[5];//Externally Powered	
			DCCMSG.szAdapterCap_For_PD30[5] &= 0xfe;//Unchunked Extended Messages Not Supported			
            #endif
            
			#if NINTENDO_SWITCH_FORALL == ENABLED
            if(b2CurrentChange == SWITCH_15V_NG)
            {
                Adapter_Cur_Cap = 260; 
            }			
            DCCMSG.szSwitchTmp[Adtmp] = Adapter_Cur_Cap;
            DCCMSG.szSwitchTmp[Adtmp+1] &= 0xfc;
            DCCMSG.szSwitchTmp[Adtmp+1] |= ((Adapter_Cur_Cap>>8)&0x03); 
			#else
            #if FORCE_NINTENDO_SWITCH == ENABLED
            if(b2CurrentChange == SWITCH_15V_NG)
            {
                Adapter_Cur_Cap = 260; 
            }
            DCCMSG.szSwitchTmp[Adtmp] = Adapter_Cur_Cap;
			DCCMSG.szSwitchTmp[Adtmp+1] &= 0xfc;
			DCCMSG.szSwitchTmp[Adtmp+1] |= ((Adapter_Cur_Cap>>8)&0x03); 
            #endif
            #endif
//            Adapter_Wat_Cap = (u32)(Adapter_Vol_Cap)*(Adapter_Cur_Cap);
//            Adapter_Wat_Cap = (Adapter_Wat_Cap/2000);//Watt
//			if(UCCMSG.szPDP_Value[0] > Adapter_Wat_Cap)
//			{
//				;
//			}
//			else
//			{
//				UCCMSG.szPDP_Value[0] = Adapter_Wat_Cap;
//			}
            
/*			Adapter_Cur_Cap	= ((u16)(DCCMSG.szAdapterTmp[Adtmp+1]&0x03)<<8) + DCCMSG.szAdapterTmp[Adtmp] ;
			Adapter_Vol_Cap = ((u16)(DCCMSG.szAdapterTmp[Adtmp+2]&0x0f)<<6) + ((DCCMSG.szAdapterTmp[Adtmp+1]&0xfc)>>2);	
			Adapter_Wat_Cap = (u32)(Adapter_Vol_Cap)*(Adapter_Cur_Cap);
			Adapter_Wat_Cap -= 16000;                                 // 8W in 0.5mW each divide
			Adapter_Cur_Cap = (Adapter_Wat_Cap/Adapter_Vol_Cap);
			
			DCCMSG.szAdapterTmp[Adtmp] = Adapter_Cur_Cap;
			DCCMSG.szAdapterTmp[Adtmp+1] &= 0xfc;
			DCCMSG.szAdapterTmp[Adtmp+1] |= ((Adapter_Cur_Cap>>8)&0x03);
            DCCMSG.szAdapterTmp[5] = 0x2e;//Externally Powered	
//			DCCMSG.szAdapterTmp[5] = ((DCCMSG.szAdapterTmp[5]&BIT3_1)|0x3e);//Externally Powered	
//			DCCMSG.szAdapterTmp[5] &= 0xee;                               //Unchunked Extended Messages Not Supported
			#if PD_PPS_EN == ENABLED
			DCCMSG.szAdapterCap_For_PD30[Adtmp] = DCCMSG.szAdapterTmp[Adtmp];
			DCCMSG.szAdapterCap_For_PD30[Adtmp+1] = DCCMSG.szAdapterTmp[Adtmp+1];
            DCCMSG.szAdapterCap_For_PD30[5] = 0x2e;
//			DCCMSG.szAdapterCap_For_PD30[5] = DCCMSG.szAdapterTmp[5];//Externally Powered	
//			DCCMSG.szAdapterCap_For_PD30[5] &= 0xfe;//Unchunked Extended Messages Not Supported			
            #endif
            Adapter_Wat_Cap = (Adapter_Wat_Cap/2000);//Watt
			if(UCCMSG.szPDP_Value[0] > Adapter_Wat_Cap)
			{
				;
			}
			else
			{
				UCCMSG.szPDP_Value[0] = Adapter_Wat_Cap;
			}   
*/            
		}
	}
    #if NINTENDO_SWITCH_FORALL == ENABLED
    if(CC1NINTENDOState.b2Switch_Ada_Online == SWITCH_ADAPTER_ALL)
    {
        memcpy(&DCCMSG.szSwitchTmp,&szNintendoSwitch_SourceCap_Msg,10);                
    }
    #endif
    DCCMSG.szAdapterTmp[5] = ((DCCMSG.szAdapterTmp[5]&BIT3_1)|0x3e);//Externally Powered	
    DCCMSG.szAdapterTmp[5] &= 0xee;                               //Unchunked Extended Messages Not Supported

    DCCMSG.szAdapterTmpFor3A[5] = ((DCCMSG.szAdapterTmpFor3A[5]&BIT3_1)|0x3e);//Externally Powered	
    DCCMSG.szAdapterTmpFor3A[5] &= 0xee;                               //Unchunked Extended Messages Not Supported
	#if PD_PPS_EN == ENABLED
	if(UCCMSG.szPDP_Value[0] >= UCCMSG.szPDP_Value[1])
	{
		;
	}
	else
	{
		UCCMSG.szPDP_Value[0] = UCCMSG.szPDP_Value[1];
	}
	#endif
}
