void Mod_Edid_CheckSum(u8 *pucEDID_Data)
{
    u8 ucloop;
    u8 ucCheckSum = 0x00;
    for (ucloop = 0; ucloop < 0x7F; ucloop++)
    {
        ucCheckSum += pucEDID_Data[ucloop];//checksum
    }
    pucEDID_Data[0x7F] = (256 - ucCheckSum) % 256;
}

void Mod_Check_DisIdSum(u8 *pucEDID_Data)
{
    u8 ucCheckSum = 0x00;
    u8 ucCheckSumLocation;
    u8 ucloop;
    ucCheckSumLocation = (0x05 + pucEDID_Data[0x02]);
    for (ucloop = 0x01; ucloop < ucCheckSumLocation; ucloop++)
    {
        ucCheckSum += pucEDID_Data[ucloop]; //checksum
    }
    pucEDID_Data[ucCheckSumLocation] = (256-ucCheckSum)%256;
}

void Mod_DpEdid_Init(void)
{
    memset(&g_stDpEdidInfo, 0, sizeof(EDID_S));
    g_stDpEdidInfo.ulDpLinkWidth = Mod_DpTx_LinkBandWidthGet();
}
//=======================================================Analysis=======================================================
void Mod_DpEdid_DetailTimingAnalysis(bool ucIsctaBlock, u8 *pucEDID_Data)
{
    u8 ucTempSwap;
    u8 ucLoop_Offset,ucLoop_x;
    u8 ucBlockInit,ucBlockMax;
    u8 timing_max;
    u8 loop_edid;
    u8 hblank_value;
    u8 loopy,vfreq,loop_freq;
    u16 E_pixclk,active,blank,hactive,vactive;
    u32 R_pixclk,htotal,vtotal;
    if(ucIsctaBlock == 0)
    {
        ucBlockInit = 0x36;
        ucBlockMax  = 0x6c;
    }
    else
    {
        ucBlockInit = pucEDID_Data[0x02];
        ucBlockMax  = 0x6d;
    }
    for(ucLoop_x = ucBlockInit ; ucLoop_x <= ucBlockMax ; ucLoop_x += 18)
    {
        if(pucEDID_Data[ucLoop_x+1] == 0)
        {
            continue;
        }
        if(((ucIsctaBlock == 0)&&(ucLoop_x == 0x36))||((ucIsctaBlock == 1)&&(ucLoop_x <= 0x5b))) //position
        {
            if(pucEDID_Data[ucLoop_x+19] > pucEDID_Data[ucLoop_x+1])
            {
                for(ucLoop_Offset = 0; ucLoop_Offset < 18; ucLoop_Offset++)
                {
                    ucTempSwap = pucEDID_Data[ucLoop_x+ucLoop_Offset] ;
                    pucEDID_Data[ucLoop_x+ucLoop_Offset]    = pucEDID_Data[ucLoop_x+ucLoop_Offset+18];
                    pucEDID_Data[ucLoop_x+ucLoop_Offset+18] = ucTempSwap;
                }
            }
        }
        if((pucEDID_Data[ucLoop_x+1] >= 0x85)||((pucEDID_Data[ucLoop_x] > 0xd0)&&(pucEDID_Data[ucLoop_x+1] == 0x84)))  //340M
        {
            g_stDpEdidInfo.b1Hdmi14Edid = 1;
            if(g_stDpEdidInfo.ulDpLinkWidth >= 540000)
            {
                g_stDpEdidInfo.b1Hdmi20Edid = 1;
                #if RX_PORT_SIGN == HDMI_PORT
                if((pucEDID_Data[ucLoop_x+1]>= 0xd0)&&(pucEDID_Data[ucLoop_x+2]==0x00)&&((pucEDID_Data[ucLoop_x+4]&0xf0)==0xf0))
                {
                    g_stDpEdidInfo.b1Timing533 = 1;
                }
                #endif
            }
            else if(g_stDpEdidInfo.ulDpLinkWidth >= 360000)
            {
                if(pucEDID_Data[ucLoop_x+1] <= 0x8b) //355M
                {
                    g_stDpEdidInfo.b1Hdmi20Edid = 1;// 355M
                }
            }
        }
        else if(pucEDID_Data[ucLoop_x+1] >= 0x50) //200M
        {
            g_stDpEdidInfo.b1Hdmi14Edid = 1;
            #if RX_PORT_SIGN == HDMI_PORT
            if(g_stDpEdidInfo.ulDpLinkWidth >= 360000)
            {
                if((pucEDID_Data[ucLoop_x+1]>= 0x66)&&(pucEDID_Data[ucLoop_x+2]==0x00)&&((pucEDID_Data[ucLoop_x+4]&0xf0)==0xf0))
                {
                    g_stDpEdidInfo.b1Timing266 = 1;
                }
            }
            #endif
        }

        if(pucEDID_Data[ucLoop_x+1] > 1)
        {  
            if(((!g_stDpEdidInfo.b1Hdmi20Edid)&&(pucEDID_Data[ucLoop_x+1]>=0x85))||((pucEDID_Data[ucLoop_x+3]<0xa0)&&((pucEDID_Data[ucLoop_x+4]&0x0f)==0x00)))
            { 
                timing_max = 0;
                R_pixclk = pucEDID_Data[ucLoop_x+1];
                R_pixclk <<=8;
                R_pixclk |= pucEDID_Data[ucLoop_x];
                R_pixclk = 10000*R_pixclk;
                for(loopy = 2; loopy <= 5; loopy += 3)
                {
                    active = pucEDID_Data[ucLoop_x+loopy+2]&0xf0;
                    active <<= 4;
                    active |=pucEDID_Data[ucLoop_x+loopy];
                    blank  = pucEDID_Data[ucLoop_x+loopy+2]&0x0f;
                    blank <<= 8;
                    blank |= pucEDID_Data[ucLoop_x+loopy+1];
                    if(loopy == 2)
                    {
                            hactive = active;
                            htotal = active + blank;
                    }
                    else
                    {
                            vactive = active;
                            vtotal = active + blank;
                    }
                }
                for(loop_freq = 22; loop_freq <= 242; loop_freq+=5)
                {
                    if((R_pixclk)<(loop_freq*htotal*vtotal))
                    {
                        vfreq = loop_freq - 2;
                        if(vfreq == 145)
                        {
                            vfreq = 144;
                        }
                        break;
                    }
                }
               // printLT("\nvfreq = %x,%x",pucEDID_Data[Loop_x],pucEDID_Data[Loop_x+1]);
              //  printLT("\nvfreq = %x",vfreq);
                if((!g_stDpEdidInfo.b1Hdmi20Edid)&&(pucEDID_Data[ucLoop_x+1] >= 0x85))
                {
                    vfreq = (vfreq <= 70)?(30):(60);
                    timing_max = 2;
                 
                     
                }
                if((pucEDID_Data[ucLoop_x+3] <=0x8c)&&((pucEDID_Data[ucLoop_x+4]&0x0f)==0x00))
                {
                    if((hactive == 2560)&&(vactive == 1440))
                    {
                        timing_max = 2;
                        if(vfreq >= 144)
                        {
                            timing_max = 1;
                        }
                    }
                    else if((hactive == 1920)&&(vactive == 1080))
                    {
                        timing_max = 2;
                        if(((g_stDpEdidInfo.b1Hdmi20Edid)&&(vfreq >= 240))||((!g_stDpEdidInfo.b1Hdmi20Edid)&&(vfreq >= 144)))
                        {
                                timing_max = 1;
                        }
                    }
                    else if((hactive == 3840)&&(vactive == 2160))
                    {
                        timing_max = 2;
                    }
                    if(timing_max ==1)//保持不变
                    {
                        if((ucLoop_x > 0x80)&&(pucEDID_Data[ucLoop_x+3] <= 0x50))
                        {
                            for(loop_edid = ucLoop_x; loop_edid < 0xfe; loop_edid++)
                            {
                                pucEDID_Data[loop_edid] = (loop_edid < 0xec)?(pucEDID_Data[loop_edid+18]):(0);
                            }
                            ucLoop_x -= 18;
                            continue;
                        }
                    }
                    else if(timing_max == 2)
                    {
                        hblank_value = 0x8c;
                        htotal += (hblank_value - pucEDID_Data[ucLoop_x+3]);
                        pucEDID_Data[ucLoop_x+3] = hblank_value;
                        if(pucEDID_Data[ucLoop_x+8] < 0x30)
                        {
                            pucEDID_Data[ucLoop_x+8] = 0x30;
                        }
                        if(pucEDID_Data[ucLoop_x+9] > 0x20)
                        {
                            pucEDID_Data[ucLoop_x+9] = 0x20;
                        }
                    }
                }
                if(timing_max == 2)
                { 
                    R_pixclk = vfreq* htotal*vtotal ;
                    if(R_pixclk >= 600000000)
                    {
                        R_pixclk = 599800000;
                    }
                    E_pixclk = 0;
                    while(R_pixclk > 10000) // 误差是 32
                    {
                        if(R_pixclk > 6400000)
                        {
                            R_pixclk -= 6400000;
                            E_pixclk += 640;
                        }
                        else if(R_pixclk > 3200000)
                        {
                            R_pixclk -= 320000;
                            E_pixclk += 32;
                        }
                        else
                        {
                            R_pixclk -= 10000;
                            E_pixclk += 1;
                        }
                    }
                    pucEDID_Data[ucLoop_x] =   E_pixclk;
                    pucEDID_Data[ucLoop_x+1] = E_pixclk>>8;
                   
                   if((hactive == 1920)&&(vactive == 1080)&&(timing_max == 2))
                    {              
                       
                        pucEDID_Data[ucLoop_x] =   0xdc;
                        pucEDID_Data[ucLoop_x+1] = 0x37;
                    }
                     if((hactive == 3840)&&(vactive == 2160)&&(timing_max == 2))
                    {              
                       if((pucEDID_Data[ucLoop_x] ==0xb7)&&(pucEDID_Data[ucLoop_x+1]==0xce))
                       { 
                         pucEDID_Data[ucLoop_x] =  0xe2;
                         pucEDID_Data[ucLoop_x+1] = 0xd1;
                       }
                        
                        if((pucEDID_Data[ucLoop_x] ==0x45)&&(pucEDID_Data[ucLoop_x+1]==0xcf))
                       {     
                         pucEDID_Data[ucLoop_x] =  0xe2;
                         pucEDID_Data[ucLoop_x+1] = 0xd1;
                       }
                       
                    }
                }
            }
            else if((pucEDID_Data[ucLoop_x+1]>=0x60)&&(pucEDID_Data[ucLoop_x+3]==0xa0)&&(pucEDID_Data[ucLoop_x+4]==0xf0)&&(pucEDID_Data[ucLoop_x+9]>=0x60))
            {
                pucEDID_Data[ucLoop_x+8] = 0x30;
                pucEDID_Data[ucLoop_x+9] = 0x20;
               
            }
        }
    }
}
void Mod_DpEdid_Block0Analysis(u8 *pucEDID_Data)
{
    g_stDpEdidInfo.ucColorDepth = DEEP_8BIT;
    if((pucEDID_Data[0x12] == 0x01)&&(pucEDID_Data[0x13] == 0x04))
    {
        if((pucEDID_Data[0x14]&0x80) == 0x80)
        {
            if((pucEDID_Data[0x14]&0x70) == 0x30)
            {
                g_stDpEdidInfo.ucColorDepth = DEEP_10BIT;
            }
            else if((pucEDID_Data[0x14]&0x70) >= 0x40)
            {
                g_stDpEdidInfo.ucColorDepth = DEEP_12BIT;
            }
        }
    }
}

void Mod_DpEdid_CtaBlockAnalysis(u8 *pucEDID_Data)
{
    u8 ucLoop_edid;
    u8 ucVic_97,ucVic_102;
    u8 ucLoop_Offset,ucLoop_x;
    g_stDpEdidInfo.b1HDREdid =0;
    ucVic_97 = ucVic_102 = 0;
    for (ucLoop_Offset = 4; ucLoop_Offset < pucEDID_Data[2];)
    {
        g_stDpEdidInfo.ucBlockTag = pucEDID_Data[ucLoop_Offset] >> 5;
        g_stDpEdidInfo.ucBlockLen = pucEDID_Data[ucLoop_Offset] & 0x1f;
        switch(g_stDpEdidInfo.ucBlockTag)
        {
            case  AUDIO_DATA_BLOCK_1:     //audio
                for (ucLoop_x = ucLoop_Offset; ucLoop_x< (ucLoop_Offset + g_stDpEdidInfo.ucBlockLen); ucLoop_x += 3)
                {
                    if((pucEDID_Data[ucLoop_x+1]&0x78)== 0x08)
                    {
                        pucEDID_Data[ucLoop_x+1]   = 0x09;// 2channel
                        if(pucEDID_Data[ucLoop_x+2]&0x07)
                        {
                            pucEDID_Data[ucLoop_x+2] &=0x07;
                        }
                    }
                }
                break;

            case VIDEO_DATA_BLOCK_2:
                g_stDpEdidInfo.b1VicFlag = TRUE;
                for(ucLoop_x = ucLoop_Offset; ucLoop_x < (ucLoop_Offset+g_stDpEdidInfo.ucBlockLen);ucLoop_x++)
                {
                    if((pucEDID_Data[ucLoop_x+1] >= 208)&&(pucEDID_Data[ucLoop_x+1] <= 217))//remove > 8k60
                    {
                        pucEDID_Data[ucLoop_x+1] = 0x01;
                    }
                    else if(((pucEDID_Data[ucLoop_x+1] >= 89)&&(pucEDID_Data[ucLoop_x+1] <= 127))||(pucEDID_Data[ucLoop_x+1] >= 193))
                    {
                        if((pucEDID_Data[ucLoop_x+1]>= 194)&&(pucEDID_Data[ucLoop_x+1]<= 207))
                        {
                            g_stDpEdidInfo.b1Support8K = TRUE;
                        }
                        if((pucEDID_Data[ucLoop_x+1]==91)||(pucEDID_Data[ucLoop_x+1]==92)
                         ||(pucEDID_Data[ucLoop_x+1]==96)||(pucEDID_Data[ucLoop_x+1]==97)
                         ||(pucEDID_Data[ucLoop_x+1]==101)||(pucEDID_Data[ucLoop_x+1]==102)
                         ||(pucEDID_Data[ucLoop_x+1]==106)||(pucEDID_Data[ucLoop_x+1]==107)
                         ||(pucEDID_Data[ucLoop_x+1]>=114))
                         {
                            if(g_stDpEdidInfo.ulDpLinkWidth >= 540000)
                            {
                                g_stDpEdidInfo.b1Hdmi20Edid  = 1;
                                #if RX_PORT_SIGN == HDMI_PORT
                                if(pucEDID_Data[ucLoop_x+1] == 97)
                                {
                                    g_stDpEdidInfo.b1Timing533 = 0;
                                    ucVic_97  = 1;
                                }
                                if((pucEDID_Data[ucLoop_x+1] == 102)||(pucEDID_Data[ucLoop_x+1] == 107))
                                {
                                    ucVic_102  = 1;
                                }
                                #endif
                            }
                        }
                        #if RX_PORT_SIGN == HDMI_PORT
                        else if(pucEDID_Data[ucLoop_x+1] == 95)
                        {
                            g_stDpEdidInfo.b1Timing266 = 0;
                        }
                        #endif
                        g_stDpEdidInfo.b1Hdmi14Edid = 1;
                    }
                    else if((pucEDID_Data[ucLoop_x+1] == 63)||(pucEDID_Data[ucLoop_x+1] == 64)
                          ||(pucEDID_Data[ucLoop_x+1] == 77)||(pucEDID_Data[ucLoop_x+1] == 78))
                    {
                        g_stDpEdidInfo.b1Hdmi14Edid = 1;
                    }   
                }
                #if RX_PORT_SIGN == HDMI_PORT
                if((g_stDpEdidInfo.b1Hdmi20Edid ==1)&&(ucVic_97 == 0)&&(ucVic_102 == 1))//PS5 issue
                {
                    g_stDpEdidInfo.b1Timing533 = 1;
                }
                #endif
                break;

            case VENDOR_SPEC_DATA_BLOCK_3:
                #if RX_PORT_SIGN == HDMI_PORT
                if((pucEDID_Data[ucLoop_Offset+1] == 0x03) &&(pucEDID_Data[ucLoop_Offset+2] == 0x0c)&&(pucEDID_Data[ucLoop_Offset+3] == 0x00))
                {
                    g_stDpEdidInfo.b1Hdmi14Vsdb = 1;
                }
                else 
                {
                    if((pucEDID_Data[ucLoop_Offset+1] == 0xd8)&&(pucEDID_Data[ucLoop_Offset+2] == 0x5d)&&(pucEDID_Data[ucLoop_Offset+3] == 0xc4))
                    {
                        if(g_stDpEdidInfo.ulDpLinkWidth >= 540000)
                        {
                            g_stDpEdidInfo.b1Hdmi20Edid  = 1;
                        }
                    }
                    for(ucLoop_x = 0; ucLoop_x <= g_stDpEdidInfo.ucBlockLen ; ucLoop_x++)
                    {
                        for(ucLoop_edid = ucLoop_Offset; ucLoop_edid < 0x7e; ucLoop_edid++)
                        {
                            pucEDID_Data[ucLoop_edid] = pucEDID_Data[ucLoop_edid+1];
                        }
                        pucEDID_Data[2]--;
                        pucEDID_Data[0x7e] = 0;
                    }
                    g_stDpEdidInfo.b1Hdmi20Vsdb  = 0;
                    g_stDpEdidInfo.ucBlockLen    = 0;
                    ucLoop_Offset --;
                }
                #endif
                break;

            case USE_EXTENDED_TAG_7:
                //capability data block and dynamic hdr data block is remove, reference CTA-861-H Table 81
                if((pucEDID_Data[ucLoop_Offset + 1] == VIDEO_CAP_DATA_BLOCK_0) || (pucEDID_Data[ucLoop_Offset + 1] == HDR_DYNAMIC_META_DATA_BLOCK_7))//not support
                {
                    for(ucLoop_x = 0; ucLoop_x <= g_stDpEdidInfo.ucBlockLen ; ucLoop_x++)
                    {
                        for(ucLoop_edid = ucLoop_Offset; ucLoop_edid < 0x7e; ucLoop_edid++)
                        {
                            pucEDID_Data[ucLoop_edid] = pucEDID_Data[ucLoop_edid+1];
                        }
                        pucEDID_Data[2]--;
                        pucEDID_Data[0x7e] = 0;
                    }
                    g_stDpEdidInfo.ucBlockLen    = 0;
                    ucLoop_Offset --;
                }
                //420 video data block, select timings that support 420 format by vic
                else if(pucEDID_Data[ucLoop_Offset + 1] == YCC420_VID_DATA_BLOCK_14)
                {
                    g_stDpEdidInfo.b1Yuv420Edid = 1;
                    for(ucLoop_x = ucLoop_Offset; ucLoop_x < (ucLoop_Offset + g_stDpEdidInfo.ucBlockLen); ucLoop_x++)
                    {
                        if((pucEDID_Data[ucLoop_x+2] == 127)||(pucEDID_Data[ucLoop_x+2] == 193)
                         ||((pucEDID_Data[ucLoop_x+2]>= 194)&&(pucEDID_Data[ucLoop_x+2]<= 209))
                         ||((pucEDID_Data[ucLoop_x+2]>= 210)&&(pucEDID_Data[ucLoop_x+2]<= 217)))
                        {
                            if(g_stDpEdidInfo.ucBlockLen == 2)
                            {
                                pucEDID_Data[ucLoop_x+2] = 97;
                                break;
                            }
                            for(ucLoop_edid =(ucLoop_x+2); ucLoop_edid < 0x7e; ucLoop_edid++)
                            {
                                pucEDID_Data[ucLoop_edid] = pucEDID_Data[ucLoop_edid+1];
                            }
                            pucEDID_Data[2]--;
                            pucEDID_Data[ucLoop_Offset]--;
                            pucEDID_Data[0x7e] = 0;
                            g_stDpEdidInfo.ucBlockLen --;
                            ucLoop_x--;
                        }
                    }
                }
                //420 capability map data block
                else if(pucEDID_Data[ucLoop_Offset+1] == YCC420_CAP_MAP_DATA_BLOCK_15)
                {
                    g_stDpEdidInfo.b1Yuv420Edid = 1;
                }
                else if(pucEDID_Data[ucLoop_Offset+1] == 0x06)
                {
                    g_stDpEdidInfo.b1HDREdid = 1;
                }
                break;
            default:
                if(pucEDID_Data[ucLoop_Offset] == 0x00)
                {
                    for(ucLoop_edid = ucLoop_Offset; ucLoop_edid <  0x7e; ucLoop_edid++)
                    {
                        pucEDID_Data [ucLoop_edid] = pucEDID_Data [ucLoop_edid+1];
                    }
                    pucEDID_Data[2]--;
                    pucEDID_Data[0x7e] = 0;
                    g_stDpEdidInfo.ucBlockLen = 0;
                    ucLoop_Offset --;
                }
                break;
        }
        ucLoop_Offset += g_stDpEdidInfo.ucBlockLen + 1;
    }
}

void Mod_DpEdid_DisplayIdBlockAnalysis(u8 *pucEDID_Data)
{
    u8 ucLoop_Offset,ucLoop_x;
    u8 ucLoop_edid;
    for(ucLoop_Offset = 0x05; ucLoop_Offset< ( 0x05 + pucEDID_Data[0x02]);)
    {
        g_stDpEdidInfo.ucBlockTag = pucEDID_Data[ucLoop_Offset];
        g_stDpEdidInfo.ucBlockLen = pucEDID_Data[ucLoop_Offset+2];
        if((g_stDpEdidInfo.ucBlockTag == 0x00)&&(g_stDpEdidInfo.ucBlockLen == 0x00)) 
        {
            break;
        }
        switch(g_stDpEdidInfo.ucBlockTag)
        {
            case 0x03:    
                for(ucLoop_x = (ucLoop_Offset+3);ucLoop_x < (ucLoop_Offset+g_stDpEdidInfo.ucBlockLen+3);ucLoop_x += 20)
                {
                    if((pucEDID_Data[ucLoop_x+1]>= 0x85)||(pucEDID_Data[ucLoop_x+2] > 0))
                    {
                        if(g_stDpEdidInfo.ulDpLinkWidth >= 540000)
                        {
                            g_stDpEdidInfo.b1Hdmi20Edid  = 1;
                        }
                        g_stDpEdidInfo.b1Hdmi14Edid  = 1;
                    }
                    else if(pucEDID_Data[ucLoop_x+1] >= 0x50) //200M
                    {
                        g_stDpEdidInfo.b1Hdmi14Edid  = 1;
                    }
                } 
                break;
            case 0x0f:
                for(ucLoop_x = 0; ucLoop_x <= (g_stDpEdidInfo.ucBlockLen+2) ; ucLoop_x++)
                {
                    for(ucLoop_edid = ucLoop_Offset; ucLoop_edid <  0x7e; ucLoop_edid++)
                    {
                        pucEDID_Data [ucLoop_edid] = pucEDID_Data [ucLoop_edid+1];
                    }
                    pucEDID_Data[ 0x02]--;
                    pucEDID_Data[ 0x7e] = 0;
                }
                g_stDpEdidInfo.ucBlockLen = 0;    
                ucLoop_Offset -= 3;
                break;
                default:
            break;
        }
        ucLoop_Offset += g_stDpEdidInfo.ucBlockLen +3;
    }
}

void Mod_DpEdid_Analysis(u8 *pucEDID_Data)
{
    u8 b1NoCtaFlag;
    u8 ucLoop_Offset,ucLoop_cnt;
    u8 ucLoop_edid,ucTempSwap;
    u16 usEdidOffSet;
    b1NoCtaFlag = FALSE;
    for(ucLoop_Offset = 0; ucLoop_Offset< 4;ucLoop_Offset++)
    {
        usEdidOffSet = (u16)ucLoop_Offset * 0x80;
        b1NoCtaFlag = TRUE;
        if((pucEDID_Data[usEdidOffSet] == 0x02) && (pucEDID_Data[usEdidOffSet + 1] >= 0x02))
        {
            b1NoCtaFlag = FALSE;
            if ((ucLoop_Offset == 2) || (ucLoop_Offset == 3))
            {
                for(ucLoop_cnt = 0; ucLoop_cnt < 128; ucLoop_cnt++)
                {
                    ucTempSwap = pucEDID_Data[usEdidOffSet | ucLoop_cnt];
                    pucEDID_Data[usEdidOffSet|ucLoop_cnt] = pucEDID_Data[0x80 | ucLoop_cnt];
                    pucEDID_Data[0x80 | ucLoop_cnt]  = ucTempSwap;
                }
            }
            break;
        }
        if(ucLoop_Offset >= pucEDID_Data[0x7e])
        {
            break;
        }
    }
    #if RX_PORT_SIGN == HDMI_PORT
    if(b1NoCtaFlag == TRUE)
    {
        for(ucLoop_cnt = 0;ucLoop_cnt< 128;ucLoop_cnt++)
        {
            pucEDID_Data[0x180|ucLoop_cnt] = pucEDID_Data[0x100|ucLoop_cnt];
            pucEDID_Data[0x100|ucLoop_cnt] = pucEDID_Data[0x80|ucLoop_cnt];
            pucEDID_Data[0x80|ucLoop_cnt]  = szEdidDefault[0x80|ucLoop_cnt];
        }
        if(pucEDID_Data[0x7e] <= 2)
        {
            pucEDID_Data[0x7e] += 1;
        }
    }
    #endif
    for(ucLoop_edid = 0; ucLoop_edid < 4; ucLoop_edid++)
    {
        usEdidOffSet = (u16)ucLoop_edid * 0x80;
        if((pucEDID_Data[usEdidOffSet] == 0x00) && (pucEDID_Data[usEdidOffSet + 1] == 0xff))
        {
            Mod_DpEdid_Block0Analysis(&pucEDID_Data[usEdidOffSet]);
            Mod_DpEdid_DetailTimingAnalysis(0,&pucEDID_Data[usEdidOffSet]);
        }
        else if((pucEDID_Data[usEdidOffSet] == 0x02) && (pucEDID_Data[usEdidOffSet + 1] >= 0x02))
        {
            Mod_DpEdid_CtaBlockAnalysis(&pucEDID_Data[usEdidOffSet]);
            Mod_DpEdid_DetailTimingAnalysis(1,&pucEDID_Data[usEdidOffSet]);
        }
        else if(pucEDID_Data[usEdidOffSet] == 0x70)
        {
            Mod_DpEdid_DisplayIdBlockAnalysis(&pucEDID_Data[usEdidOffSet]);
        }
        if(ucLoop_edid >= pucEDID_Data[0x7e])
        {
            break;
        }        
    }
    #if RX_PORT_SIGN == HDMI_PORT
    if(b1NoCtaFlag == TRUE)
    {
        if((g_stDpEdidInfo.b1Hdmi14Edid == 1)||(g_stDpEdidInfo.b1Hdmi20Edid == 1))
        {
            pucEDID_Data[0x86] = 0x10;
            if(g_stDpEdidInfo.b1Hdmi20Edid ==1)
            {
                pucEDID_Data[0x98] = 0x78;
            }
            else if(g_stDpEdidInfo.b1Hdmi14Edid ==1)
            {
                pucEDID_Data[0x98] = 0x44;
            }
        }
        memcpy(&pucEDID_Data[0x99],&pucEDID_Data[0x36],18);
        g_stDpEdidInfo.b1VicFlag    = 0;
        g_stDpEdidInfo.b1Hdmi14Vsdb = 1;
    }
    #endif
}
void Mod_DetailTiming_Update(bool ucIsctaBlock,u8 *pucEDID_Data)
{
    u8 ucLoop_Offset,ucLoop_cnt;
    u8 ucBlockInit,ucBlockMax;
    u8 ucVfreq;
    u16 usTempHtotal,usTempVtotal;
    u32 ulTemp_PixelClk;
    if(ucIsctaBlock == 0)
    {
        ucBlockInit = 0x36;
        ucBlockMax  = 0x6c;
    }
    else
    {
        ucBlockInit = pucEDID_Data[2];
        ucBlockMax  = 0x6d;
        if(pucEDID_Data[2] <= 0x7f)//value
        {
            for(ucLoop_cnt = ucBlockInit ; ucLoop_cnt <= 0x7e ; ucLoop_cnt+= 18)
            {
                if(ucLoop_cnt >= 0x6e)
                {
                    memset(&pucEDID_Data[ucLoop_cnt],0x00,(0x7f - ucLoop_cnt));
                    break;
                }
            }
        }
        else
        {
            #if RX_PORT_SIGN == HDMI_PORT
            for (ucLoop_Offset = 4; ucLoop_Offset <= 0x7e;)//for block > 128
            {
                g_stDpEdidInfo.ucBlockLen = pucEDID_Data[ucLoop_Offset] & 0x1F;
                if((ucLoop_Offset+g_stDpEdidInfo.ucBlockLen +1) >= 0x7f)//in case block data > 0x7f
                {
                    pucEDID_Data[2] = ucLoop_Offset;
                    memset(&pucEDID_Data[ucLoop_Offset],0x00,(0x7f - ucLoop_Offset + 1));
                    break;
                }
                else
                {
                    ucLoop_Offset += g_stDpEdidInfo.ucBlockLen +1;
                }
            }
            #endif
        }
    }
    for(ucLoop_cnt = ucBlockInit ; ucLoop_cnt <= ucBlockMax ; ucLoop_cnt += 18)
    {
        if((g_stDpEdidInfo.b1Hdmi20Edid == 0)&&(pucEDID_Data[ucLoop_cnt+1] >= 0x85))
        {
            ulTemp_PixelClk = ((u16)pucEDID_Data[ucLoop_cnt+1]<<8) + pucEDID_Data[ucLoop_cnt];
            ulTemp_PixelClk = 10000*ulTemp_PixelClk;

            usTempHtotal   = ((u16)(pucEDID_Data[ucLoop_cnt+4]&0xf0)<<4)   + pucEDID_Data[ucLoop_cnt+2];
            usTempHtotal  += ((u16)(pucEDID_Data[ucLoop_cnt+4]&0x0f)<<8)   + pucEDID_Data[ucLoop_cnt+3];
        
            usTempVtotal  = ((u16)(pucEDID_Data[ucLoop_cnt+7]&0xf0)<<4)    + pucEDID_Data[ucLoop_cnt+5];
            usTempVtotal  += ((u16)(pucEDID_Data[ucLoop_cnt+7]&0x0f)<<8)    + pucEDID_Data[ucLoop_cnt+6];
            if(ulTemp_PixelClk >= ((u32)(usTempHtotal)*(usTempVtotal)*70))
            {
                ucVfreq = 60;
            }
            else
            {
                ucVfreq = 30;
            }
            ulTemp_PixelClk            = (u32)(ucVfreq)*(usTempHtotal)*(usTempVtotal);
            ulTemp_PixelClk            = ulTemp_PixelClk/10000;
            pucEDID_Data[ucLoop_cnt]   = ulTemp_PixelClk;
            pucEDID_Data[ucLoop_cnt+1] = ulTemp_PixelClk>>8;
        }
        #if RX_PORT_SIGN == HDMI_PORT
        else if((ucIsctaBlock == 0)&&(pucEDID_Data[ucLoop_cnt] == 0)&&(pucEDID_Data[ucLoop_cnt+1] == 0)&&(pucEDID_Data[ucLoop_cnt+2] == 0))
        {
            if((ucIsctaBlock == 0)&&(pucEDID_Data[ucLoop_cnt+3] ==0xfd))
            {
                pucEDID_Data[ucLoop_cnt+4] &= 0x0a;
                g_stDpEdidInfo.ucMinVerticalRate=pucEDID_Data[ucLoop_cnt+5];
                if((pucEDID_Data[ucLoop_cnt+5] <= 0x01)&&(pucEDID_Data[ucLoop_cnt+6]<= 0x01))
                {
                    pucEDID_Data[ucLoop_cnt+5] = 0x30;
                    pucEDID_Data[ucLoop_cnt+6] = 0x7a;
                    pucEDID_Data[ucLoop_cnt+7] = 0x1e;
                    pucEDID_Data[ucLoop_cnt+8] = 0xf0;
                }
                if(pucEDID_Data[ucLoop_cnt+5] == pucEDID_Data[ucLoop_cnt+6])
                {
                    pucEDID_Data[ucLoop_cnt+5] = 0x30;
                }
                if(pucEDID_Data[ucLoop_cnt+7] == pucEDID_Data[ucLoop_cnt+8])
                {
                    pucEDID_Data[ucLoop_cnt+7] = 0x1e;
                }
                #if RX_PORT_SIGN == DP_PORT
                pucEDID_Data[ucLoop_cnt+10] = 0x01;
                #endif

                #if RX_PORT_SIGN == HDMI_PORT
                pucEDID_Data[ucLoop_cnt+10] = 0x00;
                #if HDMIRX_VRR_SUPPORT == DISABLED
                pucEDID_Data[ucLoop_cnt+10] = 0x01;
                #endif
                #endif
                pucEDID_Data[ucLoop_cnt+11] = 0x0a;
                pucEDID_Data[ucLoop_cnt+12] = 0x20;
                pucEDID_Data[ucLoop_cnt+13] = 0x20;
                pucEDID_Data[ucLoop_cnt+14] = 0x20;
                pucEDID_Data[ucLoop_cnt+15] = 0x20;
                pucEDID_Data[ucLoop_cnt+16] = 0x20;
                pucEDID_Data[ucLoop_cnt+17] = 0x20;
            }
            else if((ucIsctaBlock == 0)&&(pucEDID_Data[ucLoop_cnt+3] == 0x00))
            {
                if(ucLoop_cnt <= 0x6c)
                {
                    pucEDID_Data[ucLoop_cnt+3] = 0xfe;//asccii code
                    memcpy(&pucEDID_Data[ucLoop_cnt+4],&szEdidDefault[0x70],14);    //copy the ASCII STRING
                }
            }
        }
        #endif
    }
}

void Mod_Block0_Update(u8 *pucEDID_Data)
{
    #if RX_PORT_SIGN == HDMI_PORT
    pucEDID_Data[0x13] = 0x03;
    pucEDID_Data[0x14] = 0x80;
    //pucEDID_Data[0x18] &=0xce;
    pucEDID_Data[0x18] &=0xE7;
    pucEDID_Data[0x18] |=0x08;
  // memset(&pucEDID_Data[0x26],0x01,16);
    
    szEEODB[2]=pucEDID_Data[0x7e];
//    if(pucEDID_Data[0x7e]>1)
//    {
//      pucEDID_Data[0x7e]=1;
//    }
    #endif
    #if RX_PORT_SIGN == DP_PORT
    if(pucEDID_Data[0x13] <= 0x03)
    {
        pucEDID_Data[0x13] = 0x04;
        pucEDID_Data[0x18] = 0x3A;
    }
    if(g_stDpRx.ucRxMaxLaneCount <= TWO_LANE)
    {
        pucEDID_Data[0x14] &= 0x8f;   //2lane force 8bit to solve mackbook2016 send 4k30 10bit issue
        pucEDID_Data[0x14] |= 0x20;
    }
    pucEDID_Data[0x18] &=0xfe;
    #endif
}

void Mod_CtaBlock_Update(u8 *pucEDID_Data)
{
    u8 ucLoop_Offset,ucLoop_x;
    u8 ucLoop_edid;
    u8 ucTemp_Vsdblenth;
    #if (RX_PORT_SIGN == HDMI_PORT)
    #if (HDMIRX_MAX_FRL_RATE >= FRL_3G3LANE)
    u8 ucFrl_Rate;
    #endif
    #endif
    
    #if RX_PORT_SIGN == HDMI_PORT
    pucEDID_Data[0x03] |= 0x80;
    #endif
  if(szEEODB[2]>1)
    {           
        for(ucLoop_edid = 0x7e; ucLoop_edid >3; ucLoop_edid--) //
        {
          pucEDID_Data[ucLoop_edid] =	pucEDID_Data[ucLoop_edid-3];
        }  
        memcpy(&pucEDID_Data[4],&szEEODB[0],3);
        pucEDID_Data[2]+= 3;
        g_stDpEdidInfo.b1EeodbFlag = 1;
    }
  
    
    if(g_stDpEdidInfo.b1VicFlag == 0)
    {
        if(g_stDpEdidInfo.b1EeodbFlag == 0)
        {
            for(ucLoop_edid = 0x7e; ucLoop_edid > 8; ucLoop_edid--)
            {
                pucEDID_Data[ucLoop_edid] = pucEDID_Data[ucLoop_edid - 5];
            }
            memcpy(&pucEDID_Data[4],&szVic_Block[0],5);
        }
        else
        {
            for(ucLoop_edid = 0x7e; ucLoop_edid > 11; ucLoop_edid--)
            {
                pucEDID_Data[ucLoop_edid] = pucEDID_Data[ucLoop_edid - 5];
            }
            memcpy(&pucEDID_Data[7],&szVic_Block[0],5);
        }
        memcpy(&pucEDID_Data[4],&szVic_Block[0],5);
        if((g_stDpEdidInfo.b1Hdmi14Edid == 1)||(g_stDpEdidInfo.b1Hdmi20Edid == 1))
        {
             pucEDID_Data[0x06] = 0x10;
        }
        pucEDID_Data[0x02] += 0x05;
        pucEDID_Data[0x03] |= 0x01;
    }
    for (ucLoop_Offset = 4; ucLoop_Offset < pucEDID_Data[2];)
    {
        g_stDpEdidInfo.ucBlockTag = pucEDID_Data[ucLoop_Offset] >> 5;
        g_stDpEdidInfo.ucBlockLen = pucEDID_Data[ucLoop_Offset] & 0x1F;
        switch(g_stDpEdidInfo.ucBlockTag)
        {
            case VIDEO_DATA_BLOCK_2: //Video data block
                if(g_stDpEdidInfo.b1Hdmi20Edid == 0)
                {
                    for(ucLoop_x = ucLoop_Offset; ucLoop_x < (ucLoop_Offset + g_stDpEdidInfo.ucBlockLen);ucLoop_x++)
                    {
                        if((pucEDID_Data[ucLoop_x+1]==91)||(pucEDID_Data[ucLoop_x+1]==92)
                         ||(pucEDID_Data[ucLoop_x+1]==96)||(pucEDID_Data[ucLoop_x+1]==97)
                         ||(pucEDID_Data[ucLoop_x+1]==101)||(pucEDID_Data[ucLoop_x+1]==102)
                         ||(pucEDID_Data[ucLoop_x+1]==106)||(pucEDID_Data[ucLoop_x+1]==107)
                         ||((pucEDID_Data[ucLoop_x+1]>=114)&&(pucEDID_Data[ucLoop_x+1]<= 127))
                         ||(pucEDID_Data[ucLoop_x+1]>=193))
                        {
                            pucEDID_Data[ucLoop_x+1] = 0x01;
                        }
                    }
                }
                else
                {
                    #if RX_PORT_SIGN == DP_PORT
                    #if ((DPRX_DSC_DEC_SUPPORT == ENABLED)&&(DPRX_DSC_BYPASS_SUPPORT == DISABLED))
                    for(ucLoop_x = ucLoop_Offset; ucLoop_x< (ucLoop_Offset+g_stDpEdidInfo.ucBlockLen);ucLoop_x++)//
                    {
                        if(((pucEDID_Data[ucLoop_x+1] == 193))
                         ||((pucEDID_Data[ucLoop_x+1] >= 197)&&(pucEDID_Data[ucLoop_x+1] <= 207)))
                        {
                             pucEDID_Data[ucLoop_x+1] = 0x01;//remvove 5k120  8k60    
                        }
                    }
                    #endif
                    #endif
                    
                    #if RX_PORT_SIGN == HDMI_PORT
                    #if ((HDMIRX_DSC_DEC_SUPPORT == ENABLED)&&(HDMIRX_DSC_BYPASS_SUPPORT == DISABLED))
                    for(ucLoop_x = ucLoop_Offset; ucLoop_x< (ucLoop_Offset+g_stDpEdidInfo.ucBlockLen);ucLoop_x++)//
                    {
                        if(((pucEDID_Data[ucLoop_x+1] == 193))
                         ||((pucEDID_Data[ucLoop_x+1] >= 197)&&(pucEDID_Data[ucLoop_x+1] <= 207)))
                        {
                             pucEDID_Data[ucLoop_x+1] = 0x01;//remvove 5k120  8k60    
                        }
                    }
                    #endif
                    #endif
                }
                #if RX_PORT_SIGN == HDMI_PORT
                if((g_stDpEdidInfo.b1Timing533 == 1)&&(g_stDpEdidInfo.b1Hdmi20Edid ==1))
                {
                    g_stDpEdidInfo.b1Timing533 = 0;
                    for(ucLoop_edid = 0x7e; ucLoop_edid > (ucLoop_Offset + g_stDpEdidInfo.ucBlockLen+1); ucLoop_edid--)
                    {
                        pucEDID_Data [ucLoop_edid] = pucEDID_Data[ucLoop_edid-1];
                    }
                    pucEDID_Data[ucLoop_Offset+g_stDpEdidInfo.ucBlockLen+1] = 97;//594M
                    pucEDID_Data[2]++;
                    pucEDID_Data[ucLoop_Offset]++;
                    g_stDpEdidInfo.ucBlockLen ++;
                }
                if((g_stDpEdidInfo.b1Timing266 == 1)&&(g_stDpEdidInfo.b1Hdmi14Edid ==1))
                {
                    g_stDpEdidInfo.b1Timing266 = 0;
                    for(ucLoop_edid = 0x7e; ucLoop_edid > (ucLoop_Offset + g_stDpEdidInfo.ucBlockLen+1); ucLoop_edid--)
                    {
                        pucEDID_Data [ucLoop_edid] = pucEDID_Data[ucLoop_edid-1];
                    }
                    pucEDID_Data[ucLoop_Offset+g_stDpEdidInfo.ucBlockLen+1] = 95;//297M
                    pucEDID_Data[2]++;
                    pucEDID_Data[ucLoop_Offset]++;
                    g_stDpEdidInfo.ucBlockLen ++;
                }
                
               if((Mod_DpTx_LinkBandWidthGet() >= 1080000) && (g_stDpEdidInfo.b1Timing533 == 1))
                {
                    
                    for(ucLoop_edid = 0x7e; ucLoop_edid > (ucLoop_Offset + g_stDpEdidInfo.ucBlockLen+1); ucLoop_edid--)
                    {
                        pucEDID_Data [ucLoop_edid] = pucEDID_Data[ucLoop_edid-1];
                    }
                    pucEDID_Data[ucLoop_Offset+g_stDpEdidInfo.ucBlockLen+1] = 0x76;//4k120hz
                    pucEDID_Data[2]++;
                    pucEDID_Data[ucLoop_Offset]++;
                    g_stDpEdidInfo.ucBlockLen ++;
                }
                #endif
                break;
            case  VENDOR_SPEC_DATA_BLOCK_3:    //vsdb
                #if RX_PORT_SIGN == HDMI_PORT
                if((pucEDID_Data[ucLoop_Offset+1]== 0x03)&&(pucEDID_Data[ucLoop_Offset+2]== 0x0c)&&(pucEDID_Data[ucLoop_Offset+3]== 0x00))
                {
                    if(g_stDpEdidInfo.ucBlockLen < 7)
                    {
                        ucTemp_Vsdblenth = 7- g_stDpEdidInfo.ucBlockLen;
                        for(ucLoop_edid = 0x7e;ucLoop_edid > (ucLoop_Offset+g_stDpEdidInfo.ucBlockLen+ucTemp_Vsdblenth); ucLoop_edid--)//
                        {
                            pucEDID_Data[ucLoop_edid] =  pucEDID_Data[ucLoop_edid-ucTemp_Vsdblenth];
                        }    
                        pucEDID_Data[ucLoop_Offset+6] = 0x00;
                        pucEDID_Data[ucLoop_Offset+7] = 0x1e;
                        pucEDID_Data[2]                      += ucTemp_Vsdblenth;
                        pucEDID_Data[ucLoop_Offset]          += ucTemp_Vsdblenth;
                        g_stDpEdidInfo.ucBlockLen            += ucTemp_Vsdblenth;
                    }
                    if(g_stDpEdidInfo.ucBlockLen >= 6)
                    {
                        pucEDID_Data[ucLoop_Offset+6] &= 0xbf;//remove 16bit
                        if(g_stDpEdidInfo.b1Hdmi20Edid == 0)
                        {
                            pucEDID_Data[ucLoop_Offset+6] &= 0x8f;//delete the deep color bit
                        }                   
                        else
                        {
                            if(!(pucEDID_Data[ucLoop_Offset+6]&0x20)&&(g_stDpEdidInfo.ucColorDepth == DEEP_12BIT))
                            {
                                pucEDID_Data[ucLoop_Offset+6] |= 0x30;
                            }
                            else if(!(pucEDID_Data[ucLoop_Offset+5]&0x10)&&(g_stDpEdidInfo.ucColorDepth == DEEP_10BIT))
                            {
                                pucEDID_Data[ucLoop_Offset+6] |= 0x10;
                            }
                        }
                    }
                    if(g_stDpEdidInfo.ucBlockLen >= 7)
                    {
                        if(g_stDpEdidInfo.b1Hdmi20Edid == 1)
                        {
                            pucEDID_Data[ucLoop_Offset+7] = 0x78;
                        }
                        else if (g_stDpEdidInfo.b1Hdmi14Edid == 1)
                        {
                            pucEDID_Data[ucLoop_Offset+7] = 0x44;
                        }
                        if((g_stDpEdidInfo.b1Hdmi20Edid == 0)&&(pucEDID_Data[ucLoop_Offset+7] > 0x44))
                        {
                            pucEDID_Data[ucLoop_Offset+7] = 0x44;
                        }
                    }
                }
                #endif
                break;
            case USE_EXTENDED_TAG_7: 
                break;
            default:
                break;
        }
        ucLoop_Offset += g_stDpEdidInfo.ucBlockLen +1;
    }
    #if RX_PORT_SIGN == HDMI_PORT
    if(g_stDpEdidInfo.b1Hdmi14Vsdb == 0)  //VSDB14
    {
        for(ucLoop_edid = 0x7e; ucLoop_edid >  pucEDID_Data[2]; ucLoop_edid--)
        {
            pucEDID_Data[ucLoop_edid] = pucEDID_Data[ucLoop_edid-8];
        }
        if(g_stDpEdidInfo.ucColorDepth == DEEP_12BIT)
        {
            szVsdb14[6] = 0x30;        
        }
        else if(g_stDpEdidInfo.ucColorDepth == DEEP_10BIT)
        {
            szVsdb14[6] = 0x10;           
        }
        else
        {
            szVsdb14[6] = 0x00;  
        }
        szVsdb14[6] |= BIT3_1;  //YCBCR444 deep color mode
        if(g_stDpEdidInfo.b1Hdmi20Edid == 1)
        {
            szVsdb14[7] = 0x78;            
        }
        else if (g_stDpEdidInfo.b1Hdmi14Edid == 1)
        {
            szVsdb14[7] = 0x44;           
        }
        else
        {
            szVsdb14[7] = 0x1e;    
        }
   
        memcpy(&pucEDID_Data[pucEDID_Data[2]],&szVsdb14[0],8);
        pucEDID_Data[2]+= 8;
        g_stDpEdidInfo.ucVsdb_offset = pucEDID_Data[2];
    }
    else
    {
        for (ucLoop_Offset = 4; ucLoop_Offset < pucEDID_Data[2];)
        {
            g_stDpEdidInfo.ucBlockTag = pucEDID_Data[ucLoop_Offset] >> 5;
            g_stDpEdidInfo.ucBlockLen = pucEDID_Data[ucLoop_Offset] & 0x1F;
            switch(g_stDpEdidInfo.ucBlockTag)
            {
                case  0x03:    //vsdb
                    if((pucEDID_Data[ucLoop_Offset+1]==0x03)&&(pucEDID_Data[ucLoop_Offset+2]==0x0c)&&(pucEDID_Data[ucLoop_Offset+3]==0x00))
                    {
                        g_stDpEdidInfo.ucVsdb_offset = ucLoop_Offset + g_stDpEdidInfo.ucBlockLen  + 1;
                        pucEDID_Data[ucLoop_Offset+6] |= BIT3_1;  //YCBCR444 deep color mode
                        pucEDID_Data[ucLoop_Offset+7] = 0x44;
                    }
                    break;
                default:
                    break;
            }
            ucLoop_Offset += g_stDpEdidInfo.ucBlockLen  +1;
        }
    }
    if(g_stDpEdidInfo.b1Hdmi20Vsdb  == 0) //VSDB20 add
    {
        if(g_stDpEdidInfo.b1Hdmi20Edid == 1)
        {
            for(ucLoop_edid = 0x7e; ucLoop_edid > g_stDpEdidInfo.ucVsdb_offset; ucLoop_edid--) //
            {
                pucEDID_Data[ucLoop_edid] =  pucEDID_Data[ucLoop_edid - 8];
            }
            if((g_stDpEdidInfo.b1Yuv420Edid == 1)&&(g_stDpEdidInfo.ucColorDepth == DEEP_12BIT))
            {
                szVsdb20[7]  = 0x03;
            }
            else if((g_stDpEdidInfo.b1Yuv420Edid == 1)&&(g_stDpEdidInfo.ucColorDepth == DEEP_10BIT))
            {
                szVsdb20[7]  = 0x01;
            }
            #if HDMIRX_MAX_FRL_RATE >= FRL_3G3LANE
            if(Mod_DpTx_LinkBandWidthGet() >= 1080000)
            {
            ucFrl_Rate  = HDMIRX_MAX_FRL_RATE;
            szVsdb20[7] |= ucFrl_Rate <<4;
            }
            else
            {
                szVsdb20[7] = 0;
            }
            #endif
            memcpy(&pucEDID_Data[g_stDpEdidInfo.ucVsdb_offset],&szVsdb20[0],8);
            pucEDID_Data[2] += 8;
        }
    }
    #endif
}

#if RX_PORT_SIGN == HDMI_PORT
#if ((HDMIRX_DSC_BYPASS_SUPPORT == ENABLED)||(HDMIRX_DSC_DEC_SUPPORT == ENABLED)||(HDMIRX_VRR_SUPPORT == ENABLED))
void Mod_Cta_Block_DscEdidVsdb(u8 *pucEDID_Data)
{
    u8 szVsdbDsc[3] = {0x80,0x00,0x1f};//dsc
    u8 ucLoop_edid;
    u16 ucLoop_Offset;
    #if (HDMIRX_DSC_BYPASS_SUPPORT == ENABLED)
    if((g_stAuxDpTx.ucDscCap == TRUE)&&(g_stAuxDpTx.ucFecCap == TRUE))
    {
        if(g_stAuxDpTx.ucDscColorFormat &BIT4_1)//native 420 enable
        {
            szVsdbDsc[0] |= BIT6_1;
        }
        if(g_stAuxDpTx.ucDscColorFormat &BIT2_1)//10bpc
        {
            szVsdbDsc[0] |= BIT0_1;
        }
        if(g_stAuxDpTx.ucDscColorFormat &BIT3_1)//12bpc
        {
            szVsdbDsc[0] |= BIT1_1;
        }
        szVsdbDsc[1] = HDMIRX_MAX_FRL_RATE;
        szVsdbDsc[1] <<= 4;
        if((g_stAuxDpTx.ucDscSliceCap > 0x20))//&&(g_stAuxDpTx.ucDscBPPCap!=0)
        {
            szVsdbDsc[1] |= 0x04;// max  8slices
        }
        else
        {
            szVsdbDsc[1] |= 0x03;// max  4slices
        }
    }
    else
    #endif
    {
        #if (HDMIRX_DSC_DEC_SUPPORT == ENABLED)
        if(g_stDpEdidInfo.b1Yuv420Edid == TRUE)//native 420 enable
        {
            szVsdbDsc[0] |= BIT6_1;
        }
        if(g_stDpEdidInfo.ucColorDepth >= DEEP_10BIT)//10bpc
        {
            szVsdbDsc[0] |= BIT0_1;
        }
        szVsdbDsc[1] = HDMIRX_MAX_FRL_RATE;
        szVsdbDsc[1] <<= 4;
        szVsdbDsc[1] |= 0x04;// max  8slices
        #endif
    }
    for (ucLoop_Offset = 4; ucLoop_Offset < pucEDID_Data[2];)
    {
        g_stDpEdidInfo.ucBlockTag = pucEDID_Data[ucLoop_Offset] >> 5;
        g_stDpEdidInfo.ucBlockLen = pucEDID_Data[ucLoop_Offset] & 0x1F;
        switch(g_stDpEdidInfo.ucBlockTag)
        {
            case  0x03:    //vsdb
                if((pucEDID_Data[ucLoop_Offset+1] == 0xd8)&&(pucEDID_Data[ucLoop_Offset+2] == 0x5d)&&(pucEDID_Data[ucLoop_Offset+3] == 0xc4))
                {
                    if(g_stDpEdidInfo.ucBlockLen == 7)
                    {
                        for(ucLoop_edid = 0x7e; ucLoop_edid > ucLoop_Offset+13; ucLoop_edid--) //
                        {
                            pucEDID_Data[ucLoop_edid] =  pucEDID_Data[ucLoop_edid - 6];
                        }
//                        #if HDMIRX_VRR_SUPPORT == DISABLED
                       if((g_stAuxDpTx.b1MsaIgnoreCap==0))//||(Mod_DpTx_LinkBandWidthGet() < 1060000)
                    //  if((g_stAuxDpTx.b1MsaIgnoreCap==0)||(g_stAuxDpTx.ucASyncCap==0))
                        {
                        pucEDID_Data[ucLoop_Offset+8]  = 0x00;
                        pucEDID_Data[ucLoop_Offset+9]  = 0x00;
                        pucEDID_Data[ucLoop_Offset+10] = 0x00;
                        }
                        else{
                        pucEDID_Data[ucLoop_Offset+8]  = 0x00;
                        pucEDID_Data[ucLoop_Offset+9]  = 0x30;
                        pucEDID_Data[ucLoop_Offset+10] = 0x90; 
                        }                        
                        pucEDID_Data[ucLoop_Offset] += 6;
                        pucEDID_Data[2]+= 6;
                    }
                    #if ((HDMIRX_DSC_BYPASS_SUPPORT == ENABLED)||(HDMIRX_DSC_DEC_SUPPORT == ENABLED))
                    else if(g_stDpEdidInfo.ucBlockLen == 10)
                    {
                        for(ucLoop_edid = 0x7e; ucLoop_edid > ucLoop_Offset+13; ucLoop_edid--) //
                        {
                            pucEDID_Data[ucLoop_edid] =  pucEDID_Data[ucLoop_edid - 3];
                        }
                        pucEDID_Data[ucLoop_Offset] += 3;
                        pucEDID_Data[2]+= 3;
                    }
                    pucEDID_Data[ucLoop_Offset+11]  = szVsdbDsc[0];
                    pucEDID_Data[ucLoop_Offset+12]  = szVsdbDsc[1];
                    pucEDID_Data[ucLoop_Offset+13]  = szVsdbDsc[2];
                    #else
                    pucEDID_Data[ucLoop_Offset+11]  = 0x00;
                    pucEDID_Data[ucLoop_Offset+12]  = 0x00;
                    pucEDID_Data[ucLoop_Offset+13]  = 0x00;
                    #endif
                    
                }
                break;
            default:
                break;
        } 
        ucLoop_Offset += g_stDpEdidInfo.ucBlockLen +1;
    }
}
#endif
#endif

void Mod_DisPlayIDBlock_Update(u8 *pucEDID_Data)
{
    u8 ucLoop_Offset,ucLoop_x;
    #if RX_PORT_SIGN == HDMI_PORT
    #if (HDMIRX_DSC_BYPASS_SUPPORT == ENABLED)
    if((g_stAuxDpTx.ucDscCap == TRUE)&&(g_stAuxDpTx.ucFecCap == TRUE))
    {
        return;
    }
    #endif
    #endif
    
    #if RX_PORT_SIGN == DP_PORT
    #if (DPRX_DSC_BYPASS_SUPPORT == ENABLED)
    if((g_stAuxDpTx.ucDscCap == TRUE)&&(g_stAuxDpTx.ucFecCap == TRUE))
    {
        return;
    }
    #endif
    #endif
    for(ucLoop_Offset = 0x05; ucLoop_Offset< ( 0x05 + pucEDID_Data[0x02]);)
    {
        g_stDpEdidInfo.ucBlockTag = pucEDID_Data[ucLoop_Offset];
        g_stDpEdidInfo.ucBlockLen = pucEDID_Data[ucLoop_Offset+2];
        if((g_stDpEdidInfo.ucBlockTag == 0x00)&&(g_stDpEdidInfo.ucBlockLen == 0x00)) 
        {
            break;
        }
        switch(g_stDpEdidInfo.ucBlockTag)
        {
            case 0x03:    
                for(ucLoop_x = (ucLoop_Offset+3);ucLoop_x < (ucLoop_Offset +g_stDpEdidInfo.ucBlockLen+3);ucLoop_x += 20)
                {
                    if(((pucEDID_Data[ucLoop_x+1]>= 0x33)&&(pucEDID_Data[ucLoop_x+2]== 2))||(pucEDID_Data[ucLoop_x+2]> 2))//1.4g
                    {
                        memset(&pucEDID_Data[ucLoop_x],0x00,20);
                    }
                } 
                break;
            default:
                break;
        }
        ucLoop_Offset += g_stDpEdidInfo.ucBlockLen +3;
    }
}

void Mod_DpEdid_Update(u8 *pucEDID_Data)
{
    u8 ucLoop_edid;
    u16 usEdid_Offset;
    
    for(ucLoop_edid = 0; ucLoop_edid < 4; ucLoop_edid++)
    {
        usEdid_Offset = (u16)ucLoop_edid * 0x80;
        if((pucEDID_Data[usEdid_Offset] == 0x00) && (pucEDID_Data[usEdid_Offset+1] == 0xff))
        {
            Mod_Block0_Update(&pucEDID_Data[usEdid_Offset]);
            Mod_DetailTiming_Update(0,&pucEDID_Data[usEdid_Offset]);
            Mod_Edid_CheckSum(&pucEDID_Data[usEdid_Offset]);
        }
        else if((pucEDID_Data[usEdid_Offset] == 0x02) && (pucEDID_Data[usEdid_Offset+1] >= 0x02))
        {
            Mod_CtaBlock_Update(&pucEDID_Data[usEdid_Offset]);
            #if RX_PORT_SIGN == HDMI_PORT
            #if ((HDMIRX_DSC_BYPASS_SUPPORT == ENABLED)||(HDMIRX_DSC_DEC_SUPPORT == ENABLED)||(HDMIRX_VRR_SUPPORT == ENABLED))
            if(g_stAuxDpTx.ucDscSupportCap==1)
            {
              Mod_Cta_Block_DscEdidVsdb(&pucEDID_Data[usEdid_Offset]);
            }   
            #endif
            #endif
            Mod_DetailTiming_Update(1,&pucEDID_Data[usEdid_Offset]);
            Mod_Edid_CheckSum(&pucEDID_Data[usEdid_Offset]);
        }
        else if(pucEDID_Data[usEdid_Offset] == 0x70)
        {
            Mod_DisPlayIDBlock_Update(&pucEDID_Data[usEdid_Offset]);
            Mod_Check_DisIdSum(&pucEDID_Data[usEdid_Offset]);
            Mod_Edid_CheckSum(&pucEDID_Data[usEdid_Offset]);
        }
        if(ucLoop_edid >= pucEDID_Data[0x7e])
        {
            pucEDID_Data[0x7e]=1;
            Mod_Edid_CheckSum(&pucEDID_Data[0]);
            break;
        }        
    }
}
#if RX_PORT_SIGN == DP_PORT
#if (DEBUG_DPRX_EDID_PRINT_EN == ENABLED)
void Mod_Edid_DpModePrint(u8 *pucEDID_Data)
{
    u16 usLoop_Cnt;
    printLT(PRINT_PRIO_TEST, "\nDp Edid");
    if(pucEDID_Data[0x7e] >= 9)
    {
        printLT(PRINT_PRIO_TEST, " Error");
        return;
    }
    for(usLoop_Cnt = 0; usLoop_Cnt < ((pucEDID_Data[0x7e]+1)<<7); usLoop_Cnt++)
    {
        if((usLoop_Cnt &0x0f) == 0)
        {
            printLT(PRINT_PRIO_TEST, "\n");
        }
        printLT(PRINT_PRIO_TEST, "0x%02bx,", pucEDID_Data[usLoop_Cnt]);
    } 
    
}
#endif
#endif

#if RX_PORT_SIGN == HDMI_PORT
 #if (DEBUG_HDMIRX_EDID_PRINT_EN == ENABLED)
void Mod_Edid_HdmiModePrint(u8 *pucEDID_Data)
{
    u16 usLoop_Cnt;
    printLT(PRINT_PRIO_TEST, "\nHdmi Edid");
    if(pucEDID_Data[0x7e] >= 9)
    {
        printLT(PRINT_PRIO_TEST, " Error");
        return;
    }
    if(g_stDpEdidInfo.b1EeodbFlag)
    {
        printLT(PRINT_PRIO_TEST, "\nADD EEODB");
        for(usLoop_Cnt = 0; usLoop_Cnt < ((pucEDID_Data[0x86]+1)<<7); usLoop_Cnt++)
        {
            if((usLoop_Cnt &0x0f) == 0)
            {
                printLT(PRINT_PRIO_TEST, "\n");
            }
            printLT(PRINT_PRIO_TEST, "0x%02bx,", pucEDID_Data[usLoop_Cnt]);
        }
    }
    else
    {
        for(usLoop_Cnt = 0; usLoop_Cnt < ((pucEDID_Data[0x7e]+1)<<7); usLoop_Cnt++)
        {
            if((usLoop_Cnt &0x0f) == 0)
            {
                printLT(PRINT_PRIO_TEST, "\n");
            }
            printLT(PRINT_PRIO_TEST, "0x%02bx,", pucEDID_Data[usLoop_Cnt]);
        }
    }    
    
}
#endif
#endif

void Mod_Edid_Update(void)
{
    #ifdef NVIDIA_FW_EN
    memcpy(szEdidData, szNvidiaEdid, 512);
    #endif
    
    #ifdef DEMO_FW_EN
    Mod_DpEdid_Init();
    Mod_DpEdid_Analysis(szEdidData);
    Mod_DpEdid_Update(szEdidData);
    #if RX_PORT_SIGN == DP_PORT
    #if (DEBUG_DPRX_EDID_PRINT_EN == ENABLED)
    Mod_Edid_DpModePrint(szEdidData);
    #endif
    #endif
    #if RX_PORT_SIGN == HDMI_PORT
    #if (DEBUG_HDMIRX_EDID_PRINT_EN == ENABLED)
    Mod_Edid_HdmiModePrint(szEdidData);
    #endif
    #endif
    
    #endif

}

#endif
