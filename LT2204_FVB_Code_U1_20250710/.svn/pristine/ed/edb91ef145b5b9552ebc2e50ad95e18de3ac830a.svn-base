              //        BKFC_A2_REG = 0x6C;//RX receiving half-bit positon
              //        BKFC_9F_REG = 0xd8;//RX
              //        #endif
                      BKFC_A2_REG = 0x08;
                      BKFC_CD_REG = 0x08;
                      BKFC_C0_REG = 0xF0;//IDLE DET_EN 13 and Rx rate detect mode important for collision avodiance
                      BKFC_C1_REG = 0x74;//IDLE DET_EN 13 and Rx rate detect mode important for collision avodiance
                      BKFC_B1_REG = 0x07;//40m Type-C RX first sample position
                  }
              }
