              u8 Drv_CC2On_Det(IN u8 ucPow_Role)
              {
                  u8 ucDCC_Connect_Loop;
                  if(ucPow_Role&SINK)
                  {
                      if((BKA2_BB_REG & BIT2_1)==0x00)//DCC RD Mode
                      {
                          #if DCC_DET_WITHCC == 1
              //            if(((BKFC_B0_REG&0xf0)==0x00)&&(((BKE5_D4_REG&BIT4_1)==0x00)/*&&(Chip_UccChargeGpio_Enabled(
             -) == FALSE)*/))
                          if(((BKFC_B0_REG&0xf0)==0x00)&&(((BKE5_A2_REG&BIT7_1)==0x00)/*&&(Chip_UccChargeGpio_Enabled() 
             -== FALSE)*/))
                          #else
              //            if((BKE5_D4_REG&BIT4_1)==0x00)//DCC RD Mode
                          if((BKE5_A2_REG&BIT7_1)==0x00)//DCC RD Mode
                          #endif
                          {
                              for(ucDCC_Connect_Loop =0;ucDCC_Connect_Loop<100;ucDCC_Connect_Loop++)
                              {
                                  Ocm_Delay1us(4);
                                  #if DCC_DET_WITHCC == 1
              //                    if(((BKFC_B0_REG&0xf0)==0x00)&&(((BKE5_D4_REG&BIT4_1)==0x00)/*&&(Chip_UccChargeGpio_
             -Enabled() == FALSE)*/))
                                  if(((BKFC_B0_REG&0xf0)==0x00)&&(((BKE5_A2_REG&BIT7_1)==0x00)/*&&(Chip_UccChargeGpio_En
             -abled() == FALSE)*/))
                                  #else
              //                    if((BKE5_D4_REG&BIT4_1)==0x00)//DCC RD Mode
                                  if((BKE5_A2_REG&BIT7_1)==0x00)//DCC RD Mode
                                  #endif
                                  {
                                      ;
                                  }
                                  else
                                  {
                                      return TRUE;
                                  }
                              }
                          }
                          else
                          {
                              return TRUE;
                          }
                      }         
                  }
                  #if DCC_TOGGLE_SUPPORT == ENABLED
                  else if(ucPow_Role & SOURCE)
                  {
              //        if(BKE2_27_REG &BIT2_1)
                      if(BKA2_BB_REG &BIT2_1)
                      {
                          if((BKFC_B0_REG&0x50)==0x00)//DCC RP Mode
                          {
                              for(ucDCC_Connect_Loop =0;ucDCC_Connect_Loop<100;ucDCC_Connect_Loop++)
                              {
                                  if((BKFC_B0_REG&0x50)==0x00)//DCC RP Mode
C51 COMPILER V9.53.0.0   DRVTYPECCC2                                                       02/13/2025 10:14:24 PAGE 14  

                                  {
                                      ;
                                  }
                                  else
                                  {
                                      return TRUE;
                                  }
                              }
                          }
                          else               
                          {
                              return TRUE;
                          }
                      }              
                  }
                  #endif
                  return FALSE;
              }
              
              void DRV_CCPHY_DigSet(void)
              {
                  DRV_CCRterm_Cali(UCC);
                  DRV_CCRXRate_Set(UCC);
                  DRV_CCRXRate_Set(DCC);
                  DRV_CCTXRate_Set(UCC);
                  DRV_CCTXRate_Set(DCC);
                  DRV_CCInt_Init(UCC);
                  DRV_CCInt_Init(DCC); 
                  DRV_CCDebounce_Set(UCC);
                  DRV_CCDebounce_Set(DCC);
              //    DRV_Interrupt_Set(IRQ_RXUCC_INT,ON);
              //    DRV_Interrupt_Set(IRQ_RXDCC_INT,ON);
                  DRV_CCRxPHY_Set(UCC);
                  DRV_CCRxPHY_Set(DCC); 
              }
