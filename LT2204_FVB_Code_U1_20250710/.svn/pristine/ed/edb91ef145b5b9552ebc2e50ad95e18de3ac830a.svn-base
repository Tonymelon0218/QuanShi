              void DRV_RpCur_Sel(IN u8 CC_Port,IN u8 Rp_Cur)
              {
                  u8 ucRpCur_Tmp = 0x00;
                  if(CC_Port == UCC)
                  {
                      ucRpCur_Tmp = BKA2_B1_REG;
                      ucRpCur_Tmp &= (BIT0_0&BIT1_0);
                      ucRpCur_Tmp |= Rp_Cur;
                      BKA2_B1_REG = ucRpCur_Tmp; 
                  }
                  else if(CC_Port == DCC)
                  {
                      ucRpCur_Tmp = BKA2_BB_REG;
                      ucRpCur_Tmp &= (BIT0_0&BIT1_0);
                      ucRpCur_Tmp |= Rp_Cur;
                      BKA2_BB_REG = ucRpCur_Tmp; 
                  }
              }
              
              void DRV_PowerRole_Set(IN u8 CC_Port,IN u8 ucPow_Role)
              {
                  if(CC_Port == UCC)
                  {
                      if(ucPow_Role == SINK)
                      {
                          BKA2_B1_REG &= BIT2_0;
                          BKFC_3E_REG &= BIT0_0;
                      }
                      else if(ucPow_Role == SOURCE)
                      {
                          BKA2_B1_REG |= BIT2_1;
                          BKFC_3E_REG |= BIT0_1;
                      }
                  }
                  else if(CC_Port == DCC)
                  {
                      if(ucPow_Role == SINK)
                      {
                          BKA2_BB_REG &= BIT2_0;
                          BKFC_BE_REG &= BIT0_0;
                      }
                      else if(ucPow_Role == SOURCE)
                      {
                          BKA2_BB_REG |= BIT2_1;
                          BKFC_BE_REG |= BIT0_1;
                      }
C51 COMPILER V9.53.0.0   DRVTYPECCC2                                                       02/13/2025 10:14:24 PAGE 8   

                  }
              }
              
              void Drv_CC1USB3Mux_Ctrl(StructCcStatus *pstCcState)
              {
                  if(pstCcState->b1IsFlip == FALSE)
                  {
                      if(pstCcState->uclaneCount <= TWO_LANE)//USB3.1 SW
                      {
                          BKA1_01_REG = 0x30;
                      }
                      else
                      {
                          BKA1_01_REG = 0x20;
                      }
                  }
                  else
                  {
                      if(pstCcState->uclaneCount <= TWO_LANE)//USB3.1 SW
                      {
                          BKA1_01_REG = 0x70;
                      }
                      else
                      {
                          BKA1_01_REG = 0x20;
                      }
                  }
              }
              //================================
              //
              //the function is find out UCC orientation
              //ucRx_MaxLane:maximum lane,if less than 4lanes,USB switch will be enabled
              //b1Input_type:female or male
              //================================
              //void Drv_CC1Flip_Judge(u8 ucRx_MaxLane,u8 b1Input_type)//flip det
              void Drv_CC1Flip_Judge(StructCcStatus *pstCcState)//flip det
              {
                      static u8 ucCCOrienDet_Cnt;
                      pstCcState->b1IsFlip = FALSE;
                      if(pstCcState->b1UCcInput_type == FEMALE)
                      {
                              for(ucCCOrienDet_Cnt=0;ucCCOrienDet_Cnt<10;ucCCOrienDet_Cnt++)
                              {
                                      if(((!(BKA2_B1_REG&BIT2_1))&&(BKFC_30_REG&0xc0))||(BKFC_30_REG&BIT6_1)) //normal
                                      {                                       
                                              //TBD
              //                UCCPORTUSBMUX_CTRL(LOW);
                                              pstCcState->b1IsFlip = FALSE;//CC1
                              BKFC_2F_REG &= BIT1_0; //flip 1 soft
                                              break;
                                      }
                                      else if(((!(BKA2_B1_REG&BIT2_1))&&(BKFC_30_REG&0x30))||(BKFC_30_REG&BIT4_1)) //invese
                                      {               
                              pstCcState->b1IsFlip = TRUE;  
                              BKFC_2F_REG |= BIT1_1;//flip 1 soft                          
                                              break;
                                      }
                                      else
                                      {
                                              Ocm_Delay1us(10);
                                      }
                              }        
C51 COMPILER V9.53.0.0   DRVTYPECCC2                                                       02/13/2025 10:14:24 PAGE 9   

                      }
                  else
                  {
                      pstCcState->b1IsFlip = FALSE;
                  }
                  #if CHIP_SEL == LT6711GXE
                  Drv_DpTx_TypeCOutSet();
                  #endif
                      Drv_CC1USB3Mux_Ctrl(pstCcState);
              }
              void Drv_CC1Flip_Scan(StructCcStatus *pCcState)
              {
                  //ucc1 SINK MODE,DO NOT DURING RP/RD EXCHANGE PERIOD
                  if(((BKA2_B1_REG&BIT2_1) == 0x00)&&(pCcState->ucPRSwaping != 2)) //
                  {
                      if(BKFC_30_REG&0xc0) //??
                      {            
                          BKFC_2F_REG &= BIT1_0;//flip 1 soft
                          pCcState->b1IsFlip = FALSE;
                      }
                      else if(BKFC_30_REG&0x30)//             
                      {
                          BKFC_2F_REG |= BIT1_1;//flip 1 soft
                          pCcState->b1IsFlip = TRUE;
                      }
                  }
                  if(pCcState->ucFRSwaping != FRSWAP_NULL)
                  {
                      return;
                  }
                  if(BKFC_30_REG&0xf0)//ucc is on
                  {
                              ////TBD
                      if(BKA3_87_REG&BIT2_1)//SOURCE_GPIO_CTRL is HIGH
                      {
                          ;
                      }
                      else
                      {
                          if(Drv_CC2On_Det(SINK) == TRUE)//dcc is on
                          {
                              ;
                          }
                          else
                          {
                              SOURCE_GPIO_CTRL(IN HIGH); //1,ufP
                          }
                      }                
                  }
              }
              void DRV_FrTrig_Send(void)
              {
                  BKFC_3D_REG |= BIT6_1;//FR swap gen en //FOR CTS:TEST PD PHY 08
                  BKFC_44_REG = 0x01;
                  BKFC_44_REG = 0x00;
              //    BKFC_44_REG |= BIT0_1;//fr swap triggle
              //    BKFC_44_REG &= BIT0_0;
              }
              
              #if TYPEC_FRSWAP_EN  == ENABLED
              
              void Drv_CC2VoltageLvl_Det(void)
C51 COMPILER V9.53.0.0   DRVTYPECCC2                                                       02/13/2025 10:14:24 PAGE 10  

              {
                      u8 ucVbus_off_volt = 0;
                      u16 usVbus_Used_Volt;
                      BKA2_BA_REG = 0x00;
                  //如果电压扫描不到的话，会导致while无法退出
                      while((ucVbus_off_volt <= 253)&&(!(BKE5_A1_REG&BIT0_1)))
                      {
                              ucVbus_off_volt += 2;
              //              BKA2_BC_REG = ucVbus_off_volt;
                              BKA2_BA_REG = ucVbus_off_volt;
                              Ocm_Delay1us(5);
                      }
              //      printLT(PRINT_PRIO_HIG,"\nVbus_Lvl_Ori = %02bx",BKA2_BA_REG);
              //    usVbus_Used_Volt = ucVbus_off_volt;
              //    usVbus_Used_Volt = (usVbus_Used_Volt*85)+300;
              //    usVbus_Used_Volt = ((usVbus_Used_Volt-300)/100);
              //    BKE2_26_REG = usVbus_Used_Volt;
                      if(ucVbus_off_volt > 2)
                      {
                              usVbus_Used_Volt = ucVbus_off_volt;
                              if(ucVbus_off_volt <= 0x8C)
                              {
                                      usVbus_Used_Volt = (usVbus_Used_Volt*87)-12*13;//87% cut off
                              }
                              else if(ucVbus_off_volt <= 0xb0)
                              {
                                      usVbus_Used_Volt = (usVbus_Used_Volt*92)-12*13;//87% cut off
                              }
                              else
                              {
                                      usVbus_Used_Volt = (usVbus_Used_Volt*93)-12*13;//87% cut off
                              }
                      usVbus_Used_Volt = (usVbus_Used_Volt/100);
                              BKA2_BA_REG = usVbus_Used_Volt;
                              BKA2_BA_REG &= BIT0_0;
                      }
                  else
                  {
                      ucVbus_off_volt = 0;
                  }
                      Drv_Cc2VbusDet_IntClr(FALSE);
              }
              #endif
              void Drv_Cc2VbusDet_IntClr(u8 b1IsClr)
              {
                  (b1IsClr == TRUE)?(BKFC_9B_REG |= BIT0_1):(BKFC_9B_REG &= BIT0_0);
              }
              void Drv_Cc2VbusDet_IntSet(u8 b1IsSet)
              {
                  (b1IsSet == ENABLED)?(BKFC_95_REG |= BIT0_1):(BKFC_95_REG &= BIT0_0);
              }
              u8 Drv_Cc2VbusOff_Det(void)
              {
                  return (BKE5_A0_REG & BIT4_1);
              }
              u8 Drv_CC1RpOn_Scan(void)
              {
                  u8 CC_Connect_State = 0;
                  u8 CC_Connect_Loop;
                  for(CC_Connect_Loop=0;CC_Connect_Loop<150;CC_Connect_Loop++)
                  {    
              //        if(BKD3_06_REG&BIT6_1) 
C51 COMPILER V9.53.0.0   DRVTYPECCC2                                                       02/13/2025 10:14:24 PAGE 11  

                      if(BKA2_B1_REG&BIT2_1)//SOURCE MODE
                      {
                          if(BKFC_30_REG&0x50)
                          {
                              CC_Connect_State = 1;
                              break;
                          }
                          else
                          {
                              Ocm_Delay1us(10);
                              CC_Connect_State = 0;            
                          }
                      }
                      else
                      {
                          CC_Connect_State = 0;    
                          break;    
                      }
                  }
                  return CC_Connect_State;
              }
              u8 Drv_CC1RdOn_Scan(void)
              {
                  u8 CC_Connect_State = 0;
                  u8 CC_Connect_Loop;
                  for(CC_Connect_Loop=0;CC_Connect_Loop<150;CC_Connect_Loop++)
                  {
              //        if(!(BKD3_06_REG&BIT6_1))
                      if(!(BKA2_B1_REG&BIT2_1))//SINK MODE
                      {
                          if(BKFC_30_REG&0xF0)
                          {
                              CC_Connect_State = 1;
                              break;
                          }
                          else
                          {
                              Ocm_Delay1us(10);
                              CC_Connect_State = 0;
                          }
                      }
                      else
                      {
                          CC_Connect_State = 0;    
                          break;
                      }
                  }
                  return CC_Connect_State;
              }
              
              void DRV_CCRterm_Cali(u8 UCC_DCC)
              {
                  u8 CC_Cali_Cnt = 0;
                  if(UCC_DCC == UCC)
                  {
                      BKE1_0A_REG &= BIT1_0;//UCC Cali logic reset
                      BKE1_0A_REG |= BIT1_1;//UCC Cali logic reset
                      DRV_CC_LogicRst(UCC);
                      BKA2_B1_REG = 0x82;//BIT5=VBUS_VTHYS
                      BKA2_B2_REG = 0x3c;//BIT5=VBUS_VTHYS
                      BKA2_A9_REG = 0x84;//RG_UCC1_CC_EN
                      for(CC_Cali_Cnt=0;CC_Cali_Cnt<10;CC_Cali_Cnt++)
C51 COMPILER V9.53.0.0   DRVTYPECCC2                                                       02/13/2025 10:14:24 PAGE 12  

                      {
                          BKE2_12_REG &= BIT0_0;
                          Ocm_Delay1ms(1);
                          BKE2_12_REG |= BIT0_1;//UCC1 RTERM CAL
                          Ocm_Delay1ms(10);
                          if((BKE2_20_REG&BIT1_1) == 0x00)//cali done
                          {
                              ;
                          }
                          else if(BKE2_20_REG&BIT0_1)//cali fail
                          {
                              ;
                          }
                          else
                          {
                              break;
                          }
                      }
                  }
                  else if(UCC_DCC == DCC)
                  {
                      BKE1_0A_REG &= BIT0_0;//UCC Cali logic reset
                      BKE1_0A_REG |= BIT0_1;//UCC Cali logic reset
                      DRV_CC_LogicRst(DCC);
                      BKA2_BB_REG = 0x82;//BIT5=VBUS_VTHYS
                      BKA2_BC_REG = 0x07;//BIT5=VBUS_VTHYS
                      BKA2_B3_REG = 0x24;//RG_UCC1_CC_EN
                      for(CC_Cali_Cnt=0;CC_Cali_Cnt<10;CC_Cali_Cnt++)
                      {
                          BKE2_19_REG &= BIT0_0;
                          Ocm_Delay1ms(1);
                          BKE2_19_REG |= BIT0_1;//UCC1 RTERM CAL
                          Ocm_Delay1ms(10);
                          if((BKE2_22_REG&BIT1_1) == 0x00)//cali done
                          {
                              ;
                          }
                          else if(BKE2_22_REG&BIT0_1)//cali fail
                          {
                              ;
                          }
                          else
                          {
                              break;
                          }
                      }
                  }
              }
              
