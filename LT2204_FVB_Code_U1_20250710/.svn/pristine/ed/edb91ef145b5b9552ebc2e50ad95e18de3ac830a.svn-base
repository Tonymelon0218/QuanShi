              void DRV_CCDebounce_Set(u8 UCC_DCC)
              {
                  if(UCC_DCC == UCC)
                  {
                      BKFC_0A_REG = 0x13;//CC DEBAOUNCE WIDTH
              //        BKFC_0B_REG = 0x10;//can not be too large
              //        BKFC_2A_REG = 0x00;
              //        BKFC_2B_REG = 0x80;
                      BKFC_29_REG = 0x10; // cc_det_debounce
                      BKFC_2C_REG = 0x62; //Dcc connect soft en
                      #if SYSCLK == SYS_CLK_40M //90us
                      BKFC_3C_REG = 0x10;//FR_DEBOUNCE_WIDTH[7:0]
                      BKFC_3D_REG = 0x0c;//FR_DEBOUNCE_WIDTH[15:8]//BIT4-7 is very important for FR swap
                      #elif SYSCLK == SYS_CLK_48M //90us
                      BKFC_3C_REG = 0xE0;//FR_DEBOUNCE_WIDTH[7:0]//BIT4-7 is very important for FR swap
                      BKFC_3D_REG = 0x0c;//FR_DEBOUNCE_WIDTH[15:8]
                      #endif
                      #if TYPEC_FRSWAP_EN  == ENABLED
                      BKFC_3D_REG &= BIT6_0;//FR swap gen en //FOR CTS:TEST PD PHY 08
                      #endif
                      BKFC_3E_REG = 0x00;// rd  0x00: 0x01;// rp must follow the 0xd306
                  }
                  else if(UCC_DCC == DCC)
                  {
                      
                      BKFC_8A_REG = 0x13;//CC DEBAOUNCE WIDTH    
                      #if TYPEC_FRSWAP_EN == ENABLED
                      BKFC_A8_REG = 0x30;
C51 COMPILER V9.53.0.0   DRVTYPECCC2                                                       02/13/2025 10:14:24 PAGE 5   

                      BKFC_A9_REG = 0x00;
                      #else
                      BKFC_A9_REG = 0x10; // cc_det_debounce
                      #endif
                      BKFC_AC_REG = 0x62; //Dcc connect soft en
                      BKFC_BD_REG = 0x0e;//FR_DEBOUNCE_WIDTH
                      BKFC_BE_REG = 0x00;//rd must follow the 0xd30e
                      
                  }
              }
              void DRV_CCRxPHY_Set(u8 UCC_DCC)
              {
                  if(UCC_DCC == UCC)
                  {
              //        BKD3_00_REG = 0x47;//bit1: UCC1 isolate switch enable bit 0:UCC1 deadbattery Rd 
              //        BKD3_02_REG = 0x58;//bit0: UCC1 TX and RX enable da control
              //        BKD3_03_REG = 0x3f;//ufp
              //        BKD3_05_REG = 0x56;//UCC1 RD CAL ISO EN, UCC1 DETET EN
              //        BKD3_06_REG = 0x20;//0x20 rd 0x60 Rp bit6: ucc1 mode sel
              //        BKD3_07_REG = 0x00;//frl det
              //        
              //        BKD3_04_REG = 0x09;//
                       
                      BKA2_AB_REG = 0x09;//BIT3-2: UCC1 system clock select: BIT1-0:UCC1 TX LDO 1100mV
                      BKA2_AC_REG = 0x08;//BIT0:digital CONTROL UCC1 TX and RX enable
                      BKA2_AD_REG = 0x7c;//BIT6-2:UCC1 TX phy slew rate control
                      BKA2_AE_REG = 0x09;//BIT6??? rx0:400mV RX1:550mV RX2:700mV
                      
                      BKA2_B1_REG = 0xBA;//VBUS DET:400mV,VBUS DET EN,
                      BKA2_B2_REG = 0x20;//BIT5:1=2101, 0 = 2204
                      
                      BKA2_B0_REG = 0x40;//525mv
                      //SWITCH要放在最后，不然会有CC浮空的时间
                      BKA2_A9_REG = 0x87;//bit1: UCC1 isolate switch enable bit 0:UCC1 deadbattery Rd
                  }
                  else if(UCC_DCC == DCC)
                  { 
              //        BKD3_08_REG = 0x47;//UCC2 
              //        BKD3_0A_REG = 0x58;
              //        BKD3_0B_REG = 0x3f;//ufp
              //        BKD3_0C_REG = 0x00;//dvbus off det ref 5v
              //        BKD3_0D_REG = 0x16;//200mV
              //        BKD3_0E_REG = 0x20;//ucc2 rd
                      
                      
                      BKA2_B5_REG = 0x05;//BIT3-2: UCC1 system clock select: BIT1-0:UCC1 TX LDO 1100mV
                      BKA2_B6_REG = 0x08;//BIT0:digital CONTROL UCC1 TX and RX enable
                      BKA2_B7_REG = 0x7c;//BIT6-2:UCC1 TX phy slew rate control
                      BKA2_B8_REG = 0x2B;//BIT6??? rx0:400mV RX1:550mV RX2:700mV
                      
                      BKA2_BB_REG = 0xBA;//VBUS DET:400mV,VBUS DET EN,
                      BKA2_BC_REG = 0x00;//BIT5:1=2101, 0 = 2204
                      
                      BKA2_BA_REG = 0x08;//400mv--4.4V
                      //SWITCH要放在最后，不然会有CC浮空的时间
                      BKA2_B3_REG = 0x27;//bit1: UCC1 isolate switch enable bit 0:UCC1 deadbattery Rd 
                  }
              }
              void DRV_CC_LogicRst(u8 UCC_DCC) 
              {
                  if(UCC_DCC == UCC)
                  {
C51 COMPILER V9.53.0.0   DRVTYPECCC2                                                       02/13/2025 10:14:24 PAGE 6   

                      BKE1_0A_REG &= BIT2_0;//UCC logic soft reset
                      BKE1_0A_REG |= BIT2_1;//UCC logic soft reset
                  }
                  else if(UCC_DCC == DCC)
                  {
                      BKE1_0A_REG &= BIT3_0;//DCC logic soft reset
                      BKE1_0A_REG |= BIT3_1;//DCC logic soft reset
                  }
              }
              
              
              void DRV_CcOrder_Set(u8 UCC_DCC,u8 OrderType)
              {
                  if(UCC_DCC == UCC)
                  {
                      BKFC_19_REG = OrderType;
                      BKFC_19_REG = 0x01;        
                  }
                  else
                  {
                      BKFC_99_REG = OrderType;
                      BKFC_99_REG = 0x01; 
                  }
              }
