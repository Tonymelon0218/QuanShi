                  {
                      BKFC_22_REG = 0x0E;
                      BKFC_4D_REG = 0x0E;
                      BKFC_40_REG = 0x63;//IDLE DET_EN 13 and Rx rate detect mode important for collision avodiance
                      BKFC_41_REG = 0x76;//IDLE DET_EN 13 and Rx rate detect mode important for collision avodiance
                      BKFC_31_REG = 0x09;//40m Type-C RX first sample position
                  }
                  else if(UCC_DCC == DCC)
                  {
              //        #if SYSCLK == SYS_CLK_40M
