                      #if (CUSTOMER_DEFINED == ENABLED)
                      Drv_IOSoftLevel_Set(GPIO16_MCLKA, HIGH); //for nvidia case 1: hdmi mode, 0:dvi mode
                      Drv_IOSoftLevel_Set(GPIO17_SCLKA, HIGH); //for nvidia case 1: hdmi rx stable 0: hdmi rx unstable  
             -    
                      #endif
                      #endif
 187   2          }
 188   1          else
 189   1          {
 190   2              BKCD_00_REG &= BIT2_0;//[2]hdmi 21 link training start disable
 191   2              BKCE_C7_REG |= BIT2_1;//[2]hdmi 21 RX sink flt updata state clr
 192   2              BKCE_C7_REG &= BIT2_0;//[2]hdmi 21 RX sink flt updata state clr
 193   2              Drv_HdmiRx_PhySet(HDMI20);
 194   2              Drv_HdmiRx_DigInit(HDMI20);
