 238          //========================================================================
 239          // Func Name   : Mod_FrlRx_IrqHandler_FltUpdate
 240          // Description : The irq hander for source clear frl_update.
 241          // Input       : void  
 242          // Output      : None
 243          // Return      : void
 244          //========================================================================
 245          void Mod_FrlRx_IrqHandler_FltUpdate(void)
 246          {
 247   1          if (!(BKCD_E6_REG & BIT4_1))//hdmi 21 rx source flt int
 248   1              return;
 249   1          BKCD_57_REG |= BIT4_1;//clr update en
 250   1          BKCD_57_REG &= BIT4_0;//clr update dis;
 251   1          if (g_stFrlRxInfo.b1SrcReadPtnDone == TRUE) //the last DDC conmunication is reading LTP_req.
 252   1          {
 253   2              g_stFrlRxInfo.b1SrcReadPtnDone = FALSE;
 254   2              if ((g_stFrlRxInfo.ucPtnType == TRAIN_PATTERN)||(g_stFrlRxInfo.ucPtnType == CHANGE_PATTERN))
 255   2              {
 256   3                  BKCE_C8_REG |= BIT6_1;//[6]rgd_eq_check_en_clr: 1-en, stop checking eq pattern.
 257   3                  BKCE_C8_REG &= BIT6_0;//[6]rgd_eq_check_en_clr: 0-dis, start checking eq pattern.
 258   3      
 259   3                  BKCD_48_REG &= BIT4_0;//rgd_sw_frl_start_rst_n = 0, solve frl start be quickly set to 1
 260   3      
 261   3                  Mod_HdmiRxEq_EqCheckInPreDet();
 262   3                  g_stFrlRxInfo.ucEqScanCnt = 0;
 263   3              }
 264   2              else if (g_stFrlRxInfo.ucPtnType == FINISH_PATTERN)//in p state
 265   2              {
 266   3                  Drv_HdmiRx_Reset(HDMI_RX_FIFO_RST);//SOLVE astro skew over design issue
 267   3                  Drv_HdmiRx_Reset(HDMI_FRL_DEC_RST);
 268   3                  Drv_HdmiRx_Reset(HDMI_FEC_DEC_RST);
 269   3                  Drv_HdmiRx_Reset(HDMI_FRL_DEPKT_RST);
 270   3      
 271   3                  Ocm_Delay1ms(10);
 272   3                  BKCD_48_REG |= BIT4_1;//rgd_sw_frl_start_rst_n = 1
 273   3              }
 274   2              else if (g_stFrlRxInfo.ucPtnType == NOTQUEST_PATTERN)
 275   2              {
 276   3                  Mod_FrlRx_ffeStateSet(FFE_FAILED, LANE_ALL);
 277   3                  Mod_FrlRx_ffeStateUpdate();
 278   3              }
 279   2          }
 280   1      }
