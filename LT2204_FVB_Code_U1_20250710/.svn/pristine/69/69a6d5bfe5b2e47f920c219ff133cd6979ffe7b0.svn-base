 153   1      
 154   1          if (BKCE_BB_REG & BIT5_1)//[3]frl start int
 155   1          {
 156   2              BKCE_C5_REG |= BIT7_1;//ptn flag clr
 157   2              BKCE_C5_REG &= BIT7_0;//ptn flag clr
 158   2          }
 159   1          Mod_FrlRx_VarInit();
 160   1          g_stFrlRxInfo.ucFrlRate   = BKCD_B5_REG & 0x0f;//get the latest frl rate.
 161   1          g_stFrlRxInfo.ucMaxffeLvl = (BKCD_B5_REG & 0xf0) >> 4;//get the latest ffe level.
 162   1          if (g_stFrlRxInfo.ucFrlRate > FRL_NOT_SPT)
 163   1          {
 164   2              BKCD_00_REG |= BIT2_1;//[2]hdmi 21 link training start enable
 165   2              g_stFrlRxInfo.ucLaneCnt = (g_stFrlRxInfo.ucFrlRate < FRL_6G4LANE)? (3) : (4);
 166   2              if (g_stFrlRxInfo.ucMaxffeLvl > 3)
 167   2              {
 168   3                  g_stFrlRxInfo.ucMaxffeLvl = 3;
 169   3              }
 170   2              Drv_HdmiRx_TmdsPcrPllDis();
 171   2              Drv_HdmiRx_ErrValidClr(DISABLED);
 172   2              Drv_HdmiRx_Reset(HDMI_FRL_TRAIN_RST);
 173   2              Drv_HdmiRx_PhySet(HDMI21);
 174   2              Drv_HdmiRx_DigInit(HDMI21);
 175   2              Drv_HdmiRx_ClkMux(HDMI21);
 176   2              Drv_HdmiRx_PllModeSet(HDMI21);
 177   2              Drv_HdmiRx_Frl_PllBandSet(g_stFrlRxInfo.ucFrlRate);
C51 COMPILER V9.53.0.0   MODFRLRX                                                          02/13/2025 10:14:06 PAGE 4   

 178   2              Drv_HdmiRx_Frl_CdrSet(g_stFrlRxInfo.ucFrlRate);
 179   2              Drv_HdmiRx_Frl_PiSet(g_stFrlRxInfo.ucFrlRate);
 180   2              Drv_HdmiRx_Frl_PhyCtleSet(g_stFrlRxInfo.ucFrlRate);
