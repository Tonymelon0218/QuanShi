  72          //========================================================================
  73          // Func Name   : Mod_FrlRx_ffeStateUpdate
  74          // Description : Update LPT_req in scdc field from register value(0xcd09/0xcd0a).
  75          //             : the action will generate flt_update = 1 flag.
  76          //             : the LPT_req value will be cleared after source reading LPT_req.
  77          // Input       : void  
  78          // Output      : None
  79          // Return      : void
  80          //========================================================================
  81          void Mod_FrlRx_ffeStateUpdate(void)
  82          {
  83   1          BKCD_63_REG |= BIT4_1;//[4]HDMI 21 RX FFE level sync enable signal(software mode).
  84   1          Ocm_Delay1ms(1);      //necessary for update signal valid
  85   1          BKCD_63_REG &= BIT4_0;//[4]HDMI 21 RX FFE level sync enable signal(software mode) clr
  86   1          BKCD_09_REG = 0x00;//clear
  87   1          BKCD_0A_REG = 0x00;//clear
  88   1      }
  89          
  90          //========================================================================
  91          // Func Name   : Mod_FrlRx_ffeStateHandler
  92          // Description : ss
  93          // Input       : void  
  94          // Output      : None
  95          // Return      : u8
  96          //========================================================================
  97          void Mod_FrlRx_ffeStateHandler(void)
  98          {
  99   1          u8 ucRtn, ucLaneIdx;
 100   1      
 101   1          if (g_stFrlRxInfo.ucffeRequestNum <= g_stFrlRxInfo.ucMaxffeLvl)
 102   1          {
 103   2              ucRtn = Mod_HdmiRxEq_Frl_StateGet(LANE_ALL);
 104   2              if (ucRtn == SUCCESS)
 105   2              {
 106   3                  Mod_FrlRx_ffeStateSet(FFE_FINISH, LANE_ALL);
 107   3              }
 108   2              else if (g_stFrlRxInfo.ucMaxffeLvl == 0)
 109   2              {
 110   3                  Mod_FrlRx_ffeStateSet(FFE_FAILED, LANE_ALL);
 111   3              }
 112   2              else
 113   2              {
 114   3                  for(ucLaneIdx = 0 ;ucLaneIdx < LANE_ALL; ucLaneIdx++)
 115   3                  {
C51 COMPILER V9.53.0.0   MODFRLRX                                                          02/13/2025 10:14:06 PAGE 3   

 116   4                      if (Mod_HdmiRxEq_Frl_StateGet(ucLaneIdx) == FAIL)
 117   4                      {
 118   5                          Mod_FrlRx_ffeStateSet(FFE_CHANGE, ucLaneIdx);
 119   5                      }
 120   4                      if(ucLaneIdx == g_stFrlRxInfo.ucLaneCnt)
 121   4                      {
 122   5                          break;
 123   5                      }
 124   4                  }
 125   3                  g_stFrlRxInfo.ucffeRequestNum++;
 126   3              }
 127   2          }
 128   1          else
 129   1          {
 130   2              Mod_FrlRx_ffeStateSet(FFE_FAILED, LANE_ALL);
 131   2          }
 132   1          Mod_FrlRx_ffeStateUpdate();
 133   1      }
