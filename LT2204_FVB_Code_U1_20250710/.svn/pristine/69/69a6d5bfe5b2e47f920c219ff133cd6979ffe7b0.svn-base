C51 COMPILER V9.53.0.0   MODFRLRX                                                          02/13/2025 10:14:06 PAGE 6   

                  Mod_FrlRx_ffeStateHandler(); //there is no eq done irq in software eq mode, so need to fedback source 
             -ffe result here.
                  #endif
 302   1      }
