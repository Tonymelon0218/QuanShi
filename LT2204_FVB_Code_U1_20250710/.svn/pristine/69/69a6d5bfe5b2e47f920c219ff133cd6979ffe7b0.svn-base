  21          //========================================================================
  22          // Func Name   : Mod_FrlRx_ffeStateSet
  23          // Description : Set register value for LPT_req in scdc field.
  24          //             : This action will not generate flt_update = 1 flag.
  25          // Input       : u8 ucState  
  26          //               u8 ucLane   
  27          // Output      : None
  28          // Return      : void
  29          //========================================================================
  30          void Mod_FrlRx_ffeStateSet(u8 ucState, u8 ucLane)
  31          {
  32   1          switch(ucState)
  33   1          {
  34   2              case FFE_CHANGE:
  35   2                  Drv_HdmiRx_Reset(HDMI_ERR_DET_RST);
  36   2                  if (ucLane == LANE_0)
  37   2                  {
  38   3                      BKCD_09_REG |= BIT6_1;//[6]hdmi 21 rx lane0 ffe level change by software
  39   3                  }
  40   2                  else if (ucLane == LANE_1)
  41   2                  {
  42   3                      BKCD_09_REG |= BIT2_1;//[2]hdmi 21 rx lane1 ffe level change by software
  43   3                  }
  44   2                  else if (ucLane == LANE_2)
  45   2                  {
  46   3                      BKCD_0A_REG |= BIT6_1;//[6]hdmi 21 rx lane2 ffe level change by software
  47   3                  }
  48   2                  else if (ucLane == LANE_3)
  49   2                  {
  50   3                      BKCD_0A_REG |= BIT2_1;//[2]hdmi 21 rx lane3 ffe level change by software
  51   3                  }
  52   2                  else if (ucLane == LANE_ALL)
  53   2                  {
C51 COMPILER V9.53.0.0   MODFRLRX                                                          02/13/2025 10:14:06 PAGE 2   

  54   3                      BKCD_09_REG = 0x44;//[6][2]hdmi 21 rx lane0/lane1 ffe level change by software
  55   3                      BKCD_0A_REG = 0x44;//[6][2]hdmi 21 rx lane2/lane3 ffe level change by software
  56   3                  }
  57   2                  g_stFrlRxInfo.ucPtnType = CHANGE_PATTERN;
  58   2                  break;
  59   2              case FFE_FINISH:
  60   2                  BKCD_09_REG = 0x22;//[5][1]hdmi 21 rx lane0/lane1 ffe level finish by software.
  61   2                  BKCD_0A_REG = 0x22;//[5][1]hdmi 21 rx lane2/lane3 ffe level finish by software.
  62   2                  g_stFrlRxInfo.ucPtnType = FINISH_PATTERN;
  63   2                  break;
  64   2              case FFE_FAILED:
  65   2                  BKCD_09_REG = 0x11;//[4][0]hdmi 21 rx lane0/lane1 ffe level fail by software.
  66   2                  BKCD_0A_REG = 0x11;//[4][0]hdmi 21 rx lane2/lane3 ffe level fail by software.
  67   2                  g_stFrlRxInfo.ucPtnType = FAILED_PATTERN;
  68   2                  break;
  69   2          }
  70   1      }
