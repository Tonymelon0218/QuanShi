  83          void Drv_CscRx_Set(u8 CscType)
  84          {
  85   1          BKC7_65_REG = 0x00; //[4]rgb to ycbcr
  86   1          BKC7_66_REG = 0x04; //[6]444to422, [1]422to420
  87   1          BKC7_67_REG = 0x10; //[6]420to422, [2]Y422to444
  88   1          BKC7_68_REG = 0x00; //[4]ycbcr to rgb
  89   1          switch(CscType)
  90   1          {
  91   2              case RGB_TO_Y444_1:
  92   2                  BKC7_65_REG |= BIT4_1; //[4]rgb to ycbcr
  93   2                  break;
  94   2              case RGB_TO_Y422_2:
  95   2                  BKC7_65_REG |= BIT4_1; //[4]rgb to ycbcr
  96   2                  BKC7_66_REG |= BIT6_1; //[6]444to422
  97   2                  break;
  98   2              case RGB_TO_Y420_3:
  99   2                  BKC7_65_REG |= BIT4_1; //[4]rgb to ycbcr
 100   2                  BKC7_66_REG |= 0x42;   //[6]444to422, [1]422to420
 101   2                  break;   
 102   2      
 103   2              case Y444_TO_RGB_4:
 104   2                  BKC7_68_REG |= BIT4_1; //[4]ycbcr to rgb
 105   2                  break;
 106   2              case Y444_TO_Y422_5:
 107   2                  BKC7_66_REG |= BIT6_1; //[6]444to422
 108   2                  break;
 109   2              case Y444_TO_Y420_6:
C51 COMPILER V9.53.0.0   DRVCSC                                                            02/13/2025 10:14:13 PAGE 3   

 110   2                  BKC7_66_REG |= 0x42;   //[6]444to422, [1]422to420
 111   2                  break;
 112   2      
 113   2              case Y422_TO_RGB_7:
 114   2                  BKC7_67_REG |= BIT2_1; //[2]422to444
 115   2                  BKC7_68_REG |= BIT4_1; //[4]ycbcr to rgb
 116   2                  break;
 117   2              case Y422_TO_Y444_8:
 118   2                  BKC7_67_REG |= BIT2_1; //[2]422to444
 119   2                  break;
 120   2              case Y422_TO_Y420_9:
 121   2                  BKC7_66_REG |= BIT1_1; //[1]422to420
 122   2                  break;
 123   2      
 124   2              case Y420_TO_RGB_10:
 125   2                  BKC7_67_REG |= 0x44;   //[6]420to422, [2]422to444
 126   2                  BKC7_68_REG |= BIT4_1; //[4]ycbcr to rgb  
 127   2                  break;
 128   2              case Y420_TO_Y444_11:
 129   2                  BKC7_67_REG |= 0x44;   //[6]420to422, [2]422to444 
 130   2                  break;
 131   2              case Y420_TO_Y422_12:
 132   2                  BKC7_67_REG |= BIT6_1; //[6]420to422
 133   2                  break;
 134   2              default:
 135   2                  break;
 136   2          }
 137   1          BKC9_03_REG &= BIT1_0;
 138   1          BKC9_03_REG |= BIT1_1;
 139   1          Ocm_Delay1ms(200);
 140   1          printLT(PRINT_PRIO_HIG, "\nCscRx = 0x%02bx", CscType);
 141   1      }
 142          #if CSC_RANGE_EN ==  ENABLED
              void Drv_CscRx_LimitToFull(IN u8 b1IsLimitToFull,IN u8 ucColorSpace)
              {
                  if (b1IsLimitToFull == TRUE)
                  {
                      BKC7_68_REG |= BIT7_1;//TX [7]data range expand enable
                      if(ucColorSpace == RGB_0)
                      {
                          BKC7_68_REG &= BIT6_0 ; //bit 7:Data range reduce enable
                      }
                      else
                      {
                          BKC7_68_REG |= BIT6_1; //bit 7:Data range expand enable
                      }
                  }
                  else
                  {
                      BKC7_65_REG |= BIT7_1 ; //bit 7:Data range reduce enable
                      if(ucColorSpace == RGB_0)
                      {
                          BKC7_65_REG &= BIT6_0 ; //bit 7:Data range reduce enable
                      }
                      else
                      {
                          BKC7_65_REG |= BIT6_1; //bit 7:Data range reduce enable
                      }
                  }
              }
              #endif
