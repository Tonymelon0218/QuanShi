              void Mod_DpTx_LinkQualPtnSet(u8 ucPtn)
              {
                  BKF5_01_REG  = 0x00;
                  BKF5_02_REG |= BIT6_1;//[6]link train test en: 1-Test pattern transmit enable
                  BKF5_7E_REG &= 0x88;
                  BKF5_7F_REG &= 0x88;
                  switch(ucPtn & 0x07)
                  {
                      case 0x01://D10.2 without scrambling   
                          BKF5_7D_REG |= BIT1_1; //scrmable disable  new design in 2204 
                          BKF5_7E_REG |= 0x11;
                          BKF5_7F_REG |= 0x11;
                          break;
                      case 0x02://Symbol_Error_Measurement_Count    
                          BKF5_7E_REG |= 0x22;
                          BKF5_7F_REG |= 0x22;
                          break;
                      case 0x03://PRBS7
                          BKF5_7E_REG |= 0x33;//lane1, 0;  33, 03
                          BKF5_7F_REG |= 0x33;//lane3, 2; 
                          break;
                      case 0x04://80-bit custom pattern transmitted    
                          BKF5_41_REG = 0xE0;//PLTPAT 80BIT, 80 Bit Custom pattern
                          BKF5_42_REG = 0x83;//PLTPAT 80BIT
                          BKF5_43_REG = 0x0F;//PLTPAT 80BIT
                          BKF5_44_REG = 0x3E;//PLTPAT 80BIT
                          BKF5_45_REG = 0xF8;//PLTPAT 80BIT
                          BKF5_46_REG = 0xE0;//PLTPAT 80BIT
                          BKF5_47_REG = 0x83;//PLTPAT 80BIT
                          BKF5_48_REG = 0x0F;//PLTPAT 80BIT
                          BKF5_49_REG = 0x3E;//PLTPAT 80BIT
                          BKF5_4A_REG = 0xF8;//PLTPAT 80BIT
                          BKF5_7E_REG |=0x44;                    
                          BKF5_7F_REG |=0x44;
                          BKF5_40_REG = 0x08;
                          break;
                      case 0x05://CP2520 Pattern 1
                          BKF5_00_REG = 0x40;
                          BKF5_0F_REG = 0x00;
                          BKF5_40_REG = 0xfc;
                          BKF5_7D_REG &=BIT1_0; //scramble en
              
C51 COMPILER V9.53.0.0   MODDPLINKCTS                                                      02/13/2025 10:14:02 PAGE 2   

                          BKF5_7E_REG = 0x11;
                          BKF5_7F_REG = 0x11;
                          BKF5_02_REG &=BIT5_0; 
                          Ocm_Delay1ms(1);
                          BKF5_02_REG |=BIT5_1; 
                          BKF5_7E_REG = 0x55;    
                          BKF5_7F_REG = 0x55;
                          break;
                      case 0x06://CP2520 Pattern 2    
                          BKF5_00_REG = 0x80;    
                          BKF5_0F_REG = 0x00;
                          BKF5_40_REG = 0xfc;
                          BKF5_7D_REG &=BIT1_0;//scramble en
              
                          BKF5_7E_REG = 0x11;
                          BKF5_7F_REG = 0x11;
                          BKF5_02_REG &=BIT5_0; 
                          Ocm_Delay1ms(1);
                          BKF5_02_REG |=BIT5_1; 
                          BKF5_7E_REG = 0x55;    
                          BKF5_7F_REG = 0x55;
                          break;
                      case 0x07://CP2520 Pattern 3    
                          BKF5_00_REG = 0xc0;    
                          BKF5_01_REG |=0x80;//tps4 k28.0-
                          BKF5_0F_REG = 0x00;
                          BKF5_40_REG = 0xfc;
                          BKF5_7D_REG &=BIT1_0;//scramble en
              
                          BKF5_7E_REG = 0x11;
                          BKF5_7F_REG = 0x11;
                          BKF5_02_REG &=BIT5_0; 
                          Ocm_Delay1ms(1);
                          BKF5_02_REG |=BIT5_1; 
                          BKF5_7E_REG = 0x55;    
                          BKF5_7F_REG = 0x55;
                          break;
                      default:
                          break;
                  }
              }
              
              void Mod_DpTx_TestEdid(u8 b1IsInrq,u8 *pucEDID_Data)
              {
                  u8 ucdpcd201,ucdpcd218;
                  if(b1IsInrq == 0)
                  {
                      Mod_DpTxLink_DpcdRead(0x00,0x0201,Rx_Buff,1);
                      ucdpcd201 = Rx_Buff[0];
                      Mod_DpTxLink_DpcdRead(0x00,0x0218,Rx_Buff,1);
                      ucdpcd218 = Rx_Buff[0];
                  }
                  else
                  {
                      ucdpcd201 = 0x02;
                      ucdpcd218 = 0x04; 
                  }
                  if((ucdpcd201&0x02)&&(ucdpcd218&0x04))
                  {
                      switch(pucEDID_Data[0x7e])
                      {
                          case 0x01://2 block
C51 COMPILER V9.53.0.0   MODDPLINKCTS                                                      02/13/2025 10:14:02 PAGE 3   

                              Tx_Buff[0] = pucEDID_Data[0xff];
                              break;
                          case 0x02://3 block
                              Tx_Buff[0] = pucEDID_Data[0x17f];
                              break;
                          case 0x03://4 block
                              Tx_Buff[0] = pucEDID_Data[0x1ff];
                              break;
                          default:
                              Tx_Buff[0] = pucEDID_Data[0x7f];
                              break;
                      }
                      Mod_DpTxLink_DpcdWrite(0x00,0x0261, Tx_Buff,1); // the checksum of the last EDID block that was re
             -ad is written here
                      Tx_Buff[0] = 0x05;//[2]edid checksum has been written to the "test_edid_checksum"
                      Mod_DpTxLink_DpcdWrite(0x00,0x0260, Tx_Buff, 1);//[0]positive acknowledgement of the test_req
                  }
              }
              
              void Mod_DpTx_Automated_Test_Init(void)
              {
                  BKF5_02_REG &= BIT6_0; //disable test pattern
                  #if RX_PORT_SIGN == DP_PORT
                  BKC7_D7_REG &= 0xcf;
                  #endif
                  #if RX_PORT_SIGN == HDMI_PORT
                  BKC7_D7_REG &= 0xcf;
                  BKC7_D7_REG |= 0x10;
                  #endif
                  BKC7_C1_REG = 0x77; 
                  BKC7_C0_REG = 0x30;
                  BKC7_D5_REG = 0x01;
                  g_stDpTx.ucMsaValue = 0x00;
                  g_stDpTx.ucMisc0 = 0x00; 
              }
              
              void Mod_DpTx_Automated_Test_Pattern(void)
              {
                  printLT(PRINT_PRIO_HIG,"\ntest link training");
                          
                  BKF5_02_REG |= BIT6_1;//[6]link train test en: 0-test pattern transmit disable
                  BKC7_D7_REG |= 0x30; //sel pattern
                  BKC7_C1_REG = 0x07; //pattern data from register
              //    BKC7_D7_REG &= BIT0_0;//[0]rgd_rx_da_src_sel: 0-dp
                  Mod_DpTxLink_DpcdRead(0x00,0x0221,Rx_Buff,1);//test_pattern
                  BKC7_D6_REG   = (Rx_Buff[0] & 0x0f) << 4;    //dpcd-00221: ptn
                  printLT(PRINT_PRIO_HIG,"\nucdpcd221 = 0x%02bx",Rx_Buff[0]);
                  
                  Mod_DpTxLink_DpcdRead(0x00,0x0222,Rx_Buff,16);//MSA
                  BKC7_C3_REG = (((((u16)Rx_Buff[4]<<8)+Rx_Buff[5])/2)>>8); //hstart[15:8]
                  BKC7_C4_REG = ((((u16)Rx_Buff[4]<<8)+Rx_Buff[5])/2); //hstart[7:0]
                  BKC7_C5_REG = Rx_Buff[6]; //vstart[15:8]
                  BKC7_C6_REG = Rx_Buff[7]; //vstart[7:0]
                  BKC7_C7_REG = (((((u16)Rx_Buff[12]<<8)+Rx_Buff[13])/2)>>8); //hactive[15:8]
                  BKC7_C8_REG = ((((u16)Rx_Buff[12]<<8)+Rx_Buff[13])/2); //hactive[7:0]
                  BKC7_C9_REG = Rx_Buff[14]; //vactive[15:8]
                  BKC7_CA_REG = Rx_Buff[15]; //vactive[7:0]
                  BKC7_CB_REG = (((((u16)Rx_Buff[0]<<8)+Rx_Buff[1])/2)>>8); //htotal[15:8]
                  BKC7_CC_REG = ((((u16)Rx_Buff[0]<<8)+Rx_Buff[1])/2); //htotal[7:0]
                  BKC7_CD_REG = Rx_Buff[2]; //vtotal[15:8]
                  BKC7_CE_REG = Rx_Buff[3]; //vtotal[7:0]
                  BKC7_CF_REG = (((((u16)(Rx_Buff[8] & BIT7_0)<<8)+Rx_Buff[9])/2)>>8); //hsync[15:8]
C51 COMPILER V9.53.0.0   MODDPLINKCTS                                                      02/13/2025 10:14:02 PAGE 4   

                  BKC7_D0_REG = ((((u16)(Rx_Buff[8] & BIT7_0)<<8)+Rx_Buff[9])/2); //hsync[7:0]
                  BKC7_D1_REG = Rx_Buff[11]; //vsync[7:0]
                  if((Rx_Buff[8] & 0x80) == 0x80) //h polarity
                  {
                      BKC7_C0_REG &= BIT4_0;
                  }
                  else
                  {
                      BKC7_C0_REG |= BIT4_1;
                  }
                  if((Rx_Buff[10] & 0x80) == 0x80) //v polarity
                  {
                      BKC7_C0_REG &= BIT5_0;
                  }
                  else
                  {
                      BKC7_C0_REG |= BIT5_1;
                  }
                  
                  Mod_DpTxLink_DpcdRead(0x00,0x0232,Rx_Buff,3);//misc0
                  if((Rx_Buff[0] & 0x06) == 0x02) //422
                  {
                      BKC7_D6_REG &= 0xfc;
                      BKC7_D6_REG |= BIT0_1;
                      g_stDpTx.ucMsaValue &= 0xf3;
                      g_stDpTx.ucMsaValue |= BIT2_1;
                      g_stDpTx.ucMisc0 &= 0xfa;
                      g_stDpTx.ucMisc0 |= 0x0a;
                  }
                  else if((Rx_Buff[0] & 0x06) == 0x00) //RGB
                  {
                      BKC7_D6_REG &= 0xfc;
                      g_stDpTx.ucMsaValue &= 0xf3;
                      g_stDpTx.ucMisc0 &= 0xe0;
                  }
                  else if((Rx_Buff[0] & 0x06) == 0x04) //444
                  {
                      BKC7_D6_REG &= 0xfc;
                      BKC7_D6_REG |= BIT1_1;
                      g_stDpTx.ucMsaValue &= 0xf3;
                      g_stDpTx.ucMsaValue |= BIT3_1;
                      g_stDpTx.ucMisc0 &= 0xfc;
                      g_stDpTx.ucMisc0 |= 0x0c;
                  }
                  if((Rx_Buff[0] & 0x08) == 0x08) //CTA range
                  {
                      BKC7_D5_REG &= BIT4_0;
                      g_stDpTx.ucMisc0 |= BIT3_1;
                  }
                  else //VESA range
                  {
                      BKC7_D5_REG |= BIT4_1;
                      g_stDpTx.ucMisc0 &= BIT3_0;
                  }
                  if((Rx_Buff[0] & 0x10) == 0x10) //BTU 709
                  {
                      BKC7_D5_REG &= BIT5_0;
                      g_stDpTx.ucMisc0 |= BIT4_1;
                  }
                  else //BTU 601
                  {
                      BKC7_D5_REG |= BIT5_1; 
C51 COMPILER V9.53.0.0   MODDPLINKCTS                                                      02/13/2025 10:14:02 PAGE 5   

                      g_stDpTx.ucMisc0 &= BIT4_0;
                  }
                  if((Rx_Buff[0] & 0xe0) == 0x00) //6 bit
                  {
                      BKC7_D5_REG &= 0xf8;
                      g_stDpTx.ucMsaValue &= 0x8f;
                      g_stDpTx.ucMisc0 &= 0x1f;
                  }
                  else if((Rx_Buff[0] & 0xe0) == 0x20) //8 bit
                  {
                      BKC7_D5_REG &= 0xf8;
                      BKC7_D5_REG |= BIT0_1;
                      g_stDpTx.ucMsaValue &= 0x8f;
                      g_stDpTx.ucMsaValue |= BIT4_1;
                      g_stDpTx.ucMisc0 &= 0x1f;
                      g_stDpTx.ucMisc0 |= BIT5_1;
                  }
                  else if((Rx_Buff[0] & 0xe0) == 0x40) //10 bit
                  {
                      BKC7_D5_REG &= 0xf8;
                      BKC7_D5_REG |= BIT1_1;
                      g_stDpTx.ucMsaValue &= 0x8f;
                      g_stDpTx.ucMsaValue |= BIT5_1;
                      g_stDpTx.ucMisc0 &= 0x1f;
                      g_stDpTx.ucMisc0 |= BIT6_1;
                  }
                  else if((Rx_Buff[0] & 0xe0) == 0x60) //12 bit
                  {
                      BKC7_D5_REG &= 0xf8;
                      BKC7_D5_REG |= 0x03;
                      g_stDpTx.ucMsaValue &= 0x8f;
                      g_stDpTx.ucMsaValue |= 0x30;
                      g_stDpTx.ucMisc0 &= 0x1f;
                      g_stDpTx.ucMisc0 |= 0x60;
                  }
                  BKF7_17_REG = g_stDpTx.ucMsaValue;
                  BKF7_18_REG = g_stDpTx.ucMisc0;
                  
              }
              #endif
