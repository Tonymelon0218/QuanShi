                          Mod_DpTx_SendSwingAdjReq();
                          if(ucdpcd248 > 0)//ptn request
                          {
                              Tx_Buff[0] = Tx_Buff[1] = Tx_Buff[2] = Tx_Buff[3] = ucdpcd248; 
                              Mod_DpTxLink_DpcdWrite(0x00,0x010B,Tx_Buff,4);//lane0~ lane3 ptn set
                              Mod_DpTx_LinkQualPtnSet(ucdpcd248);
                          }
                      }
                      if ((ucdpcd218 == 0)&&(ucdpcd246 & BIT5_1))//TEST_CRC_SUPPORTED
                      {
                          Tx_Buff[0] = 0x00;//[0]test start
                          Mod_DpTxLink_DpcdWrite(0x00,0x0270,Tx_Buff,1);
                          
                          Tx_Buff[0] = 0x02;//[0]test_ack: 1-ack
                          Mod_DpTxLink_DpcdWrite(0x00,0x0260,Tx_Buff,1);
                      }
                      Drv_DpTx_VidOutEn(TRUE);
                  }
                  #endif 
