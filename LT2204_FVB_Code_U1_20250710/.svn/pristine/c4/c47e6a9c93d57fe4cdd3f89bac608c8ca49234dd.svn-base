  49          void Drv_HdmiRxDscBy_TimingGet(void)
  50          {
  51   1          u8 ucCnt, ucNum;
  52   1          u16 usCrt = 0, usLast = 0;
C51 COMPILER V9.53.0.0   DRVHDMIRXDSCBYPASS                                                02/13/2025 10:14:19 PAGE 2   

  53   1      
  54   1          //=================wait video check stable=====================
  55   1          ucCnt = 0;
  56   1          ucNum = 150;
  57   1          while(ucNum--)
  58   1          {
  59   2              Ocm_Delay1ms(2);
  60   2              usCrt = PACK_16_BIT(BKC8_56_REG, BKC8_57_REG);
  61   2              if (usLast == usCrt)
  62   2              {
  63   3                  ucCnt++;
  64   3                  if (ucCnt > 10)
  65   3                  {
  66   4                      break;
  67   4                  }
  68   3              }
  69   2              else
  70   2              {
  71   3                  ucCnt = 0;
  72   3                  usLast = usCrt;
  73   3              }
  74   2          }
  75   1          //=================wait video check stable=====================
  76   1      
  77   1          //get V timing by VideoCheck
  78   1          Drv_HdmiRx_RxTimingGet(&g_stHdmiRxDscByTiming);
  79   1          //get H timing by EMP pkt
  80   1          g_stHdmiRxDscByTiming.usHbp   = PACK_16_BIT(BKCB_3F_REG, BKCB_40_REG);
  81   1          g_stHdmiRxDscByTiming.usHsync = PACK_16_BIT(BKCB_3D_REG, BKCB_3E_REG);
  82   1          g_stHdmiRxDscByTiming.usHfp   = PACK_16_BIT(BKCB_3B_REG, BKCB_3C_REG);
  83   1          g_stHdmiRxDscByTiming.usHact  = PACK_16_BIT(BKCB_42_REG, BKCB_43_REG);
  84   1          g_stHdmiRxDscByTiming.usHtol  = PACK_16_BIT(BKCB_44_REG, BKCB_45_REG);
  85   1      
  86   1          #if 1
