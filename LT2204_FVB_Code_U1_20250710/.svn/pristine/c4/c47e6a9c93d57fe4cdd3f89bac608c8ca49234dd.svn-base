  97          // Func Name   : Drv_HdmiRxDscBy_DscInfoGet
  98          // Description : dsc pps info get
  99          // Input       : void  
 100          // Output      : None
 101          // Return      : void
 102          //========================================================================
 103          void Drv_HdmiRxDscBy_DscInfoGet(void)
 104          {
 105   1          u8 usPpsDetCnt;
 106   1          u16 temp0, temp1;
 107   1          u8 pps3, pps4, pps5, pps8, pps9, pps10, pps11, pps12, pps13, pps14, pps15, pps88;
 108   1      
 109   1          //packet mode set to RGB
C51 COMPILER V9.53.0.0   DRVHDMIRXDSCBYPASS                                                02/13/2025 10:14:19 PAGE 3   

 110   1          BKCC_10_REG |= BIT0_1;//[0]color space en
 111   1          BKCC_10_REG &= 0x8f;//[6:4]color space value: 0-RGB, 1-YUV422, 2-YUV444, 3-YUV420
 112   1          BKCC_0F_REG |= BIT2_1;//[2]rgd_audc_cd_sel: 1-software configure color depth value
 113   1          BKCC_0F_REG &= 0x0f;//[7:4]color depth value: 4-8bit
 114   1          BKCC_0F_REG |= 0x40;
 115   1      
 116   1      //    Ocm_Delay1us(2);//must be wait load success
 117   1              usPpsDetCnt = 0;
 118   1          Drv_System_IntClr(IRQ_HDMIRX_PPS_LOAD_SUCC_INT);
 119   1          while(usPpsDetCnt < 500)
 120   1          {
 121   2              usPpsDetCnt++;
 122   2              Ocm_Delay1us(100);
 123   2              if (Drv_System_IntFlagGet(IRQ_HDMIRX_PPS_LOAD_SUCC_INT) == TRUE)//[3]pps packet interrupt flag
 124   2              {
 125   3                  Ocm_Delay1us(10);//must be wait load success
 126   3                  Drv_System_SramPathSet(HDMIRX_DSCBYPASS_PPS_PATH);
 127   3                  break;
 128   3              }
 129   2          }
 130   1          //////////////////////////////////////////pps sram start
 131   1          Drv_System_SramPathSet(HDMIRX_DSCBYPASS_PPS_PATH);
 132   1          
 133   1          BKE5_6A_REG = 0x00; //sram address num = 0   pps0/1/2/3 <- e683/e682/e681/e680
 134   1          Ocm_Delay1us(2);
 135   1          pps3 = BKE6_80_REG;
 136   1          BKE5_6A_REG = 0x01; //sram address num = 1   pps4/5/6/7 <- e683/e682/e681/e680
 137   1          Ocm_Delay1us(2);
 138   1          pps4 = BKE6_83_REG;
 139   1          pps5 = BKE6_82_REG;
 140   1          BKE5_6A_REG = 0x02; //sram address num = 2   pps8/9/10/11 <- e683/e682/e681/e680
 141   1          Ocm_Delay1us(2);
 142   1          pps8 = BKE6_83_REG;
 143   1          pps9 = BKE6_82_REG;
 144   1          pps10 = BKE6_81_REG;
 145   1          pps11 = BKE6_80_REG;
 146   1          BKE5_6A_REG = 0x03; //sram address num = 3   pps12/13/14/15 <- e683/e682/e681/e680
 147   1          Ocm_Delay1us(2);
 148   1          pps12 = BKE6_83_REG;
 149   1          pps13 = BKE6_82_REG;
 150   1          pps14 = BKE6_81_REG;
 151   1          pps15 = BKE6_80_REG;
 152   1          BKE5_6A_REG = 0x16; //sram address num = 22   pps88/89/90/91 <- e683/e682/e681/e680
 153   1          Ocm_Delay1us(2);
 154   1          pps88 = BKE6_83_REG;
 155   1          //////////////////////////////////////////pps sram end
 156   1      
 157   1           //color space and depth get
 158   1          g_stHdmiRxDscByInfo.ucColorDepth = (pps3 >> 5);//8 bit = 0x04, so >> 4 and /2, is >> 5
 159   1          if (pps88 & BIT0_1)
 160   1              g_stHdmiRxDscByInfo.ucColorSpace = YCbCr422_1;
 161   1          else if (pps88 & BIT1_1)
 162   1              g_stHdmiRxDscByInfo.ucColorSpace = YCbCr420_3;
 163   1          else if (pps4 & BIT3_1)
 164   1              g_stHdmiRxDscByInfo.ucColorSpace = SIMPLE422_5;
 165   1          else if (pps4 & BIT4_1)//pps4[4]: 1-RGB, 0-nonRGB
 166   1              g_stHdmiRxDscByInfo.ucColorSpace = RGB_0;
 167   1          else
 168   1              g_stHdmiRxDscByInfo.ucColorSpace = YCbCr444_2;
 169   1      
 170   1          g_stHdmiRxDscByInfo.usBpp = ((u16)(pps4 & 0x03) << 8) + pps5;
 171   1          temp1 = g_stHdmiRxDscByInfo.usBpp;
C51 COMPILER V9.53.0.0   DRVHDMIRXDSCBYPASS                                                02/13/2025 10:14:19 PAGE 4   

 172   1          if (g_stHdmiRxDscByInfo.ucColorSpace == YCbCr422_1)
 173   1          {
 174   2               temp0 = 24;//24/bpp
 175   2               temp1 >>= 1;
 176   2          }
 177   1          else if(g_stHdmiRxDscByInfo.ucColorSpace == YCbCr420_3)
 178   1          {
 179   2               temp0 = 12;
 180   2               temp1 >>= 1;
 181   2          }
 182   1          else
 183   1          {
 184   2               temp0 = 24;
 185   2          }
 186   1          temp0 *= 160;
 187   1          g_stHdmiRxDscByInfo.ucCompressRatio = (u8)(temp0 / temp1);
 188   1      
 189   1          temp0 = ((u16)pps8 << 8) + pps9;
 190   1          temp1 = ((u16)pps12 << 8) + pps13;
 191   1          g_stHdmiRxDscByInfo.ucSliceNum = temp0 / temp1;
 192   1      
 193   1          g_stHdmiRxDscByInfo.usSliceHeight = ((u16)pps10 << 8) + pps11;
 194   1          g_stHdmiRxDscByInfo.usSliceWidth  = ((u16)pps12 << 8) + pps13;
 195   1          if ((g_stHdmiRxDscByInfo.ucColorSpace == YCbCr422_1) || (g_stHdmiRxDscByInfo.ucColorSpace == YCbCr420_
             -3))//420 or 422 or simple_422
 196   1          {
 197   2              g_stHdmiRxDscByInfo.usSliceWidth >>= 1;
 198   2          }
 199   1          if (g_stHdmiRxDscByInfo.ucColorSpace == YCbCr420_3)
 200   1          {
 201   2              g_stHdmiRxDscByInfo.usSliceHeight >>= 1;
 202   2          }
 203   1      
 204   1          g_stHdmiRxDscByInfo.usChunkSize = ((u16)pps14 << 8) + pps15;
 205   1          g_stHdmiRxDscByInfo.ucCoreNum = g_stHdmiRxDscByInfo.ucSliceNum;
 206   1          return;
 207   1      }
