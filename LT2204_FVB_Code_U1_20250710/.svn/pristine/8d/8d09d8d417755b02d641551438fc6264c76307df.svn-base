  16          bool Mod_DpTxLink_SingleDpcdWriteDH(u8 cmd_addr, u16 addr, u8 *buf,u8 len)
  17          {
  18   1          u16 Loopx;
  19   1          u8 ReplyStatus;
  20   1      
  21   1          if(Mod_DpTx_SinkHpdDet() == NO_ACTION)
  22   1          {
  23   2              Ocm_Delay1ms(1);//filter the irq 0.5-1ms 
  24   2          }
  25   1      
  26   1          if(Mod_DpTx_SinkHpdDet() == HIGH)
  27   1          {
  28   2              BKF5_2B_REG = cmd_addr;
  29   2              BKF5_2B_REG = (addr >>8 )& 0xff;
  30   2              BKF5_2B_REG = addr & 0xff;
  31   2              if(len)
  32   2              {
  33   3                  BKF5_2B_REG = len-1;
  34   3              }
  35   2              for(Loopx = 0; Loopx < len; Loopx++)
  36   2              {
  37   3                  BKF5_2B_REG = buf[Loopx];
  38   3              }
  39   2              BKF5_2C_REG = 0x00;//start write
  40   2              Ocm_Delay1us(100);//for cts test request
  41   2              for(Loopx = 0; Loopx < 400; Loopx ++)
  42   2              {
  43   3                  Ocm_Delay1us(10);
  44   3                  if(BKF5_30_REG & BIT0_1)//[0]the aux transaction detect
  45   3                  {
  46   4                      ReplyStatus = BKF5_2B_REG;
  47   4                      if(ReplyStatus == 0x00)//ack
  48   4                      {
  49   5                          return 0;
  50   5                      }
  51   4                      else
  52   4                      {
  53   5                          return 1;
C51 COMPILER V9.53.0.0   MODDPLINKTRAIN                                                    02/13/2025 10:14:02 PAGE 2   

  54   5                      }
  55   4                  }
  56   3              }
  57   2          }
  58   1          return 1;
  59   1      }
