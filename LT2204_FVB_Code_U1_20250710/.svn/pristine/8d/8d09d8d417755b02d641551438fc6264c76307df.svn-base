 735          void Mod_DpTx_SendSwingAdjReq(void)
 736          {
 737   1          u8 szLaneSwPre[4];
 738   1          u8 ucLaneIndex, ucTemp;
 739   1      
 740   1          Tx_Buff[0] = Tx_Buff[1] = Tx_Buff[2] = Tx_Buff[3] = 0;
 741   1          ucTemp = (g_stAuxDpTx.ucLaneCntCap == 4)? (2) : (1);
 742   1          Mod_DpTxLink_DpcdRead(0x00,0x0206,Rx_Buff,ucTemp);
 743   1          printLT(PRINT_PRIO_TEST, "\nRd206 = 0x%02bx,0x%02bx",Rx_Buff[0],Rx_Buff[1]);
 744   1      
 745   1          szLaneSwPre[0] = Rx_Buff[0] & 0x0f;       //lane0 sw and pre
 746   1          szLaneSwPre[1] = (Rx_Buff[0] >> 4) & 0x0f;//lane1 sw and pre
 747   1          szLaneSwPre[2] = Rx_Buff[1] & 0x0f;       //lane2 sw and pre
 748   1          szLaneSwPre[3] = (Rx_Buff[1] >> 4) & 0x0f;//lane3 sw and pre
 749   1          for (ucLaneIndex = 0; ucLaneIndex < g_stAuxDpTx.ucLaneCntCap; ucLaneIndex++)
 750   1          {
 751   2              //set swing and pre
 752   2              ucTemp = Mod_DpTx_SwPreMap(szLaneSwPre[ucLaneIndex]);
 753   2              Drv_DpTx_LaneSwingSet(g_stDpTx.b1IsDpOrTypec, ucTemp, ucLaneIndex);
 754   2      
 755   2              //update swing and pre
 756   2              g_stAuxDpTx.ucVoltSwing = szLaneSwPre[ucLaneIndex] & 0x03;//swing
 757   2              g_stAuxDpTx.ucPreEmphase = (szLaneSwPre[ucLaneIndex] & 0x0c) >> 2;//pre
 758   2              if (g_stAuxDpTx.ucVoltSwing == 0x03)
 759   2              {
 760   3                  g_stAuxDpTx.ucVoltSwing |= 0x04;//DPCD-00103 [2]max_swing_reached
 761   3              }
 762   2              if ((g_stAuxDpTx.ucPreEmphase + g_stAuxDpTx.ucVoltSwing) > 3)
 763   2              {
 764   3                  g_stAuxDpTx.ucPreEmphase = 0;//look at Swing_Pre_Value[]
 765   3              }
 766   2              if (g_stAuxDpTx.ucPreEmphase == 0x03)
 767   2              {
 768   3                  g_stAuxDpTx.ucPreEmphase |= 0x04;//DPCD-00103 [5]max_pre-emphasis_reached
 769   3              }
 770   2              Tx_Buff[ucLaneIndex] = g_stAuxDpTx.ucVoltSwing + (g_stAuxDpTx.ucPreEmphase << 3);
 771   2          }
 772   1          Mod_DpTxLink_DpcdWrite(0x00,0x0103,Tx_Buff,g_stAuxDpTx.ucLaneCntCap);
 773   1      }
