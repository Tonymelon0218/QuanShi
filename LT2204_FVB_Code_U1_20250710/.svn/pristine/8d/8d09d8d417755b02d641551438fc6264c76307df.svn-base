 714          u8 Mod_DpTx_SwPreMap(u8 ucVal)
 715          {
 716   1          if(ucVal == 0x08)
 717   1          {
 718   2              return 0x07;
C51 COMPILER V9.53.0.0   MODDPLINKTRAIN                                                    02/13/2025 10:14:02 PAGE 13  

 719   2          }
 720   1          else if(ucVal == 0x09)
 721   1          {
 722   2              return 0x08;
 723   2          }       
 724   1          else if(ucVal == 0x0c)
 725   1          {
 726   2              return 0x09;
 727   2          }
 728   1          else if(ucVal <= 0x06)
 729   1          {
 730   2              return ucVal;
 731   2          }
 732   1          return 0x00;
 733   1      }
