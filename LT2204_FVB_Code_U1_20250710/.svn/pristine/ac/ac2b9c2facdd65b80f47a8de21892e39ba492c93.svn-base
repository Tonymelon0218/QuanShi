 569   2              BKA2_01_REG |= 0x07;//[4:0]rg_lmtxpll_prediv_sel: 01111-/8
 570   2              BKA2_06_REG |= 0x40;//[6:4]rg_lmtxpll_tmds_freq_set: 010-/16
