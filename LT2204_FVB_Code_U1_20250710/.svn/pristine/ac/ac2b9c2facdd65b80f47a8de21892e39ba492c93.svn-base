 751          //========================================================================
 752          // Func Name   : Drv_DpTx_VdChkStableGet
 753          // Description : juage tx video stable or unstable
 754          // Input       : void  
 755          // Output      : None
 756          // Return      : STABLE/UNSTABLE/UNKNOWN
 757          //========================================================================
 758          u8 Drv_DpTx_VdChkStableJudge(void)
 759          {
 760   1          u16 usDpTxHact,usHdmiRxHact;
 761   1          u16 usDpTxVact,usHdmiRxVact;
 762   1      
 763   1          #if DPTX_DSC_ENC_SUPPORT == ENABLED
                  if (Drv_DpTxDscEnc_SwitchGet() == ENABLED)
                  {
                      return STABLE;
                  }
                  #endif
 769   1          #if DPTX_DSC_BYPASS_SUPPORT == ENABLED
 770   1          if (g_stDpTx.b1SrcDscByEn == ENABLED)
 771   1          {
 772   2              return STABLE;
 773   2          }
 774   1          #endif
 775   1          usHdmiRxHact = ((u16)BKC8_58_REG << 8) + BKC8_59_REG;
 776   1          usHdmiRxVact = ((u16)BKC8_56_REG << 8) + BKC8_57_REG;
 777   1          usDpTxHact   = ((u16)BKF7_FA_REG << 8) + BKF7_FB_REG;
 778   1          usDpTxVact   = ((u16)BKF7_F8_REG << 8) + BKF7_F9_REG;
 779   1          #if CSC_SUPPORT == ENABLED
 780   1          if(BKC7_67_REG & BIT6_1) //YUV420 to YUV422 enable
 781   1          {
 782   2              usHdmiRxHact <<= 1;
 783   2          }
 784   1          else if(BKC7_66_REG & BIT1_1) //YUV422 to YUV420 enable
 785   1          {
 786   2              usHdmiRxHact >>= 1;
 787   2          }
 788   1          #endif
C51 COMPILER V9.53.0.0   DRVDPTX                                                           02/13/2025 10:14:15 PAGE 14  

 789   1      
 790   1          if ((usHdmiRxHact == usDpTxHact) && (usHdmiRxVact == usDpTxVact))
 791   1          {
 792   2              return STABLE;
 793   2          }
 794   1          else
 795   1          {
 796   2              return UNSTABLE;    
 797   2          }
 798   1      }
