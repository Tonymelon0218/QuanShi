 141   2                  BKED_22_REG = 0x01;//[6:4]rgd_dhtx_d0_src_sel; //[2:0]rgd_dhtx_d1_src_sel
 142   2                  BKED_23_REG = 0x23;//[6:4]rgd_dhtx_d2_src_sel; //[2:0]rgd_dhtx_d3_src_sel
 143   2                  break;
 144   2                              
 145   2              case TYPEC_FEMALE_NOFLIP:
 146   2                  BKED_21_REG &= 0x0f;//[7:4]rgd_dhtx_d0(~d3)_pn_swap_en: 0-dis
 147   2                  BKED_21_REG |= 0x30;
 148   2                  BKED_22_REG = 0x30;//[6:4]rgd_dhtx_d0_src_sel; //[2:0]rgd_dhtx_d1_src_sel
 149   2                  BKED_23_REG = 0x21;//[6:4]rgd_dhtx_d2_src_sel; //[2:0]rgd_dhtx_d3_src_sel
 150   2                  break;        
 151   2              case TYPEC_FEMALE_FLIP:
 152   2                  BKED_21_REG &= 0x0f;//[7:4]rgd_dhtx_d0(~d3)_pn_swap_en: 0-dis
 153   2                  BKED_21_REG |= 0x30;
 154   2                  BKED_22_REG =  0x03;//[6:4]rgd_dhtx_d0_src_sel; //[2:0]rgd_dhtx_d1_src_sel
 155   2                  BKED_23_REG =  0x12;//[6:4]rgd_dhtx_d2_src_sel; //[2:0]rgd_dhtx_d3_src_sel
 156   2                  break;
 157   2              default:
 158   2              break;
 159   2          }
 160   1      }
