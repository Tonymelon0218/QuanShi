 972          //#if DPTX_DSC_BYPASS_SUPPORT == ENABLED
 973          #if 0
              void Drv_DpTx_MvidCal(void)
C51 COMPILER V9.53.0.0   DRVDPTX                                                           02/13/2025 10:14:15 PAGE 17  

              {
                  u16 usBypassHtol;
                  u16 ucFl_Clk;
                  u32 Mvid,Nvid;
                  u32 ulDsc_Bypass_Pixclk;
               
                  if(g_stAuxDpTx.ucLinkRateCap == HBR3)
                  {
                      ucFl_Clk = 0x32a;//8.1g * 100 = 810
                  }
                  else if(g_stAuxDpTx.ucLinkRateCap == HBR2)
                  {
                      ucFl_Clk = 0x21c;//5.4g * 100 = 540
                  }
                  else if (g_stAuxDpTx.ucLinkRateCap == HBR)
                  {
                      ucFl_Clk = 0x10e;//2.7g * 100 = 270
                  }
                  else
                  {
                      ucFl_Clk = 0xa2;//1.62g * 100 =162
                  }
              
                  Nvid = 0xc0000;
                  BKF6_00_REG = Nvid>>16;//[23:16]NVID,08/1080p,0c/4K60
                  BKF6_01_REG = Nvid>>8; //[15:8]NVID,3d/1080p,54/4K60,
                  BKF6_02_REG = Nvid;    //[7:0]NVID,60/1080p,27/4K60
              
                  #if RX_PORT_SIGN == DP_PORT
                  usBypassHtol        = ((u16)BKF3_06_REG<<8)+ BKF3_07_REG;
                  ulDsc_Bypass_Pixclk = ((double)g_stDpTx.ulTxPixelClk *g_stDpRxDscByTiming.usHtol)/usBypassHtol;
                  #endif
                  #if RX_PORT_SIGN == HDMI_PORT
                  usBypassHtol        = ((u16)BKCB_44_REG<<8)+ BKCB_45_REG;
                  ulDsc_Bypass_Pixclk = ((double)g_stDpTx.ulTxPixelClk *g_stHdmiRxDscByTiming.usHtol)/usBypassHtol;
                  #endif
                  printLT(PRINT_PRIO_HIG, "\nDscBypass_Pixclk = %ld", ulDsc_Bypass_Pixclk);
              
                  ulDsc_Bypass_Pixclk = ceil((double)ulDsc_Bypass_Pixclk /1000); //
                  Mvid = (ulDsc_Bypass_Pixclk * Nvid)/ucFl_Clk;  //1080p/
                  
                  BKF6_07_REG = Mvid >> 16;//MVID, 0x09/4k60
                  BKF6_08_REG = Mvid >> 8; //MVID, 0x10/4k60
                  BKF6_09_REG = Mvid;     //MVID, 0x50/4k60
                  BKF6_06_REG |= BIT3_1;   //MVID from register
              }
              #endif
