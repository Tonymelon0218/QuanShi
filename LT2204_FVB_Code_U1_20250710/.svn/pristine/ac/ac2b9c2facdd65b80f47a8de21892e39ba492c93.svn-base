  62          void Drv_DpTx_SwingAdjust(u8 ucStd, u8 ucLane)
  63          {
  64   1          if (ucLane == 0)
  65   1          {
  66   2              BKA1_71_REG= Swing_Pre_Value[ucStd][0];//[7:0]rgd_sw_en_dhtx_tx0_tap_main_iset
  67   2              BKA1_72_REG= Swing_Pre_Value[ucStd][1];//[6:0]rgd_sw_en_dhtx_tx0_tap_post_iset
  68   2              BKA1_70_REG |= BIT0_1;//[0]rgd_sw_en_dhtx_tx0_tap_main_iset: 1-sw en
  69   2              BKA1_72_REG |= BIT7_1;//[7]rgd_sw_en_dhtx_tx0_tap_post_iset: 1-sw en
  70   2          }
  71   1          else if (ucLane == 1)
  72   1          {
  73   2              BKA1_75_REG = Swing_Pre_Value[ucStd][0];//[7:0]rgd_sw_en_dhtx_tx1_tap_main_iset
  74   2              BKA1_76_REG = Swing_Pre_Value[ucStd][1];//[6:0]rgd_sw_en_dhtx_tx1_tap_post_iset
  75   2              BKA1_74_REG |= BIT0_1;//[0]rgd_sw_en_dhtx_tx1_tap_main_iset: 1-sw en
  76   2              BKA1_76_REG |= BIT7_1;//[7]rgd_sw_en_dhtx_tx1_tap_post_iset: 1-sw en
  77   2          }
  78   1          else if (ucLane == 2)
  79   1          {
  80   2              BKA1_79_REG = Swing_Pre_Value[ucStd][0];//[7:0]rgd_sw_en_dhtx_tx2_tap_main_iset
  81   2              BKA1_7A_REG = Swing_Pre_Value[ucStd][1];//[6:0]rgd_sw_en_dhtx_tx2_tap_post_iset
  82   2              BKA1_78_REG |= BIT0_1;//[0]rgd_sw_en_dhtx_tx2_tap_main_iset: 1-sw en
  83   2              BKA1_7A_REG |= BIT7_1;//[7]rgd_sw_en_dhtx_tx2_tap_post_iset: 1-sw en
  84   2          }
  85   1          else if (ucLane == 3)
  86   1          {
  87   2              BKA1_7D_REG = Swing_Pre_Value[ucStd][0];//[7:0]rgd_sw_en_dhtx_tx3_tap_main_iset
  88   2              BKA1_7E_REG = Swing_Pre_Value[ucStd][1];//[6:0]rgd_sw_en_dhtx_tx3_tap_post_iset
  89   2              BKA1_7C_REG |= BIT0_1;//[0]rgd_sw_en_dhtx_tx3_tap_main_iset: 1-sw en
  90   2              BKA1_7E_REG |= BIT7_1;//[7]rgd_sw_en_dhtx_tx3_tap_post_iset: 1-sw en
  91   2          }
  92   1      }
