 196          void Drv_DpTx_IrqDet(bool b1IrqEn)
 197          {
 198   1          BKF5_81_REG |= BIT0_1;
 199   1          if(b1IrqEn == ENABLED)
 200   1          {
 201   2              BKE9_81_REG |= BIT7_1;// RGD_H2_HPD_IRQ_EN = 0;
 202   2              BKF5_9B_REG |= BIT4_1;//rgd_dhtx_hdcp13_hpd_irq_en = 1
 203   2              BKF5_9B_REG &= BIT6_0;
 204   2              if (BKF5_F2_REG & BIT7_1)//[7]dp tx hpd irq flag
 205   2              {
 206   3                  BKF5_02_REG |= 0x03; //irq enabled
 207   3                  BKF5_02_REG &= 0xfc; //irq disable
 208   3              }
 209   2          }
 210   1          else
 211   1          {
 212   2              BKE9_81_REG &= BIT7_0;// RGD_H2_HPD_IRQ_EN = 0;
 213   2              BKF5_9B_REG &= BIT4_0;//rgd_dhtx_hdcp13_hpd_irq_en = 0
 214   2              BKF5_9B_REG |= BIT6_1;
 215   2          }
 216   1      }
