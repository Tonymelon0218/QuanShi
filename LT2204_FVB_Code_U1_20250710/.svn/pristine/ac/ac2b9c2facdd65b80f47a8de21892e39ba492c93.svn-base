 319          void Drv_DpTx_TxPllCali(u8 ucLinkRate)
 320          {
 321   1          u8 ucCalCnt, ucLockCnt;
 322   1      
 323   1          Drv_DpTx_TxPllInit();
 324   1          #if DPTX_SSC_SUPPORT == ENABLED
                  Drv_DpTx_SscEn(DISABLED);
                  #endif
 327   1          ucLockCnt = 0;
 328   1          do
 329   1          {
 330   2              BKA1_48_REG &= 0xfc;//[1:0]rg_dhtxpll_ref_sel: 00-aa_syspll_25m_clk
 331   2              BKA1_50_REG &= 0xf9;//[2:1]rg_dhtxpll_fb_divset: default
 332   2              switch(ucLinkRate)
 333   2              {
 334   3                  case RBR:
 335   3                      BKA1_48_REG |= 0x03;  //[1:0]rg_dhtxpll_ref_sel: 11-aa_syspll_30m_clk
 336   3                      BKA1_55_REG = 0x36;   //gd_sw_dhtxpll_div_set: 0x1b-54
 337   3                      BKA1_54_REG &= 0xfc;  //[1:0]rgd_sw_dhtxpll_freq_set: 00-/1
 338   3                      BKA1_54_REG |= 0x01;  //freq_set =1 div =2
 339   3                      BKA1_50_REG |= BIT2_1;//[2:1]rg_dhtxpll_fb_divset: 10-/1
 340   3                      BKA1_51_REG = 0x00;   //[1:0]rg_dhtxpll_loop_divset: 00-/1
 341   3                      break;
 342   3      
 343   3                  case HBR:
 344   3                      BKA1_55_REG = 0x36;   //gd_sw_dhtxpll_div_set: 0x36-54
 345   3                      BKA1_54_REG &= 0xfc;  //[1:0]rgd_sw_dhtxpll_freq_set: 00-/1
 346   3                      BKA1_50_REG |= BIT2_1;//[2:1]rg_dhtxpll_fb_divset: 10-/1
 347   3                      BKA1_51_REG = 0x00;   //[1:0]rg_dhtxpll_loop_divset: 00-/1
 348   3                      break;
 349   3      
 350   3                  case HBR2:
 351   3                      BKA1_55_REG = 0x36;   //gd_sw_dhtxpll_div_set: 0x36-54
 352   3                      BKA1_54_REG &= 0xfc;  //[1:0]rgd_sw_dhtxpll_freq_set: 00-/1
 353   3                      BKA1_50_REG |= BIT2_1;//[2:1]rg_dhtxpll_fb_divset: 10-/1
 354   3                      BKA1_51_REG = 0x01;   //[1:0]rg_dhtxpll_loop_divset: 01-/2
 355   3                      break;
 356   3      
 357   3                  case HBR3:
