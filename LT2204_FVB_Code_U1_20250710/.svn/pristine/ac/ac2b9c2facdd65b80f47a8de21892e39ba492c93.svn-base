  94          void Drv_DpTx_RtermCali(void)
  95          {
  96   1          u8 ucIndex;
  97   1          u8 ucResult = FAIL;
  98   1      
  99   1          ucIndex = 10;
 100   1          while(ucIndex--)
 101   1          {
 102   2              BKE2_09_REG &= BIT0_0;//[0]rgd_dhrx_rterm_cali_en, 0-dis
 103   2              Ocm_Delay1ms(1);
 104   2              BKE2_09_REG |= BIT0_1;//[0]rgd_dhrx_rterm_cali_en, 1-en
 105   2              Ocm_Delay1ms(2);
 106   2              if(0x02 == (BKE2_10_REG & 0x03))//[1]rgod_dhrx_rterm_cali_done: 1-done; [0]rgod_dhrx_rterm_cali_fa
             -il: 1-fail
 107   2              {
 108   3                  ucResult = SUCCESS;
 109   3                  break;
 110   3              }
 111   2          }
 112   1          printLT(PRINT_PRIO_HIG, "\nDp tx rterm cali value is 0x%02bx", BKE2_11_REG);
 113   1          if(ucResult == SUCCESS)//Rterm calibration done
 114   1          {
C51 COMPILER V9.53.0.0   DRVDPTX                                                           02/13/2025 10:14:15 PAGE 3   

 115   2              printLT(PRINT_PRIO_HIG, "\ncali success");
 116   2          }
 117   1          else
 118   1          {
 119   2              printLT(PRINT_PRIO_HIG, "\ncali failed");
 120   2          }
 121   1      }
