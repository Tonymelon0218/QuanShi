              //================================
              //the function is used to send UCC message;
              //if length is shorter than 10bytes,the data is sent once together;
              //if longer than 10bytes,data is sent two times
              //
              //
              //================================
              void Mod_CC1Msg_Send(void)
              {
                  u8 ucSendData;
                      u8 ucSendMegSndDataOffset;
                  static u8 ucUccTotalData;
                      static u8 ucMessage_ID_Send = 0x00;
                      UCCMSG.pBuffer_Order = UCCMSG.pDataOrder;
                      ucUccTotalData = ((UCCMSG.pDataOrder[1] & 0x70)>>2)+2;
                  for(ucSendMegSndDataOffset=0; ucSendMegSndDataOffset<ucUccTotalData; ucSendMegSndDataOffset++)
                  {
                      ucSendData = *UCCMSG.pDataOrder;
                      UCCMSG.pDataOrder++;
                      if(ucSendMegSndDataOffset<10)
                      {
                              if(ucSendMegSndDataOffset==1)
                          {        
                              ucSendData &=0xF0;
                              if(UCCStatus.b1Msg_ID_Change == 1)
                              {
                                      ucMessage_ID_Send = UCCMSG.ucMessageID;
                                      UCCMSG.ucMessageID = Mod_CCPortMsgId_Cal(UCCMSG.ucMessageID);            
                              }
                              else
                              {
                                  ;
                              }
                              ucSendData = (ucSendData|ucMessage_ID_Send);
C51 COMPILER V9.53.0.0   MODCC1BASICTYPEC                                                  02/13/2025 10:13:58 PAGE 2   

                              (UCCStatus.b1PowerRole)?(ucSendData |= BIT0_1):(ucSendData &= BIT0_0);
                          }
                              else if(ucSendMegSndDataOffset == 0)
                          {
                              ucSendData &= 0x1F;
                              if(UCCMSG.ucCcVersion < PD30)
                              {
                                      ucSendData |=  BIT6_1;
                              }
                              else
                              {
                                      ucSendData |=  BIT7_1;
                              }
                              (UCCStatus.b1DataRole)?(ucSendData |= BIT5_1):(ucSendData &= BIT5_0);
                          }
                              else if((UCCStatus.b1Multi_Function)&&(ucSendMegSndDataOffset== 6))
                          {
                              ucSendData |= BIT4_1; // Multifunction Prefered
                              //屏蔽掉这个是防止因为没有收到Goodcrc从而产生重发，导致重发时VDM版本不对问题
              //              UCCStatus.b1Multi_Function =0;
                          }
                              else if((UCCMSG.b1Vdm_Msg == TRUE)&&(ucSendMegSndDataOffset== 3))
                          {
                              //屏蔽掉这个是防止因为没有收到Goodcrc从而产生重发，导致重发时VDM版本不对问题
                                              //UCCMSG.b1Vdm_Msg = FALSE;
                              (UCCMSG.ucCcVersion >= PD30)?(ucSendData |= BIT5_1):(ucSendData &= BIT5_0);
                          }
                      }
                      else if(ucSendMegSndDataOffset==10)//send data enable
                      {        
                          BKFC_19_REG = 0x09; 
                      }
                      BKFC_1A_REG     = ucSendData;   
                  }
                      if(ucSendMegSndDataOffset>10)
                  {
                      ;
                  }
                  else
                  {
                      BKFC_19_REG = 0x09; 
                  }
                  
                  BKFC_23_REG = 0x01; //clr rx fifo
                  BKFC_18_REG |= BIT3_1;      //mark all data done
                  BKFC_18_REG &= BIT3_0;
                      Mod_CCPortMsg_Retry(UCC);    
              }
              
