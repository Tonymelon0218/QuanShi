                          if(UCCStatus.uclaneCount == FOUR_LANE)
                          {
                              UCCMSG.pDataOrder = szCCData_REQDpConfig_PINCE;//Update HIGH
                          }
                          else
                          {
                              UCCMSG.pDataOrder = szCCData_REQDpConfig_PIND;//Update LOW
                          }
                          b1HpdState = (UCCMSG.szRcvDate[4]&BIT7_1)?(TRUE):(FALSE);
