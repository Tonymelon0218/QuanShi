                          Mod_AltMode_Handle(PDACK,Enter_Mode);//ack
              
                          UCCMSG.pDataOrder = szCCData_REQDpStatusUpdate;
                          Mod_CC1Msg_Send();  
                          UCCMSG.ucLastMsgType = Mod_CC1MsgType_Calc(Vdm_Msg,Enter_Mode,StrVdm);
                      
                          break;
                      case Exit_Mode           :      
                          UCCStatus.ucVDM_Step &= 0xC7;//BIT3,BIT4,BIT5 should be cleared
                          UCCMSG.ucLastMsgType = Mod_CC1MsgType_Calc(Vdm_Msg,Exit_Mode,StrVdm);
