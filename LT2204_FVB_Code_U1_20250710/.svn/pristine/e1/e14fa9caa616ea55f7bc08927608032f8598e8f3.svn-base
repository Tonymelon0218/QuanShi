                          {
                              UCCStatus.b2AttentionType = ATTENTION_HIGH;
                          }
                          else
                          {
                              UCCStatus.b2AttentionType = ATTENTION_LOW;
                          }
                          #if TYPEC_PRSWAP_EN == ENABLED
                          if((Drv_CC2On_Det(SINK)==TRUE)&&(!UCCStatus.b1PowerRole)) //DCC 已经在
                          {
                              if(UCCStatus.ucPRSended == 0)//pr swap flag = 0;
                              {
                                  UCCStatus.ucPRSended = 1;
