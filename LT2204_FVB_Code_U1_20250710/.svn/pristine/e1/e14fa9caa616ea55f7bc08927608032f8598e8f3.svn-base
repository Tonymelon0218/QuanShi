              void Mod_Cc1DrSwap_Set(void)
              {
                  if((UCCStatus.ucSwap_Sent & DR_Sent)== 0)
                  {
                      //TBDTBD
                      #if CHIP_SEL == LT6711GXE
                      if(UCCStatus.b1DataRole == FALSE)//
                      #else
                      if(UCCStatus.b1DataRole == TRUE)//
                      #endif
                      {
                          if((UCCStatus.ucVDM_Step & BIT3_1) == 0x00)
                          {
                              UCCStatus.ucDrSwap_En = 1;
                          }                                  
                      }
                  }
              }
              
