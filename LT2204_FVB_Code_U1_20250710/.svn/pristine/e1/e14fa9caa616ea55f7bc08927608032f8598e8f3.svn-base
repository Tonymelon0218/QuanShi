              void Mod_Cc1Dfp_VdmMsg(void)
              {
                  static u8 b1PinMode = 0;
                  static u8 b1HpdState = 0;
               
                  switch(UCCMSG.szRcvDate[0]&0x1F)  //Command
                  {
                      case Discover_Identity   : 
                          g_stDpTx.b1DpTxAppleFlag=0;  
                          if((UCCMSG.szRcvDate[4]==0xac)&&(UCCMSG.szRcvDate[5]==0x05))
                          {
                            g_stDpTx.b1DpTxAppleFlag=1;
                          }
                          UCCMSG.pDataOrder =  szCCData_REQDiscoverSvid;
                          Mod_CC1Msg_Send();
                          UCCStatus.ucVDM_Step |= BIT0_1;
                          UCCMSG.ucLastMsgType = Mod_CC1MsgType_Calc(Vdm_Msg,Discover_SVIDs,StrVdm);
              
                          break;
                      case Discover_SVIDs      :
                          UCCMSG.pDataOrder = szCCData_REQDiscoverModes;
                          UCCStatus.ucVDM_Step |= BIT1_1;
                          Mod_CC1Msg_Send();
                          UCCMSG.ucLastMsgType = Mod_CC1MsgType_Calc(Vdm_Msg,Discover_Modes,StrVdm);
                          break;
                      case Discover_Modes      : 
                          b1PinMode = 0;    
                          if((UCCMSG.szRcvDate[4]&0x03) == 0x02)//DP SOURCE
                          {
                              UCCMSG.ucLastMsgType = 0xff;
                          }
                          else
                          {
                              UCCStatus.ucVDM_Step |= BIT2_1;
                              if(((UCCMSG.szRcvDate[5]&0x0c)== 0x08)||((!UCCMSG.szRcvDate[5])&&(((UCCMSG.szRcvDate[6]&0x
             -0c)==0x08))))
                              {
                                  if(UCCStatus.uclaneCount == FOUR_LANE)
                                  {
                                      UCCStatus.uclaneCount = TWO_LANE;
                                  }
                              }
                              else if(((UCCMSG.szRcvDate[5]&0x0c)== 0x0c)||((!UCCMSG.szRcvDate[5])&&(((UCCMSG.szRcvDate[
             -6]&0x0c)==0x0c))))
                              {
                                  b1PinMode = 1;
                              } 
                              memcpy(UCCMSG.szCC_ModeMsg_Buffer,szCCData_REQEnterMode,6);    
                              if(UCCStatus.ucVDM_Step &BIT1_1)
                              {                                                            
                                  ;    //ACK
                              }
