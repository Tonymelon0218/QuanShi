              u8 Mod_CC1PDO_Compare(u8 IN *pucData)
              {
                  return ((pucData[1]&0x70)>>4);
              }
              
              //================================
              //
              //the function is used to compare the current between request and adapter
              //the request current can not bigger than adapter can provide
              //
              //================================
              u8 Mod_CC1RequestCur_Compare(u8 IN *pucData,u8 IN ucObject)
              {
                  static u16 Request_Cur;
                      // solve PPS request obnormal issue
                  static u16 Request_Cur_Ori;
                  if((ucObject==DCCMSG.szPPS_Object[0])||(ucObject==DCCMSG.szPPS_Object[1])||(ucObject==DCCMSG.szPPS_Obj
             -ect[2]))
                      {
                              Request_Cur = UCCMSG.szRcvDate[(ucObject*4)-2]&0x7f;//Request from UCC with operation current
                              Request_Cur_Ori = pucData[(ucObject*4)-2]&0x7f;
                      }
                      else
                      {
                              Request_Cur = ((u16)(UCCMSG.szRcvDate[2]&0x0f)<<6) + ((UCCMSG.szRcvDate[1]&0xfc)>>2) ;//Request from UCC
             - with operation current
                              Request_Cur_Ori = ((u16)(pucData[(ucObject*4)-1]&0x03)<<8) + pucData[(ucObject*4)-2];
                      }
                      if(Request_Cur>Request_Cur_Ori)
                      {
                              return 0;
                      }
                      return 1;
              }
              
