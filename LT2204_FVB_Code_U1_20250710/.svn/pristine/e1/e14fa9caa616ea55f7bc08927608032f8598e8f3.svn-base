              void Mod_CC1VdmMsg_Analysis(u8 ucMsg_Type)
              {
                  if(ucMsg_Type == Vendor_Defined)
                  {
                      switch  (UCCMSG.szRcvDate[0]&0xC0)//ACK NACK INIT BUSY
                      {
                          case Init: //Command
                              //DFP 模式下，才接收Attention
                              #if CHIP_SEL == LT6711GXE
                              if(UCCStatus.b1CcDataRoleSet == DFP)
                              {
                                  switch  (UCCMSG.szRcvDate[0]&0x1F)
                                  {
                                      case Attention    :                        
                                          if((UCCStatus.ucVDM_Step & BIT5_1) == BIT5_1)
                                          {
                                              if(UCCMSG.szRcvDate[4]&BIT7_1)//
                                              {
                                                  if(UCCMSG.szRcvDate[5]&BIT0_1)
                                                  {
                                                      UCCStatus.b2AttentionType = ATTENTION_IRQ;
                                                  }
                                                  else
                                                  {
                                                      UCCStatus.b2AttentionType = ATTENTION_HIGH;
                                                  }
                                              }
                                              else
                                              {
                                                  UCCStatus.b2AttentionType = ATTENTION_LOW;
                                              }
                                          }
                                          break;
                                      default                 :
                                          break;
                                  }
                              }
                              else//UFP 模式下，才接收Attention
                              #else
                              {
C51 COMPILER V9.53.0.0   MODCC1BASICTYPEC                                                  02/13/2025 10:13:58 PAGE 22  

                                  Mod_Cc1Ufp_VdmMsg();
                              }
                              #endif
                              break;
                          case ACK:
                              //DFP模式下才接受ACK
                              #if CHIP_SEL == LT6711GXE
                              if(UCCStatus.b1CcDataRoleSet == DFP)
                              {
                                  Mod_Cc1Dfp_VdmMsg();
                              }     
                              #endif
                              break;
                          case NACK: //Command
                              //DFP模式下处理NACK
                              if(UCCStatus.b1CcDataRoleSet == DFP)
                              {
                                  ;
                              }
                              break;
                          case BUSY: //Command
                              //DFP模式下处理BUSY
                              if(UCCStatus.b1CcDataRoleSet == DFP)
                              {
                                  switch(UCCMSG.szRcvDate[0]&0x1F)  //Command
                                  {
                                      case Discover_Identity   :   
                                      case Discover_SVIDs      :
                                      case Discover_Modes      : 
                                      case Enter_Mode          :
                                          UCCStatus.b2VdmBusy = AMS_READY;
                                          UCCMSG.pLast_DataOrder = UCCMSG.pBuffer_Order;                            
                                          break;
                                      case Exit_Mode           :      
                                          UCCStatus.b2Hardreset_Hdl = HardRst_Initate;
                                          break;
                                      case Attention           :
                                      case DP_Status_Update    :                                                
                                      case DP_Config           :
                                      default                  :
                                          break;
                                  }
                              }
                              break;
                          default:
                              break;
                      }
                  }
              }
              //================================
              //
              //the function is handle UCC message
              //ucMsg_Type:message type;control,data,chunked
              //ucLength:Control or data message
              //ucExt:extended and not extended message
