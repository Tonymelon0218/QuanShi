                          UCCMSG.ucLastMsgType = Mod_CC1MsgType_Calc(Vdm_Msg,DP_Config,StrVdm);
                                  
                          break;
                      case DP_Config             :
                          UCCStatus.ucVDM_Step |= BIT5_1;
                          UCCMSG.ucLastMsgType = 0xff;
