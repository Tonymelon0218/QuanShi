              //================================
              //
              //the function is used to receive the ucc's request message and recalculate the request message to DCC
              //
              //
              //================================
              
              u8 Mod_CC1RequestMsg_Calc(void)    //FOR REQUEST ADAPTER
              {
                  u8 ucPPS_Request = 0;
                      static u8 ucPPSPosition;
                  static u16 usRequest_Cur = 0x00;
C51 COMPILER V9.53.0.0   MODCC1BASICTYPEC                                                  02/13/2025 10:13:58 PAGE 10  

                  #if NINTENDO_SWITCH_FORALL == ENABLED
                      if(((CC1NINTENDOState.b1IsSwitch == TRUE)||(CC1NINTENDOState.b1Switch_Online == TRUE))&&(CC1NINTENDOState
             -.b2Switch_Ada_Online == SWITCH_ADAPTER_ALL))
                  {
                      ucPPSPosition = 0x01;
                  }
                      else
                  #endif
                  {
                      ucPPSPosition = (UCCMSG.szRcvDate[3]&0x70)>>4;//get Object position
                  }
                  #if PD_PPS_EN == ENABLED
                      if((ucPPSPosition==DCCMSG.szPPS_Object[0])||(ucPPSPosition==DCCMSG.szPPS_Object[1])||(ucPPSPosition==DCCM
             -SG.szPPS_Object[2]))
                  {
                      ucPPS_Request = 1;
                      UCCMSG.szRequestTmp[0] = UCCMSG.szHeader[0];
                      UCCMSG.szRequestTmp[1] = UCCMSG.szHeader[1];
                      UCCMSG.szRequestTmp[2] = UCCMSG.szRcvDate[0];
                      UCCMSG.szRequestTmp[3] = UCCMSG.szRcvDate[1];
                      UCCMSG.szRequestTmp[4] = UCCMSG.szRcvDate[2];
                      UCCMSG.szRequestTmp[5] = UCCMSG.szRcvDate[3];
                  }
                      else
                  #endif
                  {
                      #if PD_PPS_EN == ENABLED
                      ucPPS_Request = 0;
                      #endif 
                      memcpy(&UCCMSG.szRequestTmp[2],&DCCMSG.szAdapterCap_Ori[(ucPPSPosition*4)- 2],4);
                      usRequest_Cur = ((u16)(UCCMSG.szRequestTmp[3]&0x03)<<8)+ UCCMSG.szRequestTmp[2];
                      UCCMSG.szRequestTmp[0] = 0x42;
                      UCCMSG.szRequestTmp[1] = 0x12;
                      
                      #if NINTENDO_SWITCH_FORALL == ENABLED
                      if(((CC1NINTENDOState.b1IsSwitch == TRUE)||(CC1NINTENDOState.b1Switch_Online == TRUE))&&(CC1NINTENDOS
             -tate.b2Switch_Ada_Online == SWITCH_ADAPTER_ALL))
                      {
                              UCCMSG.szRequestTmp[5] = 0x11;//needed
                      }
                      else
                      {
                              UCCMSG.szRequestTmp[5] = UCCMSG.szRcvDate[3];//needed
                      }
                      #else
                      UCCMSG.szRequestTmp[5] = UCCMSG.szRcvDate[3];//needed
                      #endif
                      UCCMSG.szRequestTmp[3] &= 0x03;
                      UCCMSG.szRequestTmp[3] |= (usRequest_Cur<<2);
                      usRequest_Cur >>= 6;
                      UCCMSG.szRequestTmp[4] = 0x00;//needed for Bit7(PD3.0)
                      UCCMSG.szRequestTmp[4] |= (usRequest_Cur & 0x0f);
                  }    
                  return ucPPS_Request;
              }
              
              #if PINE_SUPPORT == ENABLED
              void Mod_CC1PinType_Get(u8 IN *pucData)
              {
                  UCCStatus.ucPin_Assignment = PIN_C;
                  if(((pucData[5]&0x3F)==PIN_E)||((pucData[6]&0x1F)==PIN_E))
