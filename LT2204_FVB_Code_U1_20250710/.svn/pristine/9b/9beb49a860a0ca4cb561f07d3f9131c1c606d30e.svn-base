              void Drv_BB_FlashConfig(void)
              {
                  BKE0_EE_REG=0x01;//software is not affC5tive
                  BKE0_5E_REG=0xC1;//0XDF
                  BKE0_58_REG=0x00;
                  BKE0_59_REG=0x50;
                  BKE0_5A_REG=0x10;
                  BKE0_5A_REG=0x00;
                  BKE0_58_REG=0x21;
              }
              
              void Drv_BB_BlockEraseROrder(u32 ulAddr)
              {
                  BKE0_5A_REG=0x04;
                  BKE0_5A_REG=0x00;
                  BKE0_5B_REG=(ulAddr>>16);//High bit
                  BKE0_5C_REG=(ulAddr>>8);
                  BKE0_5D_REG= ulAddr;//Low bit
                  BKE0_5A_REG=0x01;
                  BKE0_5A_REG=0x00; 
                  Ocm_Delay1ms(500); 
                      if((ulAddr == 0x000000)||(ulAddr == 0x040000))//main FW and second FW
                  {
                      BKE0_5A_REG=0x04;
                      BKE0_5A_REG=0x00;
                      BKE0_5B_REG=(ulAddr>>16);//
                      BKE0_5C_REG=0x80;// 0x80 second block
                      BKE0_5D_REG=0x00;//
                      BKE0_5A_REG=0x01;
                      BKE0_5A_REG=0x00; 
                      Ocm_Delay1ms(500);  
                  }      
              }
              
              void Drv_BB_FlashWROrder(void)
              {
                  BKE1_03_REG=0x3F;
                  BKE1_03_REG=0xFF;
                  BKE0_5A_REG=0x04;
                  BKE0_5A_REG=0x00;
              }
              
              void Drv_BB_DataToFifoWOrder(u8 uclenth)
              {
                  IDATA u8 ucLoop_BB;
              
                  BKE0_5E_REG=0xc0|(uclenth-1);
                  BKE0_5A_REG=0x20;
                  BKE0_5A_REG=0x00;    
                  BKE0_58_REG=0x21;    
                  for(ucLoop_BB= 0;ucLoop_BB< uclenth;ucLoop_BB++)
                  {
                      BKE0_59_REG = g_stBB.szRevUpdateData[ucLoop_BB];
                  } 
              }
              
              void Drv_BB_FifoToFlashWOrder(u32 ulAddr)
              {
                  BKE0_5B_REG=(ulAddr>>16); //High bit
                  BKE0_5C_REG=(ulAddr>>8);
                  BKE0_5D_REG= ulAddr; //Low bit
                  BKE0_5A_REG=0x10;
C51 COMPILER V9.53.0.0   DRVBILLBOARD                                                      02/13/2025 10:14:12 PAGE 6   

                  BKE0_5A_REG=0x00;
              }
              
              void Drv_BB_WriteFlashProcess(void)
              {
                  u32 ulFlashAddr;
                  static u16 usAddrCnt = 0;
              
                  if(g_stBB.ucEraseIniCnt == 3)
                  {
                      g_stBB.ucEraseIniCnt = 0;
                      g_stBB.ucCrcIniCnt = 0;
                      usAddrCnt = 0;
                      Drv_BB_FlashConfig();
                      if(((g_stBB.ulAddrInit&0xffff)== 0x0000)/*||((g_stBB.ulAddrInit&0xffff)== 0x8000)*/)//address just
             - be sent once
                      {
                          Drv_BB_BlockEraseROrder(g_stBB.ulAddrInit);//
                      }
                  }
                  ulFlashAddr = (usAddrCnt*WRITE_FLASH_LEN) + g_stBB.ulAddrInit;
                  Drv_BB_FlashWROrder();
                  Drv_BB_DataToFifoWOrder(WRITE_FLASH_LEN);
                  Drv_BB_FifoToFlashWOrder(ulFlashAddr);
                  usAddrCnt++;
              }
              
