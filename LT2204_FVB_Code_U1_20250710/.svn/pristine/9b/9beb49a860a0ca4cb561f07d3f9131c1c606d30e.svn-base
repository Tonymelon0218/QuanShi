                              ucszSend_Data_lenth = 32;
                          }
                          else
                          {
                              ucszSend_Data_lenth = g_stBB.ucPkt_Lenth;
                          }
                          BKC5_02_REG &= BIT7_1;//send pkt lenth
                          BKC5_02_REG |= ucszSend_Data_lenth;//send pkt lenth
                          if(b1Pid_Chg == TRUE)
                          {
                              BKC5_03_REG = 0x4b;//data0
                              b1Pid_Chg = FALSE;
                          }
                          else
                          {
                              BKC5_03_REG = 0xc3;//data1
                              b1Pid_Chg = TRUE;
                          }
                          
                          for(ucLoop_BB = 0;ucLoop_BB < ucszSend_Data_lenth ;ucLoop_BB++)
                          {
                              BKC5_11_REG = *(g_stBB.pDataId + ucszSend_Data_header);
                              ucszSend_Data_header++;
                              Ocm_Delay1us(1);
                          }
                          if(g_stBB.ucPkt_Lenth > 32)
                          {
                              g_stBB.ucPkt_Lenth -= 32;
                              Ocm_Delay1us(800);
                          }
                          else
                          {
                              g_stBB.ucPkt_Lenth = 0xFF;//
                          } 
                      }
                  }
                  else
                  {
                              BKC5_02_REG &= BIT7_1;//send pkt lenth
                      BKC5_03_REG = 0x4b;
                      BKC5_01_REG = 0x00;
                  }
              }
              
              void Drv_BB_Interrupt(void)
              {
                  BKC5_01_REG = 0x00;
              
                  if(BKC5_22_REG & BIT4_1)//data0 intr     
                  {
                      BKC5_0C_REG |= BIT4_1;
                      BKC5_0C_REG &= BIT4_0;//clear interrupt
                      Drv_BB_DataCal();
                  }
                  if(BKC5_22_REG & BIT1_1)//IN intr    
                  {  
C51 COMPILER V9.53.0.0   DRVBILLBOARD                                                      02/13/2025 10:14:12 PAGE 10  

                      BKC5_0C_REG |= BIT1_1;
                      BKC5_0C_REG &= BIT1_0;//clear interrupt
                      Drv_BB_DataReply();
                  }
                  if(BKC5_22_REG & BIT3_1)//ack intr
                  {
                      BKC5_0C_REG |= BIT3_1;
                      BKC5_0C_REG &= BIT3_0;//clear interrupt
                      BKC5_02_REG &= BIT7_0;
                  }   
                  if (BKC5_21_REG & BIT1_1)//USB reset intr
                  {
                      BKC5_05_REG |= BIT4_1;
                      BKC5_05_REG &= BIT4_0;
                      BKC5_00_REG  = 0x00;
                      BKC5_02_REG &= BIT7_0;
                      BKE1_05_REG &= BIT3_0;//bb reset;
                      BKE1_05_REG |= BIT3_1;
                  }
              }
              #endif


