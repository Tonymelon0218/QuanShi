                      else if ((g_stAuxStatus.szRxAddress[0] == 0x00) && (g_stAuxStatus.szRxAddress[1] == 0x20))//dpcd2003
                  {
                      ucIncrease = 0;
                      switch (g_stAuxStatus.szRxAddress[2])
                      {
                          #if DPRX_MST_MODE_EN == ENABLED
                                      case 0x00:
                              ucIncrease++;
                                      case 0x01:
                              ucIncrease++; 
                          case 0x02:
                              ucIncrease++; 
                          case 0x03:
                                              if(ucIncrease > ucLenth)
