                              break;
                          #endif
                          #if ((DPRX_FEC_SUPPORT == ENABLED)||(DPRX_DSC_DEC_SUPPORT == ENABLED)||(DPRX_DSC_BYPASS_SUPPOR
             -T == ENABLED)) 
                          case 0x80:
                              if(g_stAuxStatus.szRxData[ucIncrease] & BIT1_1)
                              {
                                  Drv_DpRx_FecDisclr();
