              //Info  :solution for DPRX link cts 5.2.2.3-sink status
              //===========================================
              void Mod_Read_Dpcd205(IN u8 ucI)
              {
                  if(FALSE == Mod_DpRx_UpStreamVidReadyGet())
                  {
                      g_stAuxStatus.szRxSendData[ucI] &= BIT0_0;
                  }
              }
              
              //===========================================
              //func  :read dpcd 0020f
              //input :aux read order
              //output:N/A
              //return:void
              //Info  :solution for DPRX link CTS_5.6.2.12-5.6.2.14
              //DSC interrupt test for Chunk Length error/RC buffer under-run error/RC buffer overflow error
              //===========================================
              void Mod_Read_Dpcd20F(IN u8 ucI)
              {
                  g_stAuxStatus.szRxSendData[ucI] &= 0xf8;
                  
                  if(g_stDpRx.ucDscChunkSizeErr == DSC_CHUNKSIZE_ERR)
                      g_stAuxStatus.szRxSendData[ucI] |= BIT2_1;
                      
                  if(g_stDpRx.ucDscRcBufUnderRun == DSC_RCBUF_UNDERRUN)
                      g_stAuxStatus.szRxSendData[ucI] |= BIT0_1;
