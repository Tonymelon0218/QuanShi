              void Mod_Aux_RequestCalLane01(IN u8 ucI)
              {
                  if (g_stAuxStatus.ucTps_Pattern == TPS1) //cr lock stage.
                  {
                              #if DEBUG_FORCE_TRAINDONE == 1
                              g_stAuxStatus.ucDpcd202 = g_stAuxStatus.szRxSendData[ucI]; //record value from dpcd.
                              g_stAuxStatus.ucDpcd202 |= 0x11;
                              g_stAuxStatus.szRxSendData[ucI] = g_stAuxStatus.ucDpcd202;
                              #else
                      g_stAuxStatus.ucDpcd202 = g_stAuxStatus.szRxSendData[ucI]; //record value from dpcd.
                              #endif
                  }
                  else if ((g_stAuxStatus.ucTps_Pattern >= TPS2)) //eq done and symbol lock stage.
                  {
                      #if DEBUG_FORCE_TRAINDONE == 1
                      g_stAuxStatus.ucDpcd202  |= 0x07;
                      #else
                      g_stAuxStatus.ucDpcd202 = 0x01;
                      if (/*((BKF1_F1_REG&BIT0_1) == 0x00) && */((REG_LANE0_EQVALID_H8 != 0x00) || (REG_LANE0_EQVALID_L8
             - != 0x00))) //lane0 eq valid flag is not 0, then EQ_DONE and SYMBOL_LOCK = 1;
                      {
                          g_stAuxStatus.ucDpcd202  |= 0x07;
                          #if DPRX_CDR_MODE == ANACDR
                          Drv_DpRx_AnaCdrRst(g_stAuxStatus.ucLink_Rate);
                          #endif
                          
                          if((BKF1_F1_REG&BIT0_1) == 0x00)
                          {
                              if((ucAuxDeferCnt == 0)&&(g_stAuxStatus.b1IsSwingLvl == FALSE))
                              {
                                  Drv_DpRx_Dpcd_HighAddrWrite(0x01);
                                  Drv_DpRx_Dpcd_ValueWrite(0x03,DPRX_SWING_MIN_LEVEL);
                              }
                              if(ucAuxDeferCnt < 6)
                              {
                                  ucAuxDeferCnt++;
                                  ucAuxDeferEn = 1; 
                              }                
                          }
                          else
                          {
                              ucAuxDeferCnt = 0;
                          }
                      }
                      else
                      {
                          ucAuxDeferCnt = 0;
                          g_stAuxStatus.ucDpcd202 = g_stAuxStatus.szRxSendData[ucI];
                      }
                      #endif
              
                      if (g_stAuxStatus.ucLink_Count >= TWO_LANE) //lane1
                      {
                                      #if DEBUG_FORCE_TRAINDONE == 1
                                      g_stAuxStatus.ucDpcd202 |= 0x70;
                                      #else
                          g_stAuxStatus.ucDpcd202 |= 0x10;
                                      if (/*((BKF1_F1_REG&BIT1_1) == 0x00) && */((REG_LANE1_EQVALID_H8 != 0x00) || (REG_LANE1_EQVALID_L8 != 0
             -x00))) //eq valid flag is not 0, then.
                          {
                              g_stAuxStatus.ucDpcd202 |= 0x70;
                              #if DPRX_CDR_MODE == ANACDR
C51 COMPILER V9.53.0.0   MODAUXMSG                                                         02/13/2025 10:13:57 PAGE 6   

                              Drv_DpRx_AnaCdrRst(g_stAuxStatus.ucLink_Rate);
                              #endif
                          }
                          else
                          {
                              g_stAuxStatus.ucDpcd202 = g_stAuxStatus.szRxSendData[ucI];
                          }
                                      #endif
                      }
                      g_stAuxStatus.szRxSendData[ucI] = g_stAuxStatus.ucDpcd202; //the value is calculated by software.
                  }
                  else//video ptn
                  {
                      g_stAuxStatus.szRxSendData[ucI] = g_stAuxStatus.ucDpcd202;
                      //solution for DPRX link CTS-5.4.1.1
                      #if DPRX_LINK_CTS == ENABLED
                      if((g_stAuxStatus.b1AuxDone == FALSE) && (g_stAuxStatus.b1Train_Done == FALSE))
                      {
                          g_stAuxStatus.szRxSendData[ucI] = 0x00;
                      }
                      #endif
                  }
              }
              
