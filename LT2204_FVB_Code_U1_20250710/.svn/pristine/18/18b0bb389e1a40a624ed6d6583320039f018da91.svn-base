                      g_stAuxStatus.ucTps_Save_Pattern =  g_stAuxStatus.ucTps_Pattern;
                      
                  }
              }
              //===========================================
              //func  :write dpcd 00103
              //input :aux write order
              //output:N/A
              //return:void
              //Info  :N/A
              //===========================================
              void Mod_Write_Dpcd103(IN u8 ucI)
              {
                      if(g_stAuxStatus.szRxData[ucI] >= DPRX_SWING_MIN_LEVEL)
                      {
                              Drv_DpRx_CrLockThresholdSet(FALSE);
                              g_stAuxStatus.b1IsSwingLvl = FALSE;             
                      }
                  if(g_stAuxStatus.szRxData[ucI] > DPRX_SWING_MIN_LEVEL)
                  {
                      #if DPRX_CDR_MODE == ANACDR
                      Drv_DpRx_AnaCdrRst(g_stAuxStatus.ucLink_Rate);
                      #endif
                  }
              }
              
