                  Mod_Aux_TrainingDone();
              }
              
              //===========================================
              //func  :read dpcd 00204
              //input :aux read order
              //output:N/A
              //return:void
              //Info  :N/A
              //===========================================
              void Mod_Read_Dpcd204(IN u8 ucI)//TBD TBD
              {
                  static u8 ucRead204_Cnt = 0;
                  if(g_stAuxStatus.ucTps_Pattern == TPS1)
                  {
                       ucRead204_Cnt = 0;
                  }
                  else if(g_stAuxStatus.ucTps_Pattern >= TPS2)
                  {
                      if((g_stAuxStatus.b1Train_Done == TRUE)||(Mod_Aux_DoneGet()== TRUE))
                      {
                          ucRead204_Cnt++;
                          g_stAuxStatus.b1Train_Done = TRUE; 
                          if(ucRead204_Cnt == 1)
                          {
C51 COMPILER V9.53.0.0   MODAUXMSG                                                         02/13/2025 10:13:57 PAGE 10  

                              g_stAuxStatus.szRxSendData[ucI] |= BIT0_1; //bit0 set 1 ,bit7 not care
                          }
                          else
                          {
                               g_stAuxStatus.szRxSendData[ucI] = 0x01; //bit 0 set 1, bit8 set 0
                          }
              
                      }
                      else
                      {
                          g_stAuxStatus.szRxSendData[ucI] &= BIT0_0;
                      }
                  }
                  else if(g_stAuxStatus.ucTps_Pattern == VID_PTN)
                  {
                      if(g_stAuxStatus.ucTps_Save_Pattern >= TPS2)
                      {
                          g_stAuxStatus.szRxSendData[ucI] = (g_stAuxStatus.b1Train_Done == TRUE)?(0x01):(0x80);
                      }
                      //solution for DPRX link CTS-5.4.1.1
                      #if DPRX_LINK_CTS == ENABLED
                      if((g_stAuxStatus.b1AuxDone == FALSE) && (g_stAuxStatus.b1Train_Done == FALSE))
