              void Mod_Write_Dpcd100(IN u8 ucI)
              {
                  g_stAuxStatus.ucLink_Rate = g_stAuxStatus.szRxData[ucI];
                  Drv_DpRx_PiSet(g_stAuxStatus.ucLink_Rate);
                  Drv_DpRx_RxPllBand(g_stAuxStatus.ucLink_Rate);
                  Drv_DpRx_CdrLoopDivSet(g_stAuxStatus.ucLink_Rate);
                  Drv_DpRx_CtleSet(g_stAuxStatus.ucLink_Rate);
                  #if DPRX_CDR_MODE == ANACDR
                  Drv_DpRx_CdrSet(g_stAuxStatus.ucLink_Rate);
                  #else
                  Drv_DpRx_CdrSet(g_stAuxStatus.b1Ssc_Dpcd107, g_stAuxStatus.ucLink_Rate);
                  #endif
                  g_stAuxStatus.ucTps_Save_Pattern = 0;
              }
