              //===========================================
              void Mod_Read_Dpcd206(void)
              {
                  if(g_stAuxStatus.ucTps_Pattern == TPS1)
                  {
                      if ((g_stAuxStatus.b1IsSwingLvl == FALSE) && (g_stAuxStatus.b1Cr_Lock == FALSE))
                      {
