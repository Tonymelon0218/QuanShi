              //===========================================
              void Mod_AuxReply_En(void)
              {
                      Drv_DpRx_AcAuxTermCtrl(ENABLED);
                      REG_AUX_REPLY_ENABLE = 0x00;
              }
              void Mod_AuxMsg_Reply(u8 ucReplyType)
              {
                  REG_AUX_REPLY_DATA = ucReplyType;
              }
              
              
              //===========================================
              //func  :aux send reply data for dpcd read
              //input :AUX data length
              //output:N/A
              //return:void
              //Info  :N/A
              //===========================================
              void Mod_Aux_SendData(u8 ucLenth)
              {
                  IDATA u8 ucLoopAux;
                  if(ucAuxDeferEn)
                  {
                      ucAuxDeferEn = 0;
                      Mod_AuxMsg_Reply(AUXDEFER);
                  }
                  else
                  {
                      Mod_AuxMsg_Reply(AUXACK);
                      for (ucLoopAux = 0; ucLoopAux < ucLenth; ucLoopAux++)
                      {
                          REG_AUX_REPLY_DATA = g_stAuxStatus.szRxSendData[ucLoopAux];
                      }
                  }
              }
              
              //============================================
              //func  :aux send data for edid read  one block from 1-7 16bytes
              //input :AUX data length
              //output:N/A
              //return:void
              //Info  :N/A
              //============================================
              void Mod_Aux_EdidRead(u8 ucLenth)
              { 
                  IDATA u8 ucLoopAux;
              
                  Mod_AuxMsg_Reply(AUXACK);
                  for (ucLoopAux = 0; ucLoopAux < ucLenth; ucLoopAux++)
                  {
                      REG_AUX_REPLY_DATA = szEdidData[ucLoopAux + g_stAuxStatus.usEdid_Offset];
                  }
                  g_stAuxStatus.usEdid_Offset = g_stAuxStatus.usEdid_Offset + ucLenth;
              }
              
              //===========================================
              //func  :IIC Over Aux reply
              //input :AUX data ucLength
              //output:N/A
              //return:void
              //Info  :N/A
C51 COMPILER V9.53.0.0   MODAUXMSG                                                         02/13/2025 10:13:57 PAGE 3   

              //===========================================
              void Mod_Aux_SendZeroData(u8 ucLenth)
              {
                  IDATA u8 ucLoopAux;
              
                  Mod_AuxMsg_Reply(AUXACK);
                  for (ucLoopAux = 0; ucLoopAux < ucLenth; ucLoopAux++) //i2c last read
                  {
                      REG_AUX_REPLY_DATA = 0x00;
                  }
              }
              //HDMI MODE时，如果没有传送Branch IEEE，NO HDR
              #if (DPRX_DFP_TYPE == BRANCH_HDMI)
              void Mod_Read_DealDpcd30X(u8 ucLenth, u8 ucLowAddr)
              {
                  memcpy(&(g_stAuxStatus.szDpcd30XH[DPCD300_IEEE_OUI_LEN]), g_szpHDMIg, DPCD300_DEV_ID_LEN);
                  if ((ucLowAddr + ucLenth) <= DPCD300_ALL_LEN)
                  {
                      memcpy(g_stAuxStatus.szRxSendData, &g_stAuxStatus.szDpcd30XH[ucLowAddr], ucLenth);
                  }
                  else
                  {
                      memcpy(g_stAuxStatus.szRxSendData, &g_stAuxStatus.szDpcd30XH[ucLowAddr], DPCD300_ALL_LEN-ucLowAddr
             -);
                  } 
              }
              void Mod_Write_DealDpcd30X(u8 ucLenth, u8 ucLowAddr)
              {
                  if ((ucLowAddr + ucLenth) <= DPCD300_ALL_LEN)
                  {
                      memcpy(&g_stAuxStatus.szDpcd30XH[ucLowAddr], g_stAuxStatus.szRxData, ucLenth);
                  }
                  else
                  {
                      memcpy(&g_stAuxStatus.szDpcd30XH[ucLowAddr], g_stAuxStatus.szRxData, DPCD300_ALL_LEN-ucLowAddr);
                  }
                  //memcpy(&(g_stAuxStatus.szDpcd30XH[DPCD300_IEEE_OUI_LEN]), g_szpHDMIg, DPCD300_DEV_ID_LEN);
              }
              
              //for hdr, apple and nvidia
              void Mod_Read_Dpcd510(u8 ucLenth)
              {
                  IDATA u8 ucIncrease;
                  ucIncrease = 0;
                  switch (g_stAuxStatus.szRxAddress[2])
                  {
                      case 0x10  ://dpcd00510
                          g_stAuxStatus.szRxSendData[ucIncrease] = 0xbe;//28 OK
                          if (++ucIncrease == ucLenth)
                          {
                              break;
                          }
                      case 0x11 ://dpcd00511
                          g_stAuxStatus.szRxSendData[ucIncrease] = 0x05;
                          if (++ucIncrease == ucLenth)
                          {
                              break;
                          }
                      default:
                          break;
                  }
              }
