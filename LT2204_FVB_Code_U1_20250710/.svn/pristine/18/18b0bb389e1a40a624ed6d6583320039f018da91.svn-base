             -tAuxStatus.usEdid_Offset;
                                      g_stAuxStatus.ucEdid_Block_Offset = 0x00;
                                  }
                              }
                          }           
                          Mod_AuxMsg_Reply(AUXACK);
                          break;
                      case CMD_I2CLD://0x20;MOT=0,Write-status-update
                      default:
                          Mod_AuxMsg_Reply(AUXACK);
                          break;
                  }
                  Mod_AuxReply_En();
                      //如果AUX TERM关掉，软件模式会产生一个STOP中断，需要清掉
                  #if DPRX_AUX_MODE == SOFTMODE
                  Drv_System_IntClr(IRQ_DPRX_AUX_INT);
                  #endif
              }
              
              //========================================================================
              // Func Name   : Mod_Aux_GetTrainDoneStatus
              // Description : get link training status.
              // Input       : void  
              // Output      : None
              // Return      : TRUE-> training success.
              //             : FALSE->training is on going or fail.
              //========================================================================
              u8 Mod_Aux_GetTrainDoneStatus(void)
              {
                  if (g_stAuxStatus.b1Train_Done == TRUE) 
                  {
                      g_stAuxStatus.b1AuxDone = TRUE;
                      return TRUE;
                  }
                  return FALSE;
              }
C51 COMPILER V9.53.0.0   MODAUXMSG                                                         02/13/2025 10:13:57 PAGE 28  

              
              //========================================================================
              // Func Name   : Mod_Aux_GetRetrainStatus
              // Description : Get link training stauts
              // Input       : void  
              // Output      : None
              // Return      : TRUE-> Source re-link training.
              //             : FALSE-> No re-link training.
              //========================================================================
              u8 Mod_Aux_GetRetrainStatus(void)
              {
                  if(g_stAuxStatus.b1AuxDone == TRUE)
                  {
                      return FALSE;
                  }
                  return TRUE ;
              }
              
              u8 Mod_Aux_LinkCntGet(void)
              {
                  return g_stAuxStatus.ucLink_Count;
              }
