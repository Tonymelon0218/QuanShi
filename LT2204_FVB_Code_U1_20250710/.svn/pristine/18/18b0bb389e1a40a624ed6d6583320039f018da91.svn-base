              void Mod_Link_QualPatternSet(IN u8 ucI)
              {
                  if (g_stAuxStatus.szRxData[ucI] != 0x00)
                  {
                      BKF1_B9_REG = 0x00;//hardware mode
                  }
                  Drv_DpRx_Cp2520KeyCodeSet(g_stAuxStatus.szRxData[ucI]);
              }
              
              void Mod_Aux_DealLossLock(void)
              {
                  g_stAuxStatus.b1Train_Done = FALSE;
                  g_stAuxStatus.ucTps_Pattern = 0x00;
                  g_stAuxStatus.ucDpcd202 = 0x00;
                  g_stAuxStatus.ucDpcd203 = 0x00;
                  g_stAuxStatus.b1IsLossSymbol = TRUE; //DPRX CTS 5.3.2.1
              }
              
              #endif
              
              
              u8 Mod_Aux_DoneGet(void)
              {
                  u8 b1Status = FALSE; 
                  switch(g_stAuxStatus.ucLink_Count)
                  {
                      case ONE_LANE:
                          if((REG_CR_EQ_STATUS&0x11)== 0x11)
                          {
                              b1Status = TRUE;
                          }
                          break;
                      case TWO_LANE:
                          if((REG_CR_EQ_STATUS&0x33)== 0x33)
                          {
                              b1Status = TRUE;
                          }
                          break;
                      case FOUR_LANE:
                          if((REG_CR_EQ_STATUS&0xff)== 0xff)
                          {
                              b1Status = TRUE;
                          }
                          break;
                      default:
                          break; 
                  }
                  return b1Status;
              }
              
              
