              //===========================================
              #if DPRX_MST_MODE_EN == ENABLED
              void Mod_Read_Dpcd201(IN u8 ucI)
              {
                  g_stMstRxStatus.block_reply_done  = 0;
                  g_stMstRxStatus.reply_block_lenth = 0;
                  if(g_stMstRxStatus.reply_rdy == 1)
                  {
                      g_stAuxStatus.szRxSendData[ucI] |= 0x10;
                  }
                  ucI = 0;
                  //need add the hdcp irq case
