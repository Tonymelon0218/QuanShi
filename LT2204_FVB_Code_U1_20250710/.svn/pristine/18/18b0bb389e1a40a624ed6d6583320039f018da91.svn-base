                  else if ((g_stAuxStatus.szRxAddress[0] == 0x00) && (g_stAuxStatus.szRxAddress[1] == 0x03)) //dpcd300
                  {
                      if (g_stAuxStatus.szRxAddress[2] <= 0x0f)
