                              #if ((DPRX_FEC_SUPPORT == ENABLED)||(DPRX_DSC_DEC_SUPPORT == ENABLED)||(DPRX_DSC_BYPASS_SUPPORT == ENABL
             -ED))
                              Drv_DpRx_FecSoftModeSet(FALSE);//hardmode
                              #endif
                      Drv_DpRx_SkewLock(FALSE);
                      #if ((DPRX_FEC_SUPPORT == ENABLED)||(DPRX_DSC_DEC_SUPPORT == ENABLED)||(DPRX_DSC_BYPASS_SUPPORT ==
             - ENABLED))
                      Drv_DpRx_FecDataPathSet(DISABLED);
                      #endif
                                      
                      #if ((DPRX_CDR_MODE == FULL_SPEED_DIGCDR)||(DPRX_CDR_MODE == HALF_SPEED_DIGCDR))
                      Drv_DpRx_DigCdrRst(g_stAuxStatus.b1Ssc_Dpcd107);
                              //use hardware reset ,no need to monitor CDR
              //              g_stAuxStatus.usDelayCnt     = 0x00;
              //        DRV_Timer2Cnt_Start();
                      #endif
                              g_stAuxStatus.ucTps_Save_Pattern =  g_stAuxStatus.ucTps_Pattern;
                              
                  }
                  else if(g_stAuxStatus.ucTps_Pattern >= TPS2)//TPS2 TPS3 TPS4
                  {
