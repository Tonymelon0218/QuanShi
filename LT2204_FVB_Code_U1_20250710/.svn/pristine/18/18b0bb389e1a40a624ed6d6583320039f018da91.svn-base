                              {
                                  g_stMstRxStatus.count2c0 = 0x00;
                                  g_stMstRxStatus.payload_table[0] = 0x00; //clear flag
                                  g_stMstRxStatus.payload_table[1] = 0x00; //clear flag
                                  g_stMstRxStatus.payload_table[2] = 0x00; //clear flag
