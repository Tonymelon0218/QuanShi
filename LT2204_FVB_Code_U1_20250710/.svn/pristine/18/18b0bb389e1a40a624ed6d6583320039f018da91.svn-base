             -tus.szRxAddress[2]-0x0b)<<4)))
                              {
                                  Mod_Link_QualPatternSet(0);
                              }
                              break;
                          #endif
              //                              #if CHIP_VERSION_SEL == ECO_NONE
                          #if ((DPRX_FEC_SUPPORT == ENABLED)||(DPRX_DSC_DEC_SUPPORT == ENABLED)||(DPRX_DSC_BYPASS_SUPPOR
             -T == ENABLED)) 
                           case 0x20 : //dpcd00120
                              g_stAuxStatus.FecFlag = (g_stAuxStatus.szRxData[0]&0x01)?(1):(0);
                              #if DPRX_LINK_CTS == ENABLED
C51 COMPILER V9.53.0.0   MODAUXMSG                                                         02/13/2025 10:13:57 PAGE 22  

                              Drv_DpRx_FecCtsSet(g_stAuxStatus.szRxData[0]);
                              #endif
                              break; 
              //             #endif
                                       #endif
                           #if ((DPRX_DSC_DEC_SUPPORT == ENABLED) || (DPRX_DSC_BYPASS_SUPPORT == ENABLED))
                           case 0x60 : //dpcd00160
                              g_stAuxStatus.DscFlag = (g_stAuxStatus.szRxData[0]&0x01)?(1):(0);
                              break;
                          #endif                    
                          #if DPRX_MST_MODE_EN == ENABLED
                          case 0x11:
                              g_stAuxStatus.b1MstFlag = ((g_stAuxStatus.szRxData[ucIncrease]&0x01)==0x01)?(1):(0);
                              break;
                          case 0xc0:
                              g_stMstRxStatus.payload_table[0] = g_stAuxStatus.szRxData[ucIncrease];
                              if (++ucIncrease == ucLenth)
                              {
                                  break;
                              }
                          case 0xc1:
