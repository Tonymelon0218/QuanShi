                              Drv_DpRx_Reset(DP_MLC_DAT_RST);  //solve mst dpcd200c not clr issue 
                                      //解决华为手机写了DCPD102后，先读DPCD206，再写DPCD103，导致Swing莫名的增加
                                      Drv_DpRx_Dpcd_ValueWrite(0x03,0x00);
                                      Drv_DpRx_Dpcd_ValueWrite(0x04,0x00);
                                      Drv_DpRx_Dpcd_ValueWrite(0x05,0x00);
                                      Drv_DpRx_Dpcd_ValueWrite(0x06,0x00);
                          #if DPRX_CDR_MODE == ANACDR
