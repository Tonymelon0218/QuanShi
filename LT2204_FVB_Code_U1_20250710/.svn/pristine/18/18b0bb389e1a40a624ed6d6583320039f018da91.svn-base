              //========================================================================================================
             -===================
              //the following function get the aux training status, maybe used in other function
              //===========================================
              //func  :judge the cr_lock and eq done status
              //input :N/A
              //output:N/A
              //return:void
              //Info  :N/A
              //===========================================
              void Mod_Aux_TrainingDone(void)
              {
                  switch (g_stAuxStatus.ucLink_Count)
                  {
                      case ONE_LANE:
                          if((g_stAuxStatus.ucTps_Pattern == TPS1) && ((g_stAuxStatus.ucDpcd202 & 0x01) == 0x01))
                          {
                              g_stAuxStatus.b1Cr_Lock  = TRUE;
                          }
                          else if ((g_stAuxStatus.ucTps_Pattern >= TPS2) && ((g_stAuxStatus.ucDpcd202 & 0x0f) == 0x07))
                          {
                              g_stAuxStatus.b1Train_Done = TRUE;
                          }
                          break;
              
                      case TWO_LANE:
                          if((g_stAuxStatus.ucTps_Pattern == TPS1) && ((g_stAuxStatus.ucDpcd202 & 0x11) == 0x11))
                          {
                              g_stAuxStatus.b1Cr_Lock  = TRUE;
                          }
C51 COMPILER V9.53.0.0   MODAUXMSG                                                         02/13/2025 10:13:57 PAGE 8   

                          else if ((g_stAuxStatus.ucTps_Pattern >= TPS2) && (g_stAuxStatus.ucDpcd202 == 0x77))
                          {
                              g_stAuxStatus.b1Train_Done = TRUE;
                          }
                          break;
              
                      case FOUR_LANE:
                          if((g_stAuxStatus.ucTps_Pattern == TPS1) && ((g_stAuxStatus.ucDpcd202&0x11) == 0x11)&&((g_stAu
             -xStatus.ucDpcd203&0x11) == 0x11))
                          {
                              g_stAuxStatus.b1Cr_Lock  = TRUE;
                          }
                          else if ((g_stAuxStatus.ucTps_Pattern >= TPS2) && (g_stAuxStatus.ucDpcd202 == 0x77) && (g_stAu
             -xStatus.ucDpcd203 == 0x77))
                          {
                              g_stAuxStatus.b1Train_Done = TRUE;
                          }
                          break;
              
                      default:
                          break; 
                  }
                  #if DPRX_CDR_MODE != ANACDR
                  if((g_stAuxStatus.b1Dpcd107_WrFlag == FALSE)&&(g_stAuxStatus.ucTps_Pattern == TPS1))
                  {
                      g_stAuxStatus.b1Ssc_Dpcd107 = Drv_DpRx_SscJudgeByRxFm(g_stAuxStatus.ucLink_Rate);
                      Drv_DpRx_CdrSet(g_stAuxStatus.b1Ssc_Dpcd107, g_stAuxStatus.ucLink_Rate);
                  }   
                  #endif
              }
              
              //===========================================
              //func  :read dpcd 00200
              //input :aux read order
              //output:N/A
              //return:void
              //Info  :N/A
              //===========================================
              void Mod_Read_Dpcd200(IN u8 ucI)
              {
                  #if DPRX_HDCP_DEC_MODE == NO_HDCP
                  #if DPRX_MST_MODE_EN ==ENABLED
                  g_stAuxStatus.szRxSendData[ucI] = g_stMstRxStatus.sink_cnt;
                  #else
                  g_stAuxStatus.szRxSendData[ucI] = 0x01;
                  #endif
                  #else   
                  #if DPRX_MST_MODE_EN ==ENABLED
                  g_stAuxStatus.szRxSendData[ucI] = g_stMstRxStatus.sink_cnt | BIT6_1;
                  #else
                  g_stAuxStatus.szRxSendData[ucI] = 0x41;
                  #endif
                  #endif
                  //need add the hdcp irq case
              }
              
