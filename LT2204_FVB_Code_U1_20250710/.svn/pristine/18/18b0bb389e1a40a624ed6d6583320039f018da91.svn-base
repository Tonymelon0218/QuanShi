              //===========================================
              //func  :dpcd write action for command 0x80
              //input :aux write data lenth
              //output:N/A
              //return:void
              //Info  :N/A
              //===========================================
              void Mod_Write_Dpcd(u8 ucLenth)
              {
                  IDATA u8 ucIncrease;
                  IDATA u8 ucLoopAux;
              //    BKA3_82_REG |= BIT4_1;
                  if(g_stAuxStatus.szRxAddress[0] == 0x0f)
                  {
                      return;
                  } 
                  BKF1_03_REG =  g_stAuxStatus.szRxAddress[0];
                  BKF1_04_REG =  g_stAuxStatus.szRxAddress[1];
                  BKF1_05_REG =  g_stAuxStatus.szRxAddress[2];
                      
                  for (ucLoopAux = 0; ucLoopAux < ucLenth; ucLoopAux++)
                  {
                      if (ucLoopAux) //
                      {
                          if (BKF1_05_REG == 0xff)
                          {
                              BKF1_04_REG++;
                          }
                          BKF1_05_REG ++;
                      }
                      BKF1_53_REG = g_stAuxStatus.szRxData[ucLoopAux] ;//write from DPCD
                  }
              //      BKA3_82_REG &= BIT4_0;
