              //===========================================
              //func  :this function deal with the auxrx interrupt
              //input :N/A
              //output:N/A
              //return:void
              //Info  :N/A
              //===========================================
              void Mod_DpRx_AuxTask(void)
              {
                  IDATA u8 ucRxLength;
                  IDATA u8 ucLoopAux;
                  IDATA u8 ucRxCmd;
                  IDATA u8 ucRxCounter;
                  ucRxLength = 0;
                      ucRxCounter = REG_AUX_BUF_CNT & 0x1f;//[4:0]The number of auxrx data to read. This is used in software mo
             -de of aux reply.
                  ucRxCmd     = REG_AUX_CMDTYPE;
                  g_stAuxStatus.szRxAddress[0] = REG_AUX_REC_DATA & 0x0f;
                  g_stAuxStatus.szRxAddress[1] = REG_AUX_REC_DATA;
                  g_stAuxStatus.szRxAddress[2] = REG_AUX_REC_DATA;
                  ucRxLength = REG_AUX_REC_DATA + 1;  //REG_AUX_REC_DATA
                  if (ucRxCounter >= 0x04) //
                  {
                      if (ucRxLength > 0x10)
                      {
                          return;
                      }
                      for (ucLoopAux = 0; ucLoopAux < ucRxLength; ucLoopAux++)
                      {
                          g_stAuxStatus.szRxData[ucLoopAux] = REG_AUX_REC_DATA;  //REG_AUX_REC_DATA
                      }
                  }
                  else
                  {
                      ucRxLength = 0;
                  }
                  Drv_DpRx_AcAuxTermCtrl(DISABLED);
              
                  switch (ucRxCmd)
                  {
                      case CMD_DPCDW://0x80; Native WR
                          Mod_Write_Dpcd(ucRxLength);
                          if(g_stAuxStatus.szRxAddress[0] == 0x0f)
                          {
                              Mod_AuxMsg_Reply(AUXNACK);
                          }
                          else
                          {
                              Mod_AuxMsg_Reply(AUXACK);
                          }
                          break;
              
                      case CMD_DPCDR://0x90; Native Read              
                          Mod_Read_Dpcd(ucRxLength);  
                          Mod_Aux_SendData(ucRxLength);
                          break;
                      case CMD_I2CW://0x40;
                          if (g_stAuxStatus.szRxAddress[2] == 0x50)//EDID address
                          {
                              if ((ucRxLength == 1) && (ucRxCounter == 0x05))//WR EDID original address
                              {
                                  g_stAuxStatus.usEdid_Offset = g_stAuxStatus.szRxData[0];
C51 COMPILER V9.53.0.0   MODAUXMSG                                                         02/13/2025 10:13:57 PAGE 26  

                                  if(g_stAuxStatus.ucEdid_Block_Offset != 0x00)
                                  {
                                      g_stAuxStatus.usEdid_Offset = ((u16)g_stAuxStatus.ucEdid_Block_Offset*0x100) | g_s
             -tAuxStatus.usEdid_Offset;
                                      g_stAuxStatus.ucEdid_Block_Offset = 0x00;
                                  }
                              }
                          }
                          else if(g_stAuxStatus.szRxAddress[2] == 0x30)//>256 EDID block
                          {
                              if((ucRxLength == 1)&&(g_stAuxStatus.szRxData[0]!= 0x00))
                              {
                                   g_stAuxStatus.ucEdid_Block_Offset = g_stAuxStatus.szRxData[0];
                              }
                          }
                          Mod_AuxMsg_Reply(AUXACK);
                          break;
              
                      case CMD_I2CR://0x50; MOT=1,I2C-R //address only or address length????
                          if ((g_stAuxStatus.szRxAddress[2] == 0x50) && (ucRxCounter == 0x04)) //read EDID datas
                          {
                              Mod_Aux_EdidRead(ucRxLength);
                          }
                          else if ((g_stAuxStatus.szRxAddress[2] == 0x52) && (ucRxCounter == 0x04)) //read EDID datas
                          {
                              Mod_AuxMsg_Reply(AUXNACK);
                          }
                          else
                          {
                              Mod_Aux_SendZeroData(ucRxLength);
                          }
              
                          break;
              
                      case CMD_I2CS://0x10;
                          if ((g_stAuxStatus.szRxAddress[2] == 0x50) && (ucRxCounter == 0x04))//EDID address
                          {
                              Mod_Aux_EdidRead(ucRxLength);
                              g_stAuxStatus.usEdid_Offset = 0;
                          }
                          else if ((g_stAuxStatus.szRxAddress[2] == 0x50) && (ucRxCounter == 0x03))//address only(read s
             -top)
                          {
                              Mod_AuxMsg_Reply(AUXACK);
                              g_stAuxStatus.usEdid_Offset = 0;
                          }
                          else
                          {
                              Mod_Aux_SendZeroData(ucRxLength);
                          }
                          break;
              
                      case CMD_I2CLW://0x00;MOT=0,I2C-over-aux,write done;address only(stop)
              //            #if DDCCI_EN == 1
              //            if(g_stAuxStatus.szRxAddress[2]==0x37)//DDCCI address
              //            {
              //                              if(ucRxLength >= 1)
              //                              {
              //                                      Chip_DdcciMsg_Buffer(g_stDdcciStatus.ucFS_Data_Remove,ucRxLength);
              //                                      g_stDdcciStatus.ucFS_Data_Remove += ucRxLength;
              //                                      g_stDdcciStatus.ucLenth_Of_Data += ucRxLength;  
              //                                      g_stDdcciStatus.ucLenth_DDCCI = g_stDdcciStatus.szDDCCI_To_HDMI_BF[1];
C51 COMPILER V9.53.0.0   MODAUXMSG                                                         02/13/2025 10:13:57 PAGE 27  

              //                                      //the received data length is equal to the actual data length
              //                                      if((g_stDdcciStatus.ucLenth_DDCCI + 3) == (g_stDdcciStatus.ucLenth_Of_Data+0x80))
              //                                      {
              //                                              g_stDdcciStatus.ucFS_Data_Remove = 0;
              //                                              g_stDdcciStatus.ucAuxDDCCI = 0;
              //                                              g_stDdcciStatus.b1Send_Differ_En = 1;
              //                                      }               
              //                              }
              //                else if(g_stDdcciStatus.ucFS_Data_Remove)
              
              //                {
              //                    g_stDdcciStatus.ucFS_Data_Remove = 0;
              //                    g_stDdcciStatus.ucAuxDDCCI = 0;
              //                    g_stDdcciStatus.b1Send_Differ_En = 1;
              //                }
              //            } 
              //            #endif
                          //龙源有一款RTD的主控，会通过MOT为0的WR，来操作EDID
                                      if (g_stAuxStatus.szRxAddress[2] == 0x50) //EDID address
                          {
                              if ((ucRxLength == 1) && (ucRxCounter == 0x05)) //WR EDID original address
                              {
                                  g_stAuxStatus.usEdid_Offset = g_stAuxStatus.szRxData[0];
