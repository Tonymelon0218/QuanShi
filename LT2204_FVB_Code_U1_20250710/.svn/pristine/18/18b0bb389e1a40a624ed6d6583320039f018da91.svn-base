              void Mod_Read_Dpcd202(IN u8 ucI)//on going
              {
                  Mod_Aux_RequestCalLane01(ucI);
                  Mod_Aux_TrainingDone();
              }
              
              //===========================================
              //func  :read dpcd 00203
              //input :aux read order
              //output:N/A
