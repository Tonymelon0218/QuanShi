              void LT6911GXE_HdmiRxVarInit(void)
              {
                  g_stHdmiRx.ucHdmiVer = HDMI20;
                  #ifdef NVIDIA_FW_EN
                  #if (SLEEP_MODE == ENABLED)
                  g_stSleep.ucSleepState = SLEEP_INIT_0;
                  #endif
                  #endif
              }
              
              void LT6911GXE_PowerOnInit(void)
              {
                  Mod_HdmiRx_PowerOnInit();
              
                  #if TX_PORT_SIGN == MIPI_PORT
                  Mod_MipiTx_PowerOnInit();
                  #endif
              
                  #if TX_PORT_SIGN == LVDS_PORT
                  Mod_LvdsTx_PowerOnInit();
                  #endif
                  Drv_Sys_DecPowerDomain(TRUE);
                  Drv_Sys_EncPowerDomain(TRUE);
                              Drv_Sys_LT6911GXE_PowerDomain();
                  //Drv_Sys_DHTxPowerDomain(TRUE);// dhtx rest  cause rx issue
                        LT6911GXE_GPIO_Init();
                  #if PWM_OUT == ENABLED
                  {
                      PWM_Init(PWM_GPIO,PWM_FREQ,PWM_DUTY);
                  }
                  #endif              
              }
              
