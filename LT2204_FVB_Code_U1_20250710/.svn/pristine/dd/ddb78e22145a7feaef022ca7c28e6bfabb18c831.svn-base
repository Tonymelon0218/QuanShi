              //========================================================================
              // Func Name   : LT6911GXE_Main_Scan
              // Description : The main loop for LT6911GXE
              // Input       : void  
              // Output      : None
              // Return      : void
              //========================================================================
              void LT6911GXE_Main_Scan(void)
              {
                  //rx handler
                  Mod_HdmiRx_Handler();
              
                  //tx handler
              #if TX_PORT_SIGN == LVDS_PORT
                  Mod_LvdsTx_Handler();
              #endif
                      
              #if TX_PORT_SIGN == MIPI_PORT
                  Mod_MipiTx_Handler();
              #endif
              
              
              
               #if TX_PORT_SIGN == MIPI_PORT
                        Audio_Interrupt_Detect();
                  Video_Disappear_Interrupt_Detect();
                        Video_Ready_Interrupt_Detect();
                      
                              if(g_stMipiTx.ucTxState == STATE_MIPITX_UPSTREAM_VIDEO_READY_3)
                              {
                                              Drv_Sys_DHTxPowerDomain(FALSE);
                              }
              
C51 COMPILER V9.53.0.0   LT6911GXE                                                         02/13/2025 10:13:55 PAGE 9   

                              if (g_stMipiTx.ucTxState == STATE_MIPITX_AUDIO_OUT_6)
                              {
                                              Drv_Sys_DHTxPowerDomain(TRUE);
                              }
              
              //              if (g_stMipiTx.ucTxState >= STATE_MIPITX_AUDIO_OUT_6)
              //              {
              //                              Drv_MipiTx_EnableControl();
              //              }
              #endif
                      
                      
              #if PWM_OUT == ENABLED
                  {           
                      if(PWM_DUTY_REG != PWM_DUTY)
                      {
                          PWM_Init(PWM_GPIO,PWM_FREQ,PWM_DUTY_REG);
                      }
                      else
                      {
                          PWM_Init(PWM_GPIO,PWM_FREQ,PWM_DUTY);
                      }
                  }
              #endif          
              }
              
              #endif


