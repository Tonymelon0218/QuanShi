                  {
                      Drv_HdmiRxDscDec_ColorInfoGet(&stInfo);
                  }
                  #endif
                  Drv_HdmiRx_RxTimingGet(&stRxTimingInfo);//
              
                  #if TX_PORT_SIGN == MIPI_PORT
                  
                  #endif
                  #if TX_PORT_SIGN == LVDS_PORT
                  
                  #endif 
              }
              
              void LT6911GXE_HdmiRxAudioInfoCvt(void)
              {
                              u8 I2s_LaneNum = 0;
                              
                  AudioChlInfo_S stInfo;
                  Drv_HdmiRx_AudioInfoGet(&stInfo);
                  
                              I2s_LaneNum = ((stInfo.ucChannel + 1) / 2) + ((stInfo.ucChannel + 1) % 2);
                      
                              switch(I2s_LaneNum)
                              {
                                              case 2:
                                                              Drv_Gpio_ModeSet(GPIO29_SD0B, OUT_PP_2x|NO_PU_PD, VOL_3_3);
                                                              Drv_Gpio_ModeSet(GPIO28_SD1B, OUT_PP_2x|NO_PU_PD, VOL_3_3);
                                                              Drv_Gpio_ModeSet(GPIO27_SD2B, OUT_DISABLE, VOL_3_3);
                                                              Drv_Gpio_ModeSet(GPIO26_SD3B, OUT_DISABLE, VOL_3_3);
                                                              printLT(PRINT_PRIO_HIG, "\n******I2S 2lane output******£¡");
                                                              break;
                                              case 3:
                                                              Drv_Gpio_ModeSet(GPIO29_SD0B, OUT_PP_2x|NO_PU_PD, VOL_3_3);
                                                              Drv_Gpio_ModeSet(GPIO28_SD1B, OUT_PP_2x|NO_PU_PD, VOL_3_3);
                                                              Drv_Gpio_ModeSet(GPIO27_SD2B, OUT_PP_2x|NO_PU_PD, VOL_3_3);
                                                              Drv_Gpio_ModeSet(GPIO26_SD3B, OUT_DISABLE, VOL_3_3);
                                                              printLT(PRINT_PRIO_HIG, "\n******I2S 3lane output******£¡");
                                                              break;
                                              case 4:
                                                              Drv_Gpio_ModeSet(GPIO29_SD0B, OUT_PP_2x|NO_PU_PD, VOL_3_3);
                                                              Drv_Gpio_ModeSet(GPIO28_SD1B, OUT_PP_2x|NO_PU_PD, VOL_3_3);
                                                              Drv_Gpio_ModeSet(GPIO27_SD2B, OUT_PP_2x|NO_PU_PD, VOL_3_3);
                                                              Drv_Gpio_ModeSet(GPIO26_SD3B, OUT_PP_2x|NO_PU_PD, VOL_3_3);
                                                              printLT(PRINT_PRIO_HIG, "\n******I2S 4lane output******£¡");
                                                              break;
                                              default:
                                                              Drv_Gpio_ModeSet(GPIO29_SD0B, OUT_PP_2x|NO_PU_PD, VOL_3_3);
                                                              Drv_Gpio_ModeSet(GPIO28_SD1B, OUT_DISABLE, VOL_3_3);
                                                              Drv_Gpio_ModeSet(GPIO27_SD2B, OUT_DISABLE, VOL_3_3);
                                                              Drv_Gpio_ModeSet(GPIO26_SD3B, OUT_DISABLE, VOL_3_3);
                                                              printLT(PRINT_PRIO_HIG, "\n******I2S 1lane output******£¡");
C51 COMPILER V9.53.0.0   LT6911GXE                                                         02/13/2025 10:13:55 PAGE 4   

                                                              break;
                              }
              }
              
              
              void LT6911GXE_HdmiRxCscOrEncSel(void)
              {
                  g_stHdmiRx.b1CscRxEnable = DISABLED;
                  printLT(PRINT_PRIO_HIG, "\nRx_Tmsd_clk =  0x%08lx",g_stHdmiRx.ulRxTmdsClk);
                      
                              #if CSC_SUPPORT == ENABLED      
                                      #if TX_PORT_SIGN == MIPI_PORT
                                              g_stMipiTx.ucTxFormat = MIPITX_VIDEO_FORMAT;
                                              switch(g_stMipiTx.ucTxFormat)
                                              {
                                                              case DSI_RGB_565:
                                                              case DSI_RGB_666:
                                                              case DSI_RGB_888:
                                                              case DSI_RGB_30:
                                                              case CSI_RGB_565:                                                                       
                                                              case CSI_RGB_666:       
                                                              case CSI_RGB_888:               
                                                                               g_stHdmiRx.b1CscRxOutFormat = RGB_0;
                                                                               printLT(PRINT_PRIO_HIG, "\nCscRx out RGB_0");  
                                                                               break;
                                                                      
                                                              case DSI_YUV422_16Bit:  
                                                              case DSI_YUV422_20Bit:  
                                                              case DSI_YUV422_24Bit:
                                                              case CSI_YUV422_8Bit:
                                                              case CSI_YUV422_10Bit:
                                                                               g_stHdmiRx.b1CscRxOutFormat = YCbCr422_1;
                                                                               printLT(PRINT_PRIO_HIG, "\nCscRx out YCbCr422_1");     
                                                                               break;
              
                                                              case DSI_YUV420_12Bit:  
                                                              case CSI_YUV420_8Bit:                                                                                   
                                                                               g_stHdmiRx.b1CscRxOutFormat = YCbCr420_3;
                                                                               printLT(PRINT_PRIO_HIG, "\nCscRx out YCbCr420_3");     
                                                                               break;
                                                              
                                                              default:
                                                                               break;
                                       }
                                      #else
                                              g_stLvdsTx.ucLvdsTxDataMap = LVDS_DATAMAP;
                                              switch(g_stLvdsTx.ucLvdsTxDataMap)
                                              {
                                                              case VESA_RGB_8Bit:
                                                                         break;
                                                              case JEIDA_RGB_8Bit:    
                                                                               g_stHdmiRx.b1CscRxOutFormat = RGB_0;
                                                                               printLT(PRINT_PRIO_HIG, "\nCscRx out RGB_0");  
                                                                               break;
                                                              case SONY_YUV422_8Bit:
