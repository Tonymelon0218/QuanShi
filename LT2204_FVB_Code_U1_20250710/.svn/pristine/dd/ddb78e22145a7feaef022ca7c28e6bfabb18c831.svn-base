              void LT6911GXE_HdmiRxColorInfoCvt(void)
              {
                  ColorInfo_S stInfo;
                  LtTiming_S  stRxTimingInfo; 
              
                  Drv_HdmiRx_ColorInfoGet(&stInfo);
