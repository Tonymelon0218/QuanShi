              #if CSC_SUPPORT == ENABLED
              void LT6911GXE_HdmiRxCscCvt(void)
              {
                  if(g_stHdmiRx.b1CscRxEnable == ENABLED)
                  {
                      if((g_stHdmiRx.ucPixelEncoding == RGB_0)||(g_stHdmiRx.ucPixelEncoding == RGB_WIDE_4))
                      {
                          g_stHdmiRx.b1CscRxOutRange = FULL_RANGE;
                      }
                      else
                      {
                          g_stHdmiRx.b1CscRxOutRange = LIMIT_RANGE;
                      }
                                              Drv_CscRx_RxtoTx(&g_stHdmiRx);
                  }
              }
              #endif
              
              void LT6911GXE_HdmiRxMsgNotify(u8 ucEvent)
              {
                  Mod_LMTx_EventMonitor(ucEvent);//mipi LVDS event
                  switch(ucEvent)
                  {
                      case HDMIRX_SOURECE_PLUG_EVENT:
                          break;
              
                      case HDMIRX_SOURECE_UNPLUG_EVENT:
                          break;
              
                      case HDMIRX_VIDEO_ON_EVENT:
                          Mod_HdmiRx_TmdsClkCal();
              
                          LT6911GXE_HdmiRxCscOrEncSel();
                          LT6911GXE_HdmiRxColorInfoCvt();
                      
                          #if CSC_SUPPORT == ENABLED
                          LT6911GXE_HdmiRxCscCvt();
                          #endif
                          break;
              
                      case HDMIRX_VIDEO_OFF_EVENT:
                          Drv_HdmiRx_SyncPolSet(DISABLED);
                          Drv_HdmiRx_TmdsPcrPllDis();
                          Drv_Sys_DecPowerDomain(TRUE);
                          Drv_Sys_EncPowerDomain(TRUE);
                          #if CSC_SUPPORT == ENABLED
                          Drv_CscRx_Init();
                          #endif
                          break;
              
                      case HDMIRX_HDCP_VER_CHG_EVENT:
                          break;
              
                      case HDMIRX_AUDIO_CHG_EVENT:
                          LT6911GXE_HdmiRxAudioInfoCvt();
                          break;
              
C51 COMPILER V9.53.0.0   LT6911GXE                                                         02/13/2025 10:13:55 PAGE 6   

                      case HDMIRX_VRR_NOTIFY_EVENT:
                          break;
                      case HDMIRX_INTERLACE_EVENT:
                          break;
                      case HDMIRX_DOBLY_HDR_NOTIFY_EVENT:
                          break;
                      case HDMIRX_STATIC_HDR_NOTIFY_EVENT:
                          break;        
                      case HDMIRX_DYNAMIC_HDR_NOTIFY_EVENT:
                          break;
                      case HDMIRX_AUDIO_MUTE_EN:
                          break;
                      case HDMIRX_AUDIO_MUTE_DIS:
                          break;
                      case HDMIRX_VIDEO_MUTE_EN:
                          break;
                      case HDMIRX_VIDEO_MUTE_DIS:
                          break;
                      default:
                          break;
                  }
              }
              
              #if TX_PORT_SIGN == MIPI_PORT
              void Audio_Interrupt_Detect(void)
              {
                              if((g_stMipiTx.ucTxState) > STATE_MIPITX_AUDIO_OUT_6)
                              {
                                              if(Gpio_Int_Lock == 0)
                                              {
                                                              if (Drv_HdmiRx_AudioChangeDetect())
                                                              {
                                                                              Gpio_Int_Lock = 1;
                                                                              Audio_interrupt_trigger = 1;
                                                                              #if (CHIP_SEL == LT6911GXD_HD)
                                                                              Drv_IOSoftLevel_Set(GPIO25_PWM3, LOW);
                                                                              #else
                                                                              Drv_IOSoftLevel_Set(INT, LOW);
                                                                              #endif
                                                                              printLT(PRINT_PRIO_TEST, "\n******Audio Change, INT_LOW!******");
                                                                              Ocm_Timer_UpdLocalTime(&ulCurrentTime_audio);
                                                              }
                                              }
                              }
                              if(Ocm_Timer_IsOverFlow(&ulCurrentTime_audio, MS_20)==TRUE)
                              {
                                              if(Audio_interrupt_trigger)
                                              {
                                                              Gpio_Int_Lock = 0;
                                                              Audio_interrupt_trigger = 0;
                                                              #if (CHIP_SEL == LT6911GXD_HD)
                                                              Drv_IOSoftLevel_Set(GPIO25_PWM3, HIGH);
                                                              #else
                                                              Drv_IOSoftLevel_Set(INT, HIGH);
                                                              #endif
                                                              printLT(PRINT_PRIO_TEST, "\n******Audio Change, INT_HIGH!******");
                                                              Ocm_Timer_UpdLocalTime(&ulCurrentTime_audio);
                                              }
                              }
              }
              
              
C51 COMPILER V9.53.0.0   LT6911GXE                                                         02/13/2025 10:13:55 PAGE 7   

              void Video_Ready_Interrupt_Detect(void)
              {
                              if((g_stMipiTx.ucTxState) > STATE_MIPITX_VIDEO_OUT_5)
                              {
                                              if(Gpio_Int_Lock == 0)
                                              {
                                                              video_ready_interrupt_trigger = Drv_MipiTx_VideoReadyDetect();
                                                              if(video_ready_interrupt_trigger)
                                                              {
                                                                              Gpio_Int_Lock = 1;
                                                                              #if (CHIP_SEL == LT6911GXD_HD)
                                                                              Drv_IOSoftLevel_Set(GPIO25_PWM3, LOW);
                                                                              #else
                                                                              Drv_IOSoftLevel_Set(INT, LOW);
                                                                              #endif
                                                                              printLT(PRINT_PRIO_TEST, "\n******Video_Ready, INT_LOW!******");
                                                                              Ocm_Timer_UpdLocalTime(&ulCurrentTime_video_ready);
                                                              }
                                              }
                              }
                              if(Ocm_Timer_IsOverFlow(&ulCurrentTime_video_ready, MS_20)==TRUE)
                              {
                                              if(video_ready_interrupt_trigger)
                                              {
                                                              Gpio_Int_Lock = 0;
                                                              video_ready_interrupt_trigger = 0;
                                                              #if (CHIP_SEL == LT6911GXD_HD)
                                                              Drv_IOSoftLevel_Set(GPIO25_PWM3, HIGH);
                                                              #else
                                                              Drv_IOSoftLevel_Set(INT, HIGH);
                                                              #endif
                                                              printLT(PRINT_PRIO_TEST, "\n******Video_Ready, INT_HIGH!******");
                                                              Ocm_Timer_UpdLocalTime(&ulCurrentTime_video_ready);
                                              }
                              }
              }
              
