void Drv_Flash_Rd(u32 Add,u8 *buff,u16 length)
{
	u8 j;
	u8 time,remainder;
	u16 OverFlow;
	u8  Byte0,Byte1;
	
	UN32 UAdd;
	UAdd.ulData=Add;
	
    BKE0_5E_REG = 0xC1;
    BKE0_58_REG = 0x00;
    BKE0_59_REG = 0x50;
    BKE0_5A_REG = 0x10;
    Ocm_Delay1ms(1);
    BKE0_5A_REG = 0x00;
    BKE0_58_REG = 0x21;    
    
	time=(length/FIFO_MAX);
	remainder=(length%FIFO_MAX);
	for(j=0;j<time+1;j++)
	{
		if(j<time)
		{
			length=FIFO_MAX;
		}
		else
		{
			length=remainder;
		}
		OverFlow=UAdd.ucBuff[3]+length;
		if(OverFlow>256)
		{
			Byte0=256-UAdd.ucBuff[3];
			Byte1=length-Byte0;
		}
		else
		{
			Byte0=length;
			Byte1=0;
		}
		FlashByte_Rd(&UAdd.ucBuff[1],buff,Byte0);
		buff=buff+Byte0;
		UAdd.ulData=UAdd.ulData+Byte0;
		if(Byte1>0)
		{
			FlashByte_Rd(&UAdd.ucBuff[1],buff,Byte1);
			buff=buff+Byte1;
			UAdd.ulData=UAdd.ulData+Byte1;
		}
	}
}

#endif