void Drv_AudioSdm_SwEn(void)
{
	BKC6_24_REG |= 0x07;
	BKC6_24_REG &= 0xf8;
}

u8 Drv_Audio_FsValStbCheck(void)
{
	if(BKC6_81_REG & BIT0_1)
	{
		if(BKC6_97_REG & BIT2_1)//fs stable
		{

			BKC6_3A_REG |= BIT2_1;
			BKC6_3A_REG &= BIT2_0;
			printLT(PRINT_PRIO_TEST, "\nFS = 0x%02bx",BKC6_7C_REG);			
			return TRUE;
		}
	}
	return FALSE;
}

//===========================================
//  func: audio out mute judge
// input: N/A
//output: N/A
//return: u8, ENABLE DISABLED NO_ACTION
//  Info: N/A
//===========================================
u8 Drv_Audio_StatusCheck(void)
{
    if (BKC6_8D_REG & BIT1_1)
    {
        if (BKEB_06_REG&BIT2_1)
        {
            return ENABLED;
        }
    }
    else
    {
        if ((BKEB_06_REG&BIT2_1)==0x00)
        {
            return DISABLED;
        }
    }
    return NO_ACTION;
}
#if TX_PORT_SIGN == DP_PORT
void Drv_Audio_MuteCheck(u8 ucAudioMuteEn)
{
    #if TX_PORT_SIGN == HDMI_PORT
    ucAudioMuteEn = DISABLED;
    if (BKC6_8D_REG & BIT2_1)//[2]rgod_au_mute_hd
    {
        if (BKEB_06_REG & BIT2_1)//[2]set hdmi audio stream input enable: 1-en
        {
            Drv_Audio_OutEn(OFF);
        }
    }
    else
    {
        if ((BKEB_06_REG&BIT2_1) == 0x00)
        {
            Drv_Audio_OutEn(ON);
        }
    }
    #endif

    #if TX_PORT_SIGN == DP_PORT
    if (BKC6_8D_REG & BIT2_1)//[2]rgod_au_mute_hd
    {
        if (BKF6_0E_REG & BIT0_1)//[0]asp sdp pkt en
        {
            Drv_Audio_OutEn(OFF);
        }
    }
    else if (ucAudioMuteEn == DISABLED)//[7]rgd_no_videostream_flag: 0-video out
    {
        if ((BKF6_0E_REG & BIT0_1) == 0x00)
        {
            Drv_Audio_OutEn(ON);
        }
    }
    #endif
}
#endif


void Drv_Audio_Init(void)
{
    Drv_Audio_AcrPllInit();

    //rx input init
    Drv_Audio_DpInInit();
    Drv_Audio_I2sInInit();
    Drv_Audio_HdmiInInit();
    Drv_Audio_SpdifInInit();
    //tx out init
    Drv_Audio_DpOutInit();
    Drv_Audio_I2sOutInit();
    Drv_Audio_HdmiOutInit();
    Drv_Audio_eArcOutInit();
    Drv_Audio_SpdifOutInit();
}
