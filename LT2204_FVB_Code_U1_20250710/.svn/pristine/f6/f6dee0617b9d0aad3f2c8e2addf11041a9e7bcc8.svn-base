#include "Include.h"

#if ((TX_AUDIO_SEL != NO_AUDIO_DATA) || (I2S_AUDIO_SEL != NO_AUDIO_DATA) || (SPDIF_AUDIO_SEL != NO_AUDIO_DATA))

void Drv_Audio_I2sInInit(void)
{
    #if TX_AUDIO_SEL == I2SIN_AUDIO_DATA
    BKC6_37_REG |= BIT1_1;//[1]audio in en: 1-en(audio in 总开关)
    BKC6_38_REG &= 0x0f;
    BKC6_38_REG |= BIT4_1;//[7:4]i2s sdn_en: sd0 en
    BKC6_39_REG &= BIT7_0;//[7]rgd_spdif_i2s_in_sel: 0-i2s in

//    //default:
//    BKE6_C3_REG = 0x0f;//ad_sd0a_vsync_gpio19
//    BKE6_C4_REG = 0x19;//ad_sd1a_gpio5
//    BKE6_C5_REG = 0x18;//ad_sd2b_gpio6
//    BKE6_C6_REG = 0x17;//ad_sd3b_gpio7
//    BKE6_C7_REG = 0x10;//ad_wsa_gpio18
//    BKE6_C8_REG = 0x11;//ad_scka_gpio17

    BKE1_41_REG &= 0x0f;//[7:6]acr_128fs_clk: 1-i2s_mclk_i, 2-~i2s_mclk, 3-spdif_cdr_clk
    BKE1_41_REG |= 0x20;//[5:4]acr_fs64_clk_src: 10-i2s sck

//    #if (TX_AUDIO_SEL == I2SIN_AUDIO_DATA)
    BKC6_3E_REG = 0x30;//25Mhz Cry
    BKC6_3F_REG = 0xD4;
    
    BKA3_71_REG &= 0x33;
    BKA3_72_REG &= 0x33;
    BKED_10_REG &= 0x83;//bit6-4 3-2 
    BKE6_C3_REG = 0x05;//SD0B
    BKE6_C7_REG = 0x04;//WSB
    BKE6_C8_REG = 0x02;//SCLKB
    BKE6_C9_REG = 0x03;//MCLKB
//    #endif
    #endif
}
void Drv_Audio_IisHbrModeSel(u8 IsSoftmode)
{
    (IsSoftmode == SOFTMODE)?(BKC6_2F_REG |= BIT1_1):(BKC6_2F_REG &= BIT1_0);
}
void Drv_Audio_IisHbrSet(u8 IsHbr)
{
    (IsHbr == TRUE)?(BKC6_2F_REG |= BIT2_1):(BKC6_2F_REG &= BIT2_0);
}
void Drv_Audio_HdmiInInit(void)
{
    #if RX_PORT_SIGN == HDMI_PORT

    #if ((TX_AUDIO_SEL == RX_AUDIO_DATA)||(EARC_TX_AUDIO_SEL == RX_AUDIO_DATA) ||\
         (I2S_AUDIO_SEL == RX_AUDIO_DATA)||(SPDIF_AUDIO_SEL == RX_AUDIO_DATA))
    
    BKC6_2F_REG |= BIT0_1;//[0]dll_data_sel: 1-hdmirx
    #endif
    Drv_Audio_IisHbrModeSel(HARDWARE);
    #endif
}

void Drv_Audio_DpInInit(void)
{
    #if RX_PORT_SIGN == DP_PORT

    #if ((TX_AUDIO_SEL == RX_AUDIO_DATA)||(EARC_TX_AUDIO_SEL == RX_AUDIO_DATA) ||\
         (I2S_AUDIO_SEL == RX_AUDIO_DATA)||(SPDIF_AUDIO_SEL == RX_AUDIO_DATA))
    BKC6_2F_REG &= BIT0_0;//[0]dll_data_sel: 0-dprx
	BKEB_10_REG &= BIT4_0;//HDMITX Packet layout from User
    #endif
    //Set HBR Soft mode
    Drv_Audio_IisHbrModeSel(SOFTMODE);
    #endif
}

void Drv_Audio_SpdifInInit(void)
{
    #if TX_AUDIO_SEL == SPDIFIN_AUDIO_DATA
    BKC6_37_REG |= BIT1_1;//[1]audio in en: 1-en(audio in 总开关)
    BKC6_39_REG |= BIT7_1;//[7]spdif in en: 1-en

//    //default:
//    BKE6_CA_REG = 0x1a;//ad_spdifa_gpio4
//    Drv_Gpio_ModeSet(SPDIF_IN_PORT, FORBIDDEN, 0);

    BKE1_41_REG &= 0x0f;//[7:6]acr_128fs_clk: 1-i2s_mclk_i, 2-~i2s_mclk, 3-spdif_cdr_clk
    BKE1_41_REG |= 0xd0;//[5:4]acr_fs64_clk_src: 1-128_div2, 0-sck
    #endif
}

