 124          void Drv_HdcpTx_Enable(IN u8 ucOpt)
 125          {
 126   1          #if TX_PORT_SIGN == DP_PORT
 127   1          #if DPTX_HDCP_ENC_MODE != NO_HDCP
 128   1          if (ucOpt & HDCP1X)
 129   1          {
 130   2             // BKF5_8D_REG =0X40;//只是握手不加密
 131   2              BKF5_9F_REG  = 0XFF;
 132   2              BKF5_9B_REG &= BIT6_0;//[6]1'b0:hardware control aux when hdcp1x enable
 133   2              BKF5_9B_REG &= BIT1_0;//[1]rgd_dptx_hdcp22_auto_en: 0-dis
 134   2              BKF5_8C_REG |= BIT0_1;//[0]rgd_dp_hdcp_en: 1-en
 135   2              printLT(PRINT_PRIO_TEST, "\nDptx hdcp1x en");
 136   2          }
 137   1          else if (ucOpt & HDCP2X)
 138   1          {
 139   2              #if ((DPTX_HDCP_STATE_CHECK == ENABLED) || (CHIP_VERSION_SEL > U1_VERSION))
 140   2              BKF5_A6_REG |= BIT5_1;
 141   2              BKF5_A6_REG |= BIT4_1;//hdcp 1.3 clear HPD_irq state
 142   2              BKE9_8B_REG &= BIT2_0;//rst hdcp22
 143   2              Ocm_Delay1ms(1);
 144   2              BKF5_A6_REG &= BIT5_0;
 145   2              BKF5_A6_REG &= BIT4_0;
 146   2              BKE9_8B_REG |= BIT2_1;
 147   2      
 148   2              #if (CHIP_VERSION_SEL > U1_VERSION)
 149   2              BKF5_A6_REG |= BIT3_1;
 150   2              BKF5_A6_REG &= BIT3_0;//hpd_irq_status_rd_done_clr
 151   2              #endif
 152   2              
 153   2              #endif
 154   2              
 155   2              BKF5_9B_REG &= BIT6_0;//[6]1'b0:hardware control aux when hdcp2x enable
 156   2              BKF5_9B_REG |= BIT1_1;//[1]rgd_dptx_hdcp22_auto_en: 1-en
 157   2              BKF5_8C_REG |= BIT0_1;//[0]rgd_dp_hdcp_en: 1-en
 158   2              printLT(PRINT_PRIO_TEST, "\nDptx hdcp2x en");
 159   2          }
 160   1          else//disable all
 161   1          {
 162   2      
 163   2              BKE9_85_REG |= BIT5_1;
 164   2              BKE9_85_REG &= BIT5_0;//[5]rgd_h2_dptx_enc_dis
 165   2              BKF5_8D_REG |=BIT6_1;
 166   2              Ocm_Delay1ms(20);//important
 167   2              BKF5_8C_REG &= BIT0_0;//[0]rgd_dp_hdcp_en: 0-dis
 168   2              BKF5_8D_REG &=BIT6_0;
 169   2              
 170   2              BKF5_9B_REG &= BIT1_0;//[1]rgd_dptx_hdcp22_auto_en: 0-dis
 171   2              BKF5_9B_REG |= BIT6_1;//[6]1'b1:release to dp tx control aux when hdcp disable
 172   2      
 173   2              #if DPTX_HDCP_STATE_CHECK == ENABLED
                      BKF5_89_REG &= BIT5_0;//
                      BKF5_89_REG |= BIT5_1;//hdcp13 rst
                      #endif
 177   2              printLT(PRINT_PRIO_TEST, "\nDptx hdcp Disable");
C51 COMPILER V9.53.0.0   DRVHDCPTX                                                         02/13/2025 10:14:18 PAGE 4   

 178   2          }
 179   1          #else
                  ucOpt = NO_HDCP;
                  #endif
 182   1          #endif
 183   1      
 184   1          #if TX_PORT_SIGN == HDMI_PORT
                  #if HDMITX_HDCP_ENC_MODE != NO_HDCP
                  if (ucOpt & HDCP1X)
                  {
                      BKE9_D5_REG |= BIT7_1;//[7]tx_hdcp14_en: 1-en
                      BKE9_CA_REG |= BIT4_1;//[4]tx_hdcp14_soft_en: 1-en
                      BKE9_E2_REG &= BIT5_0;//[5]tx_ver_jud_en: 0-dis
                      printLT(PRINT_PRIO_TEST, "\nHdmi tx hdcp1x en");
                  }
                  else if (ucOpt & HDCP2X)
                  {
                      BKE9_DD_REG &= 0xfc;//
              
                      BKE9_07_REG |= BIT7_1;//[7]tx_hdcp22_en: 1-en
                      BKE9_E2_REG |= BIT5_1;//[5]tx_ver_jud_en: 1-en
                      printLT(PRINT_PRIO_TEST, "\nHdmi tx hdcp2x en");
                  }
                  else//disable all
                  {
                      BKE9_07_REG &= BIT7_0;//[7]tx_hdcp22_en: 0-dis
                      BKE9_D5_REG &= BIT7_0;//[7]tx_hdcp14_en: 0-dis
                      BKE9_E2_REG &= BIT5_0;//[5]tx_ver_jud_en: 0-dis
                      BKE9_CA_REG &= BIT4_0;//[4]tx_hdcp14_soft_en: 0-dis
                  }
                  #else
                  ucOpt = NO_HDCP;
                  #endif
                  #endif
 212   1      
 213   1          #if TX_PORT_SIGN == LVDS_PORT
                  ucOpt = NO_HDCP;
                  #endif
 216   1          #if TX_PORT_SIGN == MIPI_PORT
                  ucOpt = NO_HDCP;
                  #endif
 219   1      }
