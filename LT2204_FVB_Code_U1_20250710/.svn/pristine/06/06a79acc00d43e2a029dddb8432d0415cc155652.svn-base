#include "include.h"

#if RX_PORT_SIGN == HDMI_PORT

#if HDMIRX_MAX_FRL_RATE != FRL_NOT_SPT

u8 code szHdmiRxEqConfig[HDMIRX_MAX_FRL_RATE][6] = {
#if HDMIRX_MAX_FRL_RATE >= FRL_3G3LANE
{0x22, 0x22, 0x22, 0x22, 0x23, 0x80},
#endif
#if HDMIRX_MAX_FRL_RATE >= FRL_6G3LANE
{0x44, 0x44, 0x48, 0x48, 0x62, 0x80},
#endif
#if HDMIRX_MAX_FRL_RATE >= FRL_6G4LANE
{0x44, 0x44, 0x48, 0x48, 0x62, 0x80},
#endif
#if HDMIRX_MAX_FRL_RATE >= FRL_8G4LANE
{0x56, 0x56, 0x8c, 0x8c, 0xff, 0xcb},
#endif
#if HDMIRX_MAX_FRL_RATE >= FRL_10G4LANE
//{0x68, 0x68, 0xcc, 0xcf, 0xff, 0x8e},//old
//{0x68, 0x68, 0x8c, 0x8f, 0xff, 0x8e},//updata1
//{0x68, 0x68, 0x8a, 0x8c, 0xcc, 0x8e},//updata2-pass
//{0x68, 0x68, 0xcc, 0xcf, 0xff, 0x8e},//old
//{0x68, 0x68, 0x8c, 0x8f, 0xff, 0x8e},//updata1
//{0x68, 0x68, 0x8a, 0x8c, 0xcc, 0x8e},//updata2-pass
//{0x68, 0x68, 0x8c, 0xaf, 0xcc, 0xfe},//updata2-pass20231026
{0x58, 0x58, 0x8a, 0x8c, 0xcc, 0xfe},//20231018-phy-pass
//{0x68, 0x68, 0x8a, 0x8c, 0xff, 0x8e},//updata3
#endif
#if HDMIRX_MAX_FRL_RATE >= FRL_12G4LANE
{0x6f, 0x6f, 0xcf, 0xcf, 0xff, 0xfe},
#endif
};

void Drv_HdmiRx_Frl_Init(void)
{
    //state init
    BKCD_48_REG &= 0x41;//[7]rgd_sw_frl_train_rst_n
                        //[5]rgd_sw_frl_dec_rst_n
                        //[4]rgd_sw_frl_start_rst_n
                        //[3]rgd_sw_fec_dec_rst_n
                        //[2]rgd_sw_frl_depkt_rst_n
                        //[1]rgd_sw_glb_rst_n
    BKCD_48_REG |= 0xbe;

    BKCD_00_REG |= BIT0_1;//[0]hdmi sink version en
//    BKCD_02_REG |= BIT0_1;//[0]hdmi 21 rx flt_ready en
    BKCD_02_REG |= BIT7_1;//[7]hdmi 21 rx frl rate triggle sel: 1-source write opreation, 0-frl rate change;
    BKCD_03_REG = 0x00;//0x20;no time out   0x00 max 200ms
    
    BKCD_06_REG = 0x56;//[7:4]Ln(0)_LTP_req set, [3:0]Ln(1)_LTP_req set
    BKCD_07_REG = 0x78;//[7:4]Ln(2)_LTP_req set, [3:0]Ln(3)_LTP_req set

    BKCD_08_REG |= BIT7_1;//[7]hdmi 21 rx fec hardware reset sel: 0-not support
    BKCD_08_REG |= BIT6_1;//[7]HDMI 21 RX gap error enable during P
    BKCD_08_REG &= BIT5_0;//[5]rgd_frl_start_trigel: 0:Meet protocol
    BKCD_08_REG |= BIT0_1;//[0]hdmi 21 rx ffe level change sel, 1-user define

    BKCD_09_REG = 0x00;//[6:4][2:0]hdmi 21 rx lane0/lane1 ffe level set by software.
    BKCD_0A_REG = 0x00;//[6:4][2:0]hdmi 21 rx lane2/lane3 ffe level set by software.

    #if SYSCLK == SYS_CLK_40M
    BKCD_0B_REG = 0x9c;
    BKCD_0C_REG = 0x40;
    #elif SYSCLK == SYS_CLK_48M
    BKCD_0B_REG = 0xbb;
    BKCD_0C_REG = 0x80;//rgd_time_1s_per: 1s timer cnt of a cycle
    #endif
    BKCD_0D_REG = 0x03;//[7:0]hdmi21 rx 1s timer cnt for fec err statistics[15:8]-1000
    BKCD_0E_REG = 0xe8;//[7:0]hdmi21 rx 1s timer cnt for fec err statistics[07:0]

    BKCD_0F_REG = 0x1b;//[7:6]hdmi 21 rx lane0 input channel data select
                       //[5:4]hdmi 21 rx lane1 input channel data select
                       //[3:2]hdmi 21 rx lane2 input channel data select
                       //[1:0]hdmi 21 rx lane3 input channel data select//1b-for FPGA TR5, 36-for FPGA vu9p

    BKCD_16_REG |= BIT0_1;//[0]rgd_eq_mod_sel: 1-sw en(16/18b err clr sw en, eq pass sw en)

    BKCD_52_REG |= BIT4_1;//[4]hdmi 21 rx lane deskew bypasss during LTS:3 period.
    BKCD_5A_REG &= 0x3f;//[7:6]hdmi 21 rx key code stable mode sel: 0-

    BKCD_62_REG = 0xff;//[7:0]hdmi 21 rx tmds timing error singal width
    BKCD_63_REG &= BIT3_0;//[3]hdmi 21 rx detect tmds vactive width enable: 0-dis
    BKCD_F0_REG &= 0xf9;//[2]HDMI 21 RX tmds hactive check dis, [1]hdmi 21 rx tmds vactive check dis
    BKCD_F8_REG = 0x40;//[6:0]hdmi 21 rx write setp byte of rc.

    //hdmi2.1 rx int en
    BKCD_A6_REG |= 0x51;//[6]hdmi 21 rx eq check en int enable
                        //[4]hdmi 21 rx source flt int enable
                        //[0]hdmi 21 rx rate change int enable.
    BKCD_57_REG |= 0x51;//interrupt clr en
    BKCD_57_REG &= 0xae;//interrupt clr dis
    BKCE_80_REG |= 0x44;//[6]hdmi21 rx src write frl start int en
                        //[2]rgd_eq_scan_done_int_en
    BKCE_80_REG |= 0x88;//interrupt clr en
    BKCE_80_REG &= 0x77;//interrupt clr dis
    BKCE_81_REG |= BIT6_1;//rgd_source_rd_ptn_int_en
    BKCE_81_REG |= BIT7_1;//[7]rgd_source_rd_ptn_int_clr: 1-rst en
    BKCE_81_REG &= BIT7_0;//[7]rgd_source_rd_ptn_int_clr: 0-rst dis
    BKCE_C5_REG |= BIT7_1;//ptn flag clr
    BKCE_C5_REG &= BIT7_0;//ptn flag clr
    BKCE_C5_REG |= BIT6_1;//start flag clr
    BKCE_C5_REG &= BIT6_0;//start flag clr
    //new design
    BKCC_00_REG |= BIT2_1;//[2]rgd_h21rx_frc_hdmi_mode: 1-hdmi21 force hdmi_mode=1,
    BKCC_03_REG |= BIT7_1;//[7]frl ready

    BKCE_81_REG &= BIT2_0;//[2]0-new error cnt statistics mode, 1-LT1901 error cnt statistics mode
    BKCE_C8_REG |= BIT7_1;//[7]rgd_frl_rate_chg_sel: 1-real_time update
    BKCE_C8_REG |= BIT6_1;//[6]rgd_eq_check_en_clr: 1-en
}

void Drv_HdmiRx_Frl_PcrInit(void)
{
    BKC7_D7_REG |= BIT0_1;//[0]rgd_rx_da_src_sel: 1-hdmi

    BKA3_20_REG &= BIT4_0;//[4]rg_pcrpll_pd: 0-normal work
    BKA3_20_REG &= 0xfc;//[1:0]rg_pcrpll_ref_sel: 00-Xtal_25m_clk
    BKE2_3D_REG = 0x20;// ks =2;
    
    BKE2_3D_REG &= BIT3_0;
    BKE2_3D_REG |= BIT3_1;//pcrpll_cal_en

    BKCD_80_REG = 0x0f;//rgd_tmds_pcr_freq_pixel_change
    BKCD_9C_REG &= 0x1f;//[7:5]rgd_tmds_pcr_line_cnt_sel:
    BKCD_9C_REG |= 0x60;//0x20-every  64 active line(001)
                        //0x40-every 128 active line(010)
                        //0x60-every 256 active line(011)
    BKCB_B4_REG = 0x01;//pcr mode sel,ps5 will have issue
    BKCD_A2_REG = 0xc0;//[7:4]kp sel
    BKCD_A0_REG = 0x94;//lw limit
    BKCD_A1_REG = 0xe2;//up limit
    BKCD_A3_REG = 0x14;//load lw limit
    BKCD_A4_REG = 0xe2;//load up limit

    BKCB_9B_REG = 0x01;
    BKCB_9C_REG = 0x01;
    BKCB_9F_REG = 0x01;
    BKCB_A0_REG = 0x01;

    BKCB_D5_REG = 0x00;//da_pcrpll_rst_n end set.

    BKC8_B0_REG = 0x20;//gd_pcr_stb_chk_sel
    #if SYSCLK == SYS_CLK_40M
    BKC8_B1_REG = 0x28;//rgd_sys_cnt_1us[6:0]
    #endif
    #if SYSCLK == SYS_CLK_48M
    BKC8_B1_REG = 0x30;//rgd_sys_cnt_1us[6:0]
    #endif
    BKC8_B2_REG = 0x0f;//rgd_pcr_stb_chk1_cnt
    BKC8_B3_REG = 0x0f;//rgd_pcr_stb_chk2_cnt
    Drv_HdmiRx_Reset(HDMI_PCR_RST);
}

void Drv_HdmiRx_Frl_SecPcrInit(void)
{
    BKCE_00_REG = 0x0f;//rgd_dsc_pcr_freq_pixel_change[15:8]
    BKCE_28_REG |=0x60;//0x20-every  64 active line(001)
                       //0x40-every 128 active line(010)
                       //0x60-every 256 active line(011)
    BKCE_4C_REG = 0x80; //step 2: tmds de
    BKCE_4A_REG = 0xcc; //0xcc: level 2/3 mute
    BKCE_4D_REG = 0x02; //rgd_dsc pcr de dly set[11:8]
    BKCE_4E_REG = 0x00; //rgd_dsc pcr de dly set[7:0]
 
    BKCE_35_REG = 0xa0;//rgd_dsc_pcr_step_out
    BKCE_4F_REG = 0x00;//secpcrpll_rst_end

    BKCE_2C_REG = 0x94; //lw limit
    BKCE_2D_REG = 0xe2; //up limit
    BKCE_2F_REG = 0x14; //load lw limit
    BKCE_30_REG = 0xe2; //load up limit
    
    BKCE_32_REG = 0x7b; //step 3: tmds de
    BKCE_49_REG = 0x03; 
    BKCB_CE_REG = 0x41;
    BKCB_C3_REG = 0x08;  
    
    BKCB_CD_REG = 0x10; //tmds hfp set[7:0]
    BKCB_D0_REG = 0x10; //tmds hs set[7:0]

    BKCE_2E_REG = 0xc0; //refer 0xcda2

    BKE2_50_REG |= BIT3_1;//secpcrpll cal en
    BKE2_50_REG &= 0xcf;
    BKE2_50_REG |= 0x20;//[5:4]ks = 2
}

void Drv_HdmiRx_Frl_PhyCtleSet(u8 ucFrlRate)
{
    BKA1_02_REG = szHdmiRxEqConfig[ucFrlRate - 1][0];//[7:4]rg_dhrx_eq0 is; [3:0]rg_dhrx_eq0 rl;
    BKA1_03_REG = szHdmiRxEqConfig[ucFrlRate - 1][1];//[7:4]rg_dhrx_eq1 is; [3:0]rg_dhrx_eq1 rl;

    BKA1_04_REG = szHdmiRxEqConfig[ucFrlRate - 1][2];//[7:4]rg_dhrx_bf0 is; [3:0]rg_dhrx_bf0 rl;
    BKA1_05_REG = szHdmiRxEqConfig[ucFrlRate - 1][3];//[7:4]rg_dhrx_bf1 is; [3:0]rg_dhrx_bf1 rl;

    BKA1_06_REG = szHdmiRxEqConfig[ucFrlRate - 1][4];//[7:4]rg_dhrx_fb0 is; [3:0]rg_dhrx_fb1is;
    BKA1_07_REG = szHdmiRxEqConfig[ucFrlRate - 1][5];//[7:4]rg_dhrx_eq  cs; [3:2]rg_dgrx_fb rs; [1]rg_dhrx_nrb_en; [0]rg_dhrx_nr_en;

    BKA1_08_REG = 0x09;//[7]rg_dhrx_ldo_en: 0-disable, eq power use external vcc11_dhrx;
                       //[6:4]rg_dhrx_ldo_vset: 000-1.1v
                       //[3]rg_dhrx_en: 0-dis, 1-en;
                       //[2:0]rg_dhrx_vcm_adj: 011-0.75v
                       //0X0B==>>0X09

    BKA3_7C_REG = 0x8a;//ECO
    BKA1_09_REG |= 0xf0;//[7:4]rg_dhrx_d0(d0~d3)_hseq_en

    BKA1_0E_REG &= 0xf3;//[7:4]rg_dhrx_d0(d0~d3)bf2cdr_en; [3:2]2'b00 = Stronger DFE; [1:0]rg_dhrx_bf2cdr_fbis;
}

void Drv_HdmiRx_Frl_CdrSet(u8 ucFrlRate)
{
    switch(ucFrlRate)
    {
        case FRL_3G3LANE:
            BKC8_11_REG &= BIT0_0;//[0]rgd_cdr_ord_sel: 0-first, 1-second;
            BKC8_12_REG = 0x37;//[6:4]rgd_cdr_frug_sel; [3:0]rgd_cdr_phug_sel;
            break;
        case FRL_6G3LANE:
            BKC8_11_REG &= BIT0_0;//[0]rgd_cdr_ord_sel: 0-first, 1-second;
            BKC8_12_REG = 0x37;//[6:4]rgd_cdr_frug_sel; [3:0]rgd_cdr_phug_sel;
            break;
        case FRL_6G4LANE:
            BKC8_11_REG &= BIT0_0;//[0]rgd_cdr_ord_sel: 0-first, 1-second;
            BKC8_12_REG = 0x37;//[6:4]rgd_cdr_frug_sel; [3:0]rgd_cdr_phug_sel;
            break;
        case FRL_8G4LANE:
            BKC8_11_REG &= BIT0_0;//[0]rgd_cdr_ord_sel: 0-first, 1-second;
            BKC8_12_REG = 0x37;//[6:4]rgd_cdr_frug_sel; [3:0]rgd_cdr_phug_sel;
            break;
        case FRL_10G4LANE:
            BKC8_11_REG &= BIT0_0;//[0]rgd_cdr_ord_sel: 0-first, 1-second;
            BKC8_12_REG = 0x37;//[6:4]rgd_cdr_frug_sel; [3:0]rgd_cdr_phug_sel;
            break;
        case FRL_12G4LANE:
            BKC8_11_REG &= BIT0_0;//[0]rgd_cdr_ord_sel: 0-first, 1-second;
            BKC8_12_REG = 0x37;//[6:4]rgd_cdr_frug_sel; [3:0]rgd_cdr_phug_sel;
            break;
        default:
            break;
    }
}

void Drv_HdmiRx_Frl_PiSet(u8 ucFrlRate)
{
    switch(ucFrlRate)
    {
        case FRL_3G3LANE:
        case FRL_6G3LANE:
        case FRL_6G4LANE:
        case FRL_8G4LANE:
            BKA1_26_REG = 0x13;
            BKA1_27_REG = 0x13;
            BKA1_28_REG = 0x03;
            break;
        case FRL_10G4LANE:
        case FRL_12G4LANE:
            BKA1_26_REG = 0x8f;//[7]rgd_sw_en_dhrxpi_mix_cap_sel: 1-en
                               //[5:4]rgd_sw_dhrxpi_mix_cap_sel
                               //[3]rgd_sw_en_dhrxpi_mix_rd_sel: 1-en
                               //[2:0]rgd_sw_dhrxpi_mix_rd_sel
            BKA1_27_REG = 0x8f;//[7]rgd_sw_en_dhrxpi_mux_cap_sel: 1-en
                               //[5:4]rgd_sw_dhrxpi_mux_cap_sel
                               //[3]rgd_sw_en_dhrxpi_mux_rd_sel: 1-en
                               //[2:0]rgd_sw_dhrxpi_mux_rd_se
            BKA1_28_REG = 0x17;//[7]rgd_sw_en_dhrxpi_buf_cap_sel: 1-en
                               //[5:4]rgd_sw_dhrxpi_buf_cap_sel
                               //[3]rgd_sw_en_dhrxpi_buf_rd_sel: 1-en
                               //[2:0]rgd_sw_dhrxpi_buf_rd_se
            break;
    }
}

void Drv_HdmiRx_Frl_PllCali(void)
{
    u8 ucCnt;
    u8 ucloop_rxpll_cal;
    BKA1_30_REG &= 0xfc;//bit7 pll power on [1:0]rg_dhrxpll_ref_sel: 00-xtal_25m_clk or xtal_50m_clk
    BKA1_33_REG = 0x60;//rxpll prediv = 1
    BKA1_3E_REG = 0X60;//rxpll fb div = 1;
    BKA1_35_REG |=BIT7_1;//hdmi mode must set 
    BKA1_42_REG = 0x80; //rxpll freqset  = 0
    BKA1_44_REG = 0x80;// not analogic cdr mode
    
    BKE3_00_REG |= BIT1_1;//[1]rgd_dhrxpll_cal_pll_cal_en_auto_en: 1-calibrate multiple frequenc
    BKE3_09_REG |= BIT3_1;// sel hdmi2.1 mode  00 hdmi2.0 01 XX 10 hdmi2.1  11 dp mode

    BKE3_0A_REG &= 0xcf;//[5:4]rgd_dhrxpll_cal_frl_set_mode_sel: 00-auto ctrl mode
    BKE3_0B_REG &= BIT0_0;//[0]rgd_dhrxpll_cal_pll_band_sw_en: 0-dis
    
    for(ucloop_rxpll_cal = 0;ucloop_rxpll_cal < 2;ucloop_rxpll_cal++)
    {
        (ucloop_rxpll_cal == 0)?(BKA1_31_REG &= BIT7_0):(BKA1_31_REG |= BIT7_1);//vco in high freq
        ucCnt = 3;
        while(ucCnt--)
        {
            BKE1_05_REG &= 0xfc;//[0]rgd_sw_dhrxpll_cal_rst_n: 0-en
            BKA1_30_REG &= BIT6_0;//[6]rg_dhrxpll_rst_n: 0-en
            BKE3_00_REG &= BIT0_0;//[0]rgd_dhrxpll_cal_pll_cal_en: 0-dis
            Ocm_Delay1ms(1);
            BKE1_05_REG |= 0x03;//[0]rgd_sw_dhrxpll_cal_rst_n: 1-dis
            BKA1_30_REG |= BIT6_1;//[6]rg_dhrxpll_rst_n: 1-dis
            BKE3_00_REG |= BIT0_1;//[0]rgd_dhrxpll_cal_pll_cal_en: 1-en
            Ocm_Delay1ms(2);
            if((BKE3_1A_REG < 0xff)&&(BKE3_1B_REG == 0xff)&&((BKE3_24_REG&0x03) == 0x03))
            {
                break;
            }
            if((BKE3_24_REG&0x03) == 0x02) //[1]rgod_dhrxpll_pll_cal_done: 1-done
            {
                break;
            }
        }
        if(ucloop_rxpll_cal == 0)
        {
            BKE3_0D_REG = BKE3_18_REG;//dhrxpll hd03 band
            BKE3_0E_REG = BKE3_19_REG;//dhrxpll hd06 band
            BKE3_0F_REG = BKE3_1A_REG;//dhrxpll hd08 band
        }
        else if(ucloop_rxpll_cal == 1)
        {
            BKE3_10_REG = BKE3_1B_REG;//dhrxpll hd10 band
            BKE3_11_REG = BKE3_1C_REG;//dhrxpll hd12 band
        }
    }
    printLT(PRINT_PRIO_TEST, "\nFrl rxpll cali band= %02bx,%02bx,%02bx,%02bx,%02bx",
                        BKE3_0D_REG, BKE3_0E_REG, BKE3_0F_REG, BKE3_10_REG, BKE3_11_REG);
    BKA1_31_REG &= BIT7_0;
    BKE3_00_REG &= BIT1_0;//[1]rgd_dhrxpll_cal_pll_cal_en_auto_en: 0-calibrate a single frequency
}

void Drv_HdmiRx_Frl_PllBandSet(u8 frlrate)
{
    BKA1_31_REG &= 0xe0;
    BKA1_31_REG |= 0x08;//[4:0]rg_dhrxpll_cpcur_sel
    (frlrate <= FRL_8G4LANE)?(BKA1_31_REG &= BIT7_0):(BKA1_31_REG |= BIT7_1);//vco in high freq
    BKA1_33_REG = 0x60;//rxpll prediv = 1
    BKA1_36_REG = 0x33;//[6:4]rg_dhrxpll_lpf_cinset
    BKA1_3E_REG = 0X60;//rxpll fb div = 1;
    BKA1_35_REG |=BIT7_1;//hdmi mode must set 
    BKA1_42_REG = 0x80; //frl mode freq_set = 0
    BKA1_43_REG = 0x00;
    
    BKE3_00_REG &= BIT0_0;//[0]rgd_dhrxpll_cal_pll_cal_en: 0-dis
    BKE3_0A_REG |= BIT4_1;//[5:4]rgd_dhrxpll_cal_frl_set_mode_sel: 01-hdmi2.1 rx control
    BKE3_0B_REG |= BIT0_1;//[0]rgd_dhrxpll_cal_pll_band_sw_en: 1-en

    BKA1_30_REG &= BIT6_0;//[6]rg_dhrxpll_rst_n: 0-en
    BKA1_30_REG |= BIT6_1;//[6]rg_dhrxpll_rst_n: 1-dis
}

u8 Drv_HdmiRx_DeSkewCheck(void)
{
    u8 ucLane;
    ucLane = BKCD_B5_REG & 0x0f;//[3:0]rgod_frl_rate: 1-3g3lane, 2-6g3lane, other-4lane
    if (ucLane <= 2)//3lane
    {
        if (BKCD_B6_REG & 0x07)//[3:0]rgod_ln3(lan3~lan0)_locked: 1-lock
        {
            return SUCCESS;
        }
    }
    else//4lane
    {
        if (BKCD_B6_REG & 0x0f)//[3:0]rgod_ln3(lan3~lan0)_locked: 1-lock
        {
            return SUCCESS;
        }
    }
    return FAIL;
}

u8 Drv_HdmiRx_LinkVidTimingChk(void)
{
    u16 ucTempHactive,ucTempVactive;
    ucTempHactive = ((u16)BKCD_DB_REG << 8) + BKCD_DC_REG;
    ucTempVactive = ((u16)BKCD_DF_REG << 8) + BKCD_E0_REG;
    if((ucTempHactive <= 0x00ff)||(ucTempHactive == 0xffff))
    {
        return FAIL;
    }
    if((ucTempVactive <= 0x00ff)||(ucTempVactive == 0xffff))
    {
        return FAIL;
    }
    Ocm_Delay1ms(2);
    if((BKCD_DB_REG != ((ucTempHactive>>8)&0xff))||(BKCD_DC_REG != (ucTempHactive&0xff)))
    {
        return FAIL;
    }
    if((BKCD_DF_REG != ((ucTempVactive>>8)&0xff))||(BKCD_E0_REG != (ucTempVactive&0xff)))
    {
        return FAIL;
    }
    printLT(PRINT_PRIO_TEST, "\nThe hdmirx timing is 0x%04x,0x%04x", ucTempHactive,ucTempVactive);
    return SUCCESS;
}

void Drv_HdmiRx_Frl_ErrClr(void)
{
    BKCD_16_REG |= BIT2_1;//[2]rgd_err_clr_soft: 1-en
    BKCD_16_REG &= BIT2_0;//[2]rgd_err_clr_soft: 0-dis
}

void Drv_HdmiRx_Frl_FecErrClr(void)
{
    BKCD_16_REG |= BIT6_1;//[2]rgd_err_clr_soft: 1-en
    BKCD_16_REG &= BIT6_0;//[2]rgd_err_clr_soft: 0-dis
}
#endif

void Drv_HdmiRx_PowerDown(void)
{
    ;
}

void Drv_HdmiRx_SecPcrPower(u8 ucOpt)
{
    if (ucOpt == ON)
    {
        BKA3_2F_REG &= BIT4_0;//[4]rg_secpcrpll_pd: 0-normal work
    }
    else
    {
        BKA3_2F_REG |= BIT4_1;//[4]rg_secpcrpll_pd: 1-power down
    }
}

void Drv_HdmiRx_PllInit(void)
{
    BKA1_30_REG = 0x69;//[7]rg_dhrxpll_pd = 0: normal work. 
                       //[6]rg_dhrxpll_rst_n = 1: nowmal work.
                       //[5]rg_dhrxpll_vcodiv_rstn = 1: normal.
                       //[3]rg_dhrxpll_ibias_en: 1-en
                       //[2]rg_dhrxpll_dp_lpen = 0: hdmi mode.
                       //[1:0]rg_dhrxpll_ref_sel = 01: aa_dhrx_tmds_clk.
    BKA1_37_REG |= 0x0d;//[3]rg_dhrxpll_pix_muxsel: 1-from deep color
                        //[1:0]rg_dhrxpll_halfpix_divsel: 01-div2
    BKE3_01_REG = 0x20; //ks = 2;
}

void Drv_HdmiRx_RtermCali(void)
{
    u8 ucIndex;
    u8 ucResult = FAIL;
    
    BKA1_08_REG |= BIT3_1;//[3]rg_dhrx_en: 0-dis, 1-en;
    #if CHIP_VERSION_SEL > U1_VERSION
    BKA1_1D_REG &= BIT7_0;//[7]clk pkdet soft mode: 0-dis
    #endif
    ucIndex = 10;
    while(ucIndex--)
    {
        BKE2_00_REG &= BIT0_0;//[0]rgd_dhrx_rterm_cali_en, 0-dis
        Ocm_Delay1ms(1);
        BKE2_00_REG |= BIT0_1;//[0]rgd_dhrx_rterm_cali_en, 1-en
        Ocm_Delay1ms(2);

        if(0x02 == (BKE2_07_REG & 0x03))//[1]rgod_dhrx_rterm_cali_done: 1-done; [0]rgod_dhrx_rterm_cali_fail: 1-fail
        {
            ucResult = SUCCESS;
            break;
        }
    }

    printLT(PRINT_PRIO_HIG, "\nHdmi rx rterm cali value is 0x%02bx", BKE2_08_REG);
    if(ucResult == SUCCESS)//Rterm calibration done
    {
        printLT(PRINT_PRIO_HIG, "\nCali success");
    }
    else
    {
        printLT(PRINT_PRIO_HIG, "\nCali failed");
    }
}

void Drv_HdmiRx_PhyInit(void)
{
    BKA1_08_REG = 0x0a;//[7]rg_dhrx_ldo_en: 0-disable, eq power use external vcc11_dhrx;
                       //[6:4]rg_dhrx_ldo_vset: 000-1.1v
                       //[3]rg_dhrx_en: 0-dis, 1-en;
                       //[2:0]rg_dhrx_vcm_adj: 011-0.75v
    BKA1_0D_REG = 0xa8;//[7:6]rg_dhrx_temp_sense_vset; 
                       //[5]rg_dhrx_temp_sense_en
                       //[4]rg_dhrx_eqrg_sel: 0-small range, 1-large range for 121 mode only
                       //[3]rg_dhrx_mxchsel: do not touch this bit, default is 1
                       //[2]rg_dhrx_refclk_sel: 0-sel from eq path, 1-sel from dhrxpll
                       //[1]rg_dhrx_linkclk_sel: 0-sel from dhrx, 1-sel from dhrxpll
                       //[0]rg_dhrx_linkclk_div2_en: 0-use from normal half-rate mode, 1-use for new full-rate mede;
}

void Drv_HdmiRx_PiEnable(u8 ucOpt)
{
    if (ON == ucOpt)
    {
        BKA1_1F_REG = 0x10;//[4]rg_dhrxpi_bias_en: 1-en
                           //[3:0]rg_dhrxpi_pd: 4'b0000 = four channel normal
    }
    else
    {
        BKA1_1F_REG = 0x0f;//[4]rg_dhrxpi_bias_en: 0-dis;
                           //[3:0]rg_dhrxpi_pd: 4'b1111 = four channel power down.
    }
}

//========================================================================
// Func Name   : Drv_HdmiRX_ChannelSwap
// Description : dhrx logical data channel select phy channel.
//  connect(tmds/frl)    phy channel      logical channel
//            D2/D2------D3---------------D2
//            D1/D1------D2---------------D1
//            D0/D0------D1---------------D0
//           CLK/D3------D0---------------D3
// Input       : void  
// Output      : None
// Return      : void
//========================================================================
void Drv_HdmiRx_ChannelSwap(void)
{
    #if CHIP_SEL == LT7911UXE_HD
	  
    #else
    BKC7_E6_REG |= 0xf0;// pn swap 
	  #endif
    
    BKC7_E6_REG &= BIT0_0;//eq mode sel hdmi rx
    BKC7_E7_REG = 0x12; //[7:4]dhrx logical channel data 0 source select, 1-chl1;
                        //[3:0]dhrx logical channel data 1 source select, 2-chl2;
    BKC7_E8_REG = 0x30; //[7:4]dhrx logical channel data 2 source select, 3-chl3;
                        //[3:0]dhrx logical channel data 3 source select, 0-chl0;
}

void Drv_HdmiRx_DdcVthSet(void)
{
    BKA3_5B_REG |= BIT1_1;//rg_dhrx_ddc_vth_sel: 1-high vth mode
}

//========================================================================
// Func Name   : Drv_HdmiRx_ReadReqInit
// Description : Read request 1s timer set
// Input       : void  
// Output      : None
// Return      : void
//========================================================================
void Drv_HdmiRx_ReadReqInit(void)
{
    #if SYSCLK == SYS_CLK_40M
    BKCC_63_REG = 0x28;
    BKCC_FC_REG = 0xe5;
    #endif

    #if SYSCLK == SYS_CLK_48M
    BKCC_63_REG = 0x30;
    BKCC_FC_REG = 0xe5;
    #endif 
}

void Drv_HdmiRx_ErrorDetSet(void)
{
    BKCC_19_REG = 0x60;
    #if SYSCLK == SYS_CLK_40M
    BKCC_2A_REG = 0x09;//
    BKCC_2B_REG = 0xc4;//
    #endif

    #if SYSCLK == SYS_CLK_48M
    BKCC_2A_REG = 0x0b;//
    BKCC_2B_REG = 0xb8;//
    #endif  
}

void Drv_HdmiRx_Pkdetset(void)
{
    BKE6_EE_REG = 0x10;// sel rx1 for design issue
    BKE6_EE_REG |= BIT6_1;// pk det enable
}

void Drv_HdmiRx_HwResetSet(void)
{
    BKE1_0C_REG &= BIT4_0; //disable rx hard reset
    BKE1_0C_REG &= BIT5_0; //disable rxpll cal hard reset
    BKE1_0D_REG &= BIT7_0; //disable cdr hw rst.
    BKE1_0D_REG &= BIT5_0; //disable pi hard reset
    
    BKE1_0E_REG &= BIT7_0;//[7]rg_audpll_hw_rst_en: 0-dis
    BKE1_0E_REG &= BIT6_0; //pcrpll0_hw_reset = 0;
    BKE1_0E_REG &= BIT5_0; //pcrpll1 hw reset = 0;
}

//========================================================================
// Func Name   : Drv_HdmiRx_PowerOnInit
// Description : The setting init for power on
//             : Be called only one time at power on.
// Input       : void  
// Output      : None
// Return      : void
//========================================================================
void Drv_HdmiRx_PowerOnInit(void)
{
    Drv_HdmiRx_PowerDown();
    Drv_HdmiRx_DdcVthSet();
    Drv_HdmiRx_ErrorDetSet();
    Drv_HdmiRx_ReadReqInit();
    Drv_HdmiRx_PllInit();
    Drv_HdmiRx_RtermCali();
    Drv_HdmiRx_PhyInit();
    Drv_HdmiRx_PiEnable(ON);
    Drv_HdmiRx_ChannelSwap();
    Drv_HdmiRx_HwResetSet();
    Drv_System_PktHeadSet(HDR_INFO_FRAME_0X87);
    #if HDMIRX_MAX_FRL_RATE != FRL_NOT_SPT
    Drv_HdmiRx_Frl_PllCali();
    #endif
    Drv_HdmiRx_Pkdetset();
    Mod_HdmiRxEq_Init();
    #if ((HDMIRX_DSC_DEC_SUPPORT == ENABLED) || (HDMIRX_DSC_BYPASS_SUPPORT == ENABLED))
    Drv_HdmiRx_SecPcrPower(ON);
    #endif
}

void Drv_HdmiRx_Reset(EnumHdmiRstType ucOpt)
{
    switch(ucOpt)
    {
        case HDMI_PCR_RST:
            BKCD_48_REG &= BIT0_0;//[0]pcr reset en
            BKCD_48_REG |= BIT0_1;//[0]pcr reset dis
            break;
        case HDMI_ERR_DET_RST:
            BKCD_48_REG &= BIT6_0;//[6]hdmi 21 rx error detect rst_n en
            BKCD_48_REG |= BIT6_1;//[6]hdmi 21 rx error detect rst_n dis
            break;
        case HDMI_FRL_DEC_RST:
            BKCD_48_REG &= BIT5_0;//[5]rgd_sw_frl_dec_rst_n: 0-en
            BKCD_48_REG |= BIT5_1;//[5]rgd_sw_frl_dec_rst_n: 1-dis
            break;
        case HDMI_FEC_DEC_RST:
            BKCD_48_REG &= BIT3_0;//[3]rgd_sw_fec_dec_rst_n: 1-en
            BKCD_48_REG |= BIT3_1;//[3]rgd_sw_fec_dec_rst_n: 0-dis
            break;
        case HDMI_FRL_DEPKT_RST:
            BKCD_48_REG &= BIT2_0;
            BKCD_48_REG |= BIT2_1;//[2]rgd_sw_frl_depkt_rst_n: 1-dis
            break;
        case HDMI_FRL_TRAIN_RST:
            BKCD_48_REG &= 0x81;//[5]rgd_sw_frl_dec_rst_n
                                //[4]rgd_sw_frl_start_rst_n
                                //[3]rgd_sw_fec_dec_rst_n
                                //[2]rgd_sw_frl_depkt_rst_n
                                //[1]rgd_sw_glb_rst_n
            BKCD_48_REG |= 0x7e;
            break;
        case HDMI_RX_FIFO_RST:
            BKC9_08_REG &= BIT4_0;
            BKC9_08_REG |= BIT4_1;
            break;
        case HDMI_RX_DEPKT_RST:
            BKC9_07_REG &= BIT6_0;//[6]rgd_sw_hdmi20rx_aud_rst_n: 0-en
            BKC9_07_REG |= BIT6_1;//[6]rgd_sw_hdmi20rx_aud_rst_n: 1-dis
            break;        
        
        default:
            break;
    }
}

void Drv_HdmiRx_PktClr(EnumHdmiRstType ucOpt)
{
     switch(ucOpt)
    {
        case HDMIRX_EMP_CLR:
            BKCB_19_REG |= BIT4_1;
            BKCB_19_REG &= BIT4_0;
         default:
            break;
    }
}

void Drv_HdmiRx_EdidLoad(u8 *pEDID_Data)
{
    u8 ucBlockNum;
    u16 usLoop;

    BKCC_08_REG &= BIT1_0;//[1]rgd_rx_src_rd_en: 0-i2c slvae rd en, 1-src rd en; 
    BKCC_08_REG |= BIT7_1 | BIT0_1;//[7]rgd_edid_addr_plus_en, [0]rgd_accs_edid_en: 1-en, 0-dis
    BKCC_07_REG = 0x00;//[7:0]init address value
    BKCC_08_REG &= BIT7_0;//[7]rgd_edid_addr_plus_dis
#if CHIP_SEL == LT6711GXE
    if(g_stDpEdidInfo.b1EeodbFlag)
    {
        ucBlockNum = pEDID_Data[0x86] + 1;
    }
    else
#endif
    {
        ucBlockNum = pEDID_Data[0x7e] + 1;
    }

    if (ucBlockNum > 2)
    {
        BKCC_06_REG |= BIT6_1;//[6]rgd_edid_v3_en: 1-4block;
    }
    else
    {
        BKCC_06_REG &= BIT6_0;//[6]rgd_edid_v3_en: 0-2block;
    }
    for(usLoop = 0; usLoop < ((u16)ucBlockNum << 7); usLoop++)
    {
        BKCC_94_REG = pEDID_Data[usLoop];
    }
    BKCC_08_REG |= BIT1_1;//[1]src read en
    BKCC_08_REG &= BIT0_0;//[0]rgd_accs_edid_en: 1-en, 0-dis
    #ifdef NVIDIA_FW_EN
    #if (EDID_DDC_DIS == ENABLED)
    BKCC_03_REG &= 0xe0;
    BKCC_03_REG |= 0x02;//nivia glitch;
    BKCC_03_REG |= BIT5_1|BIT6_1;
    BKCC_06_REG  = 0x02; //RGD_SDA_OUT_DLY
    BKCA_1E_REG  = 0x04;//HDCP RX DDC SDA out delay.
    #endif
    #endif
}

void Drv_HdmiRx_Tmds_CdrSet(u8 ucOpt)
{
    switch(ucOpt)
    {
        case HDMI14:
        case HDMI20:
            BKC8_11_REG &= BIT0_0;//[0]rgd_cdr_ord_sel: 0-first, 1-second;
            BKC8_12_REG = 0x37;//[6:4]rgd_cdr_frug_sel; [3:0]rgd_cdr_phug_sel;
            break;

        default:
            break;
    }
}

//========================================================================
// Func Name   : Drv_HdmiRx_PhyInit
// Description : Select which phy dig_wclk for link clock.
//            D2/D2------D3---------------D2
//            D1/D1------D2---------------D1
//            D0/D0------D1---------------D0
//           CLK/D3------D0---------------D3
// Input       : u8 ucOpt  
// Output      : None
// Return      : void
//========================================================================
void Drv_HdmiRx_PhySet(u8 ucOpt)
{
    switch(ucOpt)
    {
        case HDMI14:
        case HDMI20:
            BKA1_09_REG &= 0x0f;//[7:4]for hdmi2.1 to hdmi2.0 mode
            BKA1_0B_REG = 0x4f;//[7:4]D1 link clk enable.
                               //[3:0]D1/D2/D3 dig_clk enable.
            BKA1_0A_REG = 0xf8;//[7:4]rg_dhrx_d0(d0~d3)_pkdet_en; [3:0]rg_dhrx_d0(d0~d3)_clkdet_en: 
            BKA1_0C_REG = 0x7a;//[7]rg_dhrx_pwr_sel: 0-select from internal ldo
                               //[2:0]rg_dhrx_pkdet_sdth: 0x02
            #if CHIP_VERSION_SEL > U1_VERSION
            BKA1_1D_REG = 0x82;//[7]soft en
                               //[2:0]rg_dhrx_pkdet_sdth: 0x02
            #endif
            break;

        #if HDMIRX_MAX_FRL_RATE != FRL_NOT_SPT
        case HDMI21:
            BKA1_09_REG |= 0xf0;
            BKA1_0B_REG = 0x4f;//[7:4]D1 link clk enable.
                               //[3:0]D0/D1/D2/D3 dig_clk enable.
            BKA1_0A_REG = 0xf0;//[7:4]rg_dhrx_d0(d0~d3)_pkdet_en; 
                               //[3:0]rg_dhrx_d0(d0~d3)_clkdet_en;
            BKA1_0C_REG = 0x7c;//[7]rg_dhrx_pwr_sel: 0-select from internal ldo
                               //[2:0]rg_dhrx_pkdet_sdth: 0x04
            break;
        #endif
    }
}

void Drv_HdmiRx_DigInit(u8 ucOpt)
{
    switch(ucOpt)
    {
        case HDMI14:
        case HDMI20:
            BKCC_1A_REG = 0x0c;//rgd_scp_cnt 
            break;

        #if HDMIRX_MAX_FRL_RATE != FRL_NOT_SPT
        case HDMI21:
            BKCD_08_REG &= BIT4_0;//[4]force frl start disable
            break;
        #endif

        default:
            break;
    }
}

//========================================================================
// Func Name   : Drv_HdmiRx_LogicalReset
// Description : Reset phy and cdr with given sequence, to make sure cdr working correctly.
// Input       : void  
// Output      : None
// Return      : void
//========================================================================
void Drv_HdmiRx_LogicalReset(void)
{
    BKC9_07_REG &= 0xc9;//[5]rgd_sw_hdmi20rx_dc_rst_n
                        //[4]rgd_sw_hdmi20rx_dec_rst_n
                        //[2]rgd_sw_hdmi20rx_err_det_rst_n
                        //[1]rgd_sw_hdmi20rx_fec_rst_n
    BKC9_07_REG |= 0x36;
}

void Drv_HdmiRx_Tmds_PhyCtleSet(u8 ucOpt)
{
    if (HDMI20 == ucOpt)
    {
        BKA1_02_REG = 0x44;//[7:4]rg_dhrx_eq0 is; [3:0]rg_dhrx_eq0 rl;
        BKA1_03_REG = 0x44;//[7:4]rg_dhrx_eq1 is; [3:0]rg_dhrx_eq1 rl;

        BKA1_04_REG = 0x48;//[7:4]rg_dhrx_bf0 is; [3:0]rg_dhrx_bf0 rl;
        BKA1_05_REG = 0x48;//[7:4]rg_dhrx_bf1 is; [3:0]rg_dhrx_bf1 rl;

        BKA1_06_REG = 0x62;//[7:4]rg_dhrx_fb0 is; [3:0]rg_dhrx_fb1is;
        BKA1_07_REG = 0x80;//[7:4]rg_dhrx_eq  cs; [3:2]rg_dgrx_fb rs; [1]rg_dhrx_nrb_en; [0]rg_dhrx_nr_en;
    }
    else
    {
        BKA1_02_REG = 0x22;//[7:4]rg_dhrx_eq0 is; [3:0]rg_dhrx_eq0 rl;
        BKA1_03_REG = 0x22;//[7:4]rg_dhrx_eq1 is; [3:0]rg_dhrx_eq1 rl;

        BKA1_04_REG = 0x22;//[7:4]rg_dhrx_bf0 is; [3:0]rg_dhrx_bf0 rl;
        BKA1_05_REG = 0x22;//[7:4]rg_dhrx_bf1 is; [3:0]rg_dhrx_bf1 rl;

        BKA1_06_REG = 0x23;//[7:4]rg_dhrx_fb0 is; [3:0]rg_dhrx_fb1is;
        BKA1_07_REG = 0x80;//[7:4]rg_dhrx_eq  cs; [3:2]rg_dgrx_fb rs; [1]rg_dhrx_nrb_en; [0]rg_dhrx_nr_en;
    }

    BKA1_08_REG = 0x0a;//[7]rg_dhrx_ldo_en: 0-disable, eq power use external vcc11_dhrx;
                       //[6:4]rg_dhrx_ldo_vset: 000-1.1v
                       //[3]rg_dhrx_en: 0-dis, 1-en;
                       //[2:0]rg_dhrx_vcm_adj: 011-0.75v
    BKA1_09_REG |= 0x70;//[7:4]rg_dhrx_d0(d0~d3)_hseq_en: because d0 is clk lane for hdmi2.0/1.4 mode, so d0 disable hseq_en
                        //[0]rg_dhrx_linkclk_div2_en: 0-use from normal half-rate mode, 1-use for new full-rate mede;
    BKA1_0E_REG &= 0xfc;
    BKA1_0E_REG |= BIT3_1; //[3:2]2'b10 = no DFE
}

//========================================================================
// Func Name   : to slove hdmi2.0 10bit case
// Description : this is a bug for rxpll that, SRC is HDMI2.0 and deep color is 10bit
// Input       : void  
// Output      : None
// Return      : void
//========================================================================
void Drv_HdmiRx_TenBitSet(void)
{
    BKA1_37_REG &= 0xfc;//default
    //CCD7: [3:0] 0101-10bit
    //CC70: [1]tmds_bit_clock_ratio: 1 is 1/40, HDMI2.0;
    if ((BKCC_70_REG & BIT1_1) && ((BKCC_D7_REG & 0x0f) == 0x05))
    {
        BKA1_37_REG |= BIT6_1;//[6]rg_dhrxpll_tenbit_sel: 1-from register
        BKA1_37_REG |= BIT4_1;//[5:4]rg_dhrxpll_tenbit_set: 01-vco_out_clk
        BKA1_37_REG |= 0x02;  //half pixel div = 1;
        printLT(PRINT_PRIO_HIG, "\nHdmi rx tmds ten bit set");
    }
    else
    {
        BKA1_37_REG &= BIT6_0;//[6]rg_dhrxpll_tenbit_sel: 0-from digital-to-analog interface
        BKA1_37_REG &= BIT4_0;//[5:4]rg_dhrxpll_tenbit_set: 00-2*vco_out_clk
        BKA1_37_REG |= 0x01;//
    }
}

//========================================================================
// Func Name   : to slove hdmi2.0 10bit case with csc ,using the pcrpll to creat pixel clk  in tmds mode
// Description : this is a bug for rxpll that, SRC is HDMI2.0 and deep color is 10bit
// Input       : void  
// Output      : None
// Return      : void
//========================================================================
void Drv_HdmiRx_TmdsPcrPllCal(u32 ulTmdsClk)
{
    u8 ucpcrpll_cal_cnt,ucpcrpll_lock_cnt;

    BKA3_20_REG &= BIT4_0;//[4]rg_pcrpll_pd: 0-normal work
    BKA3_20_REG &= 0xfc;//[1:0]rg_pcrpll_ref_sel: 00-Xtal_25m_clk
    BKA3_20_REG |= 0X03;//pcr pll sel 
    BKA3_43_REG &= 0xf3;
    BKA3_43_REG |= BIT3_1;//sel rxpll half pixel clk
    
    BKA3_21_REG &= 0xe0;
    BKA3_21_REG |= 0x04; //prediv = 5;
    
    BKA3_24_REG = 0x00;//pcrpll_pixel_clk
    BKA3_2E_REG = 0x08;//da_pcrpll_post_divsel = 1;
    BKE2_3D_REG &= BIT3_0;//pcrpll_cal_disable
    BKE2_3D_REG = 0x20;// ks =2;
    // ulRxpll_In_Clk is half tmds clk, pcrpll_in ref half pixel clk
    // 4K30 pcrpll in clk  370M  ulRxpll_In_Clk*4 = real tmds clk
    if(ulTmdsClk < 375000) //half pixel clk
    {
        BKA3_20_REG |=BIT2_1;//rg_pcrpll post div = 2;
        BKA3_2A_REG = 0x80|0x28;// divset =  40;
        BKA3_2B_REG = 0xb0;//freq_set =  div 8
    }
    else  //
    {
        BKA3_20_REG &=BIT2_0;//rg_pcrpll post div = 1;
        BKA3_2A_REG = 0x80|0x28;// divset = 40;
        BKA3_2B_REG = 0xa0;//freq_set =  div 4 
    }
    ucpcrpll_cal_cnt = 0;
    do{
        BKE1_08_REG &= 0xfc;//[1]rgd_sw_pcrpll_cal_rst_n
        BKE1_0E_REG &= BIT1_0;//[1]rg_sw_pcrpll_rst_n
        BKE2_3D_REG &= BIT3_0;//[3]rgd_pcrpll_pll_cal_en
        Ocm_Delay1ms(1);
        BKE1_08_REG |= 0x03;
        BKE1_0E_REG |= BIT1_1;
        Ocm_Delay1ms(1);
        BKE2_3D_REG |= BIT3_1;
        Ocm_Delay1ms(2);
        ucpcrpll_cal_cnt++;
    }while((ucpcrpll_cal_cnt < 3)&&((BKE2_47_REG&0x3) != 0x02));
    printLT(PRINT_PRIO_HIG, "\nPcrpll band = 0x%02bx", BKE2_4E_REG);
    ucpcrpll_lock_cnt = 0;      
    while((!(BKE2_28_REG&BIT4_1)) && (ucpcrpll_lock_cnt < 6))  //PLL lock output lock status
    {
        ucpcrpll_lock_cnt++;
        Ocm_Delay1ms(1);
    }
}

void Drv_HdmiRx_TmdsPcrPllDis(void)
{

    BKA3_20_REG &= BIT4_0;//[4]rg_pcrpll_pd: 0-normal work
    BKA3_20_REG &= BIT2_0;//pcrpll post div =0;
    BKA3_20_REG &= 0xfc;//[1:0]rg_pcrpll_ref_sel: 00-Xtal_25m_clk
    BKA3_43_REG &= 0xf3;
    
    BKA3_21_REG &= 0xe0; //pre div = 1
    BKA3_24_REG =  0x20; //half pixel clk
    BKA3_2A_REG =  0x00;
    BKA3_2B_REG =  0x00;
    BKA3_2E_REG =  0x00; 
}

void Drv_HdmiRx_PllModeSet(u8 ucOpt)
{
    if (ucOpt == HDMI21)
    {
        BKE3_09_REG &= 0xf3;  //default
        BKE3_09_REG |= BIT3_1;//[3:2]rgd_dhrxpll_cal_hdmidp_sel: 10-hdmi2.1
        BKA1_30_REG &= 0xfc;  //bit7 pll power on [1:0]rg_dhrxpll_ref_sel: 00-xtal_25m_clk or xtal_50m_clk
    }
    else
    {
        BKE3_09_REG &= 0xf3;  //[3:2]rgd_dhrxpll_cal_hdmidp_sel: 00-hdmi1.4/2.0 mode
        BKA1_30_REG &= 0xfc;  //default
        BKA1_30_REG |= BIT0_1;//[1:0]rg_dhrxpll_ref_sel = 01: aa_dhrx_tmds_clk

        BKE1_05_REG &= BIT2_0;//[2]rgd_sw_dhrxpll_freq_meter_rst_n:
        BKE1_05_REG |= BIT2_1;//[2]rgd_sw_dhrxpll_freq_meter_rst_n:
    }
}

void Drv_HdmiRx_Tmds_PiSet(u8 ucOpt)
{
    switch(ucOpt)
    {
        case HDMI14:
        case HDMI20:
            BKA1_26_REG = 0x13;
            BKA1_27_REG = 0x13;
            BKA1_28_REG = 0x03;
            break;

        default:
            break;
    }
}

void Drv_HdmiRx_Tmds_PllCali(void)
{
    BKA1_31_REG &= BIT7_0;//[7]rg_dhrxpll_iband_enhace: 0-500M~4GHz
    BKA1_35_REG |= BIT7_1;//[7]rg_dhrxpll_fec_clken: 1-en(only for dsc mode)
    BKA1_37_REG |= BIT2_1;//[2]rg_dhrxpll_halfpix_muxsel: 1-from deep color divider, applicable to all hdmi mode.

    BKE3_00_REG &= BIT1_0;//[1]rgd_dhrxpll_cal_pll_cal_en_auto_en: 0-calibrate a single frequency
    BKE3_0A_REG &= 0xcf;  //[5:4]rgd_dhrxpll_cal_frl_set_mode_sel: 00-auto ctrl mode
    BKE3_0B_REG &= BIT0_0;//[0]rgd_dhrxpll_cal_pll_band_sw_en: 0-dis

    BKE1_05_REG &= 0xfc;//[0]rgd_sw_dhrxpll_cal_rst_n: 0-en
    BKA1_30_REG &= BIT6_0;//[6]rg_dhrxpll_rst_n: 0-en
    BKE3_00_REG &= BIT0_0;//[0]rgd_dhrxpll_cal_pll_cal_en: 0-dis
    Ocm_Delay1ms(1);
    BKE1_05_REG |= 0x03;//[0]rgd_sw_dhrxpll_cal_rst_n: 1-dis
    BKA1_30_REG |= BIT6_1;//[6]rg_dhrxpll_rst_n: 1-dis
    BKE3_00_REG |= BIT0_1;//[0]rgd_dhrxpll_cal_pll_cal_en: 1-en
    Ocm_Delay1ms(2);
    printLT(PRINT_PRIO_TEST, "\nTmds Rxpll cal band = 0x%02bx", BKE3_2E_REG);
}

void Drv_HdmiRx_Tmds_PllVcoReset(void)
{   
    //-wait add reason-
    BKA1_30_REG &= BIT5_0;//[5]rg_dhrxpll_vcodiv_rst_n: 0-en
    BKA1_30_REG |= BIT5_1;//[5]rg_dhrxpll_vcodiv_rst_n: 1-dis
}

void Drv_HdmiRx_NewErrorStatistic(u8 ucOpt)
{
    if (ucOpt == DISABLED)
    {
        BKCC_15_REG &= BIT4_0;//2204 old error statistic method
        BKCC_2C_REG |= BIT2_1;//2102 new error statistic method
        printLT(PRINT_PRIO_TEST, "\nHdmirx old err");
    }
    else
    {
        BKCC_29_REG |= BIT0_1;//[0]1-not concerned disparity cnt
        BKCC_15_REG |= BIT4_1;//2204 new error statistic method   
        printLT(PRINT_PRIO_TEST, "\nHdmirx new err");  
    }

}

void Drv_HdmiRx_RxpllDivSet(u8 ucOpt)
{
    switch(ucOpt)
    {
        case HDMI14:
            if((BKE3_62_REG&0x30)==0x00)
            {
                BKA1_33_REG = 0x50;//rxpll prediv by da_freq set 
                BKA1_3E_REG = 0x50;//rxpll fb div by da_freq set
            }
            else
            {
                BKA1_33_REG = 0x00;//rxpll prediv by da_freq set 
                BKA1_3E_REG = 0x00;//rxpll fb div by da_freq set
            }
            BKA1_37_REG &= BIT7_0;//[7]rg_dhrxpll_hdmi20_sel: 0-hdmi1.4  div = 5
            BKA1_42_REG = 0x08;//frl mode freq_set = 0 el hard mode
            BKA1_31_REG = 0x02;//[4:0]rg_dhrxpll_cpcur_sel
            BKA1_36_REG = 0x43;//[6:4]rg_dhrxpll_lpf_cinset
            break;
        case HDMI20:
            BKA1_33_REG = 0x60;//rxpll prediv by da_freq set = 1 
            BKA1_37_REG |= BIT7_1;//[7]rg_dhrxpll_hdmi20_sel: 1-hdmi2.0 div = 20
            BKA1_3E_REG = 0x60;//rxpll fb div by da_freq set fb_div =1;
            BKA1_42_REG = 0x88;//frl mode freq_set = 0 freq_set = 1
            BKA1_31_REG = 0x08;//[4:0]rg_dhrxpll_cpcur_sel
            BKA1_36_REG = 0x33;//[6:4]rg_dhrxpll_lpf_cinset
            break;
        default:
            break;
    }
}

//========================================================================
// Func Name   : Drv_HdmiRx_ScrambeTimerSet
// Description : SCP cnt hold in HDMIRX scramble signal detect timer
// Input       : u8 ucOpt  
// Output      : None
// Return      : void
//========================================================================
void Drv_HdmiRx_ScrambeTimerSet(u8 ucOpt)
{
    switch(ucOpt)
    {
        case HDMI14:
            BKCC_1A_REG = 0x0c;//rgd_scp_cnt
            break;
        case HDMI20:
            BKCC_1A_REG = 0x08;//rgd_scp_cnt
            break;
        default:
            break;
    }
}

//========================================================================
// Func Name   : Drv_HdmiRx_PhyRst
// Description : Reset phy and cdr with given sequence, to make sure cdr working correctly.
//               WARNING: the reset step cannot be changed
// Input       : void
// Output      : None
// Return      : void
//========================================================================
void Drv_HdmiRx_PhyRst(void)
{
    //WARNING: the reset step cannot be changed
    BKE1_0C_REG &= 0xf0;//[6]rgd_sw_dhrx_rst_n: 0-en
    BKE1_0D_REG &= 0xe1;//[4:1]rg_sw_dhrxpi3(3~0)_rst_n: 0-en ;
    BKC9_03_REG &= 0x0f;// rx cdr reset

    BKE1_0C_REG |= 0x0f;//[6]rgd_sw_dhrx_rst_n: 1-dis
    BKE1_0D_REG |= 0x1e;//[4:1]rg_sw_dhrxpi3(3~0)_rst_n: 1-dis; 
    BKC9_03_REG |= 0xf0;//rx cdr reset
}

void Drv_HdmiRx_HpdSet(u8 b1IsHigh)
{
    BKA3_7F_REG |= BIT3_1;//[3]rgd_sw_en_dhrx_hpd: 0-hardware, 1-software
    if (b1IsHigh == HPD_HIGH)
    {
        BKA3_5A_REG |= BIT6_1;
        BKA1_09_REG |=0x0f;
        BKCC_08_REG |= BIT6_1;//[6]rgd_rx_hpd: 1-HPD high, for cts test
        BKCD_08_REG |= BIT2_1;//[2]hdmi 21 rx hpd indicated flag: for cts test
        BKCC_00_REG |= BIT3_1;//[3]rgd_5v_det: 1-for scdc read request
        BKA3_7F_REG |= BIT2_1;//[2]rgd_sw_dhrx_hpd: 0-soft output 0, 1-soft output 1
        printLT(PRINT_PRIO_HIG,"\nHdmi rx hpd high");
    }
    else
    {
        BKA3_5A_REG &=0x3f;
        BKA1_09_REG &=0xf0;//disable hdmirx-term
        BKCC_08_REG &= BIT6_0;//[6]rgd_rx_hpd: 0-dis, for cts test
        BKCD_08_REG &= BIT2_0;//[2]hdmi 21 rx hpd indicated flag, for cts test
        BKCC_00_REG &= BIT3_0;//[3]rgd_5v_det: 0-no scdc read request
        BKA3_7F_REG &= BIT2_0;//[2]rgd_sw_dhrx_hpd: 0-soft output 0, 1-soft output 1
        printLT(PRINT_PRIO_HIG,"\nHdmi rx hpd low");
    }
}


void Drv_HdmiRx_ClkMux(u8 ucOpt)
{
    //default
    BKA3_45_REG &= 0xe0;
    BKA3_3C_REG &= 0x80;
    BKA3_3D_REG &= 0x80;
    BKA3_3E_REG &= 0x80;
    BKA3_3F_REG &= 0x80;
    BKA3_40_REG &= 0x80;
    BKA3_41_REG &= 0x80;
    BKA3_42_REG &= 0x80;

    if (ucOpt == HDMI21)//hdmi2.1
    {
        //sel dsc_in_clk = rx_link_clk
        BKA3_3D_REG |= 0x60;//[6:4]rg_clkgen_div_link_muxsel     : 110-aa_pcrpll_dsc_in_clk
        
        //half pix
        BKA3_45_REG = 0xe0;//[4]rg_clkgen_dscin_clk_recvsel      : 0-aa_pcrpll_dsc_in_clk
                            //[3:1]rg_clkgen_divpcr_clk_recvsel  : 000-aa_pcrpll_div_pcr_clk
                            //[0]rg_clkgen_pix_clk_recvsel       : 0-aa_pcrpll_pix_clk
        BKA3_46_REG = 0x00;//[2:0]rg_clkgen_pcr_clk_recvsel      : 000-aa_pcrpll_pcr_clk


        //pix
        BKA3_3C_REG |= 0x01;//[6:4]rg_clkgen_cscrx_halfpix_muxsel: 000-aa_pcrpll_pix_clk or aa_secpcrpll_pix_clk
                            //[3:0]rg_clkgen_cscrx_halfpix_divsel: div 2
        BKA3_3E_REG |= 0x11;//[6:4]rg_clkgen_dscout_muxsel       : 001-aa_pcrpll_pix_clk
                            //[3:0]rg_clkgen_dscout_divse        : div 2
        BKA3_3F_REG |= 0x01;//ad_dscrx_dsc_clk    2f/2
        BKA3_40_REG |= 0x11;//ad_dscrx_dsc_rd_clk 2f/2
        BKA3_41_REG |= 0x01;//[6:4]rg_clkgen_dsctx_dsc_muxsel    : 000-aa_pcrpll_pix_clk
        BKA3_42_REG |= 0x11;//[6:4]rg_clkgen_dsctx_dscrd_muxsel  : 001-aa_pcrpll_pix_clk
                             //[3:0]rg_clkgen_dsctx_dscrd_divsel : div 2
    }
    else//hdmi2.0 or hdmi1.4
    {
        //sel rx_link clk
        BKA3_3D_REG |= 0x30;//[6:4]rg_clkgen_div_link_muxsel     : 011-aa_dhrxpll_link_clk

        //half pix
        BKA3_45_REG |= 0x0a;//[3:1]rg_clkgen_divpcr_clk_recvsel  : 101-aa_dhrxpll_half_pix_clk
        BKA3_46_REG  = 0x03; //[2:0]rg_clkgen_pcr_clk_recvsel    : 011-aa_dhrxpll_half_pix_clk

        
        //pix
        BKA3_3C_REG |= 0x51;//[6:4]rg_clkgen_cscrx_halfpix_muxsel: 101-aa_dhrxpll_pix_clk
        BKA3_3E_REG |= 0x51;//[6:4]rg_clkgen_dscout_muxsel       : 101-aa_dhrxpll_pix_clk

        BKA3_3F_REG |= 0x51;//ad_dscrx_dsc_clk    2f/2
        BKA3_40_REG |= 0x51;//ad_dscrx_dsc_rd_clk 2f/2
        BKA3_41_REG |= 0x51;//[6:4]rg_clkgen_dsctx_dsc_muxsel    : 101-aa_dhrxpll_pix_clk
        BKA3_42_REG |= 0x51;//[6:4]rg_clkgen_dsctx_dscrd_muxsel  : 101-aa_dhrxpll_pix_clk
    }
}

void Drv_HdmiRx_PcrClkMux(void)
{
    BKA3_23_REG = 0x21;//[6:4]rg_pcrpll_half_pcrck_muxsel : 010-aa_pll_half_pix_clk
    BKA3_24_REG = 0x20;//[6:4]rg_pcrpll_half_pixck_muxsel : 010-aa_pll_half_pix_clk
    BKA3_25_REG = 0x21;//[6:4]rg_pcrpll_half_tmdsck_divsel: 010-aa_pll_half_pix_clk
    BKA3_26_REG = 0x01;//[6:4]rg_pcrpll_dscin_muxsel      : 000-aa_pll_pix_clk
}

void Drv_HdmiRx_SecPcrClkMux(void)
{
    BKA3_32_REG = 0x01;//[6:4]rg_secpcrpll_half_pcrck_muxsel: 000-aa_pll_pix_clk
    BKA3_33_REG = 0x00;//[6:4]rg_secpcrpll_half_pixck_muxsel: 000-aa_pll_pix_clk
    BKA3_34_REG = 0x00;
    BKA3_35_REG = 0x00;//[6:4]rg_secpcrpll_dscin_muxsel     : 000-aa_pll_pix_clk
}

u8 Drv_HdmiRx_VersionGet(void)
{
    if (BKCC_70_REG & BIT1_1)//rgod_scdc_reg20[1]tmds_bit_clock_ratio: 1 is 1/40;
    {
        return HDMI20;
    }
    else//rgod_scdc_reg20[1]tmds_bit_clock_ratio: 0 is 1/10, 
    {
        return HDMI14;
    }
}

u8 Drv_HdmiRx_HdmiModeGet(void)
{
    if ((BKCC_E1_REG & BIT5_1)||(BKCC_70_REG & 0x03)||((BKCD_B5_REG&0x0f) != 0))//[5]sramble or scdc 1:0 or hdmi2.1
     {
          return TRUE;
     }
     else
     {
         return FALSE;
     }
}
//========================================================================
// Func Name   : Drv_HdmiRx_SettingInit
// Description : The setting init for HPD High.
//             : Shall be called every time before HPD go to high.
// Input       : void  
// Output      : None
// Return      : void
//========================================================================
void Drv_HdmiRx_SettingInit(void)
{
    Drv_HdmiRx_PhySet(HDMI20);
    Drv_HdmiRx_DigInit(HDMI20);
    Drv_HdmiRx_Tmds_CdrSet(HDMI20);
    Drv_HdmiRx_ErrValidClr(ENABLED);
    Drv_HdcpRx_Enable(HDMIRX_HDCP_DEC_MODE);
    Drv_HdcpRx_SoftAvmuteEn(ENABLED);

    #if HDMIRX_MAX_FRL_RATE != FRL_NOT_SPT
    Drv_HdmiRx_Frl_Init();
    Drv_HdmiRx_Frl_PcrInit();
    #if ((HDMIRX_DSC_DEC_SUPPORT == ENABLED) || (HDMIRX_DSC_BYPASS_SUPPORT == ENABLED))
    Drv_HdmiRx_Frl_SecPcrInit();
    #endif
    Drv_System_IntSet(IRQ_HDMIRX_FRL_INT, OFF);
    Drv_System_IntClr(IRQ_HDMIRX_FRL_INT);
    #endif
    Drv_System_IntSet(IRQ_HDMIRX_VRRSTART_INT, ON);
    Drv_System_IntClr(IRQ_HDMIRX_VRRSTART_INT);
    Drv_System_IntSet(IRQ_HDMIRX_VRRSTOP_INT, ON);
    Drv_System_IntClr(IRQ_HDMIRX_VRRSTOP_INT);
    Drv_System_IntSet(IRQ_HDMIRX_STATICHDR_INT, ON);
    Drv_System_IntClr(IRQ_HDMIRX_STATICHDR_INT);
    Drv_System_IntSet(IRQ_HDMIRX_DYNAMICHDR_INT, ON);
    Drv_System_IntClr(IRQ_HDMIRX_DYNAMICHDR_INT);
    Drv_System_IntSet(IRQ_HDMIRX_VSI_INT, ON);
    Drv_System_IntClr(IRQ_HDMIRX_VSI_INT);
    
}

u8 Drv_HdmiRx_PacketInfoCheck(void)
{
    u8 ucRtn;

    if(Drv_HdmiRx_HdmiModeGet()== TRUE)//hdmi mode
    {
        if (Drv_System_PktDataChk(AVI_INFO_FRAME_0X82) == SUCCESS)//avi info frame
        {
            printLT(PRINT_PRIO_TEST, "\nHdmi rx de-packet check ok");
            ucRtn = SUCCESS;
        }
        else
        {
            printLT(PRINT_PRIO_TEST, "\nHdmi rx de-packet check fail");
            ucRtn = FAIL;
        }
    }
    else
    {
        ucRtn = SUCCESS;//dvi mode not have avi info, so return success
    }
    printLT(PRINT_PRIO_HIG, "\nHdmi rx ecc err 0x%02bx, 0x%02bx", BKCC_F5_REG, BKCC_F6_REG);
    printLT(PRINT_PRIO_HIG, "\nHdmi rx ecc 50err state[6:5] is 0x%02bx", BKCC_F4_REG);
    return ucRtn;
}

u8 Drv_HdmiRx_DscDecState(void)
{
    #if ((CHIP_SEL == LT86121GXE))//121 case

    #if (DSC_USER_DEFINE_PKT_EN == ENABLED)
    return ENABLED;
    #elif ((HDMIRX_DSC_DEC_SUPPORT == ENABLED) || (HDMIRX_DSC_BYPASS_SUPPORT == ENABLED))
    if(BKCB_41_REG & BIT1_1)//[1]rgod_h20rx_pps_set_flag: 1-have pps
    {
        return ENABLED;
    }
    else//0-no pps
    {
        return DISABLED;
    }
    #else
    return DISABLED;
    #endif

    #else //not 121 case

    #if ((HDMIRX_DSC_DEC_SUPPORT == ENABLED) || (HDMIRX_DSC_BYPASS_SUPPORT == ENABLED))
    if(BKCB_41_REG & BIT1_1)//[1]rgod_h20rx_pps_set_flag: 1-have pps
    {
        return ENABLED;
    }
    else//0-no pps
    {
        return DISABLED;
    }
    #else
    return DISABLED;
    #endif

    #endif
}

void Drv_HdmiRx_ColorInfoGet(ColorInfo_S *pstInfo)
{
    pstInfo->ucBitDepth          = BKCC_D7_REG  & 0x0f;//[3:0]color depth: 4-8bit, 5-10bit, 6-12bit
    if(pstInfo->ucBitDepth == 0x00)//00 also 8bit
    {
        pstInfo->ucBitDepth = HDMIRX_8BIT_4;
    }
    pstInfo->ucPixelEncoding     = (BKCC_A3_REG & 0x60) >> 5;//pb1[7:5]0-rgb, 1-422, 2-444, 3-420
    if(pstInfo->ucPixelEncoding == 0x01)
    {
        pstInfo->ucBitDepth = HDMIRX_12BIT_6;
    }

    pstInfo->ucColorimetryFormat = (BKCC_A4_REG & 0xc0) >> 6;//pb2[7:6]3-use colorimetry ext
    pstInfo->ucAspectRatio       = BKCC_A4_REG  & 0x0f;
    pstInfo->ucColorimetryExt    = (BKCC_A5_REG & 0x70) >> 4;//pb3[6:4]colorimetry ext
    pstInfo->ucRgbRange          = (BKCC_A5_REG & 0x0c) >> 2;//pb3[3:2]00-default, 1-limit, 2-full, 3-reserved

    pstInfo->ucVic               =  BKCC_A6_REG;//pb4 vic value
    pstInfo->ucYccRange          = (BKCC_A7_REG & 0xc0)>>6;//pb5[7:6]00-limited, 1-full, other-reserved
}

void Drv_HdmiRx_RxTimingGet(LtTiming_S *pstTiming)
{
    //get V timing by video check
    pstTiming->usVfp =   ((u16)BKC8_4C_REG << 8) + BKC8_4D_REG;
    pstTiming->usVsync = ((u16)BKC8_46_REG << 8) + BKC8_47_REG;
    pstTiming->usVbp =   ((u16)BKC8_4A_REG << 8) + BKC8_4B_REG;
    pstTiming->usVact =  ((u16)BKC8_56_REG << 8) + BKC8_57_REG;
    pstTiming->usVtol =  ((u16)BKC8_52_REG << 8) + BKC8_53_REG;
    //h
    pstTiming->usHfp =   ((u16)BKC8_50_REG << 8) + BKC8_51_REG;
    pstTiming->usHsync = ((u16)BKC8_48_REG << 8) + BKC8_49_REG;
    pstTiming->usHbp =   ((u16)BKC8_4E_REG << 8) + BKC8_4F_REG;
    pstTiming->usHact =  ((u16)BKC8_58_REG << 8) + BKC8_59_REG;
    pstTiming->usHtol =  ((u16)BKC8_54_REG << 8) + BKC8_55_REG;
    //recover to real timing
    if ((BKCC_D0_REG & 0x70) == 0x30)//[6:4]hdmi rx color space, 11-yuv420, -wangtt- wait update
    {
        pstTiming->usHbp   <<= 2;
        pstTiming->usHfp   <<= 2;
        pstTiming->usHsync <<= 2;
        pstTiming->usHtol  <<= 2;
        pstTiming->usHact  <<= 2;
    }
    else
    {
        pstTiming->usHbp   <<= 1;
        pstTiming->usHfp   <<= 1;
        pstTiming->usHsync <<= 1;
        pstTiming->usHtol  <<= 1;
        pstTiming->usHact  <<= 1;
    }
}

void Drv_HdmiRx_AudioInfoGet(AudioChlInfo_S *pstInfo)
{
    pstInfo->ucFsValue = BKC6_7C_REG;

    pstInfo->ucLayout = (BKCC_D3_REG >> 2) & BIT0_1;//[2]rgod_audc_pkt_layout: 1-audio is 8 chl, 0-is 2 chl
    pstInfo->ucChannel = BKCC_AC_REG & 0x07;
    pstInfo->ucCodingType = (BKCC_D3_REG & BIT3_1)?(ENABLED):(DISABLED); 

    pstInfo->szAudioInfo[0] = BKCC_AC_REG;//aif pb1
    pstInfo->szAudioInfo[1] = BKCC_AD_REG;//aif pb2
    pstInfo->szAudioInfo[2] = BKCC_AE_REG;//aif pb3
    pstInfo->szAudioInfo[3] = BKCC_AF_REG;//aif pb4
    pstInfo->szAudioInfo[4] = BKCC_B0_REG;//aif pb5
}

u8 Drv_HdmiRx_Tmds_ClkStbChk(void)
{
    u8 ucState = UNSTABLE;
    static u8 ucStableCnt = 0;

    if ((BKE3_24_REG & BIT5_1)&&(Drv_System_IntSrcGet(IRQ_TMDS_STB_INT) == TRUE))
    {
        if (((BKE3_21_REG & 0x0f) > 0) || (BKE3_22_REG > 0x60))//
        {
            ucState = STABLE;
        }
    }
    if (Drv_System_IntFlagGet(IRQ_TMDS_UNSTB_INT) == TRUE)
    {
        Drv_System_IntClr(IRQ_TMDS_UNSTB_INT);
        ucState = UNSTABLE;
    }
    if(ucState == UNSTABLE)
    {
        ucStableCnt = 0;
        return UNSTABLE;
    }
    else
    {
        if((ucStableCnt++) >= 100)
        {
            ucStableCnt = 0;
            return STABLE;
        } 
    }
    return UNKNOWN;
}

//========================================================================
// Func Name   : Drv_HdmiRx_Tmds_RxPllCaliCheck
// Description : Check rxpll calibration result
// Input       : void
// Output      : None
// Return      : SUCCESS-> calibration pass.
//             : FAIL   -> calibration fail.
//========================================================================
u8 Drv_HdmiRx_Tmds_RxPllCaliCheck(void)
{
    if ((BKE3_24_REG & BIT1_1) == 0)// [1]rgod_dhrxpll_pll_cal_done
    {
        printLT(PRINT_PRIO_HIG, "\nHdmirx pll cali not done");
        return FAIL;
    }

    if (BKE3_24_REG & BIT0_1)//[0]rgod_dhrxpll_pll_cal_fail
    {
        printLT(PRINT_PRIO_HIG, "\nHdmirx pll cali fail");
        return FAIL;
    }
     
    if ((BKE3_24_REG & BIT4_1) == 0)//[4]rgod_dhrxpll_pll_lock_out
    {
        printLT(PRINT_PRIO_HIG, "\nHdmirx pll unlock");
        return FAIL;
    }

    return SUCCESS;  
}

void Drv_HdmiRx_Tmds_ErrClr(void)
{
    BKCC_28_REG |= BIT2_1;//[2]rgd_err_clr: 1-en
    BKCC_28_REG &= BIT2_0;//[2]rgd_err_clr: 0-dis
}

void Drv_HdmiRx_SyncPolSet(u8 ucOpt)
{
    if (ENABLED == ucOpt)
    {
        (!(BKC8_6F_REG&BIT5_1))? (BKCC_1C_REG |= BIT1_1) : (BKCC_1C_REG &= BIT1_0);//vsync pol
        (!(BKC8_6F_REG&BIT4_1))? (BKCC_1C_REG |= BIT0_1) : (BKCC_1C_REG &= BIT0_0);//hsync pol
    }
    else
    {
        BKCC_1C_REG &= 0xfc;//[1:0]Vsync Hsync
    }
}

void Drv_HdmiRx_ErrValidClr(u8 ucOpt)
{
    if (ucOpt == ENABLED)
    {
        BKCC_2C_REG &= BIT0_0;
    }
    else
    {
        BKCC_2C_REG |= BIT0_1;
    }
}

//--------------------------------------Eq--------------------------------------
#if HDMIRX_EQ_MODE == HW_MODE
#if HDMIRX_MAX_FRL_RATE != FRL_NOT_SPT
void Drv_HdmiRx_Frl_HwEqInit(void)
{
    #if HDMIRX_EQ_STAGE == EQ_16_STAGE
    BKCE_89_REG = 0xf0;//[7:4]rgd_eq_stage_tot_cnt: e-16 stage
                       //[3:1]rgd_retry_eq_cnt: 3 times
                       //[0]rgd_eq_normal_en: 0-dis
    BKCE_AB_REG = 0x07;//EQ STP0 level7 setting.
    #endif

    #if HDMIRX_EQ_STAGE == EQ_8_STAGE
    BKCE_89_REG = 0x70;//[7:4]rgd_eq_stage_tot_cnt: e-16 stage
                       //[3:1]rgd_retry_eq_cnt: 3 times
                       //[0]rgd_eq_normal_en: 0-dis
    #endif

    BKCE_84_REG = 0x00;//rgd_scvchk_wait_timer[15:8]
    BKCE_83_REG = 0x60;//rgd_scvchk_wait_timer[ 7:0]
    BKCE_86_REG = 0x00;//rgd_eq_wait_timer[15:8]
    BKCE_85_REG = 0xc0;//rgd_eq_wait_timer[ 7:0]
    BKCE_C4_REG = 0x01;//rgd_eq_scan_timer[15:8]
    BKCE_C3_REG = 0x00;//rgd_eq_scan_timer[ 7:0]
    BKCE_8B_REG = 0x08;//rgd_eq_err_uplmt[15:8]
    BKCE_8A_REG = 0xff;//rgd_eq_err_uplmt[ 7:0]
    BKCE_8C_REG = 0x08;//[3] 3CH SYSN enable
                       //[0]EQ_EARLY_RETRY diable -0629
}

void Drv_HdmiRx_Frl_HwEqEn(void)
{
    BKC7_FB_REG |= BIT7_1;//[7]rgd_hdmi21_mode: 1-hdmi21 eq

    BKCE_AF_REG &= BIT4_0;//[0]eq soft reset: 0-reset enable -0629
    BKCE_AF_REG |= BIT4_1;//[0]eq soft reset: 1-reset disable -0629

    BKCE_81_REG |= BIT3_1;//hardware auto eq start, positive edge effective
    BKCE_81_REG &= BIT3_0;
}
#endif

void Drv_HdmiRx_Tmds_HwEqInit(void)
{
    #if HDMIRX_EQ_MODE == HW_MODE
    #if HDMIRX_EQ_STAGE == EQ_16_STAGE
    BKCC_35_REG = 0x0f;//[3:0]rgd_eq_stage_tot_cnt: e-16 stage
    BKCC_56_REG = 0x07;//EQ STP0 level7 setting.
    #endif

    #if HDMIRX_EQ_STAGE == EQ_8_STAGE
    BKCC_35_REG = 0x07;//[3:0]rgd_eq_stage_tot_cnt: 7-8 stage
    #endif

    BKCC_1F_REG = 0x00;//1.024ms
    BKCC_20_REG = 0x60;//scvchk wait timer after change eq value when hw auto eq scan
    BKCC_2E_REG = 0x00;//2.048ms
    BKCC_2F_REG = 0xc0;//eq wait timer after scvchk wait timer when hw auto eq scan, eq wait time must be greater than scvchk wait time
    BKCC_32_REG = 0x01;//2.730ms
    BKCC_33_REG = 0x00;//eq scan timer after clear error cnt when hw auto eq scan
    BKCC_36_REG = 0x08;//[7]can not set to 1; error counter uplimit [15:8]: 0x08;
    BKCC_37_REG = 0xff;//Error counter uplimit [7:0]: use default value is 0xff;
    BKCC_34_REG = 0x80;//[6:4]: Maximum numbler of retry attempt current EQ set to 3
                       //[1]: early retry mode enable
                       //[0]: Normal stage ajust EQ enable

    BKCC_2D_REG = 0x05;//Current EQ is considered to be good EQ when errorcounter less than this register value.
    #endif
}

void Drv_HdmiRx_Tmds_HwEqEn(void)
{
    #if HDMIRX_EQ_MODE == HW_MODE
    BKC7_FB_REG &= BIT7_0;//[7]rgd_hdmi21_mode: 0-hdmi20 eq

    BKC9_07_REG &= BIT0_0;//[0]eq soft reset: 0-reset enable -0628
    BKC9_07_REG |= BIT0_1;//[0]eq soft reset: 1-reset disable -0628

    BKCC_2C_REG |= BIT3_1;//hardware auto eq start,positive edge effective
    BKCC_2C_REG &= BIT3_0;
    #endif
}

#endif
#endif


#if ((CHIP_SEL == LT6911GXD_HD) || (CHIP_SEL == LT7911UXE_HD)) 
u8 Drv_HdmiRx_AudioChangeDetect(void)
{
    u8 current_audioFS = 0;
	
		current_audioFS = BKC6_7C_REG;
	
		if(abs(BKE0_91_REG - current_audioFS > 1))
		{
				if((current_audioFS==31)||(current_audioFS==32)||(current_audioFS==44)||(current_audioFS==47)||(current_audioFS==48)||(current_audioFS==95)||(current_audioFS==96)||(current_audioFS==191)||(current_audioFS==192))
				{
						BKE0_90_REG = 0x01;
						if((current_audioFS==31)||(current_audioFS==32))
						{
								BKE0_91_REG = 32;//audio sample rate
						}
						else if(current_audioFS==44)
						{
								BKE0_91_REG = 44;//audio sample rate
						}
						else if((current_audioFS==47)||(current_audioFS==48))
						{
								BKE0_91_REG = 48;//audio sample rate
						}
						else if((current_audioFS==95)||(current_audioFS==96))
						{
								BKE0_91_REG = 96;//audio sample rate
						}
						else if((current_audioFS==191)||(current_audioFS==192))
						{
								BKE0_91_REG = 192;//audio sample rate
						}
						return 1;
				}
				else if(current_audioFS==0)
				{
						BKE0_90_REG = 0x00;
						BKE0_91_REG = current_audioFS;//audio sample rate
						return 1;
				}
				else
				{
						return 0;
				}
		}
		else
		{
				return 0;
		}
}

u8 Drv_HdmiRx_VideoDisappearDetect()
{
		if(BKE0_84_REG != 0x00)
		{
				BKE0_84_REG = 0x00;//video interrupt type
				BKE0_90_REG = 0x00;//audio interrupt type
			
				//pixlClk
				BKE0_85_REG = 0;
				BKE0_86_REG = 0;
				BKE0_87_REG = 0;
			
				//resolution
				BKE0_88_REG = 0;
				BKE0_89_REG = 0;
				BKE0_8A_REG = 0;
				BKE0_8B_REG = 0;
				BKE0_8C_REG = 0;
				BKE0_8D_REG = 0;
				BKE0_8E_REG = 0;
				BKE0_8F_REG = 0;
			
				//audio sample rate
				BKE0_91_REG = 0;
			
				//Byteclk
				BKE0_92_REG = 0;
				BKE0_93_REG = 0;
				BKE0_94_REG = 0;
				
				//color space
				BKE0_95_REG = 0;
				BKE0_96_REG = 0;
				
				return 1;
		}
		else
		{
			  return 0;
		}
}
#endif