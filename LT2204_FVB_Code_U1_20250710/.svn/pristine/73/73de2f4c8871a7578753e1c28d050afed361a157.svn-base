  10          #if TX_PORT_SIGN == MIPI_PORT
              #if MIPITX_DSC == ENABLED
              
              DSCConfig_Stru g_stMipiTxDscEncConfig;
              StructTiming g_stMipiTxDscEncVideoTiming;
              
              
              void Drv_MipiTxDscEnc_Init(void)
              {               
                  BKEF_80_REG = 0x00;
                  BKEF_F8_REG = 0x00;
              
              #if RX_PORT_SIGN == DP_PORT     
                  BKA3_3E_REG = 0x11;//[3:0]rg_clkgen_dscout_divsel
                  BKA3_41_REG = 0x01;//[3:0]rg_clkgen_dsctx_dsc_divsel
                  BKA3_42_REG = 0x11;//[3:0]rg_clkgen_dsctx_dscrd_divsel
              #endif
                      
                  CLEAR_BIT(BKED_30_REG, BIT4);
                  CLEAR_BIT(BKF9_84_REG, BIT6);//1:DSC encode  , 0:DSC bypass
              }
              
              void Drv_MipiTxDscEnc_InitForPattern(void)
              {
                  BKEF_80_REG = 0x00;
                  BKEF_F8_REG = 0x00;
              
                  CLEAR_BIT(BKED_30_REG, BIT4);
                  CLEAR_BIT(BKF9_84_REG, BIT6);//1:DSC encode  , 0:DSC bypass 
              }
              
              void Drv_MipiTxDscEnc_ColorInfoGet()
              {
              #if RX_PORT_SIGN == HDMI_PORT
                  g_stMipiTxDscEncConfig.ucColorSpace = (BKCC_D0_REG & 0x70) >> 4; //Input Color space
                  g_stMipiTxDscEncConfig.ucColorDepth = BKCC_D7_REG & 0x0f;        //8 bit = 0x04
                  if (0x00 == g_stMipiTxDscEncConfig.ucColorDepth)
                  {
                      g_stMipiTxDscEncConfig.ucColorDepth = BPC8;
                  }
              #endif
              
              #if RX_PORT_SIGN == DP_PORT
                  g_stMipiTxDscEncConfig.ucColorSpace = Mod_DpRx_ColorSpace();//Input Color space
C51 COMPILER V9.53.0.0   DRVMIPIDSCENCTX                                                   02/13/2025 10:14:22 PAGE 2   

                  g_stMipiTxDscEncConfig.ucColorDepth = Mod_DpRx_ColorDepth() + 3;//+3: 4-8bit
              #endif
                  LTLog(LOG_DEBUG,"ColorSpace: %bd , ColorDepth: %bd", g_stMipiTxDscEncConfig.ucColorSpace, g_stMipiTxDs
             -cEncConfig.ucColorDepth);
              
              }
              
              void Drv_MipiTxDscEnc_TimingGet()
              {
                  memset(&g_stMipiTxDscEncVideoTiming,0,sizeof(StructTiming));
                  Drv_VideoCheckAll_Get(&g_stMipiTxDscEncVideoTiming);
                  LTLog(LOG_INFO, "DSC[H]: Htotal:%d,Hactive:%d,Hsw:%d,Hfp:%d,Hbp:%d,Hspol:%bd",  g_stMipiTxDscEncVideoT
             -iming.Htotal, g_stMipiTxDscEncVideoTiming.Hactive, g_stMipiTxDscEncVideoTiming.Hsw, g_stMipiTxDscEncVideoTiming.Hfp, g_s
             -tMipiTxDscEncVideoTiming.Hbp,g_stMipiTxDscEncVideoTiming.Hspol);
                  LTLog(LOG_INFO, "DSC[V]: Vtotal:%d,Vactive:%d,Vsw:%d,Vfp:%d,Vbp:%d,Vspol:%bd",  g_stMipiTxDscEncVideoT
             -iming.Vtotal, g_stMipiTxDscEncVideoTiming.Vactive, g_stMipiTxDscEncVideoTiming.Vsw, g_stMipiTxDscEncVideoTiming.Vfp, g_s
             -tMipiTxDscEncVideoTiming.Vbp,g_stMipiTxDscEncVideoTiming.Vspol);    
              
                  if (YCbCr420_3 == g_stMipiTxDscEncConfig.ucColorSpace )
                  {
                      g_stMipiTxDscEncVideoTiming.Hbp >>= 1;
                      g_stMipiTxDscEncVideoTiming.Hfp >>= 1;
                      g_stMipiTxDscEncVideoTiming.Hsw >>= 1;
                      g_stMipiTxDscEncVideoTiming.Htotal >>= 1;
                      g_stMipiTxDscEncVideoTiming.Hactive >>= 1;
                  }
              
              }
              
              void Drv_MipiTxDscEnc_InfoGet(void)
              {
                  Drv_MipiTxDscEnc_ColorInfoGet();
                  Drv_MipiTxDscEnc_TimingGet();
              }
              
              void Drv_MipiTxDscEnc_DataMux()
              {
                  //pps path set
                  Drv_System_SramPathSet(MIPITX_DSCENC_PPS_PATH);//-fywang- wait confirm
              
                  SET_BIT(BKF9_84_REG, BIT6);//1:DSC encode  , 0:DSC bypass
                  SET_BIT(BKED_30_REG, BIT4);//video check 需要选择dsc decode
              }
              
              void Drv_MipiTxDscEnc_ClkMux()
              {
                  u8 ucDiv;
                  u8 ucRatio;
                  u32 ulRdClk;
              
                  SET_BIT(BKE1_40_REG, BIT0);//[0]rgd_pps_data_wr_clk_src_sel: 1-sys clk
                   
                  BKA3_3E_REG &= 0xf0;//[3:0]rg_clkgen_dscout_divsel
                  BKA3_41_REG &= 0xf0;//[3:0]rg_clkgen_dsctx_dsc_divsel
                  BKA3_42_REG &= 0xf0;//[3:0]rg_clkgen_dsctx_dscrd_divsel
                  BKA3_42_REG |= 0x01;////0001-div2 recover to default clk
              
                  //ad_dsctx_dsc_out_clk set
                  if (YCbCr420_3 == g_stMipiTxDscEncConfig.ucColorSpace )
                  {
                      ucRatio = g_stMipiTxDscEncConfig.ucCompressRatio - 1;
                  }
C51 COMPILER V9.53.0.0   DRVMIPIDSCENCTX                                                   02/13/2025 10:14:22 PAGE 3   

                  else
                  {
                      ucRatio = g_stMipiTxDscEncConfig.ucCompressRatio * 2 - 1;
                  }
                  BKA3_3E_REG |= ucRatio;
              
                  //ad_dsctx_dsc_rd_clk set
                  Drv_System_FmSet(TOP_FM, TOPFM_AD_DSCTX_DSC_RD_CLK);
                  Ocm_Delay1ms(10);
                  ulRdClk = Drv_System_FmGet(TOP_FM, HALF_PIX_CLK);
                  
                  BKA3_42_REG &= 0xf0;//[3:0]rg_clkgen_dsctx_dscrd_divsel
                  if (ulRdClk > 400000)//400M
                  {
                      BKA3_42_REG |= 0x02;//0010-div3
                  }
                  else
                  {
                      BKA3_42_REG |= 0x01;//0001-div2
                  }
              
                  //Ad_dsctx_dsc_clk set
                  ucDiv = g_stMipiTxDscEncConfig.ucSliceNum;
                  if (YCbCr422_1 == g_stMipiTxDscEncConfig.ucColorSpace)
                  {
                      ucDiv *= 2;
                  }
                  if (ucDiv == 1)
                  {
                      BKA3_41_REG |= 0x02;//0010-div3
                  }
                  else
                  {
                      ucDiv = 0x08 | (ucDiv - 1);
                      BKA3_41_REG |= ucDiv;
                  }
              
                  Ocm_Delay1ms(100);
              
              
              }
              
