 559   3                              {
 560   4                                      ;
 561   4                              }
 562   3                              else if(BKE2_20_REG&BIT0_1)//cali fail
 563   3                              {
 564   4                                      ;
 565   4                              }
 566   3                              else
 567   3                              {
 568   4                                      break;
 569   4                              }
 570   3                      }
 571   2              }
 572   1              else if(UCC_DCC == DCC)
 573   1              {
 574   2                      BKE1_0A_REG &= BIT0_0;//UCC Cali logic reset
 575   2                      BKE1_0A_REG |= BIT0_1;//UCC Cali logic reset
 576   2                      DRV_CC_LogicRst(DCC);
 577   2                      BKA2_BB_REG = 0x82;//BIT5=VBUS_VTHYS
 578   2                      BKA2_BC_REG = 0x07;//BIT5=VBUS_VTHYS
 579   2                      BKA2_B3_REG = 0x24;//RG_UCC1_CC_EN
 580   2                      for(CC_Cali_Cnt=0;CC_Cali_Cnt<10;CC_Cali_Cnt++)
 581   2                      {
 582   3                              BKE2_19_REG &= BIT0_0;
 583   3                              Ocm_Delay1ms(1);
 584   3                              BKE2_19_REG |= BIT0_1;//UCC1 RTERM CAL
 585   3                              Ocm_Delay1ms(10);
 586   3                              if((BKE2_22_REG&BIT1_1) == 0x00)//cali done
 587   3                              {
 588   4                                      ;
 589   4                              }
 590   3                              else if(BKE2_22_REG&BIT0_1)//cali fail
 591   3                              {
 592   4                                      ;
 593   4                              }
 594   3                              else
 595   3                              {
 596   4                                      break;
 597   4                              }
 598   3                      }
 599   2              }
 600   1      }
