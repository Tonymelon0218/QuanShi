 324          void DRV_CC_LogicRst(u8 UCC_DCC) 
 325          {
 326   1              if(UCC_DCC == UCC)
 327   1              {
 328   2                      BKE1_0A_REG &= BIT2_0;//UCC logic soft reset
 329   2                      BKE1_0A_REG |= BIT2_1;//UCC logic soft reset
 330   2              }
 331   1              else if(UCC_DCC == DCC)
 332   1              {
 333   2                      BKE1_0A_REG &= BIT3_0;//DCC logic soft reset
 334   2                      BKE1_0A_REG |= BIT3_1;//DCC logic soft reset
 335   2              }
 336   1      }
