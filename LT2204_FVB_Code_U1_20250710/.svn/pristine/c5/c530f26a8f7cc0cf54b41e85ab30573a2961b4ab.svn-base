 541          void DRV_CCRterm_Cali(u8 UCC_DCC)
 542          {
 543   1              u8 CC_Cali_Cnt = 0;
 544   1              if(UCC_DCC == UCC)
 545   1              {
 546   2                      BKE1_0A_REG &= BIT1_0;//UCC Cali logic reset
