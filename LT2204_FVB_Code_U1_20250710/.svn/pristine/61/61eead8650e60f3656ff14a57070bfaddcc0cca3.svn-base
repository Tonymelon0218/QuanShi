#include "include.h"



#if RX_PORT_SIGN == HDMI_PORT

StructHdmiRx g_stHdmiRx;

void Mod_HdmiRx_PowerOnInit(void)
{
    memset(&g_stHdmiRx, 0, sizeof(StructHdmiRx));
    g_stHdmiRx.ucRxState = STATE_HDMIRX_POWER_ON_1;
}

void Mod_HdmiRx_VarInit()
{
    #if CHIP_SEL == LT6711GXE
    LT6711GXE_HdmiRxVarInit();
    #endif
    #if ((CHIP_SEL == LT6911GXD_HD) || (CHIP_SEL == LT7911UXE_HD))
    LT6911GXE_HdmiRxVarInit();
    #endif
    #if CHIP_SEL == LT86121GXE
    LT86121GXE_HdmiRxVarInit();
    #endif
}

void Mod_HdmiRx_MsgNotify(u8 ucEvent)
{
    #if CHIP_SEL == LT6711GXE
    LT6711GXE_HdmiRxMsgNotify(ucEvent);
    #endif
    #if ((CHIP_SEL == LT6911GXD_HD) || (CHIP_SEL == LT7911UXE_HD))
    LT6911GXE_HdmiRxMsgNotify(ucEvent);
    #endif
    #if CHIP_SEL == LT86121GXE
    LT86121GXE_HdmiRxMsgNotify(ucEvent);
    #endif
}

u8 Mod_HdmiRx_TimeOutCheck(u8 ucOpt)
{
    u8 ucRtn = FALSE;
    static u32 ulCurrentTime = 0;

    if (DISABLED == ucOpt)
    {
        Ocm_Timer_UpdLocalTime(&ulCurrentTime);
    }

    if (g_stHdmiRx.ucRxState < STATE_HDMIRX_PLAY_BACK_18)
    {
        if(Ocm_Timer_IsOverFlow(&ulCurrentTime, SECOND_12) == TRUE)
        {
            ucRtn = TRUE;
            Drv_HdmiRx_HpdSet(LOW);
            Ocm_Delay1ms(500);
            Ocm_Timer_UpdLocalTime(&ulCurrentTime);
        }
    }
    return ucRtn;
}


void Mod_HdmiRx_SetState(u8 ucState)
{
    u8 ucLastState;
    
    if(ucState != g_stHdmiRx.ucRxState)
    {    
        ucLastState = g_stHdmiRx.ucRxState;
        g_stHdmiRx.ucRxState = ucState;
        g_stHdmiRx.b1RxStateChanged = TRUE;
        printLT(PRINT_PRIO_TEST, "\nRxState = %bd",ucState);

        // other state-->STATE_DPRX_PLAY_BACK,need notify video on
        if(g_stHdmiRx.ucRxState == STATE_HDMIRX_PLAY_BACK_18)
        {

            Mod_HdmiRx_MsgNotify(HDMIRX_INTERLACE_EVENT);
            Mod_HdmiRx_MsgNotify(HDMIRX_VIDEO_ON_EVENT);
            #ifdef NVIDIA_FW_EN
            #if (CUSTOMER_DEFINED == ENABLED)
            Drv_IOSoftLevel_Set(GPIO17_SCLKA, HIGH); //for nvidia case 1: hdmi rx stable 0: hdmi rx unstable      
            #endif
            #endif
        }

        //STATE_DPRX_PLAY_BACK_16-->other state,need notify video off
        if(ucLastState == STATE_HDMIRX_PLAY_BACK_18)
        {
            Mod_HdmiRx_MsgNotify(HDMIRX_VIDEO_OFF_EVENT);
            #ifdef NVIDIA_FW_EN
            #if (CUSTOMER_DEFINED == ENABLED)
            Drv_IOSoftLevel_Set(GPIO17_SCLKA, LOW); //for nvidia case 1: hdmi rx stable 0: hdmi rx unstable      
            #endif
            #endif
            Mod_HdmiRx_TimeOutCheck(DISABLED);
        }
    }
}

void Mod_HdmiRx_SourceDetProc(void)
{
    if(g_stHdmiRx.ucRxState >= STATE_HDMIRX_WAITE_SOURCE_2)
    {
        //the last source detect is high.
        if(g_stHdmiRx.b1SourceDet == HIGH)
        {
            //the current source detect is low.
            if(Drv_GetIO_State(GPIO2_DHRX_DCAUXN_5VDET) == FALSE)   
            {
                Drv_HdmiRx_ErrValidClr(ENABLED);
                Mod_HdmiRx_SetState(STATE_HDMIRX_WAITE_SOURCE_2);          
                Mod_HdmiRx_HpdLowAction();
                g_stHdmiRx.b1SourceDet = LOW;
                Mod_HdmiRx_MsgNotify(HDMIRX_SOURECE_UNPLUG_EVENT);
                printLT(PRINT_PRIO_HIG, "\nHdmi rx unplug");
            }
        }
        //the last source detect is low.
        else
        {
            //the current source detect is high.
            if (Drv_GetIO_State(GPIO2_DHRX_DCAUXN_5VDET) == TRUE)
            {
                g_stHdmiRx.b1SourceDet = HIGH;
                Mod_HdmiRx_MsgNotify(HDMIRX_SOURECE_PLUG_EVENT);
                printLT(PRINT_PRIO_HIG, "\nHdmi rx plug");
            }
        }
    }
}

u8 Mod_HdmiRx_PcrStableCheck(void)
{
    if (g_stHdmiRx.ucHdmiVer == HDMI21)
    {
        if (BKC8_B4_REG & BIT2_1)
        {
            return STABLE;
        }
    }
    return UNSTABLE;
}

u8 Mod_HdmiRx_SecPcrStableCheck(void)
{
    #if ((CHIP_SEL == LT86121GXE))//121 case
    #if DSC_USER_DEFINE_PKT_EN == ENABLED
    return STABLE;
    #endif
    #endif

    if (g_stHdmiRx.ucHdmiVer == HDMI21)
    {
        if (BKC8_B4_REG & BIT1_1)
        {
            return STABLE;
        }
    }
    return UNSTABLE;
}

void Mod_HdmiRx_AudioSampleFlagChk(void)
{
    #if TX_AUDIO_SEL == RX_AUDIO_DATA
    u8 ucAudioFS;
    u8 ucAspSampleFlat;
    u8 ucAspSamplePresent;
    u8 uGcpPacketSetMute = 0;
    u8 ucAudioOut = ON;
    static u8 ucAudioState = ON;

    ucAudioFS = BKC6_7C_REG;//audio fs val
    if((47 <= ucAudioFS) && (49 >= ucAudioFS))
    {
        ucAspSampleFlat    = BKCC_9B_REG & BIT0_1;
        ucAspSamplePresent = BKCC_9A_REG & BIT0_1;
        if((0 == ucAspSamplePresent) || ((1 == ucAspSamplePresent) && (1 == ucAspSampleFlat)))
        {
            ucAudioOut = OFF;
        }
        else
        {
            ucAudioOut = ON;
        }
    }

    //gcp set_avmute should mute else mute clear
    if (BKCC_F3_REG & BIT2_1)//not find gcp, return
    {
        BKCC_58_REG |= BIT6_1;//gcp pkt clr en
        BKCC_58_REG &= BIT6_0;//gcp pkt clr dis
        uGcpPacketSetMute = BKCC_9C_REG & BIT0_1;
        if(1 == uGcpPacketSetMute)
        {
             ucAudioOut = OFF;
        }
        else
        {
             ucAudioOut = ON;
        }
    }

    if (ucAudioState != ucAudioOut)
    {
        ucAudioState = ucAudioOut;
        if (ucAudioOut == OFF)
        {
            Mod_HdmiRx_MsgNotify(HDMIRX_AUDIO_MUTE_EN);
        }
        else
        {
            Mod_HdmiRx_MsgNotify(HDMIRX_AUDIO_MUTE_DIS);
        }
        if (1 == uGcpPacketSetMute)
        {
            Mod_HdmiRx_MsgNotify(HDMIRX_VIDEO_MUTE_EN);
        }
        else
        {
            Mod_HdmiRx_MsgNotify(HDMIRX_VIDEO_MUTE_DIS);
        }
    }
    #endif
}

bool Mod_HdmiRx_PcrColorSpaceUpdata(void)
{
    ColorInfo_S stColorInfo;

    //no need updata.
    Drv_HdmiRx_ColorInfoGet(&stColorInfo);
    if ((g_stHdmiRx.ucPixelEncoding == stColorInfo.ucPixelEncoding) &&
        (g_stHdmiRx.ucColorimetryFormat == stColorInfo.ucColorimetryFormat) &&
        (g_stHdmiRx.ucBitDepth == stColorInfo.ucBitDepth))
    {
        return FALSE;
    }
    g_stHdmiRx.ucPixelEncoding     = stColorInfo.ucPixelEncoding;
    g_stHdmiRx.ucColorimetryFormat = stColorInfo.ucColorimetryFormat;
    g_stHdmiRx.ucBitDepth          = stColorInfo.ucBitDepth;

    return TRUE;
}

