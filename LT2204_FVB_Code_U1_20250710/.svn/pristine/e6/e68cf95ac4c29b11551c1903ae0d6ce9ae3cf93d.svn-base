#include "include.h"

#if RX_PORT_SIGN == DP_PORT

#if DPRX_DSC_BYPASS_SUPPORT == ENABLED

LtTiming_S g_stDpRxDscByTiming;
DscDecInfo_S g_stDpRxDscByInfo;

void Drv_DpRxDscBy_ParaInit(void)
{
    memset(&g_stDpRxDscByInfo, 0, sizeof(DscDecInfo_S));
    memset(&g_stDpRxDscByTiming, 0, sizeof(LtTiming_S));
}

void Drv_DpRxDscBy_RxInit(void)
{
    Drv_System_SramPathSet(DPRX_INIT_SET_PATH);

    Drv_System_IntSet(IRQ_DPRX_PPS_PKT_INT,ON);
//    Drv_System_IntClr(IRQ_DPRX_PPS_PKT_INT);
		//if 0x80, huawei 800*600 NG
	BKF3_00_REG = 0x40;//pixel count save for fifo for dsc
    //color depth force to 8bit for dsc mode
    BKF3_0A_REG |= BIT7_1;//[7]rg_depth_soft_mode, 1-soft mode
    BKF3_16_REG &= 0xe3;
    BKF3_16_REG |= BIT2_1;//[4:2]the value of pixel_depth in soft mode
    //color space force to RGB for dsc mode
    BKF3_05_REG |= BIT7_1;//[7]rg_format_soft_mode, 1-soft mode
    BKF3_16_REG &= 0xfc;//[1:0]the value of pixel_format in soft mode

    //[7]dp dsc stream
    BKF3_82_REG = 0x20;//hsync delay
    BKF3_69_REG = 0x08;//hsync width
    //[7]dsc data swap enable: 1-en; [6]Dsc enable select: 1-software en;
    BKF3_63_REG |= 0xd0;//[4]software dsc enable

//    BKF3_77_REG &= BIT0_0;//[0]rg_pcr_restart_mode: 0-sram fifo overflow
    BKF3_83_REG &= BIT7_0;//[7]rg_dsc_bypass: 1-not bypass
}

void Drv_DpRxDscBy_TimingGet(void)
{
    Drv_DpRx_RxTimingGet(&g_stDpRxDscByTiming);//-wangtt- wait update

    #if 1
    printLT(PRINT_PRIO_TEST, "\n=============DscBypass Info=============");
    printLT(PRINT_PRIO_TEST, "\nHbp   : %-4d  Vbp   : %-4d", g_stDpRxDscByTiming.usHbp,g_stDpRxDscByTiming.usVbp);
    printLT(PRINT_PRIO_TEST, "\nHfp   : %-4d  Vfp   : %-4d", g_stDpRxDscByTiming.usHfp,g_stDpRxDscByTiming.usVfp);
    printLT(PRINT_PRIO_TEST, "\nHsync : %-4d  Vsync : %-4d", g_stDpRxDscByTiming.usHsync,g_stDpRxDscByTiming.usVsync);
    printLT(PRINT_PRIO_TEST, "\nHact  : %-4d  Vact  : %-4d", g_stDpRxDscByTiming.usHact,g_stDpRxDscByTiming.usVact);
    printLT(PRINT_PRIO_TEST, "\nHtol  : %-4d  Vtol  : %-4d", g_stDpRxDscByTiming.usHtol,g_stDpRxDscByTiming.usVtol);
    #endif
}

