 178          //========================================================================
 179          // Func Name   : eq check in pre detect
 180          // Description : 如果第一档eq比较差，会导致EqCheckIn中断无法启动，
 181          //               需要通过该函数辅助启动
 182          // Input       : void  
 183          // Output      : None
 184          // Return      : u8
 185          //========================================================================
 186          void Mod_HdmiRxEq_EqCheckInPreDet(void)
 187          {
 188   1          u8 ucEqIdx;
 189   1          for (ucEqIdx = 0; ucEqIdx < HDMIRX_EQ_STAGE; ucEqIdx++)
 190   1          {
 191   2              if((BKCD_E6_REG & BIT6_1)||(BKCD_E6_REG & BIT0_1))//eq check in int flag
 192   2              {
 193   3                  break;
 194   3              }
 195   2              Mod_HdmiRxEq_Frl_ValSet(LANE_ALL, HDMI21_EQ[ucEqIdx]);
 196   2              Ocm_Delay1ms(1);
 197   2          }
 198   1          if(ucEqIdx >= HDMIRX_EQ_STAGE) //pixe > 600M solve 980 change frl off，No video and eq checkin not val
             -id
 199   1          {
 200   2              BKCD_16_REG |= 0x30;
 201   2              BKCD_16_REG &= 0xcf; 
 202   2          }
 203   1          memset(&BKA1_13_REG,0x00,8);
 204   1      }
