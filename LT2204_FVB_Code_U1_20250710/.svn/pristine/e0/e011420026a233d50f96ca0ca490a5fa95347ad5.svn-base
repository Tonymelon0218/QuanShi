              void Mod_DisPlayIDBlock_Update(u8 *pucEDID_Data)
              {
                  u8 ucLoop_Offset,ucLoop_x;
                  u8 ucloopCnt0,ucloopCnt1;
                  #if RX_PORT_SIGN == HDMI_PORT
                  #if (HDMIRX_DSC_BYPASS_SUPPORT == ENABLED)
                  if(g_stHdmiEdidInfo.ucMaxFrlDscRate > 0)
                  {
                      return;
                  }
                  #endif
                  #endif
                  #if RX_PORT_SIGN == DP_PORT
                  #if (DPRX_DSC_BYPASS_SUPPORT == ENABLED)
                  if(g_stHdmiEdidInfo.ucMaxFrlDscRate > 0)
                  {
                      return;
                  }
                  #endif
                  #endif
                      ucloopCnt0 = 0x05 + pucEDID_Data[0x02];//in case of biger than 0xff;
                  for(ucLoop_Offset = 0x05; ucLoop_Offset< ucloopCnt0;)
                  {
                      g_stHdmiEdidInfo.ucBlockTag = pucEDID_Data[ucLoop_Offset];
                      g_stHdmiEdidInfo.ucBlockLen = pucEDID_Data[ucLoop_Offset+2];
                      if((g_stHdmiEdidInfo.ucBlockTag == 0x00)&&(g_stHdmiEdidInfo.ucBlockLen == 0x00)) 
C51 COMPILER V9.53.0.0   MODHDMIEDID                                                       02/13/2025 10:14:07 PAGE 13  

                      {
                          break;
                      }
                      switch(g_stHdmiEdidInfo.ucBlockTag)
                      {
                          case 0x03:   
                                              ucloopCnt1 = ucLoop_Offset +g_stHdmiEdidInfo.ucBlockLen+3;
                              for(ucLoop_x = (ucLoop_Offset+3);ucLoop_x < ucloopCnt1;ucLoop_x += 20)
                              {
                                  if(((pucEDID_Data[ucLoop_x+1]> 0x32)&&(pucEDID_Data[ucLoop_x+2]== 2))||(pucEDID_Data[u
             -cLoop_x+2]> 2))// Over 1440Mhz
                                  {
                                      memset(&pucEDID_Data[ucLoop_x],0x00,20);
                                  }
                              } 
                              break;
                          default :
                          break;
                      }
                      ucLoop_Offset += g_stHdmiEdidInfo.ucBlockLen +3;
                  }
              }
              
              void Mod_HdmiEdid_Update(u8 *pucEDID_Data)
              {
                  u8 ucLoop_edid;
                  u16 usEdid_Offset;
                  for(ucLoop_edid = 0; ucLoop_edid < 4; ucLoop_edid++)
                  {
                      usEdid_Offset = (u16)ucLoop_edid * 0x80;
                      if((pucEDID_Data[usEdid_Offset] == 0x00) && (pucEDID_Data[usEdid_Offset+1] == 0xff))
                      {
                          #if RX_PORT_SIGN == DP_PORT
                                      #if DPRX_DFP_TYPE == BRANCH_DP
                          Mod_Block0_Update(&pucEDID_Data[usEdid_Offset]);
                                      #endif
                          #endif
                          Mod_Check_Sum(&pucEDID_Data[usEdid_Offset]);
                      }
                      else if((pucEDID_Data[usEdid_Offset] == 0x02) && (pucEDID_Data[usEdid_Offset+1] >= 0x02))
                      {
                          Mod_CtaBlock_Update(&pucEDID_Data[usEdid_Offset]);
                          Mod_Check_Sum(&pucEDID_Data[usEdid_Offset]);
                      }
                      else if(pucEDID_Data[usEdid_Offset] == 0x70)
                      {
                          Mod_DisPlayIDBlock_Update(&pucEDID_Data[usEdid_Offset]);
                          Mod_Check_DisplayIdSum(&pucEDID_Data[usEdid_Offset]);
                          Mod_Check_Sum(&pucEDID_Data[usEdid_Offset]);
                      }
                      if(ucLoop_edid >= pucEDID_Data[0x7e])
                      {
                          break;
                      }        
                  }
              }
              
