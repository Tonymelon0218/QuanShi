              EDID_S g_stHdmiEdidInfo;
              
              u8 Mod_Check_Sum(u8 *pucEDID_Data)
              {
                  u8 ucCheckSum = 0x00;
                  u8 ucloop;
                  for (ucloop = 0; ucloop<0x7F; ucloop++)
                  {
                      ucCheckSum += pucEDID_Data[ucloop]; //checksum
                  }
                  pucEDID_Data[0x7F] = (256 - ucCheckSum)%256;
                      return pucEDID_Data[0x7F];
              }
              
              void Mod_Check_DisplayIdSum(u8 *pucEDID_Data)
              {
                  u8 ucCheckSum = 0x00;
                  u8 ucCheckSumLocation;
                  u8 ucloop;
                  ucCheckSumLocation = (0x05 + pucEDID_Data[0x02]);
                  for (ucloop = 0x01; ucloop < ucCheckSumLocation; ucloop++)
                  {
                      ucCheckSum += pucEDID_Data[ucloop]; //checksum
                  }
                  pucEDID_Data[ucCheckSumLocation] = (256-ucCheckSum)%256;
              }
              
              void Mod_HdmiEdid_Init(void)
              {
                  memset(&g_stHdmiEdidInfo, 0, sizeof(EDID_S));
              }
              
              void Mod_HdmiEdid_Block0Analysis(u8 *pucEDID_Data)
              {
                  //pucEDID_Data = NULL;
                  g_stHdmiEdidInfo.b1EdidType = EDID_HDMITYPE;
                  if((pucEDID_Data[0x12] == 0x01)&&(pucEDID_Data[0x12] >= 0x04))
                  {
                      g_stHdmiEdidInfo.b1EdidType = EDID_DPTYPE;
                  }
              }
              
              void Mod_HdmiEdid_DisplayIdBlockAnalysis(u8 *pucEDID_Data)
              {
                  pucEDID_Data = NULL;
              }
              
              void Mod_VSDB_Handle(u8 *pucEDID_Data,u8 ucLoop_Offset)
              {
                  #if RX_PORT_SIGN == HDMI_PORT
                  u8 ucFrl_Rate;
                  #endif
                      g_stHdmiEdidInfo.b1HdmiMode    = 1;
