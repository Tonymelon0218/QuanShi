                      if((g_stHdmiEdidInfo.ucMaxFrlRate == TRUE)||(g_stHdmiEdidInfo.ucMaxFrlDscRate))
                      {               
                              Drv_HdmiTx_WriteI2CByte(0xa831,0x00);//a831[7:4]ffe lvl, [3:0]frl rate
                      }
              }
              
              void Mod_HdmiEdid_Analysis(u8 *pucEDID_Data)
              {
                  u8 ucLoop_edid;
                  u16 usEdid_Offset;
                      #if RX_PORT_SIGN == HDMI_PORT
                  u8 ucNoCta_Flag;
                      #endif
                      u8 ucTempSwap, ucLoop_cnt;
                  g_stHdmiEdidInfo.ucHdmiTmdsClk = 0x1E;
                      #if RX_PORT_SIGN == HDMI_PORT
                  for(ucLoop_edid = 0; ucLoop_edid< 4;ucLoop_edid++) //sumsang 4block edid
                  {
                      usEdid_Offset = (u16)ucLoop_edid * 0x80;;
                      if((pucEDID_Data[usEdid_Offset] == 0xf0)&&(pucEDID_Data[0x7e] >= 1))
                      {
                          if(pucEDID_Data[0x7e] >= 2)
                          {
                              for(ucLoop_cnt = 0;ucLoop_cnt< 128;ucLoop_cnt++)
                              {
C51 COMPILER V9.53.0.0   MODHDMIEDID                                                       02/13/2025 10:14:07 PAGE 8   

                                  pucEDID_Data[usEdid_Offset|ucLoop_cnt] = pucEDID_Data[(usEdid_Offset+0x80)|ucLoop_cnt]
             -;
                              }
                          }
                          if(pucEDID_Data[0x7e] >= 3)
                          {
                              for(ucLoop_cnt = 0;ucLoop_cnt< 128;ucLoop_cnt++)
                              {
                                  pucEDID_Data[(usEdid_Offset+0x80)|ucLoop_cnt] = pucEDID_Data[(usEdid_Offset+0x100)|ucL
             -oop_cnt];
                              }
                          }
                          pucEDID_Data[0x7e] -= 1;
                          break;
                      }
                  }
                      #endif
                  for(ucLoop_edid = 0; ucLoop_edid< 4;ucLoop_edid++)
                  {
                              #if RX_PORT_SIGN == HDMI_PORT
                      ucNoCta_Flag = 1;
                              #endif
                      usEdid_Offset = (u16)ucLoop_edid * 0x80;
                      if((pucEDID_Data[usEdid_Offset] == 0x02)&&(pucEDID_Data[usEdid_Offset+1] >= 0x02))
                      {
                                      #if RX_PORT_SIGN == HDMI_PORT
                          ucNoCta_Flag = 0;
                                      #endif
                          if((ucLoop_edid == 2)||(ucLoop_edid == 3))
                          {
                              for(ucLoop_cnt = 0;ucLoop_cnt< 128;ucLoop_cnt++)
                              {
                                  ucTempSwap = pucEDID_Data[usEdid_Offset|ucLoop_cnt];
                                  pucEDID_Data[usEdid_Offset|ucLoop_cnt] = pucEDID_Data[0x80|ucLoop_cnt];
                                  pucEDID_Data[0x80|ucLoop_cnt]  = ucTempSwap;
                              }
                          }
                          break;
                      }
                      if(ucLoop_edid >= pucEDID_Data[0x7e])
                      {
                          break;
                      }
                  }
                  #if RX_PORT_SIGN == HDMI_PORT
                  if(ucNoCta_Flag == 1)
                  {
                      for(ucLoop_cnt = 0;ucLoop_cnt< 128;ucLoop_cnt++)
                      {
                          pucEDID_Data[0x180|ucLoop_cnt] = pucEDID_Data[0x100|ucLoop_cnt];
                          pucEDID_Data[0x100|ucLoop_cnt] = pucEDID_Data[0x80|ucLoop_cnt];
                          pucEDID_Data[0x80|ucLoop_cnt]  = szEdidDefault[0x80|ucLoop_cnt];
                      }
                      if(pucEDID_Data[0x7e] <= 2)
                      {
                          pucEDID_Data[0x7e] += 1;
                      }
                  }
                  #endif
                  for(ucLoop_edid = 0; ucLoop_edid < 4; ucLoop_edid++)
                  {
                      usEdid_Offset = (u16)ucLoop_edid * 0x80;
C51 COMPILER V9.53.0.0   MODHDMIEDID                                                       02/13/2025 10:14:07 PAGE 9   

                      if((pucEDID_Data[usEdid_Offset] == 0x00) && (pucEDID_Data[usEdid_Offset+1] == 0xff))
                      {
                          Mod_HdmiEdid_Block0Analysis(&pucEDID_Data[usEdid_Offset]);
                      }
                      else if((pucEDID_Data[usEdid_Offset] == 0x02) && (pucEDID_Data[usEdid_Offset+1] >= 0x02))
                      {
                          Mod_HdmiEdid_CtaBlockAnalysis(&pucEDID_Data[usEdid_Offset]);
                      }
                      else if(pucEDID_Data[usEdid_Offset] == 0x70)
                      {
                          Mod_HdmiEdid_DisplayIdBlockAnalysis(&pucEDID_Data[usEdid_Offset]);
