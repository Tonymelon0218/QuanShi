              u8 Mod_Edid_ModeDet(void)
              {
                  if(g_stHdmiEdidInfo.b1EdidType == EDID_DPTYPE)
                  {
                      return TRUE;
                  }
                  return g_stHdmiEdidInfo.b1HdmiMode;
              }
              
              u8 Mod_EdidHdmi20_Get(void)
              {
                  if(g_stHdmiEdidInfo.b1EdidType == EDID_DPTYPE)
                  {
                      return TRUE;
                  }
                  return g_stHdmiEdidInfo.b1Hdmi20Edid;
              }
              
