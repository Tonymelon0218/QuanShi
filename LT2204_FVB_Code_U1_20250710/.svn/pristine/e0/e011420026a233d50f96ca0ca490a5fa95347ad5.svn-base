                              #if RX_PORT_SIGN == DP_PORT
                              if(g_stHdmiEdidInfo.ucMaxFrlRate > HDMITX_MAX_FRL_RATE)
                              {
                                      pucEDID_Data[ucLoop_Offset+7] &= 0x0b;//remove frl
                                      g_stHdmiEdidInfo.ucMaxFrlRate = HDMITX_MAX_FRL_RATE;
                                      pucEDID_Data[ucLoop_Offset+7] |= g_stHdmiEdidInfo.ucMaxFrlRate<<4;
                              }               
                              #endif
              
                              #if RX_PORT_SIGN == HDMI_PORT
                              #if HDMIRX_MAX_FRL_RATE >= FRL_3G3LANE
                              if(g_stHdmiEdidInfo.ucMaxFrlRate > HDMIRX_MAX_FRL_RATE)
                              {
                                      pucEDID_Data[ucLoop_Offset+7] &= 0x08;//remove 10bit 12bit
                                      ucFrl_Rate                    = HDMIRX_MAX_FRL_RATE;
                                      pucEDID_Data[ucLoop_Offset+7] |= ucFrl_Rate<<4;
                              }
                              #endif
                              #if HDMITX_MAX_FRL_RATE >= FRL_3G3LANE
                              if(g_stHdmiEdidInfo.ucMaxFrlRate > HDMITX_MAX_FRL_RATE)
                              {
                                      g_stHdmiEdidInfo.ucMaxFrlRate = HDMITX_MAX_FRL_RATE;
                              }
                              #endif
                              #endif
                      }
                      #if HDMITX_VRR_SUPPORT == ENABLED
                      if(g_stHdmiEdidInfo.ucBlockLen >= 8)
                      {
                              if(pucEDID_Data[ucLoop_Offset+8]&0x38)
                              {
                                      g_stHdmiEdidInfo.b1EdidWithVrr = TRUE;
                              }
                      }
                      #endif
                  #if RX_PORT_SIGN == HDMI_PORT
                      if(g_stHdmiEdidInfo.ucBlockLen >= 10)
