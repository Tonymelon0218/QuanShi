                      if(ucLoop_edid >= pucEDID_Data[0x7e])
                      {
                          break;
                      }        
                  }
                      //HFR-1-69
                      if((g_stHdmiEdidInfo.ucHF_EEODBLength != 0)&&(pucEDID_Data[0x7e] == 0x01))
                      {
                      if(g_stHdmiEdidInfo.ucHF_EEODBLength >= 2)
                      {
                          Drv_HdmiTx_ReadI2CByteN(0x01,0xA000,&pucEDID_Data[0x100],128);
