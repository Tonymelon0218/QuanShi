                              }
                              if(g_stHdmiEdidInfo.ucHF_EEODBLength >= 7)
                              {
                                      Drv_HdmiTx_ReadI2CByteN(0x03,0xA080,&pucEDID_Data[0x380],128);
                              }
                              if(g_stHdmiEdidInfo.ucHF_EEODBLength <= 7)
                              {
                                      pucEDID_Data[0x7e] = g_stHdmiEdidInfo.ucHF_EEODBLength;
                              }
                              else
                              {
                                      pucEDID_Data[0x7e] = 7;
                              }
                      #else
                      if(g_stHdmiEdidInfo.ucHF_EEODBLength >= 4)
                              {
                                      pucEDID_Data[0x7e] = 4;
                              }
                              else
                              {
                                      ;
                              }
