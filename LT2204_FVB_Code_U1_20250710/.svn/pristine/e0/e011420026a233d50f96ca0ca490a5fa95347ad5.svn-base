                              else if(pucEDID_Data[ucLoop_Offset+1] == 0x22)//DisplayID Type VII Video Timing Data Block
                              {
                                  if((pucEDID_Data[ucLoop_Offset+5] > 0)||((pucEDID_Data[ucLoop_Offset+4] >= 0x75)&&(puc
             -EDID_Data[ucLoop_Offset+5] == 0)))
                                  {
                                      g_stHdmiEdidInfo.b1Hdmi20Edid = TRUE;
                                  }
                              }
                                              else if(((pucEDID_Data[ucLoop_Offset] & 0x1F)>= 0x02)&&(pucEDID_Data[ucLoop_Offset+1] == 0x78))//HF-EE
             -ODB
                                              {
                                                      g_stHdmiEdidInfo.ucHF_EEODBLength = pucEDID_Data[ucLoop_Offset+2];
