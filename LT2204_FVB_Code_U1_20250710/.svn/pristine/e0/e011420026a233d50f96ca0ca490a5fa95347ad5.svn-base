              void Mod_Edid_Update(u8 *pEdidData)
              {
                  Mod_HdmiEdid_Init();
                  Mod_HdmiEdid_Analysis(pEdidData);
                      
                  Mod_HdmiEdid_Update(pEdidData);
                  #if RX_PORT_SIGN == DP_PORT
                  #if ((DEBUG_DPRX_EDID_PRINT_EN == ENABLED))
                  Mod_Edid_DpModePrint(pEdidData);
                  #endif
                  #if DPRX_ADAPTIVE_SYNC == ENABLED
                      g_stDpRx.ucAdaptiveSync_En = g_stHdmiEdidInfo.b1EdidWithVrr;
                      #endif
                  #endif
                  
                  #if RX_PORT_SIGN == HDMI_PORT
                  #if ((DEBUG_HDMIRX_EDID_PRINT_EN == ENABLED))
                  Mod_Edid_HdmiModePrint(pEdidData);
                  #endif
                  #endif
                      
                      g_stHdmiTx.b1HdmiMode = Mod_Edid_ModeDet();
              }
