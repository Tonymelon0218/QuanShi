//                           hstart     vstart    hactive   vactive   htotal    vtotal    hsync vsync divset freqset
u8 code timing480p60hz[17] = {0x00,0x44,0x00,0x1b,0x01,0x40,0x01,0xe0,0x01,0x90,0x02,0x0d,0x00,0x30,0x02,0x40,0xe0};
u8 code timing720p60hz[17] = {0x00,0x82,0x00,0x19,0x02,0x80,0x02,0xd0,0x03,0x39,0x02,0xee,0x00,0x14,0x05,0x2f,0xd0};
u8 code timing1080p60hz[17] ={0x00,0x60,0x00,0x29,0x03,0xc0,0x04,0x38,0x04,0x4c,0x04,0x65,0x00,0x16,0x05,0x2f,0xc0};
u8 code timing4k30hz[17] =   {0x00,0xc0,0x00,0x52,0x07,0x80,0x08,0x70,0x08,0x98,0x08,0xca,0x00,0x2c,0x0a,0x2f,0xb0};
u8 code timing4k60hz[17] =   {0x00,0xc0,0x00,0x52,0x07,0x80,0x08,0x70,0x08,0x98,0x08,0xca,0x00,0x2c,0x0a,0x2f,0xa0};
u8 code timing4k120hz[17] =  {0x00,0xc0,0x00,0x52,0x07,0x80,0x08,0x70,0x08,0x98,0x08,0xca,0x00,0x2c,0x0a,0x2f,0x90};
u8 code timing8k30hz[17] =   {0x01,0x80,0x00,0x40,0x0F,0x00,0x10,0xE0,0x11,0x94,0x11,0x30,0x00,0x58,0x14,0x2F,0x90};   
#endif
    
//===========================================
//func  :xtal init
//input :N/A
//output:N/A
//return:void
//Info  :N/A
//===========================================
void Drv_System_XtalSet(void)
{
    u8 ucSyspll_Cnt;
    
    BKA3_00_REG &= BIT7_0;//[7]rg_syspll_pd: 0-normal work, 1-power down;
    BKA3_02_REG |= BIT0_1;// syspll 600M enable
    
    BKA3_00_REG |= BIT6_1; 
    BKE2_89_REG = 0x20;//ks = 2
    ucSyspll_Cnt = 0;
    do
    {
        BKE2_89_REG &= BIT6_0;
        BKE1_09_REG &= 0xfc;
        BKE1_09_REG |= 0x03;
        BKE2_89_REG |= BIT6_1;
        Ocm_Delay1ms(5);
    }while((ucSyspll_Cnt < 3)&&((BKE2_93_REG&BIT6_1) == 0x00));
    BKA3_00_REG &= BIT6_0; 
    #if SYSCLK == SYS_CLK_40M
    BKE6_E9_REG |= 0x50;//

    BKC7_46_REG = 0x9c;//rgd_fm_fm_timer_set[15:8]
    BKC7_47_REG = 0x40;//rgd_fm_fm_timer_set[ 7:0]

    BKE2_A1_REG = 0x9c;//rgd_fm_timer_set[15:8]
    BKE2_A2_REG = 0x40;//rgd_fm_timer_set[ 7:0]

    BKE6_96_REG = 0x9c;//rgd_top_fm_fm_timer_set[15:8]
    BKE6_97_REG = 0x40;//rgd_top_fm_fm_timer_set[ 7:0]

    BKED_38_REG = 0x9c;//rgd_txfm_fm_timer_set[15:8]
    BKED_39_REG = 0x40;//rgd_txfm_fm_timer_set[ 7:0]
    #endif

    #if SYSCLK == SYS_CLK_48M
    BKE6_E9_REG |= 0x60;//

    BKC7_46_REG = 0xbb;//rgd_fm_fm_timer_set[15:8]
    BKC7_47_REG = 0x80;//rgd_fm_fm_timer_set[ 7:0]

    BKE2_A1_REG = 0xbb;//rgd_fm_timer_set[15:8]
    BKE2_A2_REG = 0x80;//rgd_fm_timer_set[ 7:0]

    BKE6_96_REG = 0xbb;//rgd_top_fm_fm_timer_set[15:8]
    BKE6_97_REG = 0x80;//rgd_top_fm_fm_timer_set[ 7:0]

    BKED_38_REG = 0xbb;//rgd_txfm_fm_timer_set[15:8]
    BKED_39_REG = 0x80;//rgd_txfm_fm_timer_set[ 7:0]
    #endif
}

//===============================================
//func  :enable  int for lt8711
//input : Int typec   IS ON/OFF
//output:N/A
//return:void
//Info  :N/A
//================================================
void Drv_System_IntSet(EnumInterrupt ucIntType, u8 b1IsOn)
{
    switch(ucIntType)
    {
        case IRQ_RXPLL_UNSTB_INT:
            break;

        #if RX_PORT_SIGN == DP_PORT
        case IRQ_DPRX_AUX_INT:
            (b1IsOn)?(BKE5_00_REG &= BIT7_0):(BKE5_00_REG |= BIT7_1);
            break;
        #if DPRX_ADAPTIVE_SYNC == ENABLED
        case IRQ_DPRX_ADAPTIVE_SYNC_INT:
            (b1IsOn)?(BKF2_17_REG |= BIT0_1):(BKF2_17_REG &= BIT0_0);    
            break;
        #endif
        case IRQ_DPRX_VSI_INT: //
            (b1IsOn)?(BKF2_16_REG |= BIT7_1):(BKF2_16_REG &= BIT7_0);
            break;
        case IRQ_DPRX_PPS_PKT_INT:
            (b1IsOn)?(BKF2_17_REG |= BIT4_1):(BKF2_17_REG &= BIT4_0);
            break;
        case IRQ_DPRX_STATICHDR_INT: //using the user define pkt
            (b1IsOn)?(BKF2_16_REG |= BIT3_1):(BKF2_16_REG &= BIT3_0);
            break;
        case IRQ_DPRX_DYNAMICHDR_INT:
            break;
        case IRQ_RXHDCP1X_INT:
			if(b1IsOn)
            {
                //BKE5_00_REG &= BIT3_0;//[1]dp rx int msk, hdcp1.3 must open
                BKF1_A7_REG |= BIT3_1;//[3]dprx hdcp interrupt enable, 1-en, 0-dis
                BKF1_BB_REG |= 0x50;//interrupt en
            }
            else
            {
                //BKE5_00_REG |= BIT3_1;//[1]dp rx int msk, hdcp1.3 must open
                BKF1_A7_REG &= BIT3_0;//[3]dprx hdcp interrupt enable, 1-en, 0-dis
                BKF1_BB_REG &= 0xaf;  //interrupt dis
            }
            BKE5_30_REG |= BIT3_1;//[1]dp rx int clr en
            BKE5_30_REG &= BIT3_0;//[1]dp rx int clr dis   
			break;
		case IRQ_RXHDCP2X_INT:
			if(b1IsOn)
            {
//                BKE5_01_REG &= BIT7_0;//[6]hdcp2.3 rx int msk
                BKCA_28_REG |= 0x39;//interrupt en
                BKCA_2A_REG |= 0x0f;//interrupt en
            }
            else
            {
//                BKE5_01_REG |= BIT7_1;//[6]hdcp2.3 rx int msk
                BKCA_28_REG &= 0xc6;//interrupt dis
                BKCA_2A_REG &= 0xf0;//interrupt dis
            }
            BKCA_29_REG |= 0x39;//flag clear en
            BKCA_29_REG &= 0xc6;//flag clear dis
            BKE5_31_REG |= BIT7_1;//[6]hdcp rx int clr en
            BKE5_31_REG &= BIT7_0;//[6]hdcp rx int clr dis  
            break;
        case IRQ_DPRX_PPS_DATA_CHG_INT:
            (b1IsOn)?(BKE5_09_REG &= BIT0_0):(BKE5_09_REG |= BIT0_1);
            break;
        #endif

        #if RX_PORT_SIGN == HDMI_PORT
        case IRQ_TMDS_UNSTB_INT:
            break;
        case IRQ_RXPLL_UNLOCK_INT:
            break;
        case IRQ_HDMIRX_VSI_INT: //
            (b1IsOn)?(BKCC_60_REG |= BIT3_1):(BKCC_60_REG &= BIT3_0);
            break;
        case IRQ_HDMIRX_STATICHDR_INT: //using the user define pkt
            (b1IsOn)?(BKCC_12_REG |= BIT4_1):(BKCC_12_REG &= BIT4_0);
            break;
        case IRQ_HDMIRX_DYNAMICHDR_INT:
            (b1IsOn)?(BKCC_64_REG |= BIT1_1):(BKCC_64_REG &= BIT1_0);
            break;
        case IRQ_HDMIRX_PPS_LOAD_SUCC_INT:
            (b1IsOn)?(BKCC_64_REG |= BIT3_1):(BKCC_64_REG &= BIT3_0);
            break;
        case IRQ_HDMIRX_PPS_DATA_CHG_INT:
            if(b1IsOn)
            {
                BKE6_EE_REG |= BIT0_1;//[0]rgd_pps_cksum_en: 1-en
//                BKE5_09_REG &= BIT0_0;
//                BKE5_88_REG |= BIT3_1; //[3]1'b1:software pps cksum enable
            }
            else
            {
                BKE6_EE_REG &= BIT0_0;//[0]rgd_pps_cksum_en: 0-dis
//                BKE5_09_REG |= BIT0_1;
//                BKE5_88_REG &= BIT3_0; //[3]1'b1:software pps cksum enable
            }
            break;
        case IRQ_HDMIRX_VRRSTART_INT:
            (b1IsOn)?(BKCC_22_REG |= BIT7_1):(BKCC_22_REG &= BIT7_0);
            break;
        case IRQ_HDMIRX_VRRSTOP_INT:
            (b1IsOn)?(BKCC_22_REG |= BIT6_1):(BKCC_22_REG &= BIT6_0);
            break;
        #if HDMIRX_MAX_FRL_RATE != FRL_NOT_SPT 
        case IRQ_HDMIRX_FRL_INT:
            (b1IsOn)?(BKE5_01_REG &= BIT4_0):(BKE5_01_REG |= BIT4_1);  //[5]hdmi21 rx int mask dis
            break;
        #endif
        #endif 
        #if BB_EN == ENABLED    
        case IRQ_BB_INT:
            (b1IsOn)?(BKE5_10_REG &= BIT6_0):(BKE5_10_REG |= BIT6_1);  //bit5:bb_int_maskt 
            break;
        #endif
        
        case IRQ_CC1_INT:
            (b1IsOn)?(BKE5_12_REG &= BIT1_0):(BKE5_12_REG |= BIT1_1);  //UCC1 INT MASK
            break;
        case IRQ_CC2_INT:
            (b1IsOn)?(BKE5_12_REG &= BIT0_0):(BKE5_12_REG |= BIT0_1);  //UCC1 INT MASK
            break;
        default:
            break;    
    }
}

u8 Drv_System_IntSrcGet(EnumInterrupt ucIntType)
{
    u8 ucRtn;

    switch(ucIntType)
    {
        case IRQ_TMDS_STB_INT:
            ucRtn = (BKE5_5B_REG & BIT0_1)? (TRUE) : (FALSE);
            break;
        case IRQ_TMDS_PKDET_INT:
            ucRtn = (BKE5_56_REG & BIT2_1)? (TRUE) : (FALSE);
            break;
        default:
            break;    
    }
    return ucRtn;
}

u8 Drv_System_IntFlagGet(EnumInterrupt ucIntType)
{
    u8 ucRtn = 0x00;

    switch(ucIntType)
    {
        #if RX_PORT_SIGN == DP_PORT
        case IRQ_DPRX_AUX_INT:
            ucRtn = (BKE5_40_REG & BIT7_1);
            break;
        #if DPRX_ADAPTIVE_SYNC == ENABLED
        case IRQ_DPRX_ADAPTIVE_SYNC_INT:
            ucRtn = (BKF2_EE_REG & BIT0_1);
            break;
        #endif
        case IRQ_DPRX_VSI_INT: //
			ucRtn = (BKF2_ED_REG & BIT7_1);
            break;
        case IRQ_DPRX_PPS_PKT_INT:
            ucRtn = (BKF2_EE_REG & BIT4_1);
            break;
        case IRQ_DPRX_MSA_INT:
            ucRtn = (BKF2_EE_REG & BIT2_1);
            break;
        case IRQ_DPRX_STATICHDR_INT: //using the user define pkt
            ucRtn = (BKF2_ED_REG & BIT3_1);
            break;
        case IRQ_DPRX_DYNAMICHDR_INT:
            break;
        case IRQ_DPRX_PPS_DATA_CHG_INT:
            ucRtn = (BKE5_49_REG & BIT0_1);
            break;
        #endif

        #if RX_PORT_SIGN == HDMI_PORT
        case IRQ_TMDS_UNSTB_INT:
            ucRtn = (BKE5_4B_REG & BIT1_1);
            break;
       case IRQ_HDMIRX_VSI_INT: 
            ucRtn = (BKCC_F4_REG & BIT2_1);
            break; 
        case IRQ_HDMIRX_STATICHDR_INT: //using the user define pkt
             ucRtn = (BKCC_F2_REG & BIT5_1);
             break;
        case IRQ_HDMIRX_DYNAMICHDR_INT:
            ucRtn = (BKCC_F4_REG & BIT3_1);
            break;
        case IRQ_HDMIRX_PPS_LOAD_SUCC_INT:
            ucRtn = (BKCC_F4_REG & BIT4_1);
            break;
        case IRQ_HDMIRX_PPS_DATA_CHG_INT:
            ucRtn = (BKE5_49_REG & BIT0_1);
            break;
        case IRQ_HDMIRX_VRRSTART_INT:
            ucRtn = (BKCC_F1_REG&BIT7_1);
            break;
        case IRQ_HDMIRX_VRRSTOP_INT:
            ucRtn = (BKCC_F1_REG&BIT6_1);
            break;        
        case IRQ_RXPLL_UNLOCK_INT:
            ucRtn = (BKE5_4B_REG & BIT3_1);
            break;
        
//        #if HDMIRX_MAX_FRL_RATE != FRL_NOT_SPT 
//        case IRQ_HDMIRX_FRL_INT:
//            ucRtn = (BKE5_41_REG & BIT4_1);
//            break;
//        #endif
        #endif
        #if BB_EN == ENABLED    
        case IRQ_BB_INT:
            ucRtn = (BKE5_40_REG & BIT6_1);
            break;
        #endif
        case IRQ_CC1_INT:
            ucRtn = (BKE5_42_REG & BIT1_1);  //UCC1 INT MASK
            break;
        case IRQ_CC2_INT:
            ucRtn = (BKE5_42_REG & BIT0_1);  //UCC1 INT MASK
            break;
        default:
            break;    
    }
    if(ucRtn != 0x00)
    {
        ucRtn = TRUE;
    }
    return ucRtn;
}

//===============================================
//func  :enable  int for lt8711
//input : Int typec   IS ON/OFF
//output:N/A
//return:void
//Info  :N/A
//================================================
void Drv_System_IntClr(EnumInterrupt ucIntType)
{
    switch(ucIntType)
    {
        #if RX_PORT_SIGN == DP_PORT
        case IRQ_DPRX_AUX_INT:
            BKE5_30_REG |= BIT7_1;//bit0 clear interrupt 0
            BKE5_30_REG &= BIT7_0;//bit0 release interrupt 0
            break;
        #if DPRX_ADAPTIVE_SYNC == ENABLED
        case IRQ_DPRX_ADAPTIVE_SYNC_INT:
            BKF2_19_REG |= BIT0_1;//[0]adaptive sync int clr en
            BKF2_19_REG &= BIT0_0;//[0]adaptive sync int clr dis
        #endif
        case IRQ_DPRX_VSI_INT: //
			BKF2_18_REG |= BIT7_1;//[0]adaptive sync int clr en
            BKF2_18_REG &= BIT7_0;//[0]adaptive sync int clr dis
            break;
        case IRQ_DPRX_PPS_PKT_INT:
            BKF2_19_REG |= BIT4_1;//[0]PPS packet int clr en
            BKF2_19_REG &= BIT4_0;//[0]PPS packet int clr dis
            break;
        case IRQ_DPRX_STATICHDR_INT: //using the user define pkt
            BKF2_18_REG |= BIT3_1;//[0]adaptive sync int clr en
            BKF2_18_REG &= BIT3_0;//[0]adaptive sync int clr dis
            break;
        case IRQ_DPRX_DYNAMICHDR_INT:
            break;
        case IRQ_DPRX_PPS_DATA_CHG_INT:
            BKE5_39_REG |= BIT0_1;
            BKE5_39_REG &= BIT0_0;
            break;
        #endif

        #if RX_PORT_SIGN == HDMI_PORT
        case IRQ_TMDS_UNSTB_INT:
            BKE5_3B_REG |= BIT1_1;//tmds clr en
            BKE5_3B_REG &= BIT1_0;//tmds clr dis
            break;
        case IRQ_HDMIRX_VSI_INT: //using the user define pkt
            BKCC_60_REG |= BIT2_1;
            BKCC_60_REG &= BIT2_0;
            break;
        case IRQ_HDMIRX_STATICHDR_INT: //using the user define pkt
            BKCC_12_REG |= BIT5_1;
            BKCC_12_REG &= BIT5_0;
            break;
        case IRQ_HDMIRX_DYNAMICHDR_INT:
            BKCC_64_REG |= BIT0_1;
            BKCC_64_REG &= BIT0_0;
            break;
        case IRQ_HDMIRX_PPS_LOAD_SUCC_INT:
            BKCC_64_REG |= BIT2_1;//rgd_hdmirx_pps_upd_intr_clr en
            BKCC_64_REG &= BIT2_0;//rgd_hdmirx_pps_upd_intr_clr dis
            break;
        case IRQ_HDMIRX_PPS_DATA_CHG_INT:
            BKE5_39_REG |= BIT0_1;
            BKE5_39_REG &= BIT0_0;
            break;
        case IRQ_HDMIRX_VRRSTART_INT:
            BKCC_22_REG |= BIT5_1;//[5]rgd_vrr_en_pos_intr_clr en
            BKCC_22_REG &= BIT5_0;
            break;
        case IRQ_HDMIRX_VRRSTOP_INT:
            BKCC_22_REG |= BIT4_1;//[4]rgd_vrr_en_neg_intr_clr en
            BKCC_22_REG &= BIT4_0;
            break;
        case IRQ_RXPLL_UNLOCK_INT:
            BKE5_3B_REG |= BIT3_1;//rxpll clr en
            BKE5_3B_REG &= BIT3_0;//rxpll clr dis
            break;
        case IRQ_HDMIRX_VIDCHK_INT:
            BKC8_71_REG |= 0xc0;// hactive vactive clr = 1;
            BKC8_71_REG &= 0x3f;// hactive vactive clr = 0;
           
            BKC8_70_REG |= 0x02;// sync timer clr = 0;
            BKC8_70_REG &= 0xfd;// sync timer clr = 0;
             
            break;
        #if HDMIRX_MAX_FRL_RATE != FRL_NOT_SPT 
        case IRQ_HDMIRX_FRL_INT:
            BKE5_31_REG |= BIT4_1;//[5]hdmi21 rx int clr en
            BKE5_31_REG &= BIT4_0;//[5]hdmi21 rx int clr dis
            break;
        #endif
        #endif 
        #if BB_EN == ENABLED    
        case IRQ_BB_INT:
            BKE5_30_REG |= BIT6_1;//[5]clear bb_ininterrupt en
            BKE5_30_REG &= BIT6_0;//[5]clear bb_ininterrupt dis
            break;
        #endif
        case IRQ_CC1_INT:
            BKE5_32_REG |= BIT1_1;    // clear interrupt 2
            BKE5_32_REG &= BIT1_0;
            break;
        case IRQ_CC2_INT:
            BKE5_32_REG |= BIT0_1;    // clear interrupt 2
            BKE5_32_REG &= BIT0_0;
            break;
        default:
            break;    
    }
}

void Drv_System_FmSet(EnumFreqMeter emType, EnumClk ucSrc)
{
    switch(emType)
    {
        case RX_FM:
            BKC7_40_REG = ucSrc;
            break;

        case RXLINK_FM:
            printLT(PRINT_PRIO_HIG, "\nThis fm rxpll_in_clk");
            break;

        case TX_FM:
            printLT(PRINT_PRIO_HIG, "\nThis fm dhtx_div_link_clk");
            break;

        case TOP_FM:
            BKE6_90_REG = ucSrc;
            break;

        default:
            break;
    }
}

u8 Drv_System_FmStbGet(EnumFreqMeter emType)
{
    u8 ucRtn = STABLE;

    switch(emType)
    {
        case RX_FM:
            ucRtn = (BKC7_58_REG & BIT5_1)? (STABLE) : (UNSTABLE);
            break;

        case RXLINK_FM:
            ucRtn = (BKC7_48_REG & BIT5_1)? (STABLE) : (UNSTABLE);
            break;

        case TX_FM:
            ucRtn = (BKED_3B_REG & BIT5_1)? (STABLE) : (UNSTABLE);
            break;

        case TOP_FM:
            
            ucRtn = (BKE6_98_REG & BIT6_1)? (STABLE) : (UNSTABLE);
            break;

        default:
            break;
    }

    return ucRtn;
}

//===========================================
//func  :system freq meter value get
//input :emType: freq meter
//      :ucOpt: HALF_PIX_CLK, PIX_CLK
//output:N/A
//return:u32
//Info  :N/A
//===========================================
u32 Drv_System_FmGet(EnumFreqMeter emType, u8 ucOpt)
{
    u32 ulRtn;
    switch(emType)
    {
        case RX_FM:
            BKC7_40_REG |= BIT7_1;//[7]freq_khz_frz_en: 1-en
            ulRtn = PACK_24_BIT(BKC7_58_REG & 0x0f, BKC7_59_REG, BKC7_5A_REG);
            BKC7_40_REG &= BIT7_0;//[7]freq_khz_frz_en: 0-dis
            break;
        
        case RXLINK_FM:
            ulRtn = PACK_24_BIT(BKC7_48_REG & 0x0f, BKC7_49_REG, BKC7_4A_REG);
            break;
        
        case TX_FM:
            BKED_30_REG |= BIT1_1;//[1]rgd_txfm_freq_khz_frz_en: 1-en
            ulRtn = PACK_24_BIT(BKED_3C_REG & 0x0f, BKED_3D_REG, BKED_3E_REG);
            BKED_30_REG &= BIT1_0;//[1]rgd_txfm_freq_khz_frz_en: 0-dis
            break;

        case TOP_FM:
            BKE6_90_REG |= BIT7_1;//[7]freq_khz_frz_en: 1-en
            ulRtn = PACK_24_BIT(BKE6_98_REG & 0x0f, BKE6_99_REG, BKE6_9A_REG);
            BKE6_90_REG &= BIT7_0;//[7]freq_khz_frz_en: 0-dis
            break;

        default:
            printLT(PRINT_PRIO_HIG, "\nWARNING: Freq meter get fail");
            break;
    }

    ulRtn <<= ucOpt;
    return ulRtn;
}

void Drv_System_PktHeadSet(EnumPacktType ucType)
{
    switch(ucType)
    {
        case USER_DEFINE_PKT_0X77:
            BKCC_0A_REG = 0x77;
            break;
        case VSI_INFO_FRAME_0X81:
            BKCC_5C_REG = 0X03;
            BKCC_5D_REG = 0x81;
            BKCC_5E_REG = 0X46;
            BKCC_5F_REG = 0xD0;        
            break;
        case HDR_INFO_FRAME_0X87:
            //HDR PKT det SET
            BKCC_09_REG = 0XF3;
            BKCC_0A_REG = 0X87;
            BKCC_0B_REG = 0X01;
            BKCC_0C_REG = 0X1A;
            break;
        default:
            break;
    }
}

u8 Drv_System_PktDataChk(EnumPacktType ucType)
{
    u8 ucRtn = FAIL;

    switch(ucType)
    {
        case USER_DEFINE_PKT_0X77:
            break;
        case VSI_INFO_FRAME_0X81:
            if ((BKCC_B1_REG == 0x81)&&(BKCC_B5_REG == 0x46)&&(BKCC_B6_REG == 0xD0)&&(BKCC_B7_REG == 0x00))
            {
                ucRtn = SUCCESS;
           }  
           #if RX_PORT_SIGN == HDMI_PORT
           #if HDR10PLUS==ENABLED  
            if ((BKCC_B1_REG == 0x81)&&(BKCC_B5_REG == 0x8b)&&(BKCC_B6_REG == 0x84)&&(BKCC_B7_REG == 0x90))
            {
                ucRtn = SUCCESS+1;
            } 
           #endif   
           #endif 
            break;
        case HDR_INFO_FRAME_0X87:
            if ((BKCC_75_REG == 0x87)&&(BKCC_76_REG == 0x01)&&(BKCC_77_REG == 0x1A))//&& (BKCC_79_REG!=0
            {
                ucRtn = SUCCESS;
            }
            break;
        case AVI_INFO_FRAME_0X82:
            if ((BKCC_9F_REG == 0x82) &&
                ((BKCC_A0_REG == 0x02) || (BKCC_A0_REG == 0x03)) &&
                (BKCC_A1_REG == 0x0d))
            {
                ucRtn = SUCCESS;
            }
            break;

        default:
            break;
    }

    return ucRtn;
}

void Drv_System_VidChkSet(u8 ucSrc)
{
    if (RX_OUT_VIDEO == ucSrc)
    {
        BKC9_20_REG |= BIT7_1;//[7]rgd_vid_chk_pix_clk_src_sel: 1-pcrpll_div_pcr_clk
        BKC8_7D_REG &= BIT0_0;//[0]rgd_vid_chk_src_sel: 0-rx out
    }
    else if (CSC_OUT_VIDEO == ucSrc)
    {
        BKC9_20_REG &= BIT7_0;//[7]rgd_vid_chk_pix_clk_src_sel: 0-pcrpll_pcr_clk
        BKC8_7D_REG |= BIT0_1;//[0]rgd_vid_chk_src_sel: 1-csc out
    }
}

u8 Drv_System_VidChkStateGet(u8 b1GetEnable)
{
    static u8 ucVidChk_Scan_Cnt = 0;
    if(b1GetEnable == DISABLED)
    {
        ucVidChk_Scan_Cnt = 0; 
    }
    else
    {
        BKC8_71_REG &= 0x3f;// hacitve vactive clr = 0;
        BKC8_70_REG &= BIT1_0;// htotal clr = 0;
        if((BKC8_6F_REG & 0x0C)==0x04)
        {
            ucVidChk_Scan_Cnt++;
        }
        else if(((BKC8_6F_REG & BIT2_1) == 0x00)||(BKC8_6E_REG&0x30)||(BKC8_6D_REG&0x02))
        {
            BKC8_71_REG |= 0xc0;// hactive vactive clr = 1;
            BKC8_70_REG |= 0x02;// htotal clr = 0;
            BKC8_71_REG &= 0x3f;// hactive vactive clr = 0;
            BKC8_70_REG &= 0xfd;// htotal clr = 0;
            ucVidChk_Scan_Cnt = 0;
            return UNSTABLE; 
        }
        if(ucVidChk_Scan_Cnt >= 200)
        {
            return STABLE;
        }
    }
    return UNKNOWN; 
}
