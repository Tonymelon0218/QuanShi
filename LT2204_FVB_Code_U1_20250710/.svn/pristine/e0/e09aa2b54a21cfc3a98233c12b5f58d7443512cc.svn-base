void Drv_Sys_ChipRxSrcSel(u8 ucSel)
{
    BKC7_D7_REG &= 0xcf;//[5:4]rgd_chip_rx_sel: 00-dprx, 01-hdmirx
    BKC7_D7_REG |= ucSel;//[5:4]
}

//========================================================================
// Func Name   : Drv_System_SramPathSet
// Description : sram src and sink set
// Input       : IN EnumSramPath ucPath  
// Output      : None
// Return      : void
//========================================================================
void Drv_System_SramPathSet(IN EnumSramPath ucPath)
{
    u8 ucSaveReg;

    ucSaveReg = 0x00;//[6:4]pps sink sel: 000-hdmi tx
                     //[3:2]pps src sel: 00-hdmi rx
    switch (ucPath)
    {
        #if RX_PORT_SIGN == DP_PORT
        case DPRX_INIT_SET_PATH:
            BKE1_40_REG &= BIT0_0;//[0]rgd_pps_data_wr_clk_src_sel: 0-link clk
            ucSaveReg = (BKE5_6B_REG & 0xf0) | 0x04;
            BKE5_6B_REG = ucSaveReg;//[3:2]pps src sel: 01-dp rx
            break;
        case DPRX_DSCDEC_PPS_PATH:
            BKE1_40_REG &= BIT0_0;//[0]rgd_pps_data_wr_clk_src_sel: 0-link clk
            BKE5_6B_REG = 0x24;//[6:4]pps sink sel: 2-select dsc decoder control
                               //[3:2]pps src sel: 01-dp rx
            break;
        case DPRX_DSCBYPASS_PPS_PATH:
            BKE1_40_REG &= BIT0_0;//[0]rgd_pps_data_wr_clk_src_sel: 0-link clk
            ucSaveReg = (BKE5_6B_REG & 0xf0) | 0x04;
            BKE5_6B_REG = ucSaveReg;//[3:2]pps src sel: 01-dp rx
            break;
        #endif

        #if RX_PORT_SIGN == HDMI_PORT
        case HDMIRX_INIT_SET_PATH:
            BKE1_40_REG &=BIT0_0;
            ucSaveReg = BKE5_6B_REG & 0xf0;
            BKE5_6B_REG = ucSaveReg;//[3:2]pps src sel: 00-hdmi rx
            break;
        case HDMIRX_DSCDEC_PPS_PATH:
            BKE1_40_REG &= BIT0_0;//[0]rgd_pps_data_wr_clk_src_sel: 0-tmds clk
            BKE5_6B_REG = 0x20;//[6:4]pps sink sel: 010-select dsc decoder control
                               //[3:2]pps src sel: 00-hdmi rx
            break;
        case HDMIRX_DSCBYPASS_PPS_PATH:
            BKE1_40_REG &= BIT0_0;//[0]rgd_pps_data_wr_clk_src_sel: 0-tmds clk
            ucSaveReg = (BKE5_6B_REG & 0x0f) | 0xd0;
            BKE5_6B_REG = ucSaveReg; //[7]rgd_pps_rd_en = 1; [6:4]rgd_pps_sink_sel
            break;
        #endif

        #if TX_PORT_SIGN == DP_PORT
        case DPTX_INIT_SET_PATH:
            ucSaveReg = (BKE5_6B_REG & 0x0f) | 0x10;
            BKE5_6B_REG = ucSaveReg;//[6:4]pps sink sel: 001-dp tx
            break;
        case DPTX_DSCENC_PPS_PATH:
            BKE5_6B_REG = 0x18;//[6:4]pps sink sel: 001-dp tx
                               //[3:2]pps src sel: 10-dsc enc
            break;
        case DPTX_DSCBYPASS_PPS_PATH:
            ucSaveReg = (BKE5_6B_REG & 0x0f) | 0x10;
            BKE5_6B_REG = ucSaveReg;//[6:4]pps sink sel: 001-dp tx
                                    //[3:2]pps src sel: 01-dp rx
            break;
        case DPTX_HDR_PKT_PATH:
//            BKF6_EF_REG |= BIT6_1;//[6]rg_pps_upd_dis: 1-dis pps update
            #if RX_PORT_SIGN == DP_PORT
            ucSaveReg |= 0x14;
            BKE5_6B_REG = ucSaveReg;//[6:4]pps sink sel: 001-dp tx
                                    //[3:2]pps src sel: 01-dp rx
            #endif
            #if RX_PORT_SIGN == HDMI_PORT
            ucSaveReg |= 0x10; 
            BKE5_6B_REG = ucSaveReg;//[6:4]pps sink sel: 001-dp tx
                                    //[3:2]pps src sel: 00-hdmi rx
            #endif
            break;
        #endif

        #if TX_PORT_SIGN == HDMI_PORT
        case HDMITX_INIT_SET_PATH:
            BKE5_6B_REG &= 0x0f;//[6:4]pps sink sel: 000-hdmi tx
            break;
        case HDMITX_DSCENC_PPS_PATH:
            BKE5_6B_REG = 0x08;//[6:4]pps sink sel: 000-hdmi tx
                               //[3:2]pps src sel: 10-dsc enc
            break;
        case HDMITX_DSCBYPASS_PPS_PATH:
            BKE5_6B_REG &= 0x0f;//[6:4]pps sink sel: 000-hdmi tx
            break;
        case HDMITX_HDR_PKT_PATH:
            BKEA_1A_REG &= BIT0_0;//[0]rgd_pps_update_en: 0-sw
            #if RX_PORT_SIGN == DP_PORT
            ucSaveReg |= 0x04;//[3:2]pps src sel: 01-dp rx
            BKE5_6B_REG = ucSaveReg;
            #endif

            #if RX_PORT_SIGN == HDMI_PORT
            BKE5_6B_REG = ucSaveReg;//[3:2]pps src sel: 00-hdmi rx
            #endif
            break;
        #endif

        #if TX_PORT_SIGN == MIPI_PORT
        case MIPITX_DSCENC_PPS_PATH:
        BKE5_6B_REG = 0x38;//[6:4]pps sink sel: 011-mipi tx
                           //[3:2]pps src sel: 10-dsc enc
        break;
        #endif

        default:
            printLT(PRINT_PRIO_HIG,"Warning: input is invalid");
            break;
    }
}


//========================================================================
// Func Name   : Drv_Sys_HdcpKeyLoad
// Description : load hdcp key from flash to sram.
// Input       : void  
// Output      : None
// Return      : void
//========================================================================
void Drv_Sys_HdcpKeyLoad(void)
{
    u8 loadkey_cnt = 0;

    BKCA_2B_REG |= BIT6_1; 
    BKCA_2B_REG &= BIT6_0; //load key status clear.

    //rgd_sec_flash_init_addr[23:0] = 0x050000 (Flash load address)
    BKE0_68_REG = 0x05;
    BKE0_69_REG = 0x00;
    BKE0_6A_REG = 0x00;
    
    //rgd_upld_size[23:0] = = 0x000800 (Flash load size)
    BKE0_65_REG = 0x00;
    BKE0_66_REG = 0x08;
    BKE0_67_REG = 0x00;

    BKE0_60_REG |= BIT1_1; //start load key.
    do
    {
        loadkey_cnt++;
        Ocm_Delay1ms(1);
        if(BKCA_80_REG & BIT0_1)
        {
            break;
        }
    }while(loadkey_cnt < 20);
    printLT(PRINT_PRIO_HIG, "\nload key done[0x%02bx]",BKCA_80_REG);
    BKE0_60_REG &= BIT1_0; //stop load key.
}

void Drv_Sys_DHRxPowerDomain(u8 b1IsPowerOn)
{
   if(b1IsPowerOn == TRUE)
   {
        BKE1_21_REG = 0x00; 
        BKE1_22_REG = 0x00; 
        BKE1_23_REG = 0x00; 
        BKE1_24_REG = 0x00; 
        BKE1_25_REG = 0x00;    //clk disable 
        BKE5_80_REG &= BIT7_0; //power iso_en
        BKE1_0B_REG &= BIT3_0; // reset
        BKE5_80_REG &= BIT6_0; //power domin  enable
   }
   else
   {
        BKE5_80_REG |= BIT6_1; //power domin  disable
        BKE1_0B_REG |= BIT3_1; // reset
        BKE5_80_REG |= BIT7_1; //power iso_en
        BKE1_21_REG = 0x7f; 
        BKE1_22_REG = 0x0b; 
        BKE1_23_REG = 0xff; 
        BKE1_24_REG = 0xff; 
        BKE1_25_REG = 0xf3; // clk enable  
   } 
}

void Drv_Sys_DHTxPowerDomain(u8 b1IsPowerOn)
{
   if(b1IsPowerOn == TRUE)
   {
        BKE1_26_REG = 0x00; 
        BKE1_27_REG = 0x00;     // clk disable 
        BKE5_80_REG &= BIT5_0; //power iso_en
        BKE1_0B_REG &= BIT2_0; // reset
        BKE5_80_REG &= BIT4_0; //power domin  enable
   }
   else
   {
        BKE5_80_REG |= BIT4_1; //power domin  disable
        BKE1_0B_REG |= BIT2_1; // reset
        BKE5_80_REG |= BIT5_1; //power iso_en
        BKE1_26_REG = 0xFF; 
        BKE1_27_REG = 0xF8;// clk enable  
   } 
}

void Drv_Sys_LmtxPowerDomain(u8 b1IsPowerOn)
{
   if(b1IsPowerOn == TRUE)
   {
        BKE1_2A_REG = 0x00; 
        BKE1_2B_REG = 0x00;     //lmtx clk disable 
        BKE5_81_REG &= BIT1_0; //power iso_en
        BKE1_0B_REG &= BIT4_0; //LMTX reset
        BKE5_81_REG &= BIT0_0; //power domin  enable
   }
   else
   {
        BKE5_81_REG |= BIT0_1; //power domin  disable
        BKE1_0B_REG |= BIT4_1; //LMTX reset
        BKE5_81_REG |= BIT1_1; //power iso_en
        BKE1_2A_REG = 0xff; 
        BKE1_2B_REG = 0xff; //lmtx clk enable  
   } 
}
void Drv_Sys_DecPowerDomain(u8 b1IsPowerOn)
{
   if(b1IsPowerOn == TRUE)
   {
        BKE1_28_REG = 0x00;     // clk disable 
        BKE5_80_REG &= BIT3_0; //power iso_en
        BKE1_0B_REG &= BIT1_0; // reset
        BKE5_80_REG &= BIT2_0; //power domin  enable
   }
   else
   {
        BKE5_80_REG |= BIT2_1; //power domin  disable
        BKE1_0B_REG |= BIT1_1; // reset
        BKE5_80_REG |= BIT3_1; //power iso_en
        BKE1_28_REG = 0xff; // clk enable  
   } 
}

void Drv_Sys_EncPowerDomain(u8 b1IsPowerOn)
{
   if(b1IsPowerOn == TRUE)
   {
        BKE1_29_REG = 0x00;    // clk disable 
        BKE5_80_REG &= BIT1_0; //power iso_en
        BKE1_0B_REG &= BIT0_0; //reset
        BKE5_80_REG &= BIT0_0; //power domin  enable
   }
   else
   {
        BKE5_80_REG |= BIT0_1; //power domin  disable
        BKE1_0B_REG |= BIT0_1; // reset valid
        BKE5_80_REG |= BIT1_1; //power iso_en
        BKE1_29_REG = 0xff;    //clk enable  
   } 
}

#if ((TX_PORT_SIGN == DP_PORT) || (TX_PORT_SIGN == HDMI_PORT))
void Drv_Sys_DhTxSrcSel(u8 ucSel)
{
    BKED_20_REG = ucSel;
}
#endif
#if ((TX_PORT_SIGN == MIPI_PORT) || (TX_PORT_SIGN == LVDS_PORT))
void Drv_Sys_LmOutSel(u8 ucSel)
{
    BKF9_00_REG = ucSel;
}
