#if ((HDMITX_VID_PATTERN_SEL != NO_PATTERN)||(DPTX_VID_PATTERN_SEL != NO_PATTERN))
void Drv_System_VidPatternSet(void)
{
    u8 ucpcrpll_cal_cnt,ucpcrpll_lock_cnt;
    u8 timing[17];
    //timing fill
    #if DPTX_VID_PATTERN_SEL == PTN480P
    memcpy(timing,timing480p60hz,17);
    #elif DPTX_VID_PATTERN_SEL == PTN720P
    memcpy(timing,timing720p60hz,17);
    #elif DPTX_VID_PATTERN_SEL == PTN1080P
    memcpy(timing,timing1080p60hz,17);
    #elif DPTX_VID_PATTERN_SEL == PTN4K30
    memcpy(timing,timing4k30hz,17);
    #elif DPTX_VID_PATTERN_SEL == PTN4K60
    memcpy(timing,timing4k60hz,17);
    #elif DPTX_VID_PATTERN_SEL == PTN4K120
    memcpy(timing,timing4k120hz,17);
    #elif DPTX_VID_PATTERN_SEL == PTN8K30
    memcpy(timing,timing8k30hz,17);
    #endif
    
    #if HDMITX_VID_PATTERN_SEL == PTN480P
    memcpy(timing,timing480p60hz,17);
    #elif HDMITX_VID_PATTERN_SEL == PTN720P
    memcpy(timing,timing720p60hz,17);
    #elif HDMITX_VID_PATTERN_SEL == PTN1080P
    memcpy(timing,timing1080p60hz,17);
    #elif HDMITX_VID_PATTERN_SEL == PTN4K30
    memcpy(timing,timing4k30hz,17);
    #elif HDMITX_VID_PATTERN_SEL == PTN4K60
    memcpy(timing,timing4k60hz,17);
    #elif HDMITX_VID_PATTERN_SEL == PTN4K120
    memcpy(timing,timing4k120hz,17);
    #elif HDMITX_VID_PATTERN_SEL == PTN8K30
    memcpy(timing,timing8k30hz,17);
    #endif
    BKC7_C3_REG = timing[0];
    BKC7_C4_REG = timing[1];
    BKC7_C5_REG = timing[2];
    BKC7_C6_REG = timing[3];
    BKC7_C7_REG = timing[4];
    BKC7_C8_REG = timing[5];
    BKC7_C9_REG = timing[6];
    BKC7_CA_REG = timing[7];
    BKC7_CB_REG = timing[8];
    BKC7_CC_REG = timing[9];
    BKC7_CD_REG = timing[10];
    BKC7_CE_REG = timing[11];
    BKC7_CF_REG = timing[12];
    BKC7_D0_REG = timing[13];
    BKC7_D1_REG = timing[14];

    //pattern color space/depth set
    BKC7_D6_REG = 0x30;//[5:4]rgd_ptn_video_pattern: 11-color square
                       //[1:0]rgd_ptn_pixel_format:  00-rgb/ycbcr444/ycbcr420
    //pcrpll init
    BKC7_D7_REG &= BIT0_0;//[0]rgd_rx_da_src_sel: 0-dp
    BKA3_23_REG = 0x01;//[6:4]rg_pcrpll_half_pcrck_muxsel : 010-aa_pll_half_pix_clk
    BKA3_24_REG = 0x00;//[6:4]rg_pcrpll_half_pixck_muxsel : 010-aa_pll_half_pix_clk
    BKA3_25_REG = 0x01;//[6:4]rg_pcrpll_half_tmdsck_divsel: 010-aa_pll_half_pix_clk
    BKA3_26_REG = 0x01;//[6:4]rg_pcrpll_dscin_muxsel      : 000-aa_pll_pix_clk
    BKA3_2A_REG = 0x80|timing[15];
    BKA3_2B_REG = timing[16];//[7]rgd_sw_en_pcrpll_freq_set: 1-sw;
                             //[6:4]rgd_sw_pcrpll_freq_set
    BKA3_2E_REG = 0x08;//da_pcrpll_post_divsel = 1;                         
    //pcrpll cali
    BKA3_20_REG &= BIT4_0;//[4]rg_pcrpll_pd: 0-normal work
    BKA3_20_REG |= BIT2_1;//post_div_set  = 2
    BKA3_20_REG &= 0xfc;  //[1:0]rg_pcrpll_ref_sel: 00-Xtal_25m_clk
    BKE2_3D_REG = 0x20;// ks =2;
    ucpcrpll_cal_cnt = 0;
    do{
        BKE1_08_REG &= 0xfc;//[1]rgd_sw_pcrpll_cal_rst_n
        BKE1_0E_REG &= BIT1_0;//[1]rg_sw_pcrpll_rst_n
        BKE2_3D_REG &= BIT3_0;//[3]rgd_pcrpll_pll_cal_en
        Ocm_Delay1ms(1);
        BKE1_08_REG |= 0x03;
        BKE1_0E_REG |= BIT1_1;
        Ocm_Delay1ms(1);
        BKE2_3D_REG |= BIT3_1;
        Ocm_Delay1ms(2);
        ucpcrpll_cal_cnt++;
    }while((ucpcrpll_cal_cnt <3)&&((BKE2_47_REG&0x3) != 0x02));
    printLT(PRINT_PRIO_HIG, "\nPattern pcr band = 0x%02bx", BKE2_4E_REG);
    ucpcrpll_lock_cnt = 0;      
    while((!(BKE2_28_REG&BIT4_1)) && (ucpcrpll_lock_cnt < 6))  //PLL lock output lock status
    {
        ucpcrpll_lock_cnt++;
        Ocm_Delay1ms(1);
    }
    //dp rx sdm control mode
    BKF3_34_REG |= 0x05;//[2]rg_soft_k_en: 1-en
                        //[0]rg_soft_m_en: 1-en
    BKF3_37_REG = timing[15];//m value
    #if DPTX_VID_PATTERN_SEL == PTN480P
    BKF3_3A_REG = 0x00;//k value
    BKF3_3B_REG = 0x00;//k value
    BKF3_3C_REG = 0x00;//k value
    #elif DPTX_VID_PATTERN_SEL == PTN720P
    BKF3_3A_REG = 0x85;//k value
    BKF3_3B_REG = 0x1e;//k value
    BKF3_3C_REG = 0xb8;//k value
    #elif DPTX_VID_PATTERN_SEL == PTN1080P
    BKF3_3A_REG = 0x85;//k value
    BKF3_3B_REG = 0x1e;//k value
    BKF3_3C_REG = 0xb8;//k value
    #elif DPTX_VID_PATTERN_SEL == PTN4K30
    BKF3_3A_REG = 0x85;//k value
    BKF3_3B_REG = 0x1e;//k value
    BKF3_3C_REG = 0xb8;//k value
    #elif DPTX_VID_PATTERN_SEL == PTN4K60
    BKF3_3A_REG = 0x85;//k value
    BKF3_3B_REG = 0x1e;//k value
    BKF3_3C_REG = 0xb8;//k value
    #elif DPTX_VID_PATTERN_SEL == PTN4K120
    BKF3_3A_REG = 0x33;//k value
    BKF3_3B_REG = 0x33;//k value
    BKF3_3C_REG = 0x33;//k value
    #elif DPTX_VID_PATTERN_SEL == PTN8K30
    BKF3_3A_REG = 0x33;//k value
    BKF3_3B_REG = 0x33;//k value
    BKF3_3C_REG = 0x33;//k value
    #endif
    
    #if HDMITX_VID_PATTERN_SEL == PTN480P
    g_stHdmiTx.ulTxPixelClk = 25000;
    g_stHdmiTx.ulTxTmdsClk  = g_stHdmiTx.ulTxPixelClk;
    BKF3_3A_REG = 0x00;//k value
    BKF3_3B_REG = 0x00;//k value
    BKF3_3C_REG = 0x00;//k value
    #elif HDMITX_VID_PATTERN_SEL == PTN720P
    g_stHdmiTx.ulTxPixelClk = 74250;
    g_stHdmiTx.ulTxTmdsClk  = g_stHdmiTx.ulTxPixelClk;
    BKF3_3A_REG = 0x85;//k value
    BKF3_3B_REG = 0x1e;//k value
    BKF3_3C_REG = 0xb8;//k value
    #elif HDMITX_VID_PATTERN_SEL == PTN1080P
    g_stHdmiTx.ulTxPixelClk = 148500;
    g_stHdmiTx.ulTxTmdsClk  = g_stHdmiTx.ulTxPixelClk;
    BKF3_3A_REG = 0x85;//k value
    BKF3_3B_REG = 0x1e;//k value
    BKF3_3C_REG = 0xb8;//k value
    #elif HDMITX_VID_PATTERN_SEL == PTN4K30
    g_stHdmiTx.ulTxPixelClk = 297000;
    g_stHdmiTx.ulTxTmdsClk  = g_stHdmiTx.ulTxPixelClk;
    BKF3_3A_REG = 0x85;//k value
    BKF3_3B_REG = 0x1e;//k value
    BKF3_3C_REG = 0xb8;//k value
    #elif HDMITX_VID_PATTERN_SEL == PTN4K60
    g_stHdmiTx.ulTxPixelClk = 594000;
    g_stHdmiTx.ulTxTmdsClk  = g_stHdmiTx.ulTxPixelClk;
    BKF3_3A_REG = 0x85;//k value
    BKF3_3B_REG = 0x1e;//k value
    BKF3_3C_REG = 0xb8;//k value
    #elif HDMITX_VID_PATTERN_SEL == PTN4K120
    g_stHdmiTx.ulTxPixelClk = 1180000;
    g_stHdmiTx.ulTxTmdsClk  = g_stHdmiTx.ulTxPixelClk;
    BKF3_3A_REG = 0x33;//k value
    BKF3_3B_REG = 0x33;//k value
    BKF3_3C_REG = 0x33;//k value
    #elif HDMITX_VID_PATTERN_SEL == PTN8K30
    g_stHdmiTx.ulTxPixelClk = 1180000;
    g_stHdmiTx.ulTxTmdsClk  = g_stHdmiTx.ulTxPixelClk;
    BKF3_3A_REG = 0x33;//k value
    BKF3_3B_REG = 0x33;//k value
    BKF3_3C_REG = 0x33;//k value
    #endif
    BKF3_3D_REG &=0xf0;
    BKF3_3D_REG |=0x06;//[3:2]rg_diff_ord_sel;
                       //[1:0]rg_sdm_ord_sel;  
    BKA3_2A_REG = 0x00;
    
    //data mux
    BKC7_D7_REG &= BIT6_0;//[6]rgd_dsc_dec_sel: 0-bypass
    Drv_Sys_ChipRxSrcSel(CHIPRX_SRC_SEL_PTN);
    //clk mux

    BKA3_3C_REG &= 0x80;
    BKA3_3D_REG &= 0x80;
    BKA3_3E_REG &= 0x80;
    BKA3_3F_REG &= 0x80;
    BKA3_40_REG &= 0x80;
    BKA3_41_REG &= 0x80;
    BKA3_42_REG &= 0x80;

    //sel pcrpll_dsc_in_clk
    BKA3_3D_REG |= 0x60;//[6:4]rg_clkgen_div_link_muxsel     : 110-aa_pcrpll_dsc_in_clk
    //half pix
    BKA3_45_REG = 0x00;
    BKA3_46_REG = 0x00;//[2:0]rg_clkgen_pcr_clk_recvsel      : 000-aa_pcrpll_pcr_clk
    //pix
    BKA3_3C_REG = 0x01;//[6:4]rg_clkgen_cscrx_halfpix_muxsel: 000-aa_pcrpll_pix_clk or aa_secpcrpll_pix_clk
                            //[3:0]rg_clkgen_cscrx_halfpix_divsel: div 1
    BKA3_3E_REG = 0x11;//[6:4]rg_clkgen_dscout_muxsel       : 001-aa_pcrpll_pix_clk
                       //[3:0]rg_clkgen_dscout_divse        : div 2
    BKA3_3F_REG = 0x01;//ad_dscrx_dsc_clk    2f/2
    BKA3_40_REG = 0x11;//ad_dscrx_dsc_rd_clk 2f/2
    
    BKA3_41_REG = 0x01;//[6:4]rg_clkgen_dsctx_dsc_muxsel    : 000-aa_pcrpll_pix_clk
    BKA3_42_REG = 0x11;//[6:4]rg_clkgen_dsctx_dscrd_muxsel  : 001-aa_pcrpll_pix_clk
                         //[3:0]rg_clkgen_dsctx_dscrd_divsel : div                                             
}

void Drv_System_AudioPatternSet(void)
{
    u8 ucAudpll_cal_cnt;
    u8 ucAudpll_lock_cnt;
    BKE1_0E_REG &= BIT7_0;//AUDPLL HARDSERET = 0

    BKA3_08_REG &= BIT4_0;
    BKA3_08_REG &= 0xfc;  // 00-Xtal_25m_clk
    BKA3_0E_REG = 0x02;
    BKE2_2A_REG = 0x20;  // ks =2; rg_cal_en =1
    
    #if DPTX_VID_PATTERN_SEL != NO_PATTERN
    #if DPTX_AUD_PATTERN_SEL == AUD_PTN_32K
    BKA3_0F_REG = 0xbf;//m = 63
    BKA3_10_REG = 0xc0;//div =32 
    #endif

    #if DPTX_AUD_PATTERN_SEL == AUD_PTN_44D1K
    BKA3_0F_REG = 0xd7;
    BKA3_10_REG = 0xc0;//44.1KHz
    #endif

    #if DPTX_AUD_PATTERN_SEL == AUD_PTN_48K
    BKA3_0F_REG = 0xde;
    BKA3_10_REG = 0xc0; //div = 32
    #endif

    #if DPTX_AUD_PATTERN_SEL == AUD_PTN_88D2K
    BKA3_0F_REG = 0xd7;
    BKA3_10_REG = 0xb0;//87.9KHz
    #endif

    #if DPTX_AUD_PATTERN_SEL == AUD_PTN_96K
    BKA3_0F_REG = 0xdf;
    BKA3_10_REG = 0xb0;//96.6KHz
    #endif

    #if DPTX_AUD_PATTERN_SEL == AUD_PTN_176D4K
    BKA3_0F_REG = 0xd7;
    BKA3_10_REG = 0xa0;//175.8KHz
    #endif

    #if DPTX_AUD_PATTERN_SEL == AUD_PTN_192K
    BKA3_0F_REG = 0xde;
    BKA3_10_REG = 0xa0;//193.3KHz
    #endif
    #endif
    
    #if HDMITX_VID_PATTERN_SEL != NO_PATTERN
    #if HDMITX_AUD_PATTERN_SEL == AUD_PTN_32K
    BKA3_0F_REG = 0xbf;//m = 63
    BKA3_10_REG = 0xc0;//div =32 
    #endif

    #if HDMITX_AUD_PATTERN_SEL == AUD_PTN_44D1K
    BKA3_0F_REG = 0xd7;
    BKA3_10_REG = 0xc0;//44.1KHz
    #endif

    #if HDMITX_AUD_PATTERN_SEL == AUD_PTN_48K
    BKA3_0F_REG = 0xde;
    BKA3_10_REG = 0xc0; //div = 32
    #endif

    #if HDMITX_AUD_PATTERN_SEL == AUD_PTN_88D2K
    BKA3_0F_REG = 0xd7;
    BKA3_10_REG = 0xb0;//87.9KHz
    #endif

    #if HDMITX_AUD_PATTERN_SEL == AUD_PTN_96K
    BKA3_0F_REG = 0xdf;
    BKA3_10_REG = 0xb0;//96.6KHz
    #endif

    #if HDMITX_AUD_PATTERN_SEL == AUD_PTN_176D4K
    BKA3_0F_REG = 0xd7;
    BKA3_10_REG = 0xa0;//175.8KHz
    #endif

    #if HDMITX_AUD_PATTERN_SEL == AUD_PTN_192K
    BKA3_0F_REG = 0xde;
    BKA3_10_REG = 0xa0;//193.3KHz
    #endif
    #endif
    
    ucAudpll_cal_cnt = 0;
    do{
        BKE1_04_REG &= 0xfc;//[1]rgd_sw_audpll_cal_rst_n
        BKE1_0F_REG &= BIT7_0;//[1]rg_sw_pcrpll_rst_n
        BKE2_2A_REG &= BIT3_0;//[3]rgd_pcrpll_pll_cal_en
        Ocm_Delay1ms(1);
        BKE1_04_REG |= 0x03;
        BKE1_0F_REG |= BIT7_1;
        Ocm_Delay1ms(1);
        BKE2_2A_REG |= BIT3_1;
        Ocm_Delay1ms(2);
        ucAudpll_cal_cnt++;
    }while((ucAudpll_cal_cnt <3)&&((BKE2_34_REG&0x03) != 0x02));
    printLT(PRINT_PRIO_HIG, "\nPattern Audpll band = 0x%02bx", BKE2_3C_REG);
    ucAudpll_lock_cnt = 0;      
    while((!(BKE2_28_REG&BIT5_1)) && (ucAudpll_lock_cnt < 6))  //PLL lock output lock status
    {
        ucAudpll_lock_cnt++;
        Ocm_Delay1ms(1);
    }
    if(BKE2_28_REG&BIT5_1)
    {
        printLT(PRINT_PRIO_HIG, "\nPattern Audpll lock");
    }
}

void Drv_Vid_TimingGet(LtTiming_S *pstTiming)
{
    //get V timing by video check
    pstTiming->usVfp =   ((u16)BKC8_4C_REG << 8) + BKC8_4D_REG;
    pstTiming->usVsync = ((u16)BKC8_46_REG << 8) + BKC8_47_REG;
    pstTiming->usVbp =   ((u16)BKC8_4A_REG << 8) + BKC8_4B_REG;
    pstTiming->usVact =  ((u16)BKC8_56_REG << 8) + BKC8_57_REG;
    pstTiming->usVtol =  ((u16)BKC8_52_REG << 8) + BKC8_53_REG;
    //h
    pstTiming->usHfp =   ((u16)BKC8_50_REG << 8) + BKC8_51_REG;
    pstTiming->usHsync = ((u16)BKC8_48_REG << 8) + BKC8_49_REG;
    pstTiming->usHbp =   ((u16)BKC8_4E_REG << 8) + BKC8_4F_REG;
    pstTiming->usHact =  ((u16)BKC8_58_REG << 8) + BKC8_59_REG;
    pstTiming->usHtol =  ((u16)BKC8_54_REG << 8) + BKC8_55_REG;
    //recover to real timing
    if ((BKCC_D0_REG & 0x70) == 0x30)//[6:4]hdmi rx color space, 11-yuv420, -wangtt- wait update
    {
        pstTiming->usHbp   <<= 2;
        pstTiming->usHfp   <<= 2;
        pstTiming->usHsync <<= 2;
        pstTiming->usHtol  <<= 2;
        pstTiming->usHact  <<= 2;
    }
    else
    {
        pstTiming->usHbp   <<= 1;
        pstTiming->usHfp   <<= 1;
        pstTiming->usHsync <<= 1;
        pstTiming->usHtol  <<= 1;
        pstTiming->usHact  <<= 1;
    }
}
