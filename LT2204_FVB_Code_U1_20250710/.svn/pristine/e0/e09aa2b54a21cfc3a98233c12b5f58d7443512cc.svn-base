#if ((LVDXTX_VID_PATTERN_MODE != NO_PATTERN) ||(MIPITX_VID_PATTERN_MODE != NO_PATTERN))


void Drv_PtnType_Sel(void)
{
    //pattern color space/depth set
    BKC7_D6_REG = 0x30;//[5:4]rgd_ptn_video_pattern: 11-color square
                       //[1:0]rgd_ptn_pixel_format:  00-rgb/ycbcr444/ycbcr420
	
//		//pattern white
//		BKC7_C1_REG = 0x07;
//	
//		//pattern black
//		BKC7_C1_REG = 0x00;		
}

void Drv_PtnClk_Set(u8 Value_0xA32A,u8 Value_0xA32B)//PTN0 = 0 , PTN1 = 1
{
    BKA3_2A_REG = 0x80|Value_0xA32A;
    BKA3_2B_REG = Value_0xA32B;//[7]rgd_sw_en_pcrpll_freq_set: 1-sw;
                             //[6:4]rgd_sw_pcrpll_freq_set
		BKF3_37_REG = Value_0xA32A;//m value
}


void Drv_PtnPCR_Init(void)
{
    //pcrpll init
    BKC7_D7_REG &= BIT0_0;//[0]rgd_rx_da_src_sel: 0-dp
    BKA3_23_REG = 0x01;//[6:4]rg_pcrpll_half_pcrck_muxsel : 010-aa_pll_half_pix_clk
    BKA3_24_REG = 0x01;//[6:4]rg_pcrpll_half_pixck_muxsel : 010-aa_pll_half_pix_clk
    BKA3_25_REG = 0x01;//[6:4]rg_pcrpll_half_tmdsck_divsel: 010-aa_pll_half_pix_clk
    BKA3_26_REG = 0x01;//[6:4]rg_pcrpll_dscin_muxsel      : 000-aa_pll_pix_clk
//    BKA3_2A_REG = 0x80|timing[15];
//    BKA3_2B_REG = timing[16];//[7]rgd_sw_en_pcrpll_freq_set: 1-sw;
                             //[6:4]rgd_sw_pcrpll_freq_set
    //pcrpll cali
    BKA3_20_REG &= BIT4_0;//[4]rg_pcrpll_pd: 0-normal work
    BKA3_20_REG &= 0xfc;  //[1:0]rg_pcrpll_ref_sel: 00-Xtal_25m_clk
    BKE1_08_REG &= BIT1_0;//[1]rgd_sw_pcrpll_cal_rst_n
    BKE1_0E_REG &= BIT1_0;//[1]rg_sw_pcrpll_rst_n
    BKE2_3D_REG &= BIT3_0;//[3]rgd_pcrpll_pll_cal_en
    Ocm_Delay1ms(1);
    BKE1_08_REG |= BIT1_1;
    BKE1_0E_REG |= BIT1_1;
    BKE2_3D_REG |= BIT3_1;
    Ocm_Delay1ms(10);

    printLT(PRINT_PRIO_HIG, "\nPattern pcr band = 0x%02bx", BKE2_4E_REG);
    Ocm_Delay1ms(10);        
    if(BKE2_28_REG&BIT4_1)
    {
        printLT(PRINT_PRIO_HIG, "\nPattern pcr lock");
    }
		
    //dp rx sdm control mode
    BKF3_34_REG |= 0x05;//[2]rg_soft_k_en: 1-en
                        //[0]rg_soft_m_en: 1-en
//    BKF3_37_REG = timing[15];//m value
	
    BKF3_3A_REG = 0x04;//k value
    BKF3_3B_REG = 0x00;//k value
    BKF3_3C_REG = 0x00;//k value
    BKF3_3D_REG &=0xf0;
    BKF3_3D_REG |=0x06;//[3:2]rg_diff_ord_sel;
                        //[1:0]rg_sdm_ord_sel;  
    BKA3_2A_REG = 0x00;		
}

void Drv_PtnTiming_Set(struct TIMING *CustomTiming)
{
	
//    LTLog(LOG_INFO, "Pattern[H]: Htotal:%d,Hactive:%d,Hsw:%d,Hfp:%d,Hbp:%d,Hspol:%bd",  CustomTiming->Htotal, CustomTiming->Hactive, CustomTiming->Hsw, CustomTiming->Hfp, CustomTiming->Hbp,CustomTiming->Hspol);
//    LTLog(LOG_INFO, "Pattern[V]: Vtotal:%d,Vactive:%d,Vsw:%d,Vfp:%d,Vbp:%d,Vspol:%bd",  CustomTiming->Vtotal, CustomTiming->Vactive, CustomTiming->Vsw, CustomTiming->Vfp, CustomTiming->Vbp,CustomTiming->Vspol);    
 	
		BKC7_C3_REG = ((CustomTiming->Hsw+CustomTiming->Hbp)/2)/256;
		BKC7_C4_REG = ((CustomTiming->Hsw+CustomTiming->Hbp)/2)%256;
		BKC7_C5_REG = (CustomTiming->Vsw+CustomTiming->Vbp)/256;
		BKC7_C6_REG = (CustomTiming->Vsw+CustomTiming->Vbp)%256;
		BKC7_C7_REG = (CustomTiming->Hactive/2)/256;
		BKC7_C8_REG = (CustomTiming->Hactive/2)%256;
		BKC7_C9_REG = (CustomTiming->Vactive)/256;
		BKC7_CA_REG = (CustomTiming->Vactive)%256;
		BKC7_CB_REG = (CustomTiming->Htotal/2)/256;
		BKC7_CC_REG = (CustomTiming->Htotal/2)%256;
		BKC7_CD_REG = (CustomTiming->Vtotal)/256;
		BKC7_CE_REG = (CustomTiming->Vtotal)%256;
		BKC7_CF_REG = (CustomTiming->Hsw/2)/256;
		BKC7_D0_REG = (CustomTiming->Hsw/2)%256;
		BKC7_D1_REG = CustomTiming->Vsw;		
	
}

void Drv_PtnDataClk_Mux(void)
{
    //data mux
    BKC7_D7_REG &= BIT6_0;//[6]rgd_dsc_dec_sel: 0-bypass
    Drv_Sys_ChipRxSrcSel(CHIPRX_SRC_SEL_PTN);
    //clk mux
    BKA3_45_REG &= 0xe0;
    BKA3_3C_REG &= 0x80;
    BKA3_3E_REG &= 0x80;
    BKA3_41_REG &= 0x80;
    BKA3_42_REG &= 0x80;
    //half pix
//    BKA3_45_REG &= 0xe0;//[4]rg_clkgen_dscin_clk_recvsel     : 0-aa_pcrpll_dsc_in_clk
                         //[3:1]rg_clkgen_divpcr_clk_recvsel  : 000-aa_pcrpll_div_pcr_clk
                         //[0]rg_clkgen_pix_clk_recvsel       : 0-aa_pcrpll_pix_clk
    BKA3_46_REG = 0x00;//[2:0]rg_clkgen_pcr_clk_recvsel      : 000-aa_pcrpll_pcr_clk
    //pix
    BKA3_3E_REG |= 0x00;//[6:4]rg_clkgen_dscout_muxsel       : 001-aa_pcrpll_pix_clk
                        //[3:0]rg_clkgen_dscout_divse        : div 2
    BKA3_3C_REG |= 0x00;//[6:4]rg_clkgen_cscrx_halfpix_muxsel: 000-aa_pcrpll_pix_clk or aa_secpcrpll_pix_clk
                        //[3:0]rg_clkgen_cscrx_halfpix_divsel: div 2
//    BKA3_41_REG |= 0x00;//[6:4]rg_clkgen_dsctx_dsc_muxsel    : 000-aa_pcrpll_pix_clk
    BKA3_42_REG |= 0x00;//[6:4]rg_clkgen_dsctx_dscrd_muxsel  : 001-aa_pcrpll_pix_clk
                        //[3:0]rg_clkgen_dsctx_dscrd_divsel : div 2  
}


