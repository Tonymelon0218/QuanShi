#if TX_PORT_SIGN == MIPI_PORT
void Drv_MipiTx_Info_Update(u8 ucEvent)
{
	
#define SOURECE_PLUG_EVENT   1
#define SOURECE_UNPLUG_EVENT 2
#define VIDEO_ON_EVENT      3
#define VIDEO_OFF_EVENT       4	
#define VIDEO_HDR_NOTIFY_EVENT  11	

	u16 Htotal ,Hactive ,Vtotal,Vactive;

        switch ( ucEvent )
        {
            case SOURECE_PLUG_EVENT :
                break;
            case SOURECE_UNPLUG_EVENT :
                break;
            case VIDEO_ON_EVENT :   
							
								/********Common:0xE080~0xE09F********/
								/*version:0xE080~0xE083*/
								/*interrupt type:0xE084*/
								 SET_BIT(BKE0_84_REG, BIT0);//video ready;
								 CLEAR_BIT(BKE0_84_REG, BIT2);
								/*pixelclock:0xE085~0xE087*/
							 
								BKE0_85_REG = (g_stMipiTx.ulMipiInClk*2 >> 16)&0x0F;
								BKE0_86_REG = g_stMipiTx.ulMipiInClk*2 >> 8;
								BKE0_87_REG = g_stMipiTx.ulMipiInClk*2;	
								/*resolution:0xE088~0xE08F*/
							
								Htotal    = Drv_VideoCheckSingle_Get(HTOTAL_POS);
								Hactive   = Drv_VideoCheckSingle_Get(HACTIVE_POS);
								Vtotal    = Drv_VideoCheckSingle_Get(VTOTAL_POS);
								Vactive   = Drv_VideoCheckSingle_Get(VACTIVE_POS);
							
								BKE0_88_REG = GET_16BIT_HIGH(Htotal);
								BKE0_89_REG = GET_16BIT_LOW(Htotal);
								BKE0_8A_REG = GET_16BIT_HIGH(Vtotal);
								BKE0_8B_REG = GET_16BIT_LOW(Vtotal);
								BKE0_8C_REG = GET_16BIT_HIGH(Hactive);
								BKE0_8D_REG = GET_16BIT_LOW(Hactive);
								BKE0_8E_REG = GET_16BIT_HIGH(Vactive);
								BKE0_8F_REG = GET_16BIT_LOW(Vactive);
								
								/*Byteclock:0xE092~0xE093*/
								BKE0_92_REG = ((g_stMipiTx.ulMipiDataRate/8)>>16)&0x0F;
								BKE0_93_REG = (g_stMipiTx.ulMipiDataRate/8)>>8;
								BKE0_94_REG = g_stMipiTx.ulMipiDataRate/8;
								
								/********Mipi:0xE0A0~0xE0AF********/
								/*Lane*/
								BKE0_A0_REG = g_stMipiTx.ucTxPortNum ;
								/*YUV422 10bit*/
								switch(g_stMipiTx.ucTxFormat)
								{
										case CSI_YUV422_8Bit:
												BKE0_A1_REG = 0x00;
												break;
										case CSI_YUV422_10Bit:
												BKE0_A1_REG = 0x01;
												break;
										case CSI_RGB_888:
												BKE0_A1_REG = 0x02;
												break;                    
										case CSI_YUV420_8Bit:
												BKE0_A1_REG = 0x03;
												break;
										default:
												BKE0_A1_REG = 0x00;
												break;
								}
								
								/********Dp:0xE095~0xE096********/								
								BKE0_95_REG = g_stDpRx.ucPixelEncoding;//0x00:rgb 0x01:yuv422 0x02:yuv444 0x03:yuv420
								BKE0_96_REG = g_stDpRx.ucBitDepth;//0-6bit,  1-8bit, 2-10bit, 3-12bit								
								
								LTLog(LOG_INFO,"MIPIVidInfoUpdate!!!!!!");
                break;
            case VIDEO_OFF_EVENT :
							
								BKE0_84_REG = 0x00;						
								BKE0_85_REG = 0x00;
						
								BKE0_86_REG = 0x00;
								BKE0_87_REG = 0x00;	
								BKE0_88_REG = 0x00;
								BKE0_89_REG = 0x00;
								BKE0_8A_REG = 0x00;
								BKE0_8B_REG = 0x00;
								BKE0_8C_REG = 0x00;
								BKE0_8D_REG = 0x00;
								BKE0_8E_REG = 0x00;
								BKE0_8F_REG = 0x00;	
								BKE0_90_REG = 0x00;
								BKE0_91_REG = 0x00;	
								BKE0_92_REG = 0x00;
								BKE0_93_REG = 0x00;
								BKE0_94_REG = 0x00;	
								BKE0_95_REG = 0x00;
								BKE0_96_REG = 0x00;	
								BKE0_97_REG = 0x00;		
								BKE0_98_REG = 0x00;	
								BKE0_99_REG = 0x00;			
								BKE0_9A_REG = 0x00;		
								BKE0_9B_REG = 0x00;	
								BKE0_9C_REG = 0x00;		
								BKE0_9D_REG = 0x00;		
								BKE0_9E_REG = 0x00;	
								BKE0_9F_REG = 0x00;																
								
								BKE0_A0_REG = 0x00;
								BKE0_A1_REG = 0x00;
								BKE0_A2_REG = 0x00;	
								BKE0_A3_REG = 0x00;		
								BKE0_A4_REG = 0x00;	
								BKE0_A5_REG = 0x00;	
								BKE0_A6_REG = 0x00;		
								BKE0_A7_REG = 0x00;	
								BKE0_A8_REG = 0x00;		
								BKE0_A9_REG = 0x00;										
																
								LTLog(LOG_INFO,"MIPIVidInfoClear!!!!!!");    
						
                break;
						
            case VIDEO_HDR_NOTIFY_EVENT :
								SET_BIT(BKE0_84_REG, BIT2);//HDR_EN;								

								BKE0_85_REG = 0x00;
						
								BKE0_86_REG = BKF2_3C_REG;
								BKE0_87_REG = BKF2_3D_REG;	
								BKE0_88_REG = BKF2_3E_REG;
								BKE0_89_REG = BKF2_3F_REG;
								BKE0_8A_REG = BKF2_40_REG;
								BKE0_8B_REG = BKF2_41_REG;
								BKE0_8C_REG = BKF2_42_REG;
								BKE0_8D_REG = BKF2_43_REG;
								BKE0_8E_REG = BKF2_44_REG;
								BKE0_8F_REG = BKF2_45_REG;	
								BKE0_90_REG = BKF2_46_REG;
								BKE0_91_REG = BKF2_47_REG;	
								BKE0_92_REG = BKF2_48_REG;
								BKE0_93_REG = BKF2_49_REG;
								BKE0_94_REG = BKF2_4A_REG;		
								BKE0_95_REG = BKF2_4B_REG;	
								BKE0_96_REG = BKF2_4C_REG;		
								BKE0_97_REG = BKF2_4D_REG;		
								BKE0_98_REG = BKF2_4E_REG;	
								BKE0_99_REG = BKF2_4F_REG;			
								BKE0_9A_REG = BKF2_50_REG;		
								BKE0_9B_REG = BKF2_51_REG;	
								BKE0_9C_REG = BKF2_52_REG;		
								BKE0_9D_REG = BKF2_53_REG;		
								BKE0_9E_REG = BKF2_54_REG;	
								BKE0_9F_REG = BKF2_55_REG;	
								BKE0_A0_REG = BKF2_56_REG;		
								BKE0_A1_REG = BKF2_57_REG;	
								BKE0_A2_REG = BKF2_58_REG;		
								BKE0_A3_REG = BKF2_59_REG;		
								BKE0_A4_REG = BKF2_5A_REG;	
								BKE0_A5_REG = BKF2_5B_REG;	
								BKE0_A6_REG = BKF2_5C_REG;		
								BKE0_A7_REG = BKF2_5D_REG;	
								BKE0_A8_REG = BKF2_5E_REG;		
								BKE0_A9_REG = BKF2_5F_REG;		
											
						
                break;						
            default:
                break;
        }	
	
}
#endif


u8 Drv_DPRX_AudFs_Det(void)
{
	u8 Fs_Val;
	Fs_Val = BKC6_7C_REG;
    if((Fs_Val >= 0xbf)&&(Fs_Val <= 0xc1))
    {
		return AUD_FS_192K;
    }	
    else if((Fs_Val >= 0xaf)&&(Fs_Val <= 0xb1))
    {
		return AUD_FS_176K;
    }	
	else if((Fs_Val >= 0x5f)&&(Fs_Val <= 0x61)) 
	{
		return AUD_FS_96K;
	}
	else if((Fs_Val >= 0x57)&&(Fs_Val <= 0x59)) 
	{
		return AUD_FS_88K;
	}	
    if((Fs_Val >= 0x2f)&&(Fs_Val <= 0x31))
	{
		return AUD_FS_48K;
	}
	else if((Fs_Val >= 0x2b)&&(Fs_Val <= 0x2d))
	{
		return AUD_FS_44K;
	}
    else if((Fs_Val >= 0x1f)&&(Fs_Val <= 0x21))
    {
		return AUD_FS_32K;
    }
    else if(Fs_Val == 0x00)
    {
		return AUD_FS_ZERO;
    }
    else
    {
        return AUD_FS_VOID;
    }
}

u8 Drv_DPRX_AudChannel(void)
{
    static u8 ChNum;
//    ChNum = BKF2_63_REG & 0x07;
		ChNum = BKF2_F5_REG & 0x07;
    if(ChNum)
    {
        ChNum += 1;
    }
    else
    {
        if(BKF2_F1_REG & 0x08)
        {
            ChNum = 8;
        }
        else
        {
            ChNum = 2;
        }
    }
    return ChNum;
}

u8 Drv_DPRX_AudBitWidth(void)
{
    u8 Width = 0;
		Width = BKF2_2E_REG & 0x0F;
    if(Width == 0x02)
    {
        Width = 16;
    }
    else if((Width == 0x03)||(Width == 0x0A))
    {
        Width = 20;
    }
    else if(Width == 0x0B)
    {
        Width = 24;
    }		
    return Width;
}

u8 Drv_DPRX_AudFs_Update(void)
{
	u8 ucFsValue;
    
    ucFsValue = Drv_DPRX_AudFs_Det();
      
    if(AUD_FS_VOID != ucFsValue)
    {
        if(ucFsValue == g_stDpRx.ucFsValue)
        {
            return FALSE;
        }
        g_stDpRx.ucFsValue = ucFsValue;
        return TRUE;
    }
    return FALSE;
}

void Drv_Aud_Info_Update(u8 IsTrue)
{
	
	u8 ucFsValue, AudCh, AudWidth;
	ucFsValue = Drv_DPRX_AudFs_Det();	
	AudCh = Drv_DPRX_AudChannel();
  AudWidth = Drv_DPRX_AudBitWidth();
    if(IsTrue != FALSE)
    {
				SET_BIT(BKE0_84_REG, BIT1);//Audio;
				CLEAR_BIT(BKE0_84_REG, BIT2);//Audio;	
        BKE0_A2_REG = AudCh;
				BKE0_A3_REG = AudWidth;			
        BKE0_90_REG = 0x00;
        BKE0_91_REG = ucFsValue;//Fs_value       
        LTLog(LOG_INFO,"AudInfoUpdate!!!!!!");       
    }
    else
    {
				CLEAR_BIT(BKE0_84_REG, BIT1);//Audio;				
        BKE0_A2_REG = 0x00;
				BKE0_A3_REG = 0x00;				
        BKE0_90_REG = 0x00;
        BKE0_91_REG = 0x00;//Fs_value               
        LTLog(LOG_INFO,"AudInfoClear!!!");
    }
		
//		if(ucFsValue == 0)
//		{
//				CLEAR_BIT(BKE0_84_REG, BIT1);//Audio;				
//        BKE0_A2_REG = 0x00;
//        BKE0_90_REG = 0x00;
//        BKE0_91_REG = 0x00;//Fs_value   			
//		}
}

