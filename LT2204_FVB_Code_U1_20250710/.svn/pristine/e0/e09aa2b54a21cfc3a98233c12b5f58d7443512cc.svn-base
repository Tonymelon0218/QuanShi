#if ((RX_PORT_SIGN == DP_PORT) &&(TX_PORT_SIGN == MIPI_PORT))
void Drv_Sys_LT7911gxe_MipiTx_PowerDomain(u8 b1IsPowerOn)
{
   if(b1IsPowerOn == TRUE)
   {
		 
		 //Dhtxphy
        BKA1_59_REG &= 0x3F;

		 //Dhtxrterm
        BKA1_5A_REG &= 0xF0; 	 		 

		 //arc
        BKA2_98_REG &= 0xFC;
        BKA2_9E_REG &= 0xBF;
        BKA2_99_REG &= 0xBF;		
		 
		 //Earcpll
        BKA3_14_REG |= 0x10;
		 
		 //Secpcrpll
        BKA3_2F_REG |= 0x10; 	 		 
		 
		 //HDMI RX
        BKC9_10_REG &= 0x00; 
        BKC9_11_REG &= 0x1F;     
        BKC9_1C_REG &= 0xF3;
        BKCD_46_REG &= 0x00;
        
		 //HDCP TX
//        BKE9_88_REG &= 0x7F;	
//        BKE9_88_REG &= 0x8F;	
//        BKE9_88_REG &= 0xF7;	
//        BKE9_88_REG &= 0xF8;	
//        BKE9_89_REG &= 0xF3;	
//        BKE9_89_REG &= 0xFC;	
        BKED_0B_REG &= 0x7C;	

        BKE9_88_REG &= 0x00;
        BKE9_89_REG &= 0x00;				
				#if MIPITX_VID_PATTERN_MODE == NO_PATTERN
		//PTN	
        BKC9_17_REG &= 0x7F;
				#endif
				
		//CRC
//        BKC9_17_REG &= 0xBF;

		//EARC
        BKC9_19_REG &= 0xFC;	
        BKC9_1A_REG &= 0x3F;
        BKE1_22_REG &= 0xFC;

		//CEC	
        BKE1_20_REG &= 0xFC;

		//DHRX SECPCRPLL
        BKE1_25_REG &= 0x3F;	

		//SECPCRPLL
        BKE1_33_REG &= 0x00;	

		//DHTX
//        BKE1_26_REG &= 0x00;	
//        BKE1_27_REG &= 0x07;		

//		//DHTXPLL
        BKE1_35_REG &= 0x03;	
        BKE1_35_REG &= 0xFC;
        BKE1_36_REG &= 0x7F;

		//EARCPLL
        BKE1_36_REG &= 0x80;	
        BKE1_38_REG &= 0xF7;

		#if PWM_OUT == DISABLED
		//PWM SYS
        BKE1_38_REG &= 0x7F;	
		#endif
		//FRL
        BKEC_05_REG &= 0x00;	

		//HDMITX20
					BKED_08_REG &= 0x80;	
					BKED_09_REG &= 0x00;
					BKED_0A_REG &= 0x7F;

		//HDMITX21
        BKED_0A_REG &= 0x80;	
				
		//AFIFO
        BKED_0B_REG &= 0x80;		
				
		//BYPASS SSC
        BKF9_BA_REG &= 0xE7;	
        BKF9_BA_REG &= 0xF9;
        BKF9_BB_REG &= 0x3F;
        BKF9_BD_REG &= 0xFB;		

		//LVDS
        BKF9_BB_REG &= 0xDF;	
	
	
		#if 0	
		/*******************DPHY**************/	
				//PORT //1port out Disable another port 
//        BKF9_BB_REG &= 0x1B;
//        BKF9_BC_REG &= 0x22;
//        BKF9_B9_REG &= 0x11;		
//        BKE1_2B_REG &= 0xC0;	

					//2port out  3D SBS
//					BKF9_BB_REG &= 0x1B;
//					BKF9_BC_REG &= 0xAA;
//					BKF9_B9_REG &= 0xFF;//0xAA or 0x55 	Display anomaly	
//					BKE1_2B_REG &= 0xF0;
		#endif
	
				
   }
   else
   {

   } 
}
#endif

