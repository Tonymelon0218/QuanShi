 490   1          {
 491   2              case RX_FM:
 492   2                  BKC7_40_REG |= BIT7_1;//[7]freq_khz_frz_en: 1-en
 493   2                  ulRtn = PACK_24_BIT(BKC7_58_REG & 0x0f, BKC7_59_REG, BKC7_5A_REG);
 494   2                  BKC7_40_REG &= BIT7_0;//[7]freq_khz_frz_en: 0-dis
 495   2                  break;
 496   2              
 497   2              case RXLINK_FM:
 498   2                  ulRtn = PACK_24_BIT(BKC7_48_REG & 0x0f, BKC7_49_REG, BKC7_4A_REG);
 499   2                  break;
 500   2              
 501   2              case TX_FM:
 502   2                  BKED_30_REG |= BIT1_1;//[1]rgd_txfm_freq_khz_frz_en: 1-en
 503   2                  ulRtn = PACK_24_BIT(BKED_3C_REG & 0x0f, BKED_3D_REG, BKED_3E_REG);
 504   2                  BKED_30_REG &= BIT1_0;//[1]rgd_txfm_freq_khz_frz_en: 0-dis
 505   2                  break;
 506   2      
 507   2              case TOP_FM:
 508   2                  BKE6_90_REG |= BIT7_1;//[7]freq_khz_frz_en: 1-en
 509   2                  ulRtn = PACK_24_BIT(BKE6_98_REG & 0x0f, BKE6_99_REG, BKE6_9A_REG);
 510   2                  BKE6_90_REG &= BIT7_0;//[7]freq_khz_frz_en: 0-dis
 511   2                  break;
 512   2      
 513   2              default:
 514   2                  printLT(PRINT_PRIO_HIG, "\nWARNING: Freq meter get fail");
 515   2                  break;
 516   2          }
 517   1      
 518   1          ulRtn <<= ucOpt;
 519   1          return ulRtn;
 520   1      }
