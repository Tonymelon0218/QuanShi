 479          //func  :system freq meter value get
C51 COMPILER V9.53.0.0   DRVSYSTEM                                                         02/13/2025 10:14:23 PAGE 9   

 480          //input :emType: freq meter
 481          //      :ucOpt: HALF_PIX_CLK, PIX_CLK
 482          //output:N/A
