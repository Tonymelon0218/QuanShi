                                                                              BKE0_8F_REG = 0x00;     
                                                                              BKE0_90_REG = 0x00;
                                                                              BKE0_91_REG = 0x00;     
                                                                              BKE0_92_REG = 0x00;
                                                                              BKE0_93_REG = 0x00;
C51 COMPILER V9.53.0.0   DRVSYSTEM                                                         02/13/2025 10:14:23 PAGE 26  

                                                                              BKE0_94_REG = 0x00;     
                                                                              BKE0_95_REG = 0x00;
                                                                              BKE0_96_REG = 0x00;     
                                                                              BKE0_97_REG = 0x00;             
                                                                              BKE0_98_REG = 0x00;     
                                                                              BKE0_99_REG = 0x00;                     
                                                                              BKE0_9A_REG = 0x00;             
