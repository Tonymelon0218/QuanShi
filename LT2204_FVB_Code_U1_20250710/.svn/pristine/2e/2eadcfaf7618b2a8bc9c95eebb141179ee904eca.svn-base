                                       //[0]rg_clkgen_pix_clk_recvsel       : 0-aa_pcrpll_pix_clk
                  BKA3_46_REG = 0x00;//[2:0]rg_clkgen_pcr_clk_recvsel      : 000-aa_pcrpll_pcr_clk
                  //pix
                  BKA3_3E_REG |= 0x00;//[6:4]rg_clkgen_dscout_muxsel       : 001-aa_pcrpll_pix_clk
                                      //[3:0]rg_clkgen_dscout_divse        : div 2
                  BKA3_3C_REG |= 0x00;//[6:4]rg_clkgen_cscrx_halfpix_muxsel: 000-aa_pcrpll_pix_clk or aa_secpcrpll_pix_c
             -lk
                                      //[3:0]rg_clkgen_cscrx_halfpix_divsel: div 2
              //    BKA3_41_REG |= 0x00;//[6:4]rg_clkgen_dsctx_dsc_muxsel    : 000-aa_pcrpll_pix_clk
                  BKA3_42_REG |= 0x00;//[6:4]rg_clkgen_dsctx_dscrd_muxsel  : 001-aa_pcrpll_pix_clk
C51 COMPILER V9.53.0.0   DRVSYSTEM                                                         02/13/2025 10:14:23 PAGE 24  

                                      //[3:0]rg_clkgen_dsctx_dscrd_divsel : div 2  
              }
              
              
