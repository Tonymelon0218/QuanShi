 605          u8 Drv_System_VidChkStateGet(u8 b1GetEnable)
 606          {
 607   1          static u8 ucVidChk_Scan_Cnt = 0;
 608   1          if(b1GetEnable == DISABLED)
 609   1          {
 610   2              ucVidChk_Scan_Cnt = 0; 
 611   2          }
 612   1          else
 613   1          {
 614   2              BKC8_71_REG &= 0x3f;// hacitve vactive clr = 0;
 615   2              if(BKC8_6F_REG & BIT2_1)
 616   2              {
 617   3                  ucVidChk_Scan_Cnt++;
 618   3              }
 619   2              else if(((BKC8_6F_REG & BIT2_1) == 0x00)||(BKC8_6E_REG&0x30))
 620   2              {
 621   3                  BKC8_71_REG |= 0xc0;// hactive vactive clr = 1;
 622   3                  BKC8_71_REG &= 0x3f;// hactive vactive clr = 0;
 623   3                  ucVidChk_Scan_Cnt = 0;
 624   3                  return UNSTABLE; 
 625   3              }
 626   2              if(ucVidChk_Scan_Cnt >= 200)
 627   2              {
 628   3                  return STABLE;
 629   3              }
 630   2          }
 631   1          return UNKNOWN; 
 632   1      }
