                  BKF3_3D_REG |=0x06;//[3:2]rg_diff_ord_sel;
                                      //[1:0]rg_sdm_ord_sel;  
                  BKA3_2A_REG = 0x00;         
              }
              
              void Drv_PtnTiming_Set(struct TIMING *CustomTiming)
              {
                      
              //    LTLog(LOG_INFO, "Pattern[H]: Htotal:%d,Hactive:%d,Hsw:%d,Hfp:%d,Hbp:%d,Hspol:%bd",  CustomTiming->Ht
             -otal, CustomTiming->Hactive, CustomTiming->Hsw, CustomTiming->Hfp, CustomTiming->Hbp,CustomTiming->Hspol);
              //    LTLog(LOG_INFO, "Pattern[V]: Vtotal:%d,Vactive:%d,Vsw:%d,Vfp:%d,Vbp:%d,Vspol:%bd",  CustomTiming->Vt
             -otal, CustomTiming->Vactive, CustomTiming->Vsw, CustomTiming->Vfp, CustomTiming->Vbp,CustomTiming->Vspol);    
                      
                              BKC7_C3_REG = ((CustomTiming->Hsw+CustomTiming->Hbp)/2)/256;
                              BKC7_C4_REG = ((CustomTiming->Hsw+CustomTiming->Hbp)/2)%256;
                              BKC7_C5_REG = (CustomTiming->Vsw+CustomTiming->Vbp)/256;
                              BKC7_C6_REG = (CustomTiming->Vsw+CustomTiming->Vbp)%256;
                              BKC7_C7_REG = (CustomTiming->Hactive/2)/256;
                              BKC7_C8_REG = (CustomTiming->Hactive/2)%256;
                              BKC7_C9_REG = (CustomTiming->Vactive)/256;
                              BKC7_CA_REG = (CustomTiming->Vactive)%256;
                              BKC7_CB_REG = (CustomTiming->Htotal/2)/256;
                              BKC7_CC_REG = (CustomTiming->Htotal/2)%256;
                              BKC7_CD_REG = (CustomTiming->Vtotal)/256;
                              BKC7_CE_REG = (CustomTiming->Vtotal)%256;
                              BKC7_CF_REG = (CustomTiming->Hsw/2)/256;
                              BKC7_D0_REG = (CustomTiming->Hsw/2)%256;
                              BKC7_D1_REG = CustomTiming->Vsw;                
                      
              }
              
              void Drv_PtnDataClk_Mux(void)
              {
                  //data mux
                  BKC7_D7_REG &= BIT6_0;//[6]rgd_dsc_dec_sel: 0-bypass
                  Drv_Sys_ChipRxSrcSel(CHIPRX_SRC_SEL_PTN);
                  //clk mux
                  BKA3_45_REG &= 0xe0;
                  BKA3_3C_REG &= 0x80;
                  BKA3_3E_REG &= 0x80;
                  BKA3_41_REG &= 0x80;
                  BKA3_42_REG &= 0x80;
