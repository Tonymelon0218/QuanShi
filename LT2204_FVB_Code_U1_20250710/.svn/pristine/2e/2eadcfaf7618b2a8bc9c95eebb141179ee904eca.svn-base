 913          void Drv_Sys_EncPowerDomain(u8 b1IsPowerOn)
 914          {
 915   1         if(b1IsPowerOn == TRUE)
 916   1         {
 917   2              BKE1_29_REG = 0x00;    // clk disable 
 918   2              BKE5_80_REG &= BIT1_0; //power iso_en
 919   2              BKE1_0B_REG &= BIT0_0; //reset
 920   2              BKE5_80_REG &= BIT0_0; //power domin  enable
