 838   2              BKE1_25_REG = 0x00;    //clk disable 
 839   2              BKE5_80_REG &= BIT7_0; //power iso_en
 840   2              BKE1_0B_REG &= BIT3_0; // reset
 841   2              BKE5_80_REG &= BIT6_0; //power domin  enable
 842   2         }
 843   1         else
 844   1         {
 845   2              BKE5_80_REG |= BIT6_1; //power domin  disable
 846   2              BKE1_0B_REG |= BIT3_1; // reset
 847   2              BKE5_80_REG |= BIT7_1; //power iso_en
 848   2              BKE1_21_REG = 0x7f; 
 849   2              BKE1_22_REG = 0x0b; 
