 561   2                 #if HDR10PLUS==ENABLED  
                          if ((BKCC_B1_REG == 0x81)&&(BKCC_B5_REG == 0x8b)&&(BKCC_B6_REG == 0x84)&&(BKCC_B7_REG == 0x90)
             -)
                          {
                              ucRtn = SUCCESS+1;
                          } 
                         #endif   
 567   2                 #endif 
 568   2                  break;
 569   2              case HDR_INFO_FRAME_0X87:
 570   2                  if ((BKCC_75_REG == 0x87)&&(BKCC_76_REG == 0x01)&&(BKCC_77_REG == 0x1A))//&& (BKCC_79_REG!=0
 571   2                  {
 572   3                      ucRtn = SUCCESS;
 573   3                  }
 574   2                  break;
 575   2              case AVI_INFO_FRAME_0X82:
 576   2                  if ((BKCC_9F_REG == 0x82) &&
 577   2                      ((BKCC_A0_REG == 0x02) || (BKCC_A0_REG == 0x03)) &&
 578   2                      (BKCC_A1_REG == 0x0d))
 579   2                  {
 580   3                      ucRtn = SUCCESS;
 581   3                  }
 582   2                  break;
 583   2      
 584   2              default:
 585   2                  break;
 586   2          }
 587   1      
 588   1          return ucRtn;
 589   1      }
