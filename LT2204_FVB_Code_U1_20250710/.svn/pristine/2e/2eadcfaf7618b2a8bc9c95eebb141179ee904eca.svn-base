 792          //========================================================================
 793          // Func Name   : Drv_Sys_HdcpKeyLoad
 794          // Description : load hdcp key from flash to sram.
 795          // Input       : void  
 796          // Output      : None
 797          // Return      : void
 798          //========================================================================
 799          void Drv_Sys_HdcpKeyLoad(void)
 800          {
 801   1          u8 loadkey_cnt = 0;
 802   1      
 803   1          BKCA_2B_REG |= BIT6_1; 
 804   1          BKCA_2B_REG &= BIT6_0; //load key status clear.
 805   1      
 806   1          //rgd_sec_flash_init_addr[23:0] = 0x050000 (Flash load address)
 807   1          BKE0_68_REG = 0x05;
 808   1          BKE0_69_REG = 0x00;
 809   1          BKE0_6A_REG = 0x00;
 810   1          
 811   1          //rgd_upld_size[23:0] = = 0x000800 (Flash load size)
 812   1          BKE0_65_REG = 0x00;
 813   1          BKE0_66_REG = 0x08;
 814   1          BKE0_67_REG = 0x00;
 815   1      
 816   1          BKE0_60_REG |= BIT1_1; //start load key.
 817   1          do
 818   1          {
 819   2              loadkey_cnt++;
 820   2              Ocm_Delay1ms(1);
 821   2              if(BKCA_80_REG & BIT0_1)
 822   2              {
 823   3                  break;
 824   3              }
 825   2          }while(loadkey_cnt < 20);
 826   1          printLT(PRINT_PRIO_HIG, "\nload key done[0x%02bx]",BKCA_80_REG);
 827   1          BKE0_60_REG &= BIT1_0; //stop load key.
 828   1      }
