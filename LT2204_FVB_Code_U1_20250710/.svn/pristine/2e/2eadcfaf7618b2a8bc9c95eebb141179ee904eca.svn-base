              void Drv_PWM0_Sel(u16 CycleFreq , u16 Cycle)
              {
                  BKE6_10_REG |= BIT4_1;//pwm enable
                  
                  BKE6_11_REG = 0x00;//period(Hbyte) 
                  BKE6_12_REG = CycleFreq>>8;//
                  BKE6_13_REG = CycleFreq;//period(Lbyte)
              
                  BKE6_14_REG = 0x00;//High time(Hbyte)
                  BKE6_15_REG = Cycle>>8;
                  BKE6_16_REG = Cycle;//High time(Lbyte)
              }
              
              void Drv_PWM1_Sel(u16 CycleFreq , u16 Cycle)
              {
                  BKE6_26_REG |= BIT4_1;//pwm enable
                  
                  BKE6_27_REG = 0x00;//period(Hbyte) 
                  BKE6_28_REG = CycleFreq>>8;//
                  BKE6_29_REG = CycleFreq;//period(Lbyte)
              
                  BKE6_2A_REG = 0x00;//High time(Hbyte)
                  BKE6_2B_REG = Cycle>>8;
                  BKE6_2C_REG = Cycle;//High time(Lbyte)
              }
              
              void Drv_PWM2_Sel(u16 CycleFreq , u16 Cycle)
              {
                  BKE6_3C_REG |= BIT4_1;//pwm enable
                  
                  BKE6_3D_REG = 0x00;//period(Hbyte) 
                  BKE6_3E_REG = CycleFreq>>8;//
                  BKE6_3F_REG = CycleFreq;//period(Lbyte)
              
                  BKE6_40_REG = 0x00;//High time(Hbyte)
                  BKE6_41_REG = Cycle>>8;
                  BKE6_42_REG = Cycle;//High time(Lbyte)
              }
              
              void Drv_PWM3_Sel(u16 CycleFreq , u16 Cycle)
              {
                  BKE6_52_REG |= BIT4_1;//pwm enable
                  
                  BKE6_53_REG = 0x00;//period(Hbyte) 
                  BKE6_54_REG = CycleFreq>>8;//
                  BKE6_55_REG = CycleFreq;//period(Lbyte)
              
                  BKE6_56_REG = 0x00;//High time(Hbyte)
C51 COMPILER V9.53.0.0   DRVSYSTEM                                                         02/13/2025 10:14:23 PAGE 31  

                  BKE6_57_REG = Cycle>>8;
                  BKE6_58_REG = Cycle;//High time(Lbyte)
              }
              
              volatile u8 l_TXEventTrig;
              volatile u8 l_TXEvent;
              
              void TX_Event_Init(void)
              {
                  l_TXEventTrig = FALSE;
                  l_TXEvent = TX_SINK_UNPLUG_EVENT_2;    
              }
              
              void TX_Event_Set(u8 TxEvent)
              {
                  l_TXEventTrig = TRUE;//g_RXEventTrig = TRUE
                  l_TXEvent = TxEvent;
                  LTLog(LOG_INFO,"TxEvent-%bd",TxEvent);
              }
              
              u8 TX_Event_Trig(void)
              {
                  return l_TXEventTrig;
              }
              
              void TX_Event_Clr(void)
              {
                  l_TXEventTrig = FALSE;
              }
              
              u8 TX_Event_Get(void)
              {
                  return l_TXEvent;
              }
