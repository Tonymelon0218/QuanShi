 336          u8 Mod_HdmiRx_VrrVtimingDet(void)
 337          {
 338   1          u16 usVotal_New,usVactive_New,usHactive_New;
 339   1          u16 usVotal_Old,usVactive_Old,usHactive_Old;
 340   1          usVotal_Old   = ((u16)BKC8_52_REG <<8 ) + BKC8_53_REG ;
 341   1          usVactive_Old = ((u16)BKC8_56_REG <<8 ) + BKC8_57_REG ;
 342   1          usHactive_Old = ((u16)BKC8_58_REG <<8 ) + BKC8_59_REG ;
