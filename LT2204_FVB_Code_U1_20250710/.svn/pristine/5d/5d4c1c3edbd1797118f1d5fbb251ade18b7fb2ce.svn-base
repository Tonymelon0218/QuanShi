 460   1          if (BKCD_AD_REG & BIT1_1) //[1]rgod_tmds_pcr_freq_pixel_stable: 1-stable
 461   1          {
 462   2              ulFreqSet = PACK_24_BIT(BKCD_AA_REG&0x0f,BKCD_AB_REG,BKCD_AC_REG);
 463   2          }
 464   1          if ((ulFreqSet == 0) || (ulFreqSet >= 1200000))
 465   1          {
 466   2              return;
 467   2          }
 468   1      
 469   1          if(ulFreqSet < 18750)
