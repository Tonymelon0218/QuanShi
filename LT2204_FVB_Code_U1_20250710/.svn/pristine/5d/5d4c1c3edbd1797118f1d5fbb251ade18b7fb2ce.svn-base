 191   2              else
 192   2              {
 193   3                  ucAudioOut = ON;
 194   3              }
 195   2          }
 196   1      
 197   1          //gcp set_avmute should mute else mute clear
 198   1          if (BKCC_F3_REG & BIT2_1)//not find gcp, return
 199   1          {
