 110          void Mod_HdmiRx_SourceDetProc(void)
 111          {
 112   1          if(g_stHdmiRx.ucRxState >= STATE_HDMIRX_WAITE_SOURCE_2)
 113   1          {
C51 COMPILER V9.53.0.0   MODHDMIRX                                                         02/13/2025 10:14:07 PAGE 3   

 114   2              //the last source detect is high.
 115   2              if(g_stHdmiRx.b1SourceDet == HIGH)
 116   2              {
 117   3                  //the current source detect is low.
 118   3                  if(Drv_GetIO_State(GPIO2_DHRX_DCAUXN_5VDET) == FALSE)   
 119   3                  {
 120   4                      Drv_HdmiRx_ErrValidClr(ENABLED);
 121   4                      Mod_HdmiRx_SetState(STATE_HDMIRX_WAITE_SOURCE_2);          
 122   4                      Mod_HdmiRx_HpdLowAction();
 123   4                      g_stHdmiRx.b1SourceDet = LOW;
 124   4                      Mod_HdmiRx_MsgNotify(HDMIRX_SOURECE_UNPLUG_EVENT);
 125   4                      printLT(PRINT_PRIO_HIG, "\nHdmi rx unplug");
 126   4                  }
 127   3              }
 128   2              //the last source detect is low.
 129   2              else
 130   2              {
 131   3                  //the current source detect is high.
 132   3                  if (Drv_GetIO_State(GPIO2_DHRX_DCAUXN_5VDET) == TRUE)
 133   3                  {
 134   4                      g_stHdmiRx.b1SourceDet = HIGH;
 135   4                      Mod_HdmiRx_MsgNotify(HDMIRX_SOURECE_PLUG_EVENT);
 136   4                      printLT(PRINT_PRIO_HIG, "\nHdmi rx plug");
 137   4                  }
 138   3              }
 139   2          }
 140   1      }
