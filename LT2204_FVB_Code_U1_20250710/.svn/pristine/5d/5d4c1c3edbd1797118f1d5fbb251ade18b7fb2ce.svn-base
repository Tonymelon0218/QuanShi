 344   1          usVotal_New   = ((u16)BKC8_52_REG <<8 ) + BKC8_53_REG ;
 345   1          usVactive_New = ((u16)BKC8_56_REG <<8 ) + BKC8_57_REG ; 
 346   1          usHactive_New = ((u16)BKC8_58_REG <<8 ) + BKC8_59_REG ;    
 347   1          if((usVotal_Old != usVotal_New) &&(usVactive_Old == usVactive_New)&&(usHactive_Old == usHactive_New))
 348   1          {
 349   2              return VRR_ON; 
 350   2          }
 351   1          else if((usVotal_Old == usVotal_New) &&(usVactive_Old == usVactive_New)&&(usHactive_Old == usHactive_N
             -ew))
 352   1          {
 353   2              return VRR_OFF;
 354   2          }
 355   1          return NO_VRR;
 356   1      }
