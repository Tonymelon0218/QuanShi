 202   2              uGcpPacketSetMute = BKCC_9C_REG & BIT0_1;
 203   2              if(1 == uGcpPacketSetMute)
 204   2              {
 205   3                   ucAudioOut = OFF;
 206   3              }
 207   2              else
 208   2              {
 209   3                   ucAudioOut = ON;
 210   3              }
 211   2          }
 212   1      
 213   1          if (ucAudioState != ucAudioOut)
 214   1          {
 215   2              ucAudioState = ucAudioOut;
 216   2              if (ucAudioOut == OFF)
 217   2              {
 218   3                  Mod_HdmiRx_MsgNotify(HDMIRX_AUDIO_MUTE_EN);
 219   3              }
 220   2              else
 221   2              {
 222   3                  Mod_HdmiRx_MsgNotify(HDMIRX_AUDIO_MUTE_DIS);
 223   3              }
 224   2              if (1 == uGcpPacketSetMute)
 225   2              {
 226   3                  Mod_HdmiRx_MsgNotify(HDMIRX_VIDEO_MUTE_EN);
 227   3              }
 228   2              else
 229   2              {
 230   3                  Mod_HdmiRx_MsgNotify(HDMIRX_VIDEO_MUTE_DIS);
 231   3              }
 232   2          }
 233   1          #endif
 234   1      }
