 368          void Mod_HdmiRx_TmdsClkCal(void)
 369          {
 370   1          ColorInfo_S stInfo;
 371   1      
 372   1          Drv_HdmiRx_ColorInfoGet(&stInfo);
 373   1          #if HDMIRX_DSC_DEC_SUPPORT == ENABLED
 374   1          if (Drv_HdmiRxDscDec_SwitchGet() == ENABLED)
 375   1          {
 376   2              Drv_HdmiRxDscDec_ColorInfoGet(&stInfo);
 377   2          }
 378   1          #endif
 379   1          #if HDMIRX_DSC_BYPASS_SUPPORT == ENABLED
 380   1          if (Drv_HdmiRxDscBy_SwitchGet() == ENABLED)
 381   1          {
 382   2              Drv_HdmiRxDscBy_ColorInfoGet(&stInfo);
 383   2          }
 384   1          #endif
 385   1      
 386   1          Drv_System_FmSet(TOP_FM,TOPFM_PCRPLL_PCR_CLK);
 387   1          Ocm_Delay1ms(10);
 388   1          g_stHdmiRx.ulRxPixelClk = Drv_System_FmGet(TOP_FM,HALF_PIX_CLK);
 389   1      
 390   1          if((stInfo.ucPixelEncoding != YCbCr422_1)&&(stInfo.ucBitDepth == HDMIRX_10BIT_5))
 391   1          {
 392   2              g_stHdmiRx.ulRxTmdsClk = (g_stHdmiRx.ulRxPixelClk*5)>>2;
 393   2          }
 394   1          else if((stInfo.ucPixelEncoding != YCbCr422_1)&&(stInfo.ucBitDepth == HDMIRX_12BIT_6))
 395   1          {
 396   2              g_stHdmiRx.ulRxTmdsClk = (g_stHdmiRx.ulRxPixelClk*3)>>1;
 397   2          }
 398   1          else
 399   1          {
 400   2               g_stHdmiRx.ulRxTmdsClk = g_stHdmiRx.ulRxPixelClk;
 401   2          }
 402   1          g_stHdmiRx.ulRxPixelClk <<= 1;
 403   1          g_stHdmiRx.ulRxTmdsClk  <<= 1;
 404   1      }
