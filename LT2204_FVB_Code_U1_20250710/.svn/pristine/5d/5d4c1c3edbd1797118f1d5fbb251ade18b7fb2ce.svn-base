 172          void Mod_HdmiRx_AudioSampleFlagChk(void)
 173          {
 174   1          #if TX_AUDIO_SEL == RX_AUDIO_DATA
 175   1          u8 ucAudioFS;
C51 COMPILER V9.53.0.0   MODHDMIRX                                                         02/13/2025 10:14:07 PAGE 4   

 176   1          u8 ucAspSampleFlat;
 177   1          u8 ucAspSamplePresent;
 178   1          u8 uGcpPacketSetMute = 0;
 179   1          u8 ucAudioOut = ON;
 180   1          static u8 ucAudioState = ON;
 181   1      
 182   1          ucAudioFS = BKC6_7C_REG;//audio fs val
 183   1          if((47 <= ucAudioFS) && (49 >= ucAudioFS))
 184   1          {
 185   2              ucAspSampleFlat    = BKCC_9B_REG & BIT0_1;
