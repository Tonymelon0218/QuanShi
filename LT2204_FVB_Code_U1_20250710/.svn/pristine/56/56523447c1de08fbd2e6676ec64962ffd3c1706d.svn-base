 283          void Drv_HdmiRx_Frl_PllCali(void)
 284          {
 285   1          u8 ucCnt;
 286   1          u8 ucloop_rxpll_cal;
 287   1          BKA1_30_REG &= 0xfc;//bit7 pll power on [1:0]rg_dhrxpll_ref_sel: 00-xtal_25m_clk or xtal_50m_clk
 288   1          BKA1_33_REG = 0x60;//rxpll prediv = 1
 289   1          BKA1_3E_REG = 0X60;//rxpll fb div = 1;
 290   1          BKA1_35_REG |=BIT7_1;//hdmi mode must set 
 291   1          BKA1_42_REG = 0x80; //rxpll freqset  = 0
 292   1          BKA1_44_REG = 0x80;// not analogic cdr mode
 293   1          
 294   1          BKE3_00_REG |= BIT1_1;//[1]rgd_dhrxpll_cal_pll_cal_en_auto_en: 1-calibrate multiple frequenc
 295   1          BKE3_09_REG |= BIT3_1;// sel hdmi2.1 mode  00 hdmi2.0 01 XX 10 hdmi2.1  11 dp mode
 296   1      
 297   1          BKE3_0A_REG &= 0xcf;//[5:4]rgd_dhrxpll_cal_frl_set_mode_sel: 00-auto ctrl mode
C51 COMPILER V9.53.0.0   DRVHDMIRX                                                         02/13/2025 10:14:18 PAGE 6   

 298   1          BKE3_0B_REG &= BIT0_0;//[0]rgd_dhrxpll_cal_pll_band_sw_en: 0-dis
 299   1          
 300   1          for(ucloop_rxpll_cal = 0;ucloop_rxpll_cal < 2;ucloop_rxpll_cal++)
 301   1          {
 302   2              (ucloop_rxpll_cal == 0)?(BKA1_31_REG &= BIT7_0):(BKA1_31_REG |= BIT7_1);//vco in high freq
 303   2              ucCnt = 3;
 304   2              while(ucCnt--)
 305   2              {
 306   3                  BKE1_05_REG &= 0xfc;//[0]rgd_sw_dhrxpll_cal_rst_n: 0-en
 307   3                  BKA1_30_REG &= BIT6_0;//[6]rg_dhrxpll_rst_n: 0-en
 308   3                  BKE3_00_REG &= BIT0_0;//[0]rgd_dhrxpll_cal_pll_cal_en: 0-dis
 309   3                  Ocm_Delay1ms(1);
 310   3                  BKE1_05_REG |= 0x03;//[0]rgd_sw_dhrxpll_cal_rst_n: 1-dis
 311   3                  BKA1_30_REG |= BIT6_1;//[6]rg_dhrxpll_rst_n: 1-dis
 312   3                  BKE3_00_REG |= BIT0_1;//[0]rgd_dhrxpll_cal_pll_cal_en: 1-en
 313   3                  Ocm_Delay1ms(2);
 314   3                  if((BKE3_1A_REG < 0xff)&&(BKE3_1B_REG == 0xff)&&((BKE3_24_REG&0x03) == 0x03))
 315   3                  {
 316   4                      break;
 317   4                  }
 318   3                  if((BKE3_24_REG&0x03) == 0x02) //[1]rgod_dhrxpll_pll_cal_done: 1-done
 319   3                  {
 320   4                      break;
 321   4                  }
 322   3              }
 323   2              if(ucloop_rxpll_cal == 0)
 324   2              {
 325   3                  BKE3_0D_REG = BKE3_18_REG;//dhrxpll hd03 band
 326   3                  BKE3_0E_REG = BKE3_19_REG;//dhrxpll hd06 band
 327   3                  BKE3_0F_REG = BKE3_1A_REG;//dhrxpll hd08 band
 328   3              }
 329   2              else if(ucloop_rxpll_cal == 1)
 330   2              {
 331   3                  BKE3_10_REG = BKE3_1B_REG;//dhrxpll hd10 band
 332   3                  BKE3_11_REG = BKE3_1C_REG;//dhrxpll hd12 band
 333   3              }
 334   2          }
 335   1          printLT(PRINT_PRIO_TEST, "\nFrl rxpll cali band= %02bx,%02bx,%02bx,%02bx,%02bx",
 336   1                              BKE3_0D_REG, BKE3_0E_REG, BKE3_0F_REG, BKE3_10_REG, BKE3_11_REG);
 337   1          BKA1_31_REG &= BIT7_0;
 338   1          BKE3_00_REG &= BIT1_0;//[1]rgd_dhrxpll_cal_pll_cal_en_auto_en: 0-calibrate a single frequency
 339   1      }
