 367   2              if (BKCD_B6_REG & 0x07)//[3:0]rgod_ln3(lan3~lan0)_locked: 1-lock
 368   2              {
 369   3                  return SUCCESS;
 370   3              }
 371   2          }
 372   1          else//4lane
 373   1          {
 374   2              if (BKCD_B6_REG & 0x0f)//[3:0]rgod_ln3(lan3~lan0)_locked: 1-lock
