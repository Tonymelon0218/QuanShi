              u8 Drv_HdmiRx_VideoDisappearDetect()
              {
                              if(BKE0_84_REG != 0x00)
                              {
                                              BKE0_84_REG = 0x00;//video interrupt type
                                              BKE0_90_REG = 0x00;//audio interrupt type
                                      
                                              //resolution
                                              BKE0_88_REG = 0;
                                              BKE0_89_REG = 0;
                                              BKE0_8A_REG = 0;
                                              BKE0_8B_REG = 0;
                                              BKE0_8C_REG = 0;
                                              BKE0_8D_REG = 0;
                                              BKE0_8E_REG = 0;
                                              BKE0_8F_REG = 0;
                                      
                                              //Byteclk
                                              BKE0_92_REG = 0;
                                              BKE0_93_REG = 0;
                                              BKE0_94_REG = 0;
                                      
                                              //pixlClk
                                              BKE0_85_REG = 0;
                                              BKE0_86_REG = 0;
                                              BKE0_87_REG = 0;
                                              
                                              //audio sample rate
                                              BKE0_91_REG = 0;
                                              
                                              //color space
                                              BKE0_95_REG = 0;
                                              return 1;
                              }
                              else
                              {
                                        return 0;
                              }
              }
