 382          u8 Drv_HdmiRx_LinkVidTimingChk(void)
 383          {
 384   1          u16 ucTempHactive,ucTempVactive;
 385   1          ucTempHactive = ((u16)BKCD_DB_REG << 8) + BKCD_DC_REG;
 386   1          ucTempVactive = ((u16)BKCD_DF_REG << 8) + BKCD_E0_REG;
 387   1          if((ucTempHactive <= 0x00ff)||(ucTempHactive == 0xffff))
 388   1          {
 389   2              return FAIL;
 390   2          }
 391   1          if((ucTempVactive <= 0x00ff)||(ucTempVactive == 0xffff))
 392   1          {
 393   2              return FAIL;
 394   2          }
 395   1          Ocm_Delay1ms(2);
 396   1          if((BKCD_DB_REG != ((ucTempHactive>>8)&0xff))||(BKCD_DC_REG != (ucTempHactive&0xff)))
 397   1          {
 398   2              return FAIL;
 399   2          }
 400   1          if((BKCD_DF_REG != ((ucTempVactive>>8)&0xff))||(BKCD_E0_REG != (ucTempVactive&0xff)))
 401   1          {
 402   2              return FAIL;
 403   2          }
 404   1          printLT(PRINT_PRIO_TEST, "\nThe hdmirx timing is 0x%04x,0x%04x", ucTempHactive,ucTempVactive);
 405   1          return SUCCESS;
 406   1      }
