 644   2                  BKCD_48_REG |= BIT5_1;//[5]rgd_sw_frl_dec_rst_n: 1-dis
 645   2                  break;
 646   2              case HDMI_FEC_DEC_RST:
 647   2                  BKCD_48_REG &= BIT3_0;//[3]rgd_sw_fec_dec_rst_n: 1-en
 648   2                  BKCD_48_REG |= BIT3_1;//[3]rgd_sw_fec_dec_rst_n: 0-dis
 649   2                  break;
 650   2              case HDMI_FRL_DEPKT_RST:
