 497   1                             //[1]rg_dhrx_linkclk_sel: 0-sel from dhrx, 1-sel from dhrxpll
 498   1                             //[0]rg_dhrx_linkclk_div2_en: 0-use from normal half-rate mode, 1-use for new full-
             -rate mede;
