 451          void Drv_HdmiRx_RtermCali(void)
 452          {
 453   1          u8 ucIndex;
 454   1          u8 ucResult = FAIL;
 455   1          
 456   1          BKA1_08_REG |= BIT3_1;//[3]rg_dhrx_en: 0-dis, 1-en;
 457   1          #if CHIP_VERSION_SEL > U1_VERSION
 458   1          BKA1_1D_REG &= BIT7_0;//[7]clk pkdet soft mode: 0-dis
 459   1          #endif
 460   1          ucIndex = 10;
 461   1          while(ucIndex--)
 462   1          {
 463   2              BKE2_00_REG &= BIT0_0;//[0]rgd_dhrx_rterm_cali_en, 0-dis
 464   2              Ocm_Delay1ms(1);
 465   2              BKE2_00_REG |= BIT0_1;//[0]rgd_dhrx_rterm_cali_en, 1-en
 466   2              Ocm_Delay1ms(2);
 467   2      
 468   2              if(0x02 == (BKE2_07_REG & 0x03))//[1]rgod_dhrx_rterm_cali_done: 1-done; [0]rgod_dhrx_rterm_cali_fa
             -il: 1-fail
 469   2              {
 470   3                  ucResult = SUCCESS;
 471   3                  break;
 472   3              }
 473   2          }
 474   1      
 475   1          printLT(PRINT_PRIO_HIG, "\nHdmi rx rterm cali value is 0x%02bx", BKE2_08_REG);
 476   1          if(ucResult == SUCCESS)//Rterm calibration done
 477   1          {
 478   2              printLT(PRINT_PRIO_HIG, "\nCali success");
 479   2          }
 480   1          else
 481   1          {
 482   2              printLT(PRINT_PRIO_HIG, "\nCali failed");
C51 COMPILER V9.53.0.0   DRVHDMIRX                                                         02/13/2025 10:14:18 PAGE 9   

 483   2          }
 484   1      }
