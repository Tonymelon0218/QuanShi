 341          void Drv_HdmiRx_Frl_PllBandSet(u8 frlrate)
 342          {
 343   1          BKA1_31_REG &= 0xe0;
 344   1          BKA1_31_REG |= 0x08;//[4:0]rg_dhrxpll_cpcur_sel
 345   1          (frlrate <= FRL_8G4LANE)?(BKA1_31_REG &= BIT7_0):(BKA1_31_REG |= BIT7_1);//vco in high freq
 346   1          BKA1_33_REG = 0x60;//rxpll prediv = 1
 347   1          BKA1_36_REG = 0x33;//[6:4]rg_dhrxpll_lpf_cinset
 348   1          BKA1_3E_REG = 0X60;//rxpll fb div = 1;
 349   1          BKA1_35_REG |=BIT7_1;//hdmi mode must set 
 350   1          BKA1_42_REG = 0x80; //frl mode freq_set = 0
 351   1          BKA1_43_REG = 0x00;
 352   1          
 353   1          BKE3_00_REG &= BIT0_0;//[0]rgd_dhrxpll_cal_pll_cal_en: 0-dis
 354   1          BKE3_0A_REG |= BIT4_1;//[5:4]rgd_dhrxpll_cal_frl_set_mode_sel: 01-hdmi2.1 rx control
 355   1          BKE3_0B_REG |= BIT0_1;//[0]rgd_dhrxpll_cal_pll_band_sw_en: 1-en
 356   1      
 357   1          BKA1_30_REG &= BIT6_0;//[6]rg_dhrxpll_rst_n: 0-en
 358   1          BKA1_30_REG |= BIT6_1;//[6]rg_dhrxpll_rst_n: 1-dis
 359   1      }
