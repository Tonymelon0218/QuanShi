 880          //========================================================================
 881          // Func Name   : to slove hdmi2.0 10bit case with csc ,using the pcrpll to creat pixel clk  in tmds mode
 882          // Description : this is a bug for rxpll that, SRC is HDMI2.0 and deep color is 10bit
 883          // Input       : void  
 884          // Output      : None
 885          // Return      : void
 886          //========================================================================
 887          void Drv_HdmiRx_TmdsPcrPllCal(u32 ulTmdsClk)
 888          {
 889   1          u8 ucpcrpll_cal_cnt,ucpcrpll_lock_cnt;
 890   1      
 891   1          BKA3_20_REG &= BIT4_0;//[4]rg_pcrpll_pd: 0-normal work
 892   1          BKA3_20_REG &= 0xfc;//[1:0]rg_pcrpll_ref_sel: 00-Xtal_25m_clk
 893   1          BKA3_20_REG |= 0X03;//pcr pll sel 
 894   1          BKA3_43_REG &= 0xf3;
 895   1          BKA3_43_REG |= BIT3_1;//sel rxpll half pixel clk
 896   1          
 897   1          BKA3_21_REG &= 0xe0;
 898   1          BKA3_21_REG |= 0x04; //prediv = 5;
 899   1          
 900   1          BKA3_24_REG = 0x00;//pcrpll_pixel_clk
 901   1          BKA3_2E_REG = 0x08;//da_pcrpll_post_divsel = 1;
 902   1          BKE2_3D_REG &= BIT3_0;//pcrpll_cal_disable
 903   1          BKE2_3D_REG = 0x20;// ks =2;
 904   1          // ulRxpll_In_Clk is half tmds clk, pcrpll_in ref half pixel clk
 905   1          // 4K30 pcrpll in clk  370M  ulRxpll_In_Clk*4 = real tmds clk
 906   1          if(ulTmdsClk < 375000) //half pixel clk
 907   1          {
 908   2              BKA3_20_REG |=BIT2_1;//rg_pcrpll post div = 2;
 909   2              BKA3_2A_REG = 0x80|0x28;// divset =  40;
 910   2              BKA3_2B_REG = 0xb0;//freq_set =  div 8
 911   2          }
 912   1          else  //
 913   1          {
C51 COMPILER V9.53.0.0   DRVHDMIRX                                                         02/13/2025 10:14:18 PAGE 16  

 914   2              BKA3_20_REG &=BIT2_0;//rg_pcrpll post div = 1;
 915   2              BKA3_2A_REG = 0x80|0x28;// divset = 40;
 916   2              BKA3_2B_REG = 0xa0;//freq_set =  div 4 
 917   2          }
 918   1          ucpcrpll_cal_cnt = 0;
 919   1          do{
 920   2              BKE1_08_REG &= 0xfc;//[1]rgd_sw_pcrpll_cal_rst_n
 921   2              BKE1_0E_REG &= BIT1_0;//[1]rg_sw_pcrpll_rst_n
 922   2              BKE2_3D_REG &= BIT3_0;//[3]rgd_pcrpll_pll_cal_en
 923   2              Ocm_Delay1ms(1);
 924   2              BKE1_08_REG |= 0x03;
 925   2              BKE1_0E_REG |= BIT1_1;
 926   2              Ocm_Delay1ms(1);
 927   2              BKE2_3D_REG |= BIT3_1;
 928   2              Ocm_Delay1ms(2);
 929   2              ucpcrpll_cal_cnt++;
 930   2          }while((ucpcrpll_cal_cnt < 3)&&((BKE2_47_REG&0x3) != 0x02));
 931   1          printLT(PRINT_PRIO_HIG, "\nPcrpll band = 0x%02bx", BKE2_4E_REG);
 932   1          ucpcrpll_lock_cnt = 0;      
 933   1          while((!(BKE2_28_REG&BIT4_1)) && (ucpcrpll_lock_cnt < 6))  //PLL lock output lock status
 934   1          {
 935   2              ucpcrpll_lock_cnt++;
 936   2              Ocm_Delay1ms(1);
 937   2          }
 938   1      }
