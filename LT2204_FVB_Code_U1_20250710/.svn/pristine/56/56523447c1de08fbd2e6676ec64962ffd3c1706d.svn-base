 652   2                  BKCD_48_REG |= BIT2_1;//[2]rgd_sw_frl_depkt_rst_n: 1-dis
 653   2                  break;
 654   2              case HDMI_FRL_TRAIN_RST:
 655   2                  BKCD_48_REG &= 0x81;//[5]rgd_sw_frl_dec_rst_n
 656   2                                      //[4]rgd_sw_frl_start_rst_n
 657   2                                      //[3]rgd_sw_fec_dec_rst_n
 658   2                                      //[2]rgd_sw_frl_depkt_rst_n
 659   2                                      //[1]rgd_sw_glb_rst_n
 660   2                  BKCD_48_REG |= 0x7e;
 661   2                  break;
 662   2              case HDMI_RX_FIFO_RST:
 663   2                  BKC9_08_REG &= BIT4_0;
 664   2                  BKC9_08_REG |= BIT4_1;
 665   2                  break;
 666   2              case HDMI_RX_DEPKT_RST:
 667   2                  BKC9_07_REG &= BIT6_0;//[6]rgd_sw_hdmi20rx_aud_rst_n: 0-en
C51 COMPILER V9.53.0.0   DRVHDMIRX                                                         02/13/2025 10:14:18 PAGE 12  

 668   2                  BKC9_07_REG |= BIT6_1;//[6]rgd_sw_hdmi20rx_aud_rst_n: 1-dis
