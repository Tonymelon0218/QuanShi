 740          // Func Name   : Drv_HdmiRx_PhyInit
 741          // Description : Select which phy dig_wclk for link clock.
 742          //            D2/D2------D3---------------D2
 743          //            D1/D1------D2---------------D1
 744          //            D0/D0------D1---------------D0
 745          //           CLK/D3------D0---------------D3
 746          // Input       : u8 ucOpt  
 747          // Output      : None
 748          // Return      : void
 749          //========================================================================
 750          void Drv_HdmiRx_PhySet(u8 ucOpt)
 751          {
 752   1          switch(ucOpt)
 753   1          {
 754   2              case HDMI14:
 755   2              case HDMI20:
 756   2                  BKA1_09_REG &= 0x0f;//[7:4]for hdmi2.1 to hdmi2.0 mode
 757   2                  BKA1_0B_REG = 0x4f;//[7:4]D1 link clk enable.
 758   2                                     //[3:0]D1/D2/D3 dig_clk enable.
