              u8 Drv_HdmiRx_AudioChangeDetect(void)
              {
                  u8 current_audioFS = 0;
C51 COMPILER V9.53.0.0   DRVHDMIRX                                                         02/13/2025 10:14:18 PAGE 27  

                      
                              current_audioFS = BKC6_7C_REG;
                              if(BKE0_91_REG > current_audioFS)
                              {
                                              if(BKE0_91_REG - current_audioFS > 1)
                                              {
                                                              if((current_audioFS==31)||(current_audioFS==32)||(current_audioFS==44)||(current_audioFS==47)||(curr
             -ent_audioFS==48))
                                                              {
              //                                                              Audio_interrupt_trigger = 1;
              //                                                              Ocm_Timer_UpdLocalTime(&ulCurrentAudioTime);
                                                                              BKE0_90_REG = 0x01;
                                                                              BKE0_91_REG = current_audioFS;//audio sample rate
                                                                        return 1;
                                                              }
                                                              else if(current_audioFS==0)
                                                              {
              //                                                              Audio_interrupt_trigger = 1;
              //                                                              Ocm_Timer_UpdLocalTime(&ulCurrentAudioTime);
                                                                              BKE0_90_REG = 0x00;
                                                                              BKE0_91_REG = current_audioFS;//audio sample rate
                                                                        return 1;
                                                              }
                                                              else
                                                              {
                                                                        return 0;
                                                              }
                                              }
                                              else
                                              {
                                                        return 0;
                                              }
                              }
                              else if(current_audioFS > BKE0_91_REG)
                              {
                                              if(current_audioFS - BKE0_91_REG > 1)
                                              {
                                                              if((current_audioFS==31)||(current_audioFS==32)||(current_audioFS==44)||(current_audioFS==47)||(curr
             -ent_audioFS==48))
                                                              {
              //                                                              Audio_interrupt_trigger = 1;
              //                                                              Ocm_Timer_UpdLocalTime(&ulCurrentAudioTime);
                                                                              BKE0_90_REG = 0x01;
                                                                              BKE0_91_REG = current_audioFS;//audio sample rate
                                                                        return 1;
                                                              }
                                                              else
                                                              {
                                                                        return 0;
                                                              }
                                              }
                                              else
                                              {
                                                        return 0;
                                              }
                                              
                              }
                              else
                              {
                                        return 0;
                              }
              }
