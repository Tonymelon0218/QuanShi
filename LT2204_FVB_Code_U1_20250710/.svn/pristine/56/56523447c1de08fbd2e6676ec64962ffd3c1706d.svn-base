 853          //========================================================================
 854          // Func Name   : to slove hdmi2.0 10bit case
 855          // Description : this is a bug for rxpll that, SRC is HDMI2.0 and deep color is 10bit
 856          // Input       : void  
 857          // Output      : None
 858          // Return      : void
 859          //========================================================================
 860          void Drv_HdmiRx_TenBitSet(void)
 861          {
 862   1          BKA1_37_REG &= 0xfc;//default
 863   1          //CCD7: [3:0] 0101-10bit
 864   1          //CC70: [1]tmds_bit_clock_ratio: 1 is 1/40, HDMI2.0;
 865   1          if ((BKCC_70_REG & BIT1_1) && ((BKCC_D7_REG & 0x0f) == 0x05))
 866   1          {
 867   2              BKA1_37_REG |= BIT6_1;//[6]rg_dhrxpll_tenbit_sel: 1-from register
 868   2              BKA1_37_REG |= BIT4_1;//[5:4]rg_dhrxpll_tenbit_set: 01-vco_out_clk
 869   2              BKA1_37_REG |= 0x02;  //half pixel div = 1;
 870   2              printLT(PRINT_PRIO_HIG, "\nHdmi rx tmds ten bit set");
 871   2          }
 872   1          else
 873   1          {
 874   2              BKA1_37_REG &= BIT6_0;//[6]rg_dhrxpll_tenbit_sel: 0-from digital-to-analog interface
 875   2              BKA1_37_REG &= BIT4_0;//[5:4]rg_dhrxpll_tenbit_set: 00-2*vco_out_clk
 876   2              BKA1_37_REG |= 0x01;//
 877   2          }
 878   1      }
