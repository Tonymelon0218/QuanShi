 688          void Drv_HdmiRx_EdidLoad(u8 *pEDID_Data)
 689          {
 690   1          u8 ucBlockNum;
 691   1          u16 usLoop;
 692   1      
 693   1          BKCC_08_REG &= BIT1_0;//[1]rgd_rx_src_rd_en: 0-i2c slvae rd en, 1-src rd en; 
 694   1          BKCC_08_REG |= BIT7_1 | BIT0_1;//[7]rgd_edid_addr_plus_en, [0]rgd_accs_edid_en: 1-en, 0-dis
 695   1          BKCC_07_REG = 0x00;//[7:0]init address value
 696   1          BKCC_08_REG &= BIT7_0;//[7]rgd_edid_addr_plus_dis
 697   1      
 698   1          ucBlockNum = pEDID_Data[0x7e] + 1;
 699   1          if (ucBlockNum > 2)
 700   1          {
 701   2              BKCC_06_REG |= BIT6_1;//[6]rgd_edid_v3_en: 1-4block;
 702   2          }
 703   1          else
 704   1          {
 705   2              BKCC_06_REG &= BIT6_0;//[6]rgd_edid_v3_en: 0-2block;
 706   2          }
 707   1          for(usLoop = 0; usLoop < ((u16)ucBlockNum << 7); usLoop++)
 708   1          {
 709   2              BKCC_94_REG = pEDID_Data[usLoop];
 710   2          }
 711   1          BKCC_08_REG |= BIT1_1;//[1]src read en
 712   1          BKCC_08_REG &= BIT0_0;//[0]rgd_accs_edid_en: 1-en, 0-dis
 713   1          #ifdef NVIDIA_FW_EN
                  #if (EDID_DDC_DIS == ENABLED)
                  BKCC_03_REG &= 0xe0;
                  BKCC_03_REG |= 0x02;//nivia glitch;
                  BKCC_03_REG |= BIT5_1|BIT6_1;
                  BKCC_06_REG  = 0x02; //RGD_SDA_OUT_DLY
                  BKCA_1E_REG  = 0x04;//HDCP RX DDC SDA out delay.
                  #endif
                  #endif
 722   1      }
