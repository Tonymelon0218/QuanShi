 490   1                             //[3]rg_dhrx_en: 0-dis, 1-en;
 491   1                             //[2:0]rg_dhrx_vcm_adj: 011-0.75v
 492   1          BKA1_0D_REG = 0xa8;//[7:6]rg_dhrx_temp_sense_vset; 
