 158          u8 Drv_HdcpRx_VerGet(void)
 159          {
 160   1          #if RX_PORT_SIGN == DP_PORT
              
                  #if DPRX_HDCP_DEC_MODE != NO_HDCP
                  #if DPRX_HDCP_REPEATER == DISABLED
                  if (BKF1_FD_REG & BIT7_1)//[7]hdcp 1.3
                  {
                      return HDCP1X;
                  }
                  else if (BKCA_B3_REG & BIT0_1)//[0]hdcp 2.2
                  {
                      return HDCP2X;
                  }
                  else
                  #endif
                  #if DPRX_HDCP_REPEATER == ENABLED
                  if (BKF1_FE_REG & BIT5_1)//[5]hdcp repeater 1.3
                  {
                      return HDCP1X;
C51 COMPILER V9.53.0.0   DRVHDCPRX                                                         02/13/2025 10:14:17 PAGE 4   

                  }
                  else if (BKCA_B3_REG & BIT1_1)//[1]hdcp repeater 2.2
                  {
                      return HDCP2X;
                  }
                  else
                  #endif
                  #endif
                  {
                      return NO_HDCP;
                  }
              
                  #endif
 191   1      
 192   1          #if RX_PORT_SIGN == HDMI_PORT
 193   1      
 194   1          #if HDMIRX_HDCP_DEC_MODE != NO_HDCP
 195   1          if (BKCA_84_REG & BIT0_1)//hdcp1.3
 196   1          {
 197   2              return HDCP1X;
 198   2          }
 199   1          else if (BKCA_B3_REG & BIT0_1)//hdcp2.2
 200   1          {
