 116   2              BKCA_11_REG |= 0x01;//[7]rgd_enc_dis_at_err: 1-enc dis(HDCP2.3)
 117   2                                  //[0]hdcp2.2 RX cipher enable: 1-en
 118   2              BKCA_11_REG |= BIT7_1;
