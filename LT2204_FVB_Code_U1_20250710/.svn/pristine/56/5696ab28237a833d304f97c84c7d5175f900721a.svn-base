  16          void Drv_HdcpRx_Enable(IN u8 ucOpt)
  17          {
  18   1          #if RX_PORT_SIGN == DP_PORT
                  #if DPRX_HDCP_DEC_MODE != NO_HDCP
                  BKCA_2E_REG |= BIT7_1;//[7]rgd_rx_key_load_sel: 1-I2C
                  BKCA_2E_REG |= BIT4_1;//[4]hdcp22 rx mode select, 1-dp mode, 0-hdmi mode
                  Ocm_Delay1ms(2);
                  if ((BKCA_80_REG & 0x03) != 0x03)
                  {
                      BKC9_06_REG &= BIT2_0;//hdcp dpcd reset
                      printLT(PRINT_PRIO_HIG, "\nHdcp key invalid");
                      return;
                  }
                  BKF1_BB_REG = 0x5B;
                  BKF1_C4_REG &= BIT1_0;//[1]rgd_dprx_hdcp_bypass_en: 0-hdcp path
                  #if DPRX_HDCP_REPEATER == ENABLED
                  BKCA_31_REG &= BIT0_0;//[0]rgd_rx_id_list_sram_sel: 0-dis
                  #endif
                  if (ucOpt & HDCP1X)
                  {
                      Drv_System_IntSet(IRQ_RXHDCP1X_INT,ON);//  
                      #if DPRX_HDCP_REPEATER == ENABLED
                      BKF1_69_REG &= BIT6_0;//[6]rx mode rgd_h1_rpt_ready_sel: 0
                      BKF1_C4_REG |= BIT3_1;//[3]rgd_dprx_h1_rpt_bit: 1-en
                      #else
                      BKF1_69_REG |= BIT6_1;//[6]rx mode rgd_h1_rpt_ready_sel: 1
                      BKF1_C4_REG &= BIT3_0;//[3]dprx hdcp13 repeater bit, 1-repeater mode, 0-not
                      #endif
                      BKF1_C4_REG |= BIT0_1;//[0]dprx hdcp13 enable, 1-en, 0-dis
              
                      BKCA_14_REG = 0x00;//[7:0]hdcp 2.2 rxcaps[07:00],rx mode: 0x02; repeater mode: 0x03;
                      BKCA_15_REG = 0x00;//[7:0]hdcp 2.2 rxcaps[15:08]
                      BKCA_16_REG = 0x00;//[7:0]hdcp 2.2 rxcaps[23:16]
                  }
                  if (ucOpt & HDCP2X)
                  {
                      Drv_System_IntSet(IRQ_RXHDCP2X_INT,ON);//  
                      #if DPRX_HDCP_REPEATER == ENABLED
C51 COMPILER V9.53.0.0   DRVHDCPRX                                                         02/13/2025 10:14:17 PAGE 2   

                      BKCA_12_REG &= BIT2_0;//[2]rgd_h2_rpt_rdy_sel;
                      BKCA_14_REG = 0x03;//[7:0]hdcp 2.2 rxcaps[07:00]
                      #else
                      BKCA_12_REG |= BIT2_1;//[2]rgd_h2_rpt_rdy_sel;
                      BKCA_14_REG = 0x02;//[7:0]hdcp 2.2 rxcaps[07:00],rx mode: 0x02; repeater mode: 0x03;
                      #endif
                      BKCA_15_REG = 0x00;//[7:0]hdcp 2.2 rxcaps[15:08]
                      BKCA_16_REG = 0x02;//[7:0]hdcp 2.2 rxcaps[23:16]
                      BKCA_2A_REG |= 0x0f;//[3:0]hdcp22_cp_irq_int_en
                  }
              
                  if(ucOpt == NO_HDCP)
                  {
                      Drv_System_IntSet(IRQ_RXHDCP1X_INT,OFF);//
                      Drv_System_IntSet(IRQ_RXHDCP2X_INT,OFF);//  
                      BKF1_C4_REG &= BIT3_0;//[3]rgd_dprx_h1_rpt_bit: 0-dis
                      BKF1_C4_REG &= BIT0_0;//[0]dprx hdcp13 enable, 1-en, 0-dis
                      BKCA_14_REG = 0x00;//[7:0]hdcp 2.2 rxcaps[07:00],rx mode: 0x02; repeater mode: 0x03;
                      BKCA_15_REG = 0x00;//[7:0]hdcp 2.2 rxcaps[15:08]
                      BKCA_16_REG = 0x00;//[7:0]hdcp 2.2 rxcaps[23:16]
                  }
                  #else
                  BKC9_06_REG &= BIT2_0;//hdcp dpcd reset
                  ucOpt = NO_HDCP;
                  #endif
              
                  #endif
