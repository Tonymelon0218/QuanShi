 231   1          #if RX_PORT_SIGN == HDMI_PORT
 232   1          #if HDMIRX_HDCP_DEC_MODE != NO_HDCP
 233   1          BKCA_11_REG |= BIT6_1;//[6]rgd_re_auth_pls_pix;
 234   1          Ocm_Delay1us(20);//necessary for run hdcp logic reset
 235   1          BKCA_11_REG &= BIT6_0;
 236   1      
 237   1          BKCA_00_REG &= BIT0_0;//[0]rgd_hdcp_auto_ctrl_en;
 238   1          BKCA_01_REG |= BIT6_1;
 239   1          Ocm_Delay1us(20);//necessary for run hdcp logic reset
