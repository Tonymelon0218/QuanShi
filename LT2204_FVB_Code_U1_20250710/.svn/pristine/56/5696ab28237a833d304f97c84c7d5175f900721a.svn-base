 295          #if RX_PORT_SIGN == DP_PORT
              #if (DPRX_HDCP_DEC_MODE != NO_HDCP)
              //False: No Int
              //True: INT
              u8 Drv_Hdcp13_IntGet(void)
              {
C51 COMPILER V9.53.0.0   DRVHDCPRX                                                         02/13/2025 10:14:17 PAGE 6   

                  if(BKE5_40_REG & BIT3_1)//dp hdcp1.3 rx int
                  {
                      BKE5_30_REG |= BIT3_1;//[1]dp rx int clr en
                      BKE5_30_REG &= BIT3_0;//[1]dp rx int clr dis
                      if((BKF1_A7_REG & BIT3_1) == 0x00)//HDCP13 INT DIS
                      {
                          return FALSE;
                      }
                      if(BKF1_DC_REG & 0x06)//[2]dprx hdcp13 v ready, [1]dprx hdcp13 link intergrity check failure
                      {
                          return TRUE;
                      }
                  }
                  return FALSE;
              }
              u8 Drv_Hdcp2X_IntGet(void)
              {
                  if(BKE5_41_REG & BIT7_1)//dprx hdcp22 interrupt flag
                  {
                      BKE5_31_REG |= BIT7_1;//[6]hdcp rx int clr en
                      BKE5_31_REG &= BIT7_0;//[6]hdcp rx int clr dis
                      if((BKCA_2A_REG & 0x0f) != 0x0f)
                      {
                          return FALSE;
                      }
                      if (BKCA_B4_REG & 0xf0)//[7:4]link fail/ekhkm ready/H ready/V ready flag
                      {
                          return TRUE;
                      }
                  }  
                  return FALSE;
              }
              #endif
