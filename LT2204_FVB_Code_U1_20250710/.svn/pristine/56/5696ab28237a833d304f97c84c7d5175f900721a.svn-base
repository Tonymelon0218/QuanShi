 212          void Drv_HdcpRx_StateClear(void)
 213          {
 214   1          #if RX_PORT_SIGN == DP_PORT
                  #if DPRX_HDCP_DEC_MODE != NO_HDCP
                  u8 ucHDCP13 = 0;
                  //bit6 rgd_dprx_hdcp13_sw_dec_rst_n
                  //bit5 rgd_dprx_hdcp13_prtc_rst_n
                  //bit4 rgd_dprx_hdcp13_dpcd_rst_n
                  ucHDCP13 = BKF1_B1_REG;
                  BKF1_B1_REG &= 0x8F;//HDCP1.3 State Clear
                  BKF1_B1_REG = ucHDCP13;//HDCP1.3 State Clear
                  //bit3 HDCPRX protocol control logic soft reset  -----Important
                  //bit1 rgd_hdcprx_dp_dec_rst_n
                  //bit0 rgd_hdcprx_dp_dpcd_rst_n
                  BKC9_06_REG &= 0x37;
                  BKC9_06_REG |= 0xc8;
                  #endif
                  #endif
